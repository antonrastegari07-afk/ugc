-- ========================================
-- TÉLÉPORTATION
-- ========================================
-- 🛬 TÉLÉPORT SÛR v2
--   Le serveur place le perso puis prévient le client (SafeTPHold).
--   C'est le CLIENT qui le tient en place, et SEULEMENT tant que le sol
--   n'est pas encore chargé chez lui → zone déjà chargée = zéro attente.
local safeTeleport, floorTarget
do
	local holdEvent = game:GetService("ReplicatedStorage"):FindFirstChild("SafeTPHold")
	if not holdEvent then
		holdEvent = Instance.new("RemoteEvent")
		holdEvent.Name = "SafeTPHold"
		holdEvent.Parent = game:GetService("ReplicatedStorage")
	end

	-- Hauteur du HRP au-dessus des pieds (R15 : HipHeight + ½ HRP, R6 : 2 + ½ HRP)
	local function standOffset(character)
		local hum = character:FindFirstChildOfClass("Humanoid")
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not (hum and hrp) then return 3 end
		if hum.RigType == Enum.HumanoidRigType.R15 then
			return hum.HipHeight + hrp.Size.Y / 2
		end
		return 2 + hrp.Size.Y / 2
	end

	-- Position debout PILE sur le sol réel du checkpoint (plus jamais dans la part)
	floorTarget = function(character, part)
		if not part:IsA("BasePart") then
			return part:GetPivot() * CFrame.new(0, 3, 0) -- secours si c'est un Model
		end
		local top = part.CFrame * CFrame.new(0, part.Size.Y / 2, 0)
		local ignore = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then table.insert(ignore, p.Character) end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignore
		params.RespectCanCollide = true
		local hit = workspace:Raycast(top.Position + Vector3.new(0, 0.1, 0),
			Vector3.new(0, -(part.Size.Y + 12), 0), params)
		local floorY = hit and hit.Position.Y or top.Position.Y
		local pos = Vector3.new(top.Position.X, floorY + standOffset(character), top.Position.Z)
		return CFrame.new(pos) * part.CFrame.Rotation
	end

	safeTeleport = function(character, targetCF)
		if not character or typeof(targetCF) ~= "CFrame" then return false end
		local hrp = character:FindFirstChild("HumanoidRootPart")
			or character:WaitForChild("HumanoidRootPart", 3)
		if not hrp then return false end
		targetCF = targetCF + Vector3.new(0, 0.3, 0) -- petite marge : jamais les pieds dans le sol
		local plr = Players:GetPlayerFromCharacter(character)
		if plr and _G.AntiFlyTP and _G.AntiFlyTP.MarkTeleport then
			pcall(_G.AntiFlyTP.MarkTeleport, plr, 5)
		end
		-- 🎃 quêtes : téléport fait par le serveur ≠ téléport de triche (sinon le checkpoint suivant ne comptait pas)
		if plr and _G.HalloweenEvent and type(_G.HalloweenEvent.MarkTeleport) == "function" then
			pcall(_G.HalloweenEvent.MarkTeleport, plr, targetCF)
		end
		pcall(function()
			character:PivotTo(targetCF)
			hrp.AssemblyLinearVelocity = Vector3.zero
		end)
		if plr then
			holdEvent:FireClient(plr, character, targetCF)
			task.spawn(function()
				pcall(function() plr:RequestStreamAroundAsync(targetCF.Position, 8) end)
			end)
		end
		return true
	end
end
_G.SafeTeleport = safeTeleport

local function moveCharacter(character, targetPart)
	if not character or not targetPart or not targetPart.Parent then return false end
	return safeTeleport(character, floorTarget(character, targetPart))
end

-- ========================================
-- ✅ FONCTION: Attendre chargement SANS boucle while
-- ========================================
local function waitForCheckpointsLoaded(player, timeout)
	if checkpointsLoaded then 
		return true 
	end
	local userId = player.UserId
	playersWaitingForCheckpoints[userId] = true
	-- Attendre le signal avec timeout
	local completed = false
	local connection
	connection = checkpointLoadedSignal.Event:Once(function()
		completed = true
	end)
	-- Timeout
	local startTime = tick()
	while not completed and (tick() - startTime) < timeout do
		task.wait(0.5)
		-- Vérifier si le joueur a quitté
		if not player.Parent then
			playersWaitingForCheckpoints[userId] = nil
			return false
		end
	end
	playersWaitingForCheckpoints[userId] = nil
	return completed or checkpointsLoaded
end

