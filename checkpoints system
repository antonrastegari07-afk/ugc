end

-- ========================================
-- CONNEXION CHECKPOINTS (UNE SEULE FOIS)
-- ========================================
local function connectCheckpoint(part)
	if not part:IsA("BasePart") then return end
	if not part.Name:lower():match("^" .. CHECKPOINT_PREFIX:lower()) then return end
	local checkpointName = part.Name
	local checkpointNum = getCheckpointNumber(checkpointName)
	if not checkpointNum then return end
	-- Éviter double connexion
	if checkpointMap[checkpointName] then return end
	-- Ajouter aux deux caches
	checkpointMap[checkpointName] = part
	checkpointCache[checkpointNum] = part
	-- Connecter Touched UNE SEULE FOIS
	local connection = part.Touched:Connect(function(hit)
		if not hit or not hit.Parent then return end
		local humanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then return end
		local userId = player.UserId
		-- ✅ Ignorer si le joueur est en arène
		if _G.PlayersInArena[userId] then
			return
		end
		local now = tick()
		-- Debounce global de 0.5s
		local lastTouch = touchDebounce[userId] or 0
		if now - lastTouch < 0.5 then return end
		touchDebounce[userId] = now
		-- 🔒 le joueur est-il VRAIMENT sur le checkpoint ? (un exploit peut déclencher Touched à distance)
		local hrp = hit.Parent:FindFirstChild("HumanoidRootPart")
		local far = true
		if hrp then
			local rel = part.CFrame:PointToObjectSpace(hrp.Position)
			local M = 12
			far = math.abs(rel.X) > part.Size.X / 2 + M or math.abs(rel.Y) > part.Size.Y / 2 + M
				or math.abs(rel.Z) > part.Size.Z / 2 + M
		end
		-- Sauvegarder checkpoint (qui met aussi à jour le leaderboard)
		-- ❌ PAS de notification skip pour les touches normales
		saveCheckpoint(player, checkpointName, false, far)
	end)
	checkpointConnections[part] = connection
end

local function disconnectCheckpoint(part)
	local connection = checkpointConnections[part]
	if connection then
		connection:Disconnect()
		checkpointConnections[part] = nil
	end
	local checkpointName = part.Name
	if checkpointMap[checkpointName] == part then
		checkpointMap[checkpointName] = nil
	end
	local num = getCheckpointNumber(checkpointName)
	if num and checkpointCache[num] == part then
		checkpointCache[num] = nil
	end
end

