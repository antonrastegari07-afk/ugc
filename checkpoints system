-- ========================================
-- 🔄 RESET STAGE ON REBIRTH
-- ========================================
_G.ResetPlayerStage = function(player)
	if not player or not player.Parent then return end
	local userId = player.UserId
	print(string.format("🔄 Reset Stage pour %s (rebirth)", player.Name))
	if spawnThreads[userId] then
		task.cancel(spawnThreads[userId])
		spawnThreads[userId] = nil
	end
	local cp1 = checkpointCache[1]
	local FIRST_CP = (cp1 and cp1.Name) or (CHECKPOINT_PREFIX .. "1")
	-- ✅ Progression remise au Checkpoint 1 IMMÉDIATEMENT (session)
	sessionCheckpoints[userId] = FIRST_CP
	playerCheckpoints[userId]  = 1
	touchDebounce[userId]      = nil
	skipDebounce[userId]       = nil
	updateLeaderboard(player, 1)
	notifyCheckpoint(player, 1, "reset")
	-- ✅ DataStore : on ÉCRIT Checkpoint1 (au lieu de RemoveAsync).
	--    Rebirth = reset voulu → écrire Checkpoint1 est toujours correct, même si la lecture n'avait pas réussi.
	--    progressLoaded = true → un respawn ne relit PLUS le DataStore (plus de retour de l'ancienne progression).
	progressLoaded[userId]  = true
	savedCheckpoint[userId] = nil
	requestCheckpointWrite(userId, FIRST_CP)
	-- ✅ TP DIRECT sur le Checkpoint 1 (pas de chute)
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 and not _G.PlayersInArena[userId] then
		if cp1 and cp1.Parent then
			moveCharacter(character, cp1)
		else
			moveCharacter(character, firstSpawn)
		end
	end
	pcall(function()
		stageResetEvent:FireClient(player)
	end)
	print(string.format("✅ Stage reset OK pour %s", player.Name))
end

-- ========================================
-- 💤 AFK RELOAD : sauvegarde / restauration de la position exacte
-- ========================================
-- Appelée par le script principal JUSTE AVANT l'ACK du reload (reload accepté uniquement)
-- Écriture synchrone → la position est en mémoire AVANT que le client téléporte
_G.SaveReloadPosition = function(player)
	if not player or not player.Parent then return end
	if _G.PlayersInArena[player.UserId] then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	local data = { hrp.CFrame:GetComponents() }
	local ok, err = pcall(function()
		reloadPosMap:SetAsync(tostring(player.UserId), data, RELOAD_POS_TTL)
	end)
	if not ok then
		warn("⚠️ Position AFK non sauvegardée pour " .. player.Name .. " (fallback checkpoint): " .. tostring(err))
	end
end

-- Retourne le CFrame sauvegardé si le joueur revient d'un AFK reload (et le consomme)
local function consumeReloadPosition(player)
	local okJoin, join = pcall(function() return player:GetJoinData() end)
	if not okJoin or not join or join.SourcePlaceId ~= game.PlaceId then return nil end
	local key = tostring(player.UserId)
	local data
	for attempt = 1, 3 do
		local s, r = pcall(function() return reloadPosMap:GetAsync(key) end)
		if s then data = r break end
		task.wait(attempt)
	end
	if type(data) ~= "table" or #data ~= 12 then return nil end
	task.spawn(function()
		pcall(function() reloadPosMap:RemoveAsync(key) end)
	end)
	return CFrame.new(table.unpack(data))
end

local function handleCharacterSpawn(player, character)
	local userId = player.UserId
	-- ✅ Si le joueur est en arène, ne rien faire (le système d'arène gère le spawn)
	if _G.PlayersInArena[userId] then
		print("🎮 " .. player.Name .. " est en arène, spawn géré par le système 1v1")
		return
	end
	-- ✅ CLEANUP: Annuler les threads de spawn précédents
	if spawnThreads[userId] then
		task.cancel(spawnThreads[userId])
		spawnThreads[userId] = nil
	end
	-- Supprimer ForceField
	local function removeFF(child)
		if child:IsA("ForceField") then
			child:Destroy()
		end
	end
	for _, child in ipairs(character:GetChildren()) do
		removeFF(child)
	end
	local ffConnection = character.ChildAdded:Connect(removeFF)
	-- Gestion mort
	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		humanoid.Died:Connect(function()
			-- Nettoyer la connection ForceField
			if ffConnection then
				ffConnection:Disconnect()
			end
			task.wait(Players.RespawnTime)
			if player and player.Parent then
				player:LoadCharacter()
			end
		end)
	end
	-- ✅ Checkpoint déjà connu et chargé → on y va DIRECTEMENT
	--    (plus de double TP FirstSpawn → checkpoint à chaque respawn)
	local savedName = sessionCheckpoints[userId]
	-- ✅ FIX: la progression a-t-elle été CONFIRMÉE par une lecture réussie du DataStore ?
	local loaded = progressLoaded[userId]
	local directCp = savedName and checkpointsLoaded and checkpointMap[savedName]
	local directReady = directCp and directCp.Parent
	if loaded and directReady then
		moveCharacter(character, directCp)
		local directNum = getCheckpointNumber(savedName)
		if directNum then
			updateLeaderboard(player, directNum)
		end
		return
	end
	-- SPAWN PHASE 1: FirstSpawn immédiat
	if directReady then
		-- ✅ FIX: progression pas encore confirmée (lecture en échec / en cours) → on remet le joueur
		--    sur son checkpoint de session (pas au début) et on RETENTE la lecture en PHASE 3
		moveCharacter(character, directCp)
		local directNum = getCheckpointNumber(savedName)
		if directNum then
			updateLeaderboard(player, directNum)
		end
	else
		moveCharacter(character, firstSpawn)
	end
	-- SPAWN PHASE 2: Checkpoint en session
	if loaded and savedName then
		spawnThreads[userId] = task.spawn(function()
			-- Attendre avec le signal (PAS de boucle while!)
			waitForCheckpointsLoaded(player, 10)
			-- Vérifier que le joueur est toujours là ET pas en arène
			if not player.Parent or player.Character ~= character or _G.PlayersInArena[userId] then
				spawnThreads[userId] = nil
				return
			end
			-- Téléporter
			local checkpoint = checkpointMap[savedName]
			if checkpoint then
				moveCharacter(character, checkpoint)
				-- ✅ Mettre à jour le leaderboard après le spawn
				local checkpointNum = getCheckpointNumber(savedName)
				if checkpointNum then
					updateLeaderboard(player, checkpointNum)
				end
			end
			spawnThreads[userId] = nil
		end)
		return
	end
	-- SPAWN PHASE 3: Charger depuis DataStore
	spawnThreads[userId] = task.spawn(function()
		task.wait(1.5)
		-- Vérifier que le joueur est toujours là ET pas en arène
		if not player.Parent or _G.PlayersInArena[userId] then
			spawnThreads[userId] = nil
			return
		end
		-- ✅ FIX: lecture avec retries. ok=false = lecture ÉCHOUÉE (≠ "aucune progression")
		local ok, loadedName = getLastCheckpoint(userId)
		-- La lecture peut avoir pris du temps → revérifier
		if not player.Parent or _G.PlayersInArena[userId] then
			spawnThreads[userId] = nil
			return
		end
		if not ok then
			-- ⛔ On ne marque PAS la progression comme chargée → AUCUNE écriture ne sera faite,
			--    la vraie sauvegarde du joueur reste intacte. Nouvelle tentative au prochain respawn.
			warn(string.format("⛔ %s - progression non lue, sauvegarde bloquée pour la protéger", player.Name))
			spawnThreads[userId] = nil
			return
		end
		-- ✅ Lecture réussie : les écritures sont maintenant autorisées pour ce joueur
		progressLoaded[userId] = true
		-- 💤 Retour d'AFK reload ? → position exacte
		local reloadCF = consumeReloadPosition(player)
		savedCheckpoint[userId] = loadedName
		if loadedName then
			sessionCheckpoints[userId] = loadedName
			local savedNum = getCheckpointNumber(loadedName)
			if savedNum then
				playerCheckpoints[userId] = savedNum
				-- 📊 Mettre à jour le leaderboard avec le checkpoint sauvegardé
				updateLeaderboard(player, savedNum)
				notifyCheckpoint(player, savedNum, "load")
			end
			task.spawn(function()
				pcall(function()
					checkpointEvent:FireClient(player, loadedName)
				end)
			end)
			-- ✅ Utiliser le signal au lieu de while
			waitForCheckpointsLoaded(player, 10)
			-- Vérifier à nouveau ET pas en arène
			if player.Parent and player.Character == character and not _G.PlayersInArena[userId] then
				if reloadCF then
					safeTeleport(character, reloadCF)
				else
					local checkpoint = checkpointMap[loadedName]
					if checkpoint then
						moveCharacter(character, checkpoint)
					end
				end
			end
		elseif sessionCheckpoints[userId] then
			-- Aucune sauvegarde en base, mais le joueur a touché des checkpoints pendant l'attente
			-- (écritures bloquées jusque-là) → on les enregistre maintenant que c'est sûr
			requestCheckpointWrite(userId, sessionCheckpoints[userId])
		end
		spawnThreads[userId] = nil
	end)
end

-- ========================================
-- ✅ RETOUR CHECKPOINT (appelé par le système d'arène à la sortie)
-- ========================================
_G.GetCheckpointForExit = function(player)
	local userId = player.UserId
	local savedName = sessionCheckpoints[userId]
	-- Pas en session (ex: arrivé via ServerBrowser) → charger depuis le DataStore
	if not savedName then
		-- ✅ FIX: lecture avec retries (3 essais ici, on est appelé à la sortie d'arène)
		local ok, loadedName = getLastCheckpoint(userId, 3)
		if ok and player.Parent then
			progressLoaded[userId] = true
			savedCheckpoint[userId] = loadedName
			savedName = loadedName
			if savedName then
				sessionCheckpoints[userId] = savedName
				local num = getCheckpointNumber(savedName)
				if num then
					playerCheckpoints[userId] = num
					updateLeaderboard(player, num)
					notifyCheckpoint(player, num, "load")
				end
			end
		end
	end
	if savedName then
		if not checkpointsLoaded then
			waitForCheckpointsLoaded(player, 5)
		end
		local part = checkpointMap[savedName]
		if part then return part end
	end
	-- Aucun checkpoint → début de l'obby
	return firstSpawn
end

-- ========================================
-- ✅ SKIP LEVEL (AVEC NOTIFICATIONS!)
-- ========================================
local function skipToNextCheckpoint(player)
	local userId = player.UserId
	-- ✅ NOUVEAU: Debounce de 2 secondes pour éviter double skip
	local now = tick()
	local lastSkip = skipDebounce[userId] or 0
	if now - lastSkip < 2 then
		warn(string.format("⚠️ %s - Skip trop rapide (debounce %.1fs)", player.Name, now - lastSkip))
		return false
	end
	-- ✅ Impossible de skip dans l'arène
	if _G.PlayersInArena[userId] then
		warn("⚠️ " .. player.Name .. " - Impossible de skip dans l'arène")
		return false
	end
	local character = player.Character
	if not character then 
		warn("⚠️ " .. player.Name .. " - Pas de personnage")
		return false 
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp or not humanoid or humanoid.Health <= 0 then 
		warn("⚠️ " .. player.Name .. " - HRP ou Humanoid manquant/mort")
		return false 
	end
	local currentNumber = playerCheckpoints[userId] or 1
	local nextNumber = currentNumber + 1
	local nextCheckpoint = checkpointCache[nextNumber]
	if nextCheckpoint and nextCheckpoint.Parent then
		-- ✅ NOUVEAU: Marquer le debounce AVANT le skip
		skipDebounce[userId] = now
		-- Téléporter le joueur
		moveCharacter(character, nextCheckpoint)
		-- Mettre à jour les tables
		playerCheckpoints[userId] = nextNumber
		sessionCheckpoints[userId] = "Checkpoint" .. nextNumber
		-- 📊 Mettre à jour le leaderboard
		updateLeaderboard(player, nextNumber)
		-- ✅ Sauvegarder avec notification de skip (3ème paramètre = true)
		saveCheckpoint(player, "Checkpoint" .. nextNumber, true)
		print(string.format("✅ %s skipped to Checkpoint%d (notification envoyée)", player.Name, nextNumber))
		return true
	else
		warn(string.format("❌ Checkpoint%d not found for %s", nextNumber, player.Name))
		return false
	end
end

_G.SkipToNextCheckpoint = skipToNextCheckpoint

