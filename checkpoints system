Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId
	-- ✅ CLEANUP: Annuler thread de spawn
	if spawnThreads[userId] then
		task.cancel(spawnThreads[userId])
		spawnThreads[userId] = nil
	end
	-- ✅ CLEANUP: Déconnecter CharacterAdded
	if spawnConnections[userId] then
		spawnConnections[userId]:Disconnect()
		spawnConnections[userId] = nil
	end
	-- ✅ CLEANUP: Retirer de la liste d'attente
	playersWaitingForCheckpoints[userId] = nil
	-- ✅ Ne sauvegarder que si le joueur N'EST PAS en arène
	-- ✅ FIX: UNE seule écriture finale (retentée, sans doublon avec BindToClose),
	--    et JAMAIS si la progression n'a pas été confirmée par une lecture réussie
	leavingPlayers[userId] = true
	if not _G.PlayersInArena[userId] then
		local lastCheckpoint = sessionCheckpoints[userId]
		if lastCheckpoint and progressLoaded[userId] then
			wantedCheckpoint[userId] = lastCheckpoint
		elseif lastCheckpoint then
			warn("⛔ " .. player.Name .. " - progression jamais lue, checkpoint non sauvegardé (sauvegarde existante protégée)")
		end
	else
		print("🎮 " .. player.Name .. " a quitté en étant dans l'arène, checkpoint non sauvegardé")
	end
	-- Lance l'écriture finale (si une boucle d'écriture tourne déjà, elle écrira la dernière valeur).
	-- Les états de persistance du joueur sont nettoyés à la fin de l'écriture.
	task.spawn(runWriter, userId)
	-- ✅ CLEANUP complet
	touchDebounce[userId] = nil
	skipDebounce[userId] = nil
	sessionCheckpoints[userId] = nil
	playerCheckpoints[userId] = nil
	_G.PlayersInArena[userId] = nil
end)

-- ========================================
-- NETTOYAGE PÉRIODIQUE (Anti-leak)
-- ========================================
task.spawn(function()
	while true do
		task.wait(300) -- Toutes les 5 minutes
		local now = tick()
		local cleaned = 0
		-- Nettoyer les debounce anciens (touch)
		for userId, timestamp in pairs(touchDebounce) do
			if now - timestamp > 60 then -- Plus de 1 minute
				touchDebounce[userId] = nil
				cleaned = cleaned + 1
			end
		end
		-- Nettoyer les debounce anciens (skip)
		for userId, timestamp in pairs(skipDebounce) do
			if now - timestamp > 60 then -- Plus de 1 minute
				skipDebounce[userId] = nil
				cleaned = cleaned + 1
			end
		end
		if cleaned > 0 then
			print(string.format("🧹 Cleaned %d old debounce entries", cleaned))
		end
	end
end)

-- ========================================
-- CLEANUP À LA FERMETURE
-- ========================================
game:BindToClose(function()
	print("🔒 Fermeture du serveur - Cleanup checkpoint...")
	for userId, thread in pairs(spawnThreads) do
		if thread then task.cancel(thread) end
	end
	for userId, connection in pairs(spawnConnections) do
		if connection then connection:Disconnect() end
	end
	if queueThread then task.cancel(queueThread) end
	-- ✅ FIX : UNE écriture finale par joueur (retentée), puis on ATTEND la fin.
	--    runWriter évite les doublons avec PlayerRemoving (moitié moins de requêtes au reset)
	--    et n'écrit jamais pour un joueur dont la progression n'a pas été lue.
	for userId, checkpointName in pairs(sessionCheckpoints) do
		if not _G.PlayersInArena[userId] and progressLoaded[userId] then
			wantedCheckpoint[userId] = checkpointName
			task.spawn(runWriter, userId)
		end
	end
	local waited = 0
	while activeWrites > 0 and waited < 250 do  -- max 25s (BindToClose accepte jusqu'à 30s)
		task.wait(0.1)
		waited += 1
	end
	print(string.format("✅ Cleanup checkpoint terminé (%d écriture(s) non terminée(s))", activeWrites))
end)

