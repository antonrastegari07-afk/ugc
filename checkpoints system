-- ========================================
-- 🛡️ PROTECTION DE LA PROGRESSION (anti-perte lors des resets de serveurs)
-- ========================================
-- Problème corrigé : quand les requêtes DataStore sont saturées (reset des serveurs =
-- tout le monde quitte/rejoint en même temps), une LECTURE qui échoue était comprise
-- comme "ce joueur n'a aucune progression" → il restait au Checkpoint 1, puis la
-- première touche d'un checkpoint ÉCRASAIT sa vraie sauvegarde.
--   • les lectures sont retentées (attente progressive)
--   • on distingue "lecture ÉCHOUÉE" de "aucune progression"
--   • on N'ÉCRIT JAMAIS dans le DataStore tant que la lecture n'a pas réussi
--   • les écritures sont retentées, sans doublons (une seule à la fois par joueur)
local LOAD_ATTEMPTS = 8  -- tentatives de lecture (≈ 1 minute max d'attente progressive)
local WRITE_ATTEMPTS = 5 -- échecs d'écriture consécutifs avant d'abandonner (retenté plus tard)

local progressLoaded = {}   -- [userId] = true quand la LECTURE du DataStore a réussi
local savedCheckpoint = {}  -- [userId] = dernière valeur connue DANS le DataStore
local wantedCheckpoint = {} -- [userId] = dernière valeur à écrire dans le DataStore
local writerRunning = {}    -- [userId] = true si une boucle d'écriture tourne déjà
local leavingPlayers = {}   -- [userId] = true si le joueur est parti (nettoyage après l'écriture finale)
local activeWrites = 0      -- nombre d'écritures en cours (BindToClose les attend)

-- Retourne (ok, nom)
--   ok = false           → la lecture a ÉCHOUÉ (on ne sait PAS si le joueur a une progression)
--   ok = true, nom = nil → lecture réussie, aucune progression (nouveau joueur)
local function getLastCheckpoint(userId, maxAttempts)
	maxAttempts = maxAttempts or LOAD_ATTEMPTS
	for attempt = 1, maxAttempts do
		local success, result = pcall(function()
			return checkpointStore:GetAsync(tostring(userId))
		end)
		if success then
			return true, result
		end
		if attempt < maxAttempts then
			-- attente progressive + petit aléa : tous les joueurs ne réessaient pas au même instant
			task.wait(math.min(attempt * 2, 10) + math.random())
		else
			warn(string.format("❌ Lecture checkpoint impossible pour %d après %d essais: %s",
				userId, maxAttempts, tostring(result)))
		end
	end
	return false, nil
end

-- Boucle d'écriture : UNE seule par joueur, elle écrit toujours la DERNIÈRE valeur voulue
-- (un vieil essai retardé ne peut donc jamais écraser une valeur plus récente).
local function runWriter(userId)
	if writerRunning[userId] then return end
	writerRunning[userId] = true
	activeWrites += 1
	local failures = 0
	while true do
		local target = wantedCheckpoint[userId]
		-- rien à écrire / lecture jamais confirmée (on n'écrase JAMAIS une progression inconnue) / déjà en base
		if not target or not progressLoaded[userId] or target == savedCheckpoint[userId] then
			break
		end
		local success, err = pcall(function()
			checkpointStore:SetAsync(tostring(userId), target)
		end)
		if success then
			savedCheckpoint[userId] = target
			failures = 0
			-- si la valeur voulue a changé pendant l'écriture, la boucle écrit la nouvelle
		else
			failures += 1
			if failures >= WRITE_ATTEMPTS then
				warn(string.format("⚠️ Sauvegarde checkpoint échouée pour %d (sera retentée): %s",
					userId, tostring(err)))
				break
			end
			task.wait(math.min(failures * 1.5, 6) + math.random())
		end
	end
	writerRunning[userId] = nil
	activeWrites -= 1
	-- Le joueur est parti : on nettoie ses états de persistance maintenant que l'écriture finale est terminée
	if leavingPlayers[userId] then
		leavingPlayers[userId] = nil
		progressLoaded[userId] = nil
		savedCheckpoint[userId] = nil
		wantedCheckpoint[userId] = nil
	end
end

-- Demande l'écriture d'un checkpoint (passe par la queue pour étaler les requêtes)
local function requestCheckpointWrite(userId, checkpointName)
	-- ⛔ Lecture pas encore réussie → on n'écrit RIEN (la vraie sauvegarde reste intacte)
	if not progressLoaded[userId] then return end
	wantedCheckpoint[userId] = checkpointName
	if savedCheckpoint[userId] == checkpointName then return end -- déjà en base
	queueDatastore(function()
		runWriter(userId)
	end)
end

-- far = touché alors que le joueur n'est pas sur le checkpoint (exploit) : sauvegardé comme avant, mais
--       les quêtes ne le comptent pas
local function saveCheckpoint(player, checkpointName, skipNotify, far)
	if not checkpointName then return end
	local userId = player.UserId
	-- ✅ Ne PAS sauvegarder si le joueur est en arène
	if _G.PlayersInArena[userId] then
		print("⚠️ " .. player.Name .. " est en arène, checkpoint ignoré")
		return
	end
	local current = sessionCheckpoints[userId]
	-- Éviter sauvegardes redondantes (sauf si c'est un skip)
	if current == checkpointName and not skipNotify then return end
	sessionCheckpoints[userId] = checkpointName
	-- Extraire le numéro pour le système de skip ET le leaderboard
	local checkpointNum = tonumber(string.match(checkpointName, "%d+"))
	local prevNum = playerCheckpoints[userId]
	if checkpointNum then
		-- ✅ FIX: Toujours mettre à jour le numéro actuel (pas seulement si plus grand)
		playerCheckpoints[userId] = checkpointNum
		-- 📊 Mettre à jour le leaderboard (TOUJOURS, même si diminue!)
		updateLeaderboard(player, checkpointNum)
	end
	-- 📣 Quêtes : checkpoint touché (un skip est signalé mais ne compte pas)
	notifyCheckpoint(player, checkpointNum, skipNotify and "skip" or (far and "far" or "touch"), prevNum)
	-- Notifier client
	task.spawn(function()
		pcall(function()
			checkpointEvent:FireClient(player, checkpointName)
			-- ✅ NOUVEAU: Notification supplémentaire pour les skips
			if skipNotify then
				skipNotificationEvent:FireClient(player, checkpointNum)
			end
		end)
	end)
	-- Sauvegarder en queue
	-- ✅ FIX: écriture protégée (jamais avant une lecture réussie, retentée, sans doublons)
	requestCheckpointWrite(userId, checkpointName)
end

