-- ========================================
-- QUEUE DATASTORE (Optimisée)
-- ========================================
local datastoreQueue = {}
local isProcessingQueue = false
local queueThread = nil

local function queueDatastore(operation)
	table.insert(datastoreQueue, operation)
	if not isProcessingQueue then
		isProcessingQueue = true
		-- ✅ Annuler l'ancien thread s'il existe
		if queueThread then
			task.cancel(queueThread)
		end
		queueThread = task.spawn(function()
			while #datastoreQueue > 0 do
				local op = table.remove(datastoreQueue, 1)
				if op then task.spawn(op) end
				task.wait(0.2)
			end
			isProcessingQueue = false
			queueThread = nil
		end)
	end
end

