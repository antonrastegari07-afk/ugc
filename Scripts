	flc.MaxTextSize = 16; flc.MinTextSize = 8

	return {
		main       = main,
		header     = header,
		content    = content,
		scroll     = scroll,
		footer     = footer,
		refreshLbl = refreshLbl,
	}
end

--==============================================================================
-- MOUNT  —  point d'entrée appelé par chaque LocalScript
--==============================================================================
function Core.mount(cfg)
	cfg.palette        = cfg.palette or {}
	cfg.entryHeight    = cfg.entryHeight or 68
	cfg.topSize        = cfg.topSize or 25
	cfg.refreshDelay   = cfg.refreshDelay or 120
	cfg.firstLoadDelay = cfg.firstLoadDelay or 3   -- C : plus de task.wait(80) !
	cfg.emptyText      = cfg.emptyText or "No data yet..."

	local ctx = {
		cfg          = cfg,
		boards       = {},
		data         = nil,
		stamp        = 0,      -- incrémenté à chaque nouveau jeu de données
		lastRefresh  = 0,
		isRefreshing = false,
	}

	local getFunc = ReplicatedStorage:WaitForChild(cfg.getFunctionName, 20)
	local updEvt  = cfg.updateEventName and ReplicatedStorage:WaitForChild(cfg.updateEventName, 20) or nil

	----------------------------------------------------------------
	-- déduplication + tri
	----------------------------------------------------------------
	local function dedupe(raw)
		local seen, out = {}, {}
		for _, e in ipairs(raw) do
			local k = tostring(e.userId)
			if e.userId and not seen[k] then
				seen[k] = true
				table.insert(out, e)
				local ks = knownStats[e.userId] or {}
				for f, v in pairs(e) do
					if f ~= "rank" then ks[f] = v end
				end
				knownStats[e.userId] = ks
			end
		end
		table.sort(out, function(a, b)
			return (a[cfg.valueKey] or 0) > (b[cfg.valueKey] or 0)
		end)
		for i, e in ipairs(out) do e.rank = i end
		return out
	end

	----------------------------------------------------------------
	-- rendu sur tous les boards
	----------------------------------------------------------------
	local function pushToBoards()
		for _, b in ipairs(ctx.boards) do
			if b.scroll and b.scroll.Parent then
				if b.loader then b.loader:Destroy(); b.loader = nil end
				b.view:render(ctx.data)
			end
		end
	end

	local function applyServerData(raw)
		if not raw or #raw == 0 then return end
		fetchVip()
		ctx.data        = dedupe(raw)
		ctx.stamp       = ctx.stamp + 1
		ctx.lastRefresh = os.clock()
		pushToBoards()
	end
	ctx.applyServerData = applyServerData

	----------------------------------------------------------------
	-- UN SEUL fetch pour tous les boards (C : moins de trafic remote)
	----------------------------------------------------------------
	local function refreshAll()
		if ctx.isRefreshing then return end
		ctx.isRefreshing = true
		ctx.lastRefresh  = os.clock()

		task.spawn(function()
			fetchVip()

			local data
			for _ = 1, 5 do
				if getFunc then
					local ok, res = pcall(function() return getFunc:InvokeServer() end)
					if ok and res and #res > 0 then data = res break end
				end
				task.wait(2)
			end

			ctx.isRefreshing = false

			if data then
				ctx.data        = dedupe(data)
				ctx.stamp       = ctx.stamp + 1
				ctx.lastRefresh = os.clock()
				pushToBoards()
			else
				-- pas encore de données côté serveur : nouvel essai dans 5s
				ctx.lastRefresh = os.clock() - cfg.refreshDelay + 5
				for _, b in ipairs(ctx.boards) do
					if b.loader then b.loader:Destroy(); b.loader = nil end
					if not ctx.data then b.view:showEmpty(cfg.emptyText) end
				end
			end
		end)
	end
	ctx.refreshAll = refreshAll

	----------------------------------------------------------------
	-- countdown (un seul thread pour tous les boards)
	----------------------------------------------------------------
	task.spawn(function()
		while true do
			task.wait(1)
			local txt, col
			if ctx.isRefreshing then
				txt = "Refreshing..."
				col = cfg.palette.accent2 or cfg.palette.accent1
			else
				local rem = math.max(0, math.floor(ctx.lastRefresh + cfg.refreshDelay - os.clock()))
				if rem == 0 then
					txt = "Refreshing soon..."
					col = cfg.palette.accent1
				else
					txt = string.format("Refresh in %d:%02d", math.floor(rem / 60), rem % 60)
					col = (rem <= 15) and cfg.palette.accent1 or cfg.palette.muted
				end
			end
			for _, b in ipairs(ctx.boards) do
				if b.refreshLbl and b.refreshLbl.Parent then
					b.refreshLbl.Text       = txt
					b.refreshLbl.TextColor3 = col
				end
			end
		end
	end)

	----------------------------------------------------------------
	-- boucle d'auto-refresh + nettoyage des boards détruits
	-- (C : le bug de fuite mémoire au swap de map)
	----------------------------------------------------------------
	task.spawn(function()
		while true do
			task.wait(1)
			for i = #ctx.boards, 1, -1 do
				local b = ctx.boards[i]
				if not (b.surfaceGui and b.surfaceGui.Parent and b.scroll and b.scroll.Parent
					and b.part and b.part:IsDescendantOf(Workspace)) then
					b.view:destroy()
					-- la copie cliquable vit dans le PlayerGui : on la retire aussi
					if b.surfaceGui and b.surfaceGui ~= b.src then b.surfaceGui:Destroy() end
					table.remove(ctx.boards, i)
				end
			end
			if #ctx.boards > 0 and not ctx.isRefreshing then
				if (os.clock() - ctx.lastRefresh) >= cfg.refreshDelay then
					refreshAll()
				end
			end
		end
	end)

	----------------------------------------------------------------
	-- événement serveur
	----------------------------------------------------------------
	if updEvt then
		updEvt.OnClientEvent:Connect(function(newData)
			applyServerData(newData)
		end)
	end

	----------------------------------------------------------------
	-- détection / init des boards
	----------------------------------------------------------------
	local nameSet = {}
	for _, n in ipairs(cfg.boardNames or {}) do nameSet[n] = true end

	local function isBoard(part)
		return part:IsA("BasePart") and nameSet[part.Name] == true
	end

	local function initBoard(part)
		local src = part:FindFirstChildOfClass("SurfaceGui")
		if not src then return end
		for _, b in ipairs(ctx.boards) do
			if b.part == part then return end
		end

		local sg = src
		if INTERACTIVE then
			-- 🖱️ Une SurfaceGui posée dans le Workspace ne reçoit NI survol NI
			--    clic. On l'affiche donc depuis le PlayerGui, collée au même part
			--    (Adornee), et on éteint l'originale. Même rendu, mais cliquable.
			sg = Instance.new("SurfaceGui")
			sg.Name             = "LB_" .. part.Name
			sg.Face             = src.Face
			sg.SizingMode       = src.SizingMode
			sg.PixelsPerStud    = src.PixelsPerStud
			sg.AlwaysOnTop      = src.AlwaysOnTop
			sg.ZOffset          = src.ZOffset
			sg.MaxDistance      = src.MaxDistance
			sg.ClipsDescendants = src.ClipsDescendants
			sg.ResetOnSpawn     = false
			sg.Adornee          = part
			sg.Parent           = LocalPlayer:WaitForChild("PlayerGui")
			src.Enabled         = false
		end

		sg.CanvasSize      = Vector2.new(1920, 1080)
		sg.LightInfluence  = 0
		sg.Brightness      = 1
		sg.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling

		local ui = buildBoardUI(cfg, sg)
		local b = {
			part       = part,
			src        = src,
			surfaceGui = sg,
			main       = ui.main,
			content    = ui.content,
			scroll     = ui.scroll,
			footer     = ui.footer,
			refreshLbl = ui.refreshLbl,
			loader     = nil,
		}
		b.view = Core.newListView(ui.scroll, cfg)
		table.insert(ctx.boards, b)

		if cfg.onBoardBuilt then
			pcall(cfg.onBoardBuilt, b, ctx)
		end

		if ctx.data then
			b.view:render(ctx.data)          -- board ajouté en cours de partie
		else
			b.loader = createLoader(ui.content, cfg)
			task.delay(cfg.firstLoadDelay, function()
				if not b.scroll.Parent then return end
				if not ctx.data then refreshAll() end
			end)
		end
	end
	ctx.initBoard = initBoard

	task.spawn(function()
		task.wait(2)
		for _, d in ipairs(Workspace:GetDescendants()) do
			if isBoard(d) then initBoard(d) end
		end
	end)

	Workspace.DescendantAdded:Connect(function(d)
		if isBoard(d) then
			task.wait(0.3)
			initBoard(d)
		end
	end)

	return ctx
end

return Core--[[
	LeaderboardManagerServer.lua        ⟦ v2 — blob borné ⟧
	------------------------------------------------------------------
	Gestionnaire UNIFIÉ pour 4 leaderboards all-time globaux :
	  • Points   (extra: rebirths)
	  • Rebirths
	  • Streak   (extra: highScore)
	  • Kills

	→ À placer dans ServerScriptService. Remplace la version précédente.
	→ Les LocalScripts ne changent PAS : mêmes Remotes, mêmes noms de champs.

	════════════════════════════════════════════════════════════════════
	🩹 CE QUI EST CORRIGÉ  —  « ValueTooLarge » sur LeaderboardProfiles_v1
	════════════════════════════════════════════════════════════════════
	L'ancienne version appelait markDirty() dans snapshotPlayer(), c'est-à-dire
	pour CHAQUE joueur en ligne, à CHAQUE passage de build et de save. Résultat :
	tout joueur ayant un jour rejoint le jeu finissait dans le blob, et n'en
	sortait jamais. La clé a fini par dépasser 4 MB, et depuis, PLUS AUCUNE
	écriture de profil ne passait — l'erreur revenait à chaque flush.

	Or ce blob ne sert qu'à UNE chose : afficher le nom d'un joueur HORS LIGNE
	qui figure dans un top. Il lui faut donc 125 entrées (50+25+25+25), pas des
	dizaines de milliers.

	Trois changements :

	  1. On ne marque « à persister » QUE les joueurs réellement présents dans
	     un board construit (+ ceux dont on vient de résoudre le nom). Un joueur
	     lambda qui joue trois heures n'écrit plus rien.

	  2. On ne persiste QUE les champs dont l'affichage a besoin : le nom, et
	     les `extras` déclarés par les boards (rebirths, highScore). Les valeurs
	     triées (points, streak, kills) viennent de l'OrderedDataStore — les
	     stocker ici était du poids mort.

	  3. Le blob est BORNÉ à MAX_PROFILES entrées, les plus récemment vues
	     gardées. La coupe se fait DANS la transaction, donc elle rétrécit la
	     clé même si elle est déjà trop grosse aujourd'hui : le premier flush
	     après déploiement répare tout seul.

	Il n'y a rien à supprimer à la main. Les entrées en trop partiront d'elles-
	mêmes au premier flush réussi.
--]]

local Players          = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage= game:GetService("ReplicatedStorage")
local HttpService      = game:GetService("HttpService")
local RT               = Enum.DataStoreRequestType

-- ========================================================================
-- CONFIG GÉNÉRALE
-- ========================================================================
local SAVE_INTERVAL       = 120   -- sauvegarde des valeurs (s)
local BUILD_INTERVAL      = 120   -- reconstruction + broadcast (s)
local BUILD_STAGGER       = 2     -- délai entre chaque board dans un cycle de build
local SAVE_THROTTLE       = 0.3   -- délai entre chaque SetAsync
local INITIAL_BUILD_DELAY = 10    -- 1er build rapide (puis events au fil de l'eau)

local PROFILE_STORE_NAME  = "LeaderboardProfiles_v1"
local PROFILE_BLOB_KEY    = "profiles"

--  Combien de profils on garde. Les boards en demandent 125 ; la marge sert
--  aux joueurs qui entrent et sortent du top entre deux cycles.
--  ⚠️ Ne monte pas ça à la légère : c'est ce plafond qui empêche la clé de
--     redevenir illisible. 1500 entrées ≈ 150 KB, très loin de la limite.
local MAX_PROFILES   = 1500
local MAX_BLOB_BYTES = 1024 * 1024   -- 1 MB : on coupe bien avant les 4 MB de Roblox

-- ========================================================================
-- ACCÈS AUX STATS JOUEUR
-- ========================================================================
local function getLeaderstat(player, statName)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then return 0 end
	local v = ls:FindFirstChild(statName)
	return v and math.floor(v.Value) or 0
end

local function getKills(player)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local k = ls:FindFirstChild("Kills")
		if k then return math.floor(k.Value) end
	end
	local attr = player:GetAttribute("TotalKills") or player:GetAttribute("Kills")
	return attr and math.floor(attr) or 0
end

local profileCache = {}   -- [userId] = { name, points, rebirths, streak, highScore, kills }
local profileDirty = {}   -- [userId] = true   (à persister au prochain flush)
local lastPersisted = {}  -- [userId] = signature déjà écrite (évite de réécrire l'identique)

local function markDirty(userId)
	profileDirty[userId] = true
end

--  ⚠️ NE MARQUE PLUS DIRTY. C'était la fuite : cette fonction tourne pour
--     chaque joueur en ligne à chaque cycle. Le cache mémoire est gratuit,
--     l'écriture ne l'est pas. Ce sont buildBoard() et resolveName() qui
--     décident maintenant qui mérite d'être persisté.
local function snapshotPlayer(player)
	local id   = player.UserId
	local prof = profileCache[id] or {}
	prof.name      = player.DisplayName or player.Name
	prof.points    = getLeaderstat(player, "Points")
	prof.rebirths  = getLeaderstat(player, "Rebirths")
	prof.streak    = math.floor(player:GetAttribute("FlameStreak")    or 0)
	prof.highScore = math.floor(player:GetAttribute("FlameHighScore") or 0)
	prof.kills     = getKills(player)
	profileCache[id] = prof
	return prof
end

-- ========================================================================
-- DÉFINITION DES BOARDS
--   field  = clé du profil utilisée comme valeur triée (et nom du champ
--            renvoyé au client)
--   extras = champs secondaires supplémentaires renvoyés au client
-- ========================================================================
local BOARD_LIST = {
	{
		id           = "Points",
		store        = "GlobalLeaderboard_Points_v3",
		topSize      = 100,
		field        = "points",
		extras       = { "rebirths" },
		updateRemote = "PointsLeaderboardUpdate",
		getRemote    = "GetPointsLeaderboard",
	},
	{
		id           = "Rebirths",
		store        = "GlobalLeaderboard_Rebirths_v1",
		topSize      = 100,
		field        = "rebirths",
		extras       = {},
		updateRemote = "RebirthLeaderboardUpdate",
		getRemote    = "GetRebirthLeaderboard",
	},
	{
		id           = "Streak",
		store        = "GlobalLeaderboard_Streak_v1",
		topSize      = 100,
		field        = "streak",
		extras       = { "highScore" },
		updateRemote = "StreakLeaderboardUpdate",
		getRemote    = "GetStreakLeaderboard",
	},
	{
		id           = "Kills",
		store        = "GlobalLeaderboard_Kills_v1",
		topSize      = 100,
		field        = "kills",
		extras       = {},
		updateRemote = "KillLeaderboardUpdate",
		getRemote    = "GetKillLeaderboard",
	},
}

local BOARD_BY_ID = {}
for _, b in ipairs(BOARD_LIST) do BOARD_BY_ID[b.id] = b end

--  Champs réellement persistés : le nom, plus les `extras` de chaque board.
--  Déduit de BOARD_LIST : si tu ajoutes un extra à un board, il est persisté
--  automatiquement, sans rien toucher ici.
local PERSISTED_FIELDS = { name = true }
for _, b in ipairs(BOARD_LIST) do
	for _, ek in ipairs(b.extras) do PERSISTED_FIELDS[ek] = true end
end

local function persistShape(prof)
	if type(prof) ~= "table" then return nil end
	local out = { t = os.time() }
	for k in pairs(PERSISTED_FIELDS) do
		if prof[k] ~= nil then out[k] = prof[k] end
	end
	return out
end

--  Signature de ce qui sera écrit : si elle n'a pas bougé, inutile de
--  réécrire la même chose toutes les deux minutes.
local function persistSignature(prof)
	if type(prof) ~= "table" then return "" end
	local parts = {}
	for k in pairs(PERSISTED_FIELDS) do
		parts[#parts + 1] = k .. "=" .. tostring(prof[k])
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

--  Marque un joueur à persister UNIQUEMENT si son profil affiché a changé.
local function markIfChanged(userId)
	local prof = profileCache[userId]
	if not prof then return end
	local sig = persistSignature(prof)
	if lastPersisted[userId] ~= sig then
		profileDirty[userId] = true
	end
end

-- ========================================================================
-- STORES & REMOTES
-- ========================================================================
local orderedStores = {}
for _, b in ipairs(BOARD_LIST) do
	orderedStores[b.id] = DataStoreService:GetOrderedDataStore(b.store)
end
local profileStore = DataStoreService:GetDataStore(PROFILE_STORE_NAME)

local function getOrCreate(name, class)
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r then
		r = Instance.new(class or "RemoteEvent")
		r.Name   = name
		r.Parent = ReplicatedStorage
	end
	return r
end

local updateEvents = {}
local getFuncs     = {}
for _, b in ipairs(BOARD_LIST) do
	updateEvents[b.id] = getOrCreate(b.updateRemote, "RemoteEvent")
	getFuncs[b.id]     = getOrCreate(b.getRemote, "RemoteFunction")
end

local openAdminPanelEvent = getOrCreate("OpenAdminPointsPanel", "RemoteEvent")

-- ========================================================================
-- CACHES DE SORTIE
-- ========================================================================
local cachedBoards = {}   -- [boardId] = liste d'entrées prêtes pour le client
local lastSaved    = {}   -- [boardId][userId] = dernière valeur écrite (dirty-tracking)
for _, b in ipairs(BOARD_LIST) do
	cachedBoards[b.id] = {}
	lastSaved[b.id]    = {}
end

-- ========================================================================
-- BUDGET
-- ========================================================================
local function budgetOK(reqType)
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(reqType)
	end)
	-- en cas d'échec de lecture du budget, on autorise (comportement prudent côté pcall)
	return (not ok) or (budget == nil) or (budget > 0)
end

-- ========================================================================
-- PROFIL BLOB (noms + champs secondaires, partagé entre tous les boards)
-- ========================================================================
local function loadProfileBlob()
	local ok, stored = pcall(function()
		return profileStore:GetAsync(PROFILE_BLOB_KEY)
	end)
	if ok and type(stored) == "table" then
		local n = 0
		for k, v in pairs(stored) do
			local id = tonumber(k)
			if id and type(v) == "table" and not profileCache[id] then
				profileCache[id] = v
				lastPersisted[id] = persistSignature(v)
				n = n + 1
			end
		end
		print(string.format("📇 %d profil(s) chargé(s) depuis %s", n, PROFILE_STORE_NAME))
	elseif not ok then
		warn("⚠️ Lecture du blob de profils impossible — les noms hors ligne "
			.. "seront résolus un par un (plus lent, mais rien n'est cassé).")
	end
end

--  ✂️ Borne le blob. Appelée DANS la transaction, donc elle rétrécit la clé
--     même quand elle est déjà au-dessus de la limite — c'est ce qui répare
--     une clé devenue trop grosse sans intervention manuelle.
--
--     On garde les entrées vues le plus récemment. Les joueurs actuellement
--     dans un top sont rafraîchis à chaque build : ils sont donc toujours en
--     tête et ne peuvent pas être coupés.
local function pruneBlob(tbl)
	local list = {}
	for k, v in pairs(tbl) do
		if type(v) == "table" then
			list[#list + 1] = { k = k, t = tonumber(v.t) or 0 }
		else
			tbl[k] = nil       -- entrée corrompue : elle ne sert à rien
		end
	end

	if #list == 0 then return tbl end

	-- Plus récent d'abord. Les vieilles fiches (sans `t`, donc t = 0) partent
	-- les premières : ce sont justement celles de l'ancien système qui
	-- stockaient tout le monde.
	table.sort(list, function(a, b) return a.t > b.t end)

	local keep = math.min(#list, MAX_PROFILES)

	-- Garde-fou dur : si malgré le plafond le JSON reste trop lourd (vieilles
	-- fiches obèses), on resserre jusqu'à passer sous la barre.
	for _ = 1, 10 do
		for i = keep + 1, #list do tbl[list[i].k] = nil end

		local okEnc, json = pcall(function() return HttpService:JSONEncode(tbl) end)
		if not okEnc then break end
		if #json <= MAX_BLOB_BYTES then break end

		keep = math.floor(keep * 0.6)
		if keep < 200 then keep = 200 end
		if keep >= #list then break end
	end

	return tbl
end

-- 1 SEUL write pour tous les profils marqués "dirty".
local function flushProfiles()
	if next(profileDirty) == nil then return end
	if not budgetOK(RT.UpdateAsync) then return end -- on retentera au prochain cycle

	local batch, sigs = {}, {}
	for id in pairs(profileDirty) do
		local shaped = persistShape(profileCache[id])
		if shaped then
			batch[tostring(id)] = shaped
			sigs[id] = persistSignature(profileCache[id])
		end
	end
	profileDirty = {}

	local ok = pcall(function()
		profileStore:UpdateAsync(PROFILE_BLOB_KEY, function(old)
			old = (type(old) == "table") and old or {}
			for k, v in pairs(batch) do
				old[k] = v
			end
			return pruneBlob(old)
		end)
	end)

	if ok then
		-- On ne retient la signature qu'après une écriture réussie : sinon un
		-- échec ferait croire que la valeur est persistée et on ne réessaierait
		-- jamais.
		for id, sig in pairs(sigs) do lastPersisted[id] = sig end
	else
		warn("⚠️ Écriture du blob de profils échouée — les profils seront "
			.. "réessayés au prochain cycle.")
		for id in pairs(sigs) do profileDirty[id] = true end
	end
end

local function removeProfileFromBlob(userId)
	pcall(function()
		profileStore:UpdateAsync(PROFILE_BLOB_KEY, function(old)
			if type(old) == "table" then old[tostring(userId)] = nil end
			return old
		end)
	end)
	lastPersisted[userId] = nil
end

-- ========================================================================
-- RÉSOLUTION DE NOM (rare : entrée offline jamais vue)
-- ========================================================================
local function resolveName(userId)
	local prof = profileCache[userId]
	if prof and prof.name then return prof.name end

	local online = Players:GetPlayerByUserId(userId)
	if online then
		local nm = online.DisplayName or online.Name
		profileCache[userId] = profileCache[userId] or {}
		profileCache[userId].name = nm
		markDirty(userId)   -- ce joueur figure dans un top : il mérite sa fiche
		return nm
	end

	local ok, uname = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local resolved = (ok and uname) or ("Player_" .. userId)
	profileCache[userId] = profileCache[userId] or {}
	profileCache[userId].name = resolved
	markDirty(userId)
	return resolved
end

-- ========================================================================
-- LIRE LE TOP TRIÉ (1 page, 1 GetSortedAsync)
-- ========================================================================
local function fetchSortedTop(board)
	local results = {}
	if not budgetOK(RT.GetSortedAsync) then return results end

	local store = orderedStores[board.id]
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, board.topSize, 1, 1000000000)
	end)
	if not ok or not pages then
		warn(string.format("❌ [%s] Erreur GetSortedAsync", board.id))
		return results
	end

	local ok2, page = pcall(function() return pages:GetCurrentPage() end)
	if not ok2 or not page then return results end

	for _, e in ipairs(page) do
		local uid = tonumber(e.key)
		if uid then
			results[#results + 1] = { userId = uid, value = e.value }
		end
	end
	return results
end

-- ========================================================================
-- CONSTRUIRE UN BOARD (online frais + offline depuis le store)
-- ========================================================================
local function buildBoard(board)
	local field  = board.field
	local sorted = fetchSortedTop(board)

	local merged = {}
	local seen   = {}

	-- 1) Joueurs en ligne = valeurs fraîches (prioritaires)
	for _, p in ipairs(Players:GetPlayers()) do
		local prof = snapshotPlayer(p)
		local v    = prof[field] or 0
		if v > 0 then
			local id = p.UserId
			if not seen[id] then
				seen[id] = true
				merged[#merged + 1] = { userId = id, name = prof.name, value = v, prof = prof }
			end
		end
	end

	-- 2) Joueurs hors ligne depuis l'OrderedDataStore
	for _, e in ipairs(sorted) do
		if not seen[e.userId] then
			seen[e.userId] = true
			local prof = profileCache[e.userId]
			merged[#merged + 1] = {
				userId = e.userId,
				name   = prof and prof.name or nil, -- résolu plus bas si manquant
				value  = e.value,
				prof   = prof,
			}
		end
	end

	-- 3) Résoudre les noms manquants (rare, throttlé)
	for _, m in ipairs(merged) do
		if not m.name then
			m.name = resolveName(m.userId)
			m.prof = profileCache[m.userId]
			task.wait(0.1)
		end
	end

	-- 4) Trier + couper au topSize
	table.sort(merged, function(a, b) return a.value > b.value end)

	local result = {}
	local limit  = math.min(board.topSize, #merged)
	for i = 1, limit do
		local m = merged[i]
		local entry = {
			rank   = i,
			name   = m.name,
			userId = m.userId,
			[field]= m.value,
		}
		for _, ek in ipairs(board.extras) do
			entry[ek] = (m.prof and m.prof[ek]) or 0
		end
		result[#result + 1] = entry

		--  📇 C'EST ICI, et nulle part ailleurs, qu'on décide de persister un
		--     profil : ce joueur est affiché dans un top, donc son nom devra
		--     être lisible même quand il sera hors ligne. Les autres joueurs
		--     ne coûtent rien.
		markIfChanged(m.userId)
	end

	return result
end

local function broadcast(board, data)
	pcall(function()
		updateEvents[board.id]:FireAllClients(data)
	end)
end

-- ========================================================================
-- SAUVEGARDE (dirty-tracking : on n'écrit que ce qui a changé)
-- ========================================================================
local function savePass()
	for _, p in ipairs(Players:GetPlayers()) do
		local prof = snapshotPlayer(p)
		local id   = p.UserId
		for _, board in ipairs(BOARD_LIST) do
			local v = prof[board.field] or 0
			if v > 0 and lastSaved[board.id][id] ~= v then
				if budgetOK(RT.SetIncrementSortedAsync) then
					local ok = pcall(function()
						orderedStores[board.id]:SetAsync(tostring(id), v)
					end)
					if ok then lastSaved[board.id][id] = v end
					task.wait(SAVE_THROTTLE)
				end
			end
		end
	end
	flushProfiles() -- 1 seul write pour tous les profils
end

