	valBox.Name                   = "Value"
	valBox.Position               = UDim2.new(0.24, 0, 0.52, 0)
	valBox.Size                   = UDim2.new(0.60, 0, 0.42, 0)
	valBox.BackgroundTransparency = 1
	valBox.ZIndex                 = 5
	valBox.Parent                 = body
	local vLayout = Instance.new("UIListLayout")
