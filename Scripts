-- ════════════════════════════════════════════════════════════
-- LOG GLOBAL (buckets journaliers)
-- ════════════════════════════════════════════════════════════
local function readMeta(force)
	local now = os.time()
	-- "force" ne relit que si le cache a plus de 10 s → pas de spam au refresh
	if metaCache and (now - metaAt) < (force and 10 or META_TTL) then return metaCache end
	local ok, data = pcall(function() return LOG_STORE:GetAsync(META_KEY) end)
	if not ok then return metaCache end
	if type(data) ~= "table" or type(data.buckets) ~= "table" then data = { buckets = {} } end
	metaCache, metaAt = data, now
	for _, b in ipairs(data.buckets) do registered[b] = true end
	return data
end

local function registerBucket(key)
	if registered[key] then return end
	local ok = pcall(function()
		LOG_STORE:UpdateAsync(META_KEY, function(old)
			if type(old) ~= "table" or type(old.buckets) ~= "table" then old = { buckets = {} } end
			for _, b in ipairs(old.buckets) do if b == key then return nil end end
			table.insert(old.buckets, key)
			return old
		end)
	end)
	if ok then registered[key] = true; metaAt = 0 end
end

local function writeEntry(entry)
	local t = os.date("!*t", os.time())
	local base = string.format("b_%04d%02d%02d", t.year, t.month, t.day)
	local start = bucketSuffix[base] or 1          -- ⚡ reprend où on s'était arrêté
	for suffix = start, start + 29 do
		local key, full = base .. "_" .. suffix, false
		local ok = pcall(function()
			LOG_STORE:UpdateAsync(key, function(old)
				if type(old) ~= "table" or type(old.entries) ~= "table" then old = { entries = {} } end
				if #old.entries >= MAX_PER_BUCKET then full = true; return nil end
				table.insert(old.entries, entry)
				return old
			end)
		end)
		if not ok then return false end
		if not full then
			bucketSuffix[base] = suffix
			registerBucket(key)
			return true
		end
		bucketSuffix[base] = suffix + 1
	end
	return false
end

-- ════════════════════════════════════════════════════════════
-- FICHE JOUEUR + CLASSEMENTS
-- ════════════════════════════════════════════════════════════
local function updatePlayerRecord(userId, item, countSpent)
	local newCount, newSpent = 0, 0
	local ok = pcall(function()
		P_STORE:UpdateAsync("u_" .. userId, function(old)
			if type(old) ~= "table" then old = { c = 0, sp = 0, fr = 0, it = {} } end
			old.c  = (tonumber(old.c) or 0) + 1
			if countSpent then old.sp = (tonumber(old.sp) or 0) + (item.p or 0) end
			if item.f then old.fr = (tonumber(old.fr) or 0) + 1 end
			old.lt = item.t
			if type(old.it) ~= "table" then old.it = {} end
			table.insert(old.it, item)
			while #old.it > MAX_PLAYER_ITEMS do table.remove(old.it, 1) end
			newCount, newSpent = old.c, old.sp or 0
			return old
		end)
	end)
	if not ok then return end
	pCache[userId] = nil
	return newCount, newSpent
end

