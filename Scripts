		end
		print("🔄 Tous les leaderboards reconstruits après modification admin")
	end)
end

local function deletePlayerEntry(targetUserId)
	targetUserId = tonumber(targetUserId)
	if not targetUserId then
		warn("❌ DeletePlayerEntry: userId invalide")
		return false
	end

	for _, board in ipairs(BOARD_LIST) do
		pcall(function()
			orderedStores[board.id]:RemoveAsync(tostring(targetUserId))
		end)
		lastSaved[board.id][targetUserId] = nil

		local c = cachedBoards[board.id]
		for i = #c, 1, -1 do
			if c[i].userId == targetUserId then table.remove(c, i) end
		end
		for i, e in ipairs(c) do e.rank = i end
	end

	profileCache[targetUserId] = nil
	profileDirty[targetUserId] = nil
	removeProfileFromBlob(targetUserId)
	rebuildAll()

	print(string.format("🗑️ Joueur %d supprimé de tous les boards", targetUserId))
	return true
end

local function deleteByRank(boardId, rank)
	local board = BOARD_BY_ID[boardId]
	if not board then
		warn(string.format("❌ deleteByRank: board '%s' inconnu", tostring(boardId)))
		return false
	end
	rank = tonumber(rank)
	local entry = rank and cachedBoards[boardId][rank]
	if not entry then
		warn(string.format("❌ deleteByRank: aucune entrée au rang #%s sur %s", tostring(rank), boardId))
		return false
	end
	print(string.format("🎯 Suppression %s #%d → %s (userId: %d)", boardId, rank, entry.name, entry.userId))
	return deletePlayerEntry(entry.userId)
end

_G.DeletePlayerEntry = deletePlayerEntry
_G.DeleteByRank      = deleteByRank

