-- ════════════════════════════════════════════════════════════
-- REMOTES ADMIN (rate limit séparé par remote)
-- ════════════════════════════════════════════════════════════
local function rl(userId, tag, sec)
	local k, now = userId .. ":" .. tag, os.clock()
	if rateLimit[k] and (now - rateLimit[k]) < (sec or 0.6) then return false end
	rateLimit[k] = now
	return true
end

getLog.OnServerInvoke = function(player, cursor, wanted)
	if not isAdmin(player.UserId) then return { entries = {} } end
	-- ⚡ On ATTEND son tour au lieu de répondre « occupé » : le client
	--    s'arrêtait au premier refus → seulement 1-2 jours chargés.
	local t0 = os.clock()
	while not rl(player.UserId, "log", 0.15) do
		if os.clock() - t0 > 4 then return { entries = {}, cursor = cursor, hasMore = true, throttled = true } end
		task.wait(0.05)
	end
	wanted = math.clamp(tonumber(wanted) or 30, 5, 80)
	local meta = readMeta(cursor == nil)
	if not meta then return { entries = {}, error = "DataStore unavailable" } end
	local buckets = meta.buckets or {}
	local i, out, reads = tonumber(cursor) or #buckets, {}, 0
	while i >= 1 and #out < wanted and reads < 6 do
		local key = buckets[i]; reads += 1
		local ok, data = pcall(function() return LOG_STORE:GetAsync(key) end)
		if ok and type(data) == "table" and type(data.entries) == "table" then
			for j = #data.entries, 1, -1 do
				local e = data.entries[j]
				if type(e) == "table" then table.insert(out, e) end
			end
		end
		i -= 1
	end
	return { entries = out, cursor = i, hasMore = i >= 1 }
end

getTop.OnServerInvoke = function(player, metric, n)
	if not isAdmin(player.UserId) then return { entries = {} } end
	if not rl(player.UserId, "top") then return { entries = {} } end
	n = math.clamp(tonumber(n) or 50, 1, 100)
	local store = (metric == "spent") and RANK_SPENT or RANK_COUNT
	local ok, pages = pcall(function() return store:GetSortedAsync(false, n) end)
	if not ok or not pages then return { entries = {} } end
	local out = {}
	local okPage, page = pcall(function() return pages:GetCurrentPage() end)
	if okPage and type(page) == "table" then
		for _, e in ipairs(page) do
			local uid = tonumber(e.key)
			if uid then table.insert(out, { userId = uid, value = e.value }) end
		end
	end
	return { entries = out, metric = (metric == "spent") and "spent" or "count" }
end

getUserFn.OnServerInvoke = function(player, targetUserId)
	if not isAdmin(player.UserId) then return nil end
	if not rl(player.UserId, "user") then return nil end
	return _G.UGCRedeem_GetPlayer(tonumber(targetUserId))
end

-- ════════════════════════════════════════════════════════════
-- 🧹 NETTOYAGE MÉMOIRE (toutes les 5 min)
-- ════════════════════════════════════════════════════════════
task.spawn(function()
	while true do
		task.wait(300)
		local now, clk = os.time(), os.clock()
		for k, t in pairs(recentDedup) do
			if now - t > 600 then recentDedup[k] = nil end
		end
		for uid, c in pairs(pCache) do
			if (clk - c.t) > 300 and not Players:GetPlayerByUserId(uid) then pCache[uid] = nil end
		end
		for uid in pairs(ownCache) do
			if not Players:GetPlayerByUserId(uid) then ownCache[uid] = nil end
		end
		for k in pairs(auditDone) do
			local uid = tonumber(tostring(k):match("^(%d+)"))
			if uid and not Players:GetPlayerByUserId(uid) then auditDone[k] = nil end
		end
		for uid, d in pairs(devProdAt) do
			if type(d) ~= "table" or (now - d.t) > 1800 then devProdAt[uid] = nil end
		end
		for k in pairs(rateLimit) do
			if (clk - rateLimit[k]) > 300 then rateLimit[k] = nil end
		end
	end
end)

Players.PlayerRemoving:Connect(function(p)
