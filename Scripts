-- COMMANDES CHAT ADMIN
--   !delete <userId>          → supprime de tous les boards
--   !deleterank <board> <#>   → ex: !deleterank Points 5
--   !pointspanel              → ouvre le panneau admin Points
-- ========================================================================
Players.PlayerAdded:Connect(function(player)
	player.Chatted:Connect(function(msg)
		if not isAdmin(player) then return end
		local lower = msg:lower()

		if lower == "!pointspanel" then
			openAdminPanelEvent:FireClient(player, cachedBoards["Points"])
			print(string.format("📊 [Admin %s] panneau Points (%d entrées)", player.Name, #cachedBoards["Points"]))
			return
		end

		local userId = msg:match("^!delete%s+(%d+)$")
		if userId then
			deletePlayerEntry(userId)
			return
		end

		local bId, rank = msg:match("^!deleterank%s+(%a+)%s+(%d+)$")
		if bId and rank then
			-- normalise la casse vers un id de board connu
			for id in pairs(BOARD_BY_ID) do
				if id:lower() == bId:lower() then bId = id break end
			end
			deleteByRank(bId, rank)
		end
	end)
end)

