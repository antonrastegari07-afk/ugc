-- 👁️ VUE ENVOYÉE AU CLIENT (seulement ce qui le concerne)
-- ════════════════════════════════════════════════════════════════
local function jackSummary(player)
	if not (C.Jack and C.Jack.ShowInQuests) then return nil end
	if type(_G.JackQuestSummary) ~= "function" then return nil end
	local ok, res = pcall(_G.JackQuestSummary, player)
	return ok and res or nil
end

local function freeRerollsLeft(d)
	return math.max(0, (Q.FreeRerollsPerDay or 0) - (d.rr.used or 0))
end

local function nextTier(d)
	for i, t in ipairs(TIERS) do
		if not d.tiers[t.Id] then return i end
	end
	return nil
end

local function buildView(player)
	local uid = player.UserId
	if not allowed(uid) or not visibleFor(uid) then return { hidden = true } end
	local st = pd(uid)
	if not st then return { loading = true, start = START, finish = FINISH, now = now() } end
	local t = now()
	if ensurePeriods(st.d, t) then touch(st) end
	local d = st.d
	local function list(w)
		local out = {}
		for i, e in ipairs(d[w].list) do
			out[i] = { id = e.id, n = e.n, c = e.c == true }
		end
		return out
	end
	local owned = {}
	for i, tier in ipairs(TIERS) do owned[i] = d.tiers[tier.Id] ~= nil end
	return {
		now = t, start = START, finish = FINISH, active = activeFor(uid, t), realActive = active(t),
		tester = isTester(uid) or nil,
		testFree = (isTester(uid) and TM.FreePurchases ~= false) or nil,       -- achats Robux gratuits possibles (voir freeBuy)
		testAllFree = (isTester(uid) and freeBuy(uid, 1)) or nil,              -- … même pour les produits déjà créés
		coins = d.coins, owned = owned, nextTier = nextTier(d),
		daily = { ends = dayEnds(t), list = list("daily") },
		weekly = { ends = weekEnds(t), list = list("weekly") },
		free = freeRerollsLeft(d), credits = d.rr.credits or 0,
		zone = { got = d.zone.got, cap = Z.DailyCap or 0 },
		jack = jackSummary(player),
		frozen = st.frozen == true,
		scythe = (scytheStockOn and SCY.ShowStock ~= false) and { stock = SCY_STOCK, left = scytheLeft, mine = scytheMine(uid) or nil } or nil,
		hint = d.hint == true or nil,
	}
end

local viewDue = {}
local function pushView(player, immediate)
	local uid = player.UserId
	if immediate then
		viewDue[uid] = nil
		push(player, "view", buildView(player))
		return
	end
	if viewDue[uid] then return end
	viewDue[uid] = true
	task.delay(0.4, function()
		if viewDue[uid] and player.Parent then
			viewDue[uid] = nil
			push(player, "view", buildView(player))
		end
	end)
end

