-- 🔁 QUÊTES : tirage par période
-- ════════════════════════════════════════════════════════════════
local rng = Random.new()

local function pick(pool, perDiff, avoid)
	local out = {}
	for _, diff in ipairs(DIFFS) do
		local want = (perDiff and perDiff[diff]) or 0
		local cands, fallback = {}, {}
		for _, q in ipairs(pool) do
			if q.Diff == diff then
				table.insert(fallback, q)
				if not (avoid and avoid[q.Id]) then table.insert(cands, q) end
			end
		end
		if #cands < want then cands = fallback end
		for _ = 1, want do
			if #cands == 0 then break end
			local i = rng:NextInteger(1, #cands)
			table.insert(out, { id = cands[i].Id, n = 0, c = false })
			table.remove(cands, i)
		end
	end
	return out
end

local function ensurePeriods(d, t)
	local changed = false
	local di, wi = dayIndex(t), weekIndex(t)
	if d.daily.p ~= di then
		local avoid = {}
		for _, e in ipairs(d.daily.list) do avoid[e.id] = true end     -- pas les mêmes qu'hier si possible
		d.daily = { p = di, list = pick(Q.Daily or {}, Q.DailyPerDiff, avoid) }
		changed = true
	end
	if d.weekly.p ~= wi then
		local avoid = {}
		for _, e in ipairs(d.weekly.list) do avoid[e.id] = true end
		d.weekly = { p = wi, list = pick(Q.Weekly or {}, Q.WeeklyPerDiff, avoid) }
		changed = true
	end
	if d.rr.day ~= di then d.rr.day, d.rr.used = di, 0 changed = true end
	if d.zone.day ~= di then d.zone.day, d.zone.got = di, 0 changed = true end
	return changed
end

local function entryDone(e)
	local def = QDEF[e.id]
	return def ~= nil and e.n >= goalOf(def)
end

