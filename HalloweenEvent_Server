-- 👤 CYCLE DE VIE
-- ════════════════════════════════════════════════════════════════
local leaving = {}

local function onPlayer(player)
	local uid = player.UserId
	if not allowed(uid) then return end
	while leaving[uid] do task.wait(0.2) end
	P[uid] = { ver = 0, savedVer = 0 }
	motion[uid] = { travel = 0 }
	local syncWins, syncReb
	watchStage(player)
	syncReb = watchCounter(player, "RebirthCount", "rebirth")
	syncWins = watchCounter(player, "ArenaWins", "roundwin")
	if player.Character then task.spawn(watchCharacter, player, player.Character) end
	player.CharacterAdded:Connect(function(char)
		local m = motion[uid]
		if m then m.pos = nil end                    -- le respawn n'est pas une téléportation
		task.spawn(watchCharacter, player, char)
		task.delay(2, function() if player.Parent then refreshTools(player) end end)
	end)
	player:GetAttributeChangedSignal("InArena"):Connect(function()
		if player:GetAttribute("InArena") then return end
		task.delay(1, function() if player.Parent then refreshTools(player) end end)
	end)

	-- SEC1 : chargement (on réessaie tant que le DataStore ne répond pas)
	task.spawn(function()
		local d
		while player.Parent and not d do
			d = load(uid)
			if not d then task.wait(10) end
		end
		if not player.Parent or not d then
			if d then storeUpdate(key(uid), function(old)          -- parti pendant le chargement : on rend le verrou
					if type(old) == "table" and type(old.lock) == "table" and old.lock.job == JOB then old.lock = nil return old end
					return nil
				end) end
			return
		end
		local st = P[uid]
		if not st then return end
		-- une série « sans mourir » ou « de kills » ne survit pas à une déconnexion
		for _, w in ipairs({ "daily", "weekly" }) do
			for _, e in ipairs(d[w].list) do
				local def = QDEF[e.id]
				if def and not e.c and (def.Kind == "nodeath" or def.Kind == "killstreak") and e.n < goalOf(def) then e.n = 0 end
			end
		end
		st.d = d
		if ensurePeriods(d, now()) then touch(st) end
		log("💾 sauvegarde chargée pour", player.Name, "coins =", d.coins)
		if visibleFor(uid) then player:SetAttribute("HalloweenPass", true) end      -- Jack propose alors d'ouvrir la fenêtre
		pushView(player, true)

		-- SEC4 : « posé » = tes points chargés + quelques secondes (Stage / Rebirth / Wins à leur vraie valeur)
		local t0 = os.clock()
		while player.Parent and not pointsReady(uid) and os.clock() - t0 < 120 do task.wait(0.5) end
		task.wait(R.SettleDelay or 3)
		if not player.Parent or P[uid] ~= st then return end
		local ls = player:FindFirstChild("leaderstats")
		local stg = ls and ls:FindFirstChild("Stage")
		if stg then
			st.lastStage = tonumber(stg.Value) or 0
			d.ms = math.max(d.ms or 0, st.lastStage)
		end
		syncReb()
		syncWins()
		st.settled = true
		refreshTools(player)
		if next(d.pend) then task.spawn(deliverPending, player) end      -- récompenses pas encore versées (panne, départ…)
		-- 🎃 palier de la faux acheté mais faux pas encore reçue (panne au mauvais moment) : on la redonne
		for _, tier in ipairs(TIERS) do
			if tier.Reward and tier.Reward.Kind == "scythe" and d.tiers[tier.Id] then
				task.spawn(giveScythe, player)
			end
		end
		pushView(player, true)
		log("✅ données posées pour", player.Name)
	end)
end

