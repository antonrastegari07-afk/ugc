-- 💸 ROBUX (le prompt part d'ici ; le reçu revient par _G.HalloweenEventReceipt)
-- ════════════════════════════════════════════════════════════════
local rerollTarget = {}    -- [uid] = { which } : la section à renouveler quand le reçu arrive

local function skippable(d, uid)
	local n = 0
	local blocked = uid ~= nil and scytheSoldOutFor(uid)
	for i, t in ipairs(TIERS) do
		if not d.tiers[t.Id] then
			if blocked and tierHasScythe(t) then break end          -- faux épuisée : on ne peut pas sauter au-delà
			if C.Robux.SkipCanBuyFinal ~= false or i < #TIERS then n += 1 end
		end
	end
	return n
end

-- applique un produit (vrai reçu Robux, ou achat simulé d'un testeur : isTest = true → pas noté dans rc)
--  renvoie true si c'est fait (ou déjà fait), false = à réessayer plus tard
local function applyProduct(player, prod, pid, isTest)
	local uid = player.UserId
	local st = pd(uid)
	if not st or st.frozen or not settledOk(uid) then return false end
	if not isTest and table.find(st.d.rc, pid) then return true end              -- SEC11 : déjà appliqué
	if prod.kind == "skip" and not pointsReady(uid) then return false end         -- les paliers peuvent verser des points
	local t0 = os.clock()
	while st.busy and os.clock() - t0 < 15 do task.wait(0.2) end
	if st.busy then return false end
	-- 📦 le skip arrive jusqu'à la faux ? → numéro réservé d'abord (épuisé : on s'arrête avant, le reste est remboursé en coins)
	local scyOk = true
	if prod.kind == "skip" then
		local reach, k = false, 0
		for i, t in ipairs(TIERS) do
			if not st.d.tiers[t.Id] and k < prod.count then
				k += 1
				if tierHasScythe(t) and (C.Robux.SkipCanBuyFinal ~= false or i < #TIERS) then reach = true end
			end
		end
		if reach then
			local okR, _, soldOut = reserveScythe(player)
			if not okR and not soldOut then return false end              -- panne : le reçu sera rejoué plus tard
			scyOk = okR
		end
		if st.busy then return false end
	end
	local newTiers, rerolled = {}, nil
	local ok = commit(player, function(d)
		if not isTest and table.find(d.rc, pid) then return true end
		newTiers, rerolled = {}, nil
		local trimmed = {}
		if not isTest then
			table.insert(d.rc, pid)
			while #d.rc > 60 do table.insert(trimmed, table.remove(d.rc, 1)) end
		end
		local coinsAdded, oldEntry, credits0, used0 = 0, nil, d.rr.credits or 0, d.rr.used
		if prod.kind == "skip" then
			for _ = 1, prod.count do
				local i = nextTier(d)
				if i and (C.Robux.SkipCanBuyFinal ~= false or i < #TIERS) and (scyOk or not tierHasScythe(TIERS[i])) then
					d.tiers[TIERS[i].Id] = now()
					markPending(d, TIERS[i])
					table.insert(newTiers, i)
				elseif C.Robux.SkipCanBuyFinal ~= false then
					-- plus aucun palier (tous achetés entre-temps) : remboursé en coins
					local before = d.coins
					d.coins = math.min((C.Coin and C.Coin.MaxBalance) or 1e6, d.coins + 1000)
					coinsAdded += d.coins - before
				else
					warn(("⚠️ [HalloweenEvent] %s : skip en trop (seule la faux reste, SkipCanBuyFinal = false)"):format(player.Name))
				end
			end
		elseif prod.kind == "reroll" then
			d.rr.credits = credits0 + 1
			local tg = rerollTarget[uid]
			if tg and d[tg[1]] then
				oldEntry = deep(d[tg[1]].list)
				if doRefresh(d, tg[1], true) then rerolled = tg end
			end
		end
		return true, function(dd)
			if not isTest then
				local at = table.find(dd.rc, pid)
				if at then table.remove(dd.rc, at) end
				for k = #trimmed, 1, -1 do table.insert(dd.rc, 1, trimmed[k]) end
			end
			for _, i in ipairs(newTiers) do dd.tiers[TIERS[i].Id] = nil dd.pend[TIERS[i].Id] = nil end
			dd.coins -= coinsAdded
			dd.rr.credits, dd.rr.used = credits0, used0
			if rerolled and oldEntry then dd[rerolled[1]].list = oldEntry end
			newTiers, rerolled = {}, nil
		end
	end)
	if not ok then return false end
	rerollTarget[uid] = nil
	log(("💸 %s : %s %s (%s) appliqué"):format(player.Name, isTest and "achat TEST" or "reçu", pid, prod.kind))
	if #newTiers > 0 then
		local ann = {}
		for _, i in ipairs(newTiers) do ann[i] = true end
		task.spawn(deliverPending, player, ann)
	end
	if rerolled then push(player, "rerolled", { Which = rerolled[1] }) end
	pushView(player, true)
	return true
end

