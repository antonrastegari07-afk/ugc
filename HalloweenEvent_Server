-- 🚦 ANTI-SPAM (SEC9)
-- ════════════════════════════════════════════════════════════════
local buckets = {}
local function bucketOk(uid, tag, perSec, burst)
	local k = uid .. "_" .. tag
	local b = buckets[k]
	local t = os.clock()
	if not b then b = { n = burst, t = t } buckets[k] = b end
	b.n = math.min(burst, b.n + (t - b.t) * perSec)
	b.t = t
	if b.n < 1 then return false end
	b.n -= 1
	return true
end

local function refuse(player, tag, msg)
	log("⛔", player.Name, tag)
	if _G.AntiExploit and _G.AntiExploit.NoteBlockedClaim then
		pcall(_G.AntiExploit.NoteBlockedClaim, player, "Halloween_" .. tostring(tag))
	end
	if msg then push(player, "toast", { Kind = "error", Text = msg }) end
end

-- ════════════════════════════════════════════════════════════════
-- 🔐 OPÉRATION CRITIQUE : on modifie, on ÉCRIT, et seulement ensuite on donne (SEC3)
-- ════════════════════════════════════════════════════════════════
--  fn(d) vérifie tout AVANT de toucher à quoi que ce soit (sinon return false), puis modifie et
--  renvoie true, undo (une fonction qui défait exactement ses changements). Si l'écriture échoue,
--  seul undo est joué : les coins ramassés ou les quêtes avancées pendant l'écriture restent.
local function commit(player, fn)
	local st = pd(player.UserId)
	if not st or st.frozen or st.busy then return false, "busy" end
	st.busy = true
	local ok, res, undo = pcall(fn, st.d)
	if not ok or res == false then
		st.busy = false
		if not ok then warn("❌ [HalloweenEvent] " .. tostring(res)) end
		return false, "refused"
	end
	touch(st)
	if not save(player.UserId) then
		if type(undo) == "function" then
			local okU, errU = pcall(undo, st.d)
			if not okU then warn("❌ [HalloweenEvent] annulation : " .. tostring(errU)) end
		end
		touch(st)
		st.busy = false
		return false, "store"
	end
	st.busy = false
	return true, res
end

