-- 💾 STOCKAGE (verrou de session)
-- ════════════════════════════════════════════════════════════════
local STORE
pcall(function() STORE = DataStoreService:GetDataStore("HalloweenEvent_v1") end)
local useMemory = RunService:IsStudio() and C.StudioFreshStart ~= false
local memory = {}
if useMemory then warn("🧪 [HalloweenEvent] Studio : sauvegarde en mémoire (remise à zéro à chaque Play)") end

local JOB = (game.JobId ~= "" and game.JobId) or ("studio-" .. HttpService:GenerateGUID(false))
local LOCK_STALE = 180                        -- s : un verrou plus vieux = serveur mort, on le reprend

local function deep(v)
	if type(v) ~= "table" then return v end
	local t = {}
	for k, x in pairs(v) do t[k] = deep(x) end
	return t
end

local function storeUpdate(key, fn)
	if useMemory then
		local v = fn(deep(memory[key]))
		if v ~= nil then memory[key] = deep(v) end
		return true
	end
	if not STORE then return false, "no DataStore" end
	return pcall(function() return STORE:UpdateAsync(key, fn) end)
end

local function blank()
	return {
		v = 1, coins = 0, earned = 0, pts = 0,
		tiers = {},                               -- [tierId] = os.time() de l'achat
		daily = { p = -1, list = {} },            -- list[i] = { id, n, c (réclamée) }
		weekly = { p = -1, list = {} },
		rr = { day = -1, used = 0, credits = 0 },
		zone = { day = -1, got = 0 },
		rc = {},                                  -- derniers PurchaseId appliqués
		jack = {},                                -- [stepId] = coins déjà versés
		pend = {},                                -- [tierId] = { ["1"] = true, … } parts de récompense pas encore versées
		kv = { day = -1, v = {} },                -- kills comptés par victime aujourd'hui (SEC8, gardé entre les serveurs)
		ms = 0,                                   -- plus haut checkpoint déjà compté (remis à 0 au rebirth)
		hint = false,                             -- la petite flèche « la faux est au bout » a déjà été vue
	}
end

local function sanitize(d)
	local b = blank()
	for k, v in pairs(b) do
		if type(d[k]) ~= type(v) then d[k] = v end
	end
	for _, w in ipairs({ "daily", "weekly" }) do
		if type(d[w].list) ~= "table" then d[w].list = {} end
		if type(d[w].p) ~= "number" then d[w].p = -1 end
	end
	return d
end

-- ════════════════════════════════════════════════════════════════
-- 🧠 ÉTAT MÉMOIRE
-- ════════════════════════════════════════════════════════════════
--  P[uid] = { d = sauvegarde, ver, savedVer, settled, busy, frozen, ... }
local P = {}
local function pd(uid) local s = P[uid] return s and s.d and s end

local function key(uid) return "p_" .. uid end

local function load(uid)
	for attempt = 1, 8 do
		local result, status
		local ok, err = storeUpdate(key(uid), function(old)
			local t = now()
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= JOB
				and t - (tonumber(old.lock.t) or 0) < LOCK_STALE and attempt < 7 then
				status = "locked"
				return nil                         -- un autre serveur tient la sauvegarde : on attend
			end
			local d = sanitize(type(old) == "table" and old or blank())
			d.lock = { job = JOB, t = t }
			result, status = d, "ok"
			return d
		end)
		if ok and status == "ok" then
			result.lock = nil
			return result
		end
		if not ok then warn(("⚠️ [HalloweenEvent] lecture %d/8 ratée pour %d : %s"):format(attempt, uid, tostring(err))) end
		task.wait(status == "locked" and 5 or 3)
	end
	return nil
end

-- sauvegarde ; renvoie true si écrite. release = on rend le verrou (départ du joueur)
local function save(uid, release)
	local st = pd(uid)
	if not st or st.frozen then return false end
	local snap = deep(st.d)
	local ver = st.ver
	snap.lock = (not release) and { job = JOB, t = now() } or nil
	local lost = false
	local ok, err = storeUpdate(key(uid), function(old)
		if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= JOB then
			lost = true
			return nil
		end
		return snap
	end)
	if lost then
		st.frozen = true
		warn(("🛑 [HalloweenEvent] %d : un autre serveur a repris la sauvegarde, ce serveur n'écrit plus rien"):format(uid))
		return false
	end
	if not ok then warn("⚠️ [HalloweenEvent] sauvegarde ratée pour " .. uid .. " : " .. tostring(err)) return false end
	st.savedVer = math.max(st.savedVer or 0, ver)
	st.lastSave = os.clock()
	return true
end

local function touch(st) st.ver = (st.ver or 0) + 1 end

