-- ⚔️ kills (tag « creator » posé par ton WeaponServer) — SEC8
local function onKill(killer, victim)
	if not killer or killer == victim or not killer.Parent then return end
	if not allowed(killer.UserId) then return end
	if victim.AccountAge < (R.KillMinAccountAge or 7) then return end
	local st = pd(killer.UserId)
	if not st or not st.settled or st.frozen or not activeFor(killer.UserId) then return end
	local today = dayIndex(now())
	local kv = st.d.kv
	if kv.day ~= today then kv.day, kv.v = today, {} end
	local key_ = tostring(victim.UserId)
	local n = (kv.v[key_] or 0) + 1
	if n > (R.SameVictimMax or 3) then return end
	kv.v[key_] = n
	touch(st)
	progress(killer, "kills", 1)
	progress(killer, "killstreak", 1)
end

local function watchCharacter(player, char)
	local hum = char:WaitForChild("Humanoid", 8)
	if not hum then return end
	hum.Died:Connect(function()
		breakStreaks(player)                         -- toute mort casse les séries
		local tag = hum:FindFirstChild("creator")
		local killer = tag and tag.Value
		if typeof(killer) == "Instance" and killer:IsA("Player") then onKill(killer, player) end
	end)
end

-- 🧗 checkpoints (leaderstats ▸ Stage) — SEC4 / SEC5
local function watchStage(player)
	task.spawn(function()
		local ls = player:WaitForChild("leaderstats", 60)
		local stg = ls and ls:WaitForChild("Stage", 60)
		if not stg then return end
		local uid = player.UserId
		local st = P[uid]
		if not st then return end
		st.lastStage = tonumber(stg.Value) or 0
		stg.Changed:Connect(function()
			local s2 = P[uid]
			if not s2 then return end
			local cur = tonumber(stg.Value) or 0
			local prev = s2.lastStage or cur
			s2.lastStage = cur
			if not s2.settled or not s2.d then return end
			local best = s2.d.ms or 0
			if cur <= best then return end                -- déjà fait (retour en arrière, sélecteur d'étape)
			s2.d.ms = cur
			touch(s2)
			if cur ~= prev + 1 or warped(uid) then return end     -- saut de plusieurs étapes / téléport : rien
			local t = os.clock()
			if s2.stageT and t - s2.stageT < (R.CheckpointMinGap or 0.8) then return end
			s2.stageT = t
			progress(player, "checkpoints", 1)
			progress(player, "nodeath", 1)
		end)
	end)
end

-- 🔄 rebirth / 🏆 manche gagnée : +1 exact après le chargement — SEC6
local function watchCounter(player, attr, kind)
	local uid = player.UserId
	local last = tonumber(player:GetAttribute(attr)) or 0
	player:GetAttributeChangedSignal(attr):Connect(function()
		local cur = tonumber(player:GetAttribute(attr)) or 0
		local st = P[uid]
		if st and st.settled and cur == last + 1 then
			progress(player, kind, 1)
			if kind == "rebirth" and st.d then st.d.ms = 0 touch(st) end   -- l'obby repart de 0
		end
		last = cur
	end)
	return function() last = tonumber(player:GetAttribute(attr)) or 0 end      -- remise à niveau au « posé »
end

