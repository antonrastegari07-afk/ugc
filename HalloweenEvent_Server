-- 🛡️ ANTI-TÉLÉPORT + DISTANCE PARCOURUE (SEC7)
-- ════════════════════════════════════════════════════════════════
local MAX_SPEED = R.MaxTravelSpeed or 140
local motion = {}          -- [uid] = { pos, t, warpUntil, travel }
local lastPick = {}        -- [uid] = { pos, t }

local function flat(v) return Vector3.new(v.X, 0, v.Z) end
local function warped(uid)
	local m = motion[uid]
	return m ~= nil and os.clock() < (m.warpUntil or 0)
end

task.spawn(function()
	while true do
		task.wait(0.2)
		local t = os.clock()
		for _, pl in ipairs(Players:GetPlayers()) do
			local m = motion[pl.UserId]
			local ch = pl.Character
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			if m and hrp then
				if m.pos then
					local dt = math.max(t - m.t, 0.05)
					local dist = (flat(hrp.Position) - flat(m.pos)).Magnitude
					if dist > 8 and dist / dt > MAX_SPEED then
						m.warpUntil = t + 4
					else
						m.travel = (m.travel or 0) + math.min(dist, 6)
					end
				end
				m.pos, m.t = hrp.Position, t
				m.samples = (m.samples or 0) + 1
				local hum = ch:FindFirstChildOfClass("Humanoid")
				local md = hum and hum.MoveDirection
				if md == nil or md.Magnitude > 0.1 then m.moving = (m.moving or 0) + 1 end
			end
		end
	end
end)

local function reachable(player, pos, maxDist)
	local uid = player.UserId
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return false end
	if warped(uid) then return false end
	local m = motion[uid]
	if m and m.pos and m.t then                      -- saut depuis le dernier relevé (0,2 s) : téléport → refusé
		local dt = math.max(os.clock() - m.t, 0.05)
		local dist = (flat(hrp.Position) - flat(m.pos)).Magnitude
		if dist > 8 and dist / dt > MAX_SPEED then m.warpUntil = os.clock() + 4 return false end
	end
	if (hrp.Position - pos).Magnitude > maxDist then return false end
	local lp = lastPick[uid]
	if lp and os.clock() - lp.t < (flat(pos) - flat(lp.pos)).Magnitude / MAX_SPEED then return false end
	return true
end

