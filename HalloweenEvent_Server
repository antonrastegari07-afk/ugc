-- 🧪 OUTILS TESTEUR (barre « TESTER » sous la fenêtre) — refusé à tout autre joueur
-- ════════════════════════════════════════════════════════════════
local function actionTest(player, what)
	local uid = player.UserId
	if not isTester(uid) or TM.Tools == false then return refuse(player, "test_denied") end
	local st = pd(uid)
	if what == "coins" then
		st.d.coins = math.min((C.Coin and C.Coin.MaxBalance) or 1e6, st.d.coins + 1000)
		touch(st)
		push(player, "coinOk", { Add = 1000, Total = st.d.coins })
	elseif what == "finish" then
		ensurePeriods(st.d, now())
		for _, w in ipairs({ "daily", "weekly" }) do
			for _, e in ipairs(st.d[w].list) do if QDEF[e.id] and not e.c then e.n = goalOf(QDEF[e.id]) end end
		end
		touch(st)
	elseif what == "reset" then
		-- tout repart de zéro SAUF les reçus Robux déjà appliqués (SEC11 : un vrai achat ne se rejoue jamais)
		local keepRc = st.d.rc
		st.d = blank()
		st.d.rc = keepRc
		st.d.ms = st.lastStage or 0
		ensurePeriods(st.d, now())
		touch(st)
		clearCoins(player, st)
		push(player, "toast", { Kind = "info", Text = "Test: your Halloween Pass was reset." })
	else
		return
	end
	task.spawn(save, uid)
	log(("🧪 %s : outil testeur « %s »"):format(player.Name, tostring(what)))
	pushView(player, true)
end

