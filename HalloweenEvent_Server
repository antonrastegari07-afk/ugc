-- 🏆 PALIERS
-- ════════════════════════════════════════════════════════════════
--  announce = { [indexDuPalier] = true } : paliers qui viennent d'être achetés (écran « TIER UNLOCKED! »)
local function deliverPending(player, announce)
	local st = pd(player.UserId)
	if not st or st.frozen or st.delivering then return end
	st.delivering = true
	local d = st.d
	local any, late = false, false
	for i, tier in ipairs(TIERS) do
		local pend = d.pend[tier.Id]
		if pend then
			local given = {}
			for k, part in ipairs(partsOf(tier.Reward)) do
				if pend[tostring(k)] then
					local ok, g = grantPart(player, part, ("halloween_%d_%s_%d"):format(player.UserId, tier.Id, k))
					if ok then
						pend[tostring(k)] = nil
						if g then table.insert(given, g) end
						any = true
					end
				end
			end
			if next(pend) == nil then d.pend[tier.Id] = nil end
			if announce and announce[i] then
				push(player, "reward", { Tier = i, Given = given })
				log(("🏆 %s débloque le palier %d (%s)"):format(player.Name, i, tier.Name or tier.Id))
			elseif #given > 0 then
				late = true
			end
		end
	end
	st.delivering = false
	if any then
		touch(st)
		task.spawn(save, player.UserId)              -- les parts versées sont rayées tout de suite
	end
	if late then push(player, "toast", { Kind = "info", Text = "Your Halloween rewards have been delivered!" }) end
	pushView(player, true)
end

local function actionBuy(player, index)
	local st = pd(player.UserId)
	if not activeFor(player.UserId) then return refuse(player, "buy_closed", "The event is not running.") end
	local i = nextTier(st.d)
	if not i or i ~= index then return refuse(player, "buy_order") end
	local tier = TIERS[i]
	if st.d.coins < tier.Cost then return refuse(player, "buy_poor", "Not enough Halloween Coins!") end
	-- des points à verser mais ton système de points n'est pas prêt (chargement) : on attend, rien n'est perdu
	if pointsIn(tier.Reward) > 0 and not pointsReady(player.UserId) then return refuse(player, "buy_points", "Try again in a moment.") end
	local scy = tierHasScythe(tier)
	if scy and scytheSoldOutFor(player.UserId) then
		return refuse(player, "buy_soldout", SCY.SoldOutText or "Jack's Scythe is sold out!")
	end
	local refuseMsg
	local ok = commit(player, function(d)
		if nextTier(d) ~= i or d.coins < tier.Cost then return false end
		-- 📦 la faux : numéro réservé AVANT de débiter (épuisé → rien n'est débité)
		if scy then
			local okR, msg = reserveScythe(player)
			if not okR then refuseMsg = msg return false end
		end
		d.coins -= tier.Cost
		d.tiers[tier.Id] = now()
		markPending(d, tier)
		return true, function(dd)
			dd.coins += tier.Cost
			dd.tiers[tier.Id] = nil
			dd.pend[tier.Id] = nil
		end
	end)
	if not ok then
		if refuseMsg and scytheLeft == 0 then pushView(player, true) end
		return refuse(player, "buy_store", refuseMsg or "Try again in a moment.")
	end
	deliverPending(player, { [i] = true })
end

