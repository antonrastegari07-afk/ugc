-- 🧪 Studio seulement (Command Bar en vue « Server »)
--    _G.HalloweenCoins("TonPseudo", 5000)   → ajoute des coins
--    _G.HalloweenFinishQuests("TonPseudo")  → toutes tes quêtes du jour/semaine terminées (à réclamer)
--    _G.HalloweenReset("TonPseudo")         → tout remis à zéro (mémoire Studio)
if RunService:IsStudio() then
	local function find(name)
		for _, p in ipairs(Players:GetPlayers()) do
			if not name or p.Name == name or p.DisplayName == name then return p end
		end
	end
	_G.HalloweenCoins = function(name, n)
		local p = find(name) local st = p and pd(p.UserId)
		if not st then return warn("[HalloweenEvent] joueur introuvable / pas chargé") end
		st.d.coins += math.floor(tonumber(n) or 0)
		touch(st) pushView(p, true)
	end
	_G.HalloweenFinishQuests = function(name)
		local p = find(name) local st = p and pd(p.UserId)
		if not st then return end
		for _, w in ipairs({ "daily", "weekly" }) do
			for _, e in ipairs(st.d[w].list) do if QDEF[e.id] then e.n = goalOf(QDEF[e.id]) end end
		end
		touch(st) pushView(p, true)
	end
	_G.HalloweenReset = function(name)
		local p = find(name) local st = p and pd(p.UserId)
		if not st then return end
		st.d = blank()
		ensurePeriods(st.d, now())
		touch(st) pushView(p, true)
	end
end

