-- 🎃 ZONES DE COINS (chaque joueur a les siennes ; le serveur garde la vraie position)
-- ════════════════════════════════════════════════════════════════
local zoneParts = {}
local function scanZones()
	table.clear(zoneParts)
	local f = workspace:FindFirstChild(Z.Folder or "HalloweenCoinZones")
	if not f then return end
	for _, d in ipairs(f:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(zoneParts, d) end
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() rayParams.RespectCanCollide = true end)

local function randomSpot()
	if #zoneParts == 0 then return nil end
	local total = 0
	for _, p in ipairs(zoneParts) do total += p.Size.X * p.Size.Z end
	local r = rng:NextNumber() * total
	local part = zoneParts[#zoneParts]
	for _, p in ipairs(zoneParts) do
		r -= p.Size.X * p.Size.Z
		if r <= 0 then part = p break end
	end
	local s = part.Size
	local lx, lz = (rng:NextNumber() - 0.5) * s.X * 0.9, (rng:NextNumber() - 0.5) * s.Z * 0.9
	local top = part.CFrame:PointToWorldSpace(Vector3.new(lx, s.Y / 2, lz))
	local ignore = { workspace:FindFirstChild(Z.Folder or "HalloweenCoinZones") }
	for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then table.insert(ignore, pl.Character) end end
	rayParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(top, Vector3.new(0, -(s.Y + 40), 0), rayParams)
	if not hit then return nil end
	return hit.Position + Vector3.new(0, Z.HoverHeight or 2.4, 0)
end

-- 🗺️ Mode « AroundPlayer » (grande zone qui couvre toute la map) : les coins apparaissent AUTOUR DE TOI,
--    au sol (s'il y en a), seulement là où une Part de zone couvre l'endroit (vu de haut).
--    → même nombre de coins visibles que la zone soit petite ou immense.
local AROUND = Z.Mode == "AroundPlayer"
local function inZone(pos)
	for _, p in ipairs(zoneParts) do
		if p.Parent then
			local l = p.CFrame:PointToObjectSpace(pos)
			if math.abs(l.X) <= p.Size.X / 2 and math.abs(l.Z) <= p.Size.Z / 2 then return true end
		end
	end
	return false
end
local function spotNear(player)
	if #zoneParts == 0 then return nil end
	local ch = player.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local me = hrp.Position
	local rMin = math.max(4, tonumber(Z.NearMin) or 12)
	local rMax = math.max(rMin + 4, tonumber(Z.NearMax) or 60)
	local ignore = { workspace:FindFirstChild(Z.Folder or "HalloweenCoinZones") }
	for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then table.insert(ignore, pl.Character) end end
	rayParams.FilterDescendantsInstances = ignore
	for _ = 1, 14 do
		local a = rng:NextNumber() * math.pi * 2
		local d = rMin + rng:NextNumber() * (rMax - rMin)
		local x, z = me.X + math.cos(a) * d, me.Z + math.sin(a) * d
		if inZone(Vector3.new(x, me.Y, z)) then
			-- le sol sous ce point, pas trop loin de ta hauteur (pas sur un toit lointain, pas au fond du vide)
			local hit = workspace:Raycast(Vector3.new(x, me.Y + 10, z), Vector3.new(0, -70, 0), rayParams)
			if hit and hit.Material ~= Enum.Material.Water and hit.Position.Y > me.Y - 40 then
				return hit.Position + Vector3.new(0, Z.HoverHeight or 2.4, 0)
			end
		end
	end
	return nil
end

local coinSeq = 0
local function coinsOf(st)
	st.coins = st.coins or { list = {}, n = 0, nextT = os.clock() + 2 }
	return st.coins
end

local function clearCoins(player, st)
	local cs = coinsOf(st)
	if cs.n == 0 then return end
	table.clear(cs.list)
	cs.n = 0
	push(player, "coinClear", {})
end

task.spawn(function()
	scanZones()
	local f = workspace:FindFirstChild(Z.Folder or "HalloweenCoinZones")
	if f then
		f.DescendantAdded:Connect(function() task.defer(scanZones) end)
		f.DescendantRemoving:Connect(function() task.defer(scanZones) end)
	end
	while true do
		task.wait(1)
		if #zoneParts == 0 then
			local f2 = workspace:FindFirstChild(Z.Folder or "HalloweenCoinZones")
			if f2 then scanZones() end
		end
		local t = os.clock()
		for _, pl in ipairs(Players:GetPlayers()) do
			local open = activeFor(pl.UserId)
			local st = pd(pl.UserId)
			if st and st.settled and not st.frozen then
				ensurePeriods(st.d, now())
				local cs = coinsOf(st)
				local capped = st.d.zone.got >= (Z.DailyCap or 0)
				if not open or capped then
					clearCoins(pl, st)
				else
					-- (AroundPlayer) les coins restés trop loin de toi disparaissent : de nouveaux apparaissent près de toi
					if AROUND then
						local ch = pl.Character
						local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
						local far = tonumber(Z.DespawnDistance) or 160
						if hrp then
							for id, c in pairs(cs.list) do
								if (c.pos - hrp.Position).Magnitude > far then
									cs.list[id] = nil
									cs.n -= 1
									push(pl, "coinNo", { Id = id, Gone = true })
								end
							end
						end
					end
				end
				if open and not capped and cs.n < (Z.MaxAlive or 6) and t >= cs.nextT then
					local pos = AROUND and spotNear(pl) or (not AROUND and randomSpot()) or nil
					local rs = Z.RespawnEvery or { 8, 16 }
					cs.nextT = t + (pos and rng:NextNumber(rs[1], rs[2]) or 1.5)     -- pas de sol ici : on réessaie vite
					if pos then
						coinSeq += 1
						local id = ("%x%04x"):format(coinSeq, rng:NextInteger(0, 0xffff))
						cs.list[id] = { pos = pos }
						cs.n += 1
						push(pl, "coinAdd", { Id = id, P = { pos.X, pos.Y, pos.Z } })
					end
				end
			end
		end
	end
end)

local function actionPick(player, id)
	local uid = player.UserId
	local st = pd(uid)
	if type(id) ~= "string" or #id > 16 then return end
	local cs = coinsOf(st)
	local c = cs.list[id]
	if not c then return push(player, "coinNo", { Id = id, Gone = true }) end
	local cap = Z.DailyCap or 0
	if not activeFor(uid) or st.d.zone.got >= cap then
		cs.list[id] = nil
		cs.n -= 1
		return push(player, "coinNo", { Id = id, Gone = true })
	end
	if not reachable(player, c.pos, Z.PickupRadius or 9) then
		refuse(player, "coin_far")
		return push(player, "coinNo", { Id = id })
	end
	cs.list[id] = nil
	cs.n -= 1
	local d = st.d
	local value = math.min(Z.ValuePerCoin or 5, cap - d.zone.got)
	d.zone.got += value
	d.coins = math.min((C.Coin and C.Coin.MaxBalance) or 1e6, d.coins + value)
	d.earned += value
	lastPick[uid] = { pos = c.pos, t = os.clock() }
	touch(st)
	push(player, "coinOk", { Id = id, Add = value, Total = d.coins, Got = d.zone.got, Cap = cap })
	progress(player, "coins", 1)
	if d.zone.got >= cap then clearCoins(player, st) end
end

