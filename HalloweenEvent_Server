_G.HalloweenEvent = {
	IsActive = function() return active() end,
	-- 🎃 coins d'une quête de Jack (appelé par JackQuest_Server) : une seule fois par étape, à vie
	JackCoins = function(player, stepId, amount)
		amount = math.floor(tonumber(amount) or 0)
		if amount <= 0 or type(stepId) ~= "string" or not allowed(player.UserId) then return 0 end
		local t0 = os.clock()
		while player.Parent and not pd(player.UserId) and os.clock() - t0 < 30 do task.wait(0.5) end
		local st = pd(player.UserId)
		if not st or st.frozen then return 0 end
		local t1 = os.clock()
		while st.busy and os.clock() - t1 < 15 do task.wait(0.2) end
		if st.d.jack[stepId] then return 0 end
		st.d.jack[stepId] = amount
		st.d.coins = math.min((C.Coin and C.Coin.MaxBalance) or 1e6, st.d.coins + amount)
		st.d.earned += amount
		touch(st)
		task.spawn(save, player.UserId)              -- même si l'écriture échoue : gardé en mémoire, réessayé à la sauvegarde suivante
		push(player, "coinOk", { Add = amount, Total = st.d.coins, Jack = true })
		pushView(player)
		log(("🎃 %s : +%d coins (quête de Jack « %s »)"):format(player.Name, amount, stepId))
		return amount
	end,
	Coins = function(uid) local st = pd(uid) return st and st.d.coins or 0 end,
}

