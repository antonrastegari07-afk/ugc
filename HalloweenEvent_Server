local function processReceipt(info)
	local prod = PRODUCTS[info.ProductId]
	if not prod then return nil end
	local NOT_YET, GRANTED = Enum.ProductPurchaseDecision.NotProcessedYet, Enum.ProductPurchaseDecision.PurchaseGranted
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then return NOT_YET end
	local uid = player.UserId
	-- un achat rejoué arrive souvent juste à la connexion : on attend que la sauvegarde soit chargée et posée
	local tw = os.clock()
	while player.Parent and not settledOk(uid) and os.clock() - tw < 90 do task.wait(0.5) end
	if applyProduct(player, prod, tostring(info.PurchaseId), false) then return GRANTED end
	return NOT_YET
end
