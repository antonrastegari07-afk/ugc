-- 📜 QUÊTES : réclamer / changer
-- ════════════════════════════════════════════════════════════════
local function entryAt(d, which, idx, qid)
	if which ~= "daily" and which ~= "weekly" then return nil end
	local e = d[which].list[tonumber(idx) or 0]
	if not e or e.id ~= qid then return nil end
	return e
end

local function actionClaim(player, which, idx, qid)
	local st = pd(player.UserId)
	if not activeFor(player.UserId) then return refuse(player, "claim_closed", "The event is not running.") end
	if ensurePeriods(st.d, now()) then touch(st) pushView(player, true) end
	local e = entryAt(st.d, which, idx, qid)
	if not e or e.c or not entryDone(e) then return refuse(player, "claim_bad") end
	local reward = math.floor(QDEF[e.id].Reward or 0)
	local ok = commit(player, function(d)
		local e2 = entryAt(d, which, idx, qid)
		if not e2 or e2.c or not entryDone(e2) then return false end
		e2.c = true
		local before = d.coins
		d.coins = math.min((C.Coin and C.Coin.MaxBalance) or 1e6, d.coins + reward)
		local added = d.coins - before
		d.earned += added
		return true, function(dd)
			local e3 = entryAt(dd, which, idx, qid)
			if e3 then e3.c = false end
			dd.coins -= added
			dd.earned -= added
		end
	end)
	if not ok then return refuse(player, "claim_store", "Try again in a moment.") end
	push(player, "claimed", { Which = which, Index = idx, Amount = reward })
	pushView(player, true)
	log(("📜 %s réclame %s (+%d coins)"):format(player.Name, qid, reward))
end

-- 🔄 NOUVELLES QUÊTES : toute la SECTION (daily ou weekly) est renouvelée d'un coup.
--    Refusé tant qu'une quête finie de la section n'est pas réclamée (sa récompense ne se perd jamais).
--    renvoie true | false, raison
local function sectionClaimPending(d, which)
	for _, e in ipairs(d[which].list) do
		if not e.c and entryDone(e) then return true end
	end
	return false
end

local function doRefresh(d, which, useCredit)
	if which ~= "daily" and which ~= "weekly" then return false, "bad" end
	if sectionClaimPending(d, which) then return false, "claim" end
	local pool = which == "daily" and (Q.Daily or {}) or (Q.Weekly or {})
	local per = which == "daily" and Q.DailyPerDiff or Q.WeeklyPerDiff
	local avoid = {}
	for _, e in ipairs(d[which].list) do avoid[e.id] = true end
	local list = pick(pool, per, avoid)
	local fresh = false
	for _, e in ipairs(list) do if not avoid[e.id] then fresh = true end end
	if #list == 0 or not fresh then return false, "bad" end          -- aucune autre quête possible : rien n'est consommé
	if useCredit then
		if (d.rr.credits or 0) < 1 then return false, "pay" end
		d.rr.credits -= 1
	else
		if freeRerollsLeft(d) < 1 then return false, "pay" end
		d.rr.used += 1
	end
	d[which].list = list
	return true
end

local function actionReroll(player, which)
	local st = pd(player.UserId)
	if not activeFor(player.UserId) then return refuse(player, "reroll_closed") end
	if which ~= "daily" and which ~= "weekly" then return refuse(player, "reroll_bad") end
	if ensurePeriods(st.d, now()) then touch(st) end
	local d = st.d
	if sectionClaimPending(d, which) then return refuse(player, "reroll_claim", "Claim your finished quests first!") end
	local useCredit
	if freeRerollsLeft(d) > 0 then useCredit = false
	elseif (d.rr.credits or 0) > 0 then useCredit = true
	else
		push(player, "needRobux", { Kind = "reroll", Which = which })
		return
	end
	local ok = commit(player, function(dd)
		local old = deep(dd[which].list)
		local used, credits = dd.rr.used, dd.rr.credits
		if not doRefresh(dd, which, useCredit) then return false end
		return true, function(d3)
			d3[which].list = old
			d3.rr.used, d3.rr.credits = used, credits
		end
	end)
	if not ok then return refuse(player, "reroll_bad", "Try again in a moment.") end
	push(player, "rerolled", { Which = which })
	pushView(player, true)
end

