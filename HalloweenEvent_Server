-- 📈 PROGRESSION (un événement fait avancer les quêtes de ce type, daily ET hebdo)
-- ════════════════════════════════════════════════════════════════
local settledOk  -- fwd

local function progress(player, kind, amount)
	local uid = player.UserId
	local st = pd(uid)
	if not st or st.frozen or not settledOk(uid) or not activeFor(uid) then return end
	local d = st.d
	if ensurePeriods(d, now()) then touch(st) end
	local changed, finished = false, nil
	for _, w in ipairs({ "daily", "weekly" }) do
		for _, e in ipairs(d[w].list) do
			local def = QDEF[e.id]
			if def and not e.c and def.Kind == kind then
				local goal = goalOf(def)
				if e.n < goal then
					e.n = math.min(goal, e.n + amount)
					changed = true
					if e.n >= goal then finished = finished or {} table.insert(finished, def) end
				end
			end
		end
	end
	if changed then
		touch(st)
		pushView(player)
		for _, def in ipairs(finished or {}) do
			push(player, "toast", { Kind = "quest", Text = def.Text, Goal = def.Goal, Reward = def.Reward })
		end
	end
end

-- série cassée (mort) : les quêtes « sans mourir » / « série de kills » pas encore finies repartent à 0
local function breakStreaks(player)
	local st = pd(player.UserId)
	if not st or st.frozen then return end
	local changed = false
	for _, w in ipairs({ "daily", "weekly" }) do
		for _, e in ipairs(st.d[w].list) do
			local def = QDEF[e.id]
			if def and not e.c and (def.Kind == "nodeath" or def.Kind == "killstreak") and e.n > 0 and e.n < goalOf(def) then
				e.n = 0
				changed = true
			end
		end
	end
	if changed then touch(st) pushView(player) end
end

