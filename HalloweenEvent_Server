-- ⏰ TEMPS
-- ════════════════════════════════════════════════════════════════
local function utc(t)
	return DateTime.fromUniversalTime(t.Year, t.Month, t.Day, t.Hour or 0, t.Minute or 0, 0).UnixTimestamp
end
local START, FINISH = utc(C.StartUTC), utc(C.EndUTC)
local RESET = (C.ResetHourUTC or 0) * 3600
local MONDAY = 4 * 86400                     -- le 5 janvier 1970 était un lundi

local function now() return os.time() end
local function active(t) t = t or now() return t >= START and t < FINISH end
local SHOW_UNTIL = FINISH + (C.ShowAfterEndDays or 3) * 86400     -- après : la fenêtre et Jack n'en parlent plus
local function visible(t) return (t or now()) < SHOW_UNTIL end

-- 🧪 MODE TESTEUR : C.TestUserIds (et tout le monde dans Studio) peuvent TOUT essayer, même hors des dates.
--    Vérifié ICI (serveur) à chaque action : un joueur normal ne peut jamais l'activer.
local TM = C.TestMode or {}
local function isTester(uid)
	if TM.Enabled == false then return false end
	return C.IsTester(uid) or RunService:IsStudio()
end
local function activeFor(uid, t) return active(t) or (TM.IgnoreDates ~= false and isTester(uid)) end
local function visibleFor(uid, t) return visible(t) or isTester(uid) end
-- achat Robux simulé (gratuit) pour un testeur : produit pas encore créé (ProductId 0), avant l'event, ou Studio
local function freeBuy(uid, productId)
	if not isTester(uid) or TM.FreePurchases == false then return false end
	return (tonumber(productId) or 0) <= 0 or not active() or RunService:IsStudio()
end
local function dayIndex(t) return math.floor((t - RESET) / 86400) end
local function weekIndex(t) return math.floor((t - RESET - MONDAY) / 604800) end
local function dayEnds(t) return (dayIndex(t) + 1) * 86400 + RESET end
local function weekEnds(t) return (weekIndex(t) + 1) * 604800 + RESET + MONDAY end

