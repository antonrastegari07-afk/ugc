for _, s in ipairs((C.Robux and C.Robux.SkipTier) or {}) do
	if (tonumber(s.ProductId) or 0) > 0 then PRODUCTS[s.ProductId] = { kind = "skip", count = s.Count } end
end
local RR = C.Robux and C.Robux.RerollQuest
if RR and (tonumber(RR.ProductId) or 0) > 0 then PRODUCTS[RR.ProductId] = { kind = "reroll" } end

