local TIERS = C.Tiers or {}
local QDEF = {}                               -- [questId] = def
for _, list in ipairs({ Q.Daily or {}, Q.Weekly or {} }) do
	for _, q in ipairs(list) do QDEF[q.Id] = q end
end
local TIME_KINDS = { playtime = true, arenatime = true }
local function goalOf(def) return (TIME_KINDS[def.Kind] and def.Goal * 60) or def.Goal end
local DIFFS = { "easy", "medium", "hard" }

-- plafond de points à vie venant de l'event = la somme des points des paliers (jamais plus)
local function pointsIn(r)
	if type(r) ~= "table" then return 0 end
	if r.Kind == "points" then return tonumber(r.Amount) or 0 end
	local n = 0
	if r.Kind == "multi" then for _, s in ipairs(r.List or {}) do n += pointsIn(s) end end
	return n
end
local POINTS_CAP = 0
for _, t in ipairs(TIERS) do POINTS_CAP += pointsIn(t.Reward) end

-- produits Robux
