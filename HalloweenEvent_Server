-- ════════════════════════════════════════════════════════════════
-- 🎁 RÉCOMPENSES (même chemin que le noob : anti-cheat prévenu, rien en double)
-- ════════════════════════════════════════════════════════════════
local function pointsReady(uid)
	if _G.dataLoading and _G.dataLoading[uid] then return false end
	if _G.recentReloads and _G.recentReloads[uid] then return false end
	if type(_G.isAllSecondaryLoaded) == "function" and not _G.isAllSecondaryLoaded(uid) then return false end
	local tj = _G.tempsJoueurs
	return type(tj) == "table" and type(tj[uid]) == "table"
end

-- 💎 points normaux (copie du chemin de ton giveQuestReward, comme le noob)
local function givePoints(player, amount, tag, capState)
	local uid = player.UserId
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then return 0 end
	if capState then
		local room = POINTS_CAP - (capState.pts or 0)
		if room <= 0 then warn(("🛡️ [HalloweenEvent] plafond de points atteint pour %s"):format(player.Name)) return 0 end
		amount = math.min(amount, room)
	end
	if not pointsReady(uid) then
		warn(("⏳ [HalloweenEvent] points pas prêts pour %s, versement annulé"):format(player.Name))
		return 0
	end
	local tj = _G.tempsJoueurs
	if _G.SmartAntiCheat and _G.SmartAntiCheat.ExpectGain then
		pcall(_G.SmartAntiCheat.ExpectGain, uid, amount, "HalloweenEvent_" .. tostring(tag))
	end
	if capState then capState.pts = (capState.pts or 0) + amount end
	local cap = ServerScriptService:FindFirstChild("CapBridge")
	if cap then
		pcall(function() require(cap).recordGain(uid, amount) end)    -- ton AbsoluteCapProtection est prévenu (comme la roue)
	end
	tj[uid].future = tj[uid].future + amount
	local ls = player:FindFirstChild("leaderstats")
	local stat = ls and ls:FindFirstChild("Points")
	if stat then
		local total = tj[uid].base + tj[uid].future
		local final = total
		if type(_G.applyAllBonuses) == "function" and type(_G.calculatePoints) == "function" then
			final = _G.applyAllBonuses(_G.calculatePoints(total), player)
		end
		stat.Value = final
		player:SetAttribute("Points", stat.Value)
		local sac = _G.SmartAntiCheat and _G.SmartAntiCheat.playerData and _G.SmartAntiCheat.playerData[uid]
		if sac then
			sac.lastKnownPoints = stat.Value
			sac.lastCheckTime = os.time()
			if sac.validationWindow then sac.validationWindow.expectedGains = {} end
		end
	end
	task.spawn(function()
		if _G.SmartAntiCheat and _G.SmartAntiCheat.RecordGain then
			pcall(_G.SmartAntiCheat.RecordGain, player, amount, "HalloweenEvent_" .. tostring(tag))
		end
		if type(_G.secureSave) == "function" then
			pcall(_G.secureSave, uid, tj[uid].base + tj[uid].future)
		end
	end)
	log(("💎 %s → +%d points (%s)"):format(player.Name, amount, tostring(tag)))
	return amount
end

-- 🎡 spins : ton DailySpin_Server → _G.GiveDailySpins(userId, nombre, purchaseId)
--    Le « reçu » (halloween_<id>_<palier>_<part>) est toujours le même pour une récompense donnée :
--    ta roue le garde (spinPurchases), donc un nouvel essai ne redonne JAMAIS les spins.
--    false (sauvegarde de la roue occupée / pas chargée) → réessayé plus tard par le pass.
local function giveSpins(player, n, receiptKey)
	if type(_G.GiveDailySpins) ~= "function" then
		warn("⚠️ [HalloweenEvent] _G.GiveDailySpins introuvable : spins réessayés plus tard")
		return false
	end
	local ok, res = pcall(_G.GiveDailySpins, player.UserId, math.floor(n), tostring(receiptKey))
	if not ok then warn("⚠️ [HalloweenEvent] GiveDailySpins : " .. tostring(res)) return false end
	return res == true
end

-- ⚡ boost temporaire : _G.TempBoosts.add(player, mult, durée, source) → ok, err (comme ta roue)
local function giveBoost(player, mult, duration)
	local tb = _G.TempBoosts
	if type(tb) ~= "table" or type(tb.add) ~= "function" then
		warn("⚠️ [HalloweenEvent] _G.TempBoosts.add introuvable : boost réessayé plus tard")
		return false
	end
	local ok, added, err = pcall(tb.add, player, mult, duration, "HalloweenEvent")
	if not ok or not added then
		warn("⚠️ [HalloweenEvent] TempBoosts.add : " .. tostring(ok and err or added))
		return false
	end
	return true
end

-- 🧰 tool à vie (SEC10 : non lâchable, détruit s'il quitte son propriétaire)
local function toolTemplate(name)
	local f = ServerStorage:FindFirstChild("HalloweenEventTools")
	local t = (f and f:FindFirstChild(name)) or ServerStorage:FindFirstChild(name)
	return (t and t:IsA("Tool")) and t or nil
end

local function giveTool(player, name)
	local tpl = toolTemplate(name)
	if not tpl then warn(("❌ [HalloweenEvent] Tool « %s » introuvable (ServerStorage ▸ HalloweenEventTools)"):format(tostring(name))) return false end
	local bp = player:FindFirstChildOfClass("Backpack")
	if not bp then return false end
	if bp:FindFirstChild(name) or (player.Character and player.Character:FindFirstChild(name)) then return true end
	local tool = tpl:Clone()
	tool.CanBeDropped = false
	tool:SetAttribute("HalloweenOwner", player.UserId)
	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then return end
		local holder = (parent:IsA("Backpack") and parent.Parent) or Players:GetPlayerFromCharacter(parent)
		if holder ~= player then task.defer(function() if tool.Parent then tool:Destroy() end end) end
	end)
	tool.Parent = bp
	return true
end

local function toolsOf(r, out)
	if type(r) ~= "table" then return out end
	if r.Kind == "tool" and type(r.Tool) == "string" then table.insert(out, r.Tool) end
	if r.Kind == "multi" then for _, s in ipairs(r.List or {}) do toolsOf(s, out) end end
	return out
end

-- remet tous les tools des paliers achetés (au spawn ; jamais en arène : giveGuns vide le sac)
local function refreshTools(player)
	local st = pd(player.UserId)
	if not st then return end
	if _G.PlayersInArena and _G.PlayersInArena[player.UserId] then return end
	for _, t in ipairs(TIERS) do
		if st.d.tiers[t.Id] then
			for _, name in ipairs(toolsOf(t.Reward, {})) do giveTool(player, name) end
		end
	end
end

-- 🎃 la faux de Jack (une seule par joueur, à vie ; JackScytheService est idempotent)
local function scytheService()
	local f = ServerScriptService:FindFirstChild("JackScythe")
	local m = f and f:FindFirstChild("JackScytheService")
	if not m then return nil end
	local ok, svc = pcall(require, m)
	return ok and svc or nil
end

local function giveScythe(player)
	local svc = scytheService()
	if not svc then warn("❌ [HalloweenEvent] JackScytheService introuvable : la faux sera donnée dès qu'il sera là") return nil end
	local serial, gold = svc.Grant(player)
	return serial, gold
end

-- 📦 STOCK LIMITÉ DE FAUX (HALLOWEEN_EVENT_CONFIG ▸ Scythe.Stock)
--    Le numéro est RÉSERVÉ (JackScytheService.Reserve, atomique) AVANT de faire payer le joueur :
--    plus de stock → l'achat est refusé et rien n'est débité. Paiement raté → la réservation reste à lui.
local SCY = C.Scythe or {}
local SCY_STOCK = (tonumber(SCY.Stock) or 0) > 0 and math.floor(tonumber(SCY.Stock)) or nil
local scytheLeft = nil          -- faux restantes (dernière lecture ; nil = illimité ou pas encore lu)
local scytheStockOn = false     -- true quand JackScytheService gère le stock (version à jour)

local function rewardHasScythe(r)
	if type(r) ~= "table" then return false end
	if r.Kind == "scythe" then return true end
	if r.Kind == "multi" then
		for _, x in ipairs(r.List or {}) do if rewardHasScythe(x) then return true end end
	end
	return false
end
local function tierHasScythe(tier) return tier ~= nil and rewardHasScythe(tier.Reward) end

-- a déjà sa faux (ou un numéro réservé, ou dev) → le stock ne le concerne pas
local function scytheMine(uid)
	local svc = scytheService()
	if not svc then return false end
	if svc.IsDev and svc.IsDev(uid) then return true end
	if svc.Owner and svc.Owner(uid) ~= nil then return true end
	if svc.IsReserved and svc.IsReserved(uid) then return true end
	return false
end
local function scytheSoldOutFor(uid)
	return scytheStockOn and scytheLeft == 0 and not scytheMine(uid)
end

-- réserve le numéro AVANT le paiement → true | false, message, épuisé?
local function reserveScythe(player)
	local svc = scytheService()
	if not svc then return false, "Try again in a moment." end
	if type(svc.Reserve) ~= "function" then return true end           -- ancien JackScytheService : pas de stock
	local serial, why = svc.Reserve(player)
	if serial ~= nil then return true end
	if why == "soldout" then
		scytheLeft = 0
		return false, (SCY.SoldOutText or "Jack's Scythe is sold out!"), true
	end
	return false, "Try again in a moment."
end

-- une récompense = une liste de « parts » (multi → ses éléments)
local function partsOf(r, out)
	out = out or {}
	if type(r) ~= "table" then return out end
	if r.Kind == "multi" then
		for _, x in ipairs(r.List or {}) do partsOf(x, out) end
	else
		table.insert(out, r)
	end
	return out
end

-- verse UNE part ; renvoie ok (false = à réessayer plus tard), ce qui a été donné
local function grantPart(player, r, tag)
	local st = pd(player.UserId)
	if r.Kind == "points" then
		if not pointsReady(player.UserId) then return false end
		local n = givePoints(player, r.Amount, tag, st and st.d)
		return true, n > 0 and { Kind = "points", Amount = n } or nil
	elseif r.Kind == "spins" then
		if not giveSpins(player, r.Amount or 1, tag) then return false end
		return true, { Kind = "spins", Amount = r.Amount or 1 }
	elseif r.Kind == "boost" then
		if not giveBoost(player, r.Mult or 2, r.Duration or 900) then return false end
		return true, { Kind = "boost", Mult = r.Mult, Duration = r.Duration }
	elseif r.Kind == "tool" then
		-- le tool vient des paliers achetés : il est (re)donné à chaque réapparition
		if not toolTemplate(r.Tool) then return false end
		if not (_G.PlayersInArena and _G.PlayersInArena[player.UserId]) then giveTool(player, r.Tool) end
		return true, { Kind = "tool", Tool = r.Tool }
	elseif r.Kind == "scythe" then
		local serial, gold = giveScythe(player)
		if serial == nil then return false end
		return true, { Kind = "scythe", Serial = serial, Gold = gold == true }
	end
	return true
end

local function markPending(d, tier)
	local n = #partsOf(tier.Reward)
	if n == 0 then return end
	local p = {}
	for k = 1, n do p[tostring(k)] = true end
	d.pend[tier.Id] = p
end

