-- ========================================
-- DATASTORE QUEUE OPTIMISÉE
-- ========================================
local datastoreQueue = {}
local isProcessingQueue = false
local MAX_QUEUE_SIZE = 100

local function queueDatastoreOperation(operation)
	if #datastoreQueue >= MAX_QUEUE_SIZE then
		warn("⚠️ Queue DataStore pleine, opération ignorée")
		return
	end

	table.insert(datastoreQueue, operation)

	if not isProcessingQueue then
		isProcessingQueue = true
		task.spawn(function()
			while #datastoreQueue > 0 do
				local op = table.remove(datastoreQueue, 1)

				if op and type(op) == "function" then
					local success, err = pcall(op)
					if not success then
						warn("❌ Erreur DataStore Queue:", err)
					end
				end

				task.wait(DATASTORE_QUEUE_DELAY)
			end
			isProcessingQueue = false
		end)
	end
end

