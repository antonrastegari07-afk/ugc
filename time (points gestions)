-- Vérification si un joueur est banni
function AntiExploit.CheckBanOnJoin(player)
	local userId = player.UserId

	if isDeveloper(userId) then
		print("🛠️ DEV MODE: Développeur détecté -", player.Name, "- Anti-exploit désactivé")
		AntiExploit.bannedPlayers[userId] = nil
		AntiExploit.infractions[userId] = nil
		return true
	end

	if AntiExploit.bannedPlayers[userId] then
		player:Kick(AntiExploit.CONFIG.KICK_MESSAGE)
		return false
	end

	task.spawn(function()
		-- Ligne ~ligne 130 de ton script
		local banStore = DataStoreService:GetDataStore("BannedPlayers")
		local success, banData = pcall(function()
			return banStore:GetAsync(tostring(userId))
		end)

		if success and banData then
			AntiExploit.bannedPlayers[userId] = true
			if player.Parent then
				player:Kick(AntiExploit.CONFIG.KICK_MESSAGE)
			end
		end
	end)

	return true
end



