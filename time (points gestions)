function getHighestGamePassMultiplier(player)  -- ✅ sans "local" : remplit la forward decl
	local userId = player.UserId
	local now = os.time()

	if gamePassCache[userId] and (now - gamePassCache[userId].lastCheck) < GAMEPASS_CACHE_DURATION then
		return gamePassCache[userId].multiplier
	end

	-- ✅ MODIFICATION: Addition de tous les GamePass au lieu de prendre le plus haut
	local totalMultiplier = 0
	local ownedPasses = {} -- Pour debug

	for passId, multiplier in pairs(gamePassMultipliers) do
		local hasPass = false

		if TEST_MODE and testPasses[passId] then
			hasPass = true
		else
			local success, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
			end)
			if success and owns then
				hasPass = true
			end
		end

		if hasPass then
			totalMultiplier = totalMultiplier + multiplier
			table.insert(ownedPasses, passId)
		end
	end

	-- 👑 VIP offert par un admin : même bonus que le gamepass VIP, sans le
	--    posséder. Disparaît automatiquement si l'admin retire le VIP.
	if _G.IsVIP and _G.IsVIP(userId) and not table.find(ownedPasses, 1891589121) then
		totalMultiplier = totalMultiplier + (gamePassMultipliers[1891589121] or 2)
		table.insert(ownedPasses, 1891589121)
	end

	-- ✨ BOOSTS PERMANENTS offerts (x2 / x5 / x10). Ils se comportent
	--    exactement comme un gamepass : additifs, permanents, et lus au
	--    MÊME endroit par AbsoluteCapProtection → zéro faux ban.
	local permBoost = (_G.PermBoosts and _G.PermBoosts.getMultiplier(userId)) or 0
	if permBoost > 0 then
		totalMultiplier = totalMultiplier + permBoost
		table.insert(ownedPasses, "perm+" .. permBoost)
	end

	-- Si aucun GamePass, retourner 1 (pas de bonus)
	if totalMultiplier == 0 then
		totalMultiplier = 1
	end

	gamePassCache[userId] = {
		multiplier = totalMultiplier,
		lastCheck = now,
		ownedPasses = ownedPasses -- ✅ Ajouté pour debug
	}

	-- ✅ LOG pour debug
	if #ownedPasses > 0 then
		print(string.format("🎫 GamePass pour %s: %d total (Passes: %s)", 
			player.Name, 
			totalMultiplier,
			table.concat(ownedPasses, ", ")
			))
	end

	return totalMultiplier
end

