	_G.lastNotifyReload[userId] = now

	print(string.format("🔔 RELOAD DEMANDÉ par %s (raison: %s)", player.Name, reason or "unknown"))

	-- ✨ Bloquer toute opération sensible (boost, etc.) DÈS MAINTENANT,
