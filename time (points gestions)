-- ========================================
-- ✅ NETTOYAGE COMBINÉ
-- ========================================
task.spawn(function()
	while true do
		task.wait(300)  -- 5 minutes
		local now = os.time()
		local totalCleaned = 0

		-- PARTIE 1: Cache Anti-Cheat
		local cleanedCache = 0
		for key, expiry in pairs(SmartAntiCheat.cacheExpiry) do
			if now >= expiry then
				SmartAntiCheat.calculationCache[key] = nil
				SmartAntiCheat.cacheExpiry[key] = nil
				cleanedCache = cleanedCache + 1
			end
		end

		-- ✅ CORRECTION : Déclarer cleanedValidation
		local cleanedValidation = 0

		for userId, data in pairs(SmartAntiCheat.playerData) do
			-- ✅ Nettoyer les gains expirés de la fenêtre de validation
			if data.validationWindow and data.validationWindow.expectedGains then
				local newExpected = {}
				for _, gain in ipairs(data.validationWindow.expectedGains) do
					if now - gain.timestamp < 60 then
						table.insert(newExpected, gain)
					else
						cleanedValidation = cleanedValidation + 1  -- ✅ CORRIGÉ
					end
				end
				data.validationWindow.expectedGains = newExpected
			end

			-- Nettoyer les cooldowns expirés (garder cette partie)
			if data.questTracking then
				for questType, questData in pairs(data.questTracking) do
					if now >= questData.cooldownEnd + 3600 then
						data.questTracking[questType] = nil
						cleanedValidation = cleanedValidation + 1  -- ✅ CORRIGÉ
					end
				end
			end
		end

		-- PARTIE 2: Tables mémoire
		local function cleanTable(tbl, maxAge)
			local removed = 0
			local count = 0
			local BATCH_SIZE = 100

			for key, timestamp in pairs(tbl) do
				if type(timestamp) == "number" and now - timestamp > maxAge then
					tbl[key] = nil
					removed = removed + 1
				elseif type(timestamp) == "boolean" then
					tbl[key] = nil
					removed = removed + 1
				end

				count = count + 1
				if count % BATCH_SIZE == 0 then
					task.wait()
				end
			end

			return removed
		end

		local cleanedMemory = 0

		cleanedMemory = cleanedMemory + cleanTable(lastPointLevelTouch, 3600)
		cleanedMemory = cleanedMemory + cleanTable(pointLevelGlobalDebounce, 300)
		cleanedMemory = cleanedMemory + cleanTable(checkpointTouchCooldown, 600)
		cleanedMemory = cleanedMemory + cleanTable(lastTotalKillStoreSave, 300)
		cleanedMemory = cleanedMemory + cleanTable(lastKillQuestSave, 300)

		-- PARTIE 3: Protections
		local cleanedProtections = 0
		for userId, protection in pairs(disconnectProtection) do
			if now >= protection.blockUntil then
				local player = Players:GetPlayerByUserId(userId)
				if not player or not player.Parent then
					disconnectProtection[userId] = nil
					cleanedProtections = cleanedProtections + 1
				end
			end
		end

		for userId, session in pairs(activeConnections) do
			if not session.player or not session.player.Parent then
				activeConnections[userId] = nil
				cleanedProtections = cleanedProtections + 1
			end
		end

		-- LOG
		totalCleaned = cleanedCache + cleanedValidation + cleanedMemory + cleanedProtections
		if totalCleaned > 0 then
			print(string.format("🧹 NETTOYAGE: %d entrées (Cache: %d | Validation: %d | Mémoire: %d | Protections: %d)", 
				totalCleaned, cleanedCache, cleanedValidation, cleanedMemory, cleanedProtections))
		end
	end
end)



