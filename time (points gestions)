-- Détection spam de Remote Events
-- ✅ FIX FAUX-BAN : compteur PAR REMOTE (avant : global → 2 remotes différents
-- dans la même seconde = infraction, 5 infractions = ban de joueur légitime)
function AntiExploit.CheckRemoteCall(player, remoteName)
	local userId = player.UserId
	local now = os.time()

	if not AntiExploit.playerTracking[userId] then
		AntiExploit.InitPlayer(userId)
	end

	local t = AntiExploit.playerTracking[userId]
	t.remotesByName = t.remotesByName or {}

	local rc = t.remotesByName[remoteName]
	if not rc or now - rc.lastReset >= 1 then
		rc = { count = 0, lastReset = now }
		t.remotesByName[remoteName] = rc
	end

	rc.count = rc.count + 1

	if rc.count > AntiExploit.CONFIG.MAX_REMOTE_CALLS_PER_SECOND then
		return AntiExploit.HandleSuspiciousActivity(
			player,
			"REMOTE_SPAM",
			string.format("Spam de %s (%d appels/sec, max: %d)",
				remoteName,
				rc.count,
				AntiExploit.CONFIG.MAX_REMOTE_CALLS_PER_SECOND)
		)
	end

	return true
end

-- Vérification cooldown des quests
function AntiExploit.CheckQuestCooldown(player, questName)
	local userId = player.UserId
	local now = os.time()

	if not AntiExploit.questHistory[userId] then
		AntiExploit.questHistory[userId] = {}
	end

	local lastClaim = AntiExploit.questHistory[userId][questName]

	if lastClaim and (now - lastClaim) < AntiExploit.CONFIG.QUEST_MIN_COOLDOWN then
		local timeLeft = AntiExploit.CONFIG.QUEST_MIN_COOLDOWN - (now - lastClaim)
		return AntiExploit.HandleSuspiciousActivity(
			player, 
			"QUEST_COOLDOWN_BYPASS", 
			string.format("Tentative de claim %s avant cooldown (%d heures restantes)", 
				questName, 
				math.floor(timeLeft / 3600))
		)
	end

	AntiExploit.questHistory[userId][questName] = now
	return true
end

-- ✅ Log doux des claims bloqués par cooldown — JAMAIS de ban.
function AntiExploit.NoteBlockedClaim(player, questName)
	local userId = player.UserId
	local t = AntiExploit.playerTracking[userId]
	if not t then return end
	t.blockedClaims = t.blockedClaims or {}
	t.blockedClaims[questName] = (t.blockedClaims[questName] or 0) + 1
	if t.blockedClaims[questName] % 25 == 0 then
		warn(string.format("ℹ️ %s: %d claims %s bloqués par cooldown (aucune sanction)",
			player.Name, t.blockedClaims[questName], questName))
	end
end

-- Gestion des activités suspectes
function AntiExploit.HandleSuspiciousActivity(player, violationType, details)
	local userId = player.UserId

	if isDeveloper(userId) then
		warn("🛠️ DEV MODE: Exploit ignoré pour", player.Name, "-", violationType, "-", details)
		return true
	end

	AntiExploit.infractions[userId] = (AntiExploit.infractions[userId] or 0) + 1

	-- ✅ NOUVEAU : Tracker le type de violation
	if not AntiExploit.playerTracking[userId] then
		AntiExploit.InitPlayer(userId)
	end
	AntiExploit.playerTracking[userId].lastViolationType = violationType
	AntiExploit.playerTracking[userId].lastViolationDetails = details

	-- Initialiser l'historique des violations si nécessaire
	if not AntiExploit.playerTracking[userId].violationHistory then
		AntiExploit.playerTracking[userId].violationHistory = {}
	end
	table.insert(AntiExploit.playerTracking[userId].violationHistory, {
		type = violationType,
		details = details,
		timestamp = os.time()
	})
	-- Garder seulement les 10 dernières violations
	if #AntiExploit.playerTracking[userId].violationHistory > 10 then
		table.remove(AntiExploit.playerTracking[userId].violationHistory, 1)
	end

	warn(string.format(
		"🚨 EXPLOIT DÉTECTÉ | Joueur: %s (ID: %d) | Type: %s | Détails: %s | Infractions: %d/%d",
		player.Name,
		userId,
		violationType,
		details,
		AntiExploit.infractions[userId],
		AntiExploit.CONFIG.BAN_THRESHOLD
		))

	if AntiExploit.infractions[userId] >= AntiExploit.CONFIG.BAN_THRESHOLD then
		AntiExploit.bannedPlayers[userId] = true

		if _G.BanManager then
			pcall(function()
				_G.BanManager.Log({
					userId = userId, reason = "exploit",
					details = violationType .. " — " .. tostring(details),
					action = "ban", name = player.Name, by = "AntiExploit",
				})
			end)
		end

		task.spawn(function()
			-- Ligne ~ligne 130 de ton script
			local banStore = DataStoreService:GetDataStore("BannedPlayers")
			pcall(function()
				banStore:SetAsync(tostring(userId), {
					reason = violationType,
					details = details,
					timestamp = os.time(),
					playerName = player.Name
				})
			end)
		end)

		if player.Parent then
			player:Kick(AntiExploit.CONFIG.KICK_MESSAGE)
		end

	else
		-- ✅ Avertissement simple, aucun kick intermédiaire
		warn(string.format(
			"⚠️ Avertissement %d/%d pour %s (ID: %d)",
			AntiExploit.infractions[userId],
			AntiExploit.CONFIG.BAN_THRESHOLD - 1,
			player.Name,
			userId
			))
	end

	return false
end


