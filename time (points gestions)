local function loadAllQuestCooldowns(userId)
	if questCooldownsLoaded[userId] == "fetched" then return end
	-- ("true" venant d'un snapshot/unifié ne suffit PAS : on lit quand
	--  même le store dédié, qui est la source la plus fraîche des claims)

	local key = "AllQuestCooldowns_" .. userId

	-- ✅ FIX MIGRATION : Retry 3x
	local success, data
	for attempt = 1, 3 do
		success, data = pcall(function()
			return questCooldownStore:GetAsync(key)
		end)
		if success then break end
		warn(string.format("⚠️ questCooldownStore tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.6 * attempt)
	end

	if not success then
		-- ❌ DataStore down après retries : NE PAS marquer comme loaded (sinon perte des cooldowns)
		warn(string.format("🚨 CRITIQUE: questCooldownStore inaccessible pour %d — saves bloqués jusqu'à recovery", userId))
		task.spawn(function()
			task.wait(30)
			if Players:GetPlayerByUserId(userId) then loadAllQuestCooldowns(userId) end
		end)
		return
	end

	if not AntiExploit.questHistory[userId] then
		AntiExploit.questHistory[userId] = {}
	end

	if data and type(data) == "table" then
		local now = os.time()
		local h = AntiExploit.questHistory[userId]
		for questName, lastClaim in pairs(data) do
			if type(lastClaim) == "number"
				and (now - lastClaim) < AntiExploit.CONFIG.QUEST_MIN_COOLDOWN
				and (not h[questName] or lastClaim > h[questName]) then  -- ✅ merge-max
				h[questName] = lastClaim
				local timeLeft = AntiExploit.CONFIG.QUEST_MIN_COOLDOWN - (now - lastClaim)
				print(string.format("🔒 Cooldown restauré: %s → %.1fh restantes",
					questName, timeLeft / 3600))
			end
		end
	end
	questCooldownsLoaded[userId] = "fetched"  -- ✅ store dédié bien lu
	print(string.format("✅ Cooldowns chargés pour UserID %d", userId))
end

local function saveQuestCooldown(userId, questName, timestamp)
	task.spawn(function()
		local key = "AllQuestCooldowns_" .. userId
		local saveOk, saveErr = pcall(function()
			questCooldownStore:UpdateAsync(key, function(existing)
				local toSave = (type(existing) == "table") and existing or {}
				toSave[questName] = math.max(toSave[questName] or 0, timestamp)  -- merge-max
				local now = os.time()
				for qName, ts in pairs(toSave) do
					if type(ts) ~= "number" or (now - ts) >= AntiExploit.CONFIG.QUEST_MIN_COOLDOWN then
						toSave[qName] = nil
					end
				end
				return toSave
			end)
		end)
		if saveOk then
			print(string.format("✅ Cooldown sauvegardé: %s pour UserID %d", questName, userId))
		else
			warn(string.format("❌ Erreur save cooldown %s: %s", questName, tostring(saveErr)))
		end
	end)
end


