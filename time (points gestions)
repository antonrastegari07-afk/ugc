	playerTouchedCheckpoints[userId] = nil
	playerEarnedPointLevels[userId] = nil
	playerRedeemedCodes[userId] = nil
	Settings.data[userId] = nil
	Settings.rate[userId] = nil
	gamePassCache[userId] = nil
	_G.ACOptim.status[userId] = nil
	_G.ACOptim.attrAt[userId] = nil
	uiUpdateQueue[userId] = nil
	lastUIUpdate[userId] = nil
	pointLevelGlobalDebounce[userId] = nil
	AntiExploit.playerTracking[userId] = nil
	AntiExploit.infractions[userId] = nil
	AntiExploit.questHistory[userId] = nil
	SmartAntiCheat.playerData[userId] = nil
	questCooldownsLoaded[userId] = nil
	pendingSaves[userId] = nil
	plannedReloads[userId] = nil
	activeConnections[userId] = nil
	disconnectProtection[userId] = nil
	rebirthTriggerCooldown[userId] = nil
	playerPlaytime[userId] = nil
	playerSessionStart[userId] = nil

	local userIdStr = tostring(userId)
	for key in pairs(lastPointLevelTouch) do
		if type(key) == "string" and key:match("^" .. userIdStr .. "_") then
			lastPointLevelTouch[key] = nil
		end
	end
	for key in pairs(checkpointTouchCooldown) do
		if type(key) == "string" and key:match("^" .. userIdStr .. "_") then
			checkpointTouchCooldown[key] = nil
		end
	end
	for key in pairs(checkpointRecountTimers) do
		if type(key) == "string" and key:match("^" .. userIdStr .. "_") then
			checkpointRecountTimers[key] = nil
		end
	end
	for _, friendList in pairs(friendsCache) do
		if type(friendList) == "table" and friendList[userId] then
			friendList[userId] = nil
		end
	end

	print(string.format("🧹 Cleanup mémoire complet pour %s", player.Name))

	-- ═══════════════════════════════════
	-- ÉTAPE 4 : POSER LE SESSION LOCK + MARQUER RELOAD
	-- ═══════════════════════════════════
	acquireSessionLock(userId, totalPoints, questSnapshot)
	recentReloads[userId] = now

	-- ✅ FIX : Notifier LossGuard pour qu'il ignore les saves pendant ce reload
	if LossGuard.markReloading then
		LossGuard.markReloading(userId)
	end

	print(string.format("🔒 SessionLock posé (%d pts) + recentReloads marqué pour %s", 
		totalPoints, player.Name))

	-- ═══════════════════════════════════
	-- ÉTAPE 5 : CONFIRMER AU CLIENT → IL PEUT TÉLÉPORTER
	-- ═══════════════════════════════════
	-- 💤 Position exacte pour le retour (fallback = checkpoint)
	if _G.SaveReloadPosition then
		pcall(_G.SaveReloadPosition, player)
	end

	pcall(function()
		reloadConfirmedEvent:FireClient(player, true)
	end)

	print(string.format("✅ ACK envoyé à %s → téléportation autorisée", player.Name))

	-- Nettoyage recentReloads après 60s (sécurité)
	task.delay(120, function()
		if recentReloads[userId] == now then
			recentReloads[userId] = nil
		end
	end)
end)
