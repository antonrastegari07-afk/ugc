-- ⚠️ Pas de local pour le remote (économie de registres, limite 200)
getOrCreateRemote("UpdateSetting").OnServerEvent:Connect(function(player, name, value)
	local userId = player.UserId
	if type(name) ~= "string" then return end
	if not Settings.rateOk(userId) then return end           -- drop, pas d'infraction
	if dataLoading[userId] or player:GetAttribute("SettingsLoaded") ~= true then return end  -- jamais avant que la sauvegarde soit appliquée

	local clean = Settings.sanitize(name, value)
	if clean == nil then return end                          -- nom inconnu / valeur invalide → ignore

	if Settings.data[userId] == nil then
		Settings.data[userId] = Settings.default()
	end
	Settings.data[userId][name] = clean
	-- 🏷️ Le style de billboard doit être lisible CÔTÉ SERVEUR tout de
	--    suite : c'est le script du billboard qui le lit pour redessiner.
	--    Uniquement pour ce réglage-là — les autres ne changent pas.
	-- 🥔 SettingPerfMode aussi : le serveur des armes le lit pour ne plus
	--    envoyer les impacts des autres à un joueur en mode performance.
	--    Sans ça, il ne voyait que la valeur du moment où le joueur a rejoint.
	if name == "SettingPointStyle" or name == "SettingPerfMode" then
		player:SetAttribute(name, clean)
	end
	-- Pas de save immédiat : l'autosave + le save au départ persistent (optimisé)
end)

