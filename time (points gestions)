-- ========================================
function secureSave(userId, data, retryCount, skipReloadCheck)
	retryCount = retryCount or 0

	local playerData = tempsJoueurs[userId]
	if type(playerData) == "table" and playerData.loading then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	-- ✅ FIX 11 : skipReloadCheck=true permet à notifyReloadEvent d'écrire à unified
	-- pendant un reload (sinon le check recentReloads bloquerait l'écriture
	-- et unified resterait stale, causant perte de données si reload >30s)
	if not skipReloadCheck and recentReloads[userId] then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	if dataLoading[userId] then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	local protection = disconnectProtection[userId]
	if protection and os.time() < protection.blockUntil then
		local currentSession = activeConnections[userId]
		if currentSession and currentSession.player and currentSession.player.Parent then
			_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
			return false
		end
	end

	if retryCount >= MAX_SAVE_RETRIES then
		_G.PlayerDataStats.saveFail = _G.PlayerDataStats.saveFail + 1
		warn("❌ ÉCHEC secureSave: " .. userId .. " après " .. MAX_SAVE_RETRIES .. " tentatives")
		return false
	end

	data = validatePoints(data)

	-- ✅ FIX MIGRATION : check 100% mémoire (pas de GetAsync)
	-- On vérifie que TOUS les chargeurs critiques ont fini avant d'écrire,
	-- sinon on écrirait des 0/{} qui écraseraient la vraie data au prochain load.
	if not isAllSecondaryLoaded(userId) then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		warn(string.format(
			"🛡️ secureSave reporté pour %d : loaders pas finis (cp=%s, kills=%s, qcd=%s, rr=%s)",
			userId,
			tostring(playerCheckpoints[userId] ~= nil),
			tostring(playerKillCount[userId] ~= nil),
			tostring(questCooldownsLoaded[userId] ~= nil),
			tostring(allowedRebirth[userId] ~= nil)
			))
		return false
	end

	-- ✅ Plus de probe DataStore : isAllSecondaryLoaded (vérifié plus haut) garantit
	-- que les valeurs en mémoire sont définitives. Si une valeur est encore nil ici,
	-- c'est un vrai nouveau joueur (ou une table vide légitime) → default OK.
	local function getExistingFallback(memValue, fieldName, default)
		if memValue ~= nil then return memValue end
		return default
	end

	-- Anti-perte
	if retryCount == 0 and not LossGuard.validateSave(userId, data, "secureSave") then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	if pendingSaves[userId] then return false end
	pendingSaves[userId] = true

	-- ✅ Construire le payload unifié avec protection contre les nil en mémoire
	local payload = {
		version       = 1,
		migrated      = true,  -- ✅ FLAG : marque le joueur comme post-migration PlayerData_v1
		points        = data,
		rebirthCount  = getExistingFallback(playerRebirthCount[userId], "rebirthCount", 0),
		rebirthRight  = getExistingFallback(allowedRebirth[userId], "rebirthRight", false) == true,
		lastSavedAt   = os.time(),

		-- Checkpoint quest
		checkpoints           = getExistingFallback(playerCheckpoints[userId], "checkpoints", 0),
		checkpointCooldownEnd = getExistingFallback(checkpointQuestCooldowns[userId], "checkpointCooldownEnd", 0),
		touchedCheckpoints    = getExistingFallback(playerTouchedCheckpoints[userId], "touchedCheckpoints", {}),
		earnedPointLevels     = getExistingFallback(playerEarnedPointLevels[userId], "earnedPointLevels", {}),

		-- Kills
		killCount         = getExistingFallback(playerKillCount[userId], "killCount", 0),
		killCooldown      = getExistingFallback(playerKillCooldown[userId], "killCooldown", 0),
		killQuestProgress = getExistingFallback(killQuestProgress[userId], "killQuestProgress", 0),
		killQuestCooldown = getExistingFallback(killQuestCooldowns[userId], "killQuestCooldown", 0),

		-- Quest cooldowns
		questCooldowns = getExistingFallback(
			(AntiExploit.questHistory and AntiExploit.questHistory[userId]),
			"questCooldowns", {}
		),

		-- Codes redeem
		redeemedCodes = getExistingFallback(playerRedeemedCodes[userId], "redeemedCodes", {}),

		-- ⚙️ Paramètres joueur
		settings = getExistingFallback(Settings.data[userId], "settings", Settings.default()),

		-- Playtime lifetime
		playtimeSeconds = getCurrentPlaytime(userId),

		-- Anti-cheat
		warningInfractions = getExistingFallback(
			(AntiExploit.infractions and AntiExploit.infractions[userId]),
			"warningInfractions", 0
		),
		smartAntiCheatInfractions = (
			SmartAntiCheat.playerData
				and SmartAntiCheat.playerData[userId]
				and SmartAntiCheat.playerData[userId].infractions
		) and {
			suspiciousCount    = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
			dangerousCount     = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
			totalInfractions   = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
			burstCount         = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
			lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
		} or nil,
	}

	-- 🛡️ FIX : persister aussi P2 (totalSpent) et boosts dans le store UNIFIÉ.
	-- Sinon ces données ne vivent QUE dans le SessionLock (lu seulement si reconnexion <30s
	-- ou reload). Une reconnexion normale >30s lit l'unifié → P2/boosts perdus.
	if type(_G.enrichQuestSnapshotWithP2) == "function" then
		payload = _G.enrichQuestSnapshotWithP2(userId, payload)
	end
	if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
		payload = _G.enrichQuestSnapshotWithBoosts(userId, payload)
	end
	-- ⏱️ UpdateAsync au lieu de SetAsync : on garde le MAX entre le playtime
	--    déjà en base et celui qu'on écrit. Un playtime à 0 en mémoire ne peut
	--    plus effacer celui du joueur.
	local keptPlaytime = nil
	local success, err = pcall(function()
		PLAYER_DATA_STORE:UpdateAsync("p_" .. userId, function(old)
			keptPlaytime = nil
			local oldPt = (type(old) == "table" and tonumber(old.playtimeSeconds)) or 0
			if oldPt > (tonumber(payload.playtimeSeconds) or 0) then
				payload.playtimeSeconds = oldPt
				keptPlaytime = oldPt
			end
			return payload
		end)
	end)
	pendingSaves[userId] = nil
	if success and keptPlaytime then _G.PlaytimeRepair(userId, keptPlaytime) end


	if success then
		_G.PlayerDataStats.saveSuccess = _G.PlayerDataStats.saveSuccess + 1
		print("✅ SAVE UNIFIÉ: UserID " .. userId .. " | " .. data .. " pts | "
			.. (payload.rebirthCount) .. " rebirths")

		LossGuard.setLastSaved(userId, data)

		-- Update SessionLock (filet sécurité reconnect rapide)
		-- ✅ FIX RACE : Si reload en cours (skipReloadCheck=true), NE PAS écraser le SessionLock
		-- complet (avec questSnapshot) que notifyReloadEvent posera via acquireSessionLock.
		-- Pour les saves normaux : on écrit un lock minimal (recentReloads bloque déjà
		-- toute concurrence avec une période de reload).
		if not skipReloadCheck then
			local capturedCodes = playerRedeemedCodes[userId] or {}
			local capturedPlaytime = getCurrentPlaytime(userId)
			local capturedSettings = Settings.data[userId] or Settings.default()
			-- ✅ FIX RE-FARM : capturer AUSSI l'état quêtes/PointLevels dans le lock.
			-- Sans questSnapshot, un quit+rejoin <30s prend le raccourci SessionLock,
			-- playerCheckpoints reste nil → loadCheckpointQuestData relit un
			-- checkpointQuestStore stale → playerEarnedPointLevels perd les derniers
			-- checkpoints → re-farm des 100 pts.
			-- NOTE : isAllSecondaryLoaded a déjà été vérifié plus haut dans secureSave,
			-- donc ces tables sont garanties chargées (pas de risque d'écrire des {}).
			local capturedSnapshot = {
				checkpoints        = playerCheckpoints[userId] or 0,
				cooldownEnd        = checkpointQuestCooldowns[userId] or 0,
				touchedUIDs        = playerTouchedCheckpoints[userId] or {},
				earnedPointLevels  = playerEarnedPointLevels[userId] or {},
				killCount          = playerKillCount[userId] or 0,
				killCooldown       = playerKillCooldown[userId] or 0,
				killQuestCooldowns = killQuestCooldowns[userId] or 0,
				killQuestProgress  = killQuestProgress[userId] or 0,
				redeemedCodes      = capturedCodes,
				settings           = capturedSettings,
				playtimeSeconds    = capturedPlaytime,
				rebirthCount       = playerRebirthCount[userId] or 0,
				allowedRebirth     = allowedRebirth[userId] == true,
				questHistory       = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},
				antiExploitInfractions = AntiExploit.infractions[userId] or 0,
				-- 🛡️ FIX : inclure aussi SmartAntiCheat (sinon reset à 0 en reconnexion rapide <30s)
				smartAntiCheatInfractions = (
					SmartAntiCheat.playerData[userId]
						and SmartAntiCheat.playerData[userId].infractions
				) and {
					suspiciousCount    = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
					dangerousCount     = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
					totalInfractions   = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
					burstCount         = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
					lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
				} or nil,
			}
			-- Enrichir comme le fait BindToClose (P2 / boosts) si les hooks existent
			if type(_G.enrichQuestSnapshotWithP2) == "function" then
				capturedSnapshot = _G.enrichQuestSnapshotWithP2(userId, capturedSnapshot)
			end
			if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
				capturedSnapshot = _G.enrichQuestSnapshotWithBoosts(userId, capturedSnapshot)
			end
			task.spawn(function()
				pcall(function()
					SESSION_LOCK_STORE:SetAsync("lock_" .. userId, {
						points = data,
						timestamp = os.time(),
						expiresAt = os.time() + SESSION_LOCK_DURATION,
						redeemedCodes = capturedCodes,
						playtimeSeconds = capturedPlaytime,
						settings = capturedSettings,
						questSnapshot = capturedSnapshot,  -- ✅ FIX RE-FARM
					})
				end)
			end)
		end

		return true
	else
		warn("⚠️ Save échoué " .. userId .. " (tentative " .. (retryCount + 1) .. "): " .. tostring(err))
		task.wait(1)
		-- ✅ FIX 11 : propager skipReloadCheck dans le retry pour rester cohérent
		return secureSave(userId, data, retryCount + 1, skipReloadCheck)
	end
end

local function secureLoad(userId)
	local newKey = "p_" .. userId
	local oldKey = "temps_" .. userId

	print("🔍 CHARGEMENT pour UserID:", userId)

	-- 1. SessionLock check (reconnect rapide, inchangé)
	local lockOk, lockData = pcall(function()
		return SESSION_LOCK_STORE:GetAsync("lock_" .. userId)
	end)

	if lockOk and lockData and lockData.points then
		local lockAge = os.time() - (lockData.timestamp or 0)
		if lockAge < 30 and lockData.points > 0 then
			-- ✅ FIX ANTI-RE-REDEEM : si le lock ne contient PAS redeemedCodes (vieux format),
			-- on REFUSE le shortcut et on fall through vers PlayerData_v1.
			-- Sinon, un joueur pourrait quitter et revenir pour re-claim un code.
			local lockHasCodes = type(lockData.redeemedCodes) == "table"
				or (lockData.questSnapshot and type(lockData.questSnapshot.redeemedCodes) == "table")

			if not lockHasCodes then
				warn(string.format("⚠️ SessionLock sans redeemedCodes pour %d → fallback PlayerData_v1 (anti re-redeem)", userId))
			else
				print(string.format("🔒 SessionLock récent (%ds) → %d pts pour %d",
					lockAge, lockData.points, userId))

				-- ✅ Restaurer redeemedCodes (top-level prioritaire, sinon depuis questSnapshot)
				if type(lockData.redeemedCodes) == "table" then
					playerRedeemedCodes[userId] = lockData.redeemedCodes
				else
					playerRedeemedCodes[userId] = lockData.questSnapshot.redeemedCodes
				end

				-- ⚙️ Restaurer paramètres (top-level prioritaire, sinon questSnapshot)
				if type(lockData.settings) == "table" then
					Settings.data[userId] = lockData.settings
				elseif lockData.questSnapshot and type(lockData.questSnapshot.settings) == "table" then
					Settings.data[userId] = lockData.questSnapshot.settings
				end

				if lockData.questSnapshot then
					local snap = lockData.questSnapshot
					playerCheckpoints[userId]        = snap.checkpoints or 0
					checkpointQuestCooldowns[userId] = snap.cooldownEnd or 0
					playerTouchedCheckpoints[userId] = snap.touchedUIDs or {}
					playerEarnedPointLevels[userId]  = snap.earnedPointLevels or {}
					playerKillCount[userId]          = snap.killCount or 0
					playerKillCooldown[userId]       = snap.killCooldown or 0
					killQuestCooldowns[userId]       = snap.killQuestCooldowns or 0
					killQuestProgress[userId]        = snap.killQuestProgress or 0

					-- ✅ FIX : Reset cooldowns expirés depuis SessionLock aussi
					local nowSL = os.time()
					if playerKillCooldown[userId] > 0 and nowSL >= playerKillCooldown[userId] then
						playerKillCount[userId]    = 0
						playerKillCooldown[userId] = 0
						print(string.format("✅ Cooldown 100-kills expiré au load SessionLock pour %d", userId))
					end
					if (checkpointQuestCooldowns[userId] or 0) > 0 and nowSL >= checkpointQuestCooldowns[userId] then
						playerCheckpoints[userId]        = 0
						checkpointQuestCooldowns[userId] = 0
						playerTouchedCheckpoints[userId] = {}
						print(string.format("✅ CheckpointQuest cooldown 24h expiré au load SessionLock pour %d", userId))
					end

					-- ✅ FIX FIABILITÉ : restaurer aussi rebirths, allowedRebirth, et cooldowns quêtes
					if type(snap.rebirthCount) == "number" then
						playerRebirthCount[userId] = snap.rebirthCount
					end
					if snap.allowedRebirth ~= nil then
						allowedRebirth[userId] = snap.allowedRebirth == true
					end
					if type(snap.questHistory) == "table" then
						mergeQuestHistory(userId, snap.questHistory)          -- ✅ merge, pas écrase
						questCooldownsLoaded[userId] = questCooldownsLoaded[userId] or true
					end

					if snap.antiExploitInfractions and snap.antiExploitInfractions > 0 then
						AntiExploit.infractions[userId] = snap.antiExploitInfractions
					end
					if snap.smartAntiCheatInfractions then
						if not SmartAntiCheat.playerData[userId] then
							SmartAntiCheat.InitPlayer(userId)
						end
						local sd = SmartAntiCheat.playerData[userId]
						if sd then
							sd.infractions = {
								suspiciousCount    = snap.smartAntiCheatInfractions.suspiciousCount or 0,
								dangerousCount     = snap.smartAntiCheatInfractions.dangerousCount or 0,
								totalInfractions   = snap.smartAntiCheatInfractions.totalInfractions or 0,
								burstCount         = snap.smartAntiCheatInfractions.burstCount or 0,
								lastInfractionTime = snap.smartAntiCheatInfractions.lastInfractionTime or 0,
							}
						end
					end
				end

				-- ⏱️ Restaurer playtime (priorité : top-level → questSnapshot → fallback unifié)
				local lockedPlaytime = nil
				if type(lockData.playtimeSeconds) == "number" then
					lockedPlaytime = lockData.playtimeSeconds
				elseif lockData.questSnapshot and type(lockData.questSnapshot.playtimeSeconds) == "number" then
					lockedPlaytime = lockData.questSnapshot.playtimeSeconds
				end

				if lockedPlaytime then
					playerPlaytime[userId] = lockedPlaytime
					print(string.format("⏱️ Playtime restauré depuis SessionLock: %d sec pour %d", lockedPlaytime, userId))
				else
					-- ⚠️ Vieux SessionLock sans playtime → fallback unifié pour ne rien perdre
					local pOk, pData = pcall(function()
						return PLAYER_DATA_STORE:GetAsync(newKey)
					end)
					if pOk and type(pData) == "table" and type(pData.playtimeSeconds) == "number" then
						playerPlaytime[userId] = pData.playtimeSeconds
						print(string.format("⏱️ Playtime fallback unifié (SessionLock incomplet): %d sec pour %d", pData.playtimeSeconds, userId))
					else
						playerPlaytime[userId] = 0
						warn(string.format("⚠️ Playtime introuvable pour %d (SessionLock + unifié vides)", userId))
					end
				end

				task.spawn(function()
					pcall(function()
						SESSION_LOCK_STORE:RemoveAsync("lock_" .. userId)
					end)
				end)
				return validatePoints(lockData.points)
			end
		end
	end

	-- 2. ✅ Essai du store unifié avec 3 tentatives
	local unifiedOk, unifiedData
	for attempt = 1, 3 do
		unifiedOk, unifiedData = pcall(function()
			return PLAYER_DATA_STORE:GetAsync(newKey)
		end)
		if unifiedOk then break end
		warn(string.format("⚠️ PLAYER_DATA_STORE tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.8 * attempt)
	end

	-- 2b. 🚨 FIX CRITIQUE : Si lecture unified ÉCHOUÉE (réseau/timeout) → kick préventif
	-- Ne JAMAIS fall back vers legacy post-migration, ça écrase la vraie data avec du stale
	if not unifiedOk then
		_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
		warn(string.format(
			"🚨 CRITIQUE: PLAYER_DATA_STORE inaccessible pour %d (3 tentatives) → kick préventif",
			userId
			))
		return nil
	end

	-- 2c. 🚨 FIX CRITIQUE : Joueur marqué migrated=true mais payload corrompu → kick
	-- Détecte le cas où Roblox renvoie un payload partiel/cassé pour un joueur déjà migré
	if type(unifiedData) == "table" and unifiedData.migrated == true
		and type(unifiedData.points) ~= "number" then
		_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
		warn(string.format(
			"🚨 CRITIQUE: Joueur %d a flag migrated=true mais payload corrompu → kick préventif",
			userId
			))
		return nil
	end

	-- 2d. Unified hit : utiliser la data unifiée
	if type(unifiedData) == "table" and type(unifiedData.points) == "number" then
		_G.PlayerDataStats.loadSuccessUnified = _G.PlayerDataStats.loadSuccessUnified + 1

		-- Restaurer TOUTES les données en mémoire (1 seule lecture pour tout)
		playerRebirthCount[userId]       = unifiedData.rebirthCount or 0
		allowedRebirth[userId]           = unifiedData.rebirthRight == true

		playerCheckpoints[userId]        = unifiedData.checkpoints or 0
		checkpointQuestCooldowns[userId] = unifiedData.checkpointCooldownEnd or 0
		playerTouchedCheckpoints[userId] = unifiedData.touchedCheckpoints or {}
		playerEarnedPointLevels[userId]  = unifiedData.earnedPointLevels or {}

		playerKillCount[userId]          = unifiedData.killCount or 0
		playerKillCooldown[userId]       = unifiedData.killCooldown or 0
		killQuestProgress[userId]        = unifiedData.killQuestProgress or 0
		-- 🛡️ FIX FARM : merge-max (jamais reculer). Le store kq_ est écrit immédiatement à
		-- chaque claim ; si l'unifié est en retard, écraser downgraderait le cooldown 24h
		-- de la KillQuest → re-claim = farm 10 000 pts.
		killQuestCooldowns[userId]       = math.max(killQuestCooldowns[userId] or 0, unifiedData.killQuestCooldown or 0)

		-- ✅ FIX MIGRATION : Reset cooldown 100-kills si expiré offline
		local nowLoad = os.time()
		if playerKillCooldown[userId] > 0 and nowLoad >= playerKillCooldown[userId] then
			playerKillCount[userId]    = 0
			playerKillCooldown[userId] = 0
			print(string.format("✅ Cooldown 100-kills expiré au load unified pour %d", userId))
		end

		-- ✅ FIX MIGRATION : Reset checkpoint quest si cooldown 24h expiré offline
		if (checkpointQuestCooldowns[userId] or 0) > 0 and nowLoad >= checkpointQuestCooldowns[userId] then
			playerCheckpoints[userId]        = 0
			checkpointQuestCooldowns[userId] = 0
			playerTouchedCheckpoints[userId] = {}
			-- NE PAS reset playerEarnedPointLevels (reset uniquement au rebirth)
			print(string.format("✅ CheckpointQuest cooldown 24h expiré au load unified pour %d", userId))
		end

		-- ✅ FIX : MERGE au lieu d'écraser. loadAllQuestCooldowns (store dédié, écrit
		-- immédiatement à chaque claim) tourne en parallèle : si unified est stale
		-- (dernier save raté après un claim), écraser effacerait un cooldown plus frais
		-- → re-claim possible d'une quête 8h/24h.
		mergeQuestHistory(userId, unifiedData.questCooldowns)
		questCooldownsLoaded[userId] = questCooldownsLoaded[userId] or true
		-- (ne pas rétrograder "fetched" → true)

		if type(unifiedData.redeemedCodes) == "table" then
			playerRedeemedCodes[userId] = unifiedData.redeemedCodes
		else
			playerRedeemedCodes[userId] = {}
		end

		-- Restaurer playtime lifetime
		playerPlaytime[userId] = unifiedData.playtimeSeconds or 0

		-- ⚙️ Restaurer paramètres joueur
		if type(unifiedData.settings) == "table" then
			Settings.data[userId] = unifiedData.settings
		else
			Settings.data[userId] = Settings.default()
		end

		if type(unifiedData.warningInfractions) == "number" then
			AntiExploit.infractions[userId] = unifiedData.warningInfractions
		end

		if type(unifiedData.smartAntiCheatInfractions) == "table" then
			if not SmartAntiCheat.playerData[userId] then
				SmartAntiCheat.InitPlayer(userId)
			end
			local sd = SmartAntiCheat.playerData[userId]
			if sd then
				sd.infractions = {
					suspiciousCount    = unifiedData.smartAntiCheatInfractions.suspiciousCount or 0,
					dangerousCount     = unifiedData.smartAntiCheatInfractions.dangerousCount or 0,
					totalInfractions   = unifiedData.smartAntiCheatInfractions.totalInfractions or 0,
					burstCount         = unifiedData.smartAntiCheatInfractions.burstCount or 0,
					lastInfractionTime = unifiedData.smartAntiCheatInfractions.lastInfractionTime or 0,
				}
			end
		end

		local pts = validatePoints(unifiedData.points)
		print(string.format("✅ UNIFIÉ: %d pts | %d rebirths | %d checkpoints | %d kills",
			pts, unifiedData.rebirthCount or 0, unifiedData.checkpoints or 0, unifiedData.killCount or 0))
		return pts
	end

	-- 3. ✅ MIGRATION : pas trouvé dans unifié, lire ancien store (points + rebirths uniquement)
	print("📦 Pas dans unifié, migration depuis ancien store pour " .. userId)

	-- Points depuis l'ancien tempsStore
	local oldSuccess, oldData
	for attempt = 1, 2 do
		oldSuccess, oldData = pcall(function()
			return tempsStore:GetAsync(oldKey)
		end)
		if oldSuccess then break end
		task.wait(0.6 * attempt)
	end

	-- ✅ FIX RACE : Rebirths depuis l'ancien rebirthCountStore (SYNCHRONE avec retry)
	-- Avant: task.spawn → secureSave pouvait écrire rebirthCount=0 avant la fin du load
	local rebirthLoaded = false
	for attempt = 1, 3 do
		local okR, rebirthData = pcall(function()
			return rebirthCountStore:GetAsync("rebirth_" .. userId)
		end)
		if okR then
			if type(rebirthData) == "number" and rebirthData > 0 then
				playerRebirthCount[userId] = rebirthData
				print("📦 Rebirths legacy chargés: " .. rebirthData .. " pour " .. userId)
			else
				playerRebirthCount[userId] = 0
			end
			rebirthLoaded = true
			break
		end
		warn(string.format("⚠️ rebirthCountStore tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.5 * attempt)
	end

	if not rebirthLoaded then
		-- DataStore down : NE PAS setter à 0, signaler échec critique
		warn(string.format("🚨 CRITIQUE: rebirthCountStore inaccessible pour %d → load avorté", userId))
		_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
		return nil  -- Provoque kick préventif dans PlayerAdded (déjà géré)
	end

	if oldSuccess and oldData and type(oldData) == "number" and oldData > 0 then
		_G.PlayerDataStats.loadFromLegacy = _G.PlayerDataStats.loadFromLegacy + 1
		local pts = validatePoints(oldData)
		-- ✅ FIX MIGRATION : Init playerRedeemedCodes (pas de store legacy pour ça)
		if playerRedeemedCodes[userId] == nil then
			playerRedeemedCodes[userId] = {}
		end
		print("✅ POINTS LEGACY: " .. pts .. " pour " .. userId .. " (sera migré au prochain save)")
		return pts
	end

	-- 4. Backup stores (filet de sécurité existant, séquentiel)
	if oldSuccess then
		-- Le main a répondu nil → tenter les backups
		local maxBackupValue = 0
		for i, backupStore in ipairs(backupStores) do
			local backupOk, backupData = pcall(function()
				return backupStore:GetAsync(oldKey)
			end)
			if backupOk and backupData and type(backupData) == "number" and backupData > 0 then
				maxBackupValue = validatePoints(backupData)
				print("📦 BACKUP " .. i .. " utilisé: " .. maxBackupValue)
				break
			end
			task.wait(0.4)
		end

		if maxBackupValue > 0 then
			_G.PlayerDataStats.loadFromLegacy = _G.PlayerDataStats.loadFromLegacy + 1
			if playerRedeemedCodes[userId] == nil then
				playerRedeemedCodes[userId] = {}
			end
			return maxBackupValue
		end

		-- Vraiment nouveau joueur
		_G.PlayerDataStats.loadNewPlayer = _G.PlayerDataStats.loadNewPlayer + 1
		if playerRedeemedCodes[userId] == nil then
			playerRedeemedCodes[userId] = {}
		end
		print("ℹ️ NOUVEAU JOUEUR: " .. userId)
		return 0
	end

	-- 5. Échec total des reads (kick préventif)
	_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
	warn("🚨 ÉCHEC TOTAL secureLoad pour " .. userId .. " → nil (kick préventif)")
	return nil
end

