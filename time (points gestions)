local function giveQuestReward(player, questName, points, extraCheck)
	if not player or not player.Parent then return end

	local userId = player.UserId

	-- Anti-spam
	if not AntiExploit.CheckRemoteCall(player, questName) then return end

	-- Attendre que les cooldowns soient chargés (max 5 secondes)
	local waited = 0
	while not questCooldownsLoaded[userId] and waited < 50 do
		task.wait(0.1)
		waited = waited + 1
	end

	-- Si toujours pas chargé après 5s, refuser sans infraction
	if not questCooldownsLoaded[userId] then
		warn(string.format("⚠️ Cooldowns pas chargés pour %s, quête %s refusée", 
			player.Name, questName))
		pcall(function() waitTmrEvent:FireClient(player) end)
		return
	end

	-- Vérifier cooldown en RAM
	local now = os.time()
	local lastClaim = AntiExploit.questHistory[userId] and
		AntiExploit.questHistory[userId][questName]

	if lastClaim and (now - lastClaim) < AntiExploit.CONFIG.QUEST_MIN_COOLDOWN then
		-- ✅ FIX FAUX-BAN : rejet silencieux, aucune infraction.
		AntiExploit.NoteBlockedClaim(player, questName)
		pcall(function() waitTmrEvent:FireClient(player) end)
		return
	end

	-- Check optionnel (groupe, etc.)
	if extraCheck and not extraCheck() then return end

	-- Enregistrer cooldown en RAM immédiatement
	if not AntiExploit.questHistory[userId] then
		AntiExploit.questHistory[userId] = {}
	end
	AntiExploit.questHistory[userId][questName] = now

	-- Sauvegarder en DataStore en arrière-plan
	saveQuestCooldown(userId, questName, now)

	-- Donner les points
	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, points, questName)
	tempsJoueurs[userId].future = tempsJoueurs[userId].future + points

	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local total = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value = applyAllBonuses(calculatePoints(total), player)
		player:SetAttribute("Points", pointsStat.Value)

		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = pointsStat.Value
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end
	end

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, points, questName)
	end)
	task.spawn(function()
		local total = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		secureSave(userId, total)
	end)

	pcall(function() buyGamePassEvent:FireClient(player) end)
	print(string.format("✅ QUÊTE: %s → +%d pts (%s)", player.Name, points, questName))
end




