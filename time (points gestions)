local function awardPointLevel(player, part)
	if not player or not player.Parent then return end
	local userId = player.UserId

	-- Bloquer si les données ne sont pas encore chargées
	if playerEarnedPointLevels[userId] == nil then return end

	local rebirthCount = playerRebirthCount[userId] or 0
	local partUID = getOrCreateCheckpointUID(part, rebirthCount)
	local now = os.time()

	-- Anti-spam global 0.5s par joueur
	if pointLevelGlobalDebounce[userId] and now - pointLevelGlobalDebounce[userId] < 0.5 then
		return
	end
	pointLevelGlobalDebounce[userId] = now

	-- Cooldown 20 min par checkpoint (mémoire volatile)
	local key = tostring(userId) .. "_" .. tostring(partUID)
	if lastPointLevelTouch[key] and now - lastPointLevelTouch[key] < POINT_LEVEL_COOLDOWN then
		return
	end

	-- Défense 1 : playerEarnedPointLevels (persistant, reset UNIQUEMENT sur rebirth)
	if playerEarnedPointLevels[userId][partUID] then
		local df = player:FindFirstChild("CheckpointData")
		if df then
			local ck = "checkpoint_" .. tostring(partUID)
			if not df:FindFirstChild(ck) then
				local m = Instance.new("BoolValue")
				m.Name = ck ; m.Value = true ; m.Parent = df
			end
		end
		return
	end

	-- Défense 2 : CheckpointData folder (protection intra-session)
	local dataFolder = player:FindFirstChild("CheckpointData")
	if dataFolder then
		local countKey = "checkpoint_" .. tostring(partUID)
		if dataFolder:FindFirstChild(countKey) then
			playerEarnedPointLevels[userId][partUID] = true  -- resync persistant
			markCheckpointDirty(userId)
			return
		end
	end

	-- Premier touch valide dans ce cycle rebirth
	lastPointLevelTouch[key] = now

	-- Marquer le folder immédiatement (défense intra-session)
	if not dataFolder then
		dataFolder = Instance.new("Folder")
		dataFolder.Name = "CheckpointData" ; dataFolder.Parent = player
	end
	local countKey = "checkpoint_" .. tostring(partUID)
	if not dataFolder:FindFirstChild(countKey) then
		local marker = Instance.new("BoolValue")
		marker.Name = countKey ; marker.Value = true ; marker.Parent = dataFolder
	end

	-- Marquer dans la table persistante (survit aux reloads et resets 24h)
	playerEarnedPointLevels[userId][partUID] = true

	-- 🏃 NoDeathRun : on ne prévient la quête QUE ici, c'est-à-dire seulement
	-- quand les 100 pts sont réellement accordés. Un checkpoint déjà encaissé
	-- sort plus haut par un return → il ne compte pas pour la quête.
	if _G.NoDeathQuest_OnPointLevel then
		_G.NoDeathQuest_OnPointLevel(player, partUID)
	end

	-- Donner les points
	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, POINT_LEVEL_AMOUNT, "PointLevel")
	tempsJoueurs[userId].future = tempsJoueurs[userId].future + POINT_LEVEL_AMOUNT

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, POINT_LEVEL_AMOUNT, "PointLevel")
	end)

	-- Sauvegarder earnedPointLevels en DataStore (debounced)
	markCheckpointDirty(userId)

	-- ✅ Mise à jour directe du leaderstat (plus de queue)
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		if type(totalPoints) == "number" and totalPoints == totalPoints then
			local finalValue = applyAllBonuses(calculatePoints(totalPoints), player)
			if type(finalValue) == "number" and finalValue == finalValue then
				pointsStat.Value = finalValue
				player:SetAttribute("Points", pointsStat.Value)
			end
		end
	end

	pcall(function() bonusEvent:FireClient(player) end)
end


local function connectPointLevel(part)
	if connectedPointLevels[part] then return end
	connectedPointLevels[part] = true

	if not part:GetAttribute("CheckpointUID") then
		local pos = part.Position
		local uid = string.format("%s_%d_%d_%d", 
			part.Name,
			math.floor(pos.X),
			math.floor(pos.Y),
			math.floor(pos.Z)
		)
		part:SetAttribute("CheckpointUID", uid)
	end

	part.Touched:Connect(function(hit)
		local pl = Players:GetPlayerFromCharacter(hit.Parent)
		if pl then
			awardPointLevel(pl, part)
			addCheckpointToQuest(pl, part)
		end
	end)
end

