	-- ✅ Bloquer si les données ne sont pas encore chargées depuis le DataStore
	if playerTouchedCheckpoints[userId] == nil then
		return
	end

	if not playerCheckpoints[userId] then
		playerCheckpoints[userId] = 0
	end

	local rebirthCount = playerRebirthCount[userId] or 0
	local checkpointUID = getOrCreateCheckpointUID(checkpointPart, rebirthCount)

	-- Anti-spam touch (2 secondes)
	local touchKey = tostring(userId) .. "_touch_" .. tostring(checkpointUID)
	local now = os.time()
	if checkpointTouchCooldown[touchKey] and now - checkpointTouchCooldown[touchKey] < 2 then
		return
	end
	checkpointTouchCooldown[touchKey] = now

	-- Déjà touché dans ce cycle rebirth ?
	if playerTouchedCheckpoints[userId][checkpointUID] then
		return
	end

	-- ✅ N'incrémenter la progression quest QUE si le cooldown 24h est terminé
	local now = os.time()
	local cooldownEnd = checkpointQuestCooldowns[userId] or 0
	if now < cooldownEnd then
		print(string.format("⏸️ CheckpointQuest en cooldown 24h — progression non incrémentée pour %s (%.1fh restantes)",
			player.Name, (cooldownEnd - now) / 3600))
		-- On marque quand même le checkpoint comme touché pour que awardPointLevel bloque le re-farming des points passifs
		playerTouchedCheckpoints[userId][checkpointUID] = true
		return
	end

	-- Ne pas dépasser 90
	if playerCheckpoints[userId] >= CHECKPOINT_QUEST_REQUIRED then
		return
	end

	-- Marquer comme touché et incrémenter
	playerTouchedCheckpoints[userId][checkpointUID] = true
	playerCheckpoints[userId] = playerCheckpoints[userId] + 1

	print(string.format("✅ Checkpoint +1 pour %s → %d/%d (UID: %s)", 
		player.Name, playerCheckpoints[userId], CHECKPOINT_QUEST_REQUIRED, checkpointUID))

	markCheckpointDirty(userId)
	local isComplete = playerCheckpoints[userId] >= CHECKPOINT_QUEST_REQUIRED
	updateCheckpointQuestUI(player, isComplete)
end


