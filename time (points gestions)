game:BindToClose(function()
	print("🛑 FERMETURE DU SERVEUR - SAUVEGARDE D'URGENCE")

	-- ✅ SNAPSHOT IMMÉDIAT
	local snapshot = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local userId = player.UserId

		-- Skip reload en cours
		if recentReloads[userId] then
			print(string.format("⏭️ Skip %s (reload en cours)", player.Name))
			continue
		end

		-- Skip chargement en cours
		if dataLoading[userId] then
			print(string.format("⏭️ Skip %s (chargement en cours)", player.Name))
			continue
		end

		-- ✅ FIX MIGRATION : Skip si pas tout chargé
		-- (évite d'écrire un payload partiel avec des 0/{} qui écraseraient la data)
		if not isAllSecondaryLoaded(userId) then
			print(string.format("⏭️ Skip %s (loaders pas finis)", player.Name))
			continue
		end

		-- ✅ Skip double appareil
		local currentSession = activeConnections[userId]
		if currentSession and currentSession.player ~= player then
			print(string.format("⏭️ Skip %s (double appareil)", player.Name))
			continue
		end

		local data = tempsJoueurs[userId]
		if data and type(data) == "table" and not data.loading then
			local total = data.base + data.future
			-- ✅ Limite alignée avec validatePoints (1T au lieu de 1B)
			if total >= 0 and total <= 1000000000000 then
				snapshot[userId] = {
					name = player.Name,
					points = total,
					checkpoints       = playerCheckpoints[userId] or 0,
					cooldownEnd       = checkpointQuestCooldowns[userId] or 0,
					touchedUIDs       = playerTouchedCheckpoints[userId] or {},
					earnedPointLevels = playerEarnedPointLevels[userId] or {},
					killCount         = playerKillCount[userId] or 0,
					killCooldown = playerKillCooldown[userId] or 0,
					killQuestCooldown = killQuestCooldowns[userId] or 0,
					killQuestProgress = killQuestProgress[userId] or 0,
					rebirthCount = playerRebirthCount[userId] or 0,
					redeemedCodes = playerRedeemedCodes[userId] or {},
					playtimeSeconds = getCurrentPlaytime(userId),
					settings = Settings.data[userId] or Settings.default(),
				}
				-- ✅ FIX : Enrichir avec P2 (totalSpent etc.) avant les boosts
				if type(_G.enrichQuestSnapshotWithP2) == "function" then
					snapshot[userId] = _G.enrichQuestSnapshotWithP2(userId, snapshot[userId])
				end
				-- ✨ Inclure les boosts temporaires dans le snapshot
				if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
					snapshot[userId] = _G.enrichQuestSnapshotWithBoosts(userId, snapshot[userId])
				end

				flushTotalKills(userId)

				-- ✅ Vider immédiatement pour que PlayerRemoving skip
				tempsJoueurs[userId] = nil
			end
		end
	end

	local snapshotCount = 0
	for _ in pairs(snapshot) do snapshotCount = snapshotCount + 1 end
	print(string.format("📸 Snapshot: %d joueurs capturés", snapshotCount))

	if snapshotCount == 0 then
		print("✅ BindToClose : rien à sauvegarder")
		return
	end

	-- ✅ NEW: PHASE SESSIONLOCK (filet de sécurité)
	-- Poser les locks en PARALLÈLE avant les SetAsync principaux.
	-- Si tempsStore:SetAsync timeout/échoue plus tard, les joueurs qui
	-- reconnectent < 30s liront ce lock en priorité dans secureLoad.
	print("🔒 Pose des SessionLocks (filet de sécurité)...")
	local locksPending = 0
	for userId, data in pairs(snapshot) do
		locksPending = locksPending + 1
		task.spawn(function()
			pcall(function()
				SESSION_LOCK_STORE:SetAsync("lock_" .. userId, {
					points = data.points,
					timestamp = os.time(),
					expiresAt = os.time() + SESSION_LOCK_DURATION,
					redeemedCodes = data.redeemedCodes or {},  -- ✅ FIX ANTI-RE-REDEEM (top-level)
					playtimeSeconds = data.playtimeSeconds or 0,  -- ⏱️ critique : éviter perte au BindToClose
					settings = data.settings or {},  -- ⚙️ paramètres joueur
					questSnapshot = {
						checkpoints        = data.checkpoints,
						cooldownEnd        = data.cooldownEnd,
						touchedUIDs        = data.touchedUIDs,
						earnedPointLevels  = data.earnedPointLevels or {},  -- ✅ FIX : était manquant
						killCount          = data.killCount,
						killCooldown       = data.killCooldown,
						killQuestCooldowns = data.killQuestCooldown,
						killQuestProgress  = data.killQuestProgress,
						redeemedCodes      = data.redeemedCodes or {},  -- ✅ FIX ANTI-RE-REDEEM (snapshot)
						settings           = data.settings or {},       -- ⚙️ paramètres joueur
						tempBoosts         = data.tempBoosts or {},     -- ✨ Boosts temporaires
						playtimeSeconds    = data.playtimeSeconds or 0, -- ⏱️ double-sécurité
						-- ✅ FIX FIABILITÉ : rebirths, allowedRebirth, cooldowns quêtes au shutdown
						rebirthCount = data.rebirthCount or 0,
						allowedRebirth = (allowedRebirth[userId] == true),
						questHistory = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},
					}
				})
			end)
			locksPending = locksPending - 1
		end)
	end

	-- Attendre max 3s que les SessionLocks soient posés (en parallèle, très rapide)
	local lockWait = 0
	while locksPending > 0 and lockWait < 30 do
		task.wait(0.1)
		lockWait = lockWait + 1
	end
	print(string.format("✅ SessionLocks posés (restants non confirmés: %d)", locksPending))

	-- Laisser PlayerRemoving détecter les nil et s'arrêter
	task.wait(1.5)

	-- ✅ NOUVEAU : 1 SEUL SetAsync par joueur — EN PARALLÈLE (le séquentiel avec
	-- task.wait(0.3) dépassait les 30s de BindToClose à 20+ joueurs)
	local savesPending = 0
	for userId, data in pairs(snapshot) do
		print(string.format("💾 %s → %d pts (unifié)", data.name, data.points))

		-- Construire le payload unifié avec TOUTES les données
		local payload = {
			version       = 1,
			migrated      = true,  -- ✅ FLAG : marque le joueur comme post-migration
			points        = data.points,
			rebirthCount  = data.rebirthCount or 0,
			rebirthRight  = (allowedRebirth and allowedRebirth[userId]) == true,
			lastSavedAt   = os.time(),

			-- Checkpoint quest
			checkpoints           = data.checkpoints or 0,
			checkpointCooldownEnd = data.cooldownEnd or 0,
			touchedCheckpoints    = data.touchedUIDs or {},
			earnedPointLevels     = data.earnedPointLevels or {},

			-- Kills
			killCount         = data.killCount or 0,
			killCooldown      = data.killCooldown or 0,
			killQuestProgress = data.killQuestProgress or 0,
			killQuestCooldown = data.killQuestCooldown or 0,

			-- Quest cooldowns
			questCooldowns = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},

			-- Codes redeem
			redeemedCodes = data.redeemedCodes or {},

			-- ⚙️ Paramètres joueur
			settings = data.settings or {},

			-- Playtime lifetime
			playtimeSeconds = data.playtimeSeconds or 0,

			-- Anti-cheat (warnings)
			warningInfractions = (AntiExploit.infractions and AntiExploit.infractions[userId]) or 0,
			smartAntiCheatInfractions = (
				SmartAntiCheat.playerData
					and SmartAntiCheat.playerData[userId]
					and SmartAntiCheat.playerData[userId].infractions
			) and {
				suspiciousCount    = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
				dangerousCount     = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
				totalInfractions   = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
				burstCount         = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
				lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
			} or nil,
		}

		-- ✅ SetAsync en PARALLÈLE
		savesPending = savesPending + 1
		task.spawn(function()
			local ok = pcall(function()
				-- ⏱️ même garde-fou : le playtime ne recule jamais
				PLAYER_DATA_STORE:UpdateAsync("p_" .. userId, function(old)
					local oldPt = (type(old) == "table" and tonumber(old.playtimeSeconds)) or 0
					if oldPt > (tonumber(payload.playtimeSeconds) or 0) then
						payload.playtimeSeconds = oldPt
					end
					return payload
				end)
			end)

			if ok then
				_G.PlayerDataStats.saveSuccess = _G.PlayerDataStats.saveSuccess + 1
			else
				_G.PlayerDataStats.saveFail = _G.PlayerDataStats.saveFail + 1
				warn(string.format("❌ BindToClose: save échoué pour %s", data.name))
			end
			savesPending = savesPending - 1
		end)
	end

	-- Attendre max 15s que tous les saves parallèles se terminent
	local waitedSaves = 0
	while savesPending > 0 and waitedSaves < 150 do
		task.wait(0.1)
		waitedSaves = waitedSaves + 1
	end

	print(string.format("✅ BindToClose terminé (%d save(s) non confirmé(s))", savesPending))
end)

