Players.PlayerAdded:Connect(function(player)
	print("🎮 JOUEUR REJOINT:", player.Name, "UserID:", player.UserId)

	local userId = player.UserId
	local now = os.time()

	-- ✅ FIX 12 : Étendre la fenêtre à 120s (aligné avec recentReloads cleanup et isPlannedReloadEarly)
	-- Couvre les téléports lents (jusqu'à 2 min) sans classer un reload légitime comme join normal
	-- (sinon : reload >30s → isPlannedReload=false → secureLoad lit unified, ce qui marche
	--  grâce à FIX 11, mais FIX 12 garde le path reload propre = utilise le SessionLock directement)
	local isPlannedReload = false
	if recentReloads[userId] and (now - recentReloads[userId]) < 120 then
		isPlannedReload = true
		-- Ne pas nettoyer recentReloads ici, PlayerRemoving peut en avoir besoin
		print(string.format("✅ RELOAD PROPRE détecté pour %s (%ds, fenêtre 120s)", 
			player.Name, now - recentReloads[userId]))
	end

	-- ✅ Si c'est un reload prévu, NE PAS bloquer la sauvegarde
	if not isPlannedReload then
		disconnectProtection[userId] = {
			blockUntil = now + 10,
			newSessionId = HttpService:GenerateGUID(false)
		}
		print(string.format("🛡️ Protection multi-appareil ACTIVÉE pour %s", player.Name))
	else
		print(string.format("⚠️ Protection multi-appareil DÉSACTIVÉE pour %s (reload prévu)", player.Name))
	end

	activeConnections[userId] = {
		player = player,
		sessionId = HttpService:GenerateGUID(false),
		joinTime = now,
		isPlannedReload = isPlannedReload
	}

	-- ✅ NOUVEAU : Lire le SessionLock pour détecter une reconnexion rapide
	-- Si un lock récent existe (< 15s), c'est une reconnexion multi-appareil
	task.spawn(function()
		if not isPlannedReload then
			local lockData = readSessionLock(userId)
			if lockData and (os.time() - (lockData.timestamp or 0)) < 15 then
				-- Lock très récent = l'autre appareil vient juste de quitter
				-- On va utiliser ses points directement
				print(string.format("🔄 SessionLock récent détecté pour %s (%ds) → utilisation des points du lock", 
					player.Name, os.time() - lockData.timestamp))
				-- Le secureLoad normal prendra la valeur du DataStore qui est correcte
				-- Le lock sera lu dans la section de chargement des points
			end
		end
	end)

	if not AntiExploit.CheckBanOnJoin(player) then
		disconnectProtection[userId] = nil
		activeConnections[userId] = nil
		return
	end

	AntiExploit.InitPlayer(player.UserId)
	SmartAntiCheat.InitPlayer(player.UserId)

	task.spawn(function()
		-- ✅ ÉTAPE 1: ATTENDRE que le leaderstats existe
		local maxWait = 50
		local waited = 0
		while not player:FindFirstChild("leaderstats") and waited < maxWait do
			task.wait(0.1)
			waited = waited + 1
		end

		if not player or not player.Parent then return end

		local leaderstats = player:FindFirstChild("leaderstats")
		if not leaderstats then
			warn("❌ Leaderstats introuvable pour", player.Name)
			return
		end

		-- ✅ ÉTAPE 2: ATTENDRE que Stage soit créé par le script checkpoint
		-- Le script checkpoint attend 5 secondes max, donc on attend 6 secondes max
		waited = 0
		maxWait = 60 -- 6 secondes
		while not leaderstats:FindFirstChild("Stage") and waited < maxWait do
			task.wait(0.1)
			waited = waited + 1
		end

		-- Vérifier que le joueur est toujours là
		if not player or not player.Parent then return end

		-- ✅ NOUVEAU : Attendre que secureLoad ait fini (il peut déjà avoir setté playerRebirthCount)
		local waited = 0
		while dataLoading[userId] and waited < 100 do
			task.wait(0.1)
			waited = waited + 1
		end

		local rebirthCount = 0

		-- Si secureLoad a déjà chargé le rebirth count depuis le store unifié, on prend ça
		if type(playerRebirthCount[userId]) == "number" then
			rebirthCount = playerRebirthCount[userId]
			print(string.format("✅ Rebirth depuis unifié/legacy: %s → %d", player.Name, rebirthCount))
		else
			-- Fallback : lire l'ancien store (cas où secureLoad n'a rien trouvé)
			local success, count = pcall(function()
				return rebirthCountStore:GetAsync("rebirth_" .. userId)
			end)

			if success and count then
				rebirthCount = count
				playerRebirthCount[userId] = count
				print(string.format("🔄 Rebirth count legacy: %s → %d", player.Name, count))
			else
				playerRebirthCount[userId] = 0
				print(string.format("ℹ️ Nouveau joueur rebirth: %s → 0", player.Name))
			end
		end

		-- ✅ ÉTAPE 4: CRÉER Rebirths APRÈS Stage
		local rebirthStat = Instance.new("IntValue")
		rebirthStat.Name = "Rebirths"
		rebirthStat.Value = rebirthCount
		rebirthStat.Parent = leaderstats

		player:SetAttribute("RebirthCount", rebirthCount)

		print(string.format("✅ Rebirth leaderboard créé (position 3): %s → %d rebirths", player.Name, rebirthCount))
	end)


	local isPlannedReloadEarly = recentReloads[userId] ~= nil
		and (os.time() - recentReloads[userId]) < 120

	if not isPlannedReloadEarly then
		loadWarnings(player.UserId)
	end

	-- Toujours charger les cooldowns quêtes, même pour un reload
	task.spawn(function()
		loadAllQuestCooldowns(userId)
	end)
	task.wait(0.5)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local pointsStat = Instance.new("IntValue")
	pointsStat.Name = "Points"
	pointsStat.Value = 0
	pointsStat.Parent = leaderstats

	tempsJoueurs[player.UserId] = {base = 0, future = 0, lastSaved = 0}

	-- ✅ PATCH : Bloquer compteur passif + autosave + secureSave pendant le chargement
	dataLoading[userId] = true
	print(string.format("🔒 Chargement en cours pour %s, compteur passif bloqué", player.Name))

	task.spawn(function()
		-- ✅ Étalement plus agressif : 1.2s/joueur, max 12s
		-- Évite que 5+ joueurs déclenchent leurs GetAsync en même temps
		local joinDelay = math.min((#Players:GetPlayers() - 1) * 1.2, 12)
		if joinDelay > 0 then
			task.wait(joinDelay)
		end
		task.wait(0.5)

		print("🔍 CHARGEMENT DONNÉES pour", player.Name, "UserID:", player.UserId)

		local totalSeconds = 0

		if isPlannedReload then
			print(string.format("🔒 Reload prévu — lecture SessionLock pour %s", player.Name))
			local lockData = readSessionLock(userId)

			if lockData then
				totalSeconds = lockData.points
				print(string.format("✅ SessionLock lu: %d pts pour %s", totalSeconds, player.Name))

				local snap = lockData.questSnapshot
				if snap then
					do
						local waited = 0
						while type(_G.tryRestoreP2FromSnapshot) ~= "function" and waited < 30 do
							task.wait(0.1)
							waited = waited + 1
						end
						if type(_G.tryRestoreP2FromSnapshot) == "function" then
							_G.tryRestoreP2FromSnapshot(player, snap)
						else
							warn(string.format("⚠️ tryRestoreP2FromSnapshot jamais disponible pour %s, totalSpent non restauré", player.Name))
						end
					end
					-- ✨ Boosts temporaires
					if type(_G.tryRestoreBoostsFromSnapshot) == "function" then
						_G.tryRestoreBoostsFromSnapshot(player, snap)
					end
					playerCheckpoints[userId]        = snap.checkpoints or 0
					checkpointQuestCooldowns[userId] = snap.cooldownEnd or 0
					playerTouchedCheckpoints[userId] = snap.touchedUIDs or {}
					playerEarnedPointLevels[userId]  = snap.earnedPointLevels or {}
					playerKillCount[userId]          = snap.killCount or 0
					playerKillCooldown[userId]       = snap.killCooldown or 0
					killQuestCooldowns[userId]       = snap.killQuestCooldowns or 0
					killQuestProgress[userId]        = snap.killQuestProgress or 0

					-- ✅ FIX : Reset cooldowns expirés (même logique que secureLoad)
					-- Cas réel : reload qui prend 90s + cooldown 9h qui expire pendant les 90s
					local nowReload = os.time()
					if playerKillCooldown[userId] > 0 and nowReload >= playerKillCooldown[userId] then
						playerKillCount[userId]    = 0
						playerKillCooldown[userId] = 0
						print(string.format("✅ Cooldown 100-kills expiré pendant reload pour %d", userId))
					end
					if (checkpointQuestCooldowns[userId] or 0) > 0 and nowReload >= checkpointQuestCooldowns[userId] then
						playerCheckpoints[userId]        = 0
						checkpointQuestCooldowns[userId] = 0
						playerTouchedCheckpoints[userId] = {}
						-- NE PAS reset playerEarnedPointLevels (reset uniquement au rebirth)
						print(string.format("✅ CheckpointQuest cooldown 24h expiré pendant reload pour %d", userId))
					end

					-- ✅ FIX ANTI-RE-REDEEM : restaurer redeemedCodes depuis le snapshot
					if type(snap.redeemedCodes) == "table" then
						playerRedeemedCodes[userId] = snap.redeemedCodes
						print(string.format("✅ redeemedCodes restaurés depuis snapshot pour %s", player.Name))
					end

					-- ⚙️ Restaurer paramètres depuis snapshot
					if type(snap.settings) == "table" then
						Settings.data[userId] = snap.settings
					end

					-- ⏱️ Restaurer playtime depuis snapshot reload
					-- ⏱️ jamais « or 0 » : un snapshot sans playtime le remettait à zéro
					playerPlaytime[userId] = tonumber(snap.playtimeSeconds)
						or tonumber(lockData.playtimeSeconds) or playerPlaytime[userId]


					-- ✅ FIX FIABILITÉ : restaurer aussi rebirths, allowedRebirth, et cooldowns quêtes
					if type(snap.rebirthCount) == "number" then
						playerRebirthCount[userId] = snap.rebirthCount
						print(string.format("✅ rebirthCount restauré depuis snapshot : %d pour %s", snap.rebirthCount, player.Name))
					end
					if snap.allowedRebirth ~= nil then
						allowedRebirth[userId] = snap.allowedRebirth == true
					end
					if type(snap.questHistory) == "table" then
						mergeQuestHistory(userId, snap.questHistory)
						questCooldownsLoaded[userId] = questCooldownsLoaded[userId] or true
						print(string.format("✅ questHistory mergé depuis snapshot pour %s", player.Name))
					end

					-- ✅ RESTAURATION DES WARNINGS
					if snap.antiExploitInfractions and snap.antiExploitInfractions > 0 then
						AntiExploit.infractions[userId] = snap.antiExploitInfractions
						print(string.format("✅ Infractions AntiExploit restaurées: %d", snap.antiExploitInfractions))
					end

					if snap.smartAntiCheatInfractions then
						local smartData = SmartAntiCheat.playerData[userId]
						if not smartData then
							SmartAntiCheat.InitPlayer(userId)
							smartData = SmartAntiCheat.playerData[userId]
						end
						if smartData then
							smartData.infractions = {
								suspiciousCount   = snap.smartAntiCheatInfractions.suspiciousCount or 0,
								dangerousCount    = snap.smartAntiCheatInfractions.dangerousCount or 0,
								totalInfractions  = snap.smartAntiCheatInfractions.totalInfractions or 0,
								burstCount        = snap.smartAntiCheatInfractions.burstCount or 0,
								lastInfractionTime = snap.smartAntiCheatInfractions.lastInfractionTime or 0,
							}
							print(string.format("✅ Infractions SmartAntiCheat restaurées: %d total",
								snap.smartAntiCheatInfractions.totalInfractions or 0))
						end
					end

					print(string.format("✅ Quêtes restaurées depuis SessionLock: %d checkpoints | %d/%d kills",
						snap.checkpoints or 0, snap.killCount or 0, MAX_KILLS))
				end

				releaseSessionLock(userId)
			else
				warn(string.format("⚠️ Pas de SessionLock pour %s, fallback DataStore (attente 1s)", player.Name))
				task.wait(1)
				totalSeconds = secureLoad(userId)
			end
		else
			totalSeconds = secureLoad(userId)
		end

		-- ✅ NEW: si secureLoad a retourné nil, c'est une panne DataStore totale
		-- → kick préventif au lieu d'écraser les points avec 0
		if totalSeconds == nil then
			warn(string.format("🚨 Chargement impossible pour %s → kick préventif (évite perte de points)", player.Name))
			dataLoading[userId] = nil
			tempsJoueurs[userId] = nil  -- éviter que PlayerRemoving sauvegarde {base=0}
			activeConnections[userId] = nil
			if player and player.Parent then
				player:Kick("⚠️ Server data temporarily unavailable. Please reconnect in 30 seconds. Your progress is safe.")
			end
			return
		end

		print("✅ DONNÉES CHARGÉES:", totalSeconds, "secondes pour", player.Name)
		if player.Parent then
			-- ✅ PATCH : future=0 garanti car le compteur était bloqué
			tempsJoueurs[player.UserId] = {base = totalSeconds, future = 0, lastSaved = totalSeconds}
			LossGuard.setLastSaved(player.UserId, totalSeconds)  -- ✅ Init référence anti-perte
			local finalPoints = applyAllBonuses(calculatePoints(totalSeconds), player)
			_G.suppressPointsAnim(player, finalPoints)  -- 🆕 pas d'animation au chargement des points
			pointsStat.Value = finalPoints
			player:SetAttribute("Points", pointsStat.Value)

			-- ✅ FIX MULTI-APPAREIL : Stocker les points chargés comme attribut de protection
			player:SetAttribute("LoadedBasePoints", totalSeconds)
			player:SetAttribute("LoadedAt", os.time())

			print("💾 POINTS APPLIQUÉS:", finalPoints, "pour", player.Name)

			local data = SmartAntiCheat.playerData[player.UserId]
			if data then
				data.lastKnownPoints = finalPoints
				data.lastCheckTime = os.time()
				data.dataLoaded = true
				data.initialPoints = finalPoints
				print(string.format("🧠 Anti-Cheat initialisé: %s | Points de départ: %d", player.Name, finalPoints))
			end

			-- ✅ PATCH : Débloquer seulement après assignation complète de base
			dataLoading[userId] = nil
			print(string.format("🔓 Chargement terminé pour %s, compteur passif activé", player.Name))

			-- ⚙️ Réappliquer les paramètres (défaut si jamais nil = nouveau/legacy)
			if Settings.data[userId] == nil then
				Settings.data[userId] = Settings.default()
			end
			Settings.apply(player)
			player:SetAttribute("SettingsLoaded", true)  -- ⚙️ le client peut envoyer ses réglages

			-- ⏱️ Démarrer le compteur de playtime APRÈS chargement complet
			playerSessionStart[userId] = os.time()
			player:SetAttribute("PlaytimeSeconds", playerPlaytime[userId] or 0)
			print(string.format("⏱️ Playtime initialisé pour %s : %d sec lifetime", 
				player.Name, playerPlaytime[userId] or 0))

			if type(_G.setP2Baseline) == "function" then
				_G.setP2Baseline(player, totalSeconds)
			end

			task.wait(0.5)
			pcall(function()
				dataLoadedEvent:FireClient(player)
			end)
		else
			-- Joueur parti avant fin du chargement, nettoyer le flag
			dataLoading[userId] = nil
		end
	end)

	task.spawn(function()
		task.wait(1)
		-- 🛡️ FIX FARM : attendre que secureLoad ait fini AVANT loadKillData.
		-- Sinon (multi-joueurs → joinDelay élevé) loadKillData charge les kills depuis les
		-- stores dédiés, PUIS secureLoad écrase avec l'unifié. Si l'unifié est en retard, le
		-- cooldown 24h de la KillQuest (ou des 100 kills) est downgradé → re-claim = farm.
		-- En attendant dataLoading=nil, playerKillCount est déjà set par secureLoad → loadKillData
		-- prend la branche "skip" (merge-max avec le store kq_) au lieu de tout recharger/écraser.
		local waitedForLoad = 0
		while dataLoading[userId] and waitedForLoad < 100 do
			task.wait(0.1)
			waitedForLoad = waitedForLoad + 1
		end
		loadKillData(player.UserId)
		task.wait(0.5)  -- ✅ AJOUT : laisser le temps au DataStore de répondre
		-- ✅ FIX CRITIQUE : Envoyer l'état initial au client SINON le bouton reste "In Progress"
		if player.Parent then
			updateKillUI(player)
		end

		-- ✅ Si c'est un reload, playerCheckpoints a déjà été assigné par le SessionLock
		-- dans le task.spawn de chargement des points → ne pas écraser
		loadCheckpointQuestData(player.UserId)
		rebuildCheckpointFolder(player)

		if player.Parent then
			local dataFolder = player:FindFirstChild("CheckpointData")
			if not dataFolder then
				dataFolder = Instance.new("Folder")

				dataFolder.Name = "CheckpointData"
				dataFolder.Parent = player
			end

			local userId = player.UserId
			local checkpoints = playerCheckpoints[userId] or 0
			local canClaim = canClaimCheckpointQuest(userId)
			local cooldownEnd = checkpointQuestCooldowns[userId] or 0

			lastUIUpdate[userId] = nil

			print(string.format("📤 ENVOI UI checkpoint au join: %d checkpoints | canClaim=%s", 
				checkpoints, tostring(canClaim)))

			pcall(function()
				checkpointQuestUpdateEvent:FireClient(player, checkpoints, canClaim, cooldownEnd)
			end)

			task.wait(3)
			if player.Parent then
				local checkpoints2 = playerCheckpoints[userId] or 0
				local canClaim2 = canClaimCheckpointQuest(userId)
				local cooldownEnd2 = checkpointQuestCooldowns[userId] or 0
				lastUIUpdate[userId] = nil
				print(string.format("📤 ENVOI UI checkpoint (2e tentative): %d checkpoints", checkpoints2))
				pcall(function()
					checkpointQuestUpdateEvent:FireClient(player, checkpoints2, canClaim2, cooldownEnd2)
				end)
			end

			task.wait(0.1)
			pcall(function()
				questsLoadedEvent:FireClient(player)
			end)
		end
	end)

	task.spawn(function()
		local maxWait = 50
		local waited = 0
		while playerRebirthCount[userId] == nil and waited < maxWait do
			task.wait(0.1)
			waited = waited + 1
		end

		waited = 0
		while playerCheckpoints[userId] == nil and waited < 50 do
			task.wait(0.1)
			waited = waited + 1
		end

		print(string.format("📊 Quest checkpoints chargés pour %s: %d", 
			player.Name, playerCheckpoints[userId] or 0))

		if not player.Parent then return end

		local character = player.Character or player.CharacterAdded:Wait()
		if not character then return end

		task.wait(2)
		if not player.Parent then return end

		local currentCheckpoint = detectPlayerCheckpoint(player)

		if currentCheckpoint then
			playerCurrentCheckpoint[player.UserId] = currentCheckpoint.yPos
			print(string.format("📍 Position détectée pour %s: Y=%.1f | Quest: %d checkpoints", 
				player.Name, currentCheckpoint.yPos, playerCheckpoints[userId] or 0))
		else
			print(string.format("ℹ️ Aucun checkpoint détecté pour %s", player.Name))
		end

		-- ✅ ICI - après markLowerCheckpointsAsCollected
		lastUIUpdate[player.UserId] = nil
		local checkpoints = playerCheckpoints[player.UserId] or 0
		local canClaim = canClaimCheckpointQuest(player.UserId)
		local cooldownEnd = checkpointQuestCooldowns[player.UserId] or 0
		print(string.format("📤 ENVOI UI après détection checkpoint: %d checkpoints", checkpoints))
		pcall(function()
			checkpointQuestUpdateEvent:FireClient(player, checkpoints, canClaim, cooldownEnd)
		end)
	end)

	task.spawn(function()
		task.wait(2)

		if player.Parent then
			local friendCount = countFriendsInGame(player)
			friendCountCache[player.UserId] = friendCount

			player:SetAttribute("FriendCount", friendCount)

			updateFriendUI(player)

			task.wait(0.2)
			pcall(function()
				friendsLoadedEvent:FireClient(player)
			end)

			task.wait(3)
			if player.Parent then
				refreshAllFriendsBatched()
			end
		end
	end)

	task.spawn(function()
		task.wait(4)

		if not player.Parent then return end

		-- Skip si déjà chargé par secureLoad (voie unified)
		if allowedRebirth[player.UserId] ~= nil then return end

		-- ✅ FIX MIGRATION : Retry 3x avant d'abandonner
		local success, hasRight
		for attempt = 1, 3 do
			success, hasRight = pcall(function()
				return rebirthRightStore:GetAsync(player.UserId)
			end)
			if success then break end
			warn(string.format("⚠️ rebirthRightStore tentative %d/3 échouée pour %d", attempt, player.UserId))
			task.wait(0.6 * attempt)
		end

		if success then
			allowedRebirth[player.UserId] = (hasRight == true)
		else
			-- ❌ DataStore down après 3 retries : NE PAS setter à false (sinon perte du droit en unified)
			warn(string.format("🚨 CRITIQUE: rebirthRightStore inaccessible pour %d — valeur laissée nil (saves bloqués jusqu'à recovery)", player.UserId))
			-- ✅ FIX : Retry persistant (10 tentatives sur 5 minutes au lieu de 1 seule)
			-- Sinon saves bloqués TOUTE la session = perte de progression à la déconnexion
			task.spawn(function()
				local attempts = 0
				while attempts < 10 do
					task.wait(30)
					attempts = attempts + 1

					-- Joueur parti : abandonner
					if not Players:GetPlayerByUserId(player.UserId) then return end
					-- Déjà chargé par un autre path (secureLoad unified par ex) : abandonner
					if allowedRebirth[player.UserId] ~= nil then return end

					local ok, val = pcall(function() return rebirthRightStore:GetAsync(player.UserId) end)
					if ok then
						allowedRebirth[player.UserId] = (val == true)
						print(string.format("✅ allowedRebirth recovery réussi pour %d après %d tentatives : %s",
							player.UserId, attempts, tostring(val == true)))
						return
					end
				end
				warn(string.format("🚨 allowedRebirth abandonné pour %d après 10 retries (5 min)", player.UserId))
			end)
		end
	end)

	task.spawn(function()
		task.wait(6)

		if player.Parent then
			getHighestGamePassMultiplier(player)
		end
	end)

	if player.Character then 
		task.spawn(function() 
			monitorCharacter(player.Character)
			if AntiExploit.playerTracking[player.UserId] then
				AntiExploit.playerTracking[player.UserId].spawnTime = os.time()
			end
		end)
	end

	player.CharacterAdded:Connect(function(char)
		task.spawn(function() 
			monitorCharacter(char) 
		end)

		task.spawn(function()
			if AntiExploit.playerTracking[player.UserId] then
				AntiExploit.playerTracking[player.UserId].spawnTime = os.time()
				print("🛡️ Période de grâce réinitialisée pour", player.Name)
			end
		end)

		task.spawn(function()
			task.wait(2)
			if player.Parent then
				updateFriendUI(player)
			end
		end)

		task.spawn(function()
			task.wait(3)

			if not player.Parent then return end

			local isRebirth = player:GetAttribute("JustRebirthed")

			if isRebirth then
				player:SetAttribute("JustRebirthed", nil)
				print(string.format("🔄 Rebirth détecté pour %s, skip marquage", player.Name))
				return
			end

			local currentCheckpoint = detectPlayerCheckpoint(player)

			if currentCheckpoint then
				local previousY = playerCurrentCheckpoint[player.UserId] or 0

				if currentCheckpoint.yPos > previousY then
					print(string.format("📍 Nouveau checkpoint détecté pour %s: Y=%.1f (ancien: %.1f)", 
						player.Name, currentCheckpoint.yPos, previousY))
					playerCurrentCheckpoint[player.UserId] = currentCheckpoint.yPos
				end
			end
		end)
	end)
end)

