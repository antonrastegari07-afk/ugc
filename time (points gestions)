local function loadCheckpointQuestData(userId)
	-- ✅ Si reload prévu, attendre que le snapshot soit restauré depuis le SessionLock
	if recentReloads[userId] then
		local waited = 0
		while playerCheckpoints[userId] == nil and waited < 100 do
			task.wait(0.1)
			waited = waited + 1
		end
	end

	if playerCheckpoints[userId] ~= nil then
		-- 🛡️ FIX FARM : cas suspect = l'unifié dit "réclamable" (checkpoints>=requis ET cooldown=0).
		-- Ça peut être un unifié périmé (save du claim échoué). On croise avec le store dédié
		-- (écrit immédiatement à chaque claim) qui aurait le cooldown 24h → bloque le re-farm.
		-- Lecture UNIQUEMENT dans cet état précis → aucun read supplémentaire au join normal.
		if not recentReloads[userId]
			and (checkpointQuestCooldowns[userId] or 0) == 0
			and (playerCheckpoints[userId] or 0) >= CHECKPOINT_QUEST_REQUIRED then
			local okX, dataX = pcall(function()
				return checkpointQuestStore:GetAsync("CheckpointQuest_" .. userId)
			end)
			if okX and type(dataX) == "table" and (tonumber(dataX.cooldownEnd) or 0) > os.time() then
				checkpointQuestCooldowns[userId] = tonumber(dataX.cooldownEnd) or 0
				playerCheckpoints[userId]        = tonumber(dataX.checkpoints) or 0
				playerTouchedCheckpoints[userId] = (type(dataX.touchedUIDs) == "table") and dataX.touchedUIDs or {}
				warn(string.format("🛡️ CheckpointQuest: unifié périmé détecté pour %d, cooldown restauré depuis le store dédié (anti-farm)", userId))
			end
		end
		print(string.format("ℹ️ Checkpoint quest déjà restaurée pour %d (%d checkpoints), skip",
			userId, playerCheckpoints[userId]))
		return
	end

	-- ✅ FIX SUPPLÉMENTAIRE : Si recentReloads est actif mais playerCheckpoints est encore nil
	-- après l'attente, lire directement le SessionLock AVANT le DataStore
	if recentReloads[userId] then
		warn(string.format("⚠️ loadCheckpointQuestData: SessionLock pas encore lu pour %d, lecture directe", userId))
		local lockData = readSessionLock(userId)
		if lockData and lockData.questSnapshot then
			local snap = lockData.questSnapshot
			playerCheckpoints[userId]        = snap.checkpoints or 0
			checkpointQuestCooldowns[userId] = snap.cooldownEnd or 0
			playerTouchedCheckpoints[userId] = snap.touchedUIDs or {}
			playerEarnedPointLevels[userId]  = snap.earnedPointLevels or {}  -- ✅ FIX ANTI-WIPE
			print(string.format("✅ Checkpoints restaurés depuis SessionLock direct: %d checkpoints", 
				snap.checkpoints or 0))
			return
		end
	end

	local key = "CheckpointQuest_" .. userId
	local success, data = pcall(function()
		return checkpointQuestStore:GetAsync(key)
	end)

	print(string.format("🔍 LOAD CheckpointQuest: success=%s, data=%s",
		tostring(success),
		data and ("checkpoints=" .. tostring(data.checkpoints) ..
			" cooldown=" .. tostring(data.cooldownEnd)) or "NIL"
		))

	-- ✅ FIX MIGRATION : Retry 3x au lieu de 1
	if not success then
		for attempt = 2, 3 do
			task.wait(0.6 * attempt)
			success, data = pcall(function()
				return checkpointQuestStore:GetAsync(key)
			end)
			if success then break end
			warn(string.format("⚠️ loadCheckpointQuestData tentative %d/3 échouée pour %d", attempt, userId))
		end
	end

	if success and data then
		playerCheckpoints[userId]        = data.checkpoints or 0
		checkpointQuestCooldowns[userId] = data.cooldownEnd or 0
		playerTouchedCheckpoints[userId] = data.touchedUIDs or {}
		playerEarnedPointLevels[userId]  = data.earnedPointLevels or {}
	elseif success and data == nil then
		-- Vrai nouveau joueur, init propre
		playerCheckpoints[userId]        = 0
		checkpointQuestCooldowns[userId] = 0
		playerTouchedCheckpoints[userId] = {}
		playerEarnedPointLevels[userId]  = {}
	else
		-- ❌ DataStore down : NE PAS setter à 0 (sinon écrase en unified)
		-- Laisser nil → isAllSecondaryLoaded bloquera secureSave
		warn(string.format("🚨 CRITIQUE: loadCheckpointQuestData failed après 3 retries pour %d — valeurs laissées nil (saves bloqués)", userId))
		return
	end

	-- FIX : condition corrigée (playerCheckpoints vaut déjà 0 après claim, l'ancienne condition ne déclenchait jamais)
	local now = os.time()
	local cdEnd = checkpointQuestCooldowns[userId] or 0
	if cdEnd > 0 and now >= cdEnd then
		print(string.format("🔄 CheckpointQuest: cooldown expiré hors session, reset quête pour UserID %d", userId))
		playerCheckpoints[userId]        = 0
		checkpointQuestCooldowns[userId] = 0
		playerTouchedCheckpoints[userId] = {}
		-- NE PAS effacer playerEarnedPointLevels : pas de rebirth = pas de reset PointLevel
		saveCheckpointQuestData(userId, true)
	end
end



