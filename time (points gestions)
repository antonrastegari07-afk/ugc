local playerCurrentCheckpoint = {} 

local function getOrCreateCheckpointUID(part, rebirthCount)
	rebirthCount = rebirthCount or 0

	local uid = part:GetAttribute("CheckpointUID")
	if not uid then
		local pos = part.Position
		uid = string.format("%s_%d_%d_%d", 
			part.Name,
			math.floor(pos.X),
			math.floor(pos.Y),
			math.floor(pos.Z)
		)
		part:SetAttribute("CheckpointUID", uid)
	end

	return string.format("%s_R%d", uid, rebirthCount)
end
-- Track le checkpoint le plus haut atteint
local checkpointPositions = {} -- Cache des positions de tous les checkpoints

-- Fonction pour obtenir tous les checkpoints triés par position Y
local function getAllCheckpointsSorted()
	if #checkpointPositions > 0 then
		return checkpointPositions
	end

	local checkpoints = {}
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and part.Name == "PointLevel" then
			table.insert(checkpoints, {
				part = part,
				position = part.Position,
				yPos = part.Position.Y
			})
		end
	end

	-- Trier par hauteur (Y)
	table.sort(checkpoints, function(a, b)
		return a.yPos < b.yPos
	end)

	checkpointPositions = checkpoints
	print(string.format("📍 %d checkpoints détectés et triés", #checkpoints))

	return checkpoints
end

-- Fonction pour détecter le checkpoint actuel du joueur
local function detectPlayerCheckpoint(player)
	local character = player.Character
	if not character then return nil end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return nil end

	local playerPos = humanoidRootPart.Position
	local allCheckpoints = getAllCheckpointsSorted()

	-- Trouver le checkpoint le plus proche en dessous du joueur
	local closestCheckpoint = nil
	local closestDistance = math.huge

	for _, cpData in ipairs(allCheckpoints) do
		-- Ne considérer que les checkpoints en dessous ou au même niveau
		if cpData.yPos <= playerPos.Y + 10 then
			local distance = (cpData.position - playerPos).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closestCheckpoint = cpData
			end
		end
	end

	return closestCheckpoint
end

-- Fonction pour marquer tous les checkpoints inférieurs comme récoltés
local function markLowerCheckpointsAsCollected(player, currentCheckpoint)
	if not currentCheckpoint then return 0 end
	if not currentCheckpoint.yPos or type(currentCheckpoint.yPos) ~= "number" then
		warn(string.format("⚠️ markLowerCheckpoints: yPos invalide pour %s", player.Name))
		return 0
	end

	local userId = player.UserId
	local allCheckpoints = getAllCheckpointsSorted()
	local markedCount = 0
	local rebirthCount = playerRebirthCount[userId] or 0

	print(string.format("🔒 Marquage checkpoints pour %s (Rebirth: %d, Y=%.1f)", 
		player.Name, rebirthCount, currentCheckpoint.yPos))

	local dataFolder = player:FindFirstChild("CheckpointData")
	if not dataFolder then
		dataFolder = Instance.new("Folder")
		dataFolder.Name = "CheckpointData"
		dataFolder.Parent = player
	end

	-- Marquer les checkpoints en dessous dans le folder (pour bloquer le farming)
	for _, cpData in ipairs(allCheckpoints) do
		if cpData.yPos <= currentCheckpoint.yPos + 2 then
			local part = cpData.part
			local checkpointUID = getOrCreateCheckpointUID(part, rebirthCount)
			local countKey = "checkpoint_" .. tostring(checkpointUID)

			if not dataFolder:FindFirstChild(countKey) then
				local marker = Instance.new("BoolValue")
				marker.Name = countKey
				marker.Value = true
				marker.Parent = dataFolder
				markedCount = markedCount + 1
			end
		end
	end

	print(string.format("✅ %d nouveaux checkpoints marqués dans le folder pour %s", markedCount, player.Name))

	-- ✅ CRUCIAL : NE PAS toucher playerCheckpoints[userId] ici
	-- La valeur chargée depuis le DataStore est la source de vérité
	-- Le folder sert uniquement à bloquer le re-farming, pas à compter
	-- playerCheckpoints[userId] a déjà été chargé par loadCheckpointQuestData

	print(string.format("📊 playerCheckpoints[%d] conservé depuis DataStore: %d", 
		userId, playerCheckpoints[userId] or 0))

	return markedCount
end

local function rebuildCheckpointFolder(player)
	local userId = player.UserId
	local touched = playerTouchedCheckpoints[userId]
	if not touched then return end

	-- Ne reconstruire que si playerCheckpoints < 100 pour ne pas bloquer les touches restantes
	local currentCount = playerCheckpoints[userId] or 0
	local requiredCount = 90
	if currentCount >= requiredCount then
		return
	end

	local dataFolder = player:FindFirstChild("CheckpointData")
	if not dataFolder then
		dataFolder = Instance.new("Folder")
		dataFolder.Name = "CheckpointData"
		dataFolder.Parent = player
	end

	-- Vider le folder d'abord pour repartir proprement
	dataFolder:ClearAllChildren()

	local count = 0
	for uid, _ in pairs(touched) do
		local countKey = "checkpoint_" .. tostring(uid)
		local marker = Instance.new("BoolValue")
		marker.Name = countKey
		marker.Value = true
		marker.Parent = dataFolder
		count = count + 1
	end

end

-- Fonction de validation (utilisée par SmartAntiCheat)
-- ✅ FIX : Au lieu de RESET À 0 (perte totale) sur valeurs hors range, on clamp.
-- JAMAIS de reset à 0 silencieux pour des points élevés.
local function validatePoints(points)
	if type(points) ~= "number" then 
		warn(string.format("⚠️ validatePoints: type invalide (%s), retour 0", type(points)))
		return 0 
	end
	if points ~= points then  -- NaN check
		warn("⚠️ validatePoints: NaN détecté, retour 0")
		return 0
	end
	if points < 0 then 
		warn(string.format("⚠️ validatePoints: négatif (%d), retour 0", points))
		return 0 
	end
	-- Limite augmentée à 1000 milliards. Lua/Roblox supporte sans souci jusqu'à 2^53.
	-- Clamp au max au lieu de reset à 0 si dépassement (anormal mais préserve les points).
	if points > 1000000000000 then 
		warn(string.format("⚠️ validatePoints: %d > 1T, clamping (anormal!)", points))
		return 1000000000000 
	end
	return points
end

