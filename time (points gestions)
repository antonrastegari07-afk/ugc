Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId
	local now = os.time()

	print("👋 JOUEUR QUITTE:", player.Name)

	-- ═══════════════════════════════════
	-- CAS 0 : NOUVEAU — Détecter reconnexion multi-appareil
	-- Si un PlayerAdded pour ce même userId est arrivé très récemment
	-- (dans les 8 secondes), c'est une reconnexion — NE PAS sauvegarder
	-- ═══════════════════════════════════
	local currentSession = activeConnections[userId]
	if currentSession and currentSession.player ~= player then
		warn(string.format("🛡️ RECONNEXION MULTI-APPAREIL détectée pour %s — PlayerRemoving ignoré pour sauvegarde", player.Name))
		-- ⚠️ NE PAS mettre tempsJoueurs[userId] = nil ici !
		-- La nouvelle session est peut-être déjà en train de charger dans cette table.
		-- On ne touche à rien, on laisse la nouvelle session gérer ses données.
		return
	end

	-- ═══════════════════════════════════
	-- CAS 1 : Reload propre déjà géré par notifyReloadEvent
	-- tempsJoueurs[userId] == nil signifie que le cleanup a déjà été fait
	-- ═══════════════════════════════════
	if tempsJoueurs[userId] == nil then
		print(string.format("✅ %s : cleanup déjà effectué (reload AFK), PlayerRemoving ignoré", 
			player.Name))

		-- Nettoyage recentReloads
		if recentReloads[userId] then
			recentReloads[userId] = nil
		end

		-- Refresh amis pour les joueurs restants
		task.delay(3, function()
			if #Players:GetPlayers() > 0 then
				refreshAllFriendsBatched()
			end
		end)
		return
	end

	-- ═══════════════════════════════════
	-- CAS 2 : Vraie déconnexion → sauvegarder normalement (UNIFIÉ)
	-- ═══════════════════════════════════
	print(string.format("💾 Vraie déconnexion détectée pour %s", player.Name))

	-- Si un nouveau chargement est en cours pour ce userId, ne pas sauvegarder
	if dataLoading[userId] then
		warn(string.format("🚫 PlayerRemoving: dataLoading actif pour %d, sauvegarde annulée", userId))
		tempsJoueurs[userId] = nil
		return
	end

	-- ✅ FIX UGC ORPHELIN : prompt d'achat encore ouvert au quit.
	-- Le prompt meurt avec la session → l'achat ne peut plus aboutir,
	-- mais les points ont déjà été déduits ET persistés. On rembourse.
	-- (Si PromptPurchaseFinished a confirmé l'achat, processed=true → skip.)
	-- 🔐 Plus AUCUN remboursement au quit. `PlayerOwnsAsset` répondait ici le
	-- `false` mis en cache par le pré-check → tu remboursais une UGC livrée.
	-- La créance est déjà écrite en DataStore ; elle est tranchée à la
	-- reconnexion, sur un serveur neuf, avec une réponse authentique.
	for key, pending in pairs(pendingUGCPurchases) do
		if key:sub(1, #tostring(userId) + 1) == (userId .. "_") then
			pending.processed = true
			pendingUGCPurchases[key] = nil
		end
	end
	if _G.UGCEscrow then
		_G.UGCEscrow.OnPlayerLeaving(player)
	end


	-- ✅ FIX RE-FARM : flusher le store checkpoint si des touches n'ont pas
	-- encore été persistées. Le worker 20s JETAIT la data dirty quand le
	-- joueur était parti ("else dirtyCheckpointData[userId] = nil") →
	-- checkpointQuestStore restait stale. On capture la data MAINTENANT
	-- (avant le cleanup mémoire) ; l'écriture part en async.
	-- saveCheckpointQuestData construit sa table `data` de façon SYNCHRONE
	-- avant le task.spawn, donc le cleanup qui suit ne peut pas la corrompre.
	if dirtyCheckpointData[userId] and playerEarnedPointLevels[userId] ~= nil then
		dirtyCheckpointData[userId] = nil
		saveCheckpointQuestData(userId, false)
		print(string.format("💾 Flush checkpoint data au quit pour %d (touches non sauvegardées)", userId))
	end


	-- ✅ NOUVEAU : 1 SEUL save unifié au lieu de 6 SetAsync dispersés
	local data = tempsJoueurs[userId]
	if data and type(data) == "table" then
		local totalPoints = data.base + data.future

		-- Détection corruption (reset par nouvelle session)
		if data.base == 0 and data.future == 0 and data.lastSaved == 0 then
			warn(string.format("🛡️ tempsJoueurs reset détecté pour %s — save annulée (nouvelle session probable)",
				player.Name))
			return
		end

		-- Limite raisonnable
		if totalPoints < 0 or totalPoints > 1000000000000 then
			warn(string.format("⚠️ Points hors range: %d pour %s, sauvegarde annulée",
				totalPoints, player.Name))
			return
		end

		-- Jitter aléatoire 0-0.8s pour étaler les writes multi-joueurs
		local saveDelay = math.random(0, 8) * 0.1
		if saveDelay > 0 then task.wait(saveDelay) end

		-- Re-check multi-device après le yield
		local sessionAfterDelay = activeConnections[userId]
		if sessionAfterDelay and sessionAfterDelay.player ~= player then
			warn(string.format("🛡️ MULTI-DEVICE détecté après délai pour %s — save annulée",
				player.Name))
			return
		end

		-- Re-lire tempsJoueurs (peut avoir bougé pendant task.wait)
		local dataAfterDelay = tempsJoueurs[userId]
		if not dataAfterDelay or type(dataAfterDelay) ~= "table" then
			-- Si reload a tout cleané, l'autre chemin a déjà sauvegardé → skip OK
			if recentReloads[userId] then
				print(string.format("ℹ️ %s : tempsJoueurs cleaned par reload, save déjà fait", player.Name))
				return
			end
			-- Sinon, fallback sur la copie capturée AVANT le délai (pas de perte)
			warn(string.format(
				"⚠️ tempsJoueurs disparu pour %s pendant le délai — fallback sur données capturées (%d pts)",
				player.Name, data.base + data.future
				))
			dataAfterDelay = data
		end

		if dataAfterDelay.base == 0 and dataAfterDelay.future == 0 and dataAfterDelay.lastSaved == 0 then
			warn(string.format("🛡️ tempsJoueurs reset pendant délai pour %s", player.Name))
			return
		end
		totalPoints = dataAfterDelay.base + dataAfterDelay.future

		-- ✅ APPEL UNIQUE : secureSave écrit TOUT (points + rebirths + kills + checkpoints + warnings)
		-- dans PlayerData_v1 en 1 seul SetAsync
		print(string.format("💾 Save unifié final: %d pts pour %s", totalPoints, player.Name))
		local saveOk = secureSave(userId, totalPoints)

		if saveOk then
			print("✅ Save unifié réussi pour " .. player.Name)

			-- Ne pas nil-out si nouvelle session active
			local sessionAfterSave = activeConnections[userId]
			if not (sessionAfterSave and sessionAfterSave.player ~= player) then
				tempsJoueurs[userId] = nil
			end
		else
			warn("❌ Save unifié échoué pour " .. player.Name)
		end
	end

	-- ═══════════════════════════════════
	-- CLEANUP MÉMOIRE
	-- ═══════════════════════════════════
	task.wait(1)

	-- ✅ FIX MULTI-APPAREIL : Vérifier qu'une nouvelle session n'a pas pris le relais pendant le task.wait(1)
	local sessionAfterWait = activeConnections[userId]
	if sessionAfterWait and sessionAfterWait.player ~= player then
		warn(string.format("🛡️ CLEANUP ANNULÉ pour %s : nouvelle session active détectée après task.wait(1)", player.Name))
		return  -- Ne pas effacer les données de la nouvelle session
	end

	playerCurrentCheckpoint[userId] = nil
	friendCountCache[userId] = nil
	lastFriendCheck[userId] = nil
	friendsCache[userId] = nil
	tempsJoueurs[userId] = nil
	tempsJoueurs[userId .. "_pause"] = nil
	LossGuard.cleanup(userId)  -- ✅ Cleanup module externe
	_G.lastNotifyReload[userId] = nil
	_G.lastNotifyReload["abuse_" .. userId] = nil
	playerKillCount[userId] = nil
	playerKillCooldown[userId] = nil
	flushTotalKills(userId)
	totalKillsDirty[userId] = nil
	playerTotalKills[userId] = nil
	killQuestCooldowns[userId] = nil
	killQuestProgress[userId] = nil
	playerRebirthCount[userId] = nil
	allowedRebirth[userId] = nil
	playerCheckpoints[userId] = nil
	checkpointQuestCooldowns[userId] = nil
	playerTouchedCheckpoints[userId] = nil
	playerEarnedPointLevels[userId] = nil
	playerRedeemedCodes[userId] = nil
	Settings.data[userId] = nil
	Settings.rate[userId] = nil
	gamePassCache[userId] = nil
	_G.ACOptim.status[userId] = nil
	_G.ACOptim.attrAt[userId] = nil
	uiUpdateQueue[userId] = nil
	lastUIUpdate[userId] = nil
	pointLevelGlobalDebounce[userId] = nil
	AntiExploit.playerTracking[userId] = nil
	recentReloads[userId] = nil
	activeConnections[userId] = nil
	questCooldownsLoaded[userId] = nil
	rebirthTriggerCooldown[userId] = nil
	playerPlaytime[userId] = nil
	playerSessionStart[userId] = nil

	for key in pairs(lastPointLevelTouch) do
		if key:match("^" .. userId .. "_") then
			lastPointLevelTouch[key] = nil
		end
	end
	for key in pairs(checkpointTouchCooldown) do
		if key:match("^" .. userId .. "_") then
			checkpointTouchCooldown[key] = nil
		end
	end
	for key in pairs(checkpointRecountTimers) do
		if key:match("^" .. userId .. "_") then
			checkpointRecountTimers[key] = nil
		end
	end
	for _, friendList in pairs(friendsCache) do
		if type(friendList) == "table" and friendList[userId] then
			friendList[userId] = nil
		end
	end

	task.delay(15, function()
		disconnectProtection[userId] = nil
	end)

	-- Refresh amis
	task.delay(3, function()
		if #Players:GetPlayers() > 0 then
			refreshAllFriendsBatched()
		end
	end)

	print("✅ Cleanup complet pour", player.Name)
end)

killQuestClaimEvent.OnServerEvent:Connect(function(player)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local now = os.time()

	-- Anti-spam
	if not AntiExploit.CheckRemoteCall(player, "KillQuestClaim") then return end

	-- Données chargées ?
	if playerKillCount[userId] == nil or killQuestCooldowns[userId] == nil then
		warn(string.format("⚠️ %s tente de claim KillQuest avant chargement", player.Name))
		pcall(function() updateKillUI(player) end)
		return
	end

	-- ✅ Vérifier cooldown 24h
	local cooldownEnd = killQuestCooldowns[userId] or 0
	if now < cooldownEnd then
		-- ✅ FIX FAUX-BAN : claim bloqué = 0 point => déjà sûr, aucune infraction.
		AntiExploit.NoteBlockedClaim(player, "KillQuest")
		updateKillUI(player)
		return
	end

	-- Vérif progression quest suffisante
	if (killQuestProgress[userId] or 0) < KILL_QUEST_REQUIRED then
		AntiExploit.NoteBlockedClaim(player, "KillQuest")
		pcall(function() updateKillUI(player) end)
		return
	end

	-- ✅ Poser le cooldown 24h IMMÉDIATEMENT (protection double-clic)
	killQuestCooldowns[userId] = now + KILL_QUEST_COOLDOWN

	-- ✅ Reset la progression quest (le joueur devra refaire 10 kills après le cooldown 24h)
	killQuestProgress[userId] = 0

	-- Sauvegarder le cooldown en DataStore
	task.spawn(function()
		pcall(function()
			KILL_QUEST_COOLDOWN_STORE:SetAsync("kq_" .. userId, killQuestCooldowns[userId])
		end)
	end)

	-- Sauvegarder le kill count reset
	saveKillData(userId)

	-- Donner les points
	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, KILL_QUEST_REWARD, "KillQuest")
	tempsJoueurs[userId].future = tempsJoueurs[userId].future + KILL_QUEST_REWARD

	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local total = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value = applyAllBonuses(calculatePoints(total), player)
		player:SetAttribute("Points", pointsStat.Value)

		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = pointsStat.Value
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end
	end

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, KILL_QUEST_REWARD, "KillQuest")
	end)
	task.spawn(function()
		local total = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		secureSave(userId, total)
	end)

	-- Notifier le client
	pcall(function() buyGamePassEvent:FireClient(player) end)
	updateKillUI(player)

	print(string.format("✅ KillQuest claim: %s +%d pts | Cooldown 24h jusqu'à %d (dans %.1fh)",
		player.Name, KILL_QUEST_REWARD, killQuestCooldowns[userId], KILL_QUEST_COOLDOWN/3600))
end)

