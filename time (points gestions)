function SmartAntiCheat.ValidateGainInWindow(userId, pointsGained)
	local data = SmartAntiCheat.playerData[userId]
	if not data then return false end

	local now = os.time()
	local window = data.validationWindow

	if not window or not window.expectedGains then
		return false
	end

	-- ✅ LOG seulement si > seuil
	if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
		print(string.format("🔎 Validation: %d pts | %d gains en attente", 
			pointsGained, #window.expectedGains))
	end

	-- ✅ NOUVELLE LOGIQUE : Essayer de valider avec la SOMME des gains

	-- Essai 1: Chercher UN gain qui correspond
	for i, gain in ipairs(window.expectedGains) do
		local timeDiff = math.abs(now - gain.timestamp)
		local pointsDiff = math.abs(pointsGained - gain.points)

		local tolerance = gain.points < 500 and 0.50 or 0.30
		if pointsDiff <= (gain.points * tolerance) then
			table.remove(window.expectedGains, i)

			-- ✅ LOG seulement si > seuil
			if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
				print(string.format("✅ Gain validé (unique): %d pts (attendu: %d, écart: %ds)", 
					pointsGained, gain.points, timeDiff))
			end
			return true
		end
	end

	-- ✅ Essai 2: Essayer d'additionner plusieurs gains
	if #window.expectedGains > 1 then
		-- Calculer la somme de TOUS les gains dans la fenêtre
		local totalExpected = 0
		local gainsToRemove = {}

		for i, gain in ipairs(window.expectedGains) do
			totalExpected = totalExpected + gain.points
			table.insert(gainsToRemove, i)
		end

		local pointsDiff = math.abs(pointsGained - totalExpected)

		-- ✅ Si la somme correspond (±30%)
		if pointsDiff <= (totalExpected * 0.30) then
			-- ✅ LOG seulement si > seuil
			if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
				print(string.format("✅ Gains CUMULÉS validés: %d pts ≈ %d pts attendus (%d gains)", 
					pointsGained, totalExpected, #gainsToRemove))
			end

			-- Supprimer TOUS les gains utilisés
			for i = #gainsToRemove, 1, -1 do
				table.remove(window.expectedGains, gainsToRemove[i])
			end

			return true
		end

		-- ✅ Essai 3: Essayer des combinaisons partielles (2 gains, 3 gains, etc.)
		for numGains = 2, #window.expectedGains - 1 do
			local sum = 0
			local indices = {}

			for i = 1, numGains do
				sum = sum + window.expectedGains[i].points
				table.insert(indices, i)
			end

			local diff = math.abs(pointsGained - sum)

			if diff <= (sum * 0.30) then
				-- ✅ LOG seulement si > seuil
				if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
					print(string.format("✅ Gains PARTIELS validés: %d pts ≈ %d pts attendus (%d/%d gains)", 
						pointsGained, sum, numGains, #window.expectedGains))
				end

				-- Supprimer les gains utilisés
				for i = #indices, 1, -1 do
					table.remove(window.expectedGains, indices[i])
				end

				return true
			end
		end
	end

	-- ✅ Aucune combinaison ne fonctionne
	-- ✅ LOG DÉTAILLÉ seulement si > seuil
	if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN and #window.expectedGains > 0 then
		print(string.format("⚠️ Gain NON validé: %d pts | Gains attendus:", pointsGained))

		local totalInWindow = 0
		for i, gain in ipairs(window.expectedGains) do
			local age = now - gain.timestamp
			totalInWindow = totalInWindow + gain.points
			print(string.format("   %d. %d pts | %s | il y a %ds", 
				i, gain.points, gain.source, age))
		end

		print(string.format("   TOTAL fenêtre: %d pts (écart: %d)", totalInWindow, pointsGained - totalInWindow))
	end

	return false
end

