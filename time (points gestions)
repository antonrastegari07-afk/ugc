function SmartAntiCheat.UpdatePlayerProfile(player)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local data = SmartAntiCheat.playerData[userId]
	if not data then return end

	local now = os.time()

	if now - data.profile.lastProfileUpdate < 120 then
		return
	end

	-- ✅ CORRECTION: Utilise le cache GamePass
	local multiplier = 1
	if gamePassCache[userId] and (now - gamePassCache[userId].lastCheck) < GAMEPASS_CACHE_DURATION then
		multiplier = gamePassCache[userId].multiplier
	end

	data.profile.gamepassMultiplier = multiplier
	data.profile.hasGamepass = multiplier > 1
	data.profile.hasPremium = player.MembershipType == Enum.MembershipType.Premium
	data.profile.inGroup = player:IsInGroup(GroupId)

	-- ✅ CORRECTION: Utilise directement le cache ami
	if not lastFriendCheck[userId] or (now - lastFriendCheck[userId]) >= FRIEND_CACHE_DURATION then
		-- Fallback sur l'attribut si le cache est vide
		friendCountCache[userId] = friendCountCache[userId] or player:GetAttribute("FriendCount") or 0
		lastFriendCheck[userId] = now
		print(string.format("🔄 UpdateProfile: Cache ami expiré pour %s, forcé à %d amis", 
			player.Name, 
			friendCountCache[userId] or 0))
	end

	data.profile.friendCount = friendCountCache[userId] or 0
	data.profile.lastProfileUpdate = now
end


function SmartAntiCheat.CalculateMaxGain(player, timeWindow)
	if not player or not player.Parent then return 0 end

	local userId = player.UserId
	local now = os.time()

	-- ✅ Cache 30s (au lieu de 20s)
	local cacheKey = userId .. "_" .. timeWindow
	local cached = SmartAntiCheat.calculationCache[cacheKey]
	local cacheExpiry = SmartAntiCheat.cacheExpiry[cacheKey]

	if cached and cacheExpiry and now < cacheExpiry then
		return cached
	end

	local data = SmartAntiCheat.playerData[userId]
	if not data then return 0 end

	-- ✅ Update profile seulement si nécessaire (200s au lieu de 120s)
	if not data.profile or (now - (data.profile.lastProfileUpdate or 0)) > 200 then
		SmartAntiCheat.UpdatePlayerProfile(player)
	end

	local profile = data.profile

	-- ✅ CORRECTION: Utilise directement le cache ami
	if not lastFriendCheck[userId] or (now - lastFriendCheck[userId]) >= FRIEND_CACHE_DURATION then
		local freshCount = friendCountCache[userId] or player:GetAttribute("FriendCount") or 0
		friendCountCache[userId] = freshCount
		lastFriendCheck[userId] = now
		profile.friendCount = freshCount
		profile.lastProfileUpdate = now
	end

	local maxGain = 0

	-- ✅ CORRECTION 1: basePerSec = 1 (au lieu de 3)
	local basePerSec = 1  -- ✅ CORRIGÉ
	local friendMult = 1   -- 🚫 amis : aucun boost
	local passiveGain = basePerSec * friendMult * timeWindow

	local totalMult = profile.gamepassMultiplier
	if profile.inGroup then totalMult = totalMult * 1.1 end
	if profile.hasPremium then totalMult = totalMult * 1.15 end

	-- ✨ Boosts temporaires (additif comme la boucle passive)
	local boostSum = (_G.TempBoosts and _G.TempBoosts.getMultiplier(userId)) or 0
	if boostSum > 0 then
		totalMult = (totalMult == 1 and 0 or totalMult) + boostSum
		if totalMult < 1 then totalMult = 1 end
	end

	maxGain = passiveGain * totalMult

	local maxPointLevels = math.ceil(timeWindow / 1800)
	local maxKills = math.ceil(timeWindow / 10)

	-- ✅ CORRECTION 2: Checkpoints/Kills NE SONT PAS multipliés par GamePass
	maxGain = maxGain + (maxPointLevels * 100) + (maxKills * 100)  -- ✅ CORRIGÉ

	-- ✅ BUFFER CONSERVÉ (non modifié comme demandé)
	maxGain = maxGain * 2
	maxGain = maxGain + 1000
	maxGain = math.floor(maxGain)

	-- ✅ Cache 30s (au lieu de 20s)
	SmartAntiCheat.calculationCache[cacheKey] = maxGain
	SmartAntiCheat.cacheExpiry[cacheKey] = now + 30

	return maxGain
end


