--    remonte la mémoire au lieu d'écraser la base.
--    ⚠️ Dans _G, pas en local : limite des 200 registres du script.
_G.PlaytimeRepair = function(userId, storedSeconds)
	if not Players:GetPlayerByUserId(userId) then return end
	local current = getCurrentPlaytime(userId)
	if type(storedSeconds) ~= "number" or storedSeconds <= current then return end
	local start = playerSessionStart[userId]
	playerPlaytime[userId] = storedSeconds - (start and (os.time() - start) or 0)
	local p = Players:GetPlayerByUserId(userId)
	if p then p:SetAttribute("PlaytimeSeconds", storedSeconds) end
	warn(string.format("⏱️ Playtime réparé pour %d : %d s en mémoire → %d s (valeur en base)",
		userId, current, storedSeconds))
end


