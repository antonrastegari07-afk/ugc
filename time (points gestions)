-- FONCTION PRINCIPALE D'AJOUT DE POINTS
-- ========================================
local function addFuturePoints(player, basePoints)
	if not player or not player.Parent then return end
	local userId = player.UserId

	if type(tempsJoueurs[userId]) ~= "table" then
		-- ✅ FIX BUG RELOAD : Si reload AFK en cours, NE PAS recréer tempsJoueurs
		-- (sinon LossGuard détecte une fausse perte brutale dans PlayerRemoving)
		if recentReloads[userId] then
			return  -- Skip silencieusement, normal pendant reload AFK
		end

		-- ✅ FIX BUG RELOAD : Si pas de session active enregistrée, NE PAS recréer
		-- (sinon on recrée pour des sessions qui sont en train de quitter)
		local activeSession = activeConnections[userId]
		if not activeSession or activeSession.player ~= player then
			return  -- Skip silencieusement
		end

		-- Cas restant : bug multi-appareil → restaurer depuis attribut
		local oldPoints = 0
		local loadedBase = player:GetAttribute("LoadedBasePoints")
		local loadedAt = player:GetAttribute("LoadedAt")
		if loadedBase and loadedAt and (os.time() - loadedAt) < 30 then
			warn(string.format("🛡️ RESTAURATION ANTI-MULTIAPPAREIL pour %s : base restaurée à %d", 
				player.Name, loadedBase))
			oldPoints = loadedBase
		end

		tempsJoueurs[userId] = {base = oldPoints, future = 0, lastSaved = os.time()}
	end

	local data = tempsJoueurs[userId]

	-- ✅ Pas de multiplication ! Les points arrivent déjà calculés
	local pointsToAdd = basePoints

	data.future = data.future + pointsToAdd

	-- Hook AbsoluteCap
	if _G.AbsoluteCapHooks then
		_G.AbsoluteCapHooks.onGain(player, pointsToAdd, source)
	end

	-- ✅ Mise à jour directe du leaderstat (plus de queue)
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = data.base + data.future
		if type(totalPoints) == "number" and totalPoints == totalPoints then
			local finalValue = applyAllBonuses(calculatePoints(totalPoints), player)
			if type(finalValue) == "number" and finalValue == finalValue then
				pointsStat.Value = finalValue
				player:SetAttribute("Points", pointsStat.Value)
			end
		end
	end

	return pointsToAdd
end


