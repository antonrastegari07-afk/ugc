function SmartAntiCheat.AnalyzePlayer(player)
	local success, err = pcall(function()
		if not player or not player.Parent then return end

		local userId = player.UserId
		if isDeveloper(userId) then return end

		-- ✅ NOUVEAU : Log de début d'analyse
		print(string.format("🔄 ANALYSE AUTO démarrée pour %s (UserID: %d)", 
			player.Name, userId))

		local data = SmartAntiCheat.playerData[userId]
		if not data then
			SmartAntiCheat.InitPlayer(userId)
			return
		end

		-- ✅ NOUVEAU: Vérifier que les données sont chargées
		if not data.dataLoaded then
			local maxWait = 100
			local waited = 0
			while not data.dataLoaded and waited < maxWait do
				task.wait(0.1)
				waited = waited + 1
			end

			if not data.dataLoaded then
				warn("⚠️ Données pas encore chargées pour " .. player.Name .. ", analyse reportée")
				return
			end
		end

		if not data.pointsHistory or type(data.pointsHistory) ~= "table" then
			data.pointsHistory = {}
			return
		end

		local now = os.time()

		if now - data.lastAnalysis < 45 then
			return
		end

		-- Période de grâce
		if data.inGracePeriod then
			if now - data.sessionStart >= SmartAntiCheat.CONFIG.GRACE_PERIOD then
				data.inGracePeriod = false
				print(string.format("⏰ Période de grâce terminée pour %s", player.Name))
			else
				return
			end
		end

		local leaderstats = player:FindFirstChild("leaderstats")
		if not leaderstats then return end

		local pointsStat = leaderstats:FindFirstChild("Points")
		if not pointsStat then return end

		local currentPoints = validatePoints(pointsStat.Value)
		local timeElapsed = now - data.lastCheckTime

		if timeElapsed < 40 then
			return
		end

		local pointsGained = currentPoints - data.lastKnownPoints

		-- ✅ CORRECTION CRITIQUE : Forcer mise à jour du profil si nécessaire
		local now = os.time()
		if not data.profile or not data.profile.gamepassMultiplier or data.profile.gamepassMultiplier == 1 then
			SmartAntiCheat.UpdatePlayerProfile(player)
		end

		-- ✅ NOUVEAU : Calculer les points passifs gagnés pendant cette période
		local profile = data.profile or {}
		local basePerSec = 1
		local friendMult = 1   -- 🚫 amis : aucun boost (aligné avec la boucle passive)

		-- ✅ CORRECTION : Récupérer le GamePass directement si le profil est vide
		local gamePassMult = profile.gamepassMultiplier or 1
		if gamePassMult == 1 then
			-- Fallback : récupérer du cache GamePass directement
			if gamePassCache[userId] and gamePassCache[userId].multiplier then
				gamePassMult = gamePassCache[userId].multiplier
				print(string.format("⚠️ GamePass récupéré du cache: x%d pour %s", gamePassMult, player.Name))
			else
				-- Forcer le recalcul
				gamePassMult = getHighestGamePassMultiplier(player)
				print(string.format("⚠️ GamePass recalculé: x%d pour %s", gamePassMult, player.Name))
			end

			-- Mettre à jour le profil pour la prochaine fois
			if profile then
				profile.gamepassMultiplier = gamePassMult
			end
		end

		-- ✅ Appliquer les bonus de groupe et premium
		local totalPassiveMult = gamePassMult
		if profile.inGroup or player:IsInGroup(GroupId) then 
			totalPassiveMult = totalPassiveMult * 1.1 
		end
		if profile.hasPremium or player.MembershipType == Enum.MembershipType.Premium then 
			totalPassiveMult = totalPassiveMult * 1.15 
		end

		-- ✨ Boosts temporaires (additif comme la boucle passive)
		local boostSum = (_G.TempBoosts and _G.TempBoosts.getMultiplier(userId)) or 0
		if boostSum > 0 then
			totalPassiveMult = (totalPassiveMult == 1 and 0 or totalPassiveMult) + boostSum
			if totalPassiveMult < 1 then totalPassiveMult = 1 end
		end

		local passiveGain = basePerSec * friendMult * totalPassiveMult * timeElapsed
		passiveGain = math.floor(passiveGain)

		-- ✅ Soustraire les points passifs du gain total
		local activeGain = pointsGained - passiveGain

		-- ✅ LOG: Début d'analyse avec détails passifs
		local analyseType = data.lastAnalysis == 0 and "PREMIÈRE" or "AUTO"
		print(string.format("🔍 ANALYSE %s: %s | Points: %d→%d (+%d) | Temps: %ds", 
			analyseType,
			player.Name, 
			data.lastKnownPoints, 
			currentPoints, 
			pointsGained,
			timeElapsed
			))
		print(string.format("   💤 Passif estimé: %d pts (%.2f/s × %ds) | GamePass: x%d", 
			passiveGain,
			basePerSec * friendMult * totalPassiveMult,
			timeElapsed,
			gamePassMult
			))
		print(string.format("   ⚡ Gain actif: %d pts (= %d total - %d passif)", 
			activeGain,
			pointsGained,
			passiveGain
			))

		-- ✅ NOUVEAU : Premier scan = calibration baseline TOUJOURS (peu importe le montant)
		-- Évite que le 2e scan voie un faux "gros gain" sur un nouveau joueur
		if not data.firstAnalysisDone then
			data.firstAnalysisDone = true
			data.lastKnownPoints = currentPoints
			data.lastCheckTime = now
			data.lastAnalysis = now
			print(string.format("ℹ️ Calibration baseline pour %s: %d pts (premier scan ignoré)", 
				player.Name, currentPoints))
			return
		end

		-- ✅ NOUVEAU : Grace period étendue — pas de ratio check pendant les 90 premières secondes
		-- Protège les nouveaux joueurs qui achètent un DevProduct ou claim une quête tôt
		local sessionAge = now - data.sessionStart
		if sessionAge < 90 then
			print(string.format("⏰ Session jeune (%ds), ratio check skip pour %s", 
				sessionAge, player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		-- Ancien fallback conservé pour les rares cas où firstAnalysisDone serait perdu
		if data.lastKnownPoints == 0 and currentPoints > 1000 then
			warn(string.format("ℹ️ Fallback premier scan pour %s: %d points", 
				player.Name, 
				currentPoints))

			data.lastKnownPoints = currentPoints
			data.lastCheckTime = now
			data.lastAnalysis = now
			return
		end

		if pointsGained < 0 then
			print(string.format("⬇️ Points négatifs pour %s (achat UGC?), ignoré", player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		if pointsGained < 30 then
			print(string.format("✅ Gain faible (%d pts) pour %s, ignoré", pointsGained, player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		-- ✅ CORRECTIF BOX : Soustraire les points légitimes de boxes du calcul
		local boxPoints = 0
		if data.pointsHistory then
			for _, event in ipairs(data.pointsHistory) do
				if (event.source == "BoxReward" or event.source == "BoxDuplicate") 
					and (os.time() - event.timestamp) <= timeElapsed then
					boxPoints = boxPoints + (event.points or 0)
				end
			end
		end
		if boxPoints > 0 then
			print(string.format("📦 Points de boxes soustraits du calcul: %d pts pour %s", boxPoints, player.Name))
			activeGain = math.max(0, activeGain - boxPoints)
			passiveGain = passiveGain  -- inchangé
		end

		-- ✅ NOUVEAU : Validation par fenêtre temporelle (sur le gain ACTIF)
		print(string.format("🔎 Vérification fenêtre pour %s | Gain actif: %d pts", player.Name, activeGain))

		local isValidated = SmartAntiCheat.ValidateGainInWindow(userId, activeGain)

		if isValidated then
			data.infractions.burstCount = 0
			data.infractions.suspiciousCount = math.max(0, data.infractions.suspiciousCount - 1)

			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now

			print(string.format("✅ VALIDÉ (fenêtre): %s | +%d pts | Infractions: %d", 
				player.Name, pointsGained, data.infractions.totalInfractions))

			-- ✅ NOUVEAU : Nettoyer les gains TRÈS anciens (>5 minutes) après validation réussie
			if data.validationWindow and data.validationWindow.expectedGains then
				local cutoff = now - 300 -- 5 minutes
				local newExpected = {}
				local cleaned = 0

				for _, gain in ipairs(data.validationWindow.expectedGains) do
					if gain.timestamp >= cutoff then
						table.insert(newExpected, gain)
					else
						cleaned = cleaned + 1
					end
				end

				if cleaned > 0 then
					data.validationWindow.expectedGains = newExpected
					print(string.format("🧹 Nettoyage post-validation: %d gains anciens supprimés", cleaned))
				end
			end

			return
		end

		-- ✅ LOG: Pas validé par fenêtre
		if activeGain < 500 and #SmartAntiCheat.playerData[userId].validationWindow.expectedGains == 0 then
			print(string.format("✅ Gain faible non-validé ignoré (%d pts, fenêtre vide) pour %s", activeGain, player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end
		print(string.format("⚠️ PAS VALIDÉ par fenêtre pour %s, calcul ratio...", player.Name))

		-- ✅ ANALYSE NORMALE (sur le gain ACTIF, sans les passifs)
		local maxGain = SmartAntiCheat.CalculateMaxGain(player, timeElapsed)

		-- ✅ IMPORTANT : Soustraire AUSSI les passifs du maxGain pour comparer correctement
		local maxActiveGain = maxGain - passiveGain

		local ratio = maxActiveGain > 0 and (activeGain / maxActiveGain) or 0

		-- ✅ LOG: Ratio calculé
		print(string.format("📊 RATIO: %s | +%d/%d (%.2fx) | Passif: %d pts", 
			player.Name, activeGain, maxActiveGain, ratio, passiveGain))

		if ratio > 1.2 then
			local friendCount = friendCountCache[userId] or 0
			local friendMult = 1 + (math.min(friendCount, 3) * 0.10)

			print(string.format(
				"📊 DÉTAILS: %s | +%d/%d (%.1fx) | %ds | Amis:%d (x%.1f)",
				player.Name,
				pointsGained,
				maxGain,
				ratio,
				timeElapsed,
				friendCount,
				friendMult
				))
		end

		local SUSPICIOUS = 1.5
		local DANGEROUS = 2.5
		local BAN = 5

		-- NIVEAU 1: SUSPECT
		if ratio >= SUSPICIOUS then
			data.infractions.suspiciousCount = data.infractions.suspiciousCount + 1
			data.infractions.burstCount = data.infractions.burstCount + 1
			data.infractions.totalInfractions = data.infractions.totalInfractions + 1
			data.infractions.lastInfractionTime = now

			warn(string.format(
				"⚠️ SUSPECT: %s | %d/%d (%.1fx) | Inf:%d/%d | Bursts:%d",
				player.Name,
				pointsGained,
				maxGain,
				ratio,
				data.infractions.totalInfractions,
				3,
				data.infractions.burstCount
				))
		end

		-- NIVEAU 2: DANGEREUX (kick après 2 bursts)
		if ratio >= DANGEROUS and data.infractions.burstCount > 1 then
			SmartAntiCheat.globalStats.totalKicks = SmartAntiCheat.globalStats.totalKicks + 1

			warn(string.format(
				"🚨 KICK: %s | Ratio: %.1fx | Bursts: %d",
				player.Name, ratio, data.infractions.burstCount
				))

			if player.Parent then
				player:Kick(string.format(
					"⚠️ WARNING\n\n" ..
						"Active gain: %d pts (total: %d - passive: %d)\n" ..
						"Max allowed: %d pts in %ds\n" ..
						"Ratio: %.1fx\n\n" ..
						"Reconnect if legitimate.\n" ..
						"Repeated infractions = BAN.",
					activeGain,
					pointsGained,
					passiveGain,
					maxActiveGain,
					timeElapsed,
					ratio
					))
			end

			return
		end

		-- NIVEAU 3: BAN
		if ratio >= BAN then
			SmartAntiCheat.globalStats.totalBans = SmartAntiCheat.globalStats.totalBans + 1

			AntiExploit.bannedPlayers[userId] = true

			if _G.BanManager then
				pcall(function()
					_G.BanManager.Log({
						userId = userId, reason = "anticheat",
						details = string.format("%d/%d (%.1fx) en %ds",
							pointsGained, maxGain, ratio, timeElapsed),
						action = "ban", name = player.Name, by = "SmartAntiCheat",
					})
				end)
			end

			warn(string.format(
				"🚫 BAN PERMANENT: %s | Ratio: %.1fx | Total infractions: %d",
				player.Name, ratio, data.infractions.totalInfractions
				))

			task.spawn(function()
				-- Ligne ~ligne 130 de ton script
				local banStore = DataStoreService:GetDataStore("BannedPlayers")
				pcall(function()
					banStore:SetAsync(tostring(userId), {
						reason = "SMART_ANTICHEAT",
						details = string.format("%d/%d (%.1fx)", pointsGained, maxGain, ratio),
						timestamp = os.time(),
						playerName = player.Name,
					})
				end)
			end)

			if player.Parent then
				player:Kick(string.format(
					"🚫 PERMANENT BAN\n\n" ..
						"Exploitation detected.\n" ..
						"Gain: %d/%d (%.1fx)\n" ..
						"UserID: %d",
					pointsGained,
					maxGain,
					ratio,
					userId
					))
			end

			return
		end

		-- Réduction progressive
		if ratio < SUSPICIOUS then
			data.infractions.burstCount = math.max(0, data.infractions.burstCount - 1)
			if data.infractions.suspiciousCount > 0 then
				data.infractions.suspiciousCount = data.infractions.suspiciousCount - 1
			end

			print(string.format("✅ Ratio OK (%.2fx) pour %s, réduction infractions", ratio, player.Name))
		end

		data.lastCheckTime = now
		data.lastKnownPoints = currentPoints
		data.lastAnalysis = now

		SmartAntiCheat.globalStats.totalAnalyses = SmartAntiCheat.globalStats.totalAnalyses + 1
	end)

	if not success then
		warn("❌ Erreur AnalyzePlayer:", tostring(err))
		if player and player.Parent then
			local data = SmartAntiCheat.playerData[player.UserId]
			if data then data.pointsHistory = {} end
		end
	end
end


