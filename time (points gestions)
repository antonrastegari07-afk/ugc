local function processPlayerFriends(userId)
	local player = Players:GetPlayerByUserId(userId)
	if not player or not player.Parent then
		dirtyPlayers[userId] = nil
		return
	end

	print(string.format("⚙️ Traitement: %s (UserID %d)", player.Name, userId))

	-- ✅ FORCER le recompte (ignorer cache)
	local friendCount = countFriendsInGame(player, true)

	-- Mettre à jour UI
	player:SetAttribute("FriendCount", friendCount)
	updateFriendUI(player)

	-- Mettre à jour SmartAntiCheat
	local smartData = SmartAntiCheat.playerData[userId]
	if smartData and smartData.profile then
		smartData.profile.friendCount = friendCount
		smartData.profile.lastProfileUpdate = os.time()
	end

	-- Marquer comme traité
	if dirtyPlayers[userId] then
		dirtyPlayers[userId].processed = true
	end

	print(string.format("✅ Traité: %s → %d amis (x%.2f)", 
		player.Name, friendCount, getFriendMultiplier(player)))
end

