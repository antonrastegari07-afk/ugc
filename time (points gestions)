-- ✅ COMPTAGE PASSIF — pcall par joueur + skip strict pendant reload
-- ========================================
task.spawn(function()
	while true do
		task.wait(1)
		local allPlayers = Players:GetPlayers()
		for _, player in ipairs(allPlayers) do
			pcall(function()
				if not (player and player.Parent) then return end
				local userId = player.UserId

				-- ✅ FIX BUG RELOAD : Skip immédiat si reload AFK en cours
				if recentReloads[userId] then return end

				-- ✅ Multi-appareil : EXIGER une session active pour ce player
				local activeSession = activeConnections[userId]
				if not activeSession or activeSession.player ~= player then
					return  -- Pas de session OU pas la bonne session
				end

				if dataLoading[userId] then return end

				-- ✅ FIX BUG RELOAD : Skip si tempsJoueurs n'existe pas
				-- (au lieu de le recréer par erreur)
				local playerData = tempsJoueurs[userId]
				if not playerData or type(playerData) ~= "table" then return end

				if not tempsJoueurs[userId .. "_pause"] and not playerData.loading then
					local basePoints = 1
					local friendBonus = 0   -- 🚫 amis : aucun boost
					local gamePassMult = getHighestGamePassMultiplier(player)
					local boostSum = (_G.TempBoosts and _G.TempBoosts.getMultiplier(userId)) or 0

					-- ✅ FIX BOOST : le boost REMPLACE le "1" de base au lieu de s'y additionner.
					--   x5 seul   → 5 pts/s   (avant : 1 + 5  = 6)
					--   x5 + x10  → 15 pts/s  (avant : 1 + 15 = 16)
					-- On ne retire le "1" de base QUE s'il n'y a pas de gamepass
					-- (gamePassMult contient déjà ce 1). Gamepass + amis s'ajoutent au boost.
					-- ⚠️ Logique IDENTIQUE à SmartAntiCheat.CalculateMaxGain/AnalyzePlayer → 0 faux ban.
					-- 🆕 Bonus de statut : +10% si dans le groupe, +10% si Premium (additif)
					local statusBonus = _G.ACOptim.getStatusBonus(player)
					local totalMult
					if boostSum > 0 then
						local gpPart = (gamePassMult == 1) and 0 or gamePassMult
						totalMult = gpPart + friendBonus + boostSum + statusBonus
					else
						totalMult = gamePassMult + friendBonus + statusBonus
					end
					if totalMult < 1 then totalMult = 1 end

					local finalPoints = basePoints * totalMult
					-- ✅ Expose le vrai multiplicateur au billboard
					-- 🌐 OPTIM RÉSEAU : cet attribut est répliqué à TOUS les
					--    clients du serveur. Il ne change que si un boost, un
					--    gamepass, le VIP ou le statut change — donc l'écrire
					--    chaque seconde envoyait un paquet pour rien.
					--    ⚠️ Zéro différence fonctionnelle : le billboard lit
					--       l'attribut, et l'attribut garde la même valeur.
					if player:GetAttribute("PointsMultiplier") ~= finalPoints then
						player:SetAttribute("PointsMultiplier", finalPoints)
					end
					addFuturePoints(player, finalPoints)
					if _G.EconStats then _G.EconStats.AddPassive(userId, finalPoints, gamePassMult, boostSum, statusBonus) end
				end
			end)
		end
	end
end)

