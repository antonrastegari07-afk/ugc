-- ✅ FONCTION: Trouver le Dev Product le moins cher qui permet d'acheter l'UGC
local function findBestDevProduct(pointsNeeded)
	local bestProduct = nil
	local smallestExcess = math.huge

	for productId, productData in pairs(PRODUCTS) do
		if productData.points >= pointsNeeded then
			local excess = productData.points - pointsNeeded
			if excess < smallestExcess then
				smallestExcess = excess
				bestProduct = {
					id = productId,
					name = productData.name,
					points = productData.points
				}
			end
		end
	end

	return bestProduct
end

purchaseUGCEvent.OnServerEvent:Connect(function(player, assetId)
	local success, err = pcall(function()
		local userId = player.UserId

		-- Cas InventoryClient : assetId = prix de la box
		if type(assetId) == "number" and not UGC_ITEMS[assetId] then
			local bestProduct = findBestDevProduct(assetId)
			if bestProduct then
				pcall(function()
					MarketplaceService:PromptProductPurchase(player, bestProduct.id)
				end)
			end
			return
		end

		if type(assetId) ~= "number" then
			warn("⚠️ Asset ID invalide pour " .. player.Name)
			return
		end

		local ugcData = UGC_ITEMS[assetId]
		if not ugcData then
			warn("⚠️ UGC non configuré: " .. tostring(assetId))
			return
		end

		-- 🚫 PRIVATION D'UGC — vérification serveur, avant toute déduction.
		--    Placée ici volontairement : plus haut on ne connaît pas encore
		--    l'UGC visée, plus bas les points seraient déjà engagés.
		if _G.UGCRestrict then
			--  🆕 3ᵉ valeur : `rec`, la fiche de la sanction. Elle sert à
			--     remplir {warnings} et {confidence} dans tes textes.
			local blocked, why, rec = _G.UGCRestrict.CheckPurchase(player)
			if blocked then
				warn(string.format("🚫 [UGC] Achat refusé pour %s (%s) — %s",
					player.Name, ugcData.name, tostring(why)))

				-- 💬 Titre + texte pris dans le panel admin (⚙️ Messages → 🛒 Shop).
				--    Rendus ICI, côté serveur, avec les vraies valeurs. Le client
				--    ne reçoit qu'un texte fini : il n'y a aucun gabarit à
				--    interpréter côté joueur, donc aucune surface d'injection.
				--
				--    Deux textes DIFFÉRENTS selon le cas, et c'est important :
				--      • "restricted"  = il est vraiment sanctionné
				--      • sinon         = le registre n'a pas répondu, ce n'est
				--                        PAS une sanction et ça peut arriver à
				--                        n'importe qui.
				local title, body
				if _G.ACConfig and _G.ACConfig.Msg then
					local vars = {
						player     = player.Name,
						warnings   = rec and rec.warnings or nil,
						confidence = rec and rec.confidence or nil,
					}
					local ok = pcall(function()
						if why == "restricted" then
							title = _G.ACConfig.Msg("shopBlockedTitle", vars)
							body  = _G.ACConfig.Msg("shopBlockedBody", vars)
						else
							title = _G.ACConfig.Msg("shopUnverifiedTitle", vars)
							body  = _G.ACConfig.Msg("shopUnverifiedBody", vars)
						end
					end)
					--  Si la config n'est pas encore lue, on laisse le client
					--  afficher ses textes par défaut plutôt que rien.
					if not ok then title, body = nil, nil end
				end

				pcall(function()
					confirmUGCPurchaseEvent:FireClient(player, false,
						(why == "restricted") and "ugc_restricted" or "ugc_unverified",
						-- ⚠️ `assetId` et le nom restent en 3ᵉ et 4ᵉ position :
						--    ton shop client existant continue de fonctionner
						--    sans la moindre modification. Le bloc de texte est
						--    AJOUTÉ à la fin, là où rien ne le lisait avant.
						assetId, ugcData.name,
						{ title = title, message = body })
				end)
				return
			end
		else
			-- Le module n'est pas chargé : on refuse plutôt que de laisser
			-- passer. Un joueur honnête voit un message « réessaie », un
			-- exploiteur ne gagne rien à faire tomber le module.
			warn("🚫 [UGC] _G.UGCRestrict absent — achat refusé par sécurité")
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false,
					"ugc_unverified", assetId, ugcData.name)
			end)
			return
		end

		-- 🔒 FIX: Bloquer si données pas chargées
		if dataLoading[userId] then
			warn(string.format("⚠️ %s tente UGC pendant chargement initial", player.Name))
			return
		end

		-- 🔒 FIX: Bloquer si reload en cours
		if recentReloads[userId] then
			warn(string.format("⚠️ %s tente UGC pendant reload AFK", player.Name))
			return
		end

		-- 🔒 Cooldown GLOBAL au joueur (pas par asset)
		local now = os.time()
		local globalKey = "global_" .. userId
		if ugcPurchaseCooldown[globalKey] and now - ugcPurchaseCooldown[globalKey] < 3 then
			warn("⚠️ " .. player.Name .. " spam détecté (cooldown global UGC)")
			return
		end

		-- 🔒 Un ticket n'est JAMAIS supprimé sans être résolu.
		-- (Avant : suppression à 30 s alors que le prompt Roblox reste ouvert
		--  indéfiniment → prompt orphelin sans trace côté serveur.)
		for key, pending in pairs(pendingUGCPurchases) do
			if key:sub(1, #tostring(userId) + 1) == (userId .. "_") then
				if not pending.processed then
					warn(string.format("⚠️ %s a déjà un achat UGC en cours (%s, %ds), rejeté",
						player.Name, pending.name, now - pending.timestamp))
					pcall(function()
						confirmUGCPurchaseEvent:FireClient(player, false,
							"purchase_in_progress", assetId, ugcData.name)
					end)
					return
				end
				pendingUGCPurchases[key] = nil
			end
		end



		-- 🔒 FIX CRITIQUE: Vérifier les points depuis tempsJoueurs (source de vérité)
		local data = tempsJoueurs[userId]
		if type(data) ~= "table" then
			warn(string.format("⚠️ %s tente UGC sans tempsJoueurs valide", player.Name))
			return
		end

		local actualPoints = data.base + data.future

		-- 🔒 FIX EXPLOIT DOUBLE-UGC (version intelligente, ZÉRO lockout pour les gros soldes) :
		-- On ne bloque QUE si cet achat ferait passer le solde SOUS le total des
		-- remboursements récents encore régularisables. Un joueur avec de la marge
		-- (achats en rafale) n'est jamais bloqué.
		if _G.UGC_ANTI_DOUBLE_ENABLED then
			local pendingRefundSum = 0
			local blockRemaining = 0
			for key, r in pairs(recentPurchases or {}) do
				if type(key) == "string"
					and key:sub(1, #tostring(userId) + 1) == (userId .. "_")
					and type(r) == "table" and r.t then
					local remaining = 30 - (now - r.t)
					if remaining > 0 then
						pendingRefundSum = pendingRefundSum + (r.price or 0)
						if remaining > blockRemaining then blockRemaining = remaining end
					end
				end
			end
			if pendingRefundSum > 0 and (actualPoints - ugcData.price) < pendingRefundSum then
				warn(string.format("⏳ %s : achat UGC bloqué %ds (solde insuffisant pendant régularisation)",
					player.Name, blockRemaining))
				pcall(function()
					confirmUGCPurchaseEvent:FireClient(player, false, "refund_pending", assetId, ugcData.name, math.ceil(blockRemaining))
				end)
				return
			end
		end

		-- Pas assez de points → auto-prompt Dev Product
		if actualPoints < ugcData.price then
			local pointsNeeded = ugcData.price - actualPoints
			local bestProduct = findBestDevProduct(pointsNeeded)
			if bestProduct then
				print(string.format("💰 AUTO-PROMPT: %s manque %d points → %s",
					player.Name, pointsNeeded, bestProduct.name))
				pcall(function()
					MarketplaceService:PromptProductPurchase(player, bestProduct.id)
				end)
			else
				warn(string.format("⚠️ %s manque %d points mais aucun Dev Product adapté",
					player.Name, pointsNeeded))
			end
			return
		end

		ugcPurchaseCooldown[globalKey] = now

		-- 🔐 Possession vérifiée SANS toucher PlayerOwnsAsset.
		-- L'escrow tient son propre registre persistant (UGC validées + UGC vues
		-- par l'audit 24 h). Zéro appel API, donc zéro cache empoisonné : le
		-- premier appel de la session reste disponible pour la vérification qui
		-- compte vraiment, celle qui décide d'un remboursement.
		if not _G.UGCEscrow then
			warn("🚨 [UGC] _G.UGCEscrow absent — achat refusé par sécurité")
			return
		end
		local canBuy, reason = _G.UGCEscrow.CanBuy(player, assetId)
		if not canBuy then
			warn(string.format("🚫 Achat UGC refusé pour %s (%s) : %s",
				player.Name, ugcData.name, reason))
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false, reason, assetId, ugcData.name)
			end)
			return
		end

		-- Re-check d'état (l'appel ci-dessus peut yield sur un GetAsync)
		if dataLoading[userId] or recentReloads[userId] then
			warn(string.format("⚠️ État changé pendant CanBuy pour %s, achat annulé", player.Name))
			ugcPurchaseCooldown[globalKey] = nil
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false, "state_changed", assetId, ugcData.name)
			end)
			return
		end
		if not player or not player.Parent then
			ugcPurchaseCooldown[globalKey] = nil
			return
		end

		-- 🛡️ SÉCURITÉ : la table de points a-t-elle été remplacée pendant l'attente ?
		--    Si oui, `data` est orpheline : la débiter ne retirerait RIEN au joueur
		--    alors que l'UGC serait livrée. On abandonne l'achat.
		if tempsJoueurs[userId] ~= data then
			warn(string.format("🚨 [UGC] Table de points remplacée pendant la vérification pour %s → achat annulé",
				player.Name))
			ugcPurchaseCooldown[globalKey] = nil
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false, "state_changed", assetId, ugcData.name)
			end)
			return
		end

		-- 🛡️ SÉCURITÉ : le solde a-t-il baissé pendant l'attente ?
		--    Sans ce test, la déduction bornée par math.min prélèverait moins que
		--    le prix et le joueur repartirait avec l'UGC à moitié payée.
		local pointsNow = data.base + data.future
		if pointsNow < ugcData.price then
			warn(string.format("⚠️ [UGC] Solde tombé pendant la vérification pour %s (%d < %d) → achat annulé",
				player.Name, pointsNow, ugcData.price))
			ugcPurchaseCooldown[globalKey] = nil
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false, "not_enough_points", assetId, ugcData.name)
			end)
			return
		end

		local leaderstats = player:FindFirstChild("leaderstats")
		local points = leaderstats and leaderstats:FindFirstChild("Points")

		-- ✅ RÉSERVER les points
		local toRemove = ugcData.price
		local futureRemove = math.min(data.future, toRemove)
		data.future = data.future - futureRemove
		local baseRemove = math.min(data.base, toRemove - futureRemove)
		data.base = data.base - baseRemove
		-- 📊 Part Robux de ces points, figée MAINTENANT (aucun yield)
		if _G.EconStats then pcall(_G.EconStats.OnUGCDeduct, userId, assetId, ugcData.price) end

		-- Mise à jour leaderstat immédiate
		local totalPoints = data.base + data.future
		if points then
			points.Value = applyAllBonuses(calculatePoints(totalPoints), player)
			player:SetAttribute("Points", points.Value)
		end

		-- Sync SmartAntiCheat
		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = points and points.Value or totalPoints
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end

		-- Cooldown global déjà posé avant le yield PlayerOwnsAsset (anti-race-condition)

		-- Crée le ticket avec flag "déjà déduit"
		pendingUGCPurchases[userId .. "_" .. assetId] = {
			assetId = assetId,
			price = ugcData.price,
			name = ugcData.name,
			timestamp = now,
			alreadyDeducted = true,
			ownedBefore = false,         -- plus de pré-check : cette valeur n'est plus lue nulle part
			processed = false,            -- ✅ NOUVEAU : idempotence anti-double-fire de PromptPurchaseFinished
		}

		-- ✅ Notifier LossGuard AVANT le save (sinon blocage anti-perte sur grosse déduction)
		LossGuard.recordUGCSpend(userId, ugcData.price)

		-- 🔒 FIX CRITIQUE : SAVE SYNCHRONE avant le prompt
		-- Garantit que les points sont persistés AVANT que Roblox délivre l'UGC
		-- Bloque l'exploit leave-before-save (force-quit après réception UGC)
		local saveOk = secureSave(userId, totalPoints)
		if not saveOk then
			-- Save échouée : rembourser TOUT et abort
			data.future = data.future + ugcData.price
			LossGuard.cancelLastUGCSpend(userId, ugcData.price)
			if _G.EconStats then pcall(_G.EconStats.OnUGCRefund, userId, assetId) end
			local newTotal = data.base + data.future
			_G.suppressPointsAnim(player, ugcData.price)  -- 🆕 pas d'animation sur remboursement
			if points then
				points.Value = applyAllBonuses(calculatePoints(newTotal), player)
				player:SetAttribute("Points", points.Value)
			end

			pendingUGCPurchases[userId .. "_" .. assetId] = nil
			ugcPurchaseCooldown[globalKey] = nil

			warn(string.format("⚠️ Save UGC échouée pour %s, achat annulé (DataStore down?)", player.Name))
			return
		end

		print(string.format("💾 Save UGC confirmé pour %s : %d pts persistés", player.Name, totalPoints))

		-- 🔐 Créance écrite en DataStore, SYNCHRONE, avant l'ouverture du prompt.
		-- Un force-quit instantané après la livraison ne peut plus l'effacer.
		if not _G.UGCEscrow.Open(player, assetId, ugcData.price) then
			warn(string.format("🚨 Créance UGC non écrite pour %s → achat annulé et remboursé", player.Name))
			data.future = data.future + ugcData.price
			LossGuard.cancelLastUGCSpend(userId, ugcData.price)
			if _G.EconStats then pcall(_G.EconStats.OnUGCRefund, userId, assetId) end
			local newTotal = data.base + data.future
			_G.suppressPointsAnim(player, ugcData.price)
			if points then
				points.Value = applyAllBonuses(calculatePoints(newTotal), player)
				player:SetAttribute("Points", points.Value)
			end
			task.spawn(function() secureSave(userId, newTotal) end)
			pendingUGCPurchases[userId .. "_" .. assetId] = nil
			ugcPurchaseCooldown[globalKey] = nil
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false, "escrow_failed", assetId, ugcData.name)
			end)
			return
		end

		local ok, promptErr = pcall(function()
			MarketplaceService:PromptPurchase(player, assetId)
		end)
		if not ok then
			warn("❌ Erreur PromptPurchase: " .. tostring(promptErr))
			-- ⚠️ ON NE TOUCHE PAS AUX POINTS ICI.
			-- Une créance est ouverte : c'est l'escrow qui rembourse, avec son
			-- verrou "on ferme la créance d'abord, on paie ensuite". Si le
			-- script principal créditait aussi, et que la fermeture de la
			-- créance ratait, le joueur serait recrédité une 2e fois à sa
			-- reconnexion. Un seul endroit crée des points dans tout le système.
			_G.UGCEscrow.Cancel(player, assetId, "PromptPurchase a échoué")
			pendingUGCPurchases[userId .. "_" .. assetId] = nil
			ugcPurchaseCooldown[globalKey] = nil
			pcall(function()
				confirmUGCPurchaseEvent:FireClient(player, false, "prompt_failed", assetId, ugcData.name)
			end)
			return
		end

		print(string.format("✅ UGC RÉSERVÉ + PERSISTÉ: %s → %s (-%d pts, reste %d)",
			player.Name, ugcData.name, ugcData.price, totalPoints))
	end)

	if not success then
		warn("❌ ERREUR ACHAT UGC (AssetId: " .. tostring(assetId) .. "): " .. tostring(err))
	end
end)

-- Tracker pour rapport (peut servir aux logs)
local exploitUGCAcquisitions = {}

MarketplaceService.PromptPurchaseFinished:Connect(function(player, assetId, wasPurchased)
	if not player then return end
	local userId = player.UserId
	local purchaseKey = userId .. "_" .. assetId
	local pendingPurchase = pendingUGCPurchases[purchaseKey]

	-- ════════════════════════════════════════════════════════
	-- 🚨 DÉTECTION D'EXPLOIT : UGC du shop acquise hors-système
	-- ════════════════════════════════════════════════════════
	if wasPurchased and not pendingPurchase and UGC_ITEMS[assetId] then
		-- ✅ ANTI-FAUX-BAN : le joueur a laissé le prompt ouvert >5 min → le worker a
		-- remboursé → il finit son achat après coup. Ce n'est PAS un exploit :
		-- on re-déduit les points au lieu de bannir.
		-- 🔐 L'escrow tranche : créance ouverte (ou remboursement de moins de
		-- 15 min) → régularisation avec re-déduction ou dette.
		-- Sinon il TRACE l'événement et rend la main sans sanctionner.
		if _G.UGCEscrow then
			_G.UGCEscrow.OnUnknownPurchase(player, assetId)
			return
		end

		-- ⚠️ Conséquence : le bloc de ban qui suit (`local ugcInfo = UGC_ITEMS[assetId]`
		--    … `return end`) devient INATTEIGNABLE. C'est VOULU.
		--
		--    Il bannissait sur trois situations qui ne sont pas des exploits :
		--      • un double-fire de PromptPurchaseFinished après un achat parfaitement
		--        légitime (Roblox le fait régulièrement) ;
		--      • un joueur qui possédait déjà l'UGC avant l'installation de l'escrow ;
		--      • un événement d'achat falsifié côté client, que n'importe qui peut
		--        envoyer sans rien acheter.
		--
		--    Les vraies acquisitions hors shop sont maintenant constatées par l'audit
		--    24 h, qui compare l'inventaire réel au registre. Elles apparaissent en
		--    🌐 Hors shop dans l'admin panel avec +2 de suspicion, et c'est TOI qui
		--    bannis. Zéro ban automatique sur une situation ambiguë.
		--
		--    Tu peux laisser le bloc en place (il ne s'exécutera jamais) ou le supprimer.

		local ugcInfo = UGC_ITEMS[assetId]
		local now = os.time()

		exploitUGCAcquisitions[userId] = exploitUGCAcquisitions[userId] or {}
		table.insert(exploitUGCAcquisitions[userId], {
			timestamp = now,
			assetId = assetId,
			name = ugcInfo.name,
			price = ugcInfo.price,
		})

		warn(string.format(
			"🚨🚨🚨 EXPLOIT UGC DIRECT | Joueur: %s (ID: %d) | UGC: %s (AssetID: %d) | Prix shop: %d pts",
			player.Name, userId, ugcInfo.name, assetId, ugcInfo.price
			))
		if _G.UGCRedeem_LogExploit then
			_G.UGCRedeem_LogExploit(userId, assetId,
				string.format("PromptPurchase direct hors shop (prix shop %d pts) → ban", ugcInfo.price))
		end
		AntiExploit.bannedPlayers[userId] = true

		if _G.BanManager then
			pcall(function()
				_G.BanManager.Log({
					userId = userId, reason = "ugc",
					details = string.format("UGC '%s' (AssetID %d, %d pts) hors shop",
						ugcInfo.name, assetId, ugcInfo.price),
					action = "ban", name = player.Name, by = "UGCExploit",
				})
			end)
		end

		task.spawn(function()
			local banStore = DataStoreService:GetDataStore("BannedPlayers")
			pcall(function()
				banStore:SetAsync(tostring(userId), {
					reason = "UGC_DIRECT_EXPLOIT",
					details = string.format(
						"UGC '%s' (AssetID %d, prix %d pts) acquise sans passer par le shop",
						ugcInfo.name, assetId, ugcInfo.price
					),
					timestamp = now,
					playerName = player.Name,
					allAcquisitions = exploitUGCAcquisitions[userId],
				})
			end)
		end)

		AntiExploit.infractions[userId] = AntiExploit.CONFIG.BAN_THRESHOLD

		if player.Parent then
			player:Kick("🚫 UGC exploitation detected. Permanent ban.")
		end
		return
	end

	if not pendingPurchase then return end

	if pendingPurchase.processed then
		warn(string.format("⚠️ PromptPurchaseFinished double-fire ignoré pour %s (%s)",
			player.Name, pendingPurchase.name))
		return
	end
	pendingPurchase.processed = true
	pendingUGCPurchases[purchaseKey] = nil

	-- 🔐 Plus AUCUN appel PlayerOwnsAsset ici : la réponse serait mise en cache
	-- et donc fausse. Plus aucun remboursement non plus.
	if not _G.UGCEscrow then
		warn(string.format("🚨 [UGC] _G.UGCEscrow absent — %d pts gelés pour %s. À résoudre à la main.",
			pendingPurchase.price, player.Name))
		return
	end

	if wasPurchased then
		_G.UGCEscrow.Confirm(player, assetId, "shop")

		-- 📢 Annonce globale dans le chat
		if _G.NotifyUGC then
			pcall(function()
				_G.NotifyUGC(userId, player.Name, pendingPurchase.name, pendingPurchase.price)
			end)
		end
	else
		-- L'escrow attend 8 s puis fait le PREMIER appel de possession de la
		-- session (non caché, donc fiable) avant de décider quoi que ce soit.
		_G.UGCEscrow.OnPromptFailed(player, assetId)
	end

	-- ⚠️ La table `recentPurchases` n'est plus utilisée nulle part.
	--    Tu peux supprimer sa déclaration et toutes ses écritures.
end)

