-- ✅ Merge-max : un timestamp de claim ne peut jamais RECULER
local function mergeQuestHistory(userId, incoming)
	if type(incoming) ~= "table" then return end
	AntiExploit.questHistory[userId] = AntiExploit.questHistory[userId] or {}
	local h = AntiExploit.questHistory[userId]
	for qName, ts in pairs(incoming) do
		if type(ts) == "number" and (not h[qName] or ts > h[qName]) then
			h[qName] = ts
		end
	end
end

