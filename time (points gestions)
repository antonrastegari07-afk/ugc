function Settings.default()
	local t = {}
	for name, spec in pairs(Settings.schema) do t[name] = spec.default end
	return t
end

function Settings.sanitize(name, value)
	local spec = Settings.schema[name]
	if not spec then return nil end
	if spec.kind == "bool" then
		if type(value) ~= "boolean" then return nil end
		return value
	elseif spec.kind == "percent" then
		if type(value) ~= "number" or value ~= value then return nil end
		return math.clamp(math.floor(value), 0, 100)
	elseif spec.kind == "range" then
		if type(value) ~= "number" or value ~= value then return nil end
		return math.clamp(math.floor(value + 0.5), spec.min, spec.max)
	end
	return nil
end

-- Mémoire → attributs joueur (le client relit ses réglages)
function Settings.apply(player)
	local s = Settings.data[player.UserId]
	if not s then return end
	for name, spec in pairs(Settings.schema) do
		local v = s[name]
		if v == nil then v = spec.default end
		player:SetAttribute(name, v)
	end
end

-- Anti-flood doux (sliders) : drop silencieux >15 changements/s, AUCUNE infraction
function Settings.rateOk(userId)
	local now = os.time()
	local rl = Settings.rate[userId]
	if not rl or now - rl.windowStart >= 1 then
		Settings.rate[userId] = { count = 1, windowStart = now }
		return true
	end
	rl.count += 1
	return rl.count <= 15
end

