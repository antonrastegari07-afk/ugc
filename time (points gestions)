local function isFriendCached(player, otherPlayer)
	if not player or not otherPlayer then return false end

	local userId = player.UserId
	local otherId = otherPlayer.UserId

	-- Vérifier cache
	if friendsCache[userId] and friendsCache[userId][otherId] ~= nil then
		return friendsCache[userId][otherId]
	end

	-- Initialiser cache
	if not friendsCache[userId] then
		friendsCache[userId] = {}
	end

	-- Vérifier avec API
	local success, isFriend = pcall(function()
		return player:IsFriendsWith(otherId)
	end)

	if success then
		friendsCache[userId][otherId] = isFriend
		return isFriend
	end

	return false
end

-- ✅ OPTIMISÉ : Recompte avec cache intelligent
local function countFriendsInGame(player, forceRecount)
	if not player or not player.Parent then return 0 end

	local userId = player.UserId
	local now = os.time()

	-- ✅ Respecter le cache SI pas forcé
	if not forceRecount and friendCountCache[userId] and lastFriendCheck[userId] then
		if (now - lastFriendCheck[userId]) < FRIEND_CACHE_DURATION then
			return friendCountCache[userId]
		end
	end

	local friendCount = 0
	local allPlayers = Players:GetPlayers()

	for _, otherPlayer in ipairs(allPlayers) do
		if otherPlayer ~= player and otherPlayer.Parent then
			if isFriendCached(player, otherPlayer) then
				friendCount = friendCount + 1
			end
		end
	end

	friendCountCache[userId] = friendCount
	lastFriendCheck[userId] = now

	return friendCount
end

