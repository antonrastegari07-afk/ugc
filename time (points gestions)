-- ✅ Charger les données de kill d'un joueur
local function loadKillData(userId)

	killQuestCooldowns[userId] = killQuestCooldowns[userId]  -- laissé tel quel, sera chargé ensuite

	-- ✅ Si reload prévu, attendre que le snapshot soit restauré
	if recentReloads[userId] then
		local waited = 0
		while playerKillCount[userId] == nil and waited < 30 do
			task.wait(0.1)
			waited = waited + 1
		end
	end

	if playerKillCount[userId] ~= nil then
		print(string.format("ℹ️ Kill data déjà restaurée depuis SessionLock pour %d (%d/%d kills), skip",
			userId, playerKillCount[userId], MAX_KILLS))
		-- Charger le flag claim si pas encore chargé
		-- Charger le cooldown 24h si pas encore chargé
		-- ✅ FIX : TOUJOURS lire le store dédié et prendre le MAX avec le
		-- snapshot (un cooldown de claim ne peut jamais reculer)
		do
			local okQ, claimedData = pcall(function()
				return KILL_QUEST_COOLDOWN_STORE:GetAsync("kq_" .. userId)
			end)
			local fromStore = (okQ and type(claimedData) == "number") and claimedData or 0
			killQuestCooldowns[userId] = math.max(killQuestCooldowns[userId] or 0, fromStore)
			print(string.format("📊 KillQuest cooldown (max snapshot/store): fin dans %ds",
				math.max(0, killQuestCooldowns[userId] - os.time())))
		end
		-- 🛡️ FIX 2 : cross-check du cooldown 9h (100 kills) depuis le store dédié.
		-- Ferme la fenêtre stale-unifié : si le secureSave posant le cooldown 9h a échoué
		-- pile au 100e kill, l'unifié montre cooldown=0 → le joueur pourrait re-kill (farm).
		-- On adopte le cooldown du store dédié UNIQUEMENT s'il est encore actif (> now),
		-- donc jamais de faux-blocage d'un joueur légitime.
		do
			local okK, kData = pcall(function()
				return killCooldownStore:GetAsync("kills_" .. userId)
			end)
			if okK and type(kData) == "table" then
				local storeCd = tonumber(kData.cooldownEnd) or 0
				if storeCd > os.time() and storeCd > (playerKillCooldown[userId] or 0) then
					playerKillCooldown[userId] = storeCd
					playerKillCount[userId]    = math.max(playerKillCount[userId] or 0, tonumber(kData.killCount) or 0)
					warn(string.format("🛡️ Cooldown 9h corrigé depuis store dédié pour %d (unifié périmé, anti-farm)", userId))
				end
			end
		end
	else
		local key = "kills_" .. userId

		-- ✅ Retry 2x (suffisant, le failsafe gère les cas extrêmes)
		local loaded = false
		local data = nil
		for attempt = 1, 2 do
			local success, result = pcall(function()
				return killCooldownStore:GetAsync(key)
			end)
			if success then
				data = result
				loaded = true
				break
			end
			warn(string.format("⚠️ loadKillData tentative %d/2 échouée pour UserID %d", attempt, userId))
			task.wait(0.6)
		end

		if not loaded then
			-- ❌ DataStore down : NE PAS setter à 0 (sinon écrase en unified)
			-- Laisser nil → isAllSecondaryLoaded bloque secureSave + giveKillPoints skip aussi
			warn(string.format("🚨 CRITIQUE: loadKillData a échoué après retries pour UserID %d — valeurs laissées nil (saves + kills bloqués)", userId))
			-- Réessayer en arrière-plan dans 30s
			task.spawn(function()
				task.wait(30)
				if Players:GetPlayerByUserId(userId) then
					loadKillData(userId)
					local pl = Players:GetPlayerByUserId(userId)
					if pl then updateKillUI(pl) end
				end
			end)
			return
		end

		if data then
			playerKillCount[userId]    = data.killCount or 0
			playerKillCooldown[userId] = data.cooldownEnd or 0
			killQuestProgress[userId]  = data.questProgress or 0

			-- Charger le flag claim (avec retry léger aussi)
			local claimedData
			for attempt = 1, 2 do
				local okQ, result = pcall(function()
					return KILL_QUEST_COOLDOWN_STORE:GetAsync("kq_" .. userId)
				end)
				if okQ then
					claimedData = result
					break
				end
				task.wait(0.5)
			end

			if claimedData ~= nil then
				if type(claimedData) == "number" then
					killQuestCooldowns[userId] = claimedData
				else
					-- Migration ancien format boolean → repart propre
					killQuestCooldowns[userId] = 0
				end
			else
				killQuestCooldowns[userId] = 0
			end

			local now = os.time()
			-- Si cooldown 9h expiré → reset kills (cooldown 24h de la quest est indépendant)
			if playerKillCooldown[userId] > 0 and now >= playerKillCooldown[userId] then
				playerKillCount[userId]   = 0
				playerKillCooldown[userId] = 0
				print(string.format("✅ Cooldown 100-kills terminé pour UserID %d, compteur reset", userId))
			end

		else
			-- Pas de data = vrai nouveau joueur
			playerKillCount[userId]    = 0
			playerKillCooldown[userId] = 0
			killQuestCooldowns[userId] = 0
			killQuestProgress[userId]  = 0
			print(string.format("ℹ️ Nouveau joueur kill data: UserID %d", userId))
		end
	end

	-- ✅ NOUVEAU : Charger le total lifetime des kills
	local okTotal, storedTotal = pcall(function()
		return totalKillStore:GetAsync(tostring(userId))
	end)
	playerTotalKills[userId] = (okTotal and storedTotal) or 0

	local player = Players:GetPlayerByUserId(userId)
	if player then
		player:SetAttribute("TotalKills", playerTotalKills[userId])
	end

	print(string.format("📊 Total kills chargé: UserID %d → %d kills lifetime", userId, playerTotalKills[userId]))
end
