function SmartAntiCheat.AnalyzeRecentHistory(userId, timeWindow)
	local data = SmartAntiCheat.playerData[userId]
	if not data then 
		return {total = 0, sources = {}, hasSuspicious = false, hasDevProduct = false, hasQuest = false, devProductPoints = 0, questPoints = 0}
	end

	if not data.pointsHistory or type(data.pointsHistory) ~= "table" then
		warn(string.format("⚠️ pointsHistory invalide dans AnalyzeRecentHistory pour %d", userId))
		data.pointsHistory = {}
		return {total = 0, sources = {}, hasSuspicious = false, hasDevProduct = false, hasQuest = false, devProductPoints = 0, questPoints = 0}
	end

	local now = os.time()
	local cutoff = now - timeWindow

	local result = {
		total = 0,
		sources = {},
		hasSuspicious = false,
		hasDevProduct = false,
		hasQuest = false,
		devProductPoints = 0,
		questPoints = 0,
	}

	-- ✅ OPTIMISATION RADICALE: Itération directe SANS copie
	local historySize = #data.pointsHistory
	local checkLimit = math.min(10, historySize) -- ✅ Limiter à 10 événements max

	for i = historySize, math.max(1, historySize - checkLimit + 1), -1 do
		local event = data.pointsHistory[i]

		if not event or type(event) ~= "table" then
			continue
		end

		if not event.timestamp or type(event.timestamp) ~= "number" then
			continue
		end

		if event.timestamp < cutoff then
			break -- ✅ CRITIQUE: Arrêter dès qu'on dépasse la fenêtre
		end

		local points = event.points or 0
		if type(points) == "number" and points > 0 then
			result.total = result.total + points
		end

		local source = event.source or "unknown"
		result.sources[source] = (result.sources[source] or 0) + 1

		if source:match("DevProduct") then
			result.hasDevProduct = true
			result.devProductPoints = result.devProductPoints + points
		end

		if source:match("Quest") or source:match("Rebirth") then
			result.hasQuest = true
			result.questPoints = result.questPoints + points
		end
	end

	return result
end



