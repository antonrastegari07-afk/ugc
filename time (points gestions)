-- ========================================
-- 👑 RÉCONCILIATION DU COOLDOWN AVEC LA LIMITE
--
-- Le cooldown 24h est posé quand le compteur atteint la limite EN VIGUEUR À
-- CE MOMENT-LÀ. S'il a été posé à 100 puis que le joueur devient VIP (limite
-- 150), le cooldown n'a plus aucune raison d'exister : il lui reste 50 kills.
--
-- 🔒 Pourquoi c'est sûr :
--   • on ne lève JAMAIS un cooldown tant que killCount >= limite actuelle ;
--   • le joueur ne peut pas faire BAISSER son killCount (serveur uniquement) ;
--   • il ne peut pas faire MONTER sa limite sans que le VIPManager le déclare
--     VIP (gamepass acheté, VIP offert ou cadeau) — décision 100 % serveur ;
--   • perdre le VIP fait redescendre la limite : 130 kills >= 100 → le
--     cooldown est conservé, aucun kill offert.
--   • saveKillData écrit AUSSI le store dédié, sinon le cross-check anti-farm
--     de loadKillData ré-imposerait le vieux cooldown au prochain join.
-- ========================================
function _G.VIPKills.syncCooldown(userId)
	if playerKillCount[userId] == nil or playerKillCooldown[userId] == nil then
		return false   -- données pas chargées : on ne touche à rien
	end

	local now = os.time()
	local cd  = playerKillCooldown[userId] or 0
	local max = _G.VIPKills.get(userId)

	if cd <= 0 then return false end

	-- CAS 1 — le cooldown est ARRIVÉ À TERME : nouveau cycle quotidien.
	-- Sans ça, le compteur reste collé à la limite et le check suivant
	-- repose immédiatement un cooldown de 24 h → le joueur ne peut plus
	-- jamais kill. Le reset n'existait qu'au join et dans un task.delay
	-- qui ne survit pas à une déconnexion ou à un restart de serveur.
	if now >= cd then
		playerKillCount[userId]    = 0
		playerKillCooldown[userId] = 0
		saveKillData(userId)
		print(string.format("🔄 Cycle kills réinitialisé pour %d (cooldown terminé) → 0/%d",
			userId, max))
		return true
	end

	-- CAS 2 — cooldown encore actif MAIS la limite a monté (passage VIP) et
	-- le joueur est repassé SOUS sa limite : le cooldown n'a plus lieu d'être.
	-- 🔒 jamais levé tant que killCount >= limite, et le joueur ne peut ni
	--    baisser son compteur ni monter sa limite sans le VIP (100 % serveur).
	if playerKillCount[userId] < max then
		playerKillCooldown[userId] = 0
		saveKillData(userId)
		print(string.format("👑 Cooldown kills levé pour %d : limite montée à %d (compteur %d)",
			userId, max, playerKillCount[userId]))
		return true
	end

	return false
end

-- ✅ Fonction principale: donner des points pour un kill
local function giveKillPoints(player, points)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local now = os.time()

	-- Vérifier si les données sont chargées
	if playerKillCount[userId] == nil then
		warn(string.format("⚠️ Kill data pas encore chargée pour %s, skip", player.Name))
		return
	end


	-- ✅ TOTAL LIFETIME : incrémenté AVANT les checks cooldown/limite
	-- → le leaderboard continue de monter même quand le joueur a fini ses 100 kills.
	-- (Les POINTS et la progression quest restent bloqués par le cooldown plus bas.)
	-- Garde sur ~= nil pour ne pas écraser le total pendant le chargement.
	if playerTotalKills[userId] ~= nil then
		playerTotalKills[userId] = playerTotalKills[userId] + 1
		player:SetAttribute("TotalKills", playerTotalKills[userId])
		totalKillsDirty[userId] = true                     -- ✅ FIX FLUSH
		local lastSave = lastTotalKillStoreSave[userId] or 0
		if now - lastSave >= 10 then
			lastTotalKillStoreSave[userId] = now
			totalKillsDirty[userId] = nil                  -- ✅ écrit juste après
			local snap = playerTotalKills[userId]
			task.spawn(function()
				pcall(function()
					totalKillStore:SetAsync(tostring(userId), snap)
				end)
			end)
		end
	end

	-- ✅ PROGRESSION QUEST (25 kills) : avance AVANT les checks cap/cooldown de points
	-- → le joueur peut finir et claim sa quest même après ses 100 kills/jour.
	-- Toujours gardée par le cooldown 24h propre à la quest (inchangé).
	if killQuestProgress[userId] ~= nil then
		local qCooldownEnd = killQuestCooldowns[userId] or 0
		if now >= qCooldownEnd and (killQuestProgress[userId] or 0) < KILL_QUEST_REQUIRED then
			killQuestProgress[userId] = (killQuestProgress[userId] or 0) + 1

			-- Persistance throttlée (la progression va aussi dans le payload unifié).
			-- Save immédiat à l'atteinte de l'objectif pour fiabiliser l'état "claimable".
			local reachedGoal = killQuestProgress[userId] >= KILL_QUEST_REQUIRED
			local lastSave = lastKillQuestSave[userId] or 0
			if reachedGoal or (now - lastSave) >= 8 then
				lastKillQuestSave[userId] = now
				saveKillData(userId)
			end
		end
	end

	-- 👑 le cooldown ne vaut que pour la limite avec laquelle il a été posé
	_G.VIPKills.syncCooldown(userId)

	-- Vérifier cooldown
	if playerKillCooldown[userId] and now < playerKillCooldown[userId] then
		local timeLeft = playerKillCooldown[userId] - now
		print(string.format("⏰ %s est en cooldown kill (%.1fh restantes)", 
			player.Name, timeLeft / 3600))
		updateKillUI(player)
		return
	end


	-- Vérifier limite de kills (100 normal / 150 VIP)
	if playerKillCount[userId] >= _G.VIPKills.get(userId) then
		-- Activer le cooldown
		playerKillCooldown[userId] = now + KILL_COOLDOWN
		saveKillData(userId)
		updateKillUI(player)

		print(string.format("🚫 %s a atteint la limite de %d kills, cooldown de 9h activé", 
			player.Name, MAX_KILLS))
		return
	end

	-- ✅ KILL VALIDE - Donner les points
	local finalPoints = points

	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, finalPoints, "Kill")

	tempsJoueurs[userId].future = tempsJoueurs[userId].future + finalPoints

	-- ✅ Toujours incrémenter le compteur de session (pour limite 100 kills → cooldown 9h)
	playerKillCount[userId] = playerKillCount[userId] + 1

	-- ✅ Progression quest déjà incrémentée en haut de giveKillPoints
	-- (avant les checks cap/cooldown) → pas de double comptage ici.

	-- ✅ Total lifetime déjà incrémenté en haut de giveKillPoints (avant les checks cooldown)
	-- → ne plus l'incrémenter ici pour éviter le double comptage.

	-- Sauvegarder la session (cooldown)
	saveKillData(userId)

	-- Enregistrement anti-cheat
	SmartAntiCheat.RecordGain(player, finalPoints, "Kill")

	-- Mettre à jour l'UI
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value = applyAllBonuses(calculatePoints(totalPoints), player)
		player:SetAttribute("Points", pointsStat.Value)

		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = pointsStat.Value
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end
	end

	task.spawn(function()
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		secureSave(userId, totalPoints)
	end)

	pcall(function()
		bonusEvent:FireClient(player)
	end)

	updateKillUI(player)

	print(string.format("✅ KILL: %s → +%d pts (%d/%d kills session | %d kills total)", 
		player.Name, finalPoints, playerKillCount[userId], MAX_KILLS, playerTotalKills[userId]))

	-- Si on atteint la limite, activer le cooldown
	if playerKillCount[userId] >= _G.VIPKills.get(userId) then
		playerKillCooldown[userId] = now + KILL_COOLDOWN
		saveKillData(userId)

		-- ✅ NOUVEAU : planifier le reset du flag claim quand le cooldown 9h expire
		-- (Sera aussi reset au join via loadKillData si le joueur revient après)
		task.delay(KILL_COOLDOWN, function()
			if playerKillCount[userId] then
				playerKillCount[userId]   = 0
				playerKillCooldown[userId] = 0
				saveKillData(userId)
				local pl = Players:GetPlayerByUserId(userId)
				if pl and pl.Parent then
					updateKillUI(pl)
					print(string.format("🔄 Cycle 100-kills reset automatique pour %s", pl.Name))
				end
			end
		end)

		updateKillUI(player)

		print(string.format("🚫 %s a atteint la limite de %d kills, cooldown de 9h activé", 
			player.Name, MAX_KILLS))
	end
end

local function monitorCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end

	humanoid.Died:Connect(function()
		local tag = humanoid:FindFirstChild("creator")
		if not (tag and tag.Value and tag.Value:IsA("Player")) then return end

		local killer = tag.Value
		local victim = Players:GetPlayerFromCharacter(character)

		-- 🛡️ Un joueur ne se paie pas ses propres morts.
		if victim and killer.UserId == victim.UserId then
			warn(string.format("🚫 [KILL] Auto-kill ignoré pour %s", killer.Name))
			return
		end

		giveKillPoints(killer, KILL_POINTS)
	end)
end

