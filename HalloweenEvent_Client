			if v.weekly then weeklyT.Text = padTime(v.weekly.started and (v.weekly.ends - t) or 7 * 86400) end
			local weekOver = v.weekly and v.weekly.started and t >= v.weekly.ends + 1
			if isOpen and ((v.daily and t >= v.daily.ends + 1) or weekOver) and (not v._asked or os.clock() - v._asked > 5) then
				v._asked = os.clock()
				task.spawn(function() local nv = StateRF:InvokeServer() if nv then view = nv refresh() end end)
			end
		end
	end
end)

