local function givenText(g)
	local out = {}
	for _, x in ipairs(g or {}) do
		if x.Kind == "points" then table.insert(out, "+" .. commas(x.Amount) .. " points")
		elseif x.Kind == "spins" then table.insert(out, "+" .. x.Amount .. " spins")
		elseif x.Kind == "boost" then table.insert(out, ("x%d boost for %d min"):format(x.Mult or 2, (x.Duration or 0) // 60))
		elseif x.Kind == "tool" then table.insert(out, (x.Tool or "Tool") .. " (yours forever!)")
		elseif x.Kind == "scythe" then
			table.insert(out, x.Serial == "DEV" and "Jack's Scythe DEV" or x.Serial and ("Jack's Scythe #" .. tostring(x.Serial)) or "Jack's Scythe")
		end
	end
	return table.concat(out, " · ")
end

