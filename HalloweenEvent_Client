local lastTab = nil
local shownCoins, coinAnim = nil, 0
-- solde : nombre complet, qui défile quand il change (fenêtre ouverte)
local function setCoins(n)
	n = math.floor(n)
	if shownCoins == nil or not isOpen or shownCoins == n then
		shownCoins = n
		coinL.Text = commas(n)
		return
	end
	coinAnim += 1
	local id, from, t0 = coinAnim, shownCoins, os.clock()
	shownCoins = n
	task.spawn(function()
		while coinAnim == id and os.clock() - t0 < 0.45 do
			coinL.Text = commas(from + (n - from) * smooth((os.clock() - t0) / 0.45))
			task.wait()
		end
		if coinAnim == id then coinL.Text = commas(n) end
	end)
end
refresh = function()
	for name, t in pairs(tabBtns) do recolor(t.grad, t.edge, name == tab and COL.green or COL.dark) end
	rewardsPage.Visible = tab == "Rewards"
	questsPage.Visible = tab == "Quests"
	local v = view
	cover.Visible = not v or v.loading == true
	testBar.Visible = v ~= nil and v.tester == true
	if not v or v.loading then return end
	setCoins(v.coins or 0)
	if tab ~= lastTab then
		lastTab = tab
		local page = tab == "Rewards" and rewardsPage or questsPage
		page.Position = UDim2.fromOffset(0, 10)
		tween(page, 0.22, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quad)
	end

	-- 🏆 cartes
	for i, c in ipairs(cards) do
		local tier = TIERS[i]
		local own = v.owned and v.owned[i]
		local isNext = v.nextTier == i
		local afford = (v.coins or 0) >= (tier.Cost or 0)
		c.lock.Visible = not own
		c.lock.BackgroundTransparency = isNext and 0.62 or 0.45
		c.lockIcon.Visible = not own and not isNext
		c.owned.Visible = own
		c.nameL.TextTransparency = own and 0 or (isNext and 0.1 or 0.45)
		c.boxStroke.Color = own and Color3.fromRGB(110, 230, 140) or (isNext and afford and v.active) and Color3.fromRGB(80, 235, 110)
			or isNext and ORANGE or Color3.fromRGB(150, 150, 160)
		c.boxStroke.Thickness = isNext and 4.5 or 3.5
		local sy = (i == SCYTHE_I) and v.scythe or nil
		local soldOut = sy ~= nil and sy.left == 0 and not sy.mine and not own
		c.icon.Visible = not own and not soldOut
		if own then
			recolor(c.grad, c.edge, COL.green)
			centerRow(nil, c.priceL, "OWNED", 30, 0, 0)
		elseif soldOut then
			recolor(c.grad, c.edge, COL.dark)
			centerRow(nil, c.priceL, "SOLD OUT", 30, 0, 0)
		else
			recolor(c.grad, c.edge, (isNext and afford and v.active) and COL.green or COL.dark)
			centerRow(c.icon, c.priceL, commas(tier.Cost or 0), 30, 34, 8)
		end
		c.baseStroke = c.boxStroke.Color
		-- 📦 stock de la faux
		if c.stockL then
			local pill = c.stockL.Parent
			pill.Visible = sy ~= nil and sy.stock ~= nil and not own
			if pill.Visible then
				if sy.left == nil then c.stockL.Text = "LIMITED: " .. commas(sy.stock)
				elseif soldOut then c.stockL.Text = "SOLD OUT"
				else c.stockL.Text = commas(sy.left) .. " / " .. commas(sy.stock) .. " LEFT!" end
				if soldOut then c.stockL.TextColor3 = Color3.fromRGB(255, 110, 100) end
			end
		end
		if i == SCYTHE_I and eff.viewHint then eff.viewHint.Visible = not own end
	end
	-- 👉 petite flèche vers la faux : la 1re fois seulement, tant que la faux n'est pas à l'écran
	local sc = SCYTHE_I and cards[SCYTHE_I]
	hintB.Visible = UI.ScytheHint ~= false and not hintDone and v.hint ~= true and tab == "Rewards" and sc ~= nil
		and not (v.owned and v.owned[SCYTHE_I]) and not scytheInView()
	if hintB.Visible == false and v.hint == true then hintDone = true end
	-- ⏩ skip
	SKIPS = skipList()
	local left = 0
	for i, tier in ipairs(TIERS) do
		if not (v.owned and v.owned[i]) and (C.Robux.SkipCanBuyFinal ~= false or i < #TIERS) then left += 1 end
	end
	local avail = {}
	for _, s in ipairs(SKIPS) do if s.Count <= left then table.insert(avail, s) end end
	skipBar.Visible = #avail > 0 and v.active
	skipIndex = math.clamp(skipIndex, 1, math.max(1, #SKIPS))
	while skipIndex > 1 and SKIPS[skipIndex].Count > left do skipIndex -= 1 end
	local s = SKIPS[skipIndex]
	if s then
		-- testeur : « TEST » = gratuit (produit pas créé, avant l'event ou Studio) ; sinon icône Robux + prix
		local free = v.testFree and ((tonumber(s.ProductId) or 0) <= 0 or v.testAllFree)
		skipRobux.Visible = not free
		centerRow(skipRobux, skipPrice, free and "TEST" or commas(priceOf(s)), 36, 32, 8)
		skipCount.Text = "SKIP TIER: " .. s.Count
	end

	-- 📜 quêtes
	local free = v.free or 0
	rerollInfo.Text = free > 0 and ("🔄 NEW QUESTS: " .. free .. " free refresh today (replaces all quests of a section)") or
		((v.credits or 0) > 0 and ("🔄 NEW QUESTS: " .. v.credits .. " refresh(es) left") or "🔄 Free refresh used today — back tomorrow!")
	rerollInfo.Visible = v.active == true
	-- 🔄 boutons NEW QUESTS (un par section) : prix + pulse quand toute la section est réclamée
	local robuxOk = C.Robux and C.Robux.RerollQuest and (tonumber(C.Robux.RerollQuest.ProductId) or 0) > 0
	for which, rb in pairs(refreshBtns) do
		local list = (v[which] and v[which].list) or {}
		rb.slot.Visible = v.active == true and #list > 0
		local allClaimed = #list > 0
		for _, e in ipairs(list) do if not e.c then allClaimed = false end end
		rb.pulse = allClaimed
		rb.tagIcon.Visible = false
		rb.tagF.Visible = true
		if free > 0 then rb.tagL.Text = "FREE"
		elseif (v.credits or 0) > 0 then rb.tagL.Text = "x" .. v.credits
		elseif v.testFree and (not robuxOk or v.testAllFree) then rb.tagL.Text = "TEST"
		elseif robuxOk then
			rb.tagIcon.Visible = true
			centerRow(rb.tagIcon, rb.tagL, tostring(priceOf(C.Robux.RerollQuest)), 16, 16, 4)
		else rb.tagF.Visible = false end
		if not rb.tagIcon.Visible then
			rb.tagL.AnchorPoint, rb.tagL.Position, rb.tagL.Size = Vector2.zero, UDim2.new(), UDim2.fromScale(1, 1)
			rb.tagL.TextXAlignment = Enum.TextXAlignment.Center
		end
	end
	for _, which in ipairs({ "daily", "weekly" }) do
		local list = (v[which] and v[which].list) or {}
		for i, e in ipairs(list) do fillQuest(rowFor(which, i), which, e) end
		for i = #list + 1, #rows[which] do rows[which][i].row.Visible = false end
	end
	-- « ! » sur l'onglet Quests : au moins une quête finie pas encore réclamée
	local claimable = false
	for _, which in ipairs({ "daily", "weekly" }) do
		for _, e in ipairs((v[which] and v[which].list) or {}) do
			local def = QDEF[e.id]
			if def and not e.c and e.n >= ((TIME_KINDS[def.Kind] and def.Goal * 60) or def.Goal) then claimable = true end
		end
	end
	questDot.Visible = claimable and v.active == true
	if scytheInfo.refresh then scytheInfo.refresh() end
	local nt = v.nextTier and TIERS[v.nextTier]
	rewardsDot.Visible = v.active == true and nt ~= nil and (v.coins or 0) >= (nt.Cost or 0)
		and not (v.nextTier == SCYTHE_I and v.scythe and v.scythe.left == 0 and not v.scythe.mine)
	local jl = v.jack or {}
	jackH.Visible = #jl > 0
	jackT.Text = ""
	for i, j in ipairs(jl) do fillJack(rowFor("jack", i), j) end
	for i = #jl + 1, #rows.jack do rows.jack[i].row.Visible = false end
end

