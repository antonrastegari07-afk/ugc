local promptsHidden = false
PushRE.OnClientEvent:Connect(function(kind, data)
	data = data or {}
	if kind == "view" then
		view = data
		if data.hidden then
			if not promptsHidden then promptsHidden = true hidePrompts() end
			close()
			return
		end
		if not data.loading and shown == 0 then shown = data.coins or 0 end
		if isOpen then refresh() end
	elseif kind == "coinAdd" then
		if type(data.P) == "table" and not coins[data.Id] then
			coins[data.Id] = buildCoin(data.Id, Vector3.new(data.P[1], data.P[2], data.P[3]))
		end
	elseif kind == "coinClear" then
		for id in pairs(coins) do
			if coins[id].state ~= "dive" then removeCoin(id, true) end
		end
	elseif kind == "coinOk" then
		if data.Id then
			pickPending[data.Id] = nil
			local rec = coins[data.Id]
			if rec then rec.confirmed = true if rec.state == "idle" then rec.state = "hover" rec.riseFrom = rec.model:GetPivot() end end
		end
		if view and data.Total then view.coins = data.Total end
		hudGain(data.Add or 0, data.Total or 0, data.Got, data.Cap)
		if data.Jack then toast("+" .. commas(data.Add or 0) .. " " .. ((C.Coin and C.Coin.Name) or "Halloween Coins"), "Jack's reward!") end
		if isOpen then refresh() end
	elseif kind == "coinNo" then
		local rec = coins[data.Id]
		pickPending[data.Id] = nil
		if rec then
			if data.Gone then removeCoin(data.Id, true)
			elseif rec.state ~= "dive" then
				rec.state = "back" rec.backT0 = os.clock() rec.backFrom = rec.model:GetPivot() rec.cool = os.clock() + 2.5
			end
		end
	elseif kind == "toast" then
		if data.Kind == "quest" then
			toast("Quest complete!", ((data.Text or ""):gsub("{N}", tostring(data.Goal or ""))) .. " · claim " .. commas(data.Reward or 0) .. " coins!")
			sound("Claim", 0.35)
		else
			toast(data.Text or "", nil, data.Kind == "error")
		end
	elseif kind == "claimed" then
		sound("Claim", 0.55)
		toast("+" .. commas(data.Amount or 0) .. " " .. ((C.Coin and C.Coin.Name) or "Halloween Coins"), "Quest reward claimed!")
	elseif kind == "rerolled" then
		sound("Open", 0.4)
		toast("New quests!", (data.Which == "weekly" and "Your weekly quests" or "Your daily quests") .. " were refreshed.")
		for _, r in ipairs(rows[data.Which] or {}) do
			r.row.BackgroundColor3 = PURPLE
			r.row.BackgroundTransparency = 0.2
			tween(r.row, 0.6, { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45 })
		end
	elseif kind == "reward" then
		if not isOpen then open("Rewards") end
		table.insert(modalQueue, data)
		showNextModal()
	elseif kind == "needRobux" then
		local rr = C.Robux and C.Robux.RerollQuest
		if rr and (tonumber(rr.ProductId) or 0) > 0 then
			ActionRE:FireServer("rerollBuy", data.Which)
		else
			toast("No free refresh left today", "Come back tomorrow for new quests!", true)
		end
	end
end)

