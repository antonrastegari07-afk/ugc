			local t = serverNow()
			if t < (v.start or 0) then timerL.Text = (UI.StartsIn or "Event Starts In: ") .. longTime(v.start - t)
			elseif t < (v.finish or 0) then timerL.Text = (UI.EndsIn or "Event Ends In: ") .. longTime(v.finish - t)
			else timerL.Text = UI.Ended or "The event has ended!" end
			if v.tester and not v.realActive then timerL.Text = timerL.Text .. "  (TEST MODE)" end
			if v.daily then dailyT.Text = padTime(v.daily.ends - t) end
