local robuxPrice = {}
local function priceOf(s)
	local pid = tonumber(s and s.ProductId) or 0
	if pid > 0 and robuxPrice[pid] == nil then
		robuxPrice[pid] = false
		task.spawn(function()
			local ok, info = pcall(function()
				return game:GetService("MarketplaceService"):GetProductInfo(pid, Enum.InfoType.Product)
			end)
			if ok and type(info) == "table" and tonumber(info.PriceInRobux) then
				robuxPrice[pid] = tonumber(info.PriceInRobux)
				if isOpen and refresh then refresh() end
			end
		end)
	end
	return robuxPrice[pid] or tonumber(s and s.Price) or 0
end
