local function buildCoin(id, pos)
	local m = coinTemplate()
	m.Name = "Coin_" .. id
	local parts = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
			parts[d] = d.Transparency
		elseif d:IsA("SurfaceAppearance") then
			pcall(function() d.EmissiveStrength = Z.CoinGlow or 3 end)        -- le visage et l'anneau brillent
		end
	end
	local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
	m.PrimaryPart = pp
	-- 📐 debout (épaisseur à l'horizontale) et à la bonne taille, quel que soit le sens de l'import :
	--    le pivot est remis SUR la pièce (un import peut avoir un pivot tourné → la pièce restait à plat)
	pcall(function() pp.PivotOffset = CFrame.new() end)
	local sz = pp.Size
	pcall(function()
		local _, bs = m:GetBoundingBox()            -- toute la pièce (plusieurs morceaux possibles), dans le repère de pp
		if typeof(bs) == "Vector3" and bs.Magnitude > 0 then sz = bs end
	end)
	local base = CFrame.new()
	if sz.Y <= sz.X and sz.Y <= sz.Z then base = CFrame.Angles(0, 0, math.rad(90))
	elseif sz.Z <= sz.X and sz.Z <= sz.Y then base = CFrame.Angles(0, math.rad(90), 0) end
	local s0 = 1
	pcall(function()
		local ext = m:GetExtentsSize()
		local big = math.max(ext.X, ext.Y, ext.Z)
		if big > 0 then m:ScaleTo(m:GetScale() * (Z.CoinSize or 2.4) / big) end
		s0 = m:GetScale()
	end)
	m:PivotTo(CFrame.new(pos) * base)
	m.Parent = world()
	local rec = { id = id, model = m, pp = pp, home = pos, parts = parts, state = "appear", t = math.random() * 10,
		appearT = os.clock(), spin = math.random() * 6, base = base, s0 = s0 }
	rec.light = new("PointLight", { Color = C_OR, Range = 7, Brightness = 1.1, Shadows = false }, pp)
	rec.fx = new("Part", { Name = "CoinMagic", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(2, 2.4, 2), CFrame = CFrame.new(pos), CastShadow = false }, m)
	rec.stars = new("ParticleEmitter", { Texture = (FX and FX.Tex and FX.Tex("Star")) or STAR, Rate = 5, LightEmission = 1, LightInfluence = 0,
		Lifetime = NumberRange.new(0.7, 1.2), Speed = NumberRange.new(0.05, 0.3), SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.18), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0.1), Color = seq(WHITE, C_YE, C_OR), RotSpeed = NumberRange.new(-60, 60),
		Rotation = NumberRange.new(0, 360), ZOffset = 0.4 }, rec.fx)
	pcall(function() rec.stars.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume end)
	rec.hl = new("Highlight", { Adornee = m, FillColor = C_YE, FillTransparency = 1, OutlineColor = WHITE, OutlineTransparency = 1,
		DepthMode = Enum.HighlightDepthMode.Occluded, Enabled = false }, m)
	return rec
end

local function setAlpha(rec, a)
	for p, base in pairs(rec.parts) do
		if p.Parent then p.Transparency = base + (1 - base) * (1 - a) end
	end
end

local function puff(pos)
	if FX and FX.Puff then pcall(FX.Puff, pos, 0.5) end
end

local function removeCoin(id, withPuff)
	local rec = coins[id]
	if not rec then return end
	coins[id] = nil
	if withPuff and not rec.hidden and rec.pp and rec.pp.Parent then puff(rec.pp.Position) end
	rec.model:Destroy()
end

local function coinBurst(target)
	if FX and FX.Burst then pcall(FX.Burst, target, 0.55, { C_YE, C_OR }) end
	if FX and FX.Sparkle then pcall(FX.Sparkle, target, 18, seq(WHITE, C_YE, C_OR), 6) end
	sound("Coin", 0.5)
	local char = player.Character
	if char then
		local h = new("Highlight", { Adornee = char, FillColor = C_YE, FillTransparency = 0.6, OutlineColor = WHITE,
			OutlineTransparency = 0.3, DepthMode = Enum.HighlightDepthMode.Occluded }, char)
		tween(h, 0.6, { FillTransparency = 1, OutlineTransparency = 1 })
		task.delay(0.7, function() h:Destroy() end)
	end
end

local function hrp()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local RISE_T, DIVE_T = 0.45, 0.42
local pickPending = {}
-- 👁️ au-delà de cette distance, la pièce est RANGÉE (plus affichée, plus animée) : aucune perte de FPS,
--    et jamais une pièce qui flotte là où la map n'est pas chargée (StreamingEnabled)
local function hideRadius()
	local r = Z.ShowRadius or 220
	if workspace.StreamingEnabled then
		local ok, sr = pcall(function() return workspace.StreamingTargetRadius end)
		if ok and type(sr) == "number" and sr > 0 then r = math.min(r, sr * 0.85) end
	end
	return r
end
local HIDE_R = hideRadius()
RunService.Heartbeat:Connect(function(dt)
	local r = hrp()
	local me = r and r.Position
	local hum = r and r.Parent:FindFirstChildOfClass("Humanoid")
	local alive = hum and hum.Health > 0
	local now = os.clock()
	for id, rec in pairs(coins) do
		if not rec.hidden and not rec.model.Parent then coins[id] = nil continue end
		rec.t += dt
		local t = rec.t
		local d = me and (me - rec.home).Magnitude or math.huge
		-- loin (ou personnage pas encore là) : pièce rangée, rien n'est calculé ; elle revient en s'approchant
		local hide = (d > HIDE_R) and (rec.state == "idle" or rec.state == "appear")
		if hide ~= (rec.hidden == true) then
			rec.hidden = hide
			rec.model.Parent = (not hide) and world() or nil
		end
		if hide then continue end
		if rec.state == "idle" or rec.state == "appear" then
			rec.spin += dt * 1.8
			local cf = CFrame.new(rec.home + Vector3.new(0, math.sin(t * 1.6) * 0.22, 0)) * CFrame.Angles(0, rec.spin, 0)
			if rec.state == "appear" then
				local u = (now - rec.appearT) / 0.6
				if u >= 1 then rec.state = "idle" setAlpha(rec, 1)
				else
					setAlpha(rec, smooth(u))
					cf = cf * CFrame.new(0, (1 - smooth(u)) * -1, 0)
				end
			end
			rec.model:PivotTo(cf * rec.base)
			rec.light.Brightness = 1.1 + math.sin(t * 2.2) * 0.2
			rec.hl.Enabled = d < 14
			rec.hl.OutlineTransparency = 1 - math.clamp((14 - d) / 8, 0, 1) * 0.8
			-- ✋ ramassage en passant dessus (le serveur vérifie la distance de son côté)
			if rec.state == "idle" and alive and d <= (Z.AutoPickupDistance or 5) and not (rec.cool and now < rec.cool) then
				rec.state = "rise"
				rec.riseT0 = now
				rec.riseFrom = rec.model:GetPivot()
				pickPending[id] = now
				ActionRE:FireServer("pick", id)
				rec.stars.Rate = 20
			end
		elseif rec.state == "rise" or rec.state == "hover" then
			local u = rec.state == "rise" and math.clamp((now - rec.riseT0) / RISE_T, 0, 1) or 1
			local e = 1 - (1 - u) ^ 3
			rec.spin += dt * (2 + e * 14)
			local pos = rec.riseFrom.Position + Vector3.new(0, 1.6 * e + math.sin(t * 4) * 0.06 * e, 0)
			rec.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rec.spin, 0) * rec.base)
			if u >= 1 then rec.state = "hover" end
			if rec.state == "hover" and rec.confirmed then
				rec.state = "dive"
				rec.diveT0 = now
				rec.diveFrom = rec.model:GetPivot()
			elseif pickPending[id] and now - pickPending[id] > 4 then
				pickPending[id] = nil
				rec.state = "back" rec.backT0 = now rec.backFrom = rec.model:GetPivot() rec.cool = now + 2.5
			end
		elseif rec.state == "dive" then
			local u = math.clamp((now - rec.diveT0) / DIVE_T, 0, 1)
			local e = u * u * u
			local target = (r and (r.Position + Vector3.new(0, 0.6, 0))) or rec.home
			local from = rec.diveFrom.Position
			local mid = from:Lerp(target, 0.4) + Vector3.new(0, 1, 0)
			local q = 1 - e
			local pos = from * (q * q) + mid * (2 * q * e) + target * (e * e)
			rec.spin += dt * 18
			rec.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rec.spin, 0) * rec.base)
			pcall(function() rec.model:ScaleTo(rec.s0 * math.max(0.15, 1 - e * 0.85)) end)
			if u >= 1 then
				coinBurst(target)
				coins[id] = nil
				rec.model:Destroy()
				continue
			end
		elseif rec.state == "back" then
			local u = math.clamp((now - rec.backT0) / 0.6, 0, 1)
			rec.model:PivotTo(rec.backFrom:Lerp(CFrame.new(rec.home) * CFrame.Angles(0, rec.spin, 0) * rec.base, 1 - (1 - u) ^ 3))
			if u >= 1 then rec.state = "idle" rec.stars.Rate = 5 end
		end
		if rec.fx.Parent then rec.fx.CFrame = CFrame.new(rec.model:GetPivot().Position) end
		-- à mi-distance : lumière et étincelles coupées (moins de rendu), la pièce reste visible
		local far = d > HIDE_R * 0.5
		if far ~= rec.far then
			rec.far = far
			rec.light.Enabled = not far
			rec.stars.Enabled = not far
		end
	end
end)

