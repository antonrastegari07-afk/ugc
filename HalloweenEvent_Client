local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, col, th, tr)
	return new("UIStroke", { Color = col, Thickness = th or 1, Transparency = tr or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function tstroke(o, th, col)    -- contour du TEXTE
	return new("UIStroke", { Color = col or OUTLINE, Thickness = th or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, o)
end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
local function label(parent, props)
	local l = new("TextLabel", { BackgroundTransparency = 1, FontFace = F.Bold, TextColor3 = WHITE, TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left }, parent)
	for k, v in pairs(props) do l[k] = v end
	return l
end
local function smooth(u) u = math.clamp(u, 0, 1) return u * u * (3 - 2 * u) end

-- Bouton 3D de ton panneau Settings : socle fixe + face brillante qui s'enfonce
local function button3D(parent, text, col, size, textSize, order)
	local depth, radius = 4, 10
	local slot = new("Frame", { Size = size, BackgroundTransparency = 1, LayoutOrder = order or 0 }, parent)
	local edge = new("Frame", { Size = UDim2.new(1, 0, 1, -depth), Position = UDim2.fromOffset(0, depth),
		BackgroundColor3 = col[3], BorderSizePixel = 0 }, slot)
	corner(edge, radius)
	local btn = new("TextButton", { Size = UDim2.new(1, 0, 1, -depth), BackgroundColor3 = WHITE,
		BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = 2 }, slot)
	corner(btn, radius)
	local grad = new("UIGradient", { Rotation = 90, Color = ColorSequence.new(col[1], col[2]) }, btn)
	local lbl = new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = text,
		FontFace = FRED, TextSize = textSize or 18, TextColor3 = WHITE, ZIndex = 4 }, btn)
	tstroke(lbl, 1.6)
	local function press(down) btn.Position = UDim2.fromOffset(0, down and depth or 0) end
	btn.MouseButton1Down:Connect(function() press(true) end)
	btn.MouseButton1Up:Connect(function() press(false) end)
	btn.MouseLeave:Connect(function() press(false) end)
	btn.Activated:Connect(function() task.delay(0.08, function() press(false) end) end)
	return btn, lbl, slot, grad, edge
end
local function recolor(grad, edge, col)
	grad.Color = ColorSequence.new(col[1], col[2])
	edge.BackgroundColor3 = col[3]
end

-- 🔢 nombres
local function commas(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end
-- largeur d'un texte en FredokaOne (pour centrer « icône + nombre » ensemble dans un bouton)
local function textW(t, size)
	local ok, v = pcall(function()
		return game:GetService("TextService"):GetTextSize(t, size, Enum.Font.FredokaOne, Vector2.new(2000, 200)).X
	end)
	if ok and type(v) == "number" and v > 0 then return v end
	return #t * size * 0.62
end
-- place l'icône et le nombre CÔTE À CÔTE, le groupe centré dans son parent
local function centerRow(icon, lbl, text, size, iconW, gap)
	lbl.Text = text
	local tw = textW(text, size)
	local withIcon = icon ~= nil and icon.Visible
	local total = (withIcon and (iconW + gap) or 0) + tw
	local x = -total / 2
	if withIcon then
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0.5, x, 0.5, 0)
		x += iconW + gap
	end
	lbl.AnchorPoint = Vector2.new(0, 0.5)
	lbl.Position = UDim2.new(0.5, x - 2, 0.5, 0)
	lbl.Size = UDim2.fromOffset(tw + 8, size + 8)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
end
local function clock(sec)
	sec = math.max(0, math.floor(sec))
	local d, h, m, s = sec // 86400, (sec % 86400) // 3600, (sec % 3600) // 60, sec % 60
	return d, h, m, s
end
local function longTime(sec)        -- 9d 1h 11m 33s
	local d, h, m, s = clock(sec)
	if d > 0 then return ("%dd %dh %dm %ds"):format(d, h, m, s) end
	return ("%dh %dm %ds"):format(h, m, s)
end
local function padTime(sec)         -- 3d 06h 00m 53s
	local d, h, m, s = clock(sec)
	if d > 0 then return ("%dd %02dh %02dm %02ds"):format(d, h, m, s) end
	return ("%02dh %02dm %02ds"):format(h, m, s)
end
local function mmss(sec) return ("%d:%02d"):format(sec // 60, sec % 60) end

local function serverNow() return workspace:GetServerTimeNow() end

local function img(id)
	if type(id) == "number" then id = tostring(id) end
	if type(id) ~= "string" or id == "" then return nil end
	if id:find("://") then return id end
	return "rbxassetid://" .. id
end

