task.spawn(function()
	local GOLD = Color3.fromRGB(255, 214, 110)
	local rnd = Random.new()
	local nextShine = 0
	while true do
		local dt = task.wait()
		if isOpen then
			eff.t += dt or 0.03
			local t = eff.t
			if scytheInfo.step then scytheInfo.step(dt or 0.03) end
			-- ❗ battement de cœur (double « boum » toutes les 1,2 s)
			local u = t % 1.2
			local beat = (u < 0.14 and math.sin(u / 0.14 * math.pi)) or ((u > 0.24 and u < 0.38) and 0.7 * math.sin((u - 0.24) / 0.14 * math.pi)) or 0
			for _, d in ipairs({ questDot, rewardsDot }) do
				if d.Visible then d:FindFirstChildOfClass("UIScale").Scale = 1 + 0.22 * beat end
			end
			-- 🎃 la faux : étoiles, reflet, contour doré qui respire
			local sc = SCYTHE_I and cards[SCYTHE_I]
			if sc and tab == "Rewards" then
				for _, sp in ipairs(eff.sparkles) do
					if t - sp.t0 > sp.dur then
						sp.t0 = t + rnd:NextNumber(0, 0.6)
						sp.dur = rnd:NextNumber(0.7, 1.2)
						sp.f.Position = UDim2.fromScale(rnd:NextNumber(0.1, 0.9), rnd:NextNumber(0.08, 0.7))
						sp.size = rnd:NextNumber(0.55, 1.05)
						local col = rnd:NextNumber() < 0.5 and WHITE or GOLD
						for _, p in ipairs(sp.parts) do p.BackgroundColor3 = col end
					end
					local k = (t - sp.t0) / sp.dur
					sp.f.Visible = k >= 0 and k <= 1
					if sp.f.Visible then
						sp.sc.Scale = math.sin(k * math.pi) * (sp.size or 1)
						sp.f.Rotation = k * 90
					end
				end
				if sc.shine then
					if t >= nextShine then nextShine = t + 3.2 end
					local k = 1 - (nextShine - t) / 0.9          -- le reflet traverse en 0,9 s, puis pause
					sc.shine.Visible = k >= 0 and k <= 1
					if sc.shine.Visible then
						sc.shine.Position = UDim2.fromScale(-0.3 + 1.6 * k, 0.5)
						sc.shine.BackgroundTransparency = 0.25
					end
				end
				if view and not (view.owned and view.owned[SCYTHE_I]) and sc.baseStroke then
					sc.boxStroke.Color = sc.baseStroke:Lerp(GOLD, 0.35 + 0.35 * math.sin(t * 2.4))
				end
			end
			-- 🔄 NEW QUESTS pulse quand toute la section est réclamée (ça t'invite à prendre de nouvelles quêtes)
			for _, rb in pairs(refreshBtns) do
				rb.sc.Scale = (rb.pulse and tab == "Quests") and (1 + 0.06 * (0.5 + 0.5 * math.sin(t * 5))) or 1
