local rows = { daily = {}, weekly = {}, jack = {} }
local function rowFor(which, i)
	local r = rows[which][i]
	if not r then
		local base = which == "daily" and 10 or which == "weekly" and 100 or 200
		r = questRow(base + i)
		rows[which][i] = r
		r.pb.Activated:Connect(function()
			local e = r.entry
			if not e or not view or which == "jack" or os.clock() < busyUntil then return end
			if e.c then return end
			local def = QDEF[e.id]
			local goal = def and ((TIME_KINDS[def.Kind] and def.Goal * 60) or def.Goal) or 1
			if e.n < goal then return toast("Not finished yet!", def and def.Text:gsub("{N}", tostring(def.Goal)), true) end
			busyUntil = os.clock() + 1.2
			ActionRE:FireServer("claim", which, i, e.id)
		end)
	end
	return r
end

local function fillQuest(r, which, e)
	r.entry = e
	r.row.Visible = true
	local def = QDEF[e.id]
	if not def then r.row.Visible = false return end
	local timeKind = TIME_KINDS[def.Kind]
	local goal = timeKind and def.Goal * 60 or def.Goal
	local done = e.n >= goal
	r.title.Text = (def.Text or ""):gsub("{N}", commas(def.Goal))
	r.chip.Visible = false                     -- (pas de difficulté affichée)
	r.prog.Text = timeKind and (mmss(math.min(e.n, goal)) .. " / " .. mmss(goal)) or (commas(math.min(e.n, goal)) .. " / " .. commas(goal))
	r.barBack.Visible = true
	r.bar.Size = UDim2.fromScale(math.clamp(e.n / goal, 0, 1), 1)
	r.bar.BackgroundColor3 = done and Color3.fromRGB(120, 255, 150) or WHITE
	r.picon.Visible = true
	if e.c then
		recolor(r.pgrad, r.pedge, COL.dark)
		r.pval.Text = "✓ DONE"
		r.pval.Position = UDim2.fromOffset(0, 0)
		r.pval.Size = UDim2.fromScale(1, 1)
		r.pval.TextXAlignment = Enum.TextXAlignment.Center
		r.picon.Visible = false
		r.row.BackgroundTransparency = 0.7
	elseif done then
		recolor(r.pgrad, r.pedge, COL.green)
		r.pval.Text = "CLAIM " .. commas(def.Reward)
		r.pval.TextSize = 32
		r.pval.Position = UDim2.fromOffset(86, 0)
		r.pval.Size = UDim2.new(1, -92, 1, 0)
		r.pval.TextXAlignment = Enum.TextXAlignment.Left
		r.row.BackgroundTransparency = 0.45
	else
		recolor(r.pgrad, r.pedge, COL.dark)
		r.pval.Text = commas(def.Reward)
		r.pval.TextSize = 40
		r.pval.Position = UDim2.fromOffset(92, 0)
		r.pval.Size = UDim2.new(1, -100, 1, 0)
		r.pval.TextXAlignment = Enum.TextXAlignment.Left
		r.row.BackgroundTransparency = 0.45
	end
	r.rs.Color = done and not e.c and Color3.fromRGB(110, 230, 140) or Color3.fromRGB(95, 95, 105)
	r.rslot.Visible = false          -- (les nouvelles quêtes se prennent pour TOUTE la section : bouton dans l'en-tête)
end

local function fillJack(r, j)
	r.entry = nil
	r.row.Visible = true
	r.title.Text = j.Title or "Jack's quest"
	r.chip.Visible = true
	r.chip.Text = j.Done and "DONE" or j.Active and "ACTIVE" or j.Available and "NEW" or "LOCKED"
	r.chip.BackgroundColor3 = j.Done and DIFF_COL.easy or j.Active and DIFF_COL.medium or j.Available and PURPLE or Color3.fromRGB(80, 80, 90)
	local n, total = tonumber(j.Count), tonumber(j.Total)
	if j.Done then r.prog.Text = "Completed"
	elseif n and total then r.prog.Text = commas(n) .. " / " .. commas(total)
	else r.prog.Text = (C.Jack and C.Jack.Hint) or "Talk to Jack" end
	r.barBack.Visible = n ~= nil and total ~= nil and total > 0 and not j.Done
	if r.barBack.Visible then r.bar.Size = UDim2.fromScale(math.clamp(n / total, 0, 1), 1) end
	r.rslot.Visible = false
	recolor(r.pgrad, r.pedge, j.Done and COL.dark or COL.orange)
	r.picon.Visible = (j.Coins or 0) > 0 and not j.Done
	r.pval.TextXAlignment = Enum.TextXAlignment.Left
	r.pval.Position = UDim2.fromOffset(92, 0)
	r.pval.Size = UDim2.new(1, -100, 1, 0)
	r.pval.TextSize = 40
	if j.Done then
		r.pval.Text = "✓ DONE"
		r.pval.Position = UDim2.fromOffset(0, 0)
		r.pval.Size = UDim2.fromScale(1, 1)
		r.pval.TextXAlignment = Enum.TextXAlignment.Center
	elseif (j.Coins or 0) > 0 then
		r.pval.Text = commas(j.Coins)
	else
		r.pval.Text = (j.Points and j.Points > 0) and (commas(j.Points) .. " pts") or "🎁"
		r.pval.Position = UDim2.fromOffset(0, 0)
		r.pval.Size = UDim2.fromScale(1, 1)
		r.pval.TextXAlignment = Enum.TextXAlignment.Center
	end
	r.row.BackgroundTransparency = j.Done and 0.7 or 0.45
	r.rs.Color = j.Active and ORANGE or Color3.fromRGB(95, 95, 105)
end

