		if animCache[key] ~= nil then return animCache[key] or nil end
		local id
		pcall(function()
			local f = ReplicatedStorage:FindFirstChild("JackScythe")
			local m = f and f:FindFirstChild("SCYTHE_CONFIG")
			local SC = m and require(m)
			local v = SC and SC.Animations and SC.Animations[key]
			if type(v) == "number" then v = tostring(v) end
			if type(v) == "string" and v ~= "" then id = v:find("://") and v or ("rbxassetid://" .. v) end
		end)
		if not id and select(2, pcall(function() return RunService:IsStudio() end)) == true then
			pcall(function()
				local f = ReplicatedStorage:FindFirstChild("NpcAnimations")
				f = f and f:FindFirstChild("JackScythe")
				local kfs = f and f:FindFirstChild("Scythe_" .. key)
				if kfs then id = game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(kfs) end
			end)
		end
		animCache[key] = id or false
		return id
	end

	local live = nil
	local function stopLive()
		if not live then return end
		live.alive = false
		for _, t in pairs(live.tracks) do pcall(function() t:Stop(0) end) end
		if live.wm then live.wm:Destroy() end
		live = nil
	end

	-- 🧍 copie de TON perso + la faux dans sa main
	local function buildView()
		stopLive()
		local L = { alive = true, tracks = {}, t = 0 }
		live = L
		L.wm = new("WorldModel", {}, vp)
		local assets = ReplicatedStorage:FindFirstChild("HalloweenEventAssets")
		local prev = assets and assets:FindFirstChild("ScythePreview")
		local ch = player.Character
		local clone
		if ch then
			local was = ch.Archivable
			pcall(function()
				ch.Archivable = true
				clone = ch:Clone()
			end)
			pcall(function() ch.Archivable = was end)
		end
		local root = clone and (clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart)
		if not clone or not root then
			if clone then clone:Destroy() end
			clone = nil
		end
		if clone then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("LuaSourceContainer") or d:IsA("Tool") or d:IsA("Sound") or d:IsA("ForceField")
					or d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d.Name == "ScytheGrip" or d.Name == "RightGrip" then
					pcall(function() d:Destroy() end)
				end
			end
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("BasePart") then d.Anchored = d == root d.CanCollide = false end
			end
			local hum = clone:FindFirstChildOfClass("Humanoid")
			if hum then
				pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
				if not hum:FindFirstChildOfClass("Animator") then new("Animator", {}, hum) end
			end
			clone:PivotTo(CFrame.new(0, 3, 0))
			clone.Parent = L.wm
			-- la faux dans la main (même moteur que le vrai outil : « ScytheGrip » Torso → Handle)
			if prev then
				local s = prev:Clone()
				local handle = s:FindFirstChild("Handle")
				if handle then
					for _, d in ipairs(s:GetDescendants()) do
						if d:IsA("Motor6D") then d.Enabled = false end
					end
					for _, d in ipairs(s:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Anchored, d.CanCollide, d.Massless = false, false, true
							if d ~= handle then new("WeldConstraint", { Part0 = handle, Part1 = d }, handle) end
						end
					end
					local torso = clone:FindFirstChild("Torso") or clone:FindFirstChild("UpperTorso")
					local arm = clone:FindFirstChild("Right Arm") or clone:FindFirstChild("RightHand")
					local c0, c1 = s:GetAttribute("GripC0"), s:GetAttribute("GripC1")
					if torso and typeof(c0) == "CFrame" then
						new("Motor6D", { Name = "ScytheGrip", Part0 = torso, Part1 = handle, C0 = c0,
							C1 = typeof(c1) == "CFrame" and c1 or CFrame.new() }, torso)
					elseif arm then
						new("Motor6D", { Name = "ScytheGrip", Part0 = arm, Part1 = handle, C0 = CFrame.new(0, -1, 0) * CFrame.Angles(-math.pi / 2, 0, 0) }, arm)
					end
					s.Parent = clone
				end
			end
			-- 🎬 sortie de la faux, puis elle la tient, et un dash toutes les ~3 s
			local an = hum and hum:FindFirstChildOfClass("Animator")
			if an then
				for _, k in ipairs({ "Hold", "Equip", "Dash" }) do
					local id = animId(k)
					if id then
						local ok, tr = pcall(function() return an:LoadAnimation(new("Animation", { AnimationId = id })) end)
						if ok and tr then
							tr.Priority = ({ Hold = Enum.AnimationPriority.Action, Equip = Enum.AnimationPriority.Action2,
								Dash = Enum.AnimationPriority.Action4 })[k]
							tr.Looped = k == "Hold"
							L.tracks[k] = tr
						end
					end
				end
				task.spawn(function()
					-- ordre en boucle : sortie, sortie, dash, sortie, dash…
					local tr = L.tracks
					local function play(t, fallback)
						if not t or not L.alive then return end
						t:Play(0.05)
						task.wait(math.max(0.7, t.Length > 0 and t.Length or fallback))
					end
					if tr.Hold then tr.Hold:Play(0.1) end
					local seq = { "Equip", "Equip", "Dash", "Equip", "Dash" }
					local k = 0
					while L.alive do
						k = k % #seq + 1
						play(tr[seq[k]], seq[k] == "Dash" and 0.8 or 1.2)
						task.wait(0.9)
					end
				end)
			end
			L.center = Vector3.new(0, 3.1, 0)
			L.dist = 21                      -- un peu plus loin : tout le perso + la faux
		elseif prev then
			-- pas de perso (mort / chargement) : la faux seule, qui tourne
			local s = prev:Clone()
			for _, d in ipairs(s:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true end end
			s.Parent = L.wm
			local ok, cf, size = pcall(function() return s:GetBoundingBox() end)
			L.center = ok and cf.Position or Vector3.zero
			L.dist = ok and math.max(size.X, size.Y, size.Z) * 2.4 or 10
			L.spinModel = s
		end
		noView.Visible = L.center == nil
	end

	local function fill()
		local v = view
		local tier = SCYTHE_I and TIERS[SCYTHE_I]
		local sy = v and v.scythe
		local own = v and v.owned and SCYTHE_I and v.owned[SCYTHE_I]
		local gold = 100
		pcall(function()
			local f = ReplicatedStorage:FindFirstChild("JackScythe")
			local m = f and f:FindFirstChild("SCYTHE_CONFIG")
			local SC = m and require(m)
			if SC and tonumber(SC.GoldCount) then gold = tonumber(SC.GoldCount) end
		end)
		local txt = {
			"It's a TOOL you keep forever: it stays in your backpack, even after you respawn.",
			"Equip it and click (or press Q) to DASH forward in a burst of soul flames!",
			"Every scythe has its own serial number engraved on it. The first " .. commas(gold) .. " are GOLDEN!",
			(sy and sy.stock) and ("LIMITED: only " .. commas(sy.stock) .. " will ever exist."
				.. (sy.left ~= nil and (" " .. commas(sy.left) .. " left!") or "")) or nil,
		}
		for k, ln in ipairs(lines) do
			ln.row.Visible = txt[k] ~= nil
			ln.l.Text = txt[k] or ""
			if k == 4 then ln.l.TextColor3 = Color3.fromRGB(255, 170, 70) end      -- 📦 le stock limité ressort
		end
		local soldOut = sy ~= nil and sy.left == 0 and not sy.mine and not own
		topFade.Visible = sy ~= nil and sy.stock ~= nil
		if topFade.Visible then
			eff.pageStock.Text = soldOut and "SOLD OUT" or (sy.left ~= nil and (commas(sy.left) .. " / " .. commas(sy.stock) .. " LEFT!"))
				or ("ONLY " .. commas(sy.stock) .. " WILL EXIST")
			eff.pageStock.TextColor3 = soldOut and Color3.fromRGB(255, 110, 100) or Color3.fromRGB(255, 214, 90)
		end
		status.Text = own and "✓ You own it!" or soldOut and "SOLD OUT" or
			(v and v.nextTier == SCYTHE_I) and "Ready to unlock!" or ("Unlock tiers 1 to " .. tostring((SCYTHE_I or 1) - 1) .. " first!")
		status.TextColor3 = own and Color3.fromRGB(120, 255, 150) or soldOut and Color3.fromRGB(255, 120, 110) or GOLD_HI
		buySlot.Visible = tier ~= nil and not own and not soldOut
		if buySlot.Visible then
			local can = v and v.active and v.nextTier == SCYTHE_I and (v.coins or 0) >= (tier.Cost or 0)
			recolor(buyGrad, buyEdge, can and COL.green or COL.dark)
			centerRow(buyIcon, buyL, commas(tier.Cost or 0), 30, 34, 8)
		end
		local bgId = tier and (img(tier.Background) or img((UI.CardBackgrounds or {})[tier.Rarity or "mythic"]))
		holderBg.Image = bgId or ""
		holderBg.Visible = bgId ~= nil
	end

	function scytheInfo.open()
		if not SCYTHE_I then return end
		sound("Open", 0.35)
		fill()
		page.Visible = true
		buildView()
		if scytheInfo.padSelect then scytheInfo.padSelect(backB) end
	end
	function scytheInfo.close()
		if not page.Visible then return end
		page.Visible = false
		stopLive()
		local c = SCYTHE_I and cards[SCYTHE_I]
		if isOpen and c and scytheInfo.padSelect then scytheInfo.padSelect(c.info) end
	end
	function scytheInfo.visible() return page.Visible end
	function scytheInfo.refresh() if page.Visible then fill() end end
	-- caméra qui tourne doucement autour de toi
	function scytheInfo.step(dt)
		local L = live
		if not L or not page.Visible or not L.center then return end
		L.t += dt
		if L.spinModel then
			local a = L.t * 0.8
			cam3.CFrame = CFrame.lookAt(L.center + Vector3.new(math.sin(a) * L.dist, L.dist * 0.15, -math.cos(a) * L.dist), L.center)
		else
			local a = math.rad(28) + math.sin(L.t * 0.45) * math.rad(22)
			cam3.CFrame = CFrame.lookAt(L.center + Vector3.new(math.sin(a) * L.dist, 1.2, -math.cos(a) * L.dist), L.center)
		end
	end
	backB.Activated:Connect(function() sound("Open", 0.25) scytheInfo.close() end)
	buyB.Activated:Connect(function()
		local c = SCYTHE_I and cards[SCYTHE_I]
		if c and c.buy then c.buy() end
	end)
end

