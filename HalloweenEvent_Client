				eff.pageStock.TextColor3 = Color3.fromRGB(255, 214, 90):Lerp(Color3.fromRGB(255, 246, 200), 0.5 + 0.5 * math.sin(t * 3))
			end
			if eff.viewHint and eff.viewHint.Visible then
				-- cycle de 4 s : fondu d'apparition (1,4 s), fondu de disparition (1,4 s), puis 1,2 s invisible
				local ph = (t % 4) / 2.8
