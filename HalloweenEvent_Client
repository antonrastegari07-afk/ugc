local function topY() return math.max(GuiService:GetGuiInset().Y, 36) end
-- taille de l'écran : la caméra (toujours juste, même quand la fenêtre est fermée)
local function viewport()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize
	if not vp or vp.X < 2 or vp.Y < 2 then vp = gui.AbsoluteSize end
	return vp
end
-- ✅ même taille à CHAQUE ouverture (avant : trop petit la 1re fois, trop grand ensuite)
local function fit()
	local vp = viewport()
	if vp.X < 2 or vp.Y < 2 then return false end
	local extra = (view and view.tester) and TESTBAR_H or 0
	uiScale.Scale = math.clamp(math.min((vp.Y - topY() - 40) / (PH + extra), vp.X * (UI.MaxScreenWidth or 0.94) / W, UI.MaxScale or 1),
		0.3, 1.5)
	return true
end
local function openPos(opened)
	local extra = (view and view.tester) and TESTBAR_H * uiScale.Scale or 0
	return UDim2.new(0.5, 0, opened and 0.5 or 0.56, topY() / 2 + 6 - extra / 2)
end
local function onViewport()
	if fit() and isOpen then root.Position = openPos(true) end
end
local camConn
local function watchCamera()
	if camConn then camConn:Disconnect() camConn = nil end
	local cam = workspace.CurrentCamera
	if cam then camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(onViewport) end
	onViewport()
end
pcall(function() workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera) end)
watchCamera()

-- 🌫️ FOCUS : fond flou + tes autres UI cachées pendant que la fenêtre est ouverte ; tout est remis à la fermeture
--    (une UI qu'un script rallume pendant ce temps est re-cachée, puis rallumée à la fermeture)
local focus = { hidden = {}, conns = {}, core = {}, watched = {}, blur = nil, on = false }
do
	local KEEP = { HalloweenEventUI = true, HalloweenEventToast = true, NpcDialogGui = true }
	for _, n in ipairs(UI.KeepGuis or {}) do KEEP[n] = true end
	local CORE = { "Backpack", "PlayerList", "EmotesMenu", "Health" }
	local function watch(g)
		if not g:IsA("ScreenGui") or KEEP[g.Name] or focus.watched[g] then return end
		focus.watched[g] = 0
		if g.Enabled then focus.hidden[g] = true g.Enabled = false end
		table.insert(focus.conns, g:GetPropertyChangedSignal("Enabled"):Connect(function()
			if not focus.on or not g.Enabled then return end
			-- un de tes scripts l'a rallumée : on la recache 2 fois maximum, puis on la laisse
			-- (sinon ça se renvoie la balle à l'infini → « Exponential deferred event growth »)
			local n = focus.watched[g] or 0
			if n >= 2 then return end
			focus.watched[g] = n + 1
			focus.hidden[g] = true
			task.defer(function()
				if focus.on and g.Parent and g.Enabled then g.Enabled = false end
			end)
		end))
	end
	function focus.set(on)
		if on == focus.on then return end
		focus.on = on
		if on then
			if UI.HideOtherUI ~= false then
				for _, g in ipairs(playerGui:GetChildren()) do watch(g) end
				table.insert(focus.conns, playerGui.ChildAdded:Connect(function(g) if focus.on then watch(g) end end))
				pcall(function()
					local SG = game:GetService("StarterGui")
					for _, n in ipairs(CORE) do
						local t = Enum.CoreGuiType[n]
						focus.core[n] = SG:GetCoreGuiEnabled(t)
						SG:SetCoreGuiEnabled(t, false)
					end
				end)
			end
			if (UI.BlurSize or 18) > 0 then
				pcall(function()
					if focus.blur then focus.blur:Destroy() end
					focus.blur = new("BlurEffect", { Name = "HalloweenEventBlur", Size = 0 }, workspace.CurrentCamera)
					tween(focus.blur, 0.3, { Size = UI.BlurSize or 18 }, Enum.EasingStyle.Quad)
				end)
			end
		else
			for _, c in ipairs(focus.conns) do c:Disconnect() end
			table.clear(focus.conns)
			table.clear(focus.watched)
			for g in pairs(focus.hidden) do
				if g.Parent then pcall(function() g.Enabled = true end) end
			end
			table.clear(focus.hidden)
			pcall(function()
				local SG = game:GetService("StarterGui")
				for n, was in pairs(focus.core) do SG:SetCoreGuiEnabled(Enum.CoreGuiType[n], was) end
			end)
			table.clear(focus.core)
			local b = focus.blur
			focus.blur = nil
			if b then
				tween(b, 0.2, { Size = 0 }, Enum.EasingStyle.Quad)
				task.delay(0.25, function() b:Destroy() end)
			end
		end
	end
end

