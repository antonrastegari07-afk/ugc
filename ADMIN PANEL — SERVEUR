-- Lecture d'un OrderedDataStore (top N, paginé jusqu'à 200)
-- ⚡ Cache 45 s partagé par tous les admins + une seule lecture à la fois par classement
local orderedCache = {}
local ORDERED_TTL = 45
local function sortedBudget()
	local ok, b = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetSortedAsync)
	end)
	return ok and b or 1
end
local function readOrdered(store, n)
	n = math.clamp(tonumber(n) or 50, 1, 200)
	local c = orderedCache[store]
	if not c then c = {}; orderedCache[store] = c end
	local function fromCache()
		return table.move(c.out, 1, math.min(n, #c.out), 1, {})
	end
	-- une lecture du même classement est déjà en cours → on l'attend
	local t0 = os.clock()
	while c.busy and os.clock() - t0 < 8 do task.wait(0.05) end
	local usable = c.out and (c.n >= n or c.complete)
	if usable and os.clock() - c.at < ORDERED_TTL then return fromCache() end
	-- budget GetSortedAsync épuisé : un classement d'une minute vaut mieux qu'une longue attente
	if usable and sortedBudget() < 1 then return fromCache() end
	c.busy = true
	local ok, out, complete = pcall(function()
		local pages = store:GetSortedAsync(false, math.min(n, 100))
		local res, guard = {}, 0
		while true do
			guard = guard + 1
			for _, e in ipairs(pages:GetCurrentPage()) do
				local uid = tonumber(e.key)
				if uid then res[#res + 1] = { userId = uid, value = e.value } end
				if #res >= n then return res, false end
			end
			if pages.IsFinished then return res, true end
			if guard >= 3 then return res, false end
			local okAdv = pcall(function() pages:AdvanceToNextPageAsync() end)
			if not okAdv then return res, false end
		end
	end)
	c.busy = false
	if not ok or type(out) ~= "table" then
		if c.out then return fromCache() end
		return nil
	end
	c.out, c.n, c.at, c.complete = out, n, os.clock(), complete == true
	return fromCache()
end

getACBoard.OnServerInvoke = function(player, boardId, n)
	if not isAdmin(player.UserId) then return { error = "not admin" } end
	if not checkRateLimit(player.UserId, "board", 0.25) then return { error = "rate", throttled = true } end
	boardId = tostring(boardId or "")

	if boardId:sub(1, 4) == "fly_" then
		local kind = boardId:sub(5)
		local test = true
		if _G.AntiFlyTP and _G.AntiFlyTP.IsTestMode then
			local okM, m = pcall(function() return _G.AntiFlyTP.IsTestMode() end)
			if okM then test = (m == true) end
		end
		local entries = {}
		if test then
			local map = { strikes = "detections", warnings = "warnings", kicks = "kicks", bans = "bans" }
			if _G.AntiFlyTP and _G.AntiFlyTP.GetShadowRank then
				local ok, res = pcall(function() return _G.AntiFlyTP.GetShadowRank(map[kind] or "detections", n) end)
				if ok and type(res) == "table" then entries = res end
			end
		else
			if (kind == "warnings" or kind == "bans") and _G.AntiFlyTP and _G.AntiFlyTP.GetRealRank then
				local ok, res = pcall(function() return _G.AntiFlyTP.GetRealRank(kind, n) end)
				if ok and type(res) == "table" then entries = res end
			end
		end
		return { entries = entries, testMode = test, flyKind = kind }
	elseif boardId == "smart_infractions"   then return { entries = readOrdered(SMART_RANK, n) or {} }
	elseif boardId == "smart_suspicious"    then return { entries = readOrdered(SMART_SUSP, n) or {} }
	elseif boardId == "smart_dangerous"     then return { entries = readOrdered(SMART_DANG, n) or {} }
	elseif boardId == "exploit_infractions" then return { entries = readOrdered(EXPLOIT_RANK, n) or {} }
	end
	return { entries = {} }
end

getGameBoard.OnServerInvoke = function(player, boardId, n)
