local rateLimits = { profile = {}, action = {}, specpos = {}, points = {}, board = {}, gboard = {} }

local function checkRateLimit(adminUserId, kind, cooldown)
	-- ⚡ os.clock (précis) au lieu de os.time (à la seconde) : avant, deux clics
	--    dans la même seconde étaient bloqués même avec un cooldown de 0,2 s.
	local now = os.clock()
	local last = rateLimits[kind][adminUserId] or -math.huge
	if now - last < cooldown then return false end
	rateLimits[kind][adminUserId] = now
	return true
end

local function validateString(s, maxLen)
	if type(s) ~= "string" then return nil end
	if #s == 0 or #s > (maxLen or 50) then return nil end
	if not s:match("^[%w_]+$") then return nil end
	return s
end

local function validateInt(n, minV, maxV)
	local num = tonumber(n)
	if not num then return nil end
	num = math.floor(num)
	if num < minV or num > maxV then return nil end
	return num
end

local function isAdmin(userId)
	for _, id in ipairs(ADMIN_IDS) do
