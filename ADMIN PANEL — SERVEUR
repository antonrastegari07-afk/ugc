-- 🔧 OUTILS À DONNER  +  ⏱️ PRÊTS TEMPORAIRES (gardés après la mort)
--
--  • Liste : ServerStorage ET tous ses dossiers.
--  • Don « une fois » : l'outil va dans le Backpack, perdu à la mort (comme avant).
--  • Prêt 5 min → 1 h : une copie va AUSSI dans StarterGear, que Roblox recopie
--    à chaque réapparition. À l'échéance, toutes les copies du prêt sont retirées
--    (Backpack, personnage équipé, StarterGear, au sol). Les outils que le joueur
--    possédait déjà (gamepass, boutique…) ne sont JAMAIS retirés : seules les
--    copies marquées par le prêt le sont.
--  • Redonner un outil déjà prêté PROLONGE le prêt au lieu de créer un doublon.
--  • Prêts valables pour CE serveur (en mémoire) : un joueur qui revient avant
--    la fin les récupère.
--════════════════════════════════════════════════════════════════════════
local findTools, AdminToolGive, AdminToolCancel
do
	local toolIndexCache = { at = -math.huge, list = {}, byName = {} }
	findTools = function()
		if os.clock() - toolIndexCache.at < 10 then
			return toolIndexCache.list, toolIndexCache.byName
		end
		local list, byName = {}, {}
		for _, item in ipairs(ServerStorage:GetDescendants()) do
			if item:IsA("Tool") and not byName[item.Name] then
				-- un Tool rangé À L'INTÉRIEUR d'un autre Tool n'est pas un outil à donner
				local parent, nested = item.Parent, false
				while parent and parent ~= ServerStorage do
					if parent:IsA("Tool") then nested = true; break end
					parent = parent.Parent
				end
				if not nested then
					byName[item.Name] = item
					list[#list + 1] = item.Name
				end
			end
		end
		table.sort(list)
		toolIndexCache.at, toolIndexCache.list, toolIndexCache.byName = os.clock(), list, byName
		return list, byName
	end

	local DURATIONS = { [0] = true, [300] = true, [600] = true, [900] = true, [1800] = true, [3600] = true }
	local MAX_LOANS = 25
	local ATTR = "AdminLoanId"
	local loans, seq = {}, 0

	local function sendResult(adminPlayer, data)
		pcall(function() adminEvent:FireClient(adminPlayer, "givetools_result", data) end)
	end
	local function notifyAdmins(action, data)
		for _, pl in ipairs(Players:GetPlayers()) do
			if isAdmin(pl.UserId) then pcall(function() adminEvent:FireClient(pl, action, data) end) end
		end
	end
	local function covers(loan, uid)
		return loan.all or loan.targets[uid] == true
	end
	local function loanCopy(src, loan)
		local c = src:Clone()
		c:SetAttribute(ATTR, loan.id)
		c:SetAttribute("AdminLoanExpiresAt", loan.expiresAt)
		pcall(function() c.CanBeDropped = false end) -- personne ne récupère l'arme au sol
		return c
	end

	-- Donne ou prolonge les outils d'un prêt chez UN joueur.
	-- sgOnly = le personnage n'est pas encore apparu : StarterGear suffit.
	local function applyLoan(pl, loan, toolIndex, sgOnly)
		local bp = pl:FindFirstChild("Backpack")
		local sg = pl:FindFirstChild("StarterGear")
		if not bp then return 0, 0, 0 end
		local char = pl.Character
		local given, extended, skipped = 0, 0, 0
		for _, name in ipairs(loan.tools) do
			local src = toolIndex[name]
			if src then
				local inSg, inHand, permanent = false, false, false
				for _, cont in ipairs({ bp, char, sg }) do
					if cont then
						for _, ch in ipairs(cont:GetChildren()) do
							if ch:IsA("Tool") and ch.Name == name then
								local lid = ch:GetAttribute(ATTR)
								if lid then
									if cont == sg then inSg = true else inHand = true end
									local other = loans[lid]
									if lid ~= loan.id and (not other or other.expiresAt < loan.expiresAt) then
										ch:SetAttribute(ATTR, loan.id)
										ch:SetAttribute("AdminLoanExpiresAt", loan.expiresAt)
									end
								else
									permanent = true
								end
							end
						end
					end
				end
				if permanent and loan.skipDup and not inSg and not inHand then
					skipped = skipped + 1
				else
					local added = false
					if sg and not inSg then loanCopy(src, loan).Parent = sg; added = true end
					if not inHand and not sgOnly then loanCopy(src, loan).Parent = bp; added = true end
					if inSg or inHand then extended = extended + 1
					elseif added then given = given + 1 end
				end
			end
		end
		return given, extended, skipped
	end

	local function applyAllFor(pl, sgOnly)
		local now = os.time()
		local _, toolIndex = findTools()
		for _, loan in pairs(loans) do
			if now < loan.expiresAt and covers(loan, pl.UserId) then
				applyLoan(pl, loan, toolIndex, sgOnly)
			end
		end
	end

	local function removeLoanItems(id)
		local removed = 0
		local function sweep(cont)
			if not cont then return end
			for _, ch in ipairs(cont:GetChildren()) do
				if ch:IsA("Tool") and ch:GetAttribute(ATTR) == id then
					ch:Destroy()
					removed = removed + 1
				end
			end
		end
		for _, pl in ipairs(Players:GetPlayers()) do
			sweep(pl:FindFirstChild("Backpack"))
			sweep(pl:FindFirstChild("StarterGear"))
			sweep(pl.Character)
		end
		sweep(workspace) -- outils posés au sol
		-- un autre prêt encore actif peut couvrir le même outil : on le redonne
		for _, pl in ipairs(Players:GetPlayers()) do applyAllFor(pl, false) end
		return removed
	end

	-- Échéances
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for id, loan in pairs(loans) do
				if now >= loan.expiresAt then
					loans[id] = nil
					local removed = removeLoanItems(id)
					print(string.format("[ADMIN] ⏱️ Prêt #%d terminé (%s) : %d copie(s) retirée(s)",
						id, table.concat(loan.tools, ", "), removed))
					notifyAdmins("loan_ended", { id = id, tools = loan.tools, removed = removed })
				end
			end
		end
	end)

	-- Réapparition / arrivée : on vérifie que les prêts sont bien là
	local function hook(pl)
		pl.CharacterAdded:Connect(function()
			task.wait(1.5) -- laisse Roblox recopier StarterGear d'abord
			if pl.Parent and next(loans) then applyAllFor(pl, false) end
		end)
	end
	Players.PlayerAdded:Connect(function(pl)
		hook(pl)
		if not next(loans) then return end
		task.spawn(function()
			if pl:WaitForChild("Backpack", 15) and pl.Parent then
				applyAllFor(pl, pl.Character == nil)
			end
		end)
	end)
	for _, pl in ipairs(Players:GetPlayers()) do hook(pl) end

	AdminToolGive = function(adminPlayer, extraData)
		if type(extraData) ~= "table" or type(extraData.tools) ~= "table" then return end
		local duration = math.floor(tonumber(extraData.duration) or 0)
		if not DURATIONS[duration] then return end
		local all = duration > 0 and extraData.allServer == true
		local ids = extraData.targets
		if not all and type(ids) ~= "table" then return end

		local _, toolIndex = findTools()
		local toolNames, seenT = {}, {}
		for i = 1, math.min(#extraData.tools, 40) do
			local n = extraData.tools[i]
			if type(n) == "string" and toolIndex[n] and not seenT[n] then
				seenT[n] = true
				toolNames[#toolNames + 1] = n
			end
		end
		if #toolNames == 0 then
			sendResult(adminPlayer, { given = 0, error = "Aucun des outils choisis n'existe encore dans ServerStorage." })
			return
		end
		local skipDup = extraData.skipDuplicates ~= false

		local targets = {}
		if all then
			for _, pl in ipairs(Players:GetPlayers()) do targets[pl.UserId] = true end
		else
			for i = 1, math.min(#ids, 60) do
				local uid = tonumber(ids[i])
				if uid then targets[uid] = true end
			end
		end

		local given, extended, skipped, offline = 0, 0, 0, 0
		if duration == 0 then
			-- 🎁 une fois : Backpack seulement, perdu à la mort
			for uid in pairs(targets) do
				local pl = Players:GetPlayerByUserId(uid)
				local bp = pl and pl:FindFirstChild("Backpack")
				if not bp then
					offline = offline + 1
				else
					for _, name in ipairs(toolNames) do
						local inBp = bp:FindFirstChild(name)
						local inChar = pl.Character and pl.Character:FindFirstChild(name)
						local has = (inBp and inBp:IsA("Tool")) or (inChar and inChar:IsA("Tool"))
						if skipDup and has then
							skipped = skipped + 1
						else
							toolIndex[name]:Clone().Parent = bp
							given = given + 1
						end
					end
				end
			end
		else
			-- ⏱️ prêt
			local count = 0
			for _ in pairs(loans) do count = count + 1 end
			if count >= MAX_LOANS then
				sendResult(adminPlayer, { given = 0, error = "Trop de prêts en cours (" .. MAX_LOANS .. "). Arrêtes-en un." })
				return
			end
			seq = seq + 1
			local loan = { id = seq, tools = toolNames, targets = targets, all = all, skipDup = skipDup,
				duration = duration, expiresAt = os.time() + duration, by = adminPlayer.Name }
			loans[loan.id] = loan
			for uid in pairs(targets) do
				local pl = Players:GetPlayerByUserId(uid)
				if not pl or not pl:FindFirstChild("Backpack") then
					offline = offline + 1
				else
					local g, e, s = applyLoan(pl, loan, toolIndex, false)
					given, extended, skipped = given + g, extended + e, skipped + s
				end
			end
		end

		print(string.format("[ADMIN] %s → givetools (%s) : %d donné(s), %d prolongé(s), %d déjà possédé(s), %d absent(s)",
			adminPlayer.Name, duration == 0 and "une fois" or (duration // 60 .. " min" .. (all and ", tout le serveur" or "")),
			given, extended, skipped, offline))
		sendResult(adminPlayer, { given = given, extended = extended, skipped = skipped, offline = offline,
			tools = #toolNames, duration = duration, all = all })
	end

	AdminToolCancel = function(adminPlayer, extraData)
		local list = {}
		if extraData == "all" then
			for id in pairs(loans) do list[#list + 1] = id end
		else
			local id = tonumber(extraData)
			if id and loans[id] then list[1] = id end
		end
		local removed = 0
		for _, id in ipairs(list) do loans[id] = nil end
		for _, id in ipairs(list) do removed = removed + removeLoanItems(id) end
		print(string.format("[ADMIN] %s a arrêté %d prêt(s) : %d copie(s) retirée(s)", adminPlayer.Name, #list, removed))
		notifyAdmins("loan_ended", { cancelled = #list, removed = removed, by = adminPlayer.Name })
	end

	local function listLoans()
		local now, out = os.time(), {}
		for id, l in pairs(loans) do
			local n, names = 0, {}
			for uid in pairs(l.targets) do
				n = n + 1
				local pl = Players:GetPlayerByUserId(uid)
				if pl and #names < 3 then names[#names + 1] = pl.Name end
			end
			out[#out + 1] = { id = id, tools = table.clone(l.tools), remaining = math.max(0, l.expiresAt - now),
				duration = l.duration, all = l.all, players = n, names = names, by = l.by }
		end
		table.sort(out, function(a, b) return a.remaining < b.remaining end)
		return out
	end

	getToolsEvent.OnServerInvoke = function(player, what)
		if not isAdmin(player.UserId) then return {} end
		if what == "loans" then return { loans = listLoans() } end
		local ok, list = pcall(findTools)
		if not ok then
			warn("[ADMIN] Liste des outils impossible : " .. tostring(list))
			return {}
		end
		return table.move(list, 1, #list, 1, {})
	end
end

