-- 💎 Points + 🚫 statut ban
-- ⚡ Lectures EN PARALLÈLE (8 à la fois), dans la limite du budget DataStore.
--    Un 2e appel du même admin ATTEND le premier au lieu de répondre vide.
local pointsCacheS = {}
local POINTS_TTL = 300
local pointsBusy = {}

local function getBudget()
	local ok, b = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync)
	end)
	return ok and b or 60
end

getPointsEvent.OnServerInvoke = function(player, ids)
	if not isAdmin(player.UserId) then return {} end
	if type(ids) ~= "table" then return {} end
	local waited = os.clock()
	while pointsBusy[player.UserId] and os.clock() - waited < 10 do task.wait(0.05) end
	pointsBusy[player.UserId] = true

	local out, need, seen = {}, {}, {}
	local now = os.time()
	for i = 1, math.min(#ids, 200) do
		local id = tonumber(ids[i])
		if id and id > 0 and not seen[id] then
			seen[id] = true
			local pl = Players:GetPlayerByUserId(id)
			if pl then
				local live = pl:GetAttribute("Points")
				out[tostring(id)] = { points = (type(live) == "number") and live or nil, banned = false }
			else
				local c = pointsCacheS[id]
				if c and (now - c.t) < POINTS_TTL then
					out[tostring(id)] = { points = c.v, banned = c.banned }
				elseif #need < 60 then
					need[#need + 1] = id
				end
			end
		end
	end

	local idx, pending = 0, #need
	local function worker()
		while true do
			idx = idx + 1
			local id = need[idx]
			if not id then break end
			-- on laisse toujours de la marge au jeu (sauvegardes des joueurs)
			local guardT = os.clock()
			while getBudget() < 6 and os.clock() - guardT < 8 do task.wait(0.25) end
			local okP, data, okB, banInfo
			local banDone = false
			task.spawn(function()
				okB, banInfo = pcall(function() return banStore:GetAsync(tostring(id)) end)
				banDone = true
			end)
			okP, data = pcall(function() return PLAYER_DATA_STORE:GetAsync("p_" .. id) end)
			local t1 = os.clock()
			while not banDone and os.clock() - t1 < 8 do task.wait(0.03) end
			if okP and okB then
				local pts = (type(data) == "table" and tonumber(data.points)) or 0
				local isBanned = banInfo ~= nil
				pointsCacheS[id] = { v = pts, banned = isBanned, t = os.time() }
				out[tostring(id)] = { points = pts, banned = isBanned }
			end -- lecture ratée : pas de cache, le client redemandera
			pending = pending - 1
		end
	end
	for _ = 1, math.min(8, #need) do task.spawn(worker) end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 15 do task.wait(0.05) end
	pointsBusy[player.UserId] = nil
	return out
end

local unameCache = {}
local UserService = game:GetService("UserService")
-- ⚡ Pseudos : UN SEUL appel web pour tout le lot (avant : un appel par joueur, l'un après l'autre)
resolveNamesEvent.OnServerInvoke = function(player, ids)
	if not isAdmin(player.UserId) then return {} end
	if type(ids) ~= "table" then return {} end
	local out, need, seen = {}, {}, {}
	for i = 1, math.min(#ids, 200) do
		local id = tonumber(ids[i])
		if id and id > 0 and not seen[id] then
			seen[id] = true
			local pl = Players:GetPlayerByUserId(id)
			if pl then unameCache[id] = pl.Name end
			if unameCache[id] then
				out[tostring(id)] = unameCache[id]
			else
				need[#need + 1] = id
			end
		end
	end
	if #need == 0 then return out end

	for start = 1, #need, 100 do
		local chunk = table.move(need, start, math.min(start + 99, #need), 1, {})
		local ok, infos = pcall(function() return UserService:GetUserInfosByUserIdsAsync(chunk) end)
		if ok and type(infos) == "table" then
			for _, info in ipairs(infos) do
				local id = type(info) == "table" and tonumber(info.Id)
				if id and type(info.Username) == "string" then
					unameCache[id] = info.Username
					out[tostring(id)] = info.Username
				end
			end
		end
	end

	-- Repli : ceux que le lot n'a pas rendus, 8 à la fois
	local left = {}
	for _, id in ipairs(need) do
		if not unameCache[id] then left[#left + 1] = id end
	end
	if #left > 0 then
		local idx, pending = 0, #left
		for _ = 1, math.min(8, #left) do
			task.spawn(function()
				while true do
					idx = idx + 1
					local id = left[idx]
					if not id then break end
					local ok, nm = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
					if ok and nm then unameCache[id] = nm; out[tostring(id)] = nm end
					pending = pending - 1
				end
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 8 do task.wait(0.05) end
	end
	return out
end


