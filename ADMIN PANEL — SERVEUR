local function acSetOrRemove(store, userId, value)
	value = math.floor(tonumber(value) or 0)
	task.spawn(function()
		if value > 0 then
			pcall(function() store:SetAsync(tostring(userId), value) end)
		else
			pcall(function() store:RemoveAsync(tostring(userId)) end)
		end
	end)
end

