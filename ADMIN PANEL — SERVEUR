		profile.currentMultiplier = onlinePlayer:GetAttribute("PointsMultiplier")
		profile.friendCount = onlinePlayer:GetAttribute("FriendCount")
		local liveStreak = onlinePlayer:GetAttribute("FlameStreak")
		if type(liveStreak) == "number" then profile.flameStreak = liveStreak end
		local liveHigh = onlinePlayer:GetAttribute("FlameHighScore")
		if type(liveHigh) == "number" then profile.flameHighScore = liveHigh end
	end

	return profile
end

