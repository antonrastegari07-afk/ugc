adminEvent.OnServerEvent:Connect(function(adminPlayer, action, targetName, extraData)
	if not isAdmin(adminPlayer.UserId) then
		warn("🚫 Accès non autorisé: " .. adminPlayer.Name)
		return
	end
	if not checkRateLimit(adminPlayer.UserId, "action", 0.2) then return end
	if type(action) ~= "string" or #action > 30 then return end

	local cleanTarget = nil
	if targetName ~= nil then
		cleanTarget = validateString(targetName, 50)
		if not cleanTarget then return end
	end

	print(string.format("[ADMIN] %s → %s on %s (extra=%s)",
		adminPlayer.Name, action, tostring(cleanTarget), tostring(extraData)))

	local target = cleanTarget and getPlayerByName(cleanTarget) or nil
	
	-- ⚡ une action qui modifie un classement vide le cache des classements
	if action == "resetpoints" or action == "removefromlb" or action == "resetwarnings"
		or action == "clearflywarn" or action == "wipeflytest" or action == "wipeflyreal" then
		table.clear(orderedCache)
	end

	if action == "ban" then
		local userId = resolveUserId(targetName)
		if userId then
			-- 🚫 On passe par BanManager : ban réel + journal + fiche
			if _G.BanManager and _G.BanManager.Ban then
				pcall(function()
					_G.BanManager.Ban({
						userId     = userId,
						reason     = "admin",
						details    = "Ban via admin panel",
						duration   = -1,
						by         = adminPlayer.Name,
						displayMsg = "🚫 You got banned by an administrator.",
					})
				end)
			else
				-- Repli si BanManager n'est pas chargé
				pcall(function()
					banStore:SetAsync(tostring(userId), {
						reason = "Admin ban",
						bannedBy = adminPlayer.Name,
						timestamp = os.time()
					})
				end)
				if _G.AntiExploit and _G.AntiExploit.bannedPlayers then
					_G.AntiExploit.bannedPlayers[userId] = true
				end
				if target then target:Kick("🚫 You got banned by an administrator.") end
			end
		end

	elseif action == "unban" then
		local userId = resolveUserId(cleanTarget)
		if userId then
			if _G.BanManager and _G.BanManager.Unban then
				pcall(function() _G.BanManager.Unban(userId, adminPlayer.Name) end)
			else
				pcall(function() banStore:RemoveAsync(tostring(userId)) end)
				if _G.AntiExploit and _G.AntiExploit.bannedPlayers then
					_G.AntiExploit.bannedPlayers[userId] = nil
				end
				if _G.AntiFlyTP and _G.AntiFlyTP.Unban then
					pcall(function() _G.AntiFlyTP.Unban(userId) end)
				end
			end
		end

	elseif action == "kick" then
		if target then target:Kick("👟 You got kicked by an administrator.") end

	elseif action == "freeze" then
		if target and target.Character then
			local hrp = target.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				if frozenPlayers[target.UserId] then
					frozenPlayers[target.UserId]:Destroy()
					frozenPlayers[target.UserId] = nil
				else
					local bv = Instance.new("BodyVelocity")
					bv.Velocity = Vector3.zero
					bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
					bv.Parent = hrp
					frozenPlayers[target.UserId] = bv
				end
			end
		end

	elseif action == "teleport" then
		if target and target.Character then
			local adminChar = adminPlayer.Character
			local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
			if adminChar and targetHRP then
				local adminHRP = adminChar:FindFirstChild("HumanoidRootPart")
				if adminHRP then
					adminHRP.CFrame = targetHRP.CFrame * CFrame.new(3, 0, 0)
				end
			end
		end

	elseif action == "bring" then
		if target and target.Character and adminPlayer.Character then
			local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
			local adminHRP = adminPlayer.Character:FindFirstChild("HumanoidRootPart")
			if targetHRP and adminHRP then
				targetHRP.CFrame = adminHRP.CFrame * CFrame.new(0, 0, -4)
			end
		end

	elseif action == "reset" then
		if target and target.Character then
			local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then humanoid.Health = 0 end
		end

	elseif action == "fly" then
		if target then
			target:SetAttribute("AdminFly", not target:GetAttribute("AdminFly"))
			adminEvent:FireClient(target, "fly_toggle", adminPlayer.Name)
		end

	elseif action == "givetool" then
		local cleanTool = validateString(extraData, 50)
		if not cleanTool then return end
		if target then
			local tool = ServerStorage:FindFirstChild(cleanTool)
			if tool and tool:IsA("Tool") then
				local bp = target:FindFirstChild("Backpack")
				if bp then tool:Clone().Parent = bp end
			else
				warn("⚠️ Tool introuvable: " .. cleanTool)
			end
		end




	elseif action == "givetools" then
		-- 🎁 Don groupé : plusieurs outils × plusieurs joueurs, une fois ou en prêt
		if AdminToolGive then AdminToolGive(adminPlayer, extraData) end

	elseif action == "cancelloan" then
		-- ⏱️ Arrêt d'un prêt (extraData = numéro du prêt, ou "all")
		if AdminToolCancel then AdminToolCancel(adminPlayer, extraData) end
	elseif action == "tpcheckpoint" then
		local cpNum = validateInt(extraData, 1, 125)
		if not cpNum then return end
		if target and target.Character then
			local checkpoint = workspace:FindFirstChild("Checkpoint" .. cpNum)
			if checkpoint then
				local hrp = target.Character:FindFirstChild("HumanoidRootPart")
				if hrp then hrp.CFrame = checkpoint.CFrame * CFrame.new(0, 3, 0) end
			else
				warn("⚠️ Checkpoint introuvable: Checkpoint" .. cpNum)
			end
		end

	elseif action == "clearflywarn" then
		local userId = resolveUserId(cleanTarget)
		if userId and _G.AntiFlyTP and _G.AntiFlyTP.ResetWarnings then
			pcall(function() _G.AntiFlyTP.ResetWarnings(userId) end)
		elseif userId then
			task.spawn(function()
				pcall(function() ANTIFLY_STORE:RemoveAsync("aft_" .. userId) end)
			end)
		end

	elseif action == "resetwarnings" then
		local userId = resolveUserId(cleanTarget)
		if userId and _G.ResetWarnings then
			pcall(function() _G.ResetWarnings(userId) end)
		end

	elseif action == "toggletestlog" then
		if _G.AntiFlyTP and _G.AntiFlyTP.SetTestMode and _G.AntiFlyTP.IsTestMode then
			local cur = false
			pcall(function() cur = _G.AntiFlyTP.IsTestMode() == true end)
			pcall(function() _G.AntiFlyTP.SetTestMode(not cur) end)
			print(string.format("[ADMIN] %s a basculé le mode test AntiFlyTP → %s", adminPlayer.Name, tostring(not cur)))
		else
			warn("⚠️ AntiFlyTP.SetTestMode indisponible (moteur pas chargé ?)")
		end

	elseif action == "clearflytestlog" then
		local userId = resolveUserId(cleanTarget)
		if userId and _G.AntiFlyTP and _G.AntiFlyTP.ClearTestPlayer then
			pcall(function() _G.AntiFlyTP.ClearTestPlayer(userId) end)
		end

	elseif action == "wipeflytest" then
		if _G.AntiFlyTP and _G.AntiFlyTP.WipeTestAll then
			pcall(function() _G.AntiFlyTP.WipeTestAll("OUI") end)
			print(string.format("[ADMIN] %s a lancé WIPE TEST fly/tp", adminPlayer.Name))
		end

	elseif action == "wipeflyreal" then
		if _G.AntiFlyTP and _G.AntiFlyTP.WipeRealWarnings then
			pcall(function() _G.AntiFlyTP.WipeRealWarnings("OUI") end)
			print(string.format("[ADMIN] %s a lancé WIPE REAL warnings fly/tp", adminPlayer.Name))
		end

	elseif action == "resetpoints" then
		local userId = resolveUserId(cleanTarget)
		if not userId then return end
		local tgt = Players:GetPlayerByUserId(userId)
		if tgt then
			if _G.tempsJoueurs then
				_G.tempsJoueurs[userId] = { base = 0, future = 0, lastSaved = 0 }
			end
			local ls = tgt:FindFirstChild("leaderstats")
			local pts = ls and ls:FindFirstChild("Points")
			if pts then pts.Value = 0 end
			tgt:SetAttribute("Points", 0)
			if _G.LossGuard and _G.LossGuard.setLastSaved then
				pcall(function() _G.LossGuard.setLastSaved(userId, 0) end)
			end
			if _G.secureSave then
				task.spawn(function() pcall(function() _G.secureSave(userId, 0) end) end)
			end
		else
			task.spawn(function()
				pcall(function()
					PLAYER_DATA_STORE:UpdateAsync("p_" .. userId, function(old)
						if type(old) == "table" then old.points = 0 end
						return old
					end)
				end)
			end)
		end
		task.spawn(function()
			pcall(function()
				DataStoreService:GetOrderedDataStore("GlobalLeaderboard_Points_v3"):RemoveAsync(tostring(userId))
			end)
			if _G.DeletePlayerEntry == nil and _G.ForceRefresh then pcall(_G.ForceRefresh) end
		end)
		print(string.format("[ADMIN] %s a reset les points de %d", adminPlayer.Name, userId))

	elseif action == "removefromlb" then
		local userId = resolveUserId(cleanTarget)
		if userId and _G.DeletePlayerEntry then
			pcall(function() _G.DeletePlayerEntry(userId) end)
		elseif userId then
			for _, storeName in ipairs({
				"GlobalLeaderboard_Points_v3", "GlobalLeaderboard_Rebirths_v1",
				"GlobalLeaderboard_Streak_v1", "GlobalLeaderboard_Kills_v1",
				}) do
				task.spawn(function()
					pcall(function()
						DataStoreService:GetOrderedDataStore(storeName):RemoveAsync(tostring(userId))
					end)
				end)
			end
		end
	end
end)

