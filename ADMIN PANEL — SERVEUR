				if type(r.detections) == "table" then
					local bt = {}
					for k, v in pairs(r.detections) do bt[tostring(k)] = tonumber(v) or 0 end
					profile.tByType = bt
				end
				profile.tSimWarnings = r.simWarnings or profile.tSimWarnings
				profile.tWouldKick = r.wouldKick or profile.tWouldKick
				if r.wouldBan == true then profile.tWouldBan = true end
				profile.tWouldBanAt = r.wouldBanAt or profile.tWouldBanAt
				profile.tLastType = r.lastType
				profile.tFirstSeen = r.firstSeen or profile.tFirstSeen
				profile.tLastSeen = r.lastSeen or profile.tLastSeen
				if type(r.recent) == "table" then
					local rec = {}
					for _, e in ipairs(r.recent) do
						table.insert(rec, { t = e.t, kind = e.kind, vType = e.vType, details = e.details, count = e.count, action = e.action })
					end
					profile.tRecent = rec
				end
			end
