-- 🔔 POPUPS suivis. id = celui du PopupGate / de l'admin ▸ POPUPS.
--   kind : "buy"    → popup qui vend : affichages → fenêtres d'achat → achats → Robux
--          "ad"     → bouton de pub : affichages → pubs regardées
--          "reward" → popup qui DONNE quelque chose : affichages → récompenses prises
--          "social" → favori / event : affichages → acceptés (si Roblox le dit)
--   order = ordre d'affichage dans l'admin
local POPUPS = {
	vip_offer       = { order = 1, kind = "buy", label = "👑 Popup VIP (automatique)", src = "👑 Popup VIP (automatique)",
		desc = "S'ouvre tout seul toutes les X min chez les joueurs sans VIP." },
	skip_obby_auto  = { order = 2, kind = "buy", label = "⏭️ Pass Skip Obby (automatique)", src = "⏭️ Pass Skip Obby (automatique)",
