	{ id = "reset",        name = "🔄 RESET",     color = Color3.fromRGB(120, 60, 190) },
	{ id = "spectate",     name = "👁️ SPECTATE",  color = C.TURQUOISE_DARK },
	{ id = "fly",          name = "✈️ FLY",       color = C.BLUE },
	{ id = "givetool",     name = "🎁 GIVE",      color = C.ORANGE },
	{ id = "tpcheckpoint", name = "📍 TP CP",     color = C.GREEN },
	{ id = "profile",      name = "👤 PROFILE",   color = C.PURPLE },
