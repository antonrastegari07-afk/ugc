_G.SetRebirthCount = function(userId, count)
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		print("❌ Joueur non trouvé")
		return
	end

	playerRebirthCount[userId] = count

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local rebirthStat = leaderstats:FindFirstChild("Rebirths")
		if rebirthStat then
			rebirthStat.Value = count
		end
	end

	player:SetAttribute("RebirthCount", count)

	task.spawn(function()
		pcall(function()
			rebirthCountStore:SetAsync("rebirth_" .. userId, count)
		end)
	end)

	-- ✅ FIX : Forcer un save unifié immédiat pour persister dans PlayerData_v1
	-- (sinon legacy a la valeur mais unified reste stale jusqu'au prochain save)
	task.spawn(function()
		task.wait(0.5)  -- Laisser les autres operations se stabiliser
		local data = tempsJoueurs[userId]
		if data and type(data) == "table" then
			local total = data.base + data.future
			if secureSave(userId, total) then
				print(string.format("✅ Save unifié forcé pour SetRebirthCount %d", userId))
			end
		end
	end)

	print(string.format("✅ Rebirth count défini à %d pour %s", count, player.Name))
end


