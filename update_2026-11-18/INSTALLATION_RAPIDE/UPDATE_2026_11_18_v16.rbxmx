			<Item class="Folder" referent="RBX78">
				<Properties>
					<string name="Name">StarterPlayerScripts</string>
				</Properties>
				<Item class="LocalScript" referent="RBX79">
					<Properties>
						<bool name="Disabled">true</bool>
						<string name="Name"> ADMIN ABUSE — DÉGRADÉ SUR LE BOOST DU BILLBOARD</string>
						<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
--
--   🌈  ADMIN ABUSE — DÉGRADÉ SUR LE BOOST DU BILLBOARD
--   📍  StarterPlayer ▸ StarterPlayerScripts ▸ LocalScript
--
--   ┌──────────────────────────────────────────────────────────────────────┐
--   │  POURQUOI UN SCRIPT À PART PLUTÔT QU'UNE MODIFICATION DE            │
--   │  HeadBillboardsClient ?                                              │
--   │                                                                      │
--   │  Parce que ce fichier-là marche, qu'il est gros, et qu'il gère déjà  │
--   │  un cycle de vie délicat (le serveur DÉTRUIT et recrée TempsGui à    │
--   │  chaque respawn). Y greffer une deuxième logique, c'est risquer de   │
--   │  casser un effet qui fonctionne pour en ajouter un temporaire.       │
--   │                                                                      │
--   │  Ce script-ci se pose à côté, écoute UNE seule chose — l'attribut    │
--   │  AAEventBoost posé par le serveur d'événement — et se retire tout    │
--   │  seul. Si tu supprimes ce fichier, tout le reste continue comme      │
--   │  avant, à l'octet près.                                              │
--   └──────────────────────────────────────────────────────────────────────┘
--
--   L'effet : un dégradé multicolore qui GLISSE sur le texte du boost, pour
--   que le joueur voie d'un coup d'œil que son multiplicateur est dopé par
--   l'admin — et pas seulement plus grand.
--
--   ⚠️ Une instance ne peut porter qu'UN SEUL UIGradient. Le label de boost
--      en a peut-être déjà un (style VIP). On ne le remplace donc PAS : on
--      pose un TextLabel JUMEAU par-dessus, transparent, qui affiche le même
--      texte et porte notre dégradé. Sur un TextLabel, un UIGradient ne
--      colore que les GLYPHES — pas de rectangle, pas de débordement.
--
--════════════════════════════════════════════════════════════════════════════

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")

local LAYER_NAME = "AABoostRainbow"
local SPEED      = 1.45      -- tours par seconde du dégradé
local ATTR       = "AAEventBoost"

-- 🆕 Arc-en-ciel aussi pour TOUT boost de points temporaire (pas seulement l'Admin Abuse) :
--    boosts achetés, gagnés à la roue, offerts… → attribut TempBoostMult posé par le
--    serveur « boost temporaire » (répliqué à tout le monde, impossible à fausser côté client).
--    false = comportement d'avant (Admin Abuse seulement).
local ANY_TEMP_BOOST = true
local TEMP_ATTR      = "TempBoostMult"

--  Palette : celle du Config si présent, sinon une copie de secours. Ce
--  script doit pouvoir vivre même si le module n'est pas encore répliqué.
local RAINBOW
do
	local kp, src = {}, nil
	local mod = ReplicatedStorage:FindFirstChild("AdminAbuse_Config")
	if mod then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" and type(res.RAINBOW) == "table" then
			src = res.RAINBOW
		end
	end
	src = src or {
		{ 0.00, 255,  80,  80 }, { 0.17, 255, 190,  60 }, { 0.34, 250, 255,  90 },
		{ 0.50,  90, 255, 140 }, { 0.67,  90, 200, 255 }, { 0.84, 180, 130, 255 },
		{ 1.00, 255,  80,  80 },
	}
	for _, p in ipairs(src) do
		kp[#kp + 1] = ColorSequenceKeypoint.new(p[1], Color3.fromRGB(p[2], p[3], p[4]))
	end
	RAINBOW = ColorSequence.new(kp)
end

--══════════════════════════════════════════════════════════════════════════════
-- 🎞️ UNE SEULE BOUCLE POUR TOUS LES DÉGRADÉS
--══════════════════════════════════════════════════════════════════════════════
local live = {}   -- [UIGradient] = true

RunService.RenderStepped:Connect(function()
	local off = Vector2.new((os.clock() * SPEED) % 2 - 1, 0)
	for g in pairs(live) do
		if g:IsDescendantOf(game) then
			g.Offset = off
		else
			live[g] = nil
		end
	end
end)

--══════════════════════════════════════════════════════════════════════════════
-- 🔎 TROUVER LE LABEL DE BOOST
--    Chemin exact posé par ton script serveur de billboards :
--        Head ▸ TempsGui ▸ Frame ▸ BoostLabel
--══════════════════════════════════════════════════════════════════════════════
local function boostLabel(character)
	if not character then return nil end
	local head = character:FindFirstChild("Head")
	if not head then return nil end
	local gui = head:FindFirstChild("TempsGui")
	if not gui then return nil end
	local frame = gui:FindFirstChild("Frame")
	if not frame then return nil end
	local lbl = frame:FindFirstChild("BoostLabel")
	if lbl and lbl:IsA("TextLabel") then return lbl end
	return nil
end

local function removeLayer(lbl)
	if not lbl then return end
	local old = lbl:FindFirstChild(LAYER_NAME)
	while old do
		old:Destroy()
		old = lbl:FindFirstChild(LAYER_NAME)
	end
end

--  Les quatre garanties « le reflet ne déborde pas des lettres », reprises
--  telles quelles de ton HeadBillboardsClient :
--    1. BackgroundTransparency = 1 → aucune surface derrière le texte.
--    2. TextStrokeTransparency = 1 et aucun UIStroke → le dégradé ne bave
--       pas sur le contour, qui est plus large que le glyphe.
--    3. Font / TextScaled / TextSize / alignements recopiés → superposition
--       au pixel près, pas de texte fantôme dédoublé.
--    4. Un seul calque possible : on détruit l'ancien avant d'en poser un.
local function addLayer(lbl)
	if not lbl then return end
	if lbl:FindFirstChild(LAYER_NAME) then return end
	removeLayer(lbl)

	local twin = Instance.new("TextLabel")
	twin.Name                   = LAYER_NAME
	twin.BackgroundTransparency = 1
	twin.Size                   = UDim2.fromScale(1, 1)
	twin.Position               = UDim2.fromScale(0, 0)
	twin.Font                   = lbl.Font
	twin.TextScaled             = lbl.TextScaled
	if not lbl.TextScaled then twin.TextSize = lbl.TextSize end
	twin.TextXAlignment         = lbl.TextXAlignment
	twin.TextYAlignment         = lbl.TextYAlignment
	twin.TextColor3             = Color3.fromRGB(255, 255, 255)
	twin.TextStrokeTransparency = 1
	twin.TextTransparency       = 0
	twin.Text                   = lbl.Text
	twin.ZIndex                 = lbl.ZIndex + 2
	twin.Parent                 = lbl

	--  Le montant du boost change côté serveur : on recopie à chaque fois.
	local conn = lbl:GetPropertyChangedSignal("Text"):Connect(function()
		if twin.Parent then twin.Text = lbl.Text else return end
	end)
	twin.Destroying:Connect(function()
		if conn then conn:Disconnect() end
	end)

	local g = Instance.new("UIGradient")
	g.Color  = RAINBOW
	g.Parent = twin
	live[g]  = true
end

--══════════════════════════════════════════════════════════════════════════════
-- 👤 SUIVI D'UN JOUEUR
--    L'attribut AAEventBoost est posé par le SERVEUR sur l'objet Player : il
--    est donc répliqué à tout le monde, et tous les joueurs voient le boost
--    de celui qui l'a. Le client ne peut pas se le donner : un attribut posé
--    côté client ne part jamais vers le serveur ni vers les autres.
--══════════════════════════════════════════════════════════════════════════════
local function refresh(plr)
	local ch = plr.Character
	if not ch then return end
	local lbl = boostLabel(ch)
	if not lbl then return end
	local b = tonumber(plr:GetAttribute(ATTR)) or 0
	local t = ANY_TEMP_BOOST and (tonumber(plr:GetAttribute(TEMP_ATTR)) or 0) or 0
	if b > 0 or t > 0 then addLayer(lbl) else removeLayer(lbl) end
end

local function watchCharacter(plr, ch)
	if not ch then return end
	task.spawn(function()
		local head = ch:FindFirstChild("Head") or ch:WaitForChild("Head", 15)
		if not head then return end

		--  Ton script serveur DÉTRUIT puis recrée TempsGui (respawn, changement
		--  de style…). On ne devine pas : on écoute l'arrivée du nouveau.
		head.ChildAdded:Connect(function(child)
			if child.Name ~= "TempsGui" then return end
			task.delay(0.25, function()
				if plr.Character == ch then refresh(plr) end
			end)
		end)

		--  Première pose : on laisse au serveur le temps de construire.
		for _ = 1, 20 do
			if plr.Character ~= ch then return end
			if boostLabel(ch) then refresh(plr) return end
			task.wait(0.5)
		end
	end)
end

local function watch(plr)
	plr:GetAttributeChangedSignal(ATTR):Connect(function()
		pcall(refresh, plr)
	end)
	if ANY_TEMP_BOOST then
		plr:GetAttributeChangedSignal(TEMP_ATTR):Connect(function()
			pcall(refresh, plr)
		end)
	end
	plr.CharacterAdded:Connect(function(ch)
		watchCharacter(plr, ch)
	end)
	if plr.Character then watchCharacter(plr, plr.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do
	pcall(watch, p)
end
Players.PlayerAdded:Connect(function(p)
	pcall(watch, p)
end)]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX80">
					<Properties>
						<bool name="Disabled">true</bool>
						<string name="Name">1v1 cross server local</string>
						<ProtectedString name="Source"><![CDATA[--[[
	ServerBrowserDisplay (Client) — v5.2 (chargement tardif + restauration GUI)
	➜ À placer dans : StarterPlayer > StarterPlayerScripts  (LocalScript)
	➜ Supprime l'ancien script qui était DANS le model (sinon double prompt).
	Positions des displays : ReplicatedStorage/ServerBrowserAnchors (CFrameValue).
	  • Le script serveur doit publier ces positions ; un tag seul ne suffit pas.
	  • Les prompts locaux restent disponibles lorsque la zone se décharge.
	GUI attendu (1 seul, dans PlayerGui) :
	  ScreenGui  "Servers"
	    └ Frame "ShopFrame"
	        └ ScrollingFrame "ScrollingFrame"
	            └ Frame "Entrydemo"   (gabarit — cloné par serveur)
	NOUVEAU v5.1 : message "No other servers available" au lieu d'une page blanche.
--]]
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local UserInputService  = game:GetService("UserInputService")
local Lighting          = game:GetService("Lighting")
local Workspace         = game:GetService("Workspace")


-- Le menu et ses prompts ne dépendent pas du chargement de MapConfig.
local MapConfig = { Maps = {}, getByKey = function() return nil end }
local loadedMapModule
local function loadMapConfig(module)
	if not module or not module:IsA("ModuleScript") or loadedMapModule == module then return end
	loadedMapModule = module
	task.spawn(function()
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" and loadedMapModule == module then
			MapConfig = result
		elseif not ok then warn("[ServerBrowser] MapConfig : " .. tostring(result)) end
	end)
end
ReplicatedStorage.ChildAdded:Connect(function(child)
	if child.Name == "MapConfig" then loadMapConfig(child) end
end)
loadMapConfig(ReplicatedStorage:FindFirstChild("MapConfig"))

local localPlayer = Players.LocalPlayer
local playerGui   = localPlayer:WaitForChild("PlayerGui")
-- Une seule copie de cette version doit gérer l'interface.
local guard = playerGui:FindFirstChild("ServerBrowserController")
if guard and guard:IsA("ObjectValue") and guard.Value and guard.Value.Parent then return end
if guard then guard:Destroy() end
guard = Instance.new("ObjectValue")
guard.Name = "ServerBrowserController"
guard.Value = script
guard.Parent = playerGui

local isMobile    = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Remotes (non-bloquant : le menu s'affiche même sans serveur)
local getServersFn    = ReplicatedStorage:FindFirstChild("GetArenaServers")
local joinServerEvent = ReplicatedStorage:FindFirstChild("JoinArenaServer")
local joinFailedEvent = ReplicatedStorage:FindFirstChild("ArenaJoinFailed")

--========================================================
-- 🔧 RÉGLAGES
--========================================================
local FORCE_FAKE      = false  -- true = TOUJOURS la démo (test pur de l'UI)
local FAKE_WHEN_EMPTY = false  -- true = démo si la vraie liste est vide (Studio / 1 seul serveur)
local UNIFORM_SCALE   = true
local REF_W, REF_H    = 1100, 750
local MIN_SCALE       = 1.00
local MAX_SCALE       = 1.00
local USE_OVERLAY     = true
local AUTO_REFRESH    = 10
local MAX_PFP         = 6
local PFP_PADDING     = 4

--========================================================
-- 🧪 DONNÉES DÉMO
--========================================================
local FAKE_IDS = { localPlayer.UserId, 1, 2, 3, 156, 261 }
local function fakePlayers(count)
	local t = {}
	for i = 1, count do
		t[i] = { id = FAKE_IDS[((i - 1) % #FAKE_IDS) + 1], name = "Player" .. i }
	end
	return t
end
local function makeFakeServers()
	local presets = { 6, 3, 8, 1, 4, 2, 5, 7, 2, 6, 3, 8, 1, 4 }
	local mapKeys = {}
	for _, m in ipairs(MapConfig.Maps or {}) do table.insert(mapKeys, m.key) end
	local servers = {}
	for i, arena in ipairs(presets) do
		servers[i] = {
			fake    = true,
			jobId   = string.format("demo%d-aaaaaaaa", i),
			total   = arena + math.random(2, 9),
			arena   = arena,
			region  = ({"US","CA","FR","DE","BR","GB"})[((i - 1) % 6) + 1],
			map     = mapKeys[((i - 1) % math.max(#mapKeys, 1)) + 1],
			players = fakePlayers(arena),
		}
	end
	return servers
end

--========================================================
-- 🌫️ BLUR (frosted glass — 1 seul par joueur)
--========================================================
local blur = Lighting:FindFirstChild("ServerBrowserBlur")
if not blur then
	blur = Instance.new("BlurEffect")
	blur.Name    = "ServerBrowserBlur"
	blur.Enabled = true
	blur.Size    = 0
	blur.Parent  = Lighting
end

--========================================================
-- OVERLAY (curseur libre + bloque le tir + clic-dehors)
--========================================================
local overlayGui, overlayBtn
if USE_OVERLAY then
	overlayGui = Instance.new("ScreenGui")
	overlayGui.Name           = "ServerBrowserOverlay"
	overlayGui.ResetOnSpawn   = false
	overlayGui.IgnoreGuiInset = true
	overlayGui.DisplayOrder    = -1
	overlayGui.Enabled         = false
	overlayGui.Parent          = playerGui

	overlayBtn = Instance.new("TextButton")
	overlayBtn.Size                   = UDim2.fromScale(1, 1)
	overlayBtn.BackgroundTransparency = 1
	overlayBtn.AutoButtonColor        = false
	overlayBtn.Modal                  = true
	overlayBtn.Text                   = ""
	overlayBtn.Parent                 = overlayGui
end

--========================================================
-- 📐 RÉFÉRENCES UI (ton GUI) + responsive
--========================================================
local activeGui, shopFrame, scrolling, template, menuScale
local isOpen, autoToken = false, 0
local uiGeneration, animationToken = 0, 0
local pendingOpen = false
local setupGui, trySetupGui, close
local guiConnections = {}
local joinResets = {}
local function resetJoins()
	for _, reset in ipairs(joinResets) do reset() end
end
local function uiReady()
	return activeGui and activeGui.Parent == playerGui
		and shopFrame and shopFrame:IsDescendantOf(activeGui)
		and scrolling and scrolling:IsDescendantOf(shopFrame)
		and template ~= nil
end
local function track(connection)
	table.insert(guiConnections, connection)
	return connection
end
local responsiveFactor, animatingScale = 1, false

local function getViewport()
	local cam = Workspace.CurrentCamera
	if cam and cam.ViewportSize.Y > 1 then return cam.ViewportSize end
	return Vector2.new(1280, 720)
end
local function computeFactor()
	if not UNIFORM_SCALE then return 1 end
	local vp = getViewport()
	local s = math.min(vp.X / REF_W, vp.Y / REF_H)
	return math.clamp(s, MIN_SCALE, MAX_SCALE)
end
local function applyScale()
	responsiveFactor = computeFactor()
	if menuScale and not animatingScale then
		menuScale.Scale = responsiveFactor
	end
end

local camConn
local function hookCamera()
	local cam = Workspace.CurrentCamera
	if cam then
		if camConn then camConn:Disconnect() end
		camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	end
end

--========================================================
-- CARTE (clone de Entrydemo)
--========================================================
local function shortCode(jobId)
	local clean = (jobId or ""):gsub("-", "")
	return clean:sub(1, 8):upper()
end

local function trySet(entry, names, text)
	for _, n in ipairs(names) do
		local lbl = entry:FindFirstChild(n, true)
		if lbl and lbl:IsA("TextLabel") then lbl.Text = text; return true end
	end
	return false
end

local function fillAvatars(container, players, arena)
	for _, ch in ipairs(container:GetChildren()) do
		if ch:IsA("GuiObject") then ch:Destroy() end
	end
	container.BackgroundTransparency = 1
	container.BorderSizePixel        = 0
	for _, d in ipairs(container:GetChildren()) do
		if d:IsA("UIStroke") then d.Enabled = false end
	end

	local lay = container:FindFirstChildOfClass("UIListLayout") or Instance.new("UIListLayout")
	lay.FillDirection       = Enum.FillDirection.Horizontal
	lay.Padding             = UDim.new(0, PFP_PADDING)
	lay.VerticalAlignment   = Enum.VerticalAlignment.Center
	lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
	lay.SortOrder           = Enum.SortOrder.LayoutOrder
	lay.Parent              = container

	local shown, avatarFrames = 0, {}
	for i, p in ipairs(players) do
		if shown >= MAX_PFP then break end
		shown += 1
		local af = Instance.new("Frame")
		af.Name             = "PFP"
		af.BackgroundColor3 = Color3.fromRGB(70, 75, 86)
		af.BorderSizePixel  = 0
		af.LayoutOrder      = i
		af.Size             = UDim2.fromScale(1, 1)
		af.Parent           = container
		Instance.new("UICorner", af).CornerRadius = UDim.new(1, 0)
		local ring = Instance.new("UIStroke", af)
		ring.Color = Color3.fromRGB(255,255,255); ring.Thickness = 1.5; ring.Transparency = 0.35
		local img = Instance.new("ImageLabel")
		img.Size                   = UDim2.fromScale(1, 1)
		img.BackgroundTransparency = 1
		img.Image                  = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", p.id)
		img.Parent                 = af
		Instance.new("UICorner", img).CornerRadius = UDim.new(1, 0)
		avatarFrames[#avatarFrames+1] = af
	end

	local moreLabel
	if arena > shown then
		moreLabel = Instance.new("TextLabel")
		moreLabel.Name                 = "More"
		moreLabel.BackgroundTransparency = 1
		moreLabel.Text                 = "+" .. (arena - shown)
		moreLabel.Font                 = Enum.Font.GothamBold
		moreLabel.TextColor3           = Color3.fromRGB(120, 128, 142)
		moreLabel.TextScaled           = true
		moreLabel.LayoutOrder          = 999
		moreLabel.Size                 = UDim2.fromScale(1, 1)
		moreLabel.Parent               = container
	end

	local function resize()
		local h = container.AbsoluteSize.Y
		if h < 2 then return end
		local side = UDim2.fromOffset(h, h)
		for _, af in ipairs(avatarFrames) do af.Size = side end
		if moreLabel then moreLabel.Size = UDim2.fromOffset(math.floor(h * 1.4), h) end
	end

	task.spawn(function()
		local guard = 0
		while container.Parent and container.AbsoluteSize.Y < 2 and guard < 180 do
			task.wait(); guard += 1
		end
		if container.AbsoluteSize.Y < 2 then
			for _, af in ipairs(avatarFrames) do af.Size = UDim2.fromOffset(28, 28) end
			if moreLabel then moreLabel.Size = UDim2.fromOffset(40, 28) end
			warn("[ServerBrowser] 'Frameexemplepositionprofils' a une hauteur ~0 → avatars en taille fixe.")
		else
			resize()
		end
	end)
	container:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
end

local function buildCard(data, order)
	local arena   = data.arena or 0
	local total   = data.total or 0
	local players = data.players or {}

	local entry = template:Clone()
	entry.Name = "ServerCard"
	entry:SetAttribute("_serverCard", true)
	entry.LayoutOrder = order
	entry.Visible = false

	local countLabel = entry:FindFirstChild("Count", true)
	if countLabel and countLabel:IsA("TextLabel") then
		countLabel.Text = tostring(arena)
	end

	local pfpAnchor = entry:FindFirstChild("Frameexemplepositionprofils", true)
	if not pfpAnchor then
		for _, d in ipairs(entry:GetDescendants()) do
			if d:IsA("GuiObject") then
				local n = d.Name:lower()
				if n:find("profil") or n:find("pfp") or n:find("avatar") then
					pfpAnchor = d; break
				end
			end
		end
	end
	if pfpAnchor then
		fillAvatars(pfpAnchor, players, arena)
	else
		warn("[ServerBrowser] ⚠️ Cadre des avatars introuvable dans Entrydemo.")
	end

	local idLabel = entry:FindFirstChild("ServerID", true)
	if idLabel and idLabel:IsA("TextLabel") then
		idLabel.Text = "Server " .. shortCode(data.jobId)
	end

	local regionLabel = entry:FindFirstChild("Region", true)
	if regionLabel and regionLabel:IsA("TextLabel") then
		regionLabel.Text = data.region or "…"
	end

	local mapInfo
	if data.map and type(MapConfig.getByKey) == "function" then
		local ok, result = pcall(MapConfig.getByKey, data.map)
		if ok and type(result) == "table" then mapInfo = result end
	end
	local mapImage = entry:FindFirstChild("MapImage", true)
	if mapImage and mapImage:IsA("ImageLabel") then
		mapImage.Image = (mapInfo and mapInfo.Image) or ""
	end
	local mapNameLbl = entry:FindFirstChild("MapName", true)
	if mapNameLbl and mapNameLbl:IsA("TextLabel") then
		mapNameLbl.Text = (mapInfo and mapInfo.Name) or (data.map or "?")
	end

	trySet(entry, {"TotalCount","Total","InServer","ServerCount","Totalcount"}, total .. " in server")

	local joinBtn = entry:FindFirstChild("Joinbutton", true)
	if joinBtn and joinBtn:IsA("GuiButton") then
		local press = joinBtn:FindFirstChild("PressScale")
		if not press then press = Instance.new("UIScale"); press.Name = "PressScale"; press.Parent = joinBtn end
		joinBtn.MouseButton1Down:Connect(function() TweenService:Create(press, TweenInfo.new(0.08), {Scale = 0.93}):Play() end)
		joinBtn.MouseButton1Up:Connect(function()   TweenService:Create(press, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = 1}):Play() end)
		joinBtn.MouseLeave:Connect(function()       TweenService:Create(press, TweenInfo.new(0.12), {Scale = 1}):Play() end)

		local joining = false
		local originalText = joinBtn:IsA("TextButton") and joinBtn.Text
		local joinAttempt = 0
		local function resetJoin()
			joining = false
			joinAttempt += 1
			if joinBtn.Parent and originalText then joinBtn.Text = originalText end
		end
		table.insert(joinResets, resetJoin)
		joinBtn.Activated:Connect(function()
			if joining then return end
			if data.fake then
				TweenService:Create(press, TweenInfo.new(0.08), {Scale = 0.9}):Play()
				task.delay(0.1, function() if press then TweenService:Create(press, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = 1}):Play() end end)
				return
			end
			joinServerEvent = ReplicatedStorage:FindFirstChild("JoinArenaServer")
			if not joinServerEvent or not joinServerEvent:IsA("RemoteEvent") then
				warn("[ServerBrowser] JoinArenaServer indisponible (serveur non installé ?)")
				return
			end
			joining = true
			if joinBtn:IsA("TextButton") then joinBtn.Text = "..." end
			joinAttempt += 1
			local attempt = joinAttempt
			local ok, err = pcall(function() joinServerEvent:FireServer(data.jobId) end)
			if not ok then resetJoin(); warn("[ServerBrowser] Join : " .. tostring(err)); return end
			task.delay(15, function()
				if joining and attempt == joinAttempt then resetJoin() end
			end)
		end)
	end

	return entry
end

--========================================================
-- RENDER / REFRESH  (pagination : 10 par 10 + bouton "Load More")
--========================================================
local PAGE_SIZE     = 10
local currentCards  = {}
local sortedList    = {}
local renderedCount = 0
local loadMoreBtn   = nil
local emptyLabel    = nil   -- 🆕 message quand aucun serveur

local function destroyLoadMore()
	if loadMoreBtn then loadMoreBtn:Destroy(); loadMoreBtn = nil end
end

local function destroyEmpty()   -- 🆕
	if emptyLabel then emptyLabel:Destroy(); emptyLabel = nil end
end

local function clearCards()
	resetJoins()
	table.clear(joinResets)
	sortedList = {}
	destroyEmpty()          -- 🆕
	destroyLoadMore()
	for _, c in ipairs(currentCards) do c:Destroy() end
	table.clear(currentCards)
	renderedCount = 0
	if scrolling then
		for _, ch in ipairs(scrolling:GetChildren()) do
			if ch:GetAttribute("_serverCard") or ch:GetAttribute("_loadMore") then ch:Destroy() end
		end
	end
end

local appendPage -- forward declaration

local function buildLoadMore()
	destroyLoadMore()
	local remaining = #sortedList - renderedCount
	if remaining <= 0 then return end
	local btn = Instance.new("TextButton")
	btn:SetAttribute("_loadMore", true)
	btn.Name = "LoadMoreButton"; btn.LayoutOrder = 1000000
	btn.Size = UDim2.new(1, -20, 0, 44); btn.BackgroundColor3 = Color3.fromRGB(46, 50, 64)
	btn.AutoButtonColor = false; btn.Font = Enum.Font.FredokaOne
	btn.Text = string.format("Load More  (%d)", remaining)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255); btn.TextSize = 20; btn.Parent = scrolling
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
	local st = Instance.new("UIStroke", btn)
	st.Color = Color3.fromRGB(120, 128, 150); st.Thickness = 1.5; st.Transparency = 0.4
	btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 66, 84)}):Play() end)
	btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(46, 50, 64)}):Play() end)
	btn.Activated:Connect(function() appendPage(true) end)
	loadMoreBtn = btn
end

appendPage = function(animate)
	if not scrolling or not template then return end
	destroyLoadMore()
	local startIdx = renderedCount + 1
	local endIdx   = math.min(renderedCount + PAGE_SIZE, #sortedList)
	for i = startIdx, endIdx do
		local card = buildCard(sortedList[i], i)
		card.Parent = scrolling
		table.insert(currentCards, card)
		if animate then
			task.delay(0.035 * (i - startIdx), function()
				if card.Parent then card.Visible = true end
			end)
		else
			card.Visible = true
		end
	end
	renderedCount = endIdx
	buildLoadMore()
end

-- 🆕 affiche un message centré quand la liste est vide (au lieu d'une page blanche)
local function showEmptyState()
	destroyEmpty()
	emptyLabel = Instance.new("TextLabel")
	emptyLabel:SetAttribute("_serverCard", true) -- purgé par clearCards
	emptyLabel.Name                 = "EmptyState"
	emptyLabel.LayoutOrder          = 1
	emptyLabel.Size                 = UDim2.new(1, -20, 0, 90)
	emptyLabel.BackgroundTransparency = 1
	emptyLabel.Font                 = Enum.Font.FredokaOne
	emptyLabel.TextColor3           = Color3.fromRGB(150, 156, 170)
	emptyLabel.TextWrapped          = true
	emptyLabel.TextScaled           = true
	emptyLabel.Text                 = "No other servers available yet"
	emptyLabel.Parent               = scrolling
	local con = Instance.new("UITextSizeConstraint", emptyLabel)
	con.MaxTextSize = 22
end

local function render(list, animate)
	if not scrolling or not template then return end
	local keepCount = renderedCount
	clearCards()
	if #list == 0 then
		showEmptyState()   -- 🆕 plus de page blanche
		return
	end
	table.sort(list, function(a, b)
		local aArena, bArena = a.arena or 0, b.arena or 0
		if aArena ~= bArena then return aArena > bArena end
		return (a.total or 0) > (b.total or 0)
	end)
	sortedList = list
	-- 🩹 l'actualisation auto (toutes les 10 s) repartait à 10 serveurs : ceux chargés avec
	--    « Load More » disparaissaient. On réaffiche autant de serveurs qu'avant, sans bouger
	--    la position de défilement.
	local keep = (not animate) and keepCount or 0
	local keepPos = scrolling.CanvasPosition
	appendPage(animate)
	while renderedCount < math.min(keep, #sortedList) do appendPage(false) end
	if not animate then scrolling.CanvasPosition = keepPos end
end

-- Une requête en cours par RemoteFunction : pas d'accumulation si le serveur ne répond pas.
local inFlight = setmetatable({}, { __mode = "k" })
local lastListSig = nil   -- dernière liste affichée (pour ne pas tout reconstruire si rien n'a changé)
local function showStatus(message)
	if not uiReady() then return end
	if #currentCards == 0 then showEmptyState(); emptyLabel.Text = message end
end
local function normalizeList(raw)
	local list = {}
	for _, data in ipairs(raw) do
		if type(data) == "table" and type(data.jobId) == "string" then
			local item = table.clone(data)
			local function count(value)
				value = tonumber(value) or 0
				if value ~= value or math.abs(value) == math.huge then return 0 end
				return math.max(0, math.floor(value))
			end
			item.arena, item.total = count(data.arena), count(data.total)
			item.region = type(data.region) == "string" and data.region or "…"
			item.map = type(data.map) == "string" and data.map or nil
			item.players = {}
			if type(data.players) == "table" then
				for _, p in ipairs(data.players) do
					if type(p) == "table" and count(p.id) > 0 then
						table.insert(item.players, { id = count(p.id) })
					end
					if #item.players >= MAX_PFP then break end
				end
			end
			table.insert(list, item)
		end
	end
	return list
end
local function refresh(animate)
	if not isOpen or not uiReady() then return end
	if FORCE_FAKE then render(makeFakeServers(), animate); return end
	getServersFn = ReplicatedStorage:FindFirstChild("GetArenaServers")
	local remote = getServersFn
	if not remote or not remote:IsA("RemoteFunction") then
		showStatus("Server list unavailable. Retrying...")
		return
	end
	if inFlight[remote] then
		showStatus("Waiting for the server list...")
		return
	end
	local request = { gui = activeGui, generation = uiGeneration, session = autoToken }
	inFlight[remote] = request
	showStatus("Loading servers...")
	local function currentRequest()
		return isOpen and uiReady() and activeGui == request.gui
			and uiGeneration == request.generation and autoToken == request.session
	end
	task.delay(8, function()
		if inFlight[remote] == request and currentRequest() then
			showStatus("The server is taking too long. You can close this menu.")
		end
	end)
	task.spawn(function()
		local ok, result = pcall(function() return remote:InvokeServer() end)
		inFlight[remote] = nil
		if not currentRequest() or remote ~= ReplicatedStorage:FindFirstChild("GetArenaServers") then return end
		if not ok or type(result) ~= "table" then
			showStatus("Unable to load servers. Please try Refresh.")
			warn("[ServerBrowser] GetArenaServers : " .. tostring(result))
			return
		end
		local list = normalizeList(result)
		if #list == 0 and FAKE_WHEN_EMPTY then list = makeFakeServers() end
		-- ⚡ PERF : actualisation auto (toutes les 10 s) sans AUCUN changement → on ne reconstruit
		--    rien (avant : toutes les cartes étaient détruites et recréées à chaque fois).
		local parts = {}
		for _, it in ipairs(list) do
			local ids = {}
			for _, pp in ipairs(it.players or {}) do ids[#ids + 1] = tostring(pp.id) end
			parts[#parts + 1] = table.concat({ it.jobId, it.arena, it.total, it.region or "",
				it.map or "", table.concat(ids, ",") }, "|")
		end
		local sig = table.concat(parts, ";")
		if not animate and sig == lastListSig and #currentCards > 0 then return end
		lastListSig = sig
		local rendered, err = pcall(render, list, animate)
		if not rendered then
			warn("[ServerBrowser] Affichage : " .. tostring(err))
			clearCards()
			showStatus("Unable to display servers. Please try Refresh.")
		end
	end)
end

--========================================================
-- OPEN / CLOSE : état synchronisé avec la visibilité réelle du GUI
--========================================================
local function open()
	if not uiReady() then
		pendingOpen = true
		if trySetupGui then trySetupGui() end
		if not uiReady() then
			warn("[ServerBrowser] Menu en attente : Servers > ShopFrame > ScrollingFrame > Entrydemo")
			return
		end
	end
	pendingOpen = false
	if isOpen and activeGui.Enabled and shopFrame.Visible then return end
	isOpen = true
	autoToken += 1
	animationToken += 1
	local myToken, myAnimation = autoToken, animationToken
	if overlayGui then
		overlayGui.DisplayOrder = activeGui.DisplayOrder - 1
		overlayGui.Enabled = true
	end
	activeGui.Enabled = true
	shopFrame.Visible = true
	applyScale()
	if menuScale then
		animatingScale = true
		menuScale.Scale = responsiveFactor * 0.92
		local t = TweenService:Create(menuScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = responsiveFactor})
		t.Completed:Once(function()
			if animationToken == myAnimation then animatingScale = false end
		end)
		t:Play()
	end
	TweenService:Create(blur, TweenInfo.new(0.25), {Size = 18}):Play()
	refresh(true)
	task.spawn(function()
		while isOpen and myToken == autoToken do
			task.wait(AUTO_REFRESH)
			if isOpen and myToken == autoToken then refresh(false) end
		end
	end)
end
close = function(immediate)
	pendingOpen = false
	isOpen = false
	autoToken += 1
	animationToken += 1
	local token = animationToken
	TweenService:Create(blur, TweenInfo.new(0.2), {Size = 0}):Play()
	-- Libérer le bouton Modal dès la fermeture, même si l'animation est interrompue.
	if overlayGui then overlayGui.Enabled = false end
	local frame, gui = shopFrame, activeGui
	local function finish()
		if token ~= animationToken or isOpen then return end
		animatingScale = false
		if frame and frame.Parent then frame.Visible = false end
		if gui and gui.Parent then gui.Enabled = false end
	end
	if menuScale and menuScale.Parent and immediate ~= true then
		animatingScale = true
		local t = TweenService:Create(menuScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = responsiveFactor * 0.92})
		t.Completed:Once(finish)
		t:Play()
	else finish() end
end

--========================================================
-- SETUP DE TON GUI (réessayé si les descendants arrivent plus tard)
--========================================================
setupGui = function(gui)
	if not gui:IsA("ScreenGui") then return false end
	local newFrame = gui:FindFirstChild("ShopFrame", true)
	local newScrolling = newFrame and newFrame:FindFirstChild("ScrollingFrame", true)
	local original = newScrolling and newScrolling:FindFirstChild("Entrydemo", true)
	if not newFrame or not newFrame:IsA("GuiObject") or not newScrolling
		or not newScrolling:IsA("ScrollingFrame") or not original or not original:IsA("GuiObject") then return false end
	local cloned = original:Clone()
	if not cloned then return false end
	local wanted = pendingOpen
	close(true)
	pendingOpen = wanted
	for _, conn in ipairs(guiConnections) do conn:Disconnect() end
	table.clear(guiConnections)
	clearCards()
	if template then template:Destroy() end
	shopFrame, scrolling, menuScale = newFrame, newScrolling, nil
	gui.ResetOnSpawn = false
	gui.Enabled = false
	shopFrame.Visible = false
	uiGeneration += 1
	template = cloned
	template.Name = "EntryTemplate"
	template.Visible = true
	original.Visible = false -- garder le gabarit pour une réinitialisation ultérieure

	local listLayout = scrolling:FindFirstChildOfClass("UIListLayout")
	local gridLayout = scrolling:FindFirstChildOfClass("UIGridLayout")
	if not listLayout and not gridLayout then
		listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder           = Enum.SortOrder.LayoutOrder
		listLayout.Padding             = UDim.new(0, 10)
		listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		listLayout.Parent              = scrolling
	end

	scrolling.AutomaticCanvasSize  = Enum.AutomaticSize.None
	scrolling.ScrollingEnabled     = true
	scrolling.ScrollingDirection   = Enum.ScrollingDirection.Y
	if scrolling.ScrollBarThickness < 4 then scrolling.ScrollBarThickness = 6 end

	local canvasLayout = listLayout or gridLayout
	local canvasScrolling = scrolling
	local function syncCanvas()
		if not canvasLayout or not canvasScrolling.Parent then return end
		canvasScrolling.CanvasSize = UDim2.new(0, 0, 0, canvasLayout.AbsoluteContentSize.Y + 12)
	end
	track(canvasLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(syncCanvas))
	syncCanvas()

	if not scrolling:FindFirstChildOfClass("UIPadding") then
		local p = Instance.new("UIPadding", scrolling)
		p.PaddingTop = UDim.new(0, 6); p.PaddingBottom = UDim.new(0, 10)
	end

	if UNIFORM_SCALE then
		shopFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		shopFrame.Position    = UDim2.fromScale(0.5, 0.5)
		menuScale = shopFrame:FindFirstChildOfClass("UIScale")
		if not menuScale then menuScale = Instance.new("UIScale"); menuScale.Parent = shopFrame end
		hookCamera()
		applyScale()
	end

	local exitBtn = shopFrame:FindFirstChild("Exit", true)
	if exitBtn and exitBtn:IsA("GuiButton") then
		local ps = exitBtn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", exitBtn)
		track(exitBtn.MouseButton1Down:Connect(function() TweenService:Create(ps, TweenInfo.new(0.08), {Scale = 0.9}):Play() end))
		track(exitBtn.MouseButton1Up:Connect(function()   TweenService:Create(ps, TweenInfo.new(0.12, Enum.EasingStyle.Back), {Scale = 1}):Play() end))
		track(exitBtn.MouseLeave:Connect(function()       TweenService:Create(ps, TweenInfo.new(0.12), {Scale = 1}):Play() end))
		track(exitBtn.Activated:Connect(function() close() end))
	else
		warn("[ServerBrowser] Bouton 'Exit' introuvable dans ShopFrame")
	end

	local refreshBtn = shopFrame:FindFirstChild("Refresh", true)
	if refreshBtn and refreshBtn:IsA("GuiButton") then
		track(refreshBtn.Activated:Connect(function()
			refreshBtn.Rotation = 0
			TweenService:Create(refreshBtn, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {Rotation = 360}):Play()
			task.delay(0.4, function() if refreshBtn.Parent then refreshBtn.Rotation = 0 end end)
			refresh(true)
		end))
	else
		warn("[ServerBrowser] Bouton 'Refresh' introuvable dans ShopFrame")
	end

	activeGui = gui
	track(gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if isOpen and not gui.Enabled then close(true) end
	end))
	track(shopFrame:GetPropertyChangedSignal("Visible"):Connect(function()
		if isOpen and not shopFrame.Visible then close(true) end
	end))
	return true
end

--========================================================
-- SETUP D'UN DISPLAY (par model) — billboard + prompt
--========================================================
-- 📍 Le prompt vit sur une part LOCALE (créée par ce script) posée à la
--    position publiée par le serveur. Une part locale n'est JAMAIS déchargée
--    par le streaming → le prompt survit au départ/retour et aux swaps de map.
local localAnchors = Instance.new("Folder")
localAnchors.Name   = "ServerBrowserLocalAnchors"
localAnchors.Parent = Workspace

local function createDisplayAt(cf)
	local anchorPart = Instance.new("Part")
	anchorPart.Name         = "ServerBrowserAnchor"
	anchorPart.Size         = Vector3.new(1, 1, 1)
	anchorPart.Transparency = 1
	anchorPart.Anchored     = true
	anchorPart.CanCollide   = false
	anchorPart.CanTouch     = false
	anchorPart.CanQuery     = false
	anchorPart.CastShadow   = false
	anchorPart.CFrame       = cf
	anchorPart.Parent       = localAnchors

	local billboard = Instance.new("BillboardGui")
	billboard.Name           = "ServerBrowserHeadline"
	billboard.Size           = UDim2.fromScale(10, 3)
	billboard.StudsOffset    = Vector3.new(0, 6, 0)
	billboard.MaxDistance    = 70
	billboard.LightInfluence = 0
	billboard.Parent         = anchorPart

	local headline = Instance.new("TextLabel")
	headline.Size                   = UDim2.fromScale(1, 0.6)
	headline.BackgroundTransparency = 1
	headline.Text                   = "Find servers with players"
	headline.Font                   = Enum.Font.FredokaOne
	headline.TextColor3             = Color3.fromRGB(255, 254, 242)
	headline.TextScaled             = true
	headline.Parent                 = billboard
	local hStroke = Instance.new("UIStroke", headline)
	hStroke.Color = Color3.fromRGB(0,0,0); hStroke.Thickness = 3; hStroke.Transparency = 0

	local headSub = Instance.new("TextLabel")
	headSub.Size                   = UDim2.fromScale(1, 0.3)
	headSub.Position               = UDim2.fromScale(0, 0.66)
	headSub.BackgroundTransparency = 1
	headSub.Text                   = isMobile and "Tap to browse" or "Press E to browse"
	headSub.Font                   = Enum.Font.FredokaOne
	headSub.TextColor3             = Color3.fromRGB(248, 251, 240)
	headSub.TextScaled             = true
	headSub.Parent                 = billboard

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name                  = "ServerBrowserPrompt"
	prompt.ActionText            = "Browse Servers"
	prompt.ObjectText            = "1v1 Servers"
	prompt.KeyboardKeyCode       = Enum.KeyCode.E
	prompt.HoldDuration          = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight   = false
	prompt.Parent                = anchorPart

	prompt.Triggered:Connect(function(p)
		if p ~= localPlayer then return end
		open() -- idempotent : deux prompts ne peuvent pas ouvrir puis fermer aussitôt
	end)
	return anchorPart
end

--========================================================
-- BOOTSTRAP GUI (1 seul, par joueur) + filet anti-duplication au respawn
--========================================================
trySetupGui = function()
	if uiReady() then return end
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui.Name == "Servers" and gui:IsA("ScreenGui") then
			local ok, ready = pcall(setupGui, gui)
			if not ok then warn("[ServerBrowser] Setup : " .. tostring(ready)) end
			if ok and ready then
				if pendingOpen then open() end
				return
			end
		end
	end
end
local setupQueued = false
local function queueSetup()
	if setupQueued or uiReady() then return end
	setupQueued = true
	task.defer(function()
		setupQueued = false
		trySetupGui()
	end)
end
-- Écouter AVANT le scan ; aucune suppression d'un GUI encore incomplet.
playerGui.DescendantAdded:Connect(queueSetup)
playerGui.DescendantRemoving:Connect(function(obj)
	if obj == activeGui or obj == shopFrame or obj == scrolling then
		close(true)
		task.defer(queueSetup)
	end
end)
trySetupGui()
localPlayer.CharacterAdded:Connect(function() close(true) end)

-- Positions publiées par le serveur : écoute permanente, même après 30 secondes
-- ou si le dossier est remplacé lors d'un changement de carte.
local built = {}
local anchorFolder, folderAdded, folderRemoved
local function addAnchor(v)
	if not v:IsA("CFrameValue") or built[v] then return end
	local part = createDisplayAt(v.Value)
	built[v] = { part = part, connection = v.Changed:Connect(function(newCf)
		if part.Parent then part.CFrame = newCf end
	end) }
end
local function removeAnchor(v)
	local record = built[v]
	if record then record.connection:Disconnect(); record.part:Destroy() end
	built[v] = nil
end
local function syncAnchorFolder()
	local folder = ReplicatedStorage:FindFirstChild("ServerBrowserAnchors")
	if folder == anchorFolder then return end
	if folderAdded then folderAdded:Disconnect(); folderAdded = nil end
	if folderRemoved then folderRemoved:Disconnect(); folderRemoved = nil end
	for v in pairs(built) do removeAnchor(v) end
	anchorFolder = folder
	if not folder then return end
	folderAdded = folder.ChildAdded:Connect(addAnchor)
	folderRemoved = folder.ChildRemoved:Connect(removeAnchor)
	for _, v in ipairs(folder:GetChildren()) do addAnchor(v) end
end
ReplicatedStorage.ChildAdded:Connect(function(c)
	if c.Name == "ServerBrowserAnchors" then syncAnchorFolder() end
end)
ReplicatedStorage.ChildRemoved:Connect(function(c)
	if c == anchorFolder then syncAnchorFolder() end
end)
syncAnchorFolder()
task.delay(30, function()
	if not anchorFolder then warn("[ServerBrowser] ServerBrowserAnchors absent : vérifier le script serveur. Détection toujours active.") end
end)

--========================================================
-- CAMERA (re-hook si la caméra change)
--========================================================
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	hookCamera(); applyScale()
end)

--========================================================
-- WIRING global
--========================================================
if overlayBtn then
	overlayBtn.Activated:Connect(function() close() end)
end

local failureRemote, failureConn
local function syncRemotes()
	getServersFn = ReplicatedStorage:FindFirstChild("GetArenaServers")
	joinServerEvent = ReplicatedStorage:FindFirstChild("JoinArenaServer")
	joinFailedEvent = ReplicatedStorage:FindFirstChild("ArenaJoinFailed")
	if failureRemote ~= joinFailedEvent then
		if failureConn then failureConn:Disconnect(); failureConn = nil end
		failureRemote = joinFailedEvent
		if failureRemote and failureRemote:IsA("RemoteEvent") then
			failureConn = failureRemote.OnClientEvent:Connect(function()
				resetJoins()
				if isOpen then refresh(false) end
			end)
		end
	end
end
local remoteNames = { GetArenaServers = true, JoinArenaServer = true, ArenaJoinFailed = true }
ReplicatedStorage.ChildAdded:Connect(function(c)
	if remoteNames[c.Name] then syncRemotes(); if isOpen then refresh(false) end end
end)
ReplicatedStorage.ChildRemoved:Connect(function(c)
	if remoteNames[c.Name] then syncRemotes() end
end)
syncRemotes()

print("✅ ServerBrowserDisplay v5.2 chargé (GUI récupérable + anchors persistants)")
--========================================================
-- 🆕 OUVERTURE DEPUIS UN AUTRE SCRIPT (ex. EmptyArenaPrompt : « arène vide → autres serveurs »)
--    PlayerGui ▸ ServerBrowserController ▸ Open:Fire()   (même ouverture que le ProximityPrompt)
--========================================================
do
	local openEvent = guard:FindFirstChild("Open") or Instance.new("BindableEvent")
	openEvent.Name = "Open"
	openEvent.Parent = guard
	openEvent.Event:Connect(function() open() end)
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX81">
					<Properties>
						<bool name="Disabled">true</bool>
						<string name="Name">ArenaViewKeeper</string>
						<ProtectedString name="Source"><![CDATA[-- ════════════════════════════════════════════════════════════════════════
-- 🎯 ArenaViewKeeper — LocalScript dans StarterPlayer ▸ StarterPlayerScripts   (v3)
--
--  En arène PvP, SANS arme en main, tout est EXACTEMENT comme avec une arme,
--  sauf que le curseur (viseur) disparaît :
--   • même caméra : on reprend LES MÊMES calculs que la caméra des armes
--     (WeaponController : distance 11, hauteur 2, épaule 3,5, rehausse 3,5,
--     tangage ±70°, recul devant les murs, roulis du slide) ;
--   • mêmes réglages de rotation : souris, glisser au doigt, stick manette,
--     et ton réglage « sensibilité arme en main » ;
--   • AUCUN relais visible : quand tu ranges l'arme, on reprend la caméra dès
--     l'image suivante, là où elle était (l'arme ne la rend à Roblox que si
--     personne ne la reprend) ; quand tu ressors une arme, elle repart d'ici ;
--   • 1re personne : sur mobile / console comme avec une arme (vue tête) ;
--     sur PC, l'arme utilise déjà la caméra normale de Roblox → rien à faire ;
--   • B (manette : croix ←) change la vue, et le panneau des contrôles reste
--     affiché au même endroit : Shift Sprint · C Slide · B Views · H Hide Controls.
--     « Hide Controls » est retenu partout (toutes les armes + sans arme).
--   Hors de l'arène : rien ne change et le script ne fait rien.
--
--  v3 : la « garde souris » de DeathCam reconnaît maintenant cette vue (attribut ArenaViewKept) :
--       plus de curseur qui réapparaît ni de rotation qui saccade quand on tourne vite.
--
--  ↩️ REVENIR À AVANT : mets ENABLED = false ci-dessous (ou supprime ce script).
-- ════════════════════════════════════════════════════════════════════════
local ENABLED = true
local SHOW_CONTROLS = true   -- panneau Shift / C / B / H sans arme (PC). false = pas de panneau

if not ENABLED then return end

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local GuiService        = game:GetService("GuiService")

local player = Players.LocalPlayer
local WS = ReplicatedStorage:WaitForChild("WeaponSystem")
local Shared = require(WS:WaitForChild("WeaponSharedState"))
local IS_TOUCH = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local IS_MOBILE = Shared.IsMobile()
local IS_CONSOLE = GuiService:IsTenFootInterface()

-- ── mêmes valeurs que la caméra des armes (WeaponController) ──
local CAM_DISTANCE, CAM_HEIGHT = 11, 2
local CAM_SIDE, CAM_LIFT = 3.5, 3.5
local PITCH_MIN, PITCH_MAX = math.rad(-70), math.rad(70)
local MOUSE_SENS, DRAG_SENS = 0.005, 0.012     -- PCMobileSensitivity, MainDragSensitivity

local GP = { StickDeadzone = 0.15, StickCurve = 1.7, StickYawSpeed = 3.2, StickPitchSpeed = 2.2, ToggleView = Enum.KeyCode.DPadLeft }
local LOOK_ANYWHERE = true
pcall(function()
	local cs = require(WS:WaitForChild("CombatSettings", 10))
	if type(cs) == "table" then
		if type(cs.Gamepad) == "table" then for k, v in pairs(cs.Gamepad) do GP[k] = v end end
		if cs.Enabled == false or cs.MobileLookAnywhere == false then LOOK_ANYWHERE = false end
	end
end)

local function hipMult()   -- réglage « sensibilité arme en main » (même formule que les armes)
	local v = player:GetAttribute("SettingHipSensitivity")
	if type(v) ~= "number" then v = 50 end
	return math.clamp(0.3 + (v / 100) * 1.4, 0.2, 2)
end
local function inArena() return player:GetAttribute("InArena") == true end

--════════════════════════════════════════════════════════════
-- 📷 CAMÉRA
--════════════════════════════════════════════════════════════
local BIND = "ArenaViewKeeper"
local TOKEN = {}               -- notre « jeton » de propriétaire de caméra
local bound = false
local owning = false           -- on pilote la caméra en ce moment
local yaw, pitch = 0, 0
local saved = {}               -- ce qu'on a changé, pour le remettre exactement
local hiddenParts = {}         -- 1re personne : parts cachées localement
local dragInput, dragLast = nil, nil
local lastSentYaw, YAW_THRESH = nil, math.rad(0.5)
local padStick = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function wantMode()
	if Shared.IsThirdPersonLock() then return "lock" end
	if IS_MOBILE or IS_CONSOLE then return "first" end   -- PC 1re personne : caméra normale (comme les armes)
	return nil
end

local function setHidden(char, on)
	if on then
		for _, d in ipairs(char:GetDescendants()) do
			if (d:IsA("BasePart") or d:IsA("Decal")) and hiddenParts[d] == nil then
				hiddenParts[d] = d.LocalTransparencyModifier
				d.LocalTransparencyModifier = 1
			end
		end
	else
		for d, v in pairs(hiddenParts) do
			if d.Parent then d.LocalTransparencyModifier = v end
		end
		table.clear(hiddenParts)
	end
end

-- On rend la caméra à Roblox (sortie d'arène, mort, PC en 1re personne…)
local function release(restoreMouse)
	if not owning then return end
	owning = false
	local camera = workspace.CurrentCamera
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	setHidden(char, false)
	if Shared.CameraOwner() == TOKEN then
		Shared.ReleaseCamera(TOKEN)
		-- personne d'autre ne la tient : retour caméra normale, en gardant la direction
		local keep = camera.CFrame
		camera.CameraType = Enum.CameraType.Custom
		if hum then camera.CameraSubject = hum ; hum.AutoRotate = true end
		task.defer(function()
			if camera.CameraType == Enum.CameraType.Custom then camera.CFrame = keep end
		end)
		if restoreMouse and not IS_TOUCH then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
	end
	if saved.mouseDelta then UserInputService.MouseDeltaSensitivity = saved.mouseDelta end
	saved = {}
	player:SetAttribute("ArenaViewKept", nil)   -- lu par le bouton lock mobile (ShiftGUI)
end

local function step(dt)
	local camera = workspace.CurrentCamera
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local alive = hum and root and hum.Health > 0
	local mode = wantMode()

	-- une arme (ou une cinématique, l'écran de mort, un spectate) tient la caméra : on la laisse
	local owner = Shared.CameraOwner()
	local busy = Shared.AnyEquipped() or (owner ~= nil and owner ~= TOKEN)
		or camera:GetAttribute("KeepScriptable") or workspace:GetAttribute("AnimEditorFreeze")
	if not alive or busy or not mode then
		if owning then
			if owner ~= nil and owner ~= TOKEN then
				-- une arme vient de reprendre la caméra : on ne touche à RIEN (elle repart d'ici)
				owning = false
				setHidden(char, false)
				if saved.mouseDelta then UserInputService.MouseDeltaSensitivity = saved.mouseDelta end
				saved = {}
				player:SetAttribute("ArenaViewKept", nil)
			else
				release(true)
			end
		end
		return
	end

	if not owning then
		-- on prend le relais : on repart EXACTEMENT de l'orientation actuelle
		local sy, sp = Shared.GetCamera()
		local lv = camera.CFrame.LookVector
		local cy, cp = math.atan2(-lv.X, -lv.Z), math.asin(math.clamp(lv.Y, -1, 1))
		if sy and sp then
			local d = (sy - cy + math.pi) % (2 * math.pi) - math.pi
			if math.abs(d) < math.rad(25) and math.abs(sp - cp) < math.rad(25) then cy, cp = sy, sp end
		end
		yaw, pitch = cy, math.clamp(cp, PITCH_MIN, PITCH_MAX)
		Shared.ClaimCamera(TOKEN, root)   -- root : si le perso meurt, le jeton se libère tout seul
		saved.mouseDelta = UserInputService.MouseDeltaSensitivity
		UserInputService.MouseDeltaSensitivity = 1   -- comme les armes en vue lock
		owning = true
		lastSentYaw = nil
		player:SetAttribute("ArenaViewKept", true)
	end
	Shared.ClaimCamera(TOKEN, root)

	-- 🎮 stick droit (même courbe que les armes)
	if padStick then
		local x, y = padStick.X, padStick.Y
		local m = math.sqrt(x * x + y * y)
		local dz = GP.StickDeadzone or 0.15
		if m > dz then
			local k = (math.clamp((m - dz) / (1 - dz), 0, 1) ^ (GP.StickCurve or 1.7)) / m
			local mult = hipMult()
			yaw -= x * k * (GP.StickYawSpeed or 3.2) * dt * mult
			pitch = math.clamp(pitch + y * k * (GP.StickPitchSpeed or 2.2) * dt * mult, PITCH_MIN, PITCH_MAX)
		end
	end

	if camera.CameraType ~= Enum.CameraType.Scriptable then camera.CameraType = Enum.CameraType.Scriptable end
	if not IS_TOUCH and mode == "lock" then
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		-- 🖱️ seule différence avec une arme : pas de viseur
		if UserInputService.MouseIconEnabled then UserInputService.MouseIconEnabled = false end
	end
	pitch = math.clamp(pitch, PITCH_MIN, PITCH_MAX)
	local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local roll = CFrame.Angles(0, 0, Shared.GetCameraRoll())
	if mode == "first" then
		local headPos = root.Position + Vector3.new(0, 1.5, 0) + hum.CameraOffset
		camera.CFrame = CFrame.new(headPos) * rot * roll
		setHidden(char, true)
	else
		setHidden(char, false)
		local charPos = root.Position + Vector3.new(0, CAM_HEIGHT, 0)
		local lookAt = charPos + rot.RightVector * CAM_SIDE
		local desired = lookAt - rot.LookVector * CAM_DISTANCE + Vector3.new(0, CAM_LIFT, 0)
		rayParams.FilterDescendantsInstances = { char }
		local res = workspace:Raycast(lookAt, desired - lookAt, rayParams)
		local camPos = desired
		if res then camPos = res.Position + (lookAt - res.Position).Unit * 0.5 end
		camera.CFrame = CFrame.new(camPos, lookAt) * roll
	end
	-- le perso regarde où regarde la caméra (pas pendant la tyrolienne : elle pilote le perso)
	--  (même règle que les armes : on suit le moindre mouvement de la vue, 0,5°, et on corrige
	--   aussi si la physique a fait tourner le perso de plus de 2°)
	if not char:GetAttribute("Ziplining") then
		local rlv = root.CFrame.LookVector
		local d = (yaw - math.atan2(-rlv.X, -rlv.Z) + math.pi) % (2 * math.pi) - math.pi
		if lastSentYaw == nil or math.abs(yaw - lastSentYaw) > YAW_THRESH or math.abs(d) > math.rad(2) then
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
			root.AssemblyAngularVelocity = Vector3.zero
			lastSentYaw = yaw
		end
		if hum.AutoRotate then hum.AutoRotate = false end
	end
	-- 🔁 la prochaine arme reprend la caméra EXACTEMENT ici
	Shared.SetCamera(yaw, pitch)
end

-- ── rotation : souris / doigt / manette (mêmes réglages que les armes) ──
UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Thumbstick2 then padStick = input.Position end
	if not owning then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement and not IS_TOUCH then
		local m = hipMult()
		yaw -= input.Delta.X * MOUSE_SENS * m
		pitch = math.clamp(pitch - input.Delta.Y * MOUSE_SENS * m, PITCH_MIN, PITCH_MAX)
	elseif input.UserInputType == Enum.UserInputType.Touch and input == dragInput and dragLast then
		local np = Vector2.new(input.Position.X, input.Position.Y)
		local d = np - dragLast ; dragLast = np
		local m = hipMult()
		yaw -= d.X * DRAG_SENS * m
		pitch = math.clamp(pitch - d.Y * DRAG_SENS * m, PITCH_MIN, PITCH_MAX)
	end
end)
UserInputService.InputBegan:Connect(function(input)
	if not owning or input.UserInputType ~= Enum.UserInputType.Touch or dragInput then return end
	if Shared.IsTouchClaimed and Shared.IsTouchClaimed(input) then return end
	local camera = workspace.CurrentCamera
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	if not LOOK_ANYWHERE and pos.X < camera.ViewportSize.X * 0.5 then return end
	local pg = player:FindFirstChild("PlayerGui")
	if pg then
		for _, o in ipairs(pg:GetGuiObjectsAtPosition(pos.X, pos.Y)) do
			if o:IsA("GuiButton") or o:IsA("TextBox") then return end
			if LOOK_ANYWHERE and (o.Name:find("Thumbstick") or (o:FindFirstAncestor("TouchGui") and o.Name ~= "TouchControlFrame")) then return end
		end
	end
	if LOOK_ANYWHERE and not (pg and pg:FindFirstChild("TouchGui"))
		and pos.X < camera.ViewportSize.X * 0.4 and pos.Y > camera.ViewportSize.Y * 0.35 then return end
	dragInput, dragLast = input, pos
end)
UserInputService.InputEnded:Connect(function(input)
	if input == dragInput then dragInput, dragLast = nil, nil end
	if input.KeyCode == Enum.KeyCode.Thumbstick2 then padStick = nil end
end)

--════════════════════════════════════════════════════════════
-- ⌨️ PANNEAU DES CONTRÔLES SANS ARME (même look et même place que celui des armes)
--════════════════════════════════════════════════════════════
local panel, rows = nil, {}
local function controlsHidden() return player:GetAttribute("ControlsHidden") == true end
local function paintControls()
	if not panel then return end
	local hidden = controlsHidden()
	for key, r in pairs(rows) do
		if key ~= "H" then r.row.Visible = not hidden end
	end
	rows.H.desc.Text = hidden and "Reveal Controls" or "Hide Controls"
end
local function buildPanel()
	if panel or IS_TOUCH or not SHOW_CONTROLS then return end
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then return end
	local gui = Instance.new("ScreenGui")
	gui.Name = "UnarmedControlsGui"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = pg
	local anchor = Instance.new("Frame")   -- même emplacement que l'AmmoHud des armes
	anchor.BackgroundTransparency = 1
	anchor.Size = UDim2.new(0, 200, 0, 50)
	anchor.Position = UDim2.new(1, -265, 1, -60)
	anchor.Parent = gui
	local keys = {
		{ key = "Shift", action = "Sprint" }, { key = "C", action = "Slide" },
		{ key = "B", action = "Views" }, { key = "H", action = "Hide Controls" },
	}
	local chip, rowH = 22, 26
	local list = Instance.new("Frame")
	list.Name = "KeyInstructions"
	list.BackgroundTransparency = 1
	list.AnchorPoint = Vector2.new(0, 1)
	list.Size = UDim2.new(1, 0, 0, #keys * rowH)
	list.Position = UDim2.new(0, 0, 1, 0)
	list.Parent = anchor
	for i, k in ipairs(keys) do
		local row = Instance.new("Frame")
		row.Name = "Row_" .. k.key
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, chip)
		row.Position = UDim2.new(0, 0, 0, (i - 1) * rowH)
		row.Parent = list
		local cw = (#k.key > 1) and (chip + (#k.key - 1) * 9) or chip
		local group = Instance.new("Frame")
		group.BackgroundTransparency = 1
		group.Size = UDim2.new(0, cw + 6 + 80, 1, 0)
		group.AnchorPoint = Vector2.new(0.5, 0.5)
		group.Position = UDim2.new(0.5, 0, 0.5, 0)
		group.Parent = row
		local box = Instance.new("Frame")
		box.Size = UDim2.new(0, cw, 0, chip)
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.BackgroundColor3 = Color3.new(0, 0, 0)
		box.BackgroundTransparency = 0.4
		box.BorderSizePixel = 0
		box.Parent = group
		Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
		local bs = Instance.new("UIStroke") ; bs.Color = Color3.new(0, 0, 0) ; bs.Thickness = 1 ; bs.Parent = box
		local letter = Instance.new("TextLabel")
		letter.Size = UDim2.fromScale(1, 1)
		letter.BackgroundTransparency = 1
		letter.Text = k.key
		letter.TextColor3 = Color3.new(1, 1, 1)
		letter.TextStrokeTransparency = 0.4
		letter.Font = Enum.Font.GothamBold
		letter.TextSize = 14
		letter.Parent = box
		local desc = Instance.new("TextLabel")
		desc.Name = "Desc"
		desc.Size = UDim2.new(0, 80, 1, 0)
		desc.Position = UDim2.new(0, cw + 6, 0, 0)
		desc.BackgroundTransparency = 1
		desc.Text = k.action
		desc.TextColor3 = Color3.fromRGB(220, 220, 220)
		desc.TextStrokeTransparency = 0.3
		desc.Font = Enum.Font.GothamBold
		desc.TextSize = 13
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.Parent = group
		rows[k.key] = { row = row, desc = desc }
	end
	panel = gui
	paintControls()
end
player:GetAttributeChangedSignal("ControlsHidden"):Connect(paintControls)

local function unarmedInArena()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return inArena() and hum ~= nil and hum.Health > 0 and not Shared.AnyEquipped()
end
local function updatePanel()
	local on = unarmedInArena()
	if on then buildPanel() end
	if panel and panel.Enabled ~= on then panel.Enabled = on end
end

-- sans arme en arène : rien d'autre n'écoute B / H → c'est nous
UserInputService.InputBegan:Connect(function(input, gp)
	if gp or not unarmedInArena() then return end
	if (input.KeyCode == Enum.KeyCode.B and not IS_TOUCH) or input.KeyCode == GP.ToggleView then
		Shared.ToggleMode()   -- même fonction que les armes (le choix est aussi sauvegardé)
	elseif input.KeyCode == Enum.KeyCode.H and not IS_TOUCH then
		player:SetAttribute("ControlsHidden", not controlsHidden())   -- même état que les armes
	end
end)

--════════════════════════════════════════════════════════════
-- 🔌 ON / OFF selon l'arène
--════════════════════════════════════════════════════════════
local function frame(dt)
	updatePanel()
	step(dt)
end
local function refresh()
	if inArena() then
		if not bound then
			bound = true
			-- même priorité que la caméra des armes : la vue bouge avant le reste
			RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value, frame)
		end
	elseif bound then
		bound = false
		RunService:UnbindFromRenderStep(BIND)
		release(true)
		updatePanel()
	end
end
player:GetAttributeChangedSignal("InArena"):Connect(refresh)
player.CharacterAdded:Connect(function()
	if owning then release(false) end
	table.clear(hiddenParts)
end)
refresh()
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX82">
					<Properties>
						<bool name="Disabled">true</bool>
						<string name="Name">DeathCam</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DeathCam  (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > DeathCam

	Quand tu meurs en arène tué par un joueur, tu vois EXACTEMENT ce que voit ton tueur pendant 5 s :
	  • sa caméra, ses bras et son arme 1re personne image par image : TOUTES les pièces qui bougent
	    (barillet, chien, culasse, speedloader, cartouches, chargeur…) et celles qu'il voit cachées / visibles
	  • son flash de bouche sur SON arme 1re personne, ses douilles, ses traçantes, ses lumières
	  • son viseur (écartement, couleur), ses hitmarkers, ses chiffres de dégâts, sa lunette, ses munitions
	  • les sons que lui seul entend (touche, kill, manipulation…) ; les autres sons sont déjà au bon endroit
	  • une bande en bas : grande photo, nom, @, l'arme du kill en grand, PV restants, distance, headshot (doré si VIP)
	  • gros bouton vert RESPAWN : Espace, A / Croix à la manette, ou clic / toucher sur le bouton (après 0,4 s)
	Côté TUEUR, ce même script enregistre et envoie sa vue tant que quelqu'un la regarde (rien sinon).
	Souris : jamais bloquée au centre sans raison (arme en main / 1re personne / Maj-lock) — voir 🖱️ plus bas.
	Réglages : ReplicatedStorage/WeaponSystem/CombatSettings (sections Death / Style)
	  Death.MouseGuard = false → surveillance de la souris seulement pendant / juste après l'écran de mort
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local SoundService      = game:GetService("SoundService")
local Debris            = game:GetService("Debris")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local WS = ReplicatedStorage:WaitForChild("WeaponSystem")
local S  = require(WS:WaitForChild("CombatSettings"))
local CI = require(WS:WaitForChild("CombatInput"))
if S.Enabled == false or not S.Death or S.Death.Enabled == false then return end
local Codec = require(WS:WaitForChild("SpectateCodec"))
local D, ST = S.Death, S.Style
local FR = D.Frame or {}

local remotes       = ReplicatedStorage:WaitForChild("CombatRemotes")
local CombatEvent   = remotes:WaitForChild("CombatEvent")
local CombatRequest = remotes:WaitForChild("CombatRequest")
local Stream        = remotes:WaitForChild("SpectateStream")

local IS_TOUCH = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local function tryRequire(parent, name, timeout)
	local m = parent and parent:WaitForChild(name, timeout or 5)
	if not m then return nil end
	local ok, r = pcall(require, m)
	return ok and type(r) == "table" and r or nil
end
local VFX = tryRequire(WS, "WeaponVFX")
local FX2 = tryRequire(WS, "WeaponFX2")
local MZ = tryRequire(WS, "MuzzleFX")   -- flash Blender de la M4A1 sur toutes les armes

local KV = CI.KV
local state = nil          -- (victime) vue du tueur en cours
local replaying = false    -- (victime) on rejoue un effet du tueur : rien n'est filtré ni enregistré

---------------------------------------------------------------------
-- 🧰 outils
---------------------------------------------------------------------
local PLAIN = {
	boolean = true, Color3 = true, Vector3 = true, Vector2 = true, UDim2 = true, UDim = true, CFrame = true,
	EnumItem = true, NumberSequence = true, ColorSequence = true, NumberRange = true, Font = true,
}
-- copie envoyable par le réseau (pas de fonctions, pas de clés mélangées)
local function sanitize(v, lvl)
	local tv = typeof(v)
	if tv == "number" then return (v == v) and v or nil end
	if tv == "string" then return (#v <= 300) and v or nil end
	if PLAIN[tv] then return v end
	if tv == "Instance" then return v end
	if tv == "table" and (lvl or 0) < 5 then
		local out, n = {}, 0
		local isArray = #v > 0
		for k, x in pairs(v) do
			n += 1
			if n > 80 then break end
			if (isArray and type(k) == "number") or (not isArray and type(k) == "string") then
				local s = sanitize(x, (lvl or 0) + 1)
				if s ~= nil then out[k] = s end
			end
		end
		return out
	end
	return nil
end

local function frac(pos)
	local vp = workspace.CurrentCamera.ViewportSize
	if typeof(pos) ~= "Vector2" and typeof(pos) ~= "Vector3" then return nil end
	return { x = pos.X / math.max(vp.X, 1), y = pos.Y / math.max(vp.Y, 1) }
end

-- ⚡ LAG PVP — tables lourdes (style de traçante ≈ 20 champs, config de hitmarker, options de douille,
--    palette du flash…). Avant : recopiées EN ENTIER dans chaque effet, à chaque tir, sur le canal fiable
--    du tueur pendant qu'il se bat encore. Maintenant : envoyées UNE fois par vue (rappel toutes les 3 s),
--    puis un simple numéro. La victime garde la copie (voir « KVE » plus bas).
local tcache = { obj = setmetatable({}, { __mode = "k" }), sig = {}, sent = {}, n = 0 }
local instIds, instN = setmetatable({}, { __mode = "k" }), 0
local function sigOf(v, depth)
	local tv = typeof(v)
	if tv == "Instance" then   -- deux objets du même nom ne doivent jamais se confondre
		local i = instIds[v]
		if not i then instN += 1; i = instN; instIds[v] = i end
		return "I:" .. i
	end
	if tv ~= "table" then return tv .. ":" .. tostring(v) end
	if (depth or 0) > 4 then return "{}" end
	local keys = {}
	for k in pairs(v) do keys[#keys + 1] = k end
	table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
	local out = table.create(#keys)
	for i, k in ipairs(keys) do out[i] = tostring(k) .. "=" .. sigOf(v[k], (depth or 0) + 1) end
	return "{" .. table.concat(out, ",") .. "}"
end
local function shared(v)
	if type(v) ~= "table" then return sanitize(v) end
	local now = os.clock()
	local id = tcache.obj[v]
	if id and now - (tcache.sent[id] or 0) < 3 then return { __r = id } end
	local s = sanitize(v)
	if type(s) ~= "table" then return s end
	local sg = sigOf(s)
	id = tcache.sig[sg]
	if not id then
		tcache.n = (tcache.n % 60000) + 1
		id = tcache.n
		tcache.sig[sg] = id
	end
	tcache.obj[v] = id
	if now - (tcache.sent[id] or 0) < 3 then return { __r = id } end
	tcache.sent[id] = now
	return { __r = id, __v = s }
end
local function resetShared()
	tcache.obj = setmetatable({}, { __mode = "k" })
	table.clear(tcache.sig); table.clear(tcache.sent)
end

---------------------------------------------------------------------
-- 📼 CÔTÉ TUEUR : enregistrement de sa vue (seulement pendant qu'une victime la regarde)
---------------------------------------------------------------------
local rec = { map = {}, vparts = {}, rest = {}, mid = 0, setups = setmetatable({}, { __mode = "k" }), light = 0 }

local function ref(a)
	local ta = typeof(a)
	if ta == "Vector3" then return { p = a } end
	if ta == "Instance" then
		local i = rec.map[a]
		if i then return { v = i, m = rec.mid } end
		return { i = a }
	end
	return nil
end
local function push(kind, data) CI.KVPush(kind, data) end
-- l'effet est-il sur TON arme (1re personne ou ton perso) ? (pas celui d'un autre joueur que tu vois)
local function ownAnchor(a)
	if typeof(a) ~= "Instance" then return false end
	if rec.map[a] then return true end
	local ch = player.Character
	local cam = workspace.CurrentCamera
	return (ch ~= nil and a:IsDescendantOf(ch)) or (cam ~= nil and a:IsDescendantOf(cam))
end

-- (victime) l'effet vient-il du VRAI perso du tueur (3e personne) pendant qu'on est dans sa tête ?
-- → on le cache : on voit à la place celui de son arme 1re personne, comme lui.
local function killerOwned(x)
	local st = state
	if replaying or not st or not st.hidden then return false end
	local kc = st.killer.Character
	local tx = typeof(x)
	local arms = st.hideMode == "arms"   -- 3e personne : seuls ses bras + son arme sont remplacés
	if tx == "Instance" then
		if x == st.killer then return true end
		if st.sharedModel ~= nil and x:IsDescendantOf(st.sharedModel) then return true end
		if not kc then return false end
		if arms then
			local tool = kc:FindFirstChildOfClass("Tool")
			local ra, la = kc:FindFirstChild("Right Arm"), kc:FindFirstChild("Left Arm")
			return (tool ~= nil and (x == tool or x:IsDescendantOf(tool))) or (ra ~= nil and (x == ra or x:IsDescendantOf(ra)))
				or (la ~= nil and (x == la or x:IsDescendantOf(la)))
		end
		return x:IsDescendantOf(kc)
	elseif (tx == "Vector3" or tx == "CFrame") and kc then
		local ref = arms and (kc:FindFirstChild("Right Arm")) or kc:FindFirstChild("Head")
		local p = (tx == "CFrame") and x.Position or x
		return ref ~= nil and (ref.Position - p).Magnitude < (arms and 4 or 5)
	end
	return false
end

-- (tueur) le flash est-il remplacé par celui du GunKit (son enveloppe l'avale) ?
local function gkSwallow(a)
	local own = VFX and VFX.__GunKitOwner
	if type(own) ~= "function" or typeof(a) ~= "Instance" then return false end
	local ok, mod, _, t = pcall(own, a)
	return ok and mod ~= nil and typeof(t) == "Instance" and t:GetAttribute("GunKitMuzzle") ~= false
end

-- Enveloppes des effets : E = { sup = (victime) cacher l'effet ?, rec = (tueur) l'enregistrer, g = famille }.
-- Si l'effet passe par plusieurs enveloppes (la tienne + celle du GunKit + la nôtre), il est enregistré UNE
-- fois, au plus près de l'effet réellement joué (l'enveloppe intérieure a priorité).
local mine = setmetatable({}, { __mode = "k" })
-- profondeur d'appel + « déjà enregistré à l'intérieur », par fil d'exécution (un effet qui attend ne mélange rien)
local threads = setmetatable({}, { __mode = "k" })
local function wrap(tbl, key, E)
	if type(tbl) ~= "table" then return end
	local cur = rawget(tbl, key)
	if type(cur) ~= "function" or mine[cur] then return end
	local w = function(...)
		if replaying then return cur(...) end
		local co = coroutine.running()
		local T = threads[co]
		if not T then T = { depth = 0, hit = {} }; threads[co] = T end
		if T.depth == 0 then
			if E.sup then
				local ok, skip = pcall(E.sup, ...)
				if ok and skip then return nil end
			end
			T.hit[E.g] = false
			T.depth = 1
			local r = table.pack(pcall(cur, ...))
			T.depth = 0
			if KV.rec and not T.hit[E.g] then pcall(E.rec, ...) end
			T.hit[E.g] = false
			if not r[1] then error(r[2], 0) end
			return table.unpack(r, 2, r.n)
		end
		if KV.rec then
			local ok, did = pcall(E.rec, ...)
			if ok and did then T.hit[E.g] = true end
		end
		T.depth += 1
		local r = table.pack(pcall(cur, ...))
		T.depth -= 1
		if not r[1] then error(r[2], 0) end
		return table.unpack(r, 2, r.n)
	end
	mine[w] = true
	tbl[key] = w
end

local H = {}
H.SetupMuzzle = { g = "setup",
	-- toujours retenu (le viewmodel est préparé AVANT qu'on regarde le tueur)
	sup = function(flash, scale, palette)
		if typeof(flash) == "Instance" then rec.setups[flash] = { s = scale, p = sanitize(palette) } end
		return false
	end,
	rec = function(flash, scale, palette)
		if rec.map[flash] then push("su", { a = ref(flash), s = scale, p = shared(palette) }) end
		return true
	end }
H.EmitMuzzle = { g = "muzzle", sup = function(flash) return killerOwned(flash) end, rec = function(flash, withSmoke)
	if not ownAnchor(flash) or gkSwallow(flash) then return false end
	push("em", { a = ref(flash), sm = withSmoke and true or false })
	return true
end }
H.StarFlash = { g = "star", sup = function(anchor) return killerOwned(anchor) end, rec = function(anchor, palette, scale)
	if not ownAnchor(anchor) or gkSwallow(anchor) then return false end
	push("sf", { a = ref(anchor), p = shared(palette), s = scale })
	return true
end }
H.Tracer = { g = "tracer", sup = function(a, _, _, key) return killerOwned(key) or (key == nil and killerOwned(a)) end,
rec = function(a, b, T, key)
	if typeof(key) ~= "Instance" or not key:IsA("Tool") or key.Parent ~= player.Character then return false end
	push("tr", { a = a, b = b, T = shared(T) })
	return true
end }
H.HeadshotMarker = { g = "hm", rec = function(_, pos, M) push("hm", { pos = frac(pos), M = shared(M) }); return true end }
H.KillMarker = { g = "km", rec = function(_, pos, KM) push("km", { pos = frac(pos), M = shared(KM) }); return true end }
local H2 = {}
H2.Flash = { g = "bolt", sup = function(host) return killerOwned(host) end, rec = function(host, c1, c2, scale)
	if not ownAnchor(host) or gkSwallow(host) then return false end
	push("fl", { a = ref(host), c1 = c1, c2 = c2, s = scale })
	return true
end }
H2.Shell = { g = "shell", sup = function(cf) return killerOwned(cf) end, rec = function(cf, vel, o)
	-- seulement TES douilles (celles des autres joueurs naissent à leur arme)
	local cam = workspace.CurrentCamera
	if typeof(cf) ~= "CFrame" or not cam then return false end
	local refPos = (rec.mode == "third" and rec.vh and rec.vh.Parent) and rec.vh.Position or cam.CFrame.Position
	if (cf.Position - refPos).Magnitude > 8 then return false end
	push("sh", { cf = cf, v = vel, o = shared(o) })
	return true
end }
H2.Drop = { g = "drop", rec = function(src, cf, vel, o)
	if not ownAnchor(src) then return false end
	push("dr", { a = ref(src), cf = cf, v = vel, o = shared(o) })
	return true
end }

-- flash MuzzleFX : enregistré chez le tueur (son arme), rejoué chez toi sur sa copie
H.MZShot = { g = "mz", sup = function(_, host) return killerOwned(host) end,
rec = function(tool, host, fp, cfg, _, opts)
	if (type(opts) == "table" and opts.remote) or not ownAnchor(host) then return false end
	if MZ and MZ.ClassOf(tool, cfg) == "None" then return false end
	-- arme GunKit : son flash passe par l'événement « gk »
	if typeof(tool) == "Instance" and tool:GetAttribute("GunKitMuzzle") == true then return false end
	push("mz", { a = ref(host), fp = fp and true or false })
	return true
end }

local gkMods = {}   -- [nom de l'arme GunKit] = module MuzzleFlash
local function installWrappers()
	if VFX then
		for k, E in pairs(H) do wrap(VFX, k, E) end
		-- le GunKit garde tes fonctions d'origine : on enveloppe aussi celles-là (effet réellement joué)
		local O = rawget(VFX, "__GunKitOrig")
		if type(O) == "table" then
			wrap(O, "Emit", H.EmitMuzzle); wrap(O, "Star", H.StarFlash); wrap(O, "Tracer", H.Tracer)
			wrap(O, "FX2", H2.Flash)
		end
	end
	if FX2 then for k, E in pairs(H2) do wrap(FX2, k, E) end end
	if type(MZ) == "table" then wrap(MZ, "Shot", H.MZShot) end
	local gk = ReplicatedStorage:FindFirstChild("GunKit")
	local guns = gk and gk:FindFirstChild("Guns")
	if guns then
		for _, g in ipairs(guns:GetChildren()) do
			local mf = g:FindFirstChild("MuzzleFlash")
			if mf and mf:IsA("ModuleScript") and gkMods[g.Name] == nil then
				local ok, MF = pcall(require, mf)
				gkMods[g.Name] = (ok and type(MF) == "table") and MF or false
			end
			local MF = gkMods[g.Name]
			if MF then
				local name = g.Name
				-- flash GunKit = famille « star » : remplace ton StarFlash sur ton arme GunKit
				wrap(MF, "Emit", { g = "star", sup = function(host) return killerOwned(host) end,
				rec = function(host, fp, smoke)
					if MF._remote or not ownAnchor(host) then return false end   -- flash d'un autre joueur
					push("gk", { a = ref(host), fp = fp and true or false, sm = smoke and true or false, g = name })
					return true
				end })
			end
		end
	end
end
task.spawn(function()
	while true do
		pcall(installWrappers)
		task.wait(1)
	end
end)

-- 🔊 sons que le tueur est seul à entendre (joués chez lui : touche, kill, manipulation…)
local soundConns = setmetatable({}, { __mode = "k" })
local function watchSound(s)
	if not s:IsA("Sound") or soundConns[s] then return end
	soundConns[s] = s.Played:Connect(function()
		if not KV.rec or D.KillerSounds == false or s.Looped then return end
		if s.TimeLength > 12 then return end   -- musique / ambiance
		push("snd", { id = s.SoundId, v = s.Volume, sp = s.PlaybackSpeed, tp = s.TimePosition })
	end)
end
local function watchTree(root)
	for _, d in ipairs(root:GetDescendants()) do watchSound(d) end
	root.DescendantAdded:Connect(watchSound)
end
watchTree(SoundService)
local watchedCam
local function watchCam()
	local cam = workspace.CurrentCamera
	if cam and cam ~= watchedCam then watchedCam = cam; watchTree(cam) end
end
watchCam()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCam)

-- ── viewmodel du tueur ↔ pièces de son vrai Tool (même arbre : le viewmodel est un clone du Tool)
local function mapViewmodel(vm, tool)
	local out = {}
	local function walk(vParent, tParent, top)
		local byName = {}
		for _, c in ipairs(tParent:GetChildren()) do
			local l = byName[c.Name]
			if not l then l = {}; byName[c.Name] = l end
			table.insert(l, c)
		end
		local count = {}
		for _, c in ipairs(vParent:GetChildren()) do
			if #out >= Codec.MaxParts then return end
			local list = byName[c.Name]
			if list then
				local k = (count[c.Name] or 0) + 1
				count[c.Name] = k
				local t = list[k]
				if t and t.ClassName == c.ClassName then
					if c:IsA("BasePart") then table.insert(out, { c, t }) end
					walk(c, t, false)
				end
			end
		end
	end
	walk(vm, tool, true)
	return out
end

local function differs(a, b)
	return (a.Position - b.Position).Magnitude > 0.004 or a.LookVector:Dot(b.LookVector) < 0.99999
		or a.UpVector:Dot(b.UpVector) < 0.99999
end

local function hudCfg(tool)
	local e = KV.tools[tool]
	if not e or type(e.cfg) ~= "table" then return nil end
	local cfg = e.cfg
	return sanitize({
		cursor = cfg.Cursor, head = cfg.Headshot, cross = cfg.Crosshair, rhud = cfg.ReloadHUD,
		clip = cfg.ClipSize, style = cfg.Reload and cfg.Reload.Style,
		scope = cfg.ADS and cfg.ADS.Scope and true or false, tint = cfg.ADS and cfg.ADS.ScopeTint,
		mobile = e.mobile, optic = tool:GetAttribute("Optic"), gun = tool:GetAttribute("Gun"),
	})
end

local lightConn
-- mode « vm » : arme 1re personne (viewmodel dans la caméra) ; mode « third » : sa vraie arme + ses vrais bras
-- en 3e personne (ce que SON écran montre, bras et pièces posés chez lui, pas la version réseau)
local function sendManifest(mode, src, tool, ch)
	rec.mid = (rec.mid % 60000) + 1
	rec.mode, rec.vm, rec.tool, rec.optic = mode, src, tool, tool:GetAttribute("Optic")
	if mode == "vm" then
		rec.armR, rec.armL, rec.vh = src:FindFirstChild("Right Arm"), src:FindFirstChild("Left Arm"), src:FindFirstChild("Handle")
	else
		rec.armR, rec.armL, rec.vh = ch:FindFirstChild("Right Arm"), ch:FindFirstChild("Left Arm"), tool:FindFirstChild("Handle")
	end
	table.clear(rec.map); table.clear(rec.vparts); table.clear(rec.rest)
	local th = tool:FindFirstChild("Handle")
	local pairsList
	if mode == "vm" then
		pairsList = mapViewmodel(src, tool)
	else
		pairsList = {}
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("BasePart") and #pairsList < Codec.MaxParts then table.insert(pairsList, { d, d }) end
		end
	end
	local list, setups = {}, {}
	for i, pr in ipairs(pairsList) do
		local c, t = pr[1], pr[2]
		rec.map[c] = i
		rec.vparts[i] = c
		local rest = (th and rec.vh) and th.CFrame:ToObjectSpace(t.CFrame) or CFrame.identity
		rec.rest[i] = rest
		local bt = (c.Transparency < 0.98 and c.Transparency) or (t.Transparency < 0.98 and t.Transparency) or 0
		list[i] = { p = t, r = rest, b = bt }
		local su = rec.setups[c]
		if su then table.insert(setups, { i = i, s = su.s, p = su.p }) end
	end
	rec.handleIdx = rec.vh and rec.map[rec.vh] or nil
	-- lumières posées sur l'arme (lumière de bouche…)
	if lightConn then lightConn:Disconnect() end
	lightConn = src.DescendantAdded:Connect(function(d)
		if not KV.rec or not d:IsA("Light") or not rec.map[d.Parent] then return end
		rec.light += 1
		local id = rec.light
		push("lt", { a = ref(d.Parent), id = id, cls = d.ClassName, c = d.Color, b = d.Brightness, r = d.Range,
			sh = d.Shadows })
		d.AncestryChanged:Connect(function(_, parent)
			if not parent and KV.rec then push("ltx", { id = id }) end
		end)
	end)
	CombatRequest:FireServer("KVM", {
		id = rec.mid, tool = tool, list = list, h = rec.handleIdx, third = mode == "third",
		rs = rec.armR and rec.armR.Size, ls = rec.armL and rec.armL.Size,
		rt = rec.armR and rec.armR.Transparency or 0, lt = rec.armL and rec.armL.Transparency or 0,
		setups = setups, hud = (D.KillerHUD ~= false) and hudCfg(tool) or nil,
	})
end

local function visible(p)
	return p.Parent ~= nil and p.Transparency < 0.98 and p.LocalTransparencyModifier < 0.98
end

local rot = 0
local function makePacket()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local camCF = cam.CFrame
	local ch = player.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart")
	-- caméra attachée à SON perso : chez la victime elle suit le perso qu'elle voit (aucun décalage)
	-- position relative à son perso, rotation du monde : quand il tourne sur lui-même la caméra ne bouge pas
	local pk = { t = workspace:GetServerTimeNow(),
		cam = root and (CFrame.new(camCF.Position - root.Position) * camCF.Rotation) or camCF,
		camRel = root ~= nil, fov = cam.FieldOfView, mid = rec.mid }
	local tool = ch and ch:FindFirstChildOfClass("Tool")
	local vm = D.ShowKillerViewmodel ~= false and cam:FindFirstChild("WeaponViewmodel")
	local mode, src = nil, nil
	if vm and tool then
		mode, src = "vm", vm
	elseif tool and root and tool:FindFirstChild("Handle") and ch:FindFirstChild("Right Arm") and ch:FindFirstChild("Left Arm") then
		mode, src = "third", tool
	end
	if mode then
		if mode ~= rec.mode or src ~= rec.vm or tool ~= rec.tool or tool:GetAttribute("Optic") ~= rec.optic then
			sendManifest(mode, src, tool, ch)
		end
		pk.mid = rec.mid
		local r, l, h = rec.armR, rec.armL, rec.vh
		if r and l and h and r.Parent and l.Parent and h.Parent then
			pk.vm = true
			pk.third = mode == "third"
			local base = (mode == "third") and root.CFrame or camCF
			pk.r, pk.l, pk.h = base:ToObjectSpace(r.CFrame), base:ToObjectSpace(l.CFrame), base:ToObjectSpace(h.CFrame)
			local hcf = h.CFrame
			local n = #rec.vparts
			local vis, moved = table.create(n + 2, false), {}
			for i, c in ipairs(rec.vparts) do
				local on = visible(c)
				if on then
					local rel = hcf:ToObjectSpace(c.CFrame)
					if rel.Position.Magnitude > Codec.PartRange - 0.5 then
						on = false
					elseif differs(rel, rec.rest[i]) then
						table.insert(moved, { i, rel })
					end
				end
				vis[i] = on
			end
			vis[n + 1], vis[n + 2] = visible(r), visible(l)
			-- trop de pièces en mouvement : on envoie une fenêtre tournante (les autres gardent leur place)
			if #moved > Codec.MaxMoved then
				local disp = {}
				for _, e in ipairs(moved) do disp[e[1]] = true end
				pk.disp = disp
				local w = {}
				for k = 1, Codec.MaxMoved do w[k] = moved[((rot + k - 1) % #moved) + 1] end
				rot = (rot + Codec.MaxMoved) % #moved
				moved = w
				pk.partial = true
			end
			pk.n, pk.vis, pk.moved = n, vis, moved
		end
	end
	local e = tool and KV.tools[tool]
	if e and D.KillerHUD ~= false then
		local ok, hs = pcall(e.get)
		if ok and type(hs) == "table" then
			local a = tool:GetAttribute("AimAlpha")
			hs.aim = typeof(a) == "number" and a or 0
			pk.hud = hs
		end
	end
	return pk
end

local streaming, streamUntil, streamAcc = false, 0, 0
local evAcc, pingAt, highPing = 0, 0, false
local function setStreaming(on)
	streaming = on
	KV.rec = on
	table.clear(KV.events)
	-- ⚡ LAG PVP : le manifeste (jusqu'à 250 pièces de l'arme) n'est plus renvoyé à CHAQUE kill.
	--    Le serveur le garde tant que tu ne réapparais pas : une nouvelle victime le reçoit de lui.
	--    Il repart seulement si l'arme / la vue / l'optique change (contrôle dans makePacket).
	if on then resetShared(); evAcc = 0 end
end

CombatEvent.OnClientEvent:Connect(function(kind)
	if kind == "StreamStart" then
		setStreaming(true)
		streamUntil = os.clock() + (D.SpectateTime or 5) + 1.5
	elseif kind == "StreamStop" then
		setStreaming(false)
	end
end)
-- un nouveau perso = de nouvelles armes : le prochain manifeste repart de zéro
player.CharacterAdded:Connect(function() rec.vm, rec.mode, rec.tool = nil, nil, nil end)

-- ⚡ douilles : effet purement visuel, au plus MaxShellsPerPacket par paquet
local function trimShells(ev)
	local maxSh = math.max(0, math.floor(D.MaxShellsPerPacket or 2))
	local n, out = 0, table.create(#ev)
	for _, e in ipairs(ev) do
		if e.k == "sh" or e.k == "sho" then
			n += 1
			if n <= maxSh then table.insert(out, e) end
		else
			table.insert(out, e)
		end
	end
	return out
end

RunService.Heartbeat:Connect(function(dt)
	if not streaming then return end
	local myHum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if os.clock() > streamUntil or not myHum or myHum.Health <= 0 then   -- fin / mort pendant l'envoi
		setStreaming(false)
		return
	end
	-- ⚡ connexion déjà chargée (ping haut) : on envoie encore moins d'images
	local now = os.clock()
	if now - pingAt > 1 then
		pingAt = now
		local ok, pg = pcall(function() return player:GetNetworkPing() end)
		highPing = ok and type(pg) == "number" and pg * 1000 > (D.HighPing or 180)
	end
	local rate = highPing and (D.StreamRateHighPing or 10) or (D.StreamRate or 20)
	streamAcc += dt
	if streamAcc >= 1 / math.clamp(rate, 5, 60) then
		streamAcc = 0
		local ok, pk = pcall(makePacket)
		if ok and pk then
			local ok2, b = pcall(Codec.Encode, pk)
			if ok2 then Stream:FireServer(b) end
		end
	end
	-- effets du tour, regroupés (avant : un envoi fiable à CHAQUE image, jusqu'à 60 / s)
	-- (après le manifeste éventuel : même canal fiable, donc dans l'ordre)
	evAcc += dt
	if #KV.events > 0 and evAcc >= 1 / math.clamp(D.EventRate or 15, 5, 60) then
		evAcc = 0
		local ev = KV.events
		KV.events = {}
		ev = trimShells(ev)
		if #ev > 0 then CombatRequest:FireServer("KVE", ev) end
	end
end)

