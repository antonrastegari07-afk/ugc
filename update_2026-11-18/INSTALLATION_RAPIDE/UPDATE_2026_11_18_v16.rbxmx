-- FENÊTRE PRINCIPALE (réutilisable)
-- ========================================
local function panelSize()
	if not IS_MOBILE then return UDim2.new(0, 460, 0, 600) end
	local cam = workspace.CurrentCamera
	local vp = (cam and cam.ViewportSize.Y > 1) and cam.ViewportSize or Vector2.new(390, 700)
	local h = math.min(vp.Y * 0.82, 560)
	local w = math.min(h * 0.74, vp.X * 0.94)
	return UDim2.new(0, w, 0, h)
end

local window = Instance.new("Frame")
window.Name = "Window"
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Position = IS_MOBILE and UDim2.new(0.5, 0, 0.44, 0) or UDim2.new(0.5, 0, 0.5, 0)
window.Size = panelSize()
window.BackgroundColor3 = C.BG_BLACK
window.BackgroundTransparency = 0.15
window.BorderSizePixel = 0
window.ClipsDescendants = true
window.Visible = false
window.ZIndex = 10
window.Parent = gui
corner(window, 14)
stroke(window, C.BORDER_SUBTLE, 1.5)
attachScale(window)

-- Drag souris + tactile
local function makeDraggable(handle)
	local dragging, startInput, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; startInput = input.Position; startPos = window.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startInput
			window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

-- Nettoie le contenu de la fenêtre (garde corner/stroke/scale)
local function clearWindow()
	for _, c in ipairs(window:GetChildren()) do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") and not c:IsA("UIScale") then
			c:Destroy()
		end
	end
end

local goHome  -- forward decl

-- Construit un header + retourne (bodyScroll)
local function buildScreen(titleText, showBack, accent, backFn, refreshFn)
	clearWindow()
	accent = accent or C.TURQUOISE

	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, HEADER_H)
	header.BackgroundColor3 = C.BG_DARK
	header.BorderSizePixel = 0
	header.ZIndex = 12
	header.Parent = window
	corner(header, 14)
	local mask = Instance.new("Frame")
	mask.AnchorPoint = Vector2.new(0, 1); mask.Position = UDim2.new(0, 0, 1, 0)
	mask.Size = UDim2.new(1, 0, 0, 14); mask.BackgroundColor3 = C.BG_DARK
	mask.BorderSizePixel = 0; mask.ZIndex = 12; mask.Parent = header
	local sep = Instance.new("Frame")
	sep.AnchorPoint = Vector2.new(0, 1); sep.Position = UDim2.new(0, 0, 1, 0)
	sep.Size = UDim2.new(1, 0, 0, 1); sep.BackgroundColor3 = accent
	sep.BackgroundTransparency = 0.3; sep.BorderSizePixel = 0; sep.ZIndex = 13; sep.Parent = header
	makeDraggable(header)

	label(header, {
		text = titleText, size = UDim2.new(1, -110, 1, 0),
		position = UDim2.new(0.5, 0, 0.5, 0), anchor = Vector2.new(0.5, 0.5),
		color = accent, textSize = IS_MOBILE and 18 or 22, zIndex = 13, truncate = true,
	})

	-- Close
	local closeC = Instance.new("Frame")
	closeC.AnchorPoint = Vector2.new(1, 0.5); closeC.Position = UDim2.new(1, -8, 0.5, 0)
	closeC.Size = UDim2.new(0, IS_MOBILE and 28 or 36, 0, IS_MOBILE and 28 or 36)
	closeC.BackgroundTransparency = 1; closeC.ZIndex = 14; closeC.Parent = header
	local closeBtn = actionButton(closeC, { color = C.RED, strokeColor = C.RED_DARK, text = "✕", textSize = IS_MOBILE and 13 or 17, radius = 8, zIndex = 14 })
	closeBtn.MouseButton1Click:Connect(function() window.Visible = false end)

	-- Refresh (recharge les données de l'écran courant)
	if refreshFn then
		local rW = IS_MOBILE and 28 or 36
		local rC = Instance.new("Frame")
		rC.AnchorPoint = Vector2.new(1, 0.5)
		rC.Position = UDim2.new(1, -8 - rW - 4, 0.5, 0)
		rC.Size = UDim2.new(0, rW, 0, rW)
		rC.BackgroundTransparency = 1
		rC.ZIndex = 14
		rC.Parent = header
		local rBtn = actionButton(rC, { color = C.TURQUOISE_DARK, strokeColor = C.TURQUOISE, text = "🔄", textSize = IS_MOBILE and 13 or 16, radius = 8, zIndex = 14 })
		rBtn.MouseButton1Click:Connect(function() refreshFn() end)
	end

	-- Back
	if showBack then
		local backC = Instance.new("Frame")
		backC.AnchorPoint = Vector2.new(0, 0.5); backC.Position = UDim2.new(0, 8, 0.5, 0)
		backC.Size = UDim2.new(0, IS_MOBILE and 54 or 72, 0, IS_MOBILE and 28 or 36)
		backC.BackgroundTransparency = 1; backC.ZIndex = 14; backC.Parent = header
		local backBtn = actionButton(backC, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = "← BACK", textSize = IS_MOBILE and 10 or 13, radius = 8, zIndex = 14 })
		backBtn.MouseButton1Click:Connect(function() (backFn or goHome)() end)
	end

	local body = Instance.new("ScrollingFrame")
	body.Position = UDim2.new(0, 0, 0, HEADER_H)
	body.Size = UDim2.new(1, 0, 1, -HEADER_H)
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.ScrollBarThickness = 4
	body.ScrollBarImageColor3 = C.BORDER_SUBTLE
	body.CanvasSize = UDim2.new(0, 0, 0, 0)
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.ScrollingDirection = Enum.ScrollingDirection.Y
	body.ZIndex = 11
	body.Parent = window
	padding(body, PAD)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = body

	return body
end

-- ========================================
-- LIGNE JOUEUR (avatar + display name + @username)
-- ========================================
-- info = { userId, displayName, username, isSelf }
-- opts = { order, accent, tag, tagColor, selectable, onClick }
local function playerRow(parent, info, opts)
	opts = opts or {}
	local accent = opts.accent or C.TURQUOISE
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, ROW_H)
	row.BackgroundColor3 = C.BG_DARK
	row.AutoButtonColor = false
	row.Text = ""
	row.BorderSizePixel = 0
	row.LayoutOrder = opts.order or 1
	row.ZIndex = 11
	row.Parent = parent
	corner(row, 10)
	local rowStroke = stroke(row, C.BORDER_SUBTLE, 1)

	local avSize = ROW_H - 16
	local av = makeAvatar(row, info.userId, avSize)
	av.AnchorPoint = Vector2.new(0, 0.5)
	av.Position = UDim2.new(0, 8, 0.5, 0)

	local labelX = 8 + avSize + 10
	local nameText = info.displayName or info.username or ("User " .. tostring(info.userId))
	if info.isSelf then nameText = "👑 " .. nameText end

	label(row, {
		text = esc(nameText) .. ptsSuffixLive(info.userId),
		richText = true,
		size = UDim2.new(1, -labelX - 12, 0, IS_MOBILE and 16 or 20),
		position = UDim2.new(0, labelX, 0, IS_MOBILE and 9 or 13),
		xAlign = Enum.TextXAlignment.Left,
		color = info.isSelf and Color3.fromRGB(255, 210, 90) or C.TEXT_WHITE,
		textSize = IS_MOBILE and 13 or 16, zIndex = 12, truncate = true,
	})
	label(row, {
		text = "@" .. (info.username or tostring(info.userId)) .. economy.lastSeenSuffix(info.userId),
		size = UDim2.new(1, -labelX - 12, 0, 12),
		position = UDim2.new(0, labelX, 0, IS_MOBILE and 28 or 37),
		xAlign = Enum.TextXAlignment.Left,
		color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, zIndex = 12, truncate = true,
	})

	-- Tag optionnel (ex: FROZEN, ONLINE)
	local tagLbl
	if opts.tag then
		tagLbl = Instance.new("TextLabel")
		tagLbl.AnchorPoint = Vector2.new(1, 0.5)
		tagLbl.Position = UDim2.new(1, -10, 0.5, 0)
		tagLbl.Size = UDim2.new(0, IS_MOBILE and 58 or 74, 0, IS_MOBILE and 18 or 22)
		tagLbl.BackgroundColor3 = opts.tagColor or accent
		tagLbl.BorderSizePixel = 0
		tagLbl.Font = FONT
		tagLbl.Text = opts.tag
		tagLbl.TextColor3 = C.TEXT_WHITE
		tagLbl.TextSize = IS_MOBILE and 9 or 11
		tagLbl.ZIndex = 12
		tagLbl.Parent = row
		corner(tagLbl, 5)
	end

	row.MouseEnter:Connect(function()
		row.BackgroundColor3 = C.BG_MEDIUM; rowStroke.Color = accent
	end)
	row.MouseLeave:Connect(function()
		row.BackgroundColor3 = C.BG_DARK; rowStroke.Color = C.BORDER_SUBTLE
	end)
	if opts.onClick then
		row.MouseButton1Click:Connect(function() opts.onClick(info, row, rowStroke) end)
	end
	return row, rowStroke
end

-- Section titre (petit label gris)
local function sectionLabel(parent, order, text)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
	f.BackgroundTransparency = 1
	f.LayoutOrder = order
	f.ZIndex = 11
	f.Parent = parent
	label(f, {
		text = text, size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
		yAlign = Enum.TextYAlignment.Bottom, color = C.TEXT_DIM, textSize = IS_MOBILE and 11 or 13, zIndex = 11,
	})
	return f
end

-- ========================================
-- DONNÉES JOUEURS EN LIGNE (depuis le serveur, avec fallback local)
-- ========================================
local function fetchOnlinePlayers()
	local ok, list = pcall(function() return getPlayersEvent:InvokeServer() end)
	if ok and type(list) == "table" and #list > 0 then return list end
	-- Fallback local
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		table.insert(out, { userId = p.UserId, username = p.Name, displayName = p.DisplayName, isSelf = (p == player) })
	end
	return out
end

-- Résout des @usernames (batch, cache) pour l'écran leaderboard
local unameCache = {}
economy.usernames = unameCache
for _, p in ipairs(Players:GetPlayers()) do unameCache[p.UserId] = p.Name end
Players.PlayerAdded:Connect(function(p) unameCache[p.UserId] = p.Name end)

local function resolveUsernames(userIds, cb)
	-- ⚡ Les points partent EN MÊME TEMPS que les pseudos (avant : l'un APRÈS l'autre).
	--    resolvePoints appelé ensuite par l'écran attendra simplement cette lecture.
	resolvePoints(table.move(userIds, 1, math.min(#userIds, 60), 1, {}), function() end)
	local need = {}
	for _, id in ipairs(userIds) do
		if not unameCache[id] then table.insert(need, id) end
	end
	if #need == 0 then cb(); return end
	task.spawn(function()
		for start = 1, #need, 200 do
			local chunk = table.move(need, start, math.min(start + 199, #need), 1, {})
			local ok, res = pcall(function() return resolveNamesEvent:InvokeServer(chunk) end)
			if ok and type(res) == "table" then
				for k, v in pairs(res) do
					local id = tonumber(k)
					if id then unameCache[id] = v end
				end
			end
		end
		cb()
	end)
end

