-- ========================================
-- HELPERS UI
-- ========================================
local function corner(inst, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = inst; return c
end
local function stroke(inst, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col or C.BORDER_SUBTLE; s.Thickness = th or 1; s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = inst; return s
end
local function gradient(inst, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2) })
	g.Rotation = rot or 90; g.Parent = inst; return g
end
local function padding(inst, all)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, all); p.PaddingBottom = UDim.new(0, all)
	p.PaddingLeft = UDim.new(0, all); p.PaddingRight = UDim.new(0, all)
	p.Parent = inst; return p
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = FONT
	l.TextColor3 = props.color or C.TEXT_WHITE
	l.TextXAlignment = props.xAlign or Enum.TextXAlignment.Center
	l.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
	l.Text = props.text or ""
	l.TextWrapped = props.wrapped or false
	l.RichText = props.richText or false
	if props.truncate then l.TextTruncate = Enum.TextTruncate.AtEnd end
	if props.textSize then l.TextSize = props.textSize else l.TextScaled = true end
	if props.size then l.Size = props.size end
	if props.position then l.Position = props.position end
	if props.anchor then l.AnchorPoint = props.anchor end
	if props.zIndex then l.ZIndex = props.zIndex end
	l.Parent = parent
	return l
end

-- Bouton d'action coloré (avec petit effet de scale)
local function actionButton(parent, props)
	local color = props.color or C.GREEN
	local strokeCol = props.strokeColor or C.BORDER_BRIGHT
	local btn = Instance.new("TextButton")
	btn.Size = props.size or UDim2.fromScale(1, 1)
	btn.Position = props.position or UDim2.fromScale(0.5, 0.5)
	btn.AnchorPoint = props.anchor or Vector2.new(0.5, 0.5)
	btn.BackgroundColor3 = color
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.ZIndex = props.zIndex or 5
	btn.Parent = parent
	corner(btn, props.radius or 9)
	stroke(btn, strokeCol, 1.5)
	local sc = Instance.new("UIScale"); sc.Parent = btn
	local function tw(s, d) TweenService:Create(sc, TweenInfo.new(d or 0.13, Enum.EasingStyle.Quad), { Scale = s }):Play() end
	btn.MouseEnter:Connect(function() tw(1.04) end)
	btn.MouseLeave:Connect(function() tw(1) end)
	btn.MouseButton1Down:Connect(function() tw(0.96, 0.07) end)
	btn.MouseButton1Up:Connect(function() tw(1.04, 0.1) end)
	local lbl = label(btn, {
		text = props.text or "", size = UDim2.fromScale(1, 1),
		color = props.textColor or C.TEXT_WHITE,
		textSize = props.textSize or (IS_MOBILE and 14 or 17), zIndex = (props.zIndex or 5) + 1,
	})
	return btn, lbl
end

-- ========================================
-- AVATAR (thumbnail rond + cache)
-- ========================================
local thumbCache = {}
local economy = {}
local function loadAvatar(imageLabel, userId)
	economy.bindAvatar(imageLabel, userId)
	if thumbCache[userId] then imageLabel.Image = thumbCache[userId]; return end
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok and img then
			thumbCache[userId] = img
			if imageLabel and imageLabel.Parent then imageLabel.Image = img end
		end
	end)
end

local function makeAvatar(parent, userId, size, ringColor)
	local av = Instance.new("ImageLabel")
	av.Size = UDim2.new(0, size, 0, size)
	av.BackgroundColor3 = C.BG_LIGHT
	av.BorderSizePixel = 0
	av.ZIndex = (parent.ZIndex or 1) + 1
	av.Parent = parent
	corner(av, size / 2)
	if ringColor then stroke(av, ringColor, 2) end
	loadAvatar(av, userId)
	return av
end

-- ========================================
-- 💎 POINTS EN LIGNE (attribut répliqué — 0 requête DataStore)
-- ========================================
local GREEN_HEX = "#FFD746"  -- ≈ C.GREEN, pour le RichText

local function fmtPts(n)
	n = tonumber(n)
	if not n then return nil end
	if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
	if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
	if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end

-- Points d'un joueur EN LIGNE (via l'attribut "Points" répliqué, sinon leaderstats)
local function livePoints(userId)
	local p = Players:GetPlayerByUserId(userId)
	if not p then return nil end
	local a = p:GetAttribute("Points")
	if type(a) == "number" then return a end
	local ls = p:FindFirstChild("leaderstats")
	local pts = ls and ls:FindFirstChild("Points")
	if pts then return pts.Value end
	return nil
end

-- échappe le texte pour le RichText (noms avec & < >)
local function esc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- construit "  💎X" en vert (RichText) si des points sont connus, sinon ""
local PTS_SIZE = IS_MOBILE and 11 or 13  -- un peu plus gros, mais < taille du nom
local function ptsSuffix(pointsValue)
	if pointsValue == nil then return "" end
	local f = fmtPts(pointsValue)
	if not f then return "" end
	return "  <font color=\"" .. GREEN_HEX .. "\" size=\"" .. PTS_SIZE .. "\">" .. f .. " pts</font>"
end

-- Caches HORS LIGNE (remplis par resolvePoints, à la demande)
local pointsCache = {}  -- [userId] = number
local banCache = {}     -- [userId] = bool
local RED_HEX = "#E14550"  -- ≈ C.RED, pour le 🚫

-- Points d'un joueur : en ligne (attribut, gratuit) sinon cache hors ligne
local function pointsFor(userId)
	local lp = livePoints(userId)
	if lp ~= nil then return lp end
	local c = pointsCache[userId]
	if type(c) == "number" then return c end
	return nil
end
-- Un joueur EN LIGNE n'est jamais banni (il joue) ; sinon on lit le cache
local function bannedFor(userId)
	if Players:GetPlayerByUserId(userId) then return false end
	return banCache[userId] == true
end
-- 🕒 DERNIÈRE CONNEXION (script serveur PLAYER UGC STATS) — rangé dans `economy`
--    pour ne pas ajouter de local : ce fichier est à la limite des 200 registres.
economy.lastSeen, economy.lsFlight = {}, {}
function economy.resolveLastSeen(ids, cb)
	local fn = ReplicatedStorage:FindFirstChild("AdminLastSeen_Get")
	if not fn then cb() return end
	local need, waitOthers = {}, false
	for _, id in ipairs(ids) do
		id = tonumber(id)
		if id and not Players:GetPlayerByUserId(id) and economy.lastSeen[id] == nil then
			if economy.lsFlight[id] then waitOthers = true
			else economy.lsFlight[id] = true ; table.insert(need, id) end
		end
	end
	if #need == 0 and not waitOthers then cb() return end
	task.spawn(function()
		for s0 = 1, #need, 60 do
			local chunk = table.move(need, s0, math.min(s0 + 59, #need), 1, {})
			local ok, res = pcall(function() return fn:InvokeServer(chunk) end)
			if ok and type(res) == "table" then
				for k, v in pairs(res) do
					local id = tonumber(k)
					if id and type(v) == "table" and not v.on then economy.lastSeen[id] = v end
				end
			end
			for _, id in ipairs(chunk) do
				economy.lsFlight[id] = nil
				-- pas de réponse pour lui : on ne redemande pas à chaque affichage
				if economy.lastSeen[id] == nil and not Players:GetPlayerByUserId(id) then economy.lastSeen[id] = {} end
			end
		end
		if waitOthers then
			local t0 = os.clock()
			while os.clock() - t0 < 8 do
				local b = false
				for _, id in ipairs(ids) do if economy.lsFlight[tonumber(id) or 0] then b = true break end end
				if not b then break end
				task.wait(0.1)
			end
		end
		cb()
	end)
end
-- "  ·  🟢 en ligne" / "  ·  🕒 il y a 3 j" / "" (inconnu)
function economy.lastSeenSuffix(id)
	id = tonumber(id)
	if not id then return "" end
	if Players:GetPlayerByUserId(id) then return "  ·  🟢 en ligne" end
	local v = economy.lastSeen[id]
	if type(v) ~= "table" then return "" end
	-- 🆕 jours ET heures (« il y a 3 j 5 h »), plus jamais une date
	if v.t then
		local a = math.max(0, os.time() - v.t)
		if a < 3600 then return "  ·  🕒 il y a " .. math.max(1, math.floor(a / 60)) .. " min" end
		if a < 86400 then
			local h, m = math.floor(a / 3600), math.floor((a % 3600) / 60)
			return "  ·  🕒 il y a " .. h .. " h" .. (m > 0 and (" " .. m .. " min") or "")
		end
		local d, h = math.floor(a / 86400), math.floor((a % 86400) / 3600)
		return "  ·  🕒 il y a " .. d .. " j" .. (h > 0 and (" " .. h .. " h") or "")
	end
	-- seulement le JOUR connu (ancien joueur rangé par le rattrapage) → durée approximative
	if type(v.d) == "string" and #v.d == 8 then
		local y, mo, dd = tonumber(v.d:sub(1, 4)), tonumber(v.d:sub(5, 6)), tonumber(v.d:sub(7, 8))
		if y and mo and dd then
			local okT, t = pcall(os.time, { year = y, month = mo, day = dd, hour = 12 })
			if okT and t then
				local days = math.max(0, math.floor((os.time() - t) / 86400 + 0.5))
				return days < 1 and "  ·  🕒 aujourd'hui" or ("  ·  🕒 il y a ~" .. days .. " j")
			end
		end
	end
	if v.none then return "  ·  🕒 jamais vu" end
	return ""
end

-- Va chercher (batch + cache) points + ban des joueurs HORS LIGNE d'une liste, puis cb()
-- ⚡ Anti-doublon : si ces joueurs sont déjà en cours de lecture, on attend cette
--    lecture au lieu d'en relancer une (avant : 2e requête → réponse vide).
local function resolvePoints(userIds, cb)
	do  -- 🕒 la dernière connexion arrive avec les points (2 s d'attente max en plus)
		local cb0, lsDone, ptDone, fired = cb, false, false, false
		local function fire() if not fired then fired = true ; cb0() end end
		economy.resolveLastSeen(userIds, function() lsDone = true ; if ptDone then fire() end end)
		cb = function()
			ptDone = true
			if lsDone then fire() else task.delay(2, fire) end
		end
	end
	if not getPointsFn then cb(); return end
	local flight = economy.ptsFlight
	if not flight then flight = {}; economy.ptsFlight = flight end
	local need, waitOthers = {}, false
	for _, id in ipairs(userIds) do
		if livePoints(id) == nil and pointsCache[id] == nil then
			if flight[id] then
				waitOthers = true
			else
				flight[id] = true
				table.insert(need, id)
			end
		end
	end
	if #need == 0 and not waitOthers then cb(); return end
	task.spawn(function()
		for start = 1, #need, 60 do
			local chunk = table.move(need, start, math.min(start + 59, #need), 1, {})
			local ok, res = pcall(function() return getPointsFn:InvokeServer(chunk) end)
			if ok and type(res) == "table" then
				for k, v in pairs(res) do
					local id = tonumber(k)
					if id and type(v) == "table" then
						if type(v.points) == "number" then pointsCache[id] = v.points end
						banCache[id] = v.banned == true
					end
				end
			end
			for _, id in ipairs(chunk) do flight[id] = nil end
		end
		if waitOthers then
			local t0 = os.clock()
			local busy = true
			while busy and os.clock() - t0 < 12 do
				busy = false
				for _, id in ipairs(userIds) do
					if flight[id] then busy = true; break end
				end
				if busy then task.wait(0.1) end
			end
		end
		cb()
	end)
end
-- suffixe complet d'une entrée : 💎points (vert) + 🚫 (rouge) si banni
local function ptsSuffixLive(userId)
	-- The shared avatar footer displays both currencies; keep only the ban badge here.
	if bannedFor(userId) then
		return "  <font color=\"" .. RED_HEX .. "\" size=\"" .. PTS_SIZE .. "\">🚫</font>"
	end
	return ""
end

-- All player avatars (including bespoke cards and spectate) use the same footer.
economy.rows, economy.byAvatar, economy.desired = {}, {}, {}
economy.values, economy.pending, economy.lastRequest = {}, {}, {}
economy.running = false
economy.FOOTER_H = IS_MOBILE and 32 or 36

function economy.accept(uid, value)
	if type(value) ~= "table" then return end
	if type(value.points) == "number" then pointsCache[uid] = value.points end
	if type(value.total) ~= "number" then return end
	local old = economy.values[uid]
	if old and (old.serial or 0) > (value.serial or 0) then return end
	value.time = os.clock(); economy.values[uid] = value
end
function economy.fetch(ids)
	for _, uid in ipairs(ids) do economy.pending[uid] = true end
	if economy.running then return end
	economy.running = true
	task.spawn(function()
		task.wait(0.08) -- gather all rows created in this frame
		while next(economy.pending) do
			local remote = ReplicatedStorage:FindFirstChild("AdminSpending_Get")
			if not remote or not remote:IsA("RemoteFunction") then
				economy.pending = {}; break -- missing add-on never blocks the admin panel
			end
			local ids, wantPoints = {}, {}
			for uid in pairs(economy.pending) do
				table.insert(ids, uid); economy.pending[uid] = nil
				wantPoints[tostring(uid)] = pointsFor(uid) == nil
				if #ids >= 30 then break end
			end
			local ok, response = pcall(function() return remote:InvokeServer(ids, wantPoints) end)
			local good = ok and type(response) == "table" and not response.throttled
			if ok and type(response) == "table" then
				for key, value in pairs(response) do
					local uid = tonumber(key)
					if uid then economy.accept(uid, value) end
				end
			end
			-- ⚡ serveur occupé : on redemande dans 1 s au lieu de laisser « … » pendant 15 s
			if not good then
				for _, uid in ipairs(ids) do economy.lastRequest[uid] = nil end
			end
			task.wait(good and 0.35 or 1.1)
		end
		economy.running = false
	end)
end
economy.ROBUX_IMAGE = "rbxasset://textures/ui/common/robux.png"
function economy.openPurchases(uid)
	if economy.popup then economy.popup:Destroy(); economy.popup = nil end
	local screen = Instance.new("ScreenGui")
	screen.Name = "AdminPurchaseSummary"; screen.ResetOnSpawn = false
	screen.DisplayOrder = 1100; screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = playerGui; economy.popup = screen
	local function make(class, parent, props)
		local item = Instance.new(class)
		for k, v in pairs(props) do item[k] = v end
		item.Parent = parent; return item
	end
	local function close()
		if economy.popup == screen then economy.popup = nil end
		screen:Destroy()
	end
	local shade = make("TextButton", screen, {Size=UDim2.fromScale(1,1), Text="",
		BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.3,
		AutoButtonColor=false, BorderSizePixel=0, ZIndex=1})
	shade.Activated:Connect(close)
	local card = make("TextButton", screen, {Size=UDim2.fromScale(0.92,0.8), Text="",
		Position=UDim2.fromScale(0.5,0.5), AnchorPoint=Vector2.new(0.5,0.5),
		BackgroundColor3=C.BG_DARK, BorderSizePixel=0, AutoButtonColor=false, ZIndex=2})
	corner(card, 12); stroke(card, C.GREEN, 1)
	make("UISizeConstraint", card, {MaxSize=Vector2.new(460,540)})
	label(card, {text="Achats — @" .. tostring((economy.usernames or {})[uid] or uid),
		size=UDim2.new(1,-64,0,35), position=UDim2.fromOffset(14,8),
		color=C.TEXT_WHITE, textSize=16, xAlign=Enum.TextXAlignment.Left, truncate=true, zIndex=3})
	local closeBtn = make("TextButton", card, {Text="×", Font=FONT, TextSize=26,
		Size=UDim2.fromOffset(38,38), Position=UDim2.new(1,-44,0,5),
		BackgroundTransparency=1, TextColor3=C.TEXT_WHITE, ZIndex=4})
	closeBtn.Activated:Connect(close)
	local totalLine = make("Frame", card, {Position=UDim2.fromOffset(15,48),
		Size=UDim2.new(1,-30,0,23), BackgroundTransparency=1, ZIndex=3})
	economy.icon(totalLine, true, C.GREEN, 4)
	local totalLabel = label(totalLine, {text="Chargement…", size=UDim2.new(1,-20,1,0),
		position=UDim2.fromOffset(20,0), color=C.GREEN, textSize=16,
		xAlign=Enum.TextXAlignment.Left, truncate=true, zIndex=4})
	local scroll = make("ScrollingFrame", card, {Position=UDim2.fromOffset(14,80),
		Size=UDim2.new(1,-28,1,-134), BackgroundTransparency=1, BorderSizePixel=0,
		CanvasSize=UDim2.fromOffset(0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
		ScrollBarThickness=4, ScrollingDirection=Enum.ScrollingDirection.Y, ZIndex=3})
	make("UIListLayout", scroll, {Padding=UDim.new(0,5), SortOrder=Enum.SortOrder.LayoutOrder})
	label(card, {text="Achats enregistrés. Passes estimés aux prix fournis.\nTests à 0 conservés ; rewarded ads exclus.",
		size=UDim2.new(1,-28,0,44), position=UDim2.new(0,14,1,-49),
		color=C.TEXT_GREY, textSize=11, wrapped=true, zIndex=3})
	task.spawn(function()
		local remote = ReplicatedStorage:FindFirstChild("AdminSpending_Details")
		local ok, data = pcall(function()
			if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer(uid) end
		end)
		if not screen.Parent then return end
		if not ok or type(data) ~= "table" then
			totalLabel.Text = "Indisponible. Ferme puis réessaie dans 2 s."; return
		end
		economy.accept(uid, data)
		local share = tonumber(data.share) or 0.7
		local net = math.floor((data.total or 0) * share)
		totalLabel.Text = string.format("%s R$ payés  →  %d R$ pour toi (≈ %s $ CA%s)",
			tostring(data.total or 0), net,
			(string.format("%.2f", net * (tonumber(data.cad) or 0.0038 * 1.42)):gsub("%.", ",")),
			data.cadLive and "" or ", ⚠️ taux de secours")
		local order = 0
		local function group(title, items)
			order = order + 1
			local head = label(scroll, {text=title, size=UDim2.new(1,-8,0,25),
				color=C.TEXT_WHITE, textSize=13, xAlign=Enum.TextXAlignment.Left, zIndex=4})
			head.LayoutOrder = order
			if #items == 0 then
				order = order + 1
				local empty = label(scroll, {text="Aucun achat enregistré.", size=UDim2.new(1,-8,0,23),
					color=C.TEXT_GREY, textSize=12, xAlign=Enum.TextXAlignment.Left, zIndex=4})
				empty.LayoutOrder = order
			end
			for _, item in ipairs(items) do
				order = order + 1
				local row = make("Frame", scroll, {Size=UDim2.new(1,-8,0,45),
					BackgroundColor3=C.BG_MEDIUM, BorderSizePixel=0, LayoutOrder=order, ZIndex=4})
				corner(row, 6)
				label(row, {text=(item.name or ("ID " .. tostring(item.id)))
					.. (((item.count or 1) > 1) and ("   ×" .. tostring(item.count)) or ""),
					size=UDim2.new(1,-12,0,20), position=UDim2.fromOffset(6,1),
					color=C.TEXT_WHITE, textSize=12, xAlign=Enum.TextXAlignment.Left, truncate=true, zIndex=5})
				local line = make("Frame", row, {Position=UDim2.fromOffset(6,24),
					Size=UDim2.new(1,-12,0,17), BackgroundTransparency=1, ZIndex=5})
				economy.icon(line, true, C.GREEN, 6)
				label(line, {text=item.spent ~= nil and tostring(item.spent) or "Montant inconnu",
					size=UDim2.new(1,-20,1,0), position=UDim2.fromOffset(20,0),
					color=C.GREEN, textSize=12, xAlign=Enum.TextXAlignment.Left, zIndex=6})
			end
		end
		-- 🕐 Derniers achats, datés à la minute (depuis l'installation des stats)
		if type(data.recent) == "table" and #data.recent > 0 then
			local items = {}
			for _, x in ipairs(data.recent) do
				table.insert(items, { id = x.p, count = 1, spent = x.r,
					name = tostring(x.ds) .. "  " .. tostring(x.n or x.p) .. (x.g and "  🎁" or "") })
			end
			group("🕐 DERNIERS ACHATS (heure de Montréal)", items)
		end
		group("DEV PRODUCTS", data.products or {})
		group("PASSES", data.passes or {})
	end)
end

function economy.icon(parent, isRobux, color, z)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(13, 13); holder.Position = UDim2.fromOffset(0, 0)
	holder.BackgroundTransparency = 1; holder.ZIndex = z; holder.Parent = parent
	if not isRobux then
		local coin = Instance.new("Frame")
		coin.Size = UDim2.fromOffset(11, 11); coin.Position = UDim2.fromOffset(1, 1)
		coin.BackgroundColor3 = color; coin.BorderSizePixel = 0; coin.ZIndex = z
		coin.Parent = holder; corner(coin, 20)
		local inside = Instance.new("Frame")
		inside.Size = UDim2.fromOffset(6, 7); inside.Position = UDim2.fromOffset(2.5, 2)
		inside.BackgroundTransparency = 1; inside.ZIndex = z+1; inside.Parent = coin
		corner(inside, 20); stroke(inside, Color3.fromRGB(173, 119, 15), 1)
	else
		local icon = Instance.new("ImageLabel")
		icon.Name = "RobuxIcon"; icon.Size = UDim2.fromScale(1,1)
		icon.BackgroundTransparency = 1; icon.Image = economy.ROBUX_IMAGE
		icon.ImageColor3 = color; icon.ZIndex = z; icon.Parent = holder
	end
end
function economy.mount(avatar, uid)
	if not avatar.Parent or type(uid) ~= "number" or uid <= 0 then return end
	local existing = economy.byAvatar[avatar]
	if existing then existing.uid = uid; return end
	local host = avatar.Parent
	local reserved = host:GetAttribute("AdminEconomyReservedHeight") or 0
	local baseH = host.Size.Y.Offset - reserved
	if host.Size.Y.Scale ~= 0 then baseH = host.AbsoluteSize.Y - reserved end
	if baseH <= 0 then return end
	-- Preserve existing child geometry before making room below the card.
	-- In particular, icons and vertically centred action buttons must not grow.
	for _, child in ipairs(host:GetChildren()) do
		if child:IsA("GuiObject") then
			local pos, size = child.Position, child.Size
			if pos.Y.Scale ~= 0 then
				child.Position = UDim2.new(pos.X.Scale, pos.X.Offset, 0, baseH*pos.Y.Scale+pos.Y.Offset)
			end
			if size.Y.Scale ~= 0 then
				child.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, baseH*size.Y.Scale+size.Y.Offset)
			end
		end
	end
	if reserved == 0 then
		host.Size = UDim2.new(host.Size.X.Scale, host.Size.X.Offset, 0, baseH+economy.FOOTER_H)
	end
	local footer = Instance.new("Frame")
	footer.Name = "AdminCurrencyFooter"
	footer.Size = UDim2.new(1, -16, 0, economy.FOOTER_H)
	footer.Position = UDim2.fromOffset(8, baseH)
	footer.BackgroundTransparency = 1; footer.ZIndex = host.ZIndex+1; footer.Parent = host
	local lineH = IS_MOBILE and 14 or 16
	local function makeLine(isRobux, y, color)
		local line = Instance.new("Frame")
		line.Position = UDim2.fromOffset(0, y); line.Size = UDim2.new(1, 0, 0, lineH)
		line.BackgroundTransparency = 1; line.ZIndex = footer.ZIndex; line.Parent = footer
		economy.icon(line, isRobux, color, footer.ZIndex+1)
		return label(line, {text="…", size=UDim2.new(1, -18, 1, 0),
			position=UDim2.fromOffset(18, 0), xAlign=Enum.TextXAlignment.Left,
			color=color, textSize=IS_MOBILE and 10 or 12, zIndex=footer.ZIndex+1, truncate=true})
	end
	local ref = {uid=uid, host=host, points=makeLine(false, 2, Color3.fromRGB(255, 215, 70)),
		robux=makeLine(true, 2+lineH, C.GREEN)}
	local click = Instance.new("TextButton")
	click.Name = "OpenPurchaseSummary"; click.Text = ""; click.BackgroundTransparency = 1
	click.Size = UDim2.fromScale(1,1); click.ZIndex = footer.ZIndex+3
	click.Parent = ref.robux.Parent
	click.Activated:Connect(function() economy.openPurchases(ref.uid) end)
	economy.rows[footer] = ref; economy.byAvatar[avatar] = ref
	footer.Destroying:Connect(function()
		economy.rows[footer] = nil; economy.byAvatar[avatar] = nil; economy.desired[avatar] = nil
	end)
end
function economy.bindAvatar(avatar, uid)
	economy.desired[avatar] = uid
	task.defer(function()
		if avatar.Parent then economy.mount(avatar, economy.desired[avatar])
		else economy.desired[avatar] = nil end
	end)
end
function economy.isVisible(object)
	local current = object
	while current do
		if current:IsA("GuiObject") and not current.Visible then return false end
		if current:IsA("ScreenGui") and not current.Enabled then return false end
		current = current.Parent
	end
	return true
end
function economy.refresh()
	local now, needed = os.clock(), {}
	for footer, ref in pairs(economy.rows) do
		if footer.Parent and economy.isVisible(footer) then
			ref.points.Text = fmtPts(pointsFor(ref.uid)) or "…"
			local value = economy.values[ref.uid]
			ref.robux.Text = value and fmtPts(value.total) or "…"
			if (not value or now-value.time > 120)
				and now-(economy.lastRequest[ref.uid] or -1000) > 15 then
				economy.lastRequest[ref.uid] = now; table.insert(needed, ref.uid)
			end
		end
	end
	if #needed > 0 then economy.fetch(needed) end
end
function economy.connectUpdates()
	if economy.connection then return end
	local remote = ReplicatedStorage:FindFirstChild("AdminSpending_Changed")
	if remote and remote:IsA("RemoteEvent") then
		economy.connection = remote.OnClientEvent:Connect(function(uid, value)
			if type(uid) == "number" then economy.accept(uid, value) end
		end)
	end
end
task.spawn(function()
	while script.Parent do
		economy.connectUpdates(); economy.refresh(); task.wait(0.5)
	end
end)

-- ========================================
-- SCALE UNIFORME
-- ========================================
local REF_W, REF_H = 1100, 750
local function computeScale()
	local cam = workspace.CurrentCamera
	local vp = (cam and cam.ViewportSize.Y > 1) and cam.ViewportSize or Vector2.new(1280, 720)
	return math.clamp(math.min(vp.X / REF_W, vp.Y / REF_H), 0.75, 1)
end
local function attachScale(frame)
	local sc = Instance.new("UIScale"); sc.Parent = frame
	local function apply() sc.Scale = computeScale() end
	apply()
	local conn = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		apply()
	end)
	local cam = workspace.CurrentCamera
	local vpConn = cam and cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	frame.Destroying:Connect(function()
		conn:Disconnect(); if vpConn then vpConn:Disconnect() end
	end)
end

