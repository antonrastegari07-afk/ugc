	{ id = "ugclog",       name = "🎽 UGC LOG",   color = Color3.fromRGB(255, 150, 220) },
	{ id = "ugcescrow",    name = "🔐 ESCROW",    color = Color3.fromRGB(120, 220, 255) },
	{ id = "leaderboards", name = "🏆 BOARDS",    color = Color3.fromRGB(255, 205, 60) },
	{ id = "acboards",     name = "🚨 A-CHEAT",   color = C.RED },
}

local openAction  -- forward decl

-- 🗂️ ACCUEIL RÉORGANISÉ EN ONGLETS — AUCUN bouton retiré, AUCUNE fonction changée.
--    Chaque bouton existant est simplement rangé dans un onglet. L'onglet « 📋 Tout »
--    montre l'ancienne grille complète. Une section ajoutée plus tard (id inconnu ici)
--    apparaît dans « 🧩 Autres » : rien ne peut disparaître de l'accueil.
--    (état rangé dans `economy` : ce fichier est à la limite des 200 variables)
economy.HOME_TABS = {
	{ id = "players", label = "👥 Joueurs",
		ids = { "ban", "unban", "kick", "freeze", "teleport", "bring", "reset", "spectate", "fly",
			"givetool", "tpcheckpoint", "profile", "bans", "vip" } },
	{ id = "ugc", label = "🎽 UGC & boutique",
		ids = { "ugclog", "ugcescrow", "saleslock", "giftlog", "giftkill" } },
	{ id = "security", label = "🛡️ Sécurité",
		ids = { "acboards", "ugcban", "acmodes" } },
	{ id = "game", label = "🎉 Jeu & events",
		ids = { "eventinfo", "adminabuse", "popups", "leaderboards", "feedback" } },
	{ id = "numbers", label = "📊 Chiffres",
		ids = { "engage", "revenue", "ugcstats" } },
}
economy.homeTab = economy.homeTab or "players"
economy.homeSearch = economy.homeSearch or ""

local function screenHome()
	currentScreen = "home"
	local body = buildScreen("⚡ ADMIN PANEL", false, C.TURQUOISE)
	local list = body:FindFirstChildOfClass("UIListLayout")
	if list then list.Padding = UDim.new(0, IS_MOBILE and 6 or 8) end

	-- quel onglet pour chaque bouton existant
	local tabOf, known = {}, {}
	for _, t in ipairs(economy.HOME_TABS) do
		for _, id in ipairs(t.ids) do tabOf[id] = t.id ; known[id] = true end
	end
	local tabs = table.clone(economy.HOME_TABS)
	local hasOther = false
	for _, a in ipairs(ACTIONS) do if not known[a.id] then hasOther = true break end end
	if hasOther then table.insert(tabs, { id = "other", label = "🧩 Autres" }) end
	table.insert(tabs, { id = "all", label = "📋 Tout" })
	local validTab = false
	for _, t in ipairs(tabs) do if t.id == economy.homeTab then validTab = true end end
	if not validTab then economy.homeTab = tabs[1].id end

	-- 🔎 recherche (cherche dans TOUS les onglets)
	local search = Instance.new("TextBox")
	search.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 36)
	search.BackgroundColor3 = C.BG_DARK
	search.BorderSizePixel = 0
	search.Font = FONT
	search.PlaceholderText = "🔎 Chercher une section…"
	search.PlaceholderColor3 = C.TEXT_DIM
	search.Text = economy.homeSearch
	search.TextColor3 = C.TEXT_WHITE
	search.TextSize = IS_MOBILE and 12 or 15
	search.TextXAlignment = Enum.TextXAlignment.Left
	search.ClearTextOnFocus = false
	search.LayoutOrder = 1
	search.ZIndex = 11
	search.Parent = body
	corner(search, 9) ; stroke(search, C.BORDER_SUBTLE, 1)
	local sp = Instance.new("UIPadding") ; sp.PaddingLeft = UDim.new(0, 10) ; sp.Parent = search

	-- onglets (passent à la ligne si besoin)
	local tabRow = Instance.new("Frame")
	tabRow.Size = UDim2.new(1, 0, 0, 0)
	tabRow.AutomaticSize = Enum.AutomaticSize.Y
	tabRow.BackgroundTransparency = 1
	tabRow.LayoutOrder = 2
	tabRow.ZIndex = 11
	tabRow.Parent = body
	local tl = Instance.new("UIGridLayout")
	local pw = panelSize().X.Offset
	local perRow = IS_MOBILE and 3 or 4
	local tgap = IS_MOBILE and 4 or 6
	tl.CellSize = UDim2.new(0, math.floor((pw - PAD * 2 - tgap * (perRow - 1)) / perRow) - 1, 0, IS_MOBILE and 26 or 32)
	tl.CellPadding = UDim2.new(0, tgap, 0, tgap)
	tl.SortOrder = Enum.SortOrder.LayoutOrder
	tl.Parent = tabRow

	-- grille des boutons (exactement les mêmes boutons qu'avant)
	local gridF = Instance.new("Frame")
	gridF.Size = UDim2.new(1, 0, 0, 0)
	gridF.AutomaticSize = Enum.AutomaticSize.Y
	gridF.BackgroundTransparency = 1
	gridF.LayoutOrder = 3
	gridF.ZIndex = 11
	gridF.Parent = body
	local grid = Instance.new("UIGridLayout")
	local gap = IS_MOBILE and 6 or 10
	local cellW = IS_MOBILE and math.floor((pw - PAD * 2 - gap) / 2) or 208
	grid.CellSize = UDim2.new(0, cellW, 0, IS_MOBILE and 48 or 60)
	grid.CellPadding = UDim2.new(0, gap, 0, gap)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = gridF

	local tabButtons = {}
	local function render()
		for _, c in ipairs(gridF:GetChildren()) do if c:IsA("GuiButton") then c:Destroy() end end
		local q = string.lower(economy.homeSearch or "")
		for id, b in pairs(tabButtons) do
			local on = (q == "") and (economy.homeTab == id)
			b.BackgroundColor3 = on and C.TURQUOISE or C.BG_DARK
			b.TextColor3 = on and Color3.new(0, 0, 0) or C.TEXT_WHITE
		end
		for i, a in ipairs(ACTIONS) do
			local show
			if q ~= "" then
				show = string.find(string.lower(a.name), q, 1, true) ~= nil
			elseif economy.homeTab == "all" then
				show = true
			elseif economy.homeTab == "other" then
				show = not known[a.id]
			else
				show = tabOf[a.id] == economy.homeTab
			end
			if show then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(0, cellW, 0, IS_MOBILE and 48 or 60)
				btn.BackgroundColor3 = C.BG_DARK
				btn.AutoButtonColor = false
				btn.BorderSizePixel = 0
				btn.Text = a.name
				btn.Font = FONT
				btn.TextColor3 = C.TEXT_WHITE
				btn.TextSize = IS_MOBILE and 13 or 16
				btn.LayoutOrder = i
				btn.ZIndex = 11
				btn.Parent = gridF
				corner(btn, 10)
				stroke(btn, a.color, 2)
				btn.MouseEnter:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.13), { BackgroundColor3 = a.color }):Play()
				end)
				btn.MouseLeave:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.13), { BackgroundColor3 = C.BG_DARK }):Play()
				end)
				btn.MouseButton1Click:Connect(function() openAction(a) end)
			end
		end
	end
	for k, t in ipairs(tabs) do
		local b = Instance.new("TextButton")
		b.BackgroundColor3 = C.BG_DARK
		b.AutoButtonColor = true
		b.BorderSizePixel = 0
		b.Text = t.label
		b.Font = FONT
		b.TextSize = IS_MOBILE and 11 or 13
		b.TextColor3 = C.TEXT_WHITE
		b.TextTruncate = Enum.TextTruncate.AtEnd
		b.LayoutOrder = k
		b.ZIndex = 12
		b.Parent = tabRow
		corner(b, 8) ; stroke(b, C.BORDER_SUBTLE, 1)
		tabButtons[t.id] = b
		b.MouseButton1Click:Connect(function()
			economy.homeTab = t.id
			economy.homeSearch = ""
			search.Text = ""
			render()
		end)
	end
	search:GetPropertyChangedSignal("Text"):Connect(function()
		economy.homeSearch = search.Text:gsub("^%s+", ""):gsub("%s+$", "")
		render()
	end)
	render()
end

goHome = function()
	screenHome()
end

-- ========================================
-- ÉCRAN : PICKER GÉNÉRIQUE (ban/unban/kick/freeze/teleport/bring/reset)
-- ========================================
-- cfg = { id, title, color, allowSearch, showList, execLabel, toggleFreeze }
local function screenPicker(cfg)
	currentScreen = cfg.id
	local body = buildScreen(cfg.title, true, cfg.color, nil, function() screenPicker(cfg) end)

	-- Barre de recherche (joueur hors serveur)
	if cfg.allowSearch then
		local searchWrap = Instance.new("Frame")
		searchWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 48)
		searchWrap.BackgroundTransparency = 1
		searchWrap.LayoutOrder = 0
		searchWrap.ZIndex = 11
		searchWrap.Parent = body

		local btnW = IS_MOBILE and 74 or 100
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.Size = UDim2.new(1, -btnW - 8, 1, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.Font = FONT
		box.PlaceholderText = "Username or UserID..."
		box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = ""
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 12 or 15
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.ZIndex = 12
		box.Parent = searchWrap
		corner(box, 9); stroke(box, C.BORDER_SUBTLE, 1)
		local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box

		local goC = Instance.new("Frame")
		goC.AnchorPoint = Vector2.new(1, 0.5); goC.Position = UDim2.new(1, 0, 0.5, 0)
		goC.Size = UDim2.new(0, btnW, 1, 0); goC.BackgroundTransparency = 1; goC.ZIndex = 12; goC.Parent = searchWrap
		local goBtn = actionButton(goC, { color = cfg.color, strokeColor = C.BORDER_BRIGHT, text = cfg.execLabel or "GO", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 12 })

		local function run()
			local name = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
			if #name < 2 then toast("Enter a username", false); return end
			adminEvent:FireServer(cfg.id, name)
			toast((cfg.execLabel or "OK") .. " → " .. name, true)
			box.Text = ""
		end
		goBtn.MouseButton1Click:Connect(run)
		box.FocusLost:Connect(function(enter) if enter then run() end end)
	end

	if cfg.showList == false then return end

	sectionLabel(body, 1, "PLAYERS IN THIS SERVER")

	local statusF = Instance.new("Frame")
	statusF.Size = UDim2.new(1, 0, 0, 40); statusF.BackgroundTransparency = 1
	statusF.LayoutOrder = 2; statusF.ZIndex = 11; statusF.Parent = body
	local statusLbl = label(statusF, { text = "Loading players...", size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

	task.spawn(function()
		local list = fetchOnlinePlayers()
		if not statusF.Parent then return end
		statusF:Destroy()
		for i, info in ipairs(list) do
			local tag, tagColor
			if cfg.id == "freeze" and frozen[info.username] then
				tag, tagColor = "FROZEN", C.BLUE
			end
			playerRow(body, info, {
				order = 3 + i, accent = cfg.color, tag = tag, tagColor = tagColor,
				onClick = function(inf, row)
					adminEvent:FireServer(cfg.id, inf.username)
					if cfg.id == "freeze" then
						frozen[inf.username] = not frozen[inf.username]
						toast((frozen[inf.username] and "🧊 Frozen " or "🔥 Unfrozen ") .. inf.username, true)
						-- rafraîchir le tag
						screenPicker(cfg)
					else
						toast(cfg.execLabel .. " → " .. inf.username, true)
					end
				end,
			})
		end
	end)
end

-- ========================================
-- ÉCRAN : FLY
-- ========================================
local flying = false
local flyConn, flyBV, flyBG
local FLY_SPEED = 60

local function stopFly()
	flying = false
	if flyConn then flyConn:Disconnect(); flyConn = nil end
	if flyBV then flyBV:Destroy(); flyBV = nil end
	if flyBG then flyBG:Destroy(); flyBG = nil end
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.PlatformStand = false end
	end
end

local function startFly()
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end
	hum.PlatformStand = true
	flyBV = Instance.new("BodyVelocity")
	flyBV.Velocity = Vector3.zero
	flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	flyBV.Parent = hrp
	flyBG = Instance.new("BodyGyro")
	flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	flyBG.P = 9000; flyBG.D = 250
	flyBG.Parent = hrp
	flying = true
	flyConn = RunService.RenderStepped:Connect(function()
		if not flying then return end
		local c = player.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		if not h then return end
		local cam = workspace.CurrentCamera
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
		if dir.Magnitude > 0 then dir = dir.Unit end
		if flyBV then flyBV.Velocity = dir * FLY_SPEED end
		if flyBG then flyBG.CFrame = CFrame.new(h.Position, h.Position + cam.CFrame.LookVector) end
	end)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.F and flying then stopFly() end
end)
player.CharacterAdded:Connect(function()
	if flying then stopFly() end
end)

local function screenFly()
	currentScreen = "fly"
	local body = buildScreen("✈️ FLY", true, C.BLUE, nil, screenFly)

	local selfC = Instance.new("Frame")
	selfC.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 52)
	selfC.BackgroundTransparency = 1
	selfC.LayoutOrder = 0
	selfC.ZIndex = 11
	selfC.Parent = body
	local selfBtn, selfLbl = actionButton(selfC, {
		color = flying and C.RED or C.BLUE, strokeColor = C.BLUE_DARK,
		text = flying and "🛑 Stop flying (F)" or "✈️ Fly me (WASD/Space)", textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11,
	})
	selfBtn.MouseButton1Click:Connect(function()
		if flying then stopFly() else startFly() end
		screenFly()
	end)

	sectionLabel(body, 1, "MAKE ANOTHER PLAYER FLY")
	local statusF = Instance.new("Frame")
	statusF.Size = UDim2.new(1, 0, 0, 36); statusF.BackgroundTransparency = 1
	statusF.LayoutOrder = 2; statusF.ZIndex = 11; statusF.Parent = body
	label(statusF, { text = "Loading...", size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 14, zIndex = 11 })

	task.spawn(function()
		local list = fetchOnlinePlayers()
		if not statusF.Parent then return end
		statusF:Destroy()
		for i, info in ipairs(list) do
			if not info.isSelf then
				playerRow(body, info, {
					order = 3 + i, accent = C.BLUE,
					onClick = function(inf)
						adminEvent:FireServer("fly", inf.username)
						toast("✈️ Fly toggled → " .. inf.username, true)
					end,
				})
			end
		end
	end)
end

-- ========================================
-- ÉCRAN : GIVE TOOL
-- ========================================
local screenGiveTool
do
	--  🎁 GIVE TOOLS — plusieurs joueurs × plusieurs outils, en un seul clic.
	--  La sélection reste gardée : tu peux redonner, changer un joueur, etc.
	--  Tout est dans ce bloc `do` : aucune variable ajoutée au script (limite 200).
	local GS = {
		players = {},        -- [userId] = true
		tools = {},          -- [nom de l'outil] = true
		toolList = nil,      -- noms reçus du serveur (cache de session)
		loadingTools = false,
		pSearch = "", tSearch = "",
		skipDup = true,
		duration = 0,        -- 0 = une fois (perdu à la mort) · sinon secondes de prêt
		allServer = false,   -- prêt à tout le serveur, y compris ceux qui rejoignent
		loans = nil,         -- prêts en cours (lus sur le serveur)
		loansError = nil,
	}
	local DURATION_CHOICES = {
		{ s = 0,    label = "Une fois" },
		{ s = 300,  label = "5 min" },
		{ s = 600,  label = "10 min" },
		{ s = 900,  label = "15 min" },
		{ s = 1800, label = "30 min" },
		{ s = 3600, label = "1 h" },
	}
	local function durLabel(sec)
		for _, d in ipairs(DURATION_CHOICES) do if d.s == sec then return d.label end end
		return tostring(sec) .. " s"
	end
	local function fmtLeft(sec)
		sec = math.max(0, math.floor(sec))
		if sec >= 3600 then return string.format("%d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60) end
		return string.format("%d:%02d", sec // 60, sec % 60)
	end
	local ACC = C.ORANGE

	-- Réponses du serveur : don groupé, fin / arrêt d'un prêt
	adminEvent.OnClientEvent:Connect(function(action, data)
		if type(data) ~= "table" then return end
		if action == "givetools_result" then
			if data.error then toast("❌ " .. tostring(data.error), false) return end
			local given, extended = tonumber(data.given) or 0, tonumber(data.extended) or 0
			local dur = tonumber(data.duration) or 0
			local msg = string.format("🎁 %d objet(s) donné(s)", given)
			if extended > 0 then msg = msg .. string.format(" · %d prolongé(s)", extended) end
			if (tonumber(data.skipped) or 0) > 0 then msg = msg .. string.format(" · %d déjà possédé(s)", data.skipped) end
			if (tonumber(data.offline) or 0) > 0 then msg = msg .. string.format(" · %d joueur(s) parti(s)", data.offline) end
			if dur > 0 then msg = msg .. " · ⏱️ " .. durLabel(dur) end
			toast(msg, given + extended > 0)
			if dur > 0 and GS.fetchLoans then GS.fetchLoans() end
		elseif action == "loan_ended" then
			if data.cancelled then
				toast(string.format("⏹️ %d prêt(s) arrêté(s) · %d arme(s) retirée(s)", data.cancelled, data.removed or 0), true)
			elseif type(data.tools) == "table" then
				toast("⏱️ Prêt terminé : " .. table.concat(data.tools, ", "), true)
			end
			if GS.fetchLoans then GS.fetchLoans() end
		end
	end)

	local function countSel(t)
		local n = 0
		for _ in pairs(t) do n = n + 1 end
		return n
	end

	local function miniAvatar(parent, uid, size)
		local av = Instance.new("ImageLabel")
		av.Size = UDim2.new(0, size, 0, size)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, 8, 0.5, 0)
		av.BackgroundColor3 = C.BG_LIGHT
		av.BorderSizePixel = 0
		av.ZIndex = 13
		av.Parent = parent
		corner(av, size / 2)
		if thumbCache[uid] then
			av.Image = thumbCache[uid]
		else
			task.spawn(function()
				local ok, img = pcall(function()
					return Players:GetUserThumbnailAsync(uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
				end)
				if ok and img then
					thumbCache[uid] = img
					if av.Parent then av.Image = img end
				end
			end)
		end
		return av
	end

	local function searchBox(parent, order, placeholder, initial, onChange)
		local tb = Instance.new("TextBox")
		tb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 36)
		tb.BackgroundColor3 = C.BG_DARK
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.PlaceholderText = placeholder
		tb.PlaceholderColor3 = C.TEXT_DIM
		tb.Text = initial or ""
		tb.TextColor3 = C.TEXT_WHITE
		tb.TextSize = IS_MOBILE and 11 or 14
		tb.TextXAlignment = Enum.TextXAlignment.Left
		tb.ClearTextOnFocus = false
		tb.LayoutOrder = order
		tb.ZIndex = 12
		tb.Parent = parent
		corner(tb, 8); stroke(tb, C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0, 10); p.Parent = tb
		tb:GetPropertyChangedSignal("Text"):Connect(function() onChange(tb.Text) end)
		return tb
	end

	local function quickRow(parent, order, items)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / #items, -6, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = f
		for i, it in ipairs(items) do
			local c = Instance.new("Frame")
			c.LayoutOrder = i; c.BackgroundTransparency = 1; c.ZIndex = 12; c.Parent = f
			local b = actionButton(c, { color = it.color or C.BG_LIGHT, strokeColor = it.stroke or C.BORDER_BRIGHT,
				text = it.text, textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(it.fn)
		end
		return f
	end

	screenGiveTool = function()
		currentScreen = "givetool"
		local body = buildScreen("🎁 GIVE TOOLS", true, ACC, nil, function()
			GS.toolList = nil
			screenGiveTool()
		end)

		-- Les joueurs partis sortent de la sélection
		for uid in pairs(GS.players) do
			if not Players:GetPlayerByUserId(uid) then GS.players[uid] = nil end
		end

		----------------------------------------------------------------
		-- 📌 BARRE DU BAS, TOUJOURS VISIBLE (plus besoin de descendre)
		----------------------------------------------------------------
		local BAR_H = IS_MOBILE and 56 or 64
		body.Size = UDim2.new(1, 0, 1, -HEADER_H - BAR_H)

		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.new(0, 0, 1, 0)
		bar.Size = UDim2.new(1, 0, 0, BAR_H)
		bar.BackgroundColor3 = C.BG_DARK
		bar.BorderSizePixel = 0
		bar.ZIndex = 20
		bar.Parent = window
		corner(bar, 14)
		local mask = Instance.new("Frame")
		mask.Size = UDim2.new(1, 0, 0, 14)
		mask.BackgroundColor3 = C.BG_DARK
		mask.BorderSizePixel = 0
		mask.ZIndex = 20
		mask.Parent = bar
		local sep = Instance.new("Frame")
		sep.Size = UDim2.new(1, 0, 0, 1)
		sep.BackgroundColor3 = ACC
		sep.BackgroundTransparency = 0.3
		sep.BorderSizePixel = 0
		sep.ZIndex = 21
		sep.Parent = bar

		local giveW = IS_MOBILE and 112 or 150
		local clearW = IS_MOBILE and 40 or 46
		local summary = label(bar, {
			text = "", size = UDim2.new(1, -giveW - clearW - 32, 1, -10),
			position = UDim2.new(0, 12, 0, 5), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, wrapped = true, zIndex = 21,
		})

		local cc = Instance.new("Frame")
		cc.AnchorPoint = Vector2.new(1, 0.5)
		cc.Position = UDim2.new(1, -giveW - 16, 0.5, 0)
		cc.Size = UDim2.new(0, clearW, 0, BAR_H - 18)
		cc.BackgroundTransparency = 1
		cc.ZIndex = 21
		cc.Parent = bar
		local clearBtn = actionButton(cc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "✕", textSize = IS_MOBILE and 13 or 16, radius = 9, zIndex = 21 })

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, -8, 0.5, 0)
		gc.Size = UDim2.new(0, giveW, 0, BAR_H - 14)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 21
		gc.Parent = bar
		local giveBtn, giveLbl = actionButton(gc, { color = C.BG_LIGHT, strokeColor = C.ORANGE_DARK,
			text = "🎁 DONNER", textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 21 })

		local function refreshSummary()
			local np = countSel(GS.players)
			local nt = 0
			for _, name in ipairs(GS.toolList or {}) do if GS.tools[name] then nt = nt + 1 end end
			local all = GS.allServer and GS.duration > 0
			local when = (GS.duration > 0) and ("⏱️ " .. durLabel(GS.duration) .. " · gardé après la mort")
				or "Une fois · perdu à la mort"
			if all then
				summary.Text = string.format("🌍 Tout le serveur · 🔧 %d outil(s)\n%s", nt, when)
			elseif np == 0 and nt == 0 then
				summary.Text = "Coche des joueurs et des outils.\n" .. when
			else
				summary.Text = string.format("🧍 %d · 🔧 %d = %d objet(s)\n%s", np, nt, np * nt, when)
			end
			local ready = nt > 0 and (all or np > 0)
			giveBtn.BackgroundColor3 = ready and C.GREEN or C.BG_LIGHT
			if not ready then
				giveLbl.Text = "🎁 DONNER"
			elseif all then
				giveLbl.Text = "🌍 DONNER " .. durLabel(GS.duration)
			else
				giveLbl.Text = (GS.duration > 0 and "⏱️ DONNER ×" or "🎁 DONNER ×") .. (np * nt)
			end
		end

		giveBtn.MouseButton1Click:Connect(function()
			local targets, tools = {}, {}
			for uid in pairs(GS.players) do
				if Players:GetPlayerByUserId(uid) then targets[#targets + 1] = uid end
			end
			for _, name in ipairs(GS.toolList or {}) do
				if GS.tools[name] then tools[#tools + 1] = name end
			end
			local all = GS.allServer and GS.duration > 0
			if #tools == 0 then toast("Coche au moins un outil", false) return end
			if not all and #targets == 0 then toast("Coche au moins un joueur", false) return end
			adminEvent:FireServer("givetools", nil, { targets = targets, tools = tools,
				skipDuplicates = GS.skipDup, duration = GS.duration, allServer = all })
			toast(all and string.format("🌍 Envoi : %d outil(s) → tout le serveur…", #tools)
				or string.format("🎁 Envoi : %d outil(s) → %d joueur(s)…", #tools, #targets), true)
		end)

		----------------------------------------------------------------
		-- ⏱️ DURÉE
		----------------------------------------------------------------
		sectionLabel(body, -4, "DURÉE  — un prêt est gardé même après la mort")
		local durGrid = Instance.new("Frame")
		durGrid.Size = UDim2.new(1, 0, 0, 0)
		durGrid.AutomaticSize = Enum.AutomaticSize.Y
		durGrid.BackgroundTransparency = 1
		durGrid.LayoutOrder = -3
		durGrid.ZIndex = 11
		durGrid.Parent = body
		local dg = Instance.new("UIGridLayout")
		dg.CellSize = UDim2.new(1 / 3, -6, 0, IS_MOBILE and 30 or 34)
		dg.CellPadding = UDim2.new(0, 6, 0, 6)
		dg.SortOrder = Enum.SortOrder.LayoutOrder
		dg.Parent = durGrid
		local durRefs = {}

		local allRow = Instance.new("TextButton")
		allRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 36)
		allRow.BackgroundColor3 = C.BG_DARK
		allRow.AutoButtonColor = false
		allRow.Text = ""
		allRow.BorderSizePixel = 0
		allRow.LayoutOrder = -2
		allRow.ZIndex = 11
		allRow.Parent = body
		corner(allRow, 8)
		local allStroke = stroke(allRow, C.BORDER_SUBTLE, 1)
		local allLbl = label(allRow, { text = "", size = UDim2.new(1, -20, 1, 0), position = UDim2.new(0, 10, 0, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13,
			truncate = true, zIndex = 12 })

		local function paintDur()
			for _, r in ipairs(durRefs) do
				local sel = (r.s == GS.duration)
				r.btn.BackgroundColor3 = sel and ACC or C.BG_DARK
				r.btn.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
				r.stroke.Color = sel and ACC or C.BORDER_SUBTLE
			end
			allRow.Visible = GS.duration > 0
			allLbl.Text = GS.allServer and "✅ 🌍 Tout le serveur, y compris ceux qui rejoignent"
				or "⬜ 🌍 Tout le serveur, y compris ceux qui rejoignent"
			allStroke.Color = GS.allServer and C.GREEN or C.BORDER_SUBTLE
		end
		for i, d in ipairs(DURATION_CHOICES) do
			local b = Instance.new("TextButton")
			b.BackgroundColor3 = C.BG_DARK
			b.AutoButtonColor = false
			b.BorderSizePixel = 0
			b.Font = FONT
			b.Text = d.label
			b.TextSize = IS_MOBILE and 11 or 14
			b.LayoutOrder = i
			b.ZIndex = 12
			b.Parent = durGrid
			corner(b, 8)
			local r = { s = d.s, btn = b, stroke = stroke(b, C.BORDER_SUBTLE, 1) }
			durRefs[#durRefs + 1] = r
			b.MouseButton1Click:Connect(function()
				GS.duration = d.s
				paintDur()
				refreshSummary()
			end)
		end
		allRow.MouseButton1Click:Connect(function()
			GS.allServer = not GS.allServer
			paintDur()
			refreshSummary()
		end)
		paintDur()

		----------------------------------------------------------------
		-- ⚙️ OPTION
		----------------------------------------------------------------
		local opt = Instance.new("TextButton")
		opt.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 36)
		opt.BackgroundColor3 = C.BG_DARK
		opt.AutoButtonColor = false
		opt.Text = ""
		opt.BorderSizePixel = 0
		opt.LayoutOrder = 0
		opt.ZIndex = 11
		opt.Parent = body
		corner(opt, 8)
		local optStroke = stroke(opt, C.BORDER_SUBTLE, 1)
		local optLbl = label(opt, { text = "", size = UDim2.new(1, -20, 1, 0), position = UDim2.new(0, 10, 0, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13,
			truncate = true, zIndex = 12 })
		local function paintOpt()
			optLbl.Text = GS.skipDup and "✅ Ne pas redonner un outil déjà possédé"
				or "⬜ Donner même si le joueur l'a déjà (doublons)"
			optStroke.Color = GS.skipDup and C.GREEN or C.BORDER_SUBTLE
		end
		paintOpt()
		opt.MouseButton1Click:Connect(function() GS.skipDup = not GS.skipDup; paintOpt() end)

		----------------------------------------------------------------
		-- 🧍 JOUEURS
		----------------------------------------------------------------
		local list = Players:GetPlayers()
		table.sort(list, function(a, b)
			if a == b then return false end
			if a == player then return true end
			if b == player then return false end
			return a.DisplayName:lower() < b.DisplayName:lower()
		end)

		sectionLabel(body, 1, "JOUEURS  (" .. #list .. ")  — touche pour cocher")
		local pRefs = {}
		local function paintPlayer(r)
			local sel = GS.players[r.uid] == true
			r.row.BackgroundColor3 = sel and C.BG_SELECTED or C.BG_DARK
			r.stroke.Color = sel and ACC or C.BORDER_SUBTLE
			r.stroke.Thickness = sel and 2 or 1
			r.box.BackgroundColor3 = sel and ACC or C.BG_LIGHT
			r.check.Text = sel and "✓" or ""
		end
		local function playerVisible(r)
			local q = GS.pSearch:lower()
			return q == "" or r.search:find(q, 1, true) ~= nil
		end
		local function applyPlayerFilter()
			for _, r in ipairs(pRefs) do r.row.Visible = playerVisible(r) end
		end

		quickRow(body, 2, {
			{ text = "✅ Tous", fn = function()
				for _, r in ipairs(pRefs) do
					if playerVisible(r) and Players:GetPlayerByUserId(r.uid) then GS.players[r.uid] = true end
					paintPlayer(r)
				end
				refreshSummary()
			end },
			{ text = "👑 Moi", fn = function()
				GS.players[player.UserId] = not GS.players[player.UserId] or nil
				for _, r in ipairs(pRefs) do paintPlayer(r) end
				refreshSummary()
			end },
			{ text = "✕ Aucun", fn = function()
				table.clear(GS.players)
				for _, r in ipairs(pRefs) do paintPlayer(r) end
				refreshSummary()
			end },
		})
		if #list > 6 then
			searchBox(body, 3, "🔍 Chercher un joueur...", GS.pSearch, function(t)
				GS.pSearch = t; applyPlayerFilter()
			end)
		end

		local pHolder = Instance.new("Frame")
		pHolder.Size = UDim2.new(1, 0, 0, 0)
		pHolder.AutomaticSize = Enum.AutomaticSize.Y
		pHolder.BackgroundTransparency = 1
		pHolder.LayoutOrder = 4
		pHolder.ZIndex = 11
		pHolder.Parent = body
		local pl = Instance.new("UIListLayout")
		pl.Padding = UDim.new(0, IS_MOBILE and 4 or 6)
		pl.SortOrder = Enum.SortOrder.LayoutOrder
		pl.Parent = pHolder

		local RH = IS_MOBILE and 42 or 48
		for i, p in ipairs(list) do
			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, 0, 0, RH)
			row.BackgroundColor3 = C.BG_DARK
			row.AutoButtonColor = false
			row.Text = ""
			row.BorderSizePixel = 0
			row.LayoutOrder = i
			row.ZIndex = 12
			row.Parent = pHolder
			corner(row, 9)
			local st = stroke(row, C.BORDER_SUBTLE, 1)
			local avS = RH - 12
			miniAvatar(row, p.UserId, avS)
			local tx = 8 + avS + 10
			local boxS = IS_MOBILE and 22 or 26
			label(row, { text = (p == player and "👑 " or "") .. p.DisplayName,
				size = UDim2.new(1, -tx - boxS - 20, 0, IS_MOBILE and 16 or 19),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 5 or 6), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_WHITE, textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })
			label(row, { text = "@" .. p.Name,
				size = UDim2.new(1, -tx - boxS - 20, 0, IS_MOBILE and 13 or 15),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 22 or 26), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
			local box = Instance.new("Frame")
			box.AnchorPoint = Vector2.new(1, 0.5)
			box.Position = UDim2.new(1, -10, 0.5, 0)
			box.Size = UDim2.new(0, boxS, 0, boxS)
			box.BackgroundColor3 = C.BG_LIGHT
			box.BorderSizePixel = 0
			box.ZIndex = 13
			box.Parent = row
			corner(box, 6)
			local check = label(box, { text = "", size = UDim2.fromScale(1, 1), color = C.BG_BLACK,
				textSize = IS_MOBILE and 14 or 17, zIndex = 14 })
			local r = { uid = p.UserId, row = row, stroke = st, box = box, check = check,
				search = (p.DisplayName .. " " .. p.Name .. " " .. p.UserId):lower() }
			pRefs[#pRefs + 1] = r
			paintPlayer(r)
			row.MouseButton1Click:Connect(function()
				GS.players[r.uid] = not GS.players[r.uid] or nil
				paintPlayer(r)
				refreshSummary()
			end)
		end
		applyPlayerFilter()

		----------------------------------------------------------------
		-- 🔧 OUTILS
		----------------------------------------------------------------
		local toolsTitle = sectionLabel(body, 10, "OUTILS  — plusieurs possibles")
		local tRefs = {}
		local function paintTool(r)
			local sel = GS.tools[r.name] == true
			r.btn.BackgroundColor3 = sel and C.ORANGE_DARK or C.BG_DARK
			r.stroke.Color = sel and ACC or C.BORDER_SUBTLE
			r.stroke.Thickness = sel and 2 or 1
			r.btn.Text = (sel and "  ✅ " or "  🔧 ") .. r.name
			r.btn.TextColor3 = sel and C.TEXT_WHITE or C.TEXT_GREY
		end
		local function toolVisible(r)
			local q = GS.tSearch:lower()
			return q == "" or r.lower:find(q, 1, true) ~= nil
		end

		quickRow(body, 11, {
			{ text = "✅ Tous (filtrés)", fn = function()
				for _, r in ipairs(tRefs) do
					if toolVisible(r) then GS.tools[r.name] = true end
					paintTool(r)
				end
				refreshSummary()
			end },
			{ text = "✕ Aucun", fn = function()
				table.clear(GS.tools)
				for _, r in ipairs(tRefs) do paintTool(r) end
				refreshSummary()
			end },
		})
		searchBox(body, 12, "🔍 Chercher un outil...", GS.tSearch, function(t)
			GS.tSearch = t
			for _, r in ipairs(tRefs) do r.btn.Visible = toolVisible(r) end
		end)

		local grid = Instance.new("Frame")
		grid.Size = UDim2.new(1, 0, 0, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y
		grid.BackgroundTransparency = 1
		grid.LayoutOrder = 13
		grid.ZIndex = 11
		grid.Parent = body
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.new(0.5, -4, 0, IS_MOBILE and 34 or 40)
		gl.CellPadding = UDim2.new(0, 8, 0, 6)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = grid

		-- 📭 Message sous la grille : erreur / aucun outil, avec bouton Réessayer
		local toolsMsg = Instance.new("Frame")
		toolsMsg.Size = UDim2.new(1, 0, 0, 0)
		toolsMsg.AutomaticSize = Enum.AutomaticSize.Y
		toolsMsg.BackgroundColor3 = C.BG_ITEM
		toolsMsg.BorderSizePixel = 0
		toolsMsg.LayoutOrder = 14
		toolsMsg.Visible = false
		toolsMsg.ZIndex = 11
		toolsMsg.Parent = body
		corner(toolsMsg, 8); stroke(toolsMsg, C.ORANGE, 1)
		padding(toolsMsg, 8)
		local tml = Instance.new("UIListLayout")
		tml.Padding = UDim.new(0, 6); tml.SortOrder = Enum.SortOrder.LayoutOrder; tml.Parent = toolsMsg
		local msgLbl = Instance.new("TextLabel")
		msgLbl.Size = UDim2.new(1, 0, 0, 0)
		msgLbl.AutomaticSize = Enum.AutomaticSize.Y
		msgLbl.BackgroundTransparency = 1
		msgLbl.Font = FONT
		msgLbl.Text = ""
		msgLbl.TextColor3 = C.ORANGE
		msgLbl.TextSize = IS_MOBILE and 10 or 12
		msgLbl.TextWrapped = true
		msgLbl.TextXAlignment = Enum.TextXAlignment.Left
		msgLbl.LayoutOrder = 1
		msgLbl.ZIndex = 12
		msgLbl.Parent = toolsMsg
		local retryWrap = Instance.new("Frame")
		retryWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 36)
		retryWrap.BackgroundTransparency = 1
		retryWrap.LayoutOrder = 2
		retryWrap.ZIndex = 12
		retryWrap.Parent = toolsMsg
		local retryBtn = actionButton(retryWrap, { color = C.ORANGE_DARK, strokeColor = C.ORANGE,
			text = "🔄 Réessayer", textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })

		local fetchTools  -- fwd

		local function buildTools()
			if not grid.Parent then return end
			for _, ch in ipairs(grid:GetChildren()) do
				if not ch:IsA("UIGridLayout") then ch:Destroy() end
			end
			table.clear(tRefs)
			local titleLbl = toolsTitle:FindFirstChildOfClass("TextLabel")
			local names = GS.toolList

			-- ⏳ Pas encore de liste : « chargement » OU erreur — jamais d'attente infinie
			if not names then
				if titleLbl then
					titleLbl.Text = GS.toolsError and "OUTILS  — ❌ non chargés" or "OUTILS  — chargement..."
				end
				toolsMsg.Visible = GS.toolsError ~= nil
				msgLbl.Text = GS.toolsError or ""
				refreshSummary()
				return
			end

			if #names == 0 then
				toolsMsg.Visible = true
				msgLbl.Text = "Aucun Tool trouvé dans ServerStorage (ni dans ses dossiers).\n"
					.. "Range tes outils dans ServerStorage, puis appuie sur Réessayer."
			else
				toolsMsg.Visible = false
				msgLbl.Text = ""
			end
			if titleLbl then
				titleLbl.Text = (#names == 0) and "OUTILS  — aucun"
					or ("OUTILS  (" .. #names .. ")  — plusieurs possibles")
			end
			for i, name in ipairs(names) do
				local b = Instance.new("TextButton")
				b.BackgroundColor3 = C.BG_DARK
				b.AutoButtonColor = false
				b.BorderSizePixel = 0
				b.Font = FONT
				b.TextSize = IS_MOBILE and 11 or 14
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.TextTruncate = Enum.TextTruncate.AtEnd
				b.LayoutOrder = i
				b.ZIndex = 12
				b.Parent = grid
				corner(b, 8)
				local r = { name = name, lower = string.lower(tostring(name)), btn = b, stroke = stroke(b, C.BORDER_SUBTLE, 1) }
				tRefs[#tRefs + 1] = r
				paintTool(r)
				b.Visible = toolVisible(r)
				b.MouseButton1Click:Connect(function()
					GS.tools[name] = not GS.tools[name] or nil
					paintTool(r)
					refreshSummary()
				end)
			end
			-- un outil retiré de ServerStorage sort de la sélection
			local known = {}
			for _, n in ipairs(names) do known[n] = true end
			for n in pairs(GS.tools) do if not known[n] then GS.tools[n] = nil end end
			refreshSummary()
		end

		-- 📡 Lecture de la liste avec délai maximum : au bout de 8 s sans réponse,
		--    on affiche la cause probable au lieu de tourner à l'infini.
		--    Une réponse qui arrive en retard est quand même utilisée.
		fetchTools = function()
			local token = {}
			GS.fetchToken = token
			GS.loadingTools = true
			GS.toolsError = nil
			task.spawn(function()
				local ok, res = pcall(function() return getToolsEvent:InvokeServer() end)
				if ok and type(res) == "table" then
					GS.toolList = res
					GS.toolsError = nil
				elseif not GS.toolList and GS.fetchToken == token then
					GS.toolsError = "❌ Le serveur a renvoyé une erreur :\n" .. tostring(res)
				end
				if GS.fetchToken == token then GS.loadingTools = false end
				if currentScreen == "givetool" and GS.onTools then GS.onTools() end
			end)
			task.delay(8, function()
				if GS.fetchToken == token and GS.loadingTools and not GS.toolList then
					GS.loadingTools = false
					GS.toolsError = "⏳ Le serveur ne répond pas (AdminGetTools).\n"
						.. "• Dans AdminPanel_Server, la fonction getToolsEvent.OnServerInvoke doit exister (patch T1).\n"
						.. "• Regarde la console SERVEUR : une erreur rouge dans AdminPanel_Server bloque tout ce qui suit."
					if currentScreen == "givetool" and GS.onTools then GS.onTools() end
				end
			end)
		end

		retryBtn.MouseButton1Click:Connect(function()
			GS.toolList = nil
			fetchTools()
			buildTools()
		end)

		clearBtn.MouseButton1Click:Connect(function()
			table.clear(GS.players); table.clear(GS.tools)
			for _, r in ipairs(pRefs) do paintPlayer(r) end
			for _, r in ipairs(tRefs) do paintTool(r) end
			refreshSummary()
		end)

		----------------------------------------------------------------
		-- ⏱️ PRÊTS EN COURS
		----------------------------------------------------------------
		sectionLabel(body, 20, "⏱️ PRÊTS EN COURS SUR CE SERVEUR")
		local loansHolder = Instance.new("Frame")
		loansHolder.Size = UDim2.new(1, 0, 0, 0)
		loansHolder.AutomaticSize = Enum.AutomaticSize.Y
		loansHolder.BackgroundTransparency = 1
		loansHolder.LayoutOrder = 21
		loansHolder.ZIndex = 11
		loansHolder.Parent = body
		local lhl = Instance.new("UIListLayout")
		lhl.Padding = UDim.new(0, IS_MOBILE and 5 or 7)
		lhl.SortOrder = Enum.SortOrder.LayoutOrder
		lhl.Parent = loansHolder
		local countdowns = {}   -- { lbl, endAt }

		local function renderLoans()
			if not loansHolder.Parent then return end
			for _, ch in ipairs(loansHolder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			table.clear(countdowns)
			local list = GS.loans
			if not list then
				label(loansHolder, { text = GS.loansError or "Chargement des prêts...",
					size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26), xAlign = Enum.TextXAlignment.Left,
					color = GS.loansError and C.ORANGE or C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12,
					wrapped = true, zIndex = 12 })
				return
			end
			if #list == 0 then
				label(loansHolder, { text = "Aucun prêt en cours. Choisis une durée plus haut pour en créer un.",
					size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12, wrapped = true, zIndex = 12 })
				return
			end
			for i, loan in ipairs(list) do
				local card = Instance.new("Frame")
				card.Size = UDim2.new(1, 0, 0, IS_MOBILE and 54 or 60)
				card.BackgroundColor3 = C.BG_DARK
				card.BorderSizePixel = 0
				card.LayoutOrder = i
				card.ZIndex = 12
				card.Parent = loansHolder
				corner(card, 9); stroke(card, ACC, 1)
				local stopW = IS_MOBILE and 70 or 90
				local timeW = IS_MOBILE and 56 or 70
				label(card, { text = "🔧 " .. table.concat(loan.tools or {}, ", "),
					size = UDim2.new(1, -stopW - timeW - 26, 0, IS_MOBILE and 17 or 20),
					position = UDim2.new(0, 10, 0, IS_MOBILE and 7 or 9), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_WHITE, textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 13 })
				local who = loan.all and "🌍 tout le serveur"
					or ("🧍 " .. tostring(loan.players or 0) .. " joueur(s)"
						.. ((type(loan.names) == "table" and #loan.names > 0) and (" · " .. table.concat(loan.names, ", ")) or ""))
				label(card, { text = who .. " · " .. durLabel(loan.duration) .. " · par " .. tostring(loan.by or "?"),
					size = UDim2.new(1, -stopW - timeW - 26, 0, IS_MOBILE and 14 or 16),
					position = UDim2.new(0, 10, 0, IS_MOBILE and 28 or 33), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
				local tl = label(card, { text = fmtLeft(loan.remaining or 0),
					size = UDim2.new(0, timeW, 1, 0), position = UDim2.new(1, -stopW - 14, 0, 0),
					anchor = Vector2.new(1, 0), color = ACC, textSize = IS_MOBILE and 13 or 16, zIndex = 13 })
				countdowns[#countdowns + 1] = { lbl = tl, endAt = loan.endAt or os.clock() }
				local sc = Instance.new("Frame")
				sc.AnchorPoint = Vector2.new(1, 0.5)
				sc.Position = UDim2.new(1, -8, 0.5, 0)
				sc.Size = UDim2.new(0, stopW, 0, IS_MOBILE and 30 or 34)
				sc.BackgroundTransparency = 1
				sc.ZIndex = 13
				sc.Parent = card
				local sb, sl = actionButton(sc, { color = C.RED_DARK, strokeColor = C.RED,
					text = "✕ Arrêter", textSize = IS_MOBILE and 10 or 12, radius = 8, zIndex = 13 })
				local armed = false
				sb.MouseButton1Click:Connect(function()
					if not armed then
						armed = true; sl.Text = "Sûr ?"
						task.delay(3, function() if sl.Parent then armed = false; sl.Text = "✕ Arrêter" end end)
						return
					end
					adminEvent:FireServer("cancelloan", nil, loan.id)
				end)
			end
			if #list >= 2 then
				local ac = Instance.new("Frame")
				ac.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 38)
				ac.BackgroundTransparency = 1
				ac.LayoutOrder = 999
				ac.ZIndex = 12
				ac.Parent = loansHolder
				local ab, al = actionButton(ac, { color = C.RED_DARK, strokeColor = C.RED,
					text = "⏹️ Tout arrêter (" .. #list .. ")", textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })
				local armedAll = false
				ab.MouseButton1Click:Connect(function()
					if not armedAll then
						armedAll = true; al.Text = "Appuie encore pour tout arrêter"
						task.delay(3, function() if al.Parent then armedAll = false; al.Text = "⏹️ Tout arrêter (" .. #list .. ")" end end)
						return
					end
					adminEvent:FireServer("cancelloan", nil, "all")
				end)
			end
		end

		GS.fetchLoans = function()
			local token = {}
			GS.loansToken = token
			task.spawn(function()
				local ok, res = pcall(function() return getToolsEvent:InvokeServer("loans") end)
				if GS.loansToken ~= token then return end
				if ok and type(res) == "table" and type(res.loans) == "table" then
					local now = os.clock()
					for _, l in ipairs(res.loans) do l.endAt = now + (tonumber(l.remaining) or 0) end
					GS.loans, GS.loansError = res.loans, nil
				elseif ok then
					GS.loans, GS.loansError = nil, "⚠️ Serveur pas à jour : colle le bloc L1 dans AdminPanel_Server."
				else
					GS.loans, GS.loansError = nil, "❌ Lecture des prêts impossible : " .. tostring(res)
				end
				if currentScreen == "givetool" and GS.onLoans then GS.onLoans() end
			end)
			task.delay(8, function()
				if GS.loansToken == token and not GS.loans and not GS.loansError then
					GS.loansError = "⏳ Le serveur ne répond pas (prêts)."
					if currentScreen == "givetool" and GS.onLoans then GS.onLoans() end
				end
			end)
		end

		-- compte à rebours (une seule boucle par écran, s'arrête quand l'écran disparaît)
		task.spawn(function()
			while loansHolder.Parent do
				local ended = false
				for _, c in ipairs(countdowns) do
					local left = c.endAt - os.clock()
					if c.lbl.Parent then c.lbl.Text = fmtLeft(left) end
					if left <= -2 then ended = true end
				end
				if ended then
					table.clear(countdowns)
					GS.fetchLoans()
				end
				task.wait(1)
			end
		end)

		refreshSummary()
		GS.onTools = buildTools   -- toujours l'écran le plus récent
		GS.onLoans = renderLoans
		if not GS.toolList then fetchTools() end
		buildTools()
		renderLoans()
		GS.fetchLoans()
	end
end
-- ========================================
-- ÉCRAN : TP CHECKPOINT
-- ========================================
local function screenCheckpoint()
	currentScreen = "tpcheckpoint"
	local body = buildScreen("📍 TP CHECKPOINT", true, C.GREEN, nil, screenCheckpoint)
	local selectedTarget
	local rows = {}

	sectionLabel(body, 0, "TARGET PLAYER")
	local status = Instance.new("Frame")
	status.Size = UDim2.new(1, 0, 0, 30); status.BackgroundTransparency = 1
	status.LayoutOrder = 1; status.ZIndex = 11; status.Parent = body
	label(status, { text = "Loading players...", size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })

	task.spawn(function()
		local list = fetchOnlinePlayers()
		if not status.Parent then return end
		status:Destroy()
		for i, info in ipairs(list) do
			local row, rs = playerRow(body, info, { order = 2 + i, accent = C.GREEN })
			local entry = { row = row, stroke = rs }
			table.insert(rows, entry)
			row.MouseButton1Click:Connect(function()
				selectedTarget = info.username
				for _, r in ipairs(rows) do
					r.row.BackgroundColor3 = (r == entry) and C.BG_SELECTED or C.BG_DARK
					r.stroke.Color = (r == entry) and C.GREEN or C.BORDER_SUBTLE
				end
				toast("Target: " .. info.username, true)
			end)
		end
	end)

	sectionLabel(body, 500, "CHECKPOINT NUMBER (1–125)")
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 46)
	box.BackgroundColor3 = C.BG_DARK
	box.BorderSizePixel = 0
	box.Font = FONT
	box.PlaceholderText = "Enter number..."
	box.PlaceholderColor3 = C.TEXT_DIM
	box.Text = ""
	box.TextColor3 = C.TEXT_WHITE
	box.TextSize = IS_MOBILE and 14 or 18
	box.LayoutOrder = 501
	box.ZIndex = 11
	box.Parent = body
	corner(box, 9); stroke(box, C.BORDER_SUBTLE, 1)

	local goC = Instance.new("Frame")
	goC.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 52)
	goC.BackgroundTransparency = 1
	goC.LayoutOrder = 502
	goC.ZIndex = 11
	goC.Parent = body
	local goBtn = actionButton(goC, { color = C.GREEN, strokeColor = C.GREEN_DARK, text = "📍 TELEPORT", textSize = IS_MOBILE and 15 or 18, radius = 10, zIndex = 11 })
	goBtn.MouseButton1Click:Connect(function()
		if not selectedTarget then toast("Select a player!", false); return end
		local val = tonumber(box.Text)
		if not val or val < 1 or val > 125 then toast("Invalid number (1–125)", false); return end
		adminEvent:FireServer("tpcheckpoint", selectedTarget, math.floor(val))
		toast("📍 " .. selectedTarget .. " → CP" .. math.floor(val), true)
	end)
end

-- ========================================
-- ÉCRAN : PROFILE
-- ========================================
local function fmtNum(n)
	if not n or type(n) ~= "number" then return "0" end
	if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
	if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
	if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function fmtTime(s)
	if not s or s <= 0 then return "0min" end
	local d = math.floor(s / 86400); local h = math.floor((s % 86400) / 3600); local m = math.floor((s % 3600) / 60)
	if d > 0 then return string.format("%dd %dh %dmin", d, h, m) end
	if h > 0 then return string.format("%dh %dmin", h, m) end
	return string.format("%dmin", m)
end
local function fmtAgo(ts)
	if not ts or ts <= 0 then return "Unknown" end
	local a = os.time() - ts
	if a < 60 then return a .. "s ago" end
	if a < 3600 then return math.floor(a / 60) .. "min ago" end
	if a < 86400 then return math.floor(a / 3600) .. "h ago" end
	return string.format("%.1fd ago", a / 86400)
end

-- 🎽 Libellés des voies d'acquisition UGC
-- ⚠️ Déclarés ICI (avant renderProfile) : sinon la carte UGC du profil
--    ne les voit pas et affiche les codes bruts.
local SRC_LABEL = {
	shop = "🛒 Shop", late = "⏱️ Late", timeout = "⌛ Timeout",
	quit = "🚪 Quit", bugfix = "🩹 Bugfix", admin = "🛠️ Admin", free = "🎁 Free",
	exploit = "🚨 EXPLOIT", external = "🌐 External",
}
local SRC_GROUP = {
	shop = "paid", late = "paid", timeout = "paid", quit = "paid", bugfix = "paid",
	free = "free", admin = "free",
	exploit = "flag", external = "flag",
}

local function statCard(parent, order, title, titleColor)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = C.BG_DARK
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	card.ZIndex = 12
	card.Parent = parent
	corner(card, 10); stroke(card, titleColor, 1)
	label(card, {
		text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
		position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
		color = titleColor, textSize = IS_MOBILE and 11 or 14, zIndex = 13,
	})
	local rows = Instance.new("Frame")
	rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
	rows.Size = UDim2.new(1, 0, 0, 0)
	rows.AutomaticSize = Enum.AutomaticSize.Y
	rows.BackgroundTransparency = 1
	rows.ZIndex = 13
	rows.Parent = card
	local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 2); l.Parent = rows
	local rp = Instance.new("UIPadding")
	rp.PaddingBottom = UDim.new(0, 8); rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
	rp.Parent = rows
	return card, rows
end

local function statRow(parent, order, key, val, valColor)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.ZIndex = 13
	row.Parent = parent
	label(row, { text = key, size = UDim2.new(0.5, 0, 1, 0), xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, zIndex = 14 })
	label(row, { text = tostring(val), size = UDim2.new(0.5, 0, 1, 0), position = UDim2.new(0.5, 0, 0, 0), xAlign = Enum.TextXAlignment.Right, color = valColor or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13, zIndex = 14, truncate = true })
end

local screenProfile  -- forward decl

-- 🆔 Ligne UserID sélectionnable + bouton Copier
-- (Roblox n'a pas d'API presse-papier pour les scripts de jeu : on rend le champ
--  sélectionnable et on le pré-sélectionne → Ctrl+C sur PC, appui long sur mobile)
local function idCopyRow(parent, order, userId)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
	row.BackgroundColor3 = C.BG_DARK
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.ZIndex = 12
	row.Parent = parent
	corner(row, 8); stroke(row, C.BORDER_SUBTLE, 1)

	local lblW = IS_MOBILE and 30 or 38
	label(row, {
		text = "🆔", size = UDim2.new(0, lblW, 1, 0), position = UDim2.new(0, 6, 0, 0),
		color = C.TEXT_GREY, textSize = IS_MOBILE and 13 or 16, zIndex = 13,
	})

	local copyW = IS_MOBILE and 60 or 84
	local boxX = 6 + lblW
	local box = Instance.new("TextBox")
	box.Position = UDim2.new(0, boxX, 0, 0)
	box.Size = UDim2.new(1, -boxX - copyW - 10, 1, 0)
	box.BackgroundTransparency = 1
	box.Font = FONT
	box.Text = tostring(userId)
	box.TextColor3 = C.TEXT_WHITE
	box.TextSize = IS_MOBILE and 13 or 16
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false
	box.TextEditable = true          -- nécessaire pour permettre la sélection/copie
	box.ZIndex = 13
	box.Parent = row
	-- si le joueur modifie par accident, on restaure l'ID exact
	box.FocusLost:Connect(function() box.Text = tostring(userId) end)

	local cC = Instance.new("Frame")
	cC.AnchorPoint = Vector2.new(1, 0.5)
	cC.Position = UDim2.new(1, -6, 0.5, 0)
	cC.Size = UDim2.new(0, copyW, 0, IS_MOBILE and 26 or 32)
	cC.BackgroundTransparency = 1
	cC.ZIndex = 13
	cC.Parent = row
	local cb = actionButton(cC, {
		color = C.TURQUOISE_DARK, strokeColor = C.TURQUOISE,
		text = IS_MOBILE and "⧉" or "⧉ Copy", textSize = IS_MOBILE and 13 or 13, radius = 7, zIndex = 13,
	})
	cb.MouseButton1Click:Connect(function()
		box.Text = tostring(userId)
		box:CaptureFocus()
		box.CursorPosition = #box.Text + 1
		box.SelectionStart = 1        -- pré-sélectionne tout l'ID
		toast("ID selected — Ctrl+C (PC) / long-press → Copy (mobile)", true)
	end)
	return row
end

local function renderProfile(body, profile)
	-- vider (garde layout)
	for _, c in ipairs(body:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
	end

	if profile.error then
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundColor3 = C.BG_DARK; f.BorderSizePixel = 0
		f.LayoutOrder = 1; f.ZIndex = 12; f.Parent = body
		corner(f, 10); stroke(f, C.RED, 1)
		label(f, { text = "❌ " .. profile.error, size = UDim2.fromScale(1, 1), color = C.RED, textSize = IS_MOBILE and 12 or 15, wrapped = true, zIndex = 13 })
		return
	end

	-- HEADER CARD : avatar + display name + @username + badges
	local hc = Instance.new("Frame")
	hc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 92 or 118)
	hc.BackgroundColor3 = C.BG_DARK
	hc.BorderSizePixel = 0
	hc.LayoutOrder = 1
	hc.ZIndex = 12
	hc.Parent = body
	corner(hc, 10); stroke(hc, C.PURPLE, 1)
	gradient(hc, C.BG_DARK, C.BG_ITEM)

	local avSize = IS_MOBILE and 66 or 96
	local av = makeAvatar(hc, profile.userId, avSize, C.PURPLE)
	av.AnchorPoint = Vector2.new(0, 0.5)
	av.Position = UDim2.new(0, 10, 0.5, 0)

	local ix = 10 + avSize + 12
	label(hc, {
		text = profile.displayName or profile.name,
		size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 22 or 28),
		position = UDim2.new(0, ix, 0, IS_MOBILE and 10 or 14),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE, textSize = IS_MOBILE and 15 or 20, truncate = true, zIndex = 13,
	})
	label(hc, {
		text = "@" .. (profile.username or profile.name),
		size = UDim2.new(1, -ix - 12, 0, 14),
		position = UDim2.new(0, ix, 0, IS_MOBILE and 32 or 42),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13,
	})
	label(hc, {
		text = "ID: " .. profile.userId,
		size = UDim2.new(1, -ix - 12, 0, 12),
		position = UDim2.new(0, ix, 0, IS_MOBILE and 46 or 60),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 12, zIndex = 13,
	})
	-- badges statut
	local badgeY = IS_MOBILE and 62 or 80
	local st = Instance.new("TextLabel")
	st.Size = UDim2.new(0, IS_MOBILE and 62 or 82, 0, IS_MOBILE and 18 or 22)
	st.Position = UDim2.new(0, ix, 0, badgeY)
	st.BackgroundColor3 = profile.isOnline and C.GREEN or C.BG_LIGHT
	st.BorderSizePixel = 0; st.Font = FONT
	st.Text = profile.isOnline and "● ONLINE" or "● OFFLINE"
	st.TextColor3 = C.TEXT_WHITE; st.TextSize = IS_MOBILE and 9 or 11; st.ZIndex = 13; st.Parent = hc
	corner(st, 5)
	if profile.banned then
		local bn = Instance.new("TextLabel")
		bn.Size = UDim2.new(0, IS_MOBILE and 62 or 82, 0, IS_MOBILE and 18 or 22)
		bn.Position = UDim2.new(0, ix + (IS_MOBILE and 68 or 90), 0, badgeY)
		bn.BackgroundColor3 = C.RED; bn.BorderSizePixel = 0; bn.Font = FONT
		bn.Text = "🚫 BANNED"; bn.TextColor3 = C.TEXT_WHITE; bn.TextSize = IS_MOBILE and 9 or 11; bn.ZIndex = 13; bn.Parent = hc
		corner(bn, 5)
	end

	-- 🆔 UserID copiable (juste sous la carte d'en-tête)
	idCopyRow(body, 1, profile.userId)

	-- STATS
	local _, statsRows = statCard(body, 2, "📊 STATS", Color3.fromRGB(100, 180, 255))
	statRow(statsRows, 1, "Points", fmtNum(profile.points), Color3.fromRGB(255, 215, 70))
	statRow(statsRows, 2, "🔄 Rebirths", tostring(profile.rebirths), Color3.fromRGB(255, 180, 80))
	statRow(statsRows, 3, "⚔️ Total Kills", fmtNum(profile.totalKills), Color3.fromRGB(255, 100, 100))
	statRow(statsRows, 4, "📍 Checkpoints", (profile.checkpointProgress or 0) .. "/90", Color3.fromRGB(120, 220, 120))
	statRow(statsRows, 5, "⏱️ Playtime", fmtTime(profile.playtimeSeconds), C.TEXT_WHITE)
	statRow(statsRows, 6, "🔥 Streak", tostring(profile.flameStreak or 0) .. " d", Color3.fromRGB(255, 140, 50))
	statRow(statsRows, 7, "🏆 Best streak", tostring(profile.flameHighScore or 0) .. " d", Color3.fromRGB(255, 200, 80))

	-- ACCOUNT
	local _, accRows = statCard(body, 3, "📅 ACCOUNT", Color3.fromRGB(255, 180, 100))
	statRow(accRows, 1, "First join", profile.daysSinceFirstJoin and string.format("%.1f days", profile.daysSinceFirstJoin) or "Unknown", Color3.fromRGB(255, 200, 100))
	if profile.firstJoin then statRow(accRows, 2, "Date", fmtAgo(profile.firstJoin), C.TEXT_GREY) end
	if profile.lastSavedAt then statRow(accRows, 3, "Last save", fmtAgo(profile.lastSavedAt), C.TEXT_GREY) end

	-- ECONOMY
	local _, ecoRows = statCard(body, 4, "💰 ECONOMY", Color3.fromRGB(255, 200, 50))
	statRow(ecoRows, 1, "🛒 UGC Spent", fmtNum(profile.spent), Color3.fromRGB(255, 150, 100))
	statRow(ecoRows, 2, "💳 DevProduct $", "+" .. fmtNum(profile.devProductBonus), Color3.fromRGB(100, 255, 150))
	statRow(ecoRows, 3, "📦 Box Gains", "+" .. fmtNum(profile.boxGains), Color3.fromRGB(180, 220, 100))
	statRow(ecoRows, 4, "🎟️ Codes redeemed", tostring(profile.redeemedCodesCount), C.TEXT_WHITE)

	-- MODERATION
	local modClean = (profile.warnings == 0 and profile.smartAntiCheatTotal == 0)
	local _, modRows = statCard(body, 5, "⚠️ MODERATION", modClean and C.GREEN or Color3.fromRGB(255, 100, 80))
	statRow(modRows, 1, "AntiExploit warnings", tostring(profile.warnings), profile.warnings > 0 and C.ORANGE or C.GREEN)
	statRow(modRows, 2, "SmartAntiCheat", tostring(profile.smartAntiCheatTotal), profile.smartAntiCheatTotal > 0 and C.ORANGE or C.GREEN)
	if profile.banned then
		statRow(modRows, 3, "Ban reason", tostring(profile.banReason or "?"), C.RED)
		if profile.banTimestamp then statRow(modRows, 4, "Ban date", fmtAgo(profile.banTimestamp), C.TEXT_GREY) end
	end

	-- ✅ ANTI-FLY / ANTI-TP (logs)
	local flyClean = (profile.flyTpWarnings or 0) == 0
	local flyCard, flyRows = statCard(body, 6, "🛡️ ANTI-FLY / ANTI-TP", flyClean and C.GREEN or C.RED)
	statRow(flyRows, 1, "Warnings", tostring(profile.flyTpWarnings or 0) .. " / 5", flyClean and C.GREEN or C.RED)
	if profile.flyTpLastAt then
		statRow(flyRows, 2, "Last warning", fmtAgo(profile.flyTpLastAt), C.TEXT_GREY)
	end
	-- historique détaillé (du plus récent au plus ancien)
	local hist = profile.flyTpHistory or {}
	if #hist > 0 then
		statRow(flyRows, 3, "── Recent detections ──", "", C.TEXT_DIM)
		local shown = 0
		for i = #hist, 1, -1 do
			local e = hist[i]
			shown = shown + 1
			if shown > 6 then break end
			local when = e.t and fmtAgo(e.t) or "?"
			-- clé = type, valeur = quand ; détails en petit dessous
			statRow(flyRows, 10 + shown * 2, tostring(e.type), when, C.ORANGE)
			if e.details and e.details ~= "" then
				local d = Instance.new("Frame")
				d.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
				d.BackgroundTransparency = 1
				d.LayoutOrder = 11 + shown * 2
				d.ZIndex = 13
				d.Parent = flyRows
				label(d, { text = "   " .. e.details, size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
			end
		end
	else
		statRow(flyRows, 3, "No fly/tp detections", "clean ✅", C.GREEN)
	end

	-- 🧪 SHADOW / TEST (fly / tp / speed) — agrégats + récent (mode test)
	do
		local rowsColor = Color3.fromRGB(120, 220, 255)
		local _, tRows = statCard(body, 7, "🧪 SHADOW / TEST — FLY / TP / SPEED", rowsColor)
		statRow(tRows, 1, "Test mode", profile.flyTpTestMode and "🟢 ON (shadow)" or "⚪ OFF", profile.flyTpTestMode and C.GREEN or C.TEXT_DIM)
		statRow(tRows, 2, "Detections", tostring(profile.tTotal or 0), (profile.tTotal or 0) > 0 and C.ORANGE or C.TEXT_GREY)
		statRow(tRows, 3, "Would-warn", tostring(profile.tSimWarnings or 0), (profile.tSimWarnings or 0) > 0 and C.ORANGE or C.TEXT_WHITE)
		statRow(tRows, 4, "Would-kick", tostring(profile.tWouldKick or 0), (profile.tWouldKick or 0) > 0 and C.ORANGE or C.TEXT_WHITE)
		statRow(tRows, 5, "Would-ban",
			profile.tWouldBan and ("🚫 YES" .. (profile.tWouldBanAt and (" (" .. fmtAgo(profile.tWouldBanAt) .. ")") or "")) or "no",
			profile.tWouldBan and C.RED or C.GREEN)

		-- détections par type
		local bt = profile.tByType or {}
		local hasType = false
		local order = 10
		for typeName, cnt in pairs(bt) do
			hasType = true
			order = order + 1
			statRow(tRows, order, "  " .. typeName, tostring(cnt), C.TEXT_GREY)
		end

		-- événements récents (serveur courant, live)
		local rec = profile.tRecent or {}
		if #rec > 0 then
			statRow(tRows, 50, "── Recent (this server) ──", "", C.TEXT_DIM)
			local n = 0
			for _, e in ipairs(rec) do
				n = n + 1
				if n > 20 then break end
				local lbl = (e.kind == "warning")
					and ("WOULD-" .. string.upper(tostring(e.action or "?")) .. " W" .. tostring(e.count or "?"))
					or tostring(e.vType)
				statRow(tRows, 60 + n * 2, lbl, (e.t and fmtAgo(e.t)) or "?", e.kind == "warning" and C.RED or C.ORANGE)
				if e.details and e.details ~= "" then
					local d = Instance.new("Frame")
					d.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
					d.BackgroundTransparency = 1
					d.LayoutOrder = 61 + n * 2
					d.ZIndex = 13
					d.Parent = tRows
					label(d, { text = "   " .. e.details, size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
				end
			end
		elseif not profile.flyTpTestMode then
			statRow(tRows, 6, "Enable test mode to record", "everything", C.TEXT_DIM)
		elseif (profile.tTotal or 0) == 0 then
			statRow(tRows, 6, "No detections yet", "clean ✅", C.GREEN)
		end
	end

	-- ⚠️ VIOLATIONS DÉTAIL (AntiExploit + SmartAntiCheat)
	do
		local _, vRows = statCard(body, 8, "⚠️ VIOLATIONS DÉTAIL", Color3.fromRGB(255, 140, 90))
		statRow(vRows, 1, "Suspicious", tostring(profile.smartSuspicious or 0), C.TEXT_WHITE)
		statRow(vRows, 2, "Dangerous", tostring(profile.smartDangerous or 0), (profile.smartDangerous or 0) > 0 and C.ORANGE or C.TEXT_WHITE)
		statRow(vRows, 3, "Burst", tostring(profile.smartBurst or 0), C.TEXT_WHITE)
		if profile.smartLastInfractionAt then statRow(vRows, 4, "Last infraction", fmtAgo(profile.smartLastInfractionAt), C.TEXT_GREY) end
		if profile.aeLastViolationType then
			statRow(vRows, 5, "Last AE violation", tostring(profile.aeLastViolationType), C.ORANGE)
			if profile.aeLastViolationDetails and profile.aeLastViolationDetails ~= "" then
				local d = Instance.new("Frame")
				d.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16); d.BackgroundTransparency = 1
				d.LayoutOrder = 6; d.ZIndex = 13; d.Parent = vRows
				label(d, { text = "   " .. profile.aeLastViolationDetails, size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
			end
		end
		local ah = profile.aeHistory or {}
		if #ah > 0 then
			statRow(vRows, 7, "── AntiExploit history ──", "", C.TEXT_DIM)
			local n = 0
			for i = #ah, 1, -1 do
				local e = ah[i]; n = n + 1; if n > 12 then break end
				local key = tostring(e.type) .. ((e.details and e.details ~= "") and (" · " .. e.details) or "")
				statRow(vRows, 20 + n, key, (e.t and fmtAgo(e.t)) or "?", C.TEXT_GREY)
			end
		end
	end

	-- ⏳ COOLDOWNS & QUESTS
	do
		local _, cRows = statCard(body, 9, "⏳ COOLDOWNS & QUESTS", Color3.fromRGB(120, 200, 160))
		local now = os.time()
		local function cdText(endT)
			endT = tonumber(endT) or 0
			if endT <= now then return "ready ✅" end
			return fmtTime(endT - now) .. " left"
		end
		statRow(cRows, 1, "Kill cooldown (100)", cdText(profile.killCooldownEnd), C.TEXT_WHITE)
		statRow(cRows, 2, "Kill quest", (profile.killQuestProgress or 0) .. "/30", C.TEXT_WHITE)
		statRow(cRows, 3, "Kill quest CD", cdText(profile.killQuestCooldownEnd), C.TEXT_GREY)
		statRow(cRows, 4, "Checkpoint quest CD", cdText(profile.checkpointCooldownEnd), C.TEXT_GREY)
		statRow(cRows, 5, "PointLevels earned", tostring(profile.earnedPointLevelsCount or 0), C.TEXT_WHITE)
	end

	-- 🎽 UGC RÉCUPÉRÉS
	do
		local n = profile.ugcCount or 0
		local _, uRows = statCard(body, 10, "🎽 UGC REDEEMED", n > 0 and Color3.fromRGB(255, 150, 220) or C.TEXT_DIM)
		statRow(uRows, 1, "Total items", tostring(n), n > 0 and Color3.fromRGB(255, 170, 230) or C.TEXT_GREY)
		statRow(uRows, 2, "💎 Points spent", fmtNum(profile.ugcSpent or 0), Color3.fromRGB(120, 220, 255))
		statRow(uRows, 3, "🎁 Free items", tostring(profile.ugcFree or 0), (profile.ugcFree or 0) > 0 and C.GREEN or C.TEXT_GREY)
		if profile.ugcLastAt then
			statRow(uRows, 4, "Last redeem", fmtAgo(profile.ugcLastAt), C.TEXT_GREY)
		end

		local items = profile.ugcItems or {}
		if #items > 0 then
			statRow(uRows, 5, "── History (newest first) ──", "", C.TEXT_DIM)
			for i, it in ipairs(items) do
				local line = Instance.new("Frame")
				line.Size = UDim2.new(1, 0, 0, IS_MOBILE and 26 or 32)
				line.BackgroundTransparency = 1
				line.LayoutOrder = 10 + i
				line.ZIndex = 13
				line.Parent = uRows

				local s = IS_MOBILE and 22 or 28
				local im = Instance.new("ImageLabel")
				im.Size = UDim2.new(0, s, 0, s)
				im.Position = UDim2.new(0, 0, 0.5, 0)
				im.AnchorPoint = Vector2.new(0, 0.5)
				im.BackgroundColor3 = C.BG_ITEM
				im.BorderSizePixel = 0
				im.Image = (function(v) v = tostring(v); return v:find("://") and v or ("rbxassetid://" .. v) end)(it.ai or it.a)
				im.ScaleType = Enum.ScaleType.Fit
				im.ZIndex = 14
				im.Parent = line
				corner(im, 5)

				label(line, { text = tostring(it.an or "?"),
					size = UDim2.new(0.52, -(s + 6), 1, 0), position = UDim2.new(0, s + 6, 0, 0),
					xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
					textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 14 })

				local right = (it.f and "🎁 FREE" or ("💎 " .. fmtNum(it.p or 0)))
					.. "  ·  " .. ((SRC_LABEL and SRC_LABEL[tostring(it.s)]) or tostring(it.s))
					.. "  ·  " .. fmtAgo(it.t)
				label(line, { text = right,
					size = UDim2.new(0.48, 0, 1, 0), position = UDim2.new(0.52, 0, 0, 0),
					xAlign = Enum.TextXAlignment.Right,
					color = it.f and C.GREEN or C.TEXT_GREY,
					textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 14 })
			end
		elseif n == 0 then
			statRow(uRows, 5, "No UGC redeemed", "—", C.TEXT_DIM)
		end
	end

	do
		local es = profile.escrow
		local bad = es and ((es.debt or 0) > 0 or (es.susp or 0) > 0 or es.open ~= nil)
		local _, eRows = statCard(body, 11, "🔐 UGC ESCROW", bad and C.RED or C.GREEN)
		if not es then
			statRow(eRows, 1, "Module escrow", "non chargé", C.TEXT_DIM)
		else
			if es.unsafe then
				statRow(eRows, 0, "⚠️ FICHE VERROUILLÉE", "lecture DataStore KO", C.RED)
			end
			if es.open then
				statRow(eRows, 1, "⚠️ Créance OUVERTE", "asset " .. tostring(es.open.a), C.RED)
				statRow(eRows, 2, "   montant gelé", fmtNum(es.open.p or 0) .. " pts", C.ORANGE)
				statRow(eRows, 3, "   état", tostring(es.open.st or "open"), C.ORANGE)
				statRow(eRows, 4, "   depuis", fmtAgo(es.open.t), C.TEXT_GREY)
			else
				statRow(eRows, 1, "Créance ouverte", "aucune ✅", C.GREEN)
			end
			statRow(eRows, 5, "🔴 Dette", fmtNum(es.debt or 0) .. " pts  (x" .. tostring(es.debtCount or 0) .. ")",
				(es.debt or 0) > 0 and C.RED or C.GREEN)
			statRow(eRows, 6, "🚨 Suspicion", tostring(es.susp or 0) .. " / 10",
				(es.susp or 0) > 0 and C.ORANGE or C.GREEN)
			statRow(eRows, 7, "🎽 UGC validées", tostring(es.redeemedCount or 0), C.TEXT_WHITE)
			statRow(eRows, 8, "🌐 Possédées hors shop", tostring(es.extOwnedCount or 0),
				(es.extOwnedCount or 0) > 0 and C.ORANGE or C.TEXT_GREY)
			local s = es.st or {}
			statRow(eRows, 9,  "── Compteurs ──", "", C.TEXT_DIM)
			statRow(eRows, 10, "  Achats ouverts",  tostring(s.opened or 0), C.TEXT_GREY)
			statRow(eRows, 11, "  Confirmés",       tostring(s.confirmed or 0), C.GREEN)
			statRow(eRows, 12, "  Remboursés",      tostring(s.refunded or 0), C.TEXT_WHITE)
			statRow(eRows, 13, "  Quits en achat",  tostring(s.quits or 0),
				(s.quits or 0) > 2 and C.RED or C.TEXT_GREY)
			statRow(eRows, 14, "  Re-déductions",   tostring(s.reDeducted or 0),
				(s.reDeducted or 0) > 0 and C.ORANGE or C.TEXT_GREY)
			statRow(eRows, 15, "  Achats bloqués",  tostring(s.blocked or 0), C.TEXT_GREY)
			if (es.lastAuditAt or 0) > 0 then
				statRow(eRows, 16, "Dernier audit", fmtAgo(es.lastAuditAt), C.TEXT_GREY)
			end
		end
	end


	-- LIVE (online)
	if profile.isOnline then
		local _, liveRows = statCard(body, 20, "🟢 LIVE DATA", C.GREEN)
		if profile.currentMultiplier then statRow(liveRows, 1, "Multiplier", string.format("x%.2f", profile.currentMultiplier), Color3.fromRGB(100, 220, 100)) end
		if profile.friendCount then statRow(liveRows, 2, "Friends", tostring(profile.friendCount), C.TEXT_WHITE) end
		statRow(liveRows, 3, "Rebirth right", profile.rebirthRight and "✅" or "❌", profile.rebirthRight and C.GREEN or C.TEXT_DIM)
	end

	-- ACTIONS RAPIDES
	local actWrap = Instance.new("Frame")
	actWrap.Size = UDim2.new(1, 0, 0, 0)
	actWrap.AutomaticSize = Enum.AutomaticSize.Y
	actWrap.BackgroundTransparency = 1
	actWrap.LayoutOrder = 21
	actWrap.ZIndex = 12
	actWrap.Parent = body
	local ag = Instance.new("UIGridLayout")
	ag.CellSize = UDim2.new(0.5, -4, 0, IS_MOBILE and 38 or 44)
	ag.CellPadding = UDim2.new(0, 8, 0, 8)
	ag.SortOrder = Enum.SortOrder.LayoutOrder
	ag.Parent = actWrap

	local function quickBtn(order, text, col, colDark, fn)
		local c = Instance.new("Frame")
		c.LayoutOrder = order; c.BackgroundTransparency = 1; c.ZIndex = 12; c.Parent = actWrap
		local b = actionButton(c, { color = col, strokeColor = colDark, text = text, textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })
		b.MouseButton1Click:Connect(fn)
	end
	local uname = profile.username or profile.name
	if profile.banned then
		quickBtn(1, "✅ UNBAN", C.GREEN, C.GREEN_DARK, function() adminEvent:FireServer("unban", uname); toast("Unbanned " .. uname, true) end)
	else
		quickBtn(1, "🔨 BAN", C.RED, C.RED_DARK, function() adminEvent:FireServer("ban", uname); toast("Banned " .. uname, true) end)
	end
	if profile.isOnline then
		quickBtn(2, "👟 KICK", C.ORANGE, C.ORANGE_DARK, function() adminEvent:FireServer("kick", uname); toast("Kicked " .. uname, true) end)
	end
	quickBtn(3, "🛡️ Clear Fly/TP", C.TURQUOISE_DARK, C.TURQUOISE, function() adminEvent:FireServer("clearflywarn", uname); toast("Cleared fly/tp warnings", true) end)
	quickBtn(4, "⚠️ Clear warns", C.PURPLE, C.PURPLE_DARK, function() adminEvent:FireServer("resetwarnings", uname); toast("Cleared warnings", true) end)
	quickBtn(5, profile.flyTpTestMode and "🧪 Test mode: ON" or "🧪 Test mode: OFF",
		profile.flyTpTestMode and C.GREEN or C.BG_LIGHT, profile.flyTpTestMode and C.GREEN_DARK or C.BORDER_BRIGHT,
		function() adminEvent:FireServer("toggletestlog"); toast("Toggled global test mode — refresh 🔄", true) end)
	quickBtn(6, "🧹 Clear test log", Color3.fromRGB(90, 90, 110), C.BORDER_BRIGHT,
		function() adminEvent:FireServer("clearflytestlog", uname); toast("Cleared test log", true) end)
end

-- Ouvre directement le détail d'un profil (back personnalisable)
local function openProfileDetail(name, backFn)
	local body = buildScreen("👤 PROFILE", true, C.PURPLE, backFn, function() openProfileDetail(name, backFn) end)
	local loadF = Instance.new("Frame")
	loadF.Size = UDim2.new(1, 0, 0, 80)
	loadF.BackgroundColor3 = C.BG_DARK
	loadF.BorderSizePixel = 0
	loadF.LayoutOrder = 1
	loadF.ZIndex = 12
	loadF.Parent = body
	corner(loadF, 10)
	label(loadF, { text = "⏳ Loading " .. tostring(name) .. "...", size = UDim2.fromScale(1, 1), color = C.TEXT_WHITE, textSize = IS_MOBILE and 12 or 15, wrapped = true, zIndex = 13 })
	task.spawn(function()
		local ok, profile = pcall(function() return getProfileEvent:InvokeServer(name) end)
		if not body.Parent then return end
		renderProfile(body, (ok and profile) or { error = "Failed to fetch profile" })
	end)
end

screenProfile = function()
	currentScreen = "profile"
	local body = buildScreen("👤 PLAYER PROFILE", true, C.PURPLE, nil, screenProfile)

	-- search
	local searchWrap = Instance.new("Frame")
	searchWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 48)
	searchWrap.BackgroundTransparency = 1
	searchWrap.LayoutOrder = 0
	searchWrap.ZIndex = 11
	searchWrap.Parent = body
	local btnW = IS_MOBILE and 54 or 78
	local box = Instance.new("TextBox")
	box.AnchorPoint = Vector2.new(0, 0.5); box.Position = UDim2.new(0, 0, 0.5, 0)
	box.Size = UDim2.new(1, -btnW - 8, 1, 0); box.BackgroundColor3 = C.BG_DARK
	box.BorderSizePixel = 0; box.Font = FONT; box.PlaceholderText = "Name or UserID..."
	box.PlaceholderColor3 = C.TEXT_DIM; box.Text = ""; box.TextColor3 = C.TEXT_WHITE
	box.TextSize = IS_MOBILE and 12 or 15; box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false; box.ZIndex = 12; box.Parent = searchWrap
	corner(box, 9); stroke(box, C.BORDER_SUBTLE, 1)
	local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box
	local goC = Instance.new("Frame")
	goC.AnchorPoint = Vector2.new(1, 0.5); goC.Position = UDim2.new(1, 0, 0.5, 0)
	goC.Size = UDim2.new(0, btnW, 1, 0); goC.BackgroundTransparency = 1; goC.ZIndex = 12; goC.Parent = searchWrap
	local goBtn = actionButton(goC, { color = C.PURPLE, strokeColor = C.PURPLE_DARK, text = "🔍", textSize = IS_MOBILE and 14 or 17, radius = 9, zIndex = 12 })

	sectionLabel(body, 1, "ONLINE PLAYERS (tap to view)")
	local listHolder = Instance.new("Frame")
	listHolder.Size = UDim2.new(1, 0, 0, 0)
	listHolder.AutomaticSize = Enum.AutomaticSize.Y
	listHolder.BackgroundTransparency = 1
	listHolder.LayoutOrder = 2
	listHolder.ZIndex = 11
	listHolder.Parent = body
	local lh = Instance.new("UIListLayout"); lh.Padding = UDim.new(0, IS_MOBILE and 6 or 9); lh.Parent = listHolder

	local function showProfile(name)
		if not name or name == "" then toast("Enter a name", false); return end
		openProfileDetail(name, screenProfile)
	end

	goBtn.MouseButton1Click:Connect(function() showProfile(box.Text) end)
	box.FocusLost:Connect(function(enter) if enter then showProfile(box.Text) end end)

	task.spawn(function()
		local list = fetchOnlinePlayers()
		if not listHolder.Parent then return end
		for i, info in ipairs(list) do
			playerRow(listHolder, info, {
				order = i, accent = C.PURPLE,
				onClick = function(inf) showProfile(inf.username) end,
			})
		end
	end)
end

-- ========================================
-- ÉCRAN : SPECTATE (barre flottante, corrigé respawn)
-- ========================================
local spectateBar = Instance.new("Frame")
spectateBar.AnchorPoint = Vector2.new(0.5, 0)
spectateBar.Position = UDim2.new(0.5, 0, 0, IS_MOBILE and 8 or 16)
spectateBar.Size = UDim2.new(0, IS_MOBILE and 280 or 360, 0, IS_MOBILE and 52 or 64)
spectateBar.BackgroundColor3 = C.BG_DARK
spectateBar.BorderSizePixel = 0
spectateBar.Visible = false
spectateBar.ZIndex = 30
spectateBar.Parent = gui
corner(spectateBar, 12)
stroke(spectateBar, C.TURQUOISE, 1.5)

local specAvatar = Instance.new("ImageLabel")
specAvatar.AnchorPoint = Vector2.new(0, 0.5)
specAvatar.Position = UDim2.new(0, 8, 0.5, 0)
specAvatar.Size = UDim2.new(0, IS_MOBILE and 38 or 46, 0, IS_MOBILE and 38 or 46)
specAvatar.BackgroundColor3 = C.BG_LIGHT
specAvatar.BorderSizePixel = 0
specAvatar.ZIndex = 31
specAvatar.Parent = spectateBar
corner(specAvatar, (IS_MOBILE and 38 or 46) / 2)
stroke(specAvatar, C.TURQUOISE, 2)

local specName = label(spectateBar, {
	text = "", size = UDim2.new(1, -(IS_MOBILE and 190 or 230), 1, 0),
	position = UDim2.new(0, IS_MOBILE and 52 or 62, 0, 0), xAlign = Enum.TextXAlignment.Left,
	color = C.TEXT_WHITE, textSize = IS_MOBILE and 12 or 15, zIndex = 31, truncate = true, richText = true,
})

local spectating = false
local spectateIndex = 1
local spectateTarget = nil
local spectateConn = nil

local function getOthers()
	local t = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then table.insert(t, p) end
	end
	return t
end

-- 🎥 CAMÉRA DE SPECTATE — pilotée MANUELLEMENT.
--   Pourquoi : régler CameraSubject ne suffit pas si ton jeu a une caméra
--   personnalisée (fréquent en simulateur/rebirth) qui la réécrit chaque frame →
--   tu te revois. Ici on met la caméra en Scriptable et on calcule sa position
--   nous-mêmes, via BindToRenderStep à une priorité APRÈS la caméra du jeu, donc
--   on gagne toujours. Suit le respawn (on relit le Character à chaque frame).
local SPEC_BIND   = "AdminSpectateCam"
local specYaw     = 0
local specPitch   = math.rad(-15)
local specDist    = 14
local specDragging = false
local specInputConns = {}
local specBound   = false
local specTouches = {}      -- [inputObject] = Vector2  (suivi multi-touch pour le pinch)
local specPinchDist = nil   -- dernière distance entre 2 doigts
local specLastMouse = nil   -- dernière position curseur (delta calculé à la main)
local specServerPos = nil   -- position de la cible fournie par le serveur (fallback streaming)

local function spectateApply()
	local target = spectateTarget
	if not target or not target.Parent then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	-- Position cible : le perso local (précis/fluide) si chargé, sinon la position
	-- serveur (cas d'un joueur lointain "streamé out"). On NE retombe JAMAIS sur
	-- soi-même → on prend la caméra en main dès le début.
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	local basePos
	local char = target.Character
	local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
	if hrp then
		basePos = hrp.Position
	elseif specServerPos then
		basePos = specServerPos
	else
		return  -- pas encore de position connue → on garde la dernière CFrame (figée), pas soi
	end
	local focus  = basePos + Vector3.new(0, 2, 0)
	local rot    = CFrame.Angles(0, specYaw, 0) * CFrame.Angles(specPitch, 0, 0)
	local camPos = focus + rot * Vector3.new(0, 0, specDist)
	cam.CFrame = CFrame.lookAt(camPos, focus)
	cam.Focus  = CFrame.new(focus)
end

-- Rotation par glisser (souris gauche/droite OU doigt), zoom molette + pinch.
--   Les connexions ne vivent que pendant le spectate. `gpe` (gameProcessedEvent)
--   à true = l'input a touché l'UI → on ignore, pour ne pas tourner en cliquant
--   les boutons de la barre.
local function specTouchCount()
	local n = 0
	for _ in pairs(specTouches) do n = n + 1 end
	return n
end
local function bindSpectateInput()
	table.insert(specInputConns, UserInputService.InputBegan:Connect(function(input, gpe)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2) and not gpe then
			specDragging = true
			specLastMouse = nil  -- 1er MouseMovement fixe la base (même repère que input.Position)
		elseif t == Enum.UserInputType.Touch and not gpe then
			specTouches[input] = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
	table.insert(specInputConns, UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			specDragging = false
			specLastMouse = nil
		elseif t == Enum.UserInputType.Touch then
			specTouches[input] = nil
			if specTouchCount() < 2 then specPinchDist = nil end
		end
	end))
	table.insert(specInputConns, UserInputService.InputChanged:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement and specDragging then
			-- ⚠️ input.Delta = (0,0) quand le curseur est libre (caméra Scriptable) →
			--    on calcule le delta nous-mêmes à partir de la position écran.
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			if specLastMouse then
				local d = pos - specLastMouse
				specYaw   = specYaw - d.X * 0.006
				specPitch = math.clamp(specPitch - d.Y * 0.006, -1.4, 1.4)
			end
			specLastMouse = pos
		elseif t == Enum.UserInputType.MouseWheel then
			specDist = math.clamp(specDist - input.Position.Z * 3, 4, 80)
		elseif t == Enum.UserInputType.Touch then
			if specTouches[input] then
				specTouches[input] = Vector2.new(input.Position.X, input.Position.Y)
			end
			if specTouchCount() >= 2 then
				-- 🤏 pinch → zoom
				local pts = {}
				for _, p in pairs(specTouches) do pts[#pts + 1] = p end
				local d = (pts[1] - pts[2]).Magnitude
				if specPinchDist then
					specDist = math.clamp(specDist - (d - specPinchDist) * 0.06, 4, 80)
				end
				specPinchDist = d
			else
				-- 👆 un doigt → rotation
				specYaw   = specYaw - input.Delta.X * 0.012
				specPitch = math.clamp(specPitch - input.Delta.Y * 0.012, -1.4, 1.4)
			end
		end
	end))
end

local stopSpectate  -- fwd

-- 🌍 STREAMING : si ton jeu a StreamingEnabled, le client ne charge que la zone
--   autour de TON perso → un joueur lointain apparaît "dans le vide". On demande
--   au serveur de streamer la zone autour de la cible (API officielle, pas besoin
--   de téléporter ton perso). Appelé à chaque changement + en boucle (il bouge).
--   Étapes (async) : 1) demander la position au serveur (toujours connue, même
--   si le perso est streamé out) → sert de cible caméra ET de point de streaming.
--   2) demander au serveur de streamer la zone autour de cette position.
local function spectateStreamAround(target)
	target = target or spectateTarget
	if not target then return end
	-- 1) position serveur (fallback fiable pour les cibles lointaines)
	if getPosFn then
		local ok, pos = pcall(function() return getPosFn:InvokeServer(target.UserId) end)
		if ok and typeof(pos) == "Vector3" and target == spectateTarget then
			specServerPos = pos
		end
	end
	-- 2) meilleure position connue = perso local si chargé, sinon serveur
	local best
	local char = target.Character
	local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
	if hrp then best = hrp.Position else best = specServerPos end
	if best then
		pcall(function() player:RequestStreamAroundAsync(best) end)
	end
end

local function spectateAt(index)
	local others = getOthers()
	if #others == 0 then stopSpectate(); toast("No one to spectate", false); return end
	spectateIndex = ((index - 1) % #others) + 1
	local target = others[spectateIndex]
	spectateTarget = target
	specServerPos = nil  -- oublie la position de la cible précédente
	specName.Text = "👁️ " .. esc(target.DisplayName) .. ptsSuffixLive(target.UserId)
	loadAvatar(specAvatar, target.UserId)
	task.spawn(spectateStreamAround, target)  -- charge la zone tout de suite (async)
	spectateApply()  -- bascule immédiate (la boucle de rendu maintient ensuite)
	toast("👁️ " .. target.DisplayName, true)
end

stopSpectate = function()
	spectating = false
	spectateTarget = nil
	specDragging = false
	specLastMouse = nil
	specServerPos = nil
	specTouches = {}
	specPinchDist = nil
	if specBound then
		pcall(function() RunService:UnbindFromRenderStep(SPEC_BIND) end)
		specBound = false
	end
	for _, c in ipairs(specInputConns) do pcall(function() c:Disconnect() end) end
	specInputConns = {}
	spectateBar.Visible = false
	-- rend la caméra au joueur (Custom + son propre Humanoid)
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local myChar = player.Character
		if myChar then
			local myHum = myChar:FindFirstChildOfClass("Humanoid")
			if myHum then cam.CameraSubject = myHum end
		end
	end
end

-- Boutons de la barre spectate
local function specBtn(x, w, text, col, fn)
	local c = Instance.new("Frame")
	c.AnchorPoint = Vector2.new(1, 0.5); c.Position = UDim2.new(1, x, 0.5, 0)
	c.Size = UDim2.new(0, w, 0, IS_MOBILE and 30 or 40); c.BackgroundTransparency = 1; c.ZIndex = 31; c.Parent = spectateBar
	local b = actionButton(c, { color = col, strokeColor = C.BORDER_BRIGHT, text = text, textSize = IS_MOBILE and 13 or 17, radius = 8, zIndex = 31 })
	b.MouseButton1Click:Connect(fn)
	return b
end
local bw = IS_MOBILE and 32 or 42
specBtn(-8, bw, "✕", C.RED, function() stopSpectate() end)
specBtn(-8 - bw - 4, bw, "▶", C.TURQUOISE_DARK, function() spectateAt(spectateIndex + 1) end)
specBtn(-8 - (bw + 4) * 2, bw, "◀", C.TURQUOISE_DARK, function() spectateAt(spectateIndex - 1) end)

-- Si le joueur observé quitte → passer au suivant / stop
Players.PlayerRemoving:Connect(function(leaving)
	if spectating and spectateTarget == leaving then
		task.wait(0.2)
		if #getOthers() > 0 then spectateAt(spectateIndex) else stopSpectate() end
	end
end)

local function startSpectate()
	if #getOthers() == 0 then toast("No one to spectate", false); return end
	spectating = true
	spectateIndex = 1
	-- réglages caméra par défaut
	specYaw, specPitch, specDist = 0, math.rad(-15), 14
	spectateBar.Visible = true
	window.Visible = false
	bindSpectateInput()
	spectateAt(1)
	-- 🔑 pilotage caméra chaque frame, APRÈS la caméra du jeu (priorité + élevée
	--    = exécuté en dernier → on écrase toute caméra custom → fix "je me revois").
	--    Suit aussi le respawn (Character relu à chaque frame dans spectateApply).
	if specBound then pcall(function() RunService:UnbindFromRenderStep(SPEC_BIND) end) end
	RunService:BindToRenderStep(SPEC_BIND, Enum.RenderPriority.Camera.Value + 100, function()
		if spectating then spectateApply() end
	end)
	specBound = true
	-- 🌍 boucle de streaming : recharge la zone autour de la cible qui se déplace
	--    (async, ne bloque jamais le rendu). S'arrête quand le spectate s'arrête.
	task.spawn(function()
		while spectating do
			spectateStreamAround(spectateTarget)
			task.wait(0.5)
		end
	end)
end

-- ========================================
-- ÉCRAN : LEADERBOARDS (gestion des top joueurs)
-- ========================================
local GOLD = Color3.fromRGB(255, 205, 60)
local LB_TABS = {
	{ id = "RobuxSpent", field = "value", label = "Robux", short = "", isRobux = true },
	{ id = "Points",   remote = "GetPointsLeaderboard",  field = "points",   label = "Points",   short = "" },
	{ id = "Rebirths", remote = "GetRebirthLeaderboard", field = "rebirths", label = "🔄 Rebirths", short = "🔄" },
	{ id = "Streak",   remote = "GetStreakLeaderboard",  field = "streak",   label = "🔥 Streak", suffix = " d", short = "🔥" },
	{ id = "Kills",    remote = "GetKillLeaderboard",    field = "kills",    label = "⚔️ Kills",    short = "⚔️" },
	-- ⏱️ Playtime : pas de remote LeaderboardManager, lu via getGameBoard uniquement.
	--    isPlaytime = rendu spécial (durée) + case à cocher efficacité.
	{ id = "Playtime", field = "value", label = "⏱️ Time", short = "⏱️", isPlaytime = true },
}

-- ⚡ mode du board Playtime : false = temps de jeu | true = efficacité (pts/temps)
local playtimeEffMode = false

-- durée lisible à partir de secondes (ex "3d 4h", "5h 12m", "9m")
local function fmtDuration(sec)
	sec = math.max(0, math.floor(tonumber(sec) or 0))
	local d = math.floor(sec / 86400)
	local h = math.floor((sec % 86400) / 3600)
	local m = math.floor((sec % 3600) / 60)
	if d > 0 then return string.format("%dd %dh", d, h) end
	if h > 0 then return string.format("%dh %dm", h, m) end
	return string.format("%dm", m)
end

local function rankColor(r)
	if r == 1 then return Color3.fromRGB(255, 205, 60)
	elseif r == 2 then return Color3.fromRGB(205, 205, 215)
	elseif r == 3 then return Color3.fromRGB(205, 130, 70)
	elseif r <= 10 then return C.TURQUOISE
	else return C.TEXT_GREY end
end

local function fmtValue(tab, v)
	v = tonumber(v) or 0
	if tab.isPlaytime then
		if playtimeEffMode then return fmtNum(math.floor(v)) .. "/h" end
		return fmtDuration(v)
	end
	if tab.suffix then return tostring(math.floor(v)) .. tab.suffix end
	if tab.id == "Rebirths" then return tostring(math.floor(v)) end
	return fmtNum(v)
end

local screenLeaderboards  -- fwd

-- Panneau de gestion d'un joueur (depuis le leaderboard)
local function screenManage(info, backFn)
	local body = buildScreen("👤 MANAGE PLAYER", true, C.PURPLE, backFn, function() screenManage(info, backFn) end)

	-- Carte joueur
	local hc = Instance.new("Frame")
	hc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 84 or 104)
	hc.BackgroundColor3 = C.BG_DARK
	hc.BorderSizePixel = 0
	hc.LayoutOrder = 0
	hc.ZIndex = 12
	hc.Parent = body
	corner(hc, 10); stroke(hc, C.PURPLE, 1)
	gradient(hc, C.BG_DARK, C.BG_ITEM)
	local avSize = IS_MOBILE and 58 or 76
	local av = makeAvatar(hc, info.userId, avSize, C.PURPLE)
	av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 10, 0.5, 0)
	local ix = 10 + avSize + 12
	local nameL = label(hc, { text = esc(info.displayName or info.username) .. ptsSuffixLive(info.userId), richText = true, size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 20 or 26), position = UDim2.new(0, ix, 0, IS_MOBILE and 10 or 16), xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE, textSize = IS_MOBILE and 15 or 19, truncate = true, zIndex = 13 })
	do
		local atL = label(hc, { text = "@" .. info.username .. economy.lastSeenSuffix(info.userId), size = UDim2.new(1, -ix - 12, 0, 14), position = UDim2.new(0, ix, 0, IS_MOBILE and 32 or 42), xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })
		-- 🕒 dernière connexion : lue si on ne l'a pas encore
		economy.resolveLastSeen({ info.userId }, function()
			if atL.Parent then atL.Text = "@" .. info.username .. economy.lastSeenSuffix(info.userId) end
		end)
	end
	if info.sub then
		label(hc, { text = info.sub, size = UDim2.new(1, -ix - 12, 0, 14), position = UDim2.new(0, ix, 0, IS_MOBILE and 50 or 64), xAlign = Enum.TextXAlignment.Left, color = GOLD, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })
	end

	-- 🏅 STATUT : 🛡️ ADMIN · 👑 VIP · ⚡ x2 / x5 / x10 PERM (achetés OU offerts, calculés par le serveur)
	--    Petites pastilles en HAUT À DROITE de la carte : la carte garde EXACTEMENT sa taille
	--    (rien d'autre ne bouge sur l'écran), seul le nom se raccourcit pour leur laisser la place.
	--    En ligne ici : attribut ProfileBadges. Sinon : GetPublicProfile (cache 60 s côté serveur).
	do
		local row = Instance.new("Frame")
		row.Name = "StatusBadges"
		row.BackgroundTransparency = 1
		row.AnchorPoint = Vector2.new(1, 0)
		row.Position = UDim2.new(1, -8, 0, IS_MOBILE and 6 or 8)
		row.Size = UDim2.new(0, 0, 0, IS_MOBILE and 14 or 17)
		row.AutomaticSize = Enum.AutomaticSize.X
		row.ZIndex = 14
		row.Parent = hc
		local ll = Instance.new("UIListLayout")
		ll.FillDirection = Enum.FillDirection.Horizontal
		ll.HorizontalAlignment = Enum.HorizontalAlignment.Right
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Padding = UDim.new(0, 4)
		ll.Parent = row
		-- le nom laisse la place aux pastilles (même ligne, à gauche)
		local function fitName()
			if nameL.Parent then
				nameL.Size = UDim2.new(1, -ix - 16 - row.AbsoluteSize.X, 0, IS_MOBILE and 20 or 26)
			end
		end
		row:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitName)
		local function pill(text, col, order)
			if not hc.Parent then return end
			local t = Instance.new("TextLabel")
			t.AutomaticSize = Enum.AutomaticSize.X
			t.Size = UDim2.new(0, 0, 1, 0)
			t.BackgroundColor3 = col
			t.BorderSizePixel = 0
			t.Text = " " .. text .. " "
			t.Font = Enum.Font.GothamBold
			t.TextSize = IS_MOBILE and 9 or 11
			t.TextColor3 = Color3.new(1, 1, 1)
			t.LayoutOrder = order
			t.ZIndex = 15
			corner(t, 5)
			t.Parent = row
		end
		local uid = tonumber(info.userId) or 0
		local isAdm = false
		for _, id in ipairs(ADMIN_IDS) do if id == uid then isAdm = true break end end
		if isAdm then pill("🛡️ ADMIN", Color3.fromRGB(200, 55, 60), 1) end
		local function show(vip, b2, b5, b10)
			if vip then pill("👑 VIP", Color3.fromRGB(190, 140, 20), 2) end
			if b2 then pill("⚡x2", Color3.fromRGB(40, 140, 90), 3) end
			if b5 then pill("⚡x5", Color3.fromRGB(40, 110, 200), 4) end
			if b10 then pill("⚡x10", Color3.fromRGB(130, 60, 210), 5) end
			if not (isAdm or vip or b2 or b5 or b10) then pill("Aucun VIP / boost", Color3.fromRGB(70, 74, 90), 9) end
		end
		local online = Players:GetPlayerByUserId(uid)
		local attr = online and online:GetAttribute("ProfileBadges")
		if type(attr) == "string" then
			local set = {}
			for tok in attr:gmatch("[^,]+") do set[tok] = true end
			show(set.vip, set["2"], set["5"], set["10"])
		elseif uid > 0 then
			task.spawn(function()
				local fn = ReplicatedStorage:FindFirstChild("GetPublicProfile")
				if not fn then return end
				local res
				for _ = 1, 3 do   -- le serveur limite à 1 appel / 0,5 s
					local ok, r = pcall(function() return fn:InvokeServer(uid) end)
					if ok and type(r) == "table" and not r.throttled then res = r break end
					task.wait(0.6)
				end
				if type(res) ~= "table" or not hc.Parent then return end
				show(res.isVip == 1, res.b2 == 1, res.b5 == 1, res.b10 == 1)
			end)
		end
	end

	-- 🆔 UserID copiable
	idCopyRow(body, 0, info.userId)

	-- Bouton pleine largeur (avec option confirmation double-tap pour les actions sensibles)
	local function fullBtn(order, text, col, colDark, danger, fn)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 42 or 48)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 12
		c.Parent = body
		local b, lbl = actionButton(c, { color = col, strokeColor = colDark, text = text, textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 12 })
		if danger then
			local armed = false
			b.MouseButton1Click:Connect(function()
				if not armed then
					armed = true
					lbl.Text = "⚠️ Tap again to confirm"
					task.delay(3, function() if lbl and lbl.Parent then armed = false; lbl.Text = text end end)
				else
					armed = false; lbl.Text = text
					fn()
				end
			end)
		else
			b.MouseButton1Click:Connect(fn)
		end
	end

	fullBtn(1, "👤 View full profile", C.PURPLE, C.PURPLE_DARK, false, function()
		openProfileDetail(info.username, function() screenManage(info, backFn) end)
	end)
	fullBtn(2, "👟 Kick", C.ORANGE, C.ORANGE_DARK, false, function()
		adminEvent:FireServer("kick", info.username); toast("Kicked " .. info.username, true)
	end)
	fullBtn(3, "🔨 Ban", C.RED, C.RED_DARK, true, function()
		adminEvent:FireServer("ban", info.username); toast("Banned " .. info.username, true)
	end)
	fullBtn(4, "💥 Reset points", Color3.fromRGB(205, 80, 40), Color3.fromRGB(120, 45, 20), true, function()
		adminEvent:FireServer("resetpoints", info.username); toast("Reset points of " .. info.username, true)
	end)
	fullBtn(45, "🛡️ Clear warnings (all)", C.TURQUOISE_DARK, C.TURQUOISE, false, function()
		adminEvent:FireServer("resetwarnings", info.username)
		adminEvent:FireServer("clearflywarn", info.username)
		toast("Cleared warnings for " .. info.username, true)
	end)
	fullBtn(5, "🗑️ Remove from boards", C.BG_LIGHT, C.BORDER_BRIGHT, true, function()
		adminEvent:FireServer("removefromlb", info.username)
		toast("Removed from boards", true)
		task.delay(0.6, function() if backFn then backFn() end end)
	end)
end

-- Ligne d'un leaderboard : rang + avatar + nom + @username + valeur
-- ⚡ Renvoie ses labels : la ligne s'affiche TOUT DE SUITE, le nom et le
--    @pseudo se remplissent quand le serveur répond (sans rien redessiner).
local function lbRow(parent, order, tab, entry, uname)
	local function currentName()
		return unameCache[entry.userId] or uname or tostring(entry.userId)
	end
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, ROW_H)
	row.BackgroundColor3 = C.BG_DARK
	row.AutoButtonColor = false
	row.Text = ""
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.ZIndex = 11
	row.Parent = parent
	corner(row, 10)
	local rs = stroke(row, C.BORDER_SUBTLE, 1)

	local rankW = IS_MOBILE and 30 or 40
	label(row, {
		text = "#" .. (entry.rank or order), size = UDim2.new(0, rankW, 1, 0),
		position = UDim2.new(0, 4, 0, 0), color = rankColor(entry.rank or order),
		textSize = IS_MOBILE and 12 or 16, zIndex = 12,
	})

	local avSize = ROW_H - 18
	local av = makeAvatar(row, entry.userId, avSize)
	av.AnchorPoint = Vector2.new(0, 0.5)
	av.Position = UDim2.new(0, rankW + 6, 0.5, 0)

	local labelX = rankW + 6 + avSize + 8
	local valW = IS_MOBILE and 74 or 96
	local nameLbl = label(row, {
		text = esc(entry.name or unameCache[entry.userId] or "…") .. ptsSuffixLive(entry.userId),
		richText = true,
		size = UDim2.new(1, -labelX - valW - 10, 0, IS_MOBILE and 15 or 19),
		position = UDim2.new(0, labelX, 0, IS_MOBILE and 9 or 13),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE, textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12,
	})
	local userLbl = label(row, {
		text = "@" .. currentName(),
		size = UDim2.new(1, -labelX - valW - 10, 0, 12),
		position = UDim2.new(0, labelX, 0, IS_MOBILE and 28 or 37),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 12,
	})
	if tab.isRobux then
		local amount = Instance.new("TextButton")
		amount.Text = ""; amount.BackgroundTransparency = 1
		amount.Size = UDim2.fromOffset(valW, 24)
		amount.Position = UDim2.new(1, -8, 0.5, 0); amount.AnchorPoint = Vector2.new(1,0.5)
		amount.ZIndex = 13; amount.Parent = row
		economy.icon(amount, true, C.GREEN, 14)
		label(amount, {text=fmtValue(tab, entry[tab.field]), size=UDim2.new(1,-17,1,0),
			position=UDim2.fromOffset(17,0), xAlign=Enum.TextXAlignment.Right,
			color=C.GREEN, textSize=IS_MOBILE and 12 or 16, zIndex=14, truncate=true})
		amount.Activated:Connect(function() economy.openPurchases(entry.userId) end)
	else
		label(row, {
			text = fmtValue(tab, entry[tab.field]),
			size = UDim2.new(0, valW, 1, 0),
			position = UDim2.new(1, -8, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right, color = GOLD, textSize = IS_MOBILE and 12 or 16, zIndex = 12, truncate = true,
		})
	end

	row.MouseEnter:Connect(function() row.BackgroundColor3 = C.BG_MEDIUM; rs.Color = C.PURPLE end)
	row.MouseLeave:Connect(function() row.BackgroundColor3 = C.BG_DARK; rs.Color = C.BORDER_SUBTLE end)
	row.MouseButton1Click:Connect(function()
		if tab.isRobux then economy.openPurchases(entry.userId); return end
		local un = currentName()
		screenManage({
			userId = entry.userId,
			displayName = entry.name or un,
			username = un,
			sub = tab.label .. " • " .. fmtValue(tab, entry[tab.field]),
		}, function() screenLeaderboards(tab.id, nil, true) end)
	end)
	return { name = nameLbl, user = userLbl, entry = entry }
end

screenLeaderboards = function(tabId, count, fresh)
	currentScreen = "leaderboards"
	tabId = tabId or "Points"
	count = math.clamp(tonumber(count) or 50, 50, 200)

	-- ⚡ Cache client 30 s (survit à la fermeture du panel) : rebasculer d'onglet est instantané.
	--    Rangé dans `economy` pour ne PAS ajouter de variable locale au script (limite 200).
	local lbc = economy.lbCache
	if not lbc then lbc = {}; economy.lbCache = lbc end
	local period = economy.robuxPeriod or "all"
	local PERIODS = {
		{ id = "day",   label = "Aujourd'hui", title = "DU JOUR" },
		{ id = "month", label = "Ce mois",     title = "DU MOIS" },
		{ id = "year",  label = "Cette année", title = "DE L'ANNÉE" },
		{ id = "all",   label = "All time",    title = "ALL TIME" },
	}
	local periodTitle = "ALL TIME"
	for _, p in ipairs(PERIODS) do if p.id == period then periodTitle = p.title end end

	local isRobuxTab = (tabId == "RobuxSpent")
	local body = buildScreen(isRobuxTab and ("💸 TOP SPENDERS — " .. periodTitle) or "🏆 LEADERBOARDS",
		true, isRobuxTab and C.GREEN or GOLD, nil, function() screenLeaderboards(tabId, count, true) end)

	-- Barre d'onglets
	local tabWrap = Instance.new("Frame")
	tabWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 42)
	tabWrap.BackgroundTransparency = 1
	tabWrap.LayoutOrder = 0
	tabWrap.ZIndex = 11
	tabWrap.Parent = body
	local pw = panelSize().X.Offset
	local inner = pw - PAD * 2
	local tgap = 4
	local nTabs = #LB_TABS
	local tw = math.floor((inner - tgap * (nTabs - 1)) / nTabs)
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.Padding = UDim.new(0, tgap)
	tl.Parent = tabWrap
	for _, tabDef in ipairs(LB_TABS) do
		local sel = (tabDef.id == tabId)
		local accent = tabDef.isRobux and C.GREEN or GOLD
		local tb = Instance.new("TextButton")
		tb.Size = UDim2.new(0, tw, 1, 0)
		tb.BackgroundColor3 = sel and accent or C.BG_DARK
		tb.AutoButtonColor = false
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.Text = IS_MOBILE and tabDef.short or tabDef.label
		tb.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		tb.TextSize = IS_MOBILE and 12 or 14
		tb.ZIndex = 12
		tb.Parent = tabWrap
		if tabDef.isRobux or tabDef.id == "Points" then
			local iconBox = Instance.new("Frame")
			iconBox.Size = UDim2.fromOffset(13,13)
			iconBox.Position = IS_MOBILE and UDim2.new(0.5,-6,0.5,-6) or UDim2.new(0,5,0.5,-6)
			iconBox.BackgroundTransparency = 1; iconBox.ZIndex = 13; iconBox.Parent = tb
			economy.icon(iconBox, tabDef.isRobux == true, sel and C.BG_BLACK or accent, 14)
			if not IS_MOBILE then tb.Text = "    " .. tabDef.label; tb.TextSize = 12 end
		end
		corner(tb, 8)
		stroke(tb, sel and accent or C.BORDER_SUBTLE, 1)
		tb.MouseButton1Click:Connect(function() screenLeaderboards(tabDef.id, 50) end)
	end

	local tab
	for _, t in ipairs(LB_TABS) do if t.id == tabId then tab = t end end
	if not tab then tab = LB_TABS[2]; tabId = tab.id end

	-- ⚡ Case à cocher (onglet Playtime) : bascule temps de jeu ↔ efficacité
	if tab.isPlaytime then
		local cbRow = Instance.new("TextButton")
		cbRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		cbRow.BackgroundColor3 = C.BG_DARK
		cbRow.AutoButtonColor = false
		cbRow.Text = ""
		cbRow.BorderSizePixel = 0
		cbRow.LayoutOrder = 1
		cbRow.ZIndex = 11
		cbRow.Parent = body
		corner(cbRow, 8); stroke(cbRow, playtimeEffMode and GOLD or C.BORDER_SUBTLE, 1)
		local box = Instance.new("Frame")
		box.Size = UDim2.new(0, IS_MOBILE and 18 or 22, 0, IS_MOBILE and 18 or 22)
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 10, 0.5, 0)
		box.BackgroundColor3 = playtimeEffMode and GOLD or C.BG_LIGHT
		box.BorderSizePixel = 0
		box.ZIndex = 12
		box.Parent = cbRow
		corner(box, 5); stroke(box, playtimeEffMode and GOLD or C.BORDER_BRIGHT, 1)
		if playtimeEffMode then
			label(box, { text = "✓", size = UDim2.fromScale(1, 1), color = C.BG_BLACK, textSize = IS_MOBILE and 13 or 16, zIndex = 13 })
		end
		label(cbRow, {
			text = "⚡ Plus de points / moins de temps",
			size = UDim2.new(1, -(IS_MOBILE and 40 or 48), 1, 0),
			position = UDim2.new(0, IS_MOBILE and 36 or 42, 0, 0),
			xAlign = Enum.TextXAlignment.Left, color = playtimeEffMode and GOLD or C.TEXT_GREY,
			textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 12,
		})
		cbRow.MouseButton1Click:Connect(function()
			playtimeEffMode = not playtimeEffMode
			screenLeaderboards(tabId, 50)
		end)
	end

	-- 💸 Sous-onglets du classement Robux : jour / mois / année / all time
	if tab.isRobux then
		local pWrap = Instance.new("Frame")
		pWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 36)
		pWrap.BackgroundTransparency = 1
		pWrap.LayoutOrder = 1
		pWrap.ZIndex = 11
		pWrap.Parent = body
		local pl = Instance.new("UIListLayout")
		pl.FillDirection = Enum.FillDirection.Horizontal
		pl.Padding = UDim.new(0, tgap)
		pl.Parent = pWrap
		local pwEach = math.floor((inner - tgap * (#PERIODS - 1)) / #PERIODS)
		for _, p in ipairs(PERIODS) do
			local sel = (p.id == period)
			local pb = Instance.new("TextButton")
			pb.Size = UDim2.new(0, pwEach, 1, 0)
			pb.BackgroundColor3 = sel and C.GREEN or C.BG_DARK
			pb.AutoButtonColor = false
			pb.BorderSizePixel = 0
			pb.Font = FONT
			pb.Text = p.label
			pb.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
			pb.TextSize = IS_MOBILE and 10 or 13
			pb.ZIndex = 12
			pb.Parent = pWrap
			corner(pb, 7)
			stroke(pb, sel and C.GREEN or C.BORDER_SUBTLE, 1)
			pb.MouseButton1Click:Connect(function()
				economy.robuxPeriod = p.id
				screenLeaderboards("RobuxSpent", 50)
			end)
		end
		local note = label(body, {text = (period == "all")
			and "Total suivi • passes estimés + dev products • touche un joueur pour le détail"
			or "Achats enregistrés depuis l'installation v4 • bascule à minuit UTC",
			size=UDim2.new(1,0,0,26), color=C.TEXT_GREY, textSize=IS_MOBILE and 10 or 12,
			wrapped=true, zIndex=11})
		note.LayoutOrder = 2
	end

	local statusF = Instance.new("Frame")
	statusF.Size = UDim2.new(1, 0, 0, 40); statusF.BackgroundTransparency = 1
	statusF.LayoutOrder = 3; statusF.ZIndex = 11; statusF.Parent = body
	label(statusF, { text = "Loading " .. tab.id .. "...", size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

	-- Clé du board envoyée au serveur
	local boardKey = tabId
	if tab.isPlaytime then boardKey = playtimeEffMode and "Efficiency" or "Playtime" end
	if tab.isRobux then boardKey = (period == "all") and "RobuxSpent" or ("RobuxSpent_" .. period) end
	local cacheKey = boardKey .. "#" .. count

	local function paint(data, paged)
		if not statusF.Parent then return end
		statusF:Destroy()
		if #data == 0 then
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 50); f.BackgroundTransparency = 1
			f.LayoutOrder = 3; f.ZIndex = 11; f.Parent = body
			label(f, { text = tab.isRobux and "Aucun achat enregistré sur cette période." or "No entries yet.",
				size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			return
		end
		-- ① on dessine TOUT DE SUITE
		local refs, ids = {}, {}
		for i, entry in ipairs(data) do
			if not entry.name then entry.name = unameCache[entry.userId] end
			ids[i] = entry.userId
			refs[i] = lbRow(body, 3 + i, tab, entry, unameCache[entry.userId])
		end
		-- ⬇️ Load more
		if paged and #data >= count and count < 200 then
			local mc = Instance.new("Frame")
			mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
			mc.BackgroundTransparency = 1
			mc.LayoutOrder = 99999
			mc.ZIndex = 11
			mc.Parent = body
			local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = "⬇️ Load more (+50)", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
			mb.MouseButton1Click:Connect(function() screenLeaderboards(tabId, count + 50) end)
		end
		-- ② puis on remplit les noms et le badge 🚫, sans rien reconstruire
		local function refill()
			for _, r in ipairs(refs) do
				if r.name.Parent then
					local e = r.entry
					local un = unameCache[e.userId]
					if un then
						if not e.name then e.name = un end
						r.user.Text = "@" .. un
					end
					r.name.Text = esc(e.name or ("User " .. e.userId)) .. ptsSuffixLive(e.userId)
				end
			end
		end
		resolveUsernames(ids, function()
			refill()
			resolvePoints(ids, refill)
		end)
	end

	local cached = lbc[cacheKey]
	if cached and not fresh and os.clock() - cached.at < 30 then
		paint(cached.data, cached.paged)
		return
	end

	task.spawn(function()
		local data, paged, robuxErr
		local boardRemote = getGameBoard
		if tab.isRobux then boardRemote = ReplicatedStorage:FindFirstChild("AdminSpending_Top") end
		if boardRemote then
			for attempt = 1, 4 do
				local ok, res = pcall(function() return boardRemote:InvokeServer(boardKey, count) end)
				if ok and type(res) == "table" and res.throttled and attempt < 4 then
					task.wait(0.35 * attempt) -- serveur occupé : on réessaie tout seul
				else
					if ok and type(res) == "table" and type(res.entries) == "table" then
						paged = true
						data = {}
						for i, e in ipairs(res.entries) do
							local row = { userId = e.userId, rank = i }
							row[tab.field] = e.value
							data[i] = row
						end
					elseif ok and type(res) == "table" and res.error then
						robuxErr = tostring(res.error)
					end
					break
				end
			end
		end
		if tab.isRobux and not paged then
			if not statusF.Parent then return end
			statusF:ClearAllChildren()
			label(statusF, {text = robuxErr or "Classement indisponible. Vérifie AdminSpending_Server (v4) puis actualise.",
				size=UDim2.fromScale(1,1), color=C.RED, textSize=IS_MOBILE and 11 or 14, wrapped=true, zIndex=12})
			return
		end
		if not paged then
			local remote = tab.remote and ReplicatedStorage:FindFirstChild(tab.remote)
			if not remote then
				if not statusF.Parent then return end
				statusF:Destroy()
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 80); f.BackgroundColor3 = C.BG_DARK; f.BorderSizePixel = 0
				f.LayoutOrder = 3; f.ZIndex = 11; f.Parent = body
				corner(f, 10); stroke(f, C.RED, 1)
				label(f, { text = "❌ Leaderboard system not found\n(mets AdminPanel_Server à jour ou installe LeaderboardManager)", size = UDim2.fromScale(1, 1), color = C.RED, textSize = IS_MOBILE and 11 or 14, wrapped = true, zIndex = 12 })
				return
			end
			local ok, res = pcall(function() return remote:InvokeServer() end)
			if ok and type(res) == "table" then data = res end
		end
		if type(data) == "table" then
			lbc[cacheKey] = { data = data, paged = paged, at = os.clock() }
		else
			data = {} -- lecture ratée : on n'enregistre rien, 🔄 réessaiera
		end
		paint(data, paged)
	end)
end

-- ========================================
-- ÉCRAN : ANTI-CHEAT BOARDS (top exploiteurs)
-- ========================================
local AC_SYSTEMS = {
	{ id = "fly", label = "🛡️ Fly", color = C.BLUE, metrics = {
		{ id = "fly_strikes",  label = "Strikes" },
		{ id = "fly_warnings", label = "Warnings" },
		{ id = "fly_kicks",    label = "Kicks" },
		{ id = "fly_bans",     label = "Bans", isDate = true },
	} },
	{ id = "smart", label = "🧠 SmartAC", color = C.PURPLE, metrics = {
		{ id = "smart_infractions", label = "Total" },
		{ id = "smart_suspicious",  label = "Suspicious" },
		{ id = "smart_dangerous",   label = "Dangerous" },
	} },
	{ id = "exploit", label = "🚫 Exploit", color = C.RED, metrics = {
		{ id = "exploit_infractions", label = "Infractions" },
	} },
}

local screenACBoards  -- fwd

-- barre d'onglets horizontale générique
local function acTabBar(parent, order, items, selectedId, accent, onPick)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 40)
	wrap.BackgroundTransparency = 1
	wrap.LayoutOrder = order
	wrap.ZIndex = 11
	wrap.Parent = parent
	local pw = panelSize().X.Offset
	local inner = pw - PAD * 2
	local gap = 4
	local count = math.max(1, #items)
	local tw = math.floor((inner - gap * (count - 1)) / count)
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.Padding = UDim.new(0, gap)
	tl.Parent = wrap
	for _, it in ipairs(items) do
		local sel = (it.id == selectedId)
		local tb = Instance.new("TextButton")
		tb.Size = UDim2.new(0, tw, 1, 0)
		tb.BackgroundColor3 = sel and accent or C.BG_DARK
		tb.AutoButtonColor = false
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.Text = it.label
		tb.TextColor3 = sel and C.TEXT_WHITE or C.TEXT_GREY
		tb.TextSize = IS_MOBILE and 10 or 13
		tb.ZIndex = 12
		tb.Parent = wrap
		corner(tb, 8)
		stroke(tb, sel and accent or C.BORDER_SUBTLE, 1)
		tb.MouseButton1Click:Connect(function() onPick(it.id) end)
	end
	return wrap
end

-- ligne d'un board anti-cheat : rang + avatar + nom + @ + valeur → tap = manage
local function acRow(parent, order, rank, userId, value, isDate, accent, backFn)
	local username = unameCache[userId] or tostring(userId)
	local onlinePl = Players:GetPlayerByUserId(userId)
	local displayName = onlinePl and onlinePl.DisplayName or ("@" .. username)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, ROW_H)
	row.BackgroundColor3 = C.BG_DARK
	row.AutoButtonColor = false
	row.Text = ""
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.ZIndex = 11
	row.Parent = parent
	corner(row, 10)
	local rs = stroke(row, C.BORDER_SUBTLE, 1)

	local rankW = IS_MOBILE and 30 or 40
	label(row, { text = "#" .. rank, size = UDim2.new(0, rankW, 1, 0), position = UDim2.new(0, 4, 0, 0),
		color = rankColor(rank), textSize = IS_MOBILE and 12 or 16, zIndex = 12 })

	local avSize = ROW_H - 18
	local av = makeAvatar(row, userId, avSize)
	av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, rankW + 6, 0.5, 0)

	local labelX = rankW + 6 + avSize + 8
	local valW = IS_MOBILE and 76 or 100
	label(row, { text = esc(displayName) .. ptsSuffixLive(userId), richText = true,
		size = UDim2.new(1, -labelX - valW - 10, 0, IS_MOBILE and 15 or 19),
		position = UDim2.new(0, labelX, 0, IS_MOBILE and 9 or 13), xAlign = Enum.TextXAlignment.Left,
		color = C.TEXT_WHITE, textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12 })
	label(row, { text = "@" .. username .. economy.lastSeenSuffix(userId), size = UDim2.new(1, -labelX - valW - 10, 0, 12),
		position = UDim2.new(0, labelX, 0, IS_MOBILE and 28 or 37), xAlign = Enum.TextXAlignment.Left,
		color = C.TEXT_GREY, textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 12 })

	local valText = isDate and ((value and value > 0) and fmtAgo(value) or "?") or fmtNum(value)
	label(row, { text = valText, size = UDim2.new(0, valW, 1, 0), position = UDim2.new(1, -8, 0.5, 0),
		anchor = Vector2.new(1, 0.5), xAlign = Enum.TextXAlignment.Right, color = accent,
		textSize = IS_MOBILE and 12 or 16, zIndex = 12, truncate = true })

	row.MouseEnter:Connect(function() row.BackgroundColor3 = C.BG_MEDIUM; rs.Color = accent end)
	row.MouseLeave:Connect(function() row.BackgroundColor3 = C.BG_DARK; rs.Color = C.BORDER_SUBTLE end)
	row.MouseButton1Click:Connect(function()
		screenManage({ userId = userId, displayName = displayName, username = username, sub = valText }, backFn)
	end)
end

screenACBoards = function(sysId, metricId, count)
	currentScreen = "acboards"
	count = math.clamp(tonumber(count) or 50, 50, 200)
	sysId = sysId or "fly"
	local sys
	for _, s in ipairs(AC_SYSTEMS) do if s.id == sysId then sys = s end end
	if not sys then sys = AC_SYSTEMS[1]; sysId = sys.id end
	local isValid = false
	for _, m in ipairs(sys.metrics) do if m.id == metricId then isValid = true end end
	if not isValid then metricId = sys.metrics[1].id end

	local body = buildScreen("🚨 ANTI-CHEAT BOARDS", true, C.RED, nil, function() screenACBoards(sysId, metricId) end)

	-- onglets système
	local sysItems = {}
	for _, s in ipairs(AC_SYSTEMS) do table.insert(sysItems, { id = s.id, label = s.label }) end
	acTabBar(body, 0, sysItems, sysId, C.RED, function(id) screenACBoards(id) end)

	-- onglets métrique (contextuel)
	acTabBar(body, 1, sys.metrics, metricId, sys.color, function(id) screenACBoards(sysId, id) end)

	-- 🗑️ Danger zone (fly uniquement) : reset des stores
	if sysId == "fly" then
		local dz = Instance.new("Frame")
		dz.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		dz.BackgroundTransparency = 1
		dz.LayoutOrder = 2
		dz.ZIndex = 11
		dz.Parent = body
		local ag = Instance.new("UIGridLayout")
		ag.CellSize = UDim2.new(0.5, -4, 1, 0)
		ag.CellPadding = UDim2.new(0, 8, 0, 0)
		ag.Parent = dz
		local function dangerReset(order, text, actionId)
			local c = Instance.new("Frame")
			c.LayoutOrder = order; c.BackgroundTransparency = 1; c.ZIndex = 11; c.Parent = dz
			local b, lbl = actionButton(c, { color = Color3.fromRGB(150, 40, 40), strokeColor = C.RED, text = text, textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 11 })
			local armed = false
			b.MouseButton1Click:Connect(function()
				if not armed then
					armed = true
					lbl.Text = "⚠️ Tap again"
					task.delay(3, function() if lbl and lbl.Parent then armed = false; lbl.Text = text end end)
				else
					armed = false; lbl.Text = text
					adminEvent:FireServer(actionId)
					toast("Wipe lancé — actualisation…", true)
					-- laisse le serveur bumper la génération puis on ré-affiche vide
					task.delay(2.5, function()
						if currentScreen == "acboards" then screenACBoards(sysId, metricId, count) end
					end)
				end
			end)
		end
		dangerReset(1, "🗑️ Wipe TEST", "wipeflytest")
		dangerReset(2, "🗑️ Wipe REAL", "wipeflyreal")
	end

	-- liste
	local statusF = Instance.new("Frame")
	statusF.Size = UDim2.new(1, 0, 0, 44); statusF.BackgroundTransparency = 1
	statusF.LayoutOrder = 5; statusF.ZIndex = 11; statusF.Parent = body
	local statusLbl = label(statusF, { text = "Loading top 50...", size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

	local isDate = false
	for _, m in ipairs(sys.metrics) do if m.id == metricId then isDate = m.isDate end end

	if not getACBoard then
		statusLbl.Text = "❌ Server not updated (AdminGetACBoard missing)."
		return
	end

	task.spawn(function()
		local ok, res = pcall(function() return getACBoard:InvokeServer(metricId, count) end)
		if not statusF.Parent then return end
		if not ok or type(res) ~= "table" or type(res.entries) ~= "table" then
			statusLbl.Text = "Couldn't load (try refresh)."
			return
		end
		local entries = res.entries
		local testMode = res.testMode  -- true/false pour le système Fly, nil sinon

		-- badge de source (Fly uniquement) : TEST vs RÉEL
		local function addSourceBadge()
			if sysId ~= "fly" then return end
			local bf = Instance.new("Frame")
			bf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 20 or 24)
			bf.BackgroundTransparency = 1
			bf.LayoutOrder = 6
			bf.ZIndex = 11
			bf.Parent = body
			label(bf, {
				text = testMode and "🧪 Données du MODE TEST (shadow)" or "🛡️ Données RÉELLES (mode normal)",
				size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
				color = testMode and C.GREEN or C.ORANGE, textSize = IS_MOBILE and 10 or 12, zIndex = 11,
			})
		end

		if #entries == 0 then
			if sysId == "fly" and testMode == false and (metricId == "fly_strikes" or metricId == "fly_kicks") then
				statusLbl.Text = "⏸️ Strikes / Kicks ne sont suivis qu'en MODE TEST."
			else
				statusLbl.Text = "No entries yet for this board."
			end
			return
		end

		local ids = {}
		for _, e in ipairs(entries) do table.insert(ids, e.userId) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if not statusF.Parent then return end
				statusF:Destroy()
				addSourceBadge()
				for i, e in ipairs(entries) do
					acRow(body, 10 + i, i, e.userId, e.value, isDate, sys.color, function() screenACBoards(sysId, metricId, count) end)
				end
				-- ⬇️ Load more (si la page était pleine et qu'on n'a pas atteint le cap)
				if #entries >= count and count < 200 then
					local mc = Instance.new("Frame")
					mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
					mc.BackgroundTransparency = 1
					mc.LayoutOrder = 99999
					mc.ZIndex = 11
					mc.Parent = body
					local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = "⬇️ Load more (+50)", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
					mb.MouseButton1Click:Connect(function() screenACBoards(sysId, metricId, count + 50) end)
				end
			end)
		end)
	end)
end

-- ========================================
-- ÉCRAN : FEEDBACK 💬  (recherche + filtres + tri)
-- ========================================
local FB_CFG
pcall(function()
	local m = ReplicatedStorage:WaitForChild("FeedbackConfig", 10)
	if m then FB_CFG = require(m) end
end)

local function fbCatText(id)
	if FB_CFG and FB_CFG.get then
		local c = FB_CFG.get(id)
		if c then return c.icon .. " " .. c.label end
	end
	return "💬 " .. tostring(id)
end

-- tout l'état dans UNE table (pas de locals éparpillés)
local fbState = {
	entries = {}, cursor = nil, hasMore = false,
	cat = "all", status = "all", sort = "new", search = "",
	tab = "all", favTag = "all",          -- ⭐ onglet + filtre étiquette
}
-- ⭐ favoris : déclaré ICI (avant fbCard qui l'utilise), rempli par l'IIFE plus bas
local FAV = { items = {}, map = {}, custom = {}, tags = nil, loaded = false }
local screenFeedback

local function fbCard(parent, order, e, rerender, isFav)
	local uid   = tonumber(e.u) or 0
	local uname = unameCache[uid] or e.n or tostring(uid)
	local disp  = e.d or e.n or uname
	local favRec = FAV.map[FAV.fid and FAV.fid(e) or ""]
	local card = Instance.new("Frame")
	card.Size             = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize    = Enum.AutomaticSize.Y
	card.BackgroundColor3 = C.BG_DARK
	card.BorderSizePixel  = 0
	card.LayoutOrder      = order
	card.ZIndex           = 11
	card.Parent           = parent
	corner(card, 10)
	-- ⭐ contour doré si en favori, sinon turquoise si non lu
	stroke(card,
		favRec and (FAV.tagColor and FAV.tagColor(favRec._g) or Color3.fromRGB(255, 205, 60))
			or (e.read and C.BORDER_SUBTLE or C.TURQUOISE),
		(favRec or not e.read) and 1.5 or 1)
	local pd = Instance.new("UIPadding")
	pd.PaddingTop = UDim.new(0, 8); pd.PaddingBottom = UDim.new(0, 8)
	pd.PaddingLeft = UDim.new(0, 10); pd.PaddingRight = UDim.new(0, 10)
	pd.Parent = card
	local lay = Instance.new("UIListLayout")
	lay.Padding = UDim.new(0, 6); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = card
	local head = Instance.new("Frame")
	head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
	head.BackgroundTransparency = 1
	head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = card
	local avS = IS_MOBILE and 32 or 38
	local av  = makeAvatar(head, uid, avS)
	av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 0, 0.5, 0)
	local tx, dateW = avS + 8, IS_MOBILE and 62 or 82
	label(head, { text = esc(disp) .. ptsSuffixLive(uid), richText = true,
		size = UDim2.new(1, -tx - dateW - 4, 0, IS_MOBILE and 15 or 18),
		position = UDim2.new(0, tx, 0, IS_MOBILE and 2 or 3),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
		textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 13 })
	-- 🏷️ pastille d'étiquette (droite, ligne 2) si le feedback est en favori
	local tagW = 0
	if favRec and favRec._gl then
		tagW = IS_MOBILE and 82 or 104
		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0)
		pill.Position = UDim2.new(1, 0, 0, IS_MOBILE and 19 or 22)
		pill.Size = UDim2.new(0, tagW - 4, 0, IS_MOBILE and 14 or 17)
		pill.BackgroundColor3 = FAV.tagColor(favRec._g)
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = tostring(favRec._gl)
		pill.TextColor3 = C.BG_BLACK
		pill.TextSize = IS_MOBILE and 9 or 11
		pill.TextTruncate = Enum.TextTruncate.AtEnd
		pill.ZIndex = 13
		pill.Parent = head
		corner(pill, 5)
	end
	label(head, { text = "@" .. uname .. "  •  " .. fbCatText(e.c),
		size = UDim2.new(1, -tx - 4 - tagW, 0, IS_MOBILE and 13 or 15),
		position = UDim2.new(0, tx, 0, IS_MOBILE and 19 or 23),
		xAlign = Enum.TextXAlignment.Left, color = C.TURQUOISE,
		textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
	label(head, { text = (e.read and "" or "🔴 ") .. fmtAgo(e.t),
		size = UDim2.new(0, dateW, 0, IS_MOBILE and 15 or 18),
		position = UDim2.new(1, 0, 0, IS_MOBILE and 2 or 3), anchor = Vector2.new(1, 0),
		xAlign = Enum.TextXAlignment.Right, color = e.read and C.TEXT_DIM or C.TURQUOISE,
		textSize = IS_MOBILE and 9 or 11, zIndex = 13 })
	local msg = Instance.new("TextLabel")
	msg.Size                   = UDim2.new(1, 0, 0, 0)
	msg.AutomaticSize          = Enum.AutomaticSize.Y
	msg.BackgroundColor3       = C.BG_ITEM
	msg.BackgroundTransparency = 0.3
	msg.BorderSizePixel        = 0
	msg.Font                   = FONT
	msg.Text                   = tostring(e.m or "")
	msg.TextColor3             = C.TEXT_WHITE
	msg.TextSize               = IS_MOBILE and 11 or 13
	msg.TextWrapped            = true
	msg.TextXAlignment         = Enum.TextXAlignment.Left
	msg.TextYAlignment         = Enum.TextYAlignment.Top
	msg.LayoutOrder            = 2
	msg.ZIndex                 = 12
	msg.Parent                 = card
	corner(msg, 8)
	local mp = Instance.new("UIPadding")
	mp.PaddingTop = UDim.new(0, 6); mp.PaddingBottom = UDim.new(0, 6)
	mp.PaddingLeft = UDim.new(0, 8); mp.PaddingRight = UDim.new(0, 8)
	mp.Parent = msg
	-- 🗒️ qui l'a enregistré (onglet favoris uniquement)
	if isFav and favRec then
		local by = Instance.new("Frame")
		by.Size = UDim2.new(1, 0, 0, IS_MOBILE and 13 or 15)
		by.BackgroundTransparency = 1
		by.LayoutOrder = 3; by.ZIndex = 12; by.Parent = card
		label(by, { text = "⭐ enregistré par " .. tostring(favRec._bn or "?") .. "  ·  " .. fmtAgo(favRec._at),
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })
	end
	local acts = Instance.new("Frame")
	acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
	acts.BackgroundTransparency = 1
	acts.LayoutOrder = 4; acts.ZIndex = 12; acts.Parent = card
	local ag = Instance.new("UIGridLayout")
	ag.CellSize = UDim2.new(1/4, -5, 1, 0)
	ag.CellPadding = UDim2.new(0, 6, 0, 0)
	ag.SortOrder = Enum.SortOrder.LayoutOrder
	ag.Parent = acts
	local function mini(o, text, col, colDark, danger, fn)
		local c = Instance.new("Frame")
		c.LayoutOrder = o; c.BackgroundTransparency = 1; c.ZIndex = 12; c.Parent = acts
		local b, lbl = actionButton(c, { color = col, strokeColor = colDark, text = text,
			textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
		if danger then
			local armed = false
			b.MouseButton1Click:Connect(function()
				if not armed then
					armed = true; lbl.Text = "⚠️ Confirm"
					task.delay(3, function() if lbl and lbl.Parent then armed = false; lbl.Text = text end end)
				else fn() end
			end)
		else
			b.MouseButton1Click:Connect(fn)
		end
	end
	mini(1, IS_MOBILE and (e.read and "↺" or "✓") or (e.read and "↺ Unread" or "✓ Read"),
		e.read and C.BG_LIGHT or C.GREEN, C.BORDER_BRIGHT, false, function()
			if feedbackAction then feedbackAction:FireServer(e.read and "unread" or "read", e.bucket, e.id) end
			e.read = not e.read
			rerender()
		end)
	mini(2, IS_MOBILE and "👤" or "👤 Profile", C.PURPLE, C.PURPLE_DARK, false, function()
		openProfileDetail(uname, function() screenFeedback(false) end)
	end)
	-- ⭐ favori : ouvre le sélecteur d'étiquette
	mini(3, favRec and "★" or "☆",
		favRec and Color3.fromRGB(255, 205, 60) or C.BG_LIGHT,
		favRec and Color3.fromRGB(180, 140, 30) or C.BORDER_BRIGHT, false, function()
			FAV.picker(e, rerender)
		end)
	if isFav then
		mini(4, IS_MOBILE and "✕" or "✕ Unfav", Color3.fromRGB(150, 110, 40), C.BORDER_BRIGHT, false, function()
			FAV.act("remove", { fid = FAV.fid(e) }, function() toast("Retiré des favoris", true); rerender() end)
		end)
	else
		mini(4, IS_MOBILE and "🗑️" or "🗑️ Delete", C.RED, C.RED_DARK, true, function()
			if feedbackAction then feedbackAction:FireServer("delete", e.bucket, e.id) end
			for i, x in ipairs(fbState.entries) do
				if x == e then table.remove(fbState.entries, i) break end
			end
			toast("Feedback deleted (le favori est conservé)", true)
			rerender()
		end)
	end
end

-- filtre + tri appliqués côté client sur ce qui est déjà chargé (0 requête)
local function fbVisible()
	local out = {}
	local q = tostring(fbState.search or ""):lower()
	for _, e in ipairs(fbState.entries) do
		local okCat = (fbState.cat == "all") or (e.c == fbState.cat)
		local okSt  = (fbState.status == "all")
			or (fbState.status == "unread" and e.read ~= true)
			or (fbState.status == "read"   and e.read == true)
		local okQ = true
		if #q > 0 then
			local uname = (unameCache[tonumber(e.u) or 0] or ""):lower()
			okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.d or ""):lower():find(q, 1, true) ~= nil)
				or (uname:find(q, 1, true) ~= nil)
				or (tostring(e.m or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.u) == q)
		end
		if okCat and okSt and okQ then table.insert(out, e) end
	end

	local s = fbState.sort
	table.sort(out, function(a, b)
		if s == "old" then return (a.t or 0) < (b.t or 0) end
		if s == "points" then
			local pa = pointsFor(tonumber(a.u) or 0) or -1
			local pb = pointsFor(tonumber(b.u) or 0) or -1
			if pa ~= pb then return pa > pb end
			return (a.t or 0) > (b.t or 0)
		end
		if s == "unread" then
			local ua, ub = (a.read ~= true), (b.read ~= true)
			if ua ~= ub then return ua end
			return (a.t or 0) > (b.t or 0)
		end
		return (a.t or 0) > (b.t or 0)   -- "new"
	end)
	return out
end

screenFeedback = function(reset)
	currentScreen = "feedback"
	if reset then
		fbState.entries, fbState.cursor, fbState.hasMore = {}, nil, false
	end

	local body = buildScreen("💬 FEEDBACK", true, C.TURQUOISE, nil, function()
		if fbState.tab == "fav" then FAV.load(true, function() screenFeedback(false) end)
		else FAV.load(true, function() end); screenFeedback(true) end
	end)
	local chipRefs = {}
	local render, paintChips
	-- ⭐ onglets : tous / favoris
	acTabBar(body, -1, {
		{ id = "all", label = "💬 All feedback" },
		{ id = "fav", label = "⭐ Favorites" .. (#FAV.items > 0 and (" (" .. #FAV.items .. ")") or "") },
	}, fbState.tab or "all", Color3.fromRGB(255, 205, 60), function(id)
		fbState.tab = id
		screenFeedback(false)
	end)
	-- 1er chargement des favoris (cache 20 s côté serveur → quasi gratuit)
	if not FAV.loaded then
		FAV.load(false, function()
			if currentScreen == "feedback" and body.Parent then screenFeedback(false) end
		end)
	end
	if fbState.tab == "fav" then
		FAV.renderList(body)
		return
	end

	-- ── Recherche ────────────────────────────────────────────
	local searchWrap = Instance.new("Frame")
	searchWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
	searchWrap.BackgroundTransparency = 1
	searchWrap.LayoutOrder = 0; searchWrap.ZIndex = 11; searchWrap.Parent = body

	local sBox = Instance.new("TextBox")
	sBox.Size = UDim2.new(1, 0, 1, 0)
	sBox.BackgroundColor3 = C.BG_DARK
	sBox.BorderSizePixel = 0
	sBox.Font = FONT
	sBox.PlaceholderText = "🔍 Search player, UserID or keyword..."
	sBox.PlaceholderColor3 = C.TEXT_DIM
	sBox.Text = fbState.search or ""
	sBox.TextColor3 = C.TEXT_WHITE
	sBox.TextSize = IS_MOBILE and 11 or 14
	sBox.TextXAlignment = Enum.TextXAlignment.Left
	sBox.ClearTextOnFocus = false
	sBox.ZIndex = 12
	sBox.Parent = searchWrap
	corner(sBox, 8); stroke(sBox, C.BORDER_SUBTLE, 1)
	local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sBox
	sBox:GetPropertyChangedSignal("Text"):Connect(function()
		fbState.search = sBox.Text
		if render then render() end
	end)

	-- ── Fabrique de chips ────────────────────────────────────
	local function chipRow(order)
		local sf = Instance.new("ScrollingFrame")
		sf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
		sf.BackgroundTransparency = 1
		sf.BorderSizePixel = 0
		sf.ScrollBarThickness = 0
		sf.ScrollingDirection = Enum.ScrollingDirection.X
		sf.CanvasSize = UDim2.new(0, 0, 0, 0)
		sf.AutomaticCanvasSize = Enum.AutomaticSize.X
		sf.LayoutOrder = order; sf.ZIndex = 11; sf.Parent = body
		local l = Instance.new("UIListLayout")
		l.FillDirection = Enum.FillDirection.Horizontal
		l.Padding = UDim.new(0, 5)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = sf
		return sf
	end

	local function mkChip(parent, i, group, id, text, accent)
		local b = Instance.new("TextButton")
		b.AutomaticSize   = Enum.AutomaticSize.X
		b.Size            = UDim2.new(0, 0, 1, 0)
		b.BackgroundColor3 = C.BG_DARK
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Font            = FONT
		b.Text            = text
		b.TextSize        = IS_MOBILE and 10 or 12
		b.TextColor3      = C.TEXT_GREY
		b.LayoutOrder     = i
		b.ZIndex          = 12
		b.Parent          = parent
		corner(b, 7)
		local st = stroke(b, C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10); p.Parent = b
		table.insert(chipRefs, { btn = b, stroke = st, group = group, id = id, accent = accent or C.TURQUOISE })
		b.MouseButton1Click:Connect(function()
			fbState[group] = id
			paintChips(); render()
		end)
	end

	paintChips = function()
		for _, r in ipairs(chipRefs) do
			local sel = (fbState[r.group] == r.id)
			r.btn.BackgroundColor3 = sel and r.accent or C.BG_DARK
			r.btn.TextColor3       = sel and C.TEXT_WHITE or C.TEXT_GREY
			r.stroke.Color         = sel and r.accent or C.BORDER_SUBTLE
		end
	end

	-- ── Ligne 1 : catégories ─────────────────────────────────
	local rowCat = chipRow(1)
	mkChip(rowCat, 1, "cat", "all", "🌐 All", C.TURQUOISE_DARK)
	if FB_CFG then
		for i, c in ipairs(FB_CFG.CATEGORIES) do
			mkChip(rowCat, i + 1, "cat", c.id, c.icon .. " " .. c.label, C.TURQUOISE_DARK)
		end
	end

	-- ── Ligne 2 : statut ─────────────────────────────────────
	local rowSt = chipRow(2)
	mkChip(rowSt, 1, "status", "all",    "📥 All",    C.BG_LIGHT)
	mkChip(rowSt, 2, "status", "unread", "🔴 Unread", C.RED_DARK)
	mkChip(rowSt, 3, "status", "read",   "✅ Read",   C.GREEN_DARK)

	-- ── Ligne 3 : tri ────────────────────────────────────────
	local rowSort = chipRow(3)
	mkChip(rowSort, 1, "sort", "new",    "🕒 Newest",       C.PURPLE_DARK)
	mkChip(rowSort, 2, "sort", "old",    "🕓 Oldest",       C.PURPLE_DARK)
	mkChip(rowSort, 3, "sort", "unread", "🔴 Unread first", C.PURPLE_DARK)
	mkChip(rowSort, 4, "sort", "points", "💎 Top points",   C.PURPLE_DARK)

	-- ── Compteur ─────────────────────────────────────────────
	local countF = Instance.new("Frame")
	countF.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
	countF.BackgroundTransparency = 1
	countF.LayoutOrder = 4; countF.ZIndex = 11; countF.Parent = body
	local countLbl = label(countF, { text = "", size = UDim2.fromScale(1, 1),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
		textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

	-- ── Liste ────────────────────────────────────────────────
	local listHolder = Instance.new("Frame")
	listHolder.Size = UDim2.new(1, 0, 0, 0)
	listHolder.AutomaticSize = Enum.AutomaticSize.Y
	listHolder.BackgroundTransparency = 1
	listHolder.LayoutOrder = 5; listHolder.ZIndex = 11; listHolder.Parent = body
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = listHolder

	render = function()
		for _, ch in ipairs(listHolder:GetChildren()) do
			if not ch:IsA("UIListLayout") then ch:Destroy() end
		end
		local list = fbVisible()
		local unread = 0
		for _, e in ipairs(fbState.entries) do if e.read ~= true then unread = unread + 1 end end
		countLbl.Text = string.format("%d shown  •  %d loaded  •  %d unread",
			#list, #fbState.entries, unread)

		if #list == 0 then
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = listHolder
			label(f, { text = "Nothing matches these filters.", size = UDim2.fromScale(1, 1),
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
		else
			for i, e in ipairs(list) do fbCard(listHolder, i, e, render, false) end
		end

		if fbState.hasMore then
			local mc = Instance.new("Frame")
			mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
			mc.BackgroundTransparency = 1; mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = listHolder
			local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
				text = "⬇️ Load more", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
			mb.MouseButton1Click:Connect(function()
				local ok, res = pcall(function() return getFeedbacks:InvokeServer(fbState.cursor, 25) end)
				if ok and type(res) == "table" then
					local ids = {}
					for _, e in ipairs(res.entries or {}) do
						table.insert(fbState.entries, e); table.insert(ids, e.u)
					end
					fbState.cursor  = res.cursor
					fbState.hasMore = res.hasMore == true
					resolveUsernames(ids, function() resolvePoints(ids, function() render() end) end)
				else
					render()
				end
			end)
		end
	end

	paintChips()

	if not getFeedbacks then
		countLbl.Text = "❌ Server not updated (AdminGetFeedbacks missing)."
		return
	end

	if #fbState.entries > 0 and not reset then
		render()
		return
	end

	countLbl.Text = "Loading feedback..."
	task.spawn(function()
		local ok, res = pcall(function() return getFeedbacks:InvokeServer(nil, 25) end)
		if not body.Parent then return end
		if not ok or type(res) ~= "table" then
			countLbl.Text = "Couldn't load (try 🔄)."
			return
		end
		fbState.entries = res.entries or {}
		fbState.cursor  = res.cursor
		fbState.hasMore = res.hasMore == true
		local ids = {}
		for _, e in ipairs(fbState.entries) do table.insert(ids, e.u) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if body.Parent then render() end
			end)
		end)
	end)
end

-- ════════════════════════════════════════════════════════════
-- ⭐ FAVORIS DE FEEDBACK (IIFE : registres isolés, +0 au chunk)
-- ════════════════════════════════════════════════════════════
;(function()
	local GOLDEN = Color3.fromRGB(255, 205, 60)
	local DEF = {
		{ id = "urgent", icon = "🔥", label = "Urgent",     r = 255, g = 95,  b = 95  },
		{ id = "todo",   icon = "🔨", label = "À faire",    r = 255, g = 180, b = 60  },
		{ id = "check",  icon = "👀", label = "À vérifier", r = 110, g = 190, b = 255 },
		{ id = "done",   icon = "✅", label = "Fait",       r = 90,  g = 220, b = 140 },
	}
	local function tagList() return FAV.tags or DEF end

	-- ⚠️ doit produire EXACTEMENT le même id que fidOf() côté serveur
	FAV.fid = function(e)
		local id = e and (e.id or e.fid or e.gid)
		if id ~= nil and tostring(id) ~= "" then return tostring(id) end
		return tostring((e and e.u) or 0) .. "_" .. tostring((e and e.t) or 0)
	end
	FAV.tagDef = function(tid)
		for _, t in ipairs(tagList()) do if t.id == tid then return t end end
		return nil
	end
	FAV.tagColor = function(tid)
		local d = FAV.tagDef(tid)
		if d then return Color3.fromRGB(d.r, d.g, d.b) end
		return GOLDEN
	end

	local function absorb(res)
		if type(res) ~= "table" then return false end
		if type(res.items)  == "table" then FAV.items  = res.items  end
		if type(res.custom) == "table" then FAV.custom = res.custom end
		if type(res.tags)   == "table" and #res.tags > 0 then FAV.tags = res.tags end
		FAV.map = {}
		for _, it in ipairs(FAV.items) do FAV.map[tostring(it._fid)] = it end
		FAV.loaded = true
		return true
	end

	FAV.load = function(force, cb)
		if not getFavorites then if cb then cb() end return end
		task.spawn(function()
			local ok, res = pcall(function() return getFavorites:InvokeServer(force == true) end)
			if ok then absorb(res) end
			if cb then cb() end
		end)
	end

	FAV.act = function(action, payload, cb)
		if not favAction then toast("Serveur pas à jour (AdminFavoriteAction)", false); return end
		task.spawn(function()
			local ok, res = pcall(function() return favAction:InvokeServer(action, payload) end)
			if ok and type(res) == "table" and res.ok then
				absorb(res)
				if cb then cb(true) end
			else
				toast("Action favori échouée", false)
				if cb then cb(false) end
			end
		end)
	end

	-- ── ligne de chips horizontale scrollable ──
	local function chipStrip(parent, order)
		local sf = Instance.new("ScrollingFrame")
		sf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
		sf.BackgroundTransparency = 1; sf.BorderSizePixel = 0
		sf.ScrollBarThickness = 0
		sf.ScrollingDirection = Enum.ScrollingDirection.X
		sf.CanvasSize = UDim2.new(0, 0, 0, 0)
		sf.AutomaticCanvasSize = Enum.AutomaticSize.X
		sf.LayoutOrder = order; sf.ZIndex = 52; sf.Parent = parent
		local l = Instance.new("UIListLayout")
		l.FillDirection = Enum.FillDirection.Horizontal
		l.Padding = UDim.new(0, 5); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = sf
		return sf
	end
	local function chipBtn(parent, i, text, sel, accent, z, fn)
		local b = Instance.new("TextButton")
		b.AutomaticSize = Enum.AutomaticSize.X
		b.Size = UDim2.new(0, 0, 1, 0)
		b.BackgroundColor3 = sel and accent or C.BG_DARK
		b.AutoButtonColor = false; b.BorderSizePixel = 0
		b.Font = FONT; b.Text = text
		b.TextSize = IS_MOBILE and 10 or 12
		b.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		b.LayoutOrder = i; b.ZIndex = z; b.Parent = parent
		corner(b, 7); stroke(b, sel and accent or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10); p.Parent = b
		b.MouseButton1Click:Connect(fn)
		return b
	end

	-- ════════ SÉLECTEUR D'ÉTIQUETTE ════════
	FAV.picker = function(entry, onDone)
		local fid = FAV.fid(entry)
		local cur = FAV.map[fid]
		local pick = cur and cur._g or nil
		local customTxt = (cur and cur._g == "_c") and tostring(cur._gl or "") or ""

		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.5
		ov.AutoButtonColor = false; ov.Text = ""; ov.BorderSizePixel = 0
		ov.ZIndex = 50; ov.Parent = window
		local function close() ov:Destroy() end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.92, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0; card.ZIndex = 51; card.Parent = ov
		corner(card, 12); stroke(card, GOLDEN, 1.5); padding(card, 12)
		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8); cl.SortOrder = Enum.SortOrder.LayoutOrder; cl.Parent = card

		local t1 = Instance.new("Frame")
		t1.Size = UDim2.new(1, 0, 0, IS_MOBILE and 20 or 24); t1.BackgroundTransparency = 1
		t1.LayoutOrder = 1; t1.ZIndex = 52; t1.Parent = card
		label(t1, { text = cur and "⭐ Modifier le favori" or "⭐ Enregistrer ce feedback",
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = GOLDEN, textSize = IS_MOBILE and 14 or 17, zIndex = 52 })

		local t2 = Instance.new("Frame")
		t2.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 19); t2.BackgroundTransparency = 1
		t2.LayoutOrder = 2; t2.ZIndex = 52; t2.Parent = card
		label(t2, { text = "« " .. tostring(entry.m or ""):sub(1, 70) .. " »",
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 52 })

		local t3 = Instance.new("Frame")
		t3.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 17); t3.BackgroundTransparency = 1
		t3.LayoutOrder = 3; t3.ZIndex = 52; t3.Parent = card
		label(t3, { text = "ÉTIQUETTE", size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, zIndex = 52 })

		local strip = chipStrip(card, 4)

		local cBox = Instance.new("TextBox")
		cBox.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 36)
		cBox.BackgroundColor3 = C.BG_ITEM; cBox.BorderSizePixel = 0
		cBox.Font = FONT
		cBox.PlaceholderText = "✏️ Ton étiquette (24 car. max)..."
		cBox.PlaceholderColor3 = C.TEXT_DIM
		cBox.Text = customTxt; cBox.TextColor3 = C.TEXT_WHITE
		cBox.TextSize = IS_MOBILE and 11 or 13
		cBox.TextXAlignment = Enum.TextXAlignment.Left
		cBox.ClearTextOnFocus = false
		cBox.Visible = (pick == "_c")
		cBox.LayoutOrder = 5; cBox.ZIndex = 52; cBox.Parent = card
		corner(cBox, 8); stroke(cBox, GOLDEN, 1)
		local cp = Instance.new("UIPadding"); cp.PaddingLeft = UDim.new(0, 10); cp.Parent = cBox

		local paint
		paint = function()
			for _, ch in ipairs(strip:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			chipBtn(strip, 1, "🚫 Aucune", pick == nil, C.BG_LIGHT, 52, function()
				pick = nil; cBox.Visible = false; paint()
			end)
			for i, t in ipairs(tagList()) do
				chipBtn(strip, i + 1, t.icon .. " " .. t.label, pick == t.id,
					Color3.fromRGB(t.r, t.g, t.b), 52, function()
						pick = t.id; cBox.Visible = false; paint()
					end)
			end
			for i, txt in ipairs(FAV.custom) do
				chipBtn(strip, 100 + i, "✏️ " .. txt, (pick == "_c" and cBox.Text == txt), GOLDEN, 52, function()
					pick = "_c"; cBox.Text = txt; cBox.Visible = true; paint()
				end)
			end
			chipBtn(strip, 900, "➕ Perso...", (pick == "_c"), GOLDEN, 52, function()
				pick = "_c"; cBox.Visible = true; cBox:CaptureFocus(); paint()
			end)
		end
		paint()

		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 6; btns.ZIndex = 52; btns.Parent = card
		local n = cur and 3 or 2
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(1/n, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 6, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder; bg.Parent = btns
		local function bt(o, text, col, colDark, fn)
			local c = Instance.new("Frame")
			c.LayoutOrder = o; c.BackgroundTransparency = 1; c.ZIndex = 52; c.Parent = btns
			local b = actionButton(c, { color = col, strokeColor = colDark, text = text,
				textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 52 })
			b.MouseButton1Click:Connect(fn)
		end
		bt(1, cur and "💾 Mettre à jour" or "⭐ Enregistrer", GOLDEN, Color3.fromRGB(180, 140, 30), function()
			if pick == "_c" and cBox.Text:gsub("%s", "") == "" then
				toast("Écris ton étiquette", false); return
			end
			FAV.act("add", { entry = entry, tag = pick, custom = cBox.Text }, function()
				toast(cur and "Favori mis à jour ⭐" or "Enregistré dans les favoris ⭐", true)
				close(); if onDone then onDone() end
			end)
		end)
		if cur then
			bt(2, "✕ Retirer", C.RED, C.RED_DARK, function()
				FAV.act("remove", { fid = fid }, function()
					toast("Retiré des favoris", true)
					close(); if onDone then onDone() end
				end)
			end)
		end
		bt(3, "Annuler", C.BG_LIGHT, C.BORDER_BRIGHT, close)
	end

	-- ════════ ONGLET FAVORIS ════════
	FAV.renderList = function(body)
		local strip = chipStrip(body, 0)
		strip.ZIndex = 11
		local function refresh() screenFeedback(false) end
		chipBtn(strip, 1, "🌐 Toutes", fbState.favTag == "all", GOLDEN, 12, function()
			fbState.favTag = "all"; refresh()
		end)
		for i, t in ipairs(tagList()) do
			chipBtn(strip, i + 1, t.icon .. " " .. t.label, fbState.favTag == t.id,
				Color3.fromRGB(t.r, t.g, t.b), 12, function() fbState.favTag = t.id; refresh() end)
		end
		chipBtn(strip, 900, "✏️ Perso", fbState.favTag == "_c", GOLDEN, 12, function()
			fbState.favTag = "_c"; refresh()
		end)
		chipBtn(strip, 901, "🚫 Sans étiquette", fbState.favTag == "_none", C.BG_LIGHT, 12, function()
			fbState.favTag = "_none"; refresh()
		end)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1; cf.LayoutOrder = 1; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 2; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder; hl.Parent = holder

		if not getFavorites then cLbl.Text = "❌ Serveur pas à jour (AdminGetFavorites)."; return end

		local list = {}
		for _, it in ipairs(FAV.items) do
			local f = fbState.favTag
			local ok = (f == "all")
				or (f == "_none" and it._g == nil)
				or (f == "_c" and it._g == "_c")
				or (it._g == f)
			if ok then table.insert(list, it) end
		end
		cLbl.Text = string.format("%d affiché(s)  •  %d favori(s) au total", #list, #FAV.items)
		if #list == 0 then
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
			label(f, { text = FAV.loaded and "Aucun favori ici. Touche ☆ sur un feedback pour l'enregistrer."
				or "Chargement des favoris...",
				size = UDim2.fromScale(1, 1), wrapped = true,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			return
		end
		local ids = {}
		for _, it in ipairs(list) do table.insert(ids, tonumber(it.u) or 0) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if not holder.Parent then return end
				for _, ch in ipairs(holder:GetChildren()) do
					if not ch:IsA("UIListLayout") then ch:Destroy() end
				end
				for i, it in ipairs(list) do
					fbCard(holder, i, it, function() screenFeedback(false) end, true)
				end
			end)
		end)
	end
end)()

-- ========================================
-- ÉCRAN : UGC REDEEMERS 🎽
-- ========================================
local ESC = {}
local UGC_PINK = Color3.fromRGB(255, 150, 220)
local UGC_CFG
pcall(function()
	local m = ReplicatedStorage:WaitForChild("UGC_CONFIG", 10)
	if m then UGC_CFG = require(m) end
end)

-- SRC_LABEL / SRC_GROUP sont déclarés plus haut (avant renderProfile)
local ugcState = {
	entries = {}, cursor = nil, hasMore = false,
	tab = "log", asset = "all", src = "all", search = "", topMetric = "count", top = nil,
}
local screenUGCLog

local function ugcImg(e)
	local id = tostring(e.ai or e.a)
	if id:find("://") then return id end   -- 🖼️ miniature Roblox (rbxthumb://)
	return "rbxassetid://" .. id
end

local function ugcCard(parent, order, e, backFn)
	local uid   = tonumber(e.u) or 0
	local uname = unameCache[uid] or e.n or tostring(uid)
	local disp  = e.d or e.n or uname
	local H     = IS_MOBILE and 74 or 88

	local card = Instance.new("TextButton")
	card.Size = UDim2.new(1, 0, 0, H)
	card.BackgroundColor3 = C.BG_DARK
	card.AutoButtonColor = false
	card.Text = ""
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	card.ZIndex = 11
	card.Parent = parent
	corner(card, 10)
	local cs = stroke(card, e.f and C.GREEN or C.BORDER_SUBTLE, 1)

	-- image de l'UGC
	local imgSize = H - 16
	local img = Instance.new("ImageLabel")
	img.Size = UDim2.new(0, imgSize, 0, imgSize)
	img.Position = UDim2.new(0, 8, 0.5, 0)
	img.AnchorPoint = Vector2.new(0, 0.5)
	img.BackgroundColor3 = C.BG_ITEM
	img.BorderSizePixel = 0
	img.Image = ugcImg(e)
	img.ScaleType = Enum.ScaleType.Fit
	img.ZIndex = 12
	img.Parent = card
	corner(img, 8)
	stroke(img, UGC_PINK, 1, 0.5)

	local tx = 8 + imgSize + 10
	local prW = IS_MOBILE and 74 or 96

	-- ligne 1 : nom de l'UGC + prix
	label(card, { text = tostring(e.an or "?"),
		size = UDim2.new(1, -tx - prW - 10, 0, IS_MOBILE and 16 or 19),
		position = UDim2.new(0, tx, 0, IS_MOBILE and 7 or 10),
		xAlign = Enum.TextXAlignment.Left, color = UGC_PINK,
		textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12 })
	label(card, {
		text = e.f and "🎁 FREE" or ("💎 " .. fmtNum(e.p or 0)),
		size = UDim2.new(0, prW, 0, IS_MOBILE and 16 or 19),
		position = UDim2.new(1, -8, 0, IS_MOBILE and 7 or 10), anchor = Vector2.new(1, 0),
		xAlign = Enum.TextXAlignment.Right, color = e.f and C.GREEN or Color3.fromRGB(120, 220, 255),
		textSize = IS_MOBILE and 11 or 14, zIndex = 12 })

	-- ligne 2 : avatar mini + joueur
	local avS = IS_MOBILE and 18 or 22
	local av = makeAvatar(card, uid, avS)
	av.Position = UDim2.new(0, tx, 0, IS_MOBILE and 26 or 33)
	label(card, { text = esc(disp) .. "  <font color=\"#8A8A98\">@" .. esc(uname) .. "</font>",
		richText = true,
		size = UDim2.new(1, -tx - avS - 16, 0, IS_MOBILE and 16 or 20),
		position = UDim2.new(0, tx + avS + 6, 0, IS_MOBILE and 26 or 33),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
		textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 12 })

	-- ligne 3 : comment + quand
	local how = SRC_LABEL[tostring(e.s)] or ("• " .. tostring(e.s))
	if e.rbx then how = how .. "  💳 Robux" end
	if e.pa then how = how .. "  ·  solde " .. fmtNum(e.pa) end
	label(card, { text = how .. "  ·  " .. fmtAgo(e.t),
		size = UDim2.new(1, -tx - 12, 0, IS_MOBILE and 14 or 17),
		position = UDim2.new(0, tx, 0, IS_MOBILE and 46 or 57),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
		textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 12 })

	card.MouseEnter:Connect(function() card.BackgroundColor3 = C.BG_MEDIUM; cs.Color = UGC_PINK end)
	card.MouseLeave:Connect(function() card.BackgroundColor3 = C.BG_DARK; cs.Color = e.f and C.GREEN or C.BORDER_SUBTLE end)
	card.MouseButton1Click:Connect(function()
		screenManage({ userId = uid, displayName = disp, username = uname,
			sub = "🎽 " .. tostring(e.an) .. " · " .. (e.f and "FREE" or (fmtNum(e.p or 0) .. " pts")) }, backFn)
	end)
end

local function ugcVisible()
	local out = {}
	local q = tostring(ugcState.search or ""):lower()
	for _, e in ipairs(ugcState.entries) do
		local okA = (ugcState.asset == "all") or (tostring(e.a) == tostring(ugcState.asset))
		local g   = SRC_GROUP[tostring(e.s)] or "paid"
		local okS = (ugcState.src == "all") or (g == ugcState.src)
		local okQ = true
		if #q > 0 then
			local un = (unameCache[tonumber(e.u) or 0] or ""):lower()
			okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.d or ""):lower():find(q, 1, true) ~= nil)
				or (un:find(q, 1, true) ~= nil)
				or (tostring(e.an or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.u) == q)
		end
		if okA and okS and okQ then table.insert(out, e) end
	end
	table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
	return out
end

screenUGCLog = function(reset)
	currentScreen = "ugclog"
	if reset then ugcState.entries, ugcState.cursor, ugcState.hasMore = {}, nil, false end

	local body = buildScreen("🎽 UGC REDEEMERS", true, UGC_PINK, nil, function() screenUGCLog(true) end)
	local render

	-- onglets Log / Top
	acTabBar(body, 0, {
		{ id = "log", label = "📜 Log" },
		{ id = "top", label = "🏆 Top redeemers" },
	}, ugcState.tab, UGC_PINK, function(id)
		ugcState.tab = id
		if id == "top" then ugcState.top = nil end
		screenUGCLog(false)
	end)

	-- ════════ ONGLET TOP ════════
	if ugcState.tab == "top" then
		acTabBar(body, 1, {
			{ id = "count", label = "🎽 Nb d'UGC" },
			{ id = "spent", label = "💎 Points dépensés" },
		}, ugcState.topMetric, C.PURPLE, function(id)
			ugcState.topMetric = id; ugcState.top = nil; screenUGCLog(false)
		end)

		local st = Instance.new("Frame")
		st.Size = UDim2.new(1, 0, 0, 44); st.BackgroundTransparency = 1
		st.LayoutOrder = 2; st.ZIndex = 11; st.Parent = body
		local stl = label(st, { text = "Loading...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		if not getUGCTop then stl.Text = "❌ Server not updated."; return end

		local function paint(entries)
			if not st.Parent then return end
			st:Destroy()
			if #entries == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 50); f.BackgroundTransparency = 1
				f.LayoutOrder = 3; f.ZIndex = 11; f.Parent = body
				label(f, { text = "No UGC redeemed yet.", size = UDim2.fromScale(1, 1),
					color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
				return
			end
			for i, e in ipairs(entries) do
				local isSpent = (ugcState.topMetric == "spent")
				acRow(body, 10 + i, i, e.userId,
					e.value, false, UGC_PINK, function() screenUGCLog(false) end)
			end
			local note = Instance.new("Frame")
			note.Size = UDim2.new(1, 0, 0, 22); note.BackgroundTransparency = 1
			note.LayoutOrder = 9999; note.ZIndex = 11; note.Parent = body
			label(note, {
				text = (ugcState.topMetric == "spent") and "Valeur = points dépensés en UGC" or "Valeur = nombre d'UGC récupérés",
				size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, zIndex = 11 })
		end

		if ugcState.top then
			local ids = {}
			for _, e in ipairs(ugcState.top) do table.insert(ids, e.userId) end
			resolveUsernames(ids, function() resolvePoints(ids, function() paint(ugcState.top) end) end)
		else
			task.spawn(function()
				local ok, res = pcall(function() return getUGCTop:InvokeServer(ugcState.topMetric, 50) end)
				if not st.Parent then return end
				if not ok or type(res) ~= "table" then stl.Text = "Couldn't load (try 🔄)."; return end
				ugcState.top = res.entries or {}
				local ids = {}
				for _, e in ipairs(ugcState.top) do table.insert(ids, e.userId) end
				resolveUsernames(ids, function() resolvePoints(ids, function() paint(ugcState.top) end) end)
			end)
		end
		return
	end

	-- ════════ ONGLET LOG ════════
	local searchWrap = Instance.new("Frame")
	searchWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
	searchWrap.BackgroundTransparency = 1
	searchWrap.LayoutOrder = 1; searchWrap.ZIndex = 11; searchWrap.Parent = body
	local sBox = Instance.new("TextBox")
	sBox.Size = UDim2.new(1, 0, 1, 0)
	sBox.BackgroundColor3 = C.BG_DARK
	sBox.BorderSizePixel = 0
	sBox.Font = FONT
	sBox.PlaceholderText = "🔍 Player, UserID or UGC name..."
	sBox.PlaceholderColor3 = C.TEXT_DIM
	sBox.Text = ugcState.search or ""
	sBox.TextColor3 = C.TEXT_WHITE
	sBox.TextSize = IS_MOBILE and 11 or 14
	sBox.TextXAlignment = Enum.TextXAlignment.Left
	sBox.ClearTextOnFocus = false
	sBox.ZIndex = 12
	sBox.Parent = searchWrap
	corner(sBox, 8); stroke(sBox, C.BORDER_SUBTLE, 1)
	local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sBox
	sBox:GetPropertyChangedSignal("Text"):Connect(function()
		ugcState.search = sBox.Text
		if render then render() end
	end)

	-- chips par UGC (config actuelle + UGC retirés encore présents dans le log)
	local chipRow = Instance.new("ScrollingFrame")
	chipRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
	chipRow.BackgroundTransparency = 1
	chipRow.BorderSizePixel = 0
	chipRow.ScrollBarThickness = 0
	chipRow.ScrollingDirection = Enum.ScrollingDirection.X
	chipRow.CanvasSize = UDim2.new(0, 0, 0, 0)
	chipRow.AutomaticCanvasSize = Enum.AutomaticSize.X
	chipRow.LayoutOrder = 2; chipRow.ZIndex = 11; chipRow.Parent = body
	local cl = Instance.new("UIListLayout")
	cl.FillDirection = Enum.FillDirection.Horizontal
	cl.Padding = UDim.new(0, 5); cl.SortOrder = Enum.SortOrder.LayoutOrder; cl.Parent = chipRow

	local function chip(i, id, text)
		local sel = (tostring(ugcState.asset) == tostring(id))
		local b = Instance.new("TextButton")
		b.AutomaticSize = Enum.AutomaticSize.X
		b.Size = UDim2.new(0, 0, 1, 0)
		b.BackgroundColor3 = sel and UGC_PINK or C.BG_DARK
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Font = FONT
		b.Text = text
		b.TextSize = IS_MOBILE and 10 or 12
		b.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		b.LayoutOrder = i
		b.ZIndex = 12
		b.Parent = chipRow
		corner(b, 7); stroke(b, sel and UGC_PINK or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10); p.Parent = b
		b.MouseButton1Click:Connect(function() ugcState.asset = id; screenUGCLog(false) end)
	end
	chip(1, "all", "🌐 All")
	local seen = {}
	if UGC_CFG then
		for i, u in ipairs(UGC_CFG.Items) do
			seen[tostring(u.AssetId)] = true
			chip(i + 1, u.AssetId, u.Name)
		end
	end
	local extra = 500
	for _, e in ipairs(ugcState.entries) do
		local k = tostring(e.a)
		if not seen[k] then seen[k] = true; extra += 1; chip(extra, e.a, (e.an or k) .. " ⚠️") end
	end

	-- Filtre par voie d'acquisition
	acTabBar(body, 25, {
		{ id = "all",  label = "🌐 Toutes" },
		{ id = "paid", label = "💎 Payées" },
		{ id = "free", label = "🎁 Gratuites" },
		{ id = "flag", label = "🚨 Hors shop" },
	}, ugcState.src, C.RED, function(id) ugcState.src = id; screenUGCLog(false) end)

	local countF = Instance.new("Frame")
	countF.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
	countF.BackgroundTransparency = 1
	countF.LayoutOrder = 30; countF.ZIndex = 11; countF.Parent = body
	local countLbl = label(countF, { text = "", size = UDim2.fromScale(1, 1),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
		textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

	local listHolder = Instance.new("Frame")
	listHolder.Size = UDim2.new(1, 0, 0, 0)
	listHolder.AutomaticSize = Enum.AutomaticSize.Y
	listHolder.BackgroundTransparency = 1
	listHolder.LayoutOrder = 31; listHolder.ZIndex = 11; listHolder.Parent = body
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
	ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = listHolder

	render = function()
		for _, ch in ipairs(listHolder:GetChildren()) do
			if not ch:IsA("UIListLayout") then ch:Destroy() end
		end
		local list = ugcVisible()
		local sum, freeN = 0, 0
		for _, e in ipairs(list) do
			sum += (e.p or 0)
			if e.f then freeN += 1 end
		end
		countLbl.Text = string.format("%d shown  •  %d loaded  •  %s pts total  •  %d free",
			#list, #ugcState.entries, fmtNum(sum), freeN)

		if #list == 0 then
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = listHolder
			label(f, { text = "Nothing matches these filters.", size = UDim2.fromScale(1, 1),
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
		else
			for i, e in ipairs(list) do
				ugcCard(listHolder, i, e, function() screenUGCLog(false) end)
			end
		end

		if ugcState.hasMore then
			local mc = Instance.new("Frame")
			mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
			mc.BackgroundTransparency = 1; mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = listHolder
			local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
				text = "⬇️ Load more", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
			mb.MouseButton1Click:Connect(function()
				local ok, res = pcall(function() return getUGCLog:InvokeServer(ugcState.cursor, 30) end)
				if ok and type(res) == "table" then
					local ids = {}
					for _, e in ipairs(res.entries or {}) do
						table.insert(ugcState.entries, e); table.insert(ids, e.u)
					end
					ugcState.cursor  = res.cursor
					ugcState.hasMore = res.hasMore == true
					resolveUsernames(ids, function() resolvePoints(ids, function() render() end) end)
				else render() end
			end)
		end
	end

	if not getUGCLog then countLbl.Text = "❌ Server not updated (AdminGetUGCRedeems missing)."; return end
	if #ugcState.entries > 0 and not reset then render(); return end

	countLbl.Text = "Loading UGC log..."
	task.spawn(function()
		local ok, res = pcall(function() return getUGCLog:InvokeServer(nil, 30) end)
		if not body.Parent then return end
		if not ok or type(res) ~= "table" then countLbl.Text = "Couldn't load (try 🔄)."; return end
		ugcState.entries = res.entries or {}
		ugcState.cursor  = res.cursor
		ugcState.hasMore = res.hasMore == true
		local ids = {}
		for _, e in ipairs(ugcState.entries) do table.insert(ids, e.u) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if not body.Parent then return end
				-- si le log contient des UGC absents de la config actuelle,
				-- on reconstruit une fois pour afficher leurs chips "⚠️"
				local needRebuild = false
				if UGC_CFG then
					local known = {}
					for _, u in ipairs(UGC_CFG.Items) do known[tostring(u.AssetId)] = true end
					for _, e in ipairs(ugcState.entries) do
						if not known[tostring(e.a)] then needRebuild = true break end
					end
				end
				if needRebuild then screenUGCLog(false) else render() end
			end)
		end)
	end)
end

-- ========================================
-- DISPATCH DES ACTIONS DEPUIS L'ACCUEIL
-- ========================================
openAction = function(a)
	local id = a.id
	if id == "spectate" then
		startSpectate()
	elseif id == "fly" then
		screenFly()
	elseif id == "givetool" then
		screenGiveTool()
	elseif id == "tpcheckpoint" then
		screenCheckpoint()
	elseif id == "profile" then
		screenProfile()
	elseif id == "feedback" then
		screenFeedback(true)
	elseif id == "ugclog" then
		screenUGCLog(true)
	elseif id == "ugcescrow" then
		ESC.screen(true)
	elseif id == "leaderboards" then
		screenLeaderboards("Points")
	elseif id == "acboards" then
		screenACBoards("fly")
	elseif id == "ban" then
		screenPicker({ id = "ban", title = "🔨 BAN", color = C.RED, allowSearch = true, execLabel = "BAN" })
	elseif id == "unban" then
		screenPicker({ id = "unban", title = "✅ UNBAN", color = C.GREEN, allowSearch = true, showList = false, execLabel = "UNBAN" })
	elseif id == "kick" then
		screenPicker({ id = "kick", title = "👟 KICK", color = C.ORANGE, execLabel = "Kicked" })
	elseif id == "freeze" then
		screenPicker({ id = "freeze", title = "🧊 FREEZE", color = C.BLUE, execLabel = "Frozen" })
	elseif id == "teleport" then
		screenPicker({ id = "teleport", title = "🚀 GO TO PLAYER", color = C.PURPLE, execLabel = "Teleported to" })
	elseif id == "bring" then
		screenPicker({ id = "bring", title = "🧲 BRING PLAYER", color = C.PURPLE, execLabel = "Brought" })
	elseif id == "reset" then
		screenPicker({ id = "reset", title = "🔄 RESET", color = Color3.fromRGB(120, 60, 190), execLabel = "Reset" })
	end
end

-- ========================================
-- OUVERTURE / FERMETURE
-- ========================================
local function openPanel()
	window.Visible = true
	if currentScreen == nil or currentScreen == "home" then
		screenHome()
	else
		screenHome()  -- toujours revenir à l'accueil à l'ouverture
	end
	window.Size = UDim2.new(0, 0, 0, 0)
	local target = panelSize()
	TweenService:Create(window, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = target }):Play()
end

miniBtn.MouseButton1Click:Connect(function()
	if window.Visible then window.Visible = false else openPanel() end
end)

-- Commande chat /admin
pcall(function()
	TextChatService.MessageReceived:Connect(function(msg)
		if msg.TextSource and msg.TextSource.UserId == player.UserId then
			if msg.Text:lower() == "/admin" then
				if window.Visible then window.Visible = false else openPanel() end
			end
		end
	end)
end)

-- Rafraîchir les listes ouvertes quand un joueur rejoint/part
-- (on évite givetool / tpcheckpoint / profile pour ne pas casser une sélection en cours)
local function refreshIfListScreen()
	if not window.Visible then return end
	local s = currentScreen
	if s == "home" then
		screenHome()
	elseif s == "fly" then
		screenFly()
	elseif s == "ban" or s == "unban" or s == "kick" or s == "freeze"
		or s == "teleport" or s == "bring" or s == "reset" then
		openAction({ id = s })
	end
end
Players.PlayerAdded:Connect(function() task.wait(0.5); refreshIfListScreen() end)
Players.PlayerRemoving:Connect(function() task.wait(0.5); refreshIfListScreen() end)

-- Fly reçu (déclenché par un autre admin sur nous)
adminEvent.OnClientEvent:Connect(function(action, data)
	if action == "fly_toggle" then
		if flying then stopFly(); toast("✈️ Fly disabled", false)
		else startFly(); toast("✈️ Fly enabled by " .. tostring(data), true) end
	end
end)



--════════════════════════════════════════════════════════════════════════════
-- 🧩 ADMIN PANEL — CLIENT : SECTIONS         ⟦ VERSION 3 ⟧
--     🚫 BANS  +  🎁 GIFT LOG  +  🔐 ESCROW (complet)
--
--  📍 OÙ COLLER CE FICHIER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--  ⚠️ DEUX BLOCS DE TON SCRIPT SONT À SUPPRIMER AVANT DE COLLER :
--
--     1. L'ancienne section BANS — l'IIFE qui commence par
--        ;(function()  local ACCENT = Color3.fromRGB(255, 95, 95)
--        (si tu avais déjà installé la v1 ou la v2, c'est déjà fait)
--
--     2. ⚠️ NOUVEAU — Ta section ESCROW — l'IIFE qui commence par
--        ;(function()  local CYAN = Color3.fromRGB(120, 220, 255)
--        ...jusqu'à son `end)()` et le pavé « ✅ CE QUE TU VERRAS » qui suit.
--        Le bloc 3 la remplace, en gardant tous ses onglets et en y ajoutant
--        les réglages, les dettes et les créances de côté.
--
--        ⚠️ GARDE la ligne `local ESC = {}` : elle est en dehors de l'IIFE,
--           plus haut dans ton script (juste avant `local UGC_PINK`).
--
--     Et si tu avais collé la v1 ou la v2 de ce fichier, remplace-la
--     entièrement (de cet en-tête au dernier `end)()` avant la ligne print).
--
--  Les trois blocs sont des IIFE : ils n'ajoutent AUCUNE variable locale au
--  script principal (tu restes loin de la limite de 200 registres).
--
--  Prérequis serveur :
--     • BanManager.server.lua  (v2)      → bloc 1
--     • GiftLog_Server.lua               → bloc 2
--     • A_UGCEscrow.server.lua (v3)      → bloc 3
--
--  ── CE QUI A CHANGÉ DEPUIS LA VERSION 2 ──────────────────────────────────
--     • Les réglages escrow ne sont plus une entrée de menu séparée : ils
--       vivent dans ta section 🔐 ESCROW, avec les dettes et les créances de
--       côté. Six onglets sur deux rangées.
--     • Chaque réglage passe par une fenêtre qui explique ce qu'il fait, avec
--       un compte à rebours avant que le bouton de validation s'active.
--     • Les actions sensibles (confirmer / rembourser / annuler une dette /
--       solder une créance) passent par la même fenêtre.
--     • Cartes de gift : les zones donneur et receveur ont maintenant un fond
--       et une mention « 👤 voir le profil » pour qu'on voie qu'elles sont
--       cliquables, avec surbrillance au survol.
--     • Bloc 1 (BANS) : inchangé depuis la v1.
--════════════════════════════════════════════════════════════════════════════


--════════════════════════════════════════════════════════════════════════════
-- 🚫 BLOC 1/2 — SECTION BANS  (remplace intégralement ton ancienne section)
--
--  Nouveautés par rapport à ta version :
--    ✨ Onglet 📵 Appareils : qui est bloqué, qui est en attente, depuis quand
--    ✨ Device ban sur joueur HORS LIGNE → mis en attente, appliqué au rejoin
--    ✅ Journal réparé : les anciens bans apparaissent avec leur vraie date
--    ✅ Filtres 📵 Appareil et 📦 Importés dans le journal
--    ✅ Bouton de ré-import des anciens bans dans les réglages
--════════════════════════════════════════════════════════════════════════════
;(function()
	local ACCENT      = Color3.fromRGB(255, 95, 95)
	local ACCENT_DARK = Color3.fromRGB(150, 40, 45)
	local DEVICE_COL  = Color3.fromRGB(120, 200, 255)
	local DEVICE_DARK = Color3.fromRGB(30, 95, 150)
	local PENDING_COL = Color3.fromRGB(255, 185, 70)

	local getCfg = ReplicatedStorage:WaitForChild("AdminGetBanConfig", 10)
	local setCfg = ReplicatedStorage:WaitForChild("AdminSetBanConfig", 10)
	local getLog = ReplicatedStorage:WaitForChild("AdminGetBanLog", 10)
	local doAct  = ReplicatedStorage:WaitForChild("AdminBanAction", 10)
	local getDev = ReplicatedStorage:WaitForChild("AdminGetDeviceBans", 10)   -- ✨ v2

	if not getCfg then
		warn("[Admin] AdminGetBanConfig introuvable → ajoute BanManager.server.lua dans ServerScriptService")
	end
	if not getDev then
		warn("[Admin] AdminGetDeviceBans introuvable → mets BanManager.server.lua à jour (v2)")
	end

	local RLBL = {
		newaccount = "🍼 Nouveau compte",
		anticheat  = "🧠 Anti-cheat",
		exploit    = "🚫 Anti-exploit",
		flytp      = "🛡️ Fly / TP",
		ugc        = "🎽 UGC",
		admin      = "🔨 Admin",
		other      = "❓ Autre",
	}
	local RCOL = {
		newaccount = Color3.fromRGB(255, 190, 90),
		anticheat  = C.PURPLE,
		exploit    = C.RED,
		flytp      = C.BLUE,
		ugc        = Color3.fromRGB(255, 150, 220),
		admin      = C.ORANGE,
		other      = C.TEXT_GREY,
	}
	local RORDER = { "newaccount", "anticheat", "exploit", "flytp", "ugc", "admin", "other" }

	local DURATIONS = {
		{ id = 3600,       label = "1 h" },
		{ id = 86400,      label = "1 j" },
		{ id = 7 * 86400,  label = "7 j" },
		{ id = 30 * 86400, label = "30 j" },
		{ id = -1,         label = "♾️ Perm" },
	}

	local S = {
		tab = "cfg",
		cfg = nil, totals = nil, session = nil, devOk = true,
		dirty = false, loadingCfg = false, loadingLog = false,
		logLoaded = false, cfgFailed = false,
		entries = {}, cursor = nil, hasMore = false,
		filter = "all", search = "",
		mTarget = "", mDuration = -1, mDevice = false, mAlts = false, mDetails = "",
		lookup = nil,
		-- ✨ onglet appareils
		devEntries = {}, devLoaded = false, devLoading = false,
		devFilter = "all", devCount = { pending = 0, active = 0 },
	}

	local screen  -- forward decl

	----------------------------------------------------------------------
	-- 🔧 PETITS COMPOSANTS
	----------------------------------------------------------------------
	local function fmtDur(sec)
		sec = tonumber(sec)
		if sec == nil then return "?" end
		if sec == -1 then return "♾️ permanent" end
		if sec <= 0 then return "—" end
		if sec >= 86400 then return string.format("%.0f j", sec / 86400) end
		if sec >= 3600  then return string.format("%.0f h", sec / 3600) end
		return string.format("%.0f min", sec / 60)
	end

	local function durToDays(sec)
		sec = tonumber(sec)
		if not sec or sec == -1 then return 7 end
		return math.max(1, math.floor(sec / 86400 + 0.5))
	end

	local function fmtUntil(ts)
		ts = tonumber(ts)
		if not ts or ts == 0 then return "♾️ jamais" end
		local left = ts - os.time()
		if left <= 0 then return "expiré" end
		return "dans " .. fmtDur(left)
	end

	-- Date d'un événement du journal (gère les fiches importées sans date)
	local function fmtWhen(e)
		if e.unk or not e.t or e.t == 0 then return "📅 date inconnue" end
		return fmtAgo(e.t)
	end

	local function noteCard(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)

		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f

		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	local function toggleRow(parent, order, text, value, onSet)
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.Text = ""
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 8); stroke(row, value and C.GREEN or C.BORDER_SUBTLE, 1)

		local pw = IS_MOBILE and 50 or 62
		label(row, {
			text = text, size = UDim2.new(1, -pw - 22, 1, 0),
			position = UDim2.new(0, 10, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = value and C.TEXT_WHITE or C.TEXT_GREY,
			textSize = IS_MOBILE and 11 or 13, truncate = true, zIndex = 12,
		})

		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, -8, 0.5, 0)
		pill.Size = UDim2.new(0, pw, 0, IS_MOBILE and 21 or 25)
		pill.BackgroundColor3 = value and C.GREEN or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = value and "ON" or "OFF"
		pill.TextColor3 = value and C.BG_BLACK or C.TEXT_GREY
		pill.TextSize = IS_MOBILE and 10 or 12
		pill.ZIndex = 12
		pill.Parent = row
		corner(pill, 6)

		row.MouseButton1Click:Connect(function() onSet(not value) end)
		return row
	end

	local function stepperRow(parent, order, value, minV, maxV, suffix, onSet)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		row.BackgroundColor3 = C.BG_DARK
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 8); stroke(row, ACCENT, 1)

		local bw = IS_MOBILE and 38 or 46
		local function sideBtn(isPlus)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(isPlus and 1 or 0, 0.5)
			c.Position = UDim2.new(isPlus and 1 or 0, isPlus and -6 or 6, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 28 or 34)
			c.BackgroundTransparency = 1
			c.ZIndex = 12
			c.Parent = row
			local b = actionButton(c, {
				color = isPlus and C.GREEN or C.BG_LIGHT,
				strokeColor = isPlus and C.GREEN_DARK or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 16 or 20, radius = 7, zIndex = 12,
			})
			b.MouseButton1Click:Connect(function()
				onSet(math.clamp(value + (isPlus and 1 or -1), minV, maxV))
			end)
		end
		sideBtn(false); sideBtn(true)

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.Position = UDim2.new(0.5, 0, 0.5, 0)
		box.Size = UDim2.new(1, -(bw * 2 + 24), 1, -10)
		box.BackgroundTransparency = 1
		box.Font = FONT
		box.Text = tostring(value) .. " " .. suffix
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 14 or 17
		box.ClearTextOnFocus = true
		box.ZIndex = 12
		box.Parent = row

		box.FocusLost:Connect(function()
			local v = tonumber(box.Text:match("%d+"))
			if v then onSet(math.clamp(math.floor(v), minV, maxV))
			else box.Text = tostring(value) .. " " .. suffix end
		end)
		return row
	end

	local function chipStrip(parent, order)
		local sf = Instance.new("ScrollingFrame")
		sf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
		sf.BackgroundTransparency = 1
		sf.BorderSizePixel = 0
		sf.ScrollBarThickness = 0
		sf.ScrollingDirection = Enum.ScrollingDirection.X
		sf.CanvasSize = UDim2.new(0, 0, 0, 0)
		sf.AutomaticCanvasSize = Enum.AutomaticSize.X
		sf.LayoutOrder = order
		sf.ZIndex = 11
		sf.Parent = parent
		local l = Instance.new("UIListLayout")
		l.FillDirection = Enum.FillDirection.Horizontal
		l.Padding = UDim.new(0, 5)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = sf
		return sf
	end

	local function chip(parent, i, text, selected, accent, onClick)
		local b = Instance.new("TextButton")
		b.AutomaticSize = Enum.AutomaticSize.X
		b.Size = UDim2.new(0, 0, 1, 0)
		b.BackgroundColor3 = selected and accent or C.BG_DARK
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Font = FONT
		b.Text = text
		b.TextSize = IS_MOBILE and 10 or 12
		b.TextColor3 = selected and C.BG_BLACK or C.TEXT_GREY
		b.LayoutOrder = i
		b.ZIndex = 12
		b.Parent = parent
		corner(b, 7); stroke(b, selected and accent or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = b
		b.MouseButton1Click:Connect(onClick)
		return b
	end

	local function bigBtn(parent, order, text, col, colDark, danger, fn)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 42 or 48)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b, lbl = actionButton(c, {
			color = col, strokeColor = colDark, text = text,
			textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11,
		})
		if danger then
			local armed = false
			b.MouseButton1Click:Connect(function()
				if not armed then
					armed = true
					lbl.Text = "⚠️ Appuie encore pour confirmer"
					task.delay(3, function()
						if lbl and lbl.Parent then armed = false; lbl.Text = text end
					end)
				else
					armed = false; lbl.Text = text
					fn()
				end
			end)
		else
			b.MouseButton1Click:Connect(fn)
		end
		return b
	end

	local function statLine(parent, order, key, val, color)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order
		row.ZIndex = 12
		row.Parent = parent
		label(row, { text = key, size = UDim2.new(0.6, 0, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })
		label(row, { text = tostring(val), size = UDim2.new(0.4, 0, 1, 0),
			position = UDim2.new(0.6, 0, 0, 0), xAlign = Enum.TextXAlignment.Right,
			color = color or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13, zIndex = 13 })
		return row
	end

	local function card(parent, order, title, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 10); stroke(f, color, 1)

		label(f, { text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
			color = color, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })

		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = f
		local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 2); l.Parent = rows
		local p = Instance.new("UIPadding")
		p.PaddingBottom = UDim.new(0, 8); p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = rows
		return f, rows
	end

	-- Appel serveur générique + toast + rafraîchissement
	local function callServer(action, payload, onDone)
		if not doAct then toast("BanManager pas installé côté serveur", false); return end
		task.spawn(function()
			local ok, res = pcall(function() return doAct:InvokeServer(action, payload) end)
			if ok and type(res) == "table" then
				if res.msg then toast(res.msg, res.ok == true) end
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

	----------------------------------------------------------------------
	-- ⚙️ ONGLET RÉGLAGES
	----------------------------------------------------------------------
	local function renderSettings(body)
		local cfg = S.cfg
		if not cfg then
			local msg, col
			if not getCfg then
				msg, col = "❌ BanManager pas installé côté serveur (AdminGetBanConfig introuvable).", C.RED
			elseif S.cfgFailed then
				msg, col = "⚠️ Réglages illisibles. Appuie sur 🔄 en haut pour réessayer.", C.ORANGE
			else
				msg, col = "Chargement des réglages...", C.TEXT_GREY
			end
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = body
			label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
				color = col, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			return
		end

		local function set(k, v)
			cfg[k] = v
			S.dirty = true
			screen(false)
		end

		sectionLabel(body, 1, "FILTRE DES NOUVEAUX COMPTES")
		acTabBar(body, 2, {
			{ id = "off",  label = "⛔ Désactivé" },
			{ id = "kick", label = "👟 Kick" },
			{ id = "ban",  label = "🔨 Ban" },
		}, cfg.naMode, ACCENT, function(id) set("naMode", id) end)

		if cfg.naMode == "off" then
			noteCard(body, 3, "Le filtre est éteint : tous les comptes peuvent jouer, quel que soit leur âge.", C.TEXT_DIM)
		else
			noteCard(body, 3, (cfg.naMode == "ban")
				and "Un compte plus jeune que le seuil est BANNI (il ne peut plus rejoindre du tout)."
				or  "Un compte plus jeune que le seuil est KICK (il peut réessayer, mais sera re-kické).",
				ACCENT)
		end

		sectionLabel(body, 4, "ÂGE MINIMUM DU COMPTE (EN JOURS)")
		stepperRow(body, 5, cfg.naMinDays, 1, 365, "jour(s)", function(v) set("naMinDays", v) end)
		noteCard(body, 6, "Tape directement dans la case pour saisir un nombre, ou utilise − / +. "
			.. "Actuellement : un compte de moins de " .. tostring(cfg.naMinDays) .. " jour(s) est bloqué.", C.TEXT_DIM)

		if cfg.naMode == "ban" then
			sectionLabel(body, 7, "DURÉE DU BAN")
			acTabBar(body, 8, DURATIONS, cfg.naDuration, ACCENT, function(id) set("naDuration", id) end)
			sectionLabel(body, 9, "OU DURÉE PERSONNALISÉE (EN JOURS)")
			stepperRow(body, 10, durToDays(cfg.naDuration), 1, 3650, "jour(s)", function(v)
				set("naDuration", v * 86400)
			end)
		end

		sectionLabel(body, 11, "OPTIONS")
		toggleRow(body, 12, "📵 Bloquer aussi l'appareil (ApplyDeviceBlock)", cfg.naDeviceBlock == true,
			function(v) set("naDeviceBlock", v) end)
		toggleRow(body, 13, "👥 Épargner les comptes alternatifs détectés", cfg.naExcludeAlts == true,
			function(v) set("naExcludeAlts", v) end)
		toggleRow(body, 14, "🎮 Ignorer le filtre dans Studio", cfg.naSkipStudio ~= false,
			function(v) set("naSkipStudio", v) end)

		if cfg.naDeviceBlock and cfg.naMode ~= "ban" then
			noteCard(body, 15, "⚠️ Le blocage d'appareil ne s'applique qu'en mode BAN. En mode KICK il est ignoré.", C.ORANGE)
		elseif cfg.naDeviceBlock then
			noteCard(body, 15, "📵 Blocage d'appareil : 24 h maximum (limite Roblox), PC Windows/macOS uniquement. "
				.. "Le joueur étant forcément connecté quand ce filtre se déclenche, le blocage s'applique bien.",
				DEVICE_COL)
		end

		if S.devOk == false then
			noteCard(body, 16, "🚨 Le moteur de ce serveur a refusé ApplyDeviceBlock : les bans partent sans blocage d'appareil.", C.RED)
		end

		bigBtn(body, 20, S.dirty and "💾 ENREGISTRER LES MODIFICATIONS" or "✅ Réglages à jour",
			S.dirty and C.GREEN or C.BG_LIGHT, S.dirty and C.GREEN_DARK or C.BORDER_BRIGHT, false, function()
				if not S.dirty then toast("Rien à enregistrer", false); return end
				if not setCfg then toast("Serveur pas à jour", false); return end
				task.spawn(function()
					local ok, res = pcall(function() return setCfg:InvokeServer(cfg) end)
					if ok and type(res) == "table" and res.ok then
						S.cfg = res.config or cfg
						S.dirty = false
						toast(res.msg or "Enregistré ✅", true)
					else
						toast((type(res) == "table" and res.msg) or "Échec de l'enregistrement", false)
					end
					screen(false)
				end)
			end)

		-- Stats
		local totals = S.totals or {}
		local _, rows = card(body, 21, "📊 TOTAL DES SANCTIONS", Color3.fromRGB(120, 200, 255))
		statLine(rows, 1, "Toutes raisons", tostring(totals.all or 0), C.TEXT_WHITE)
		for i, rid in ipairs(RORDER) do
			local n = totals[rid] or 0
			statLine(rows, 1 + i, RLBL[rid], tostring(n), n > 0 and RCOL[rid] or C.TEXT_DIM)
		end
		local sess = S.session or {}
		statLine(rows, 50, "── Sur ce serveur ──", "", C.TEXT_DIM)
		statLine(rows, 51, "Depuis le démarrage", tostring(sess.all or 0), C.TEXT_GREY)
		statLine(rows, 52, "📦 Anciens bans importés", tostring(totals.imported or 0), C.TEXT_GREY)

		-- 📦 Ré-import manuel
		sectionLabel(body, 30, "MAINTENANCE")
		noteCard(body, 31, "Tes anciens systèmes (anti-cheat, UGC, ancien panel) écrivaient directement dans "
			.. "`BannedPlayers` sans passer par ce journal. L'import les réinjecte avec leur vraie date. "
			.. "Il tourne automatiquement une fois ; ce bouton permet de le relancer si besoin "
			.. "(sans doublons).", C.TEXT_DIM)
		bigBtn(body, 32, "📦 Ré-importer les anciens bans", C.BG_LIGHT, C.BORDER_BRIGHT, true, function()
			toast("Import lancé, ça peut prendre 1 à 2 minutes…", true)
			callServer("importlegacy", {}, function()
				S.entries, S.cursor, S.hasMore = {}, nil, false
				S.logLoaded = false
			end)
		end)
	end

	----------------------------------------------------------------------
	-- 📵 ONGLET APPAREILS  (✨ NOUVEAU)
	----------------------------------------------------------------------
	local function deviceState(rec)
		local now = os.time()
		if rec.st == "pending" then
			return "pending", "⏳ EN ATTENTE", PENDING_COL
		elseif rec.st == "active" and (rec.exAt or 0) > now then
			return "active", "📵 BLOQUÉ", DEVICE_COL
		else
			return "expired", "⌛ EXPIRÉ", C.TEXT_DIM
		end
	end

	local function deviceRow(parent, order, rec)
		local uid   = tonumber(rec.userId) or 0
		local uname = unameCache[uid] or rec.n or tostring(uid)
		local state, badgeTxt, col = deviceState(rec)

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, col, state == "expired" and 1 or 1.5)
		padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = box

		-- Ligne 1 : avatar + nom + badge
		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local avS = IS_MOBILE and 30 or 36
		local av = makeAvatar(head, uid, avS, col)
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 0, 0.5, 0)

		local bdW = IS_MOBILE and 74 or 92
		label(head, {
			text = esc(rec.n or uname) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -avS - bdW - 16, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 1 or 2),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13,
		})
		label(head, {
			text = "@" .. uname .. "  ·  " .. tostring(rec.userId),
			size = UDim2.new(1, -avS - bdW - 16, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13,
		})

		local badge = Instance.new("TextLabel")
		badge.AnchorPoint = Vector2.new(1, 0.5)
		badge.Position = UDim2.new(1, 0, 0.5, 0)
		badge.Size = UDim2.new(0, bdW, 0, IS_MOBILE and 20 or 24)
		badge.BackgroundColor3 = col
		badge.BorderSizePixel = 0
		badge.Font = FONT
		badge.Text = badgeTxt
		badge.TextColor3 = (state == "expired") and C.TEXT_WHITE or C.BG_BLACK
		badge.TextSize = IS_MOBILE and 9 or 11
		badge.ZIndex = 13
		badge.Parent = head
		corner(badge, 5)

		-- Ligne 2 : détail
		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1, 0, 0, 0)
		info.AutomaticSize = Enum.AutomaticSize.Y
		info.BackgroundColor3 = C.BG_ITEM
		info.BackgroundTransparency = 0.35
		info.BorderSizePixel = 0
		info.Font = FONT
		info.TextColor3 = C.TEXT_GREY
		info.TextSize = IS_MOBILE and 9 or 11
		info.TextWrapped = true
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.LayoutOrder = 2
		info.ZIndex = 12
		info.Parent = box
		corner(info, 7)
		local ip = Instance.new("UIPadding")
		ip.PaddingTop = UDim.new(0, 6); ip.PaddingBottom = UDim.new(0, 6)
		ip.PaddingLeft = UDim.new(0, 8); ip.PaddingRight = UDim.new(0, 8)
		ip.Parent = info

		local lines = {}
		if state == "pending" then
			table.insert(lines, "⏳ En attente depuis " .. fmtAgo(rec.qAt))
			table.insert(lines, "Sera appliqué à la SECONDE où le joueur rejoint : compte banni "
				.. fmtDur(rec.dur) .. " + appareil bloqué 24 h.")
		elseif state == "active" then
			table.insert(lines, "📵 Appareil bloqué — expire " .. fmtUntil(rec.exAt))
			table.insert(lines, "Appliqué " .. fmtAgo(rec.aAt) .. "  ·  compte banni " .. fmtDur(rec.dur))
			if rec.qAt and rec.aAt and rec.aAt > rec.qAt + 60 then
				table.insert(lines, "A patienté " .. fmtDur(rec.aAt - rec.qAt) .. " avant de rejoindre.")
			end
		else
			table.insert(lines, "⌛ Blocage d'appareil terminé (" .. fmtAgo(rec.exAt) .. ")")
			table.insert(lines, "Le compte reste banni " .. fmtDur(rec.dur) .. " — seul le PC est libéré.")
		end
		if rec.dt and rec.dt ~= "" then table.insert(lines, "📝 " .. tostring(rec.dt)) end
		if rec.by then table.insert(lines, "👮 Par " .. tostring(rec.by)) end
		info.Text = table.concat(lines, "\n")

		-- Ligne 3 : actions
		local acts = Instance.new("Frame")
		acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		acts.BackgroundTransparency = 1
		acts.LayoutOrder = 3; acts.ZIndex = 12; acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local function act(o, text, colB, colD, danger, fn)
			local wrap = Instance.new("Frame")
			wrap.LayoutOrder = o; wrap.BackgroundTransparency = 1; wrap.ZIndex = 12; wrap.Parent = acts
			local b, lbl = actionButton(wrap, { color = colB, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
			local armed = false
			b.MouseButton1Click:Connect(function()
				if danger and not armed then
					armed = true; lbl.Text = "⚠️ ok ?"
					task.delay(3, function()
						if lbl and lbl.Parent then armed = false; lbl.Text = text end
					end)
					return
				end
				armed = false; lbl.Text = text
				fn()
			end)
		end

		act(1, IS_MOBILE and "👤" or "👤 Profil", C.PURPLE, C.PURPLE_DARK, false, function()
			openProfileDetail(uname, function() screen(false) end)
		end)

		if state == "pending" then
			act(2, IS_MOBILE and "✕" or "✕ Annuler", C.BG_LIGHT, C.BORDER_BRIGHT, true, function()
				callServer("devicecancel", { target = tostring(uid) }, function()
					S.devLoaded = false; screen(false)
				end)
			end)
			act(3, IS_MOBILE and "🔨" or "🔨 Ban simple", C.RED, C.RED_DARK, true, function()
				callServer("ban", {
					target = tostring(uid), duration = rec.dur or -1,
					deviceBlock = false, reason = "admin",
					details = "Ban simple (device ban en attente abandonné)",
					displayMsg = "You have been banned by a moderator.",
				}, function()
					callServer("devicecancel", { target = tostring(uid) }, function()
						S.devLoaded = false; screen(false)
					end)
				end)
			end)
		else
			act(2, IS_MOBILE and "✅" or "✅ Débannir", C.GREEN, C.GREEN_DARK, true, function()
				callServer("unban", { target = tostring(uid) }, function()
					S.devLoaded = false; screen(false)
				end)
			end)
			act(3, IS_MOBILE and "🗑️" or "🗑️ Retirer", C.BG_LIGHT, C.BORDER_BRIGHT, true, function()
				callServer("devicecancel", { target = tostring(uid) }, function()
					S.devLoaded = false; screen(false)
				end)
			end)
		end

		return box
	end

	local function renderDevices(body)
		noteCard(body, 0,
			"Roblox ne peut bloquer un appareil QUE si le joueur est connecté au moment du ban.\n"
				.. "• Joueur EN LIGNE → ban + blocage immédiats.\n"
				.. "• Joueur HORS LIGNE → la demande est mise en attente ici, et appliquée à la seconde "
				.. "où il rejoint (il ne joue pas une seconde).\n"
				.. "Blocage = 24 h max, PC Windows/macOS uniquement. Un débannissement le lève aussitôt.",
			DEVICE_COL)

		local pending, active, expired = 0, 0, 0
		local now = os.time()
		for _, rec in ipairs(S.devEntries) do
			if rec.st == "pending" then pending = pending + 1
			elseif rec.st == "active" and (rec.exAt or 0) > now then active = active + 1
			else expired = expired + 1 end
		end

		acTabBar(body, 1, {
			{ id = "all",     label = "🌐 Tout" },
			{ id = "pending", label = "⏳ Attente" .. (pending > 0 and (" (" .. pending .. ")") or "") },
			{ id = "active",  label = "📵 Bloqué" .. (active > 0 and (" (" .. active .. ")") or "") },
			{ id = "expired", label = "⌛ Expiré" },
		}, S.devFilter, DEVICE_COL, function(id) S.devFilter = id; screen(false) end)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 2; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 3; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		if not getDev then
			cLbl.Text = "❌ Serveur pas à jour (AdminGetDeviceBans manquant)."
			return
		end

		local list = {}
		for _, rec in ipairs(S.devEntries) do
			local state = select(1, deviceState(rec))
			if S.devFilter == "all" or S.devFilter == state then
				table.insert(list, rec)
			end
		end

		cLbl.Text = string.format("%d affiché(s)  •  %d en attente  •  %d bloqué(s)  •  %d expiré(s)",
			#list, pending, active, expired)

		if #list == 0 then
			local msg
			if S.devLoading then msg = "Chargement du registre..."
			elseif #S.devEntries == 0 then msg = "✅ Aucun appareil bloqué ni en attente."
			else msg = "Rien ne correspond à ce filtre." end
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
			label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			return
		end

		for i, rec in ipairs(list) do
			deviceRow(holder, i, rec)
		end
	end

	----------------------------------------------------------------------
	-- 📜 ONGLET JOURNAL
	----------------------------------------------------------------------
	local function journalCard(parent, order, e)
		local uid   = tonumber(e.u) or 0
		local uname = unameCache[uid] or e.n or tostring(uid)
		local disp  = e.d or e.n or uname
		local rid   = RLBL[e.r] and e.r or "other"
		local col   = RCOL[rid]

		local badgeTxt, badgeCol, strokeCol
		if e.a == "unban" then
			badgeTxt, badgeCol, strokeCol = "✅ UNBAN", C.GREEN, C.GREEN
		elseif e.a == "kick" then
			badgeTxt, badgeCol, strokeCol = "👟 KICK", C.ORANGE, col
		elseif e.a == "queue" then
			badgeTxt, badgeCol, strokeCol = "⏳ FILE", PENDING_COL, PENDING_COL
		elseif e.a == "cancel" then
			badgeTxt, badgeCol, strokeCol = "✕ ANNULÉ", C.BG_LIGHT, C.BORDER_SUBTLE
		else
			badgeTxt, badgeCol, strokeCol = (e.db and "📵 BAN" or "🔨 BAN"),
			(e.db and DEVICE_DARK or C.RED), (e.db and DEVICE_COL or col)
		end

		local H = IS_MOBILE and 72 or 86
		local c = Instance.new("TextButton")
		c.Size = UDim2.new(1, 0, 0, H)
		c.BackgroundColor3 = C.BG_DARK
		c.AutoButtonColor = false
		c.Text = ""
		c.BorderSizePixel = 0
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		corner(c, 10)
		local cs = stroke(c, strokeCol, 1)

		local avS = H - 24
		local av = makeAvatar(c, uid, avS)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, 8, 0.5, 0)

		local tx  = 8 + avS + 10
		local bdW = IS_MOBILE and 66 or 84

		label(c, {
			text = esc(disp) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -tx - bdW - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 7 or 10),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12,
		})

		local badge = Instance.new("TextLabel")
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, -8, 0, IS_MOBILE and 7 or 10)
		badge.Size = UDim2.new(0, bdW, 0, IS_MOBILE and 16 or 19)
		badge.BackgroundColor3 = badgeCol
		badge.BorderSizePixel = 0
		badge.Font = FONT
		badge.Text = badgeTxt
		badge.TextColor3 = C.TEXT_WHITE
		badge.TextSize = IS_MOBILE and 9 or 11
		badge.ZIndex = 12
		badge.Parent = c
		corner(badge, 5)

		label(c, {
			text = "@" .. uname .. "  •  " .. RLBL[rid] .. (e.lg and "  •  📦 importé" or ""),
			size = UDim2.new(1, -tx - 12, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 25 or 32),
			xAlign = Enum.TextXAlignment.Left, color = col,
			textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 12,
		})

		local extra = fmtWhen(e)
		if e.ag then extra = extra .. "  ·  compte de " .. tostring(e.ag) .. " j" end
		if e.a == "ban" or e.a == "queue" then extra = extra .. "  ·  " .. fmtDur(e.du) end
		if e.db then extra = extra .. "  ·  📵 appareil bloqué" end
		if e.dq then extra = extra .. "  ·  ⏳ appareil en attente" end
		if e.by and e.by ~= "system" then extra = extra .. "  ·  par " .. tostring(e.by) end

		local det = tostring(e.dt or "")
		if det ~= "" then det = det .. "  —  " end

		label(c, {
			text = det .. extra,
			size = UDim2.new(1, -tx - 12, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 43 or 54),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12,
		})

		c.MouseEnter:Connect(function() c.BackgroundColor3 = C.BG_MEDIUM; cs.Color = ACCENT end)
		c.MouseLeave:Connect(function() c.BackgroundColor3 = C.BG_DARK; cs.Color = strokeCol end)
		c.MouseButton1Click:Connect(function()
			screenManage({
				userId = uid, displayName = disp, username = uname,
				sub = RLBL[rid] .. "  ·  " .. badgeTxt .. "  ·  " .. fmtWhen(e),
			}, function() screen(false) end)
		end)
	end

	local function journalVisible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs(S.entries) do
			local rid = RLBL[e.r] and e.r or "other"
			local okR
			if S.filter == "all" then okR = true
			elseif S.filter == "_device" then okR = (e.db == true or e.dq == true)
			elseif S.filter == "_legacy" then okR = (e.lg == true)
			else okR = (rid == S.filter) end

			local okQ = true
			if #q > 0 then
				local un = (unameCache[tonumber(e.u) or 0] or ""):lower()
				okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.d or ""):lower():find(q, 1, true) ~= nil)
					or (un:find(q, 1, true) ~= nil)
					or (tostring(e.dt or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.u) == q)
			end
			if okR and okQ then table.insert(out, e) end
		end
		-- Les entrées sans date partent en bas plutôt que de polluer le haut
		table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
		return out
	end

	local function renderJournal(body)
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 1; sw.ZIndex = 11; sw.Parent = body

		local sb = Instance.new("TextBox")
		sb.Size = UDim2.new(1, 0, 1, 0)
		sb.BackgroundColor3 = C.BG_DARK
		sb.BorderSizePixel = 0
		sb.Font = FONT
		sb.PlaceholderText = "🔍 Joueur, UserID ou détail..."
		sb.PlaceholderColor3 = C.TEXT_DIM
		sb.Text = S.search or ""
		sb.TextColor3 = C.TEXT_WHITE
		sb.TextSize = IS_MOBILE and 11 or 14
		sb.TextXAlignment = Enum.TextXAlignment.Left
		sb.ClearTextOnFocus = false
		sb.ZIndex = 12
		sb.Parent = sw
		corner(sb, 8); stroke(sb, C.BORDER_SUBTLE, 1)
		local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sb

		local strip = chipStrip(body, 2)
		local holder, countLbl, render

		chip(strip, 1, "🌐 Tout", S.filter == "all", ACCENT, function()
			S.filter = "all"; screen(false)
		end)
		chip(strip, 2, "📵 Appareil", S.filter == "_device", DEVICE_COL, function()
			S.filter = "_device"; screen(false)
		end)
		for i, rid in ipairs(RORDER) do
			chip(strip, i + 2, RLBL[rid], S.filter == rid, RCOL[rid], function()
				S.filter = rid; screen(false)
			end)
		end
		chip(strip, 900, "📦 Importés", S.filter == "_legacy", C.BG_LIGHT, function()
			S.filter = "_legacy"; screen(false)
		end)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 3; cf.ZIndex = 11; cf.Parent = body
		countLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 4; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end

			local list = journalVisible()
			local bans, devs = 0, 0
			for _, e in ipairs(S.entries) do
				if e.a == "ban" then bans = bans + 1 end
				if e.db or e.dq then devs = devs + 1 end
			end
			countLbl.Text = string.format("%d affiché(s)  •  %d chargé(s)  •  %d ban(s)  •  %d appareil",
				#list, #S.entries, bans, devs)

			if #list == 0 then
				local msg
				if S.loadingLog then msg = "Chargement du journal..."
				elseif not getLog then msg = "❌ BanManager pas installé côté serveur."
				elseif #S.entries == 0 then
					msg = "✅ Aucune sanction enregistrée.\n\nSi tu as déjà banni des joueurs avant, "
						.. "l'import automatique tourne 25 s après le démarrage du serveur — "
						.. "reviens dans une minute, ou lance-le à la main depuis ⚙️ Réglages."
				else msg = "Rien ne correspond à ces filtres." end

				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 80); f.BackgroundTransparency = 1
				f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
				label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			else
				for i, e in ipairs(list) do journalCard(holder, i, e) end
			end

			if S.hasMore then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = holder
				local mb, mlbl = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger plus", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					if not getLog or S.loadingLog then return end
					S.loadingLog = true
					mlbl.Text = "⏳ Chargement..."
					task.spawn(function()
						local ok, res = pcall(function() return getLog:InvokeServer(S.cursor, 30) end)
						S.loadingLog = false
						if ok and type(res) == "table" and res.throttled then
							toast("Trop rapide, réessaie dans 1 s", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
							return
						end
						if ok and type(res) == "table" then
							local ids = {}
							for _, e in ipairs(res.entries or {}) do
								table.insert(S.entries, e); table.insert(ids, e.u)
							end
							S.cursor  = res.cursor
							S.hasMore = res.hasMore == true
							resolveUsernames(ids, function()
								resolvePoints(ids, function()
									if holder and holder.Parent then render() end
								end)
							end)
						else
							toast("Chargement impossible", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
						end
					end)
				end)
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text; render()
		end)

		render()
	end

	----------------------------------------------------------------------
	-- 🔨 ONGLET BAN MANUEL
	----------------------------------------------------------------------
	local function renderManual(body)
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 1; sw.ZIndex = 11; sw.Parent = body

		local btnW = IS_MOBILE and 56 or 76
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.Size = UDim2.new(1, -btnW - 8, 1, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.Font = FONT
		box.PlaceholderText = "Pseudo ou UserID..."
		box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = S.mTarget or ""
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 12 or 15
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.ZIndex = 12
		box.Parent = sw
		corner(box, 9); stroke(box, C.BORDER_SUBTLE, 1)
		local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box
		box:GetPropertyChangedSignal("Text"):Connect(function() S.mTarget = box.Text end)

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, 0, 0.5, 0)
		gc.Size = UDim2.new(0, btnW, 1, 0)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 12; gc.Parent = sw

		local function callAction(act, extra)
			if not doAct then toast("Serveur pas à jour", false); return end
			local target = (S.mTarget or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if #target < 2 then toast("Entre un pseudo ou un UserID", false); return end

			local payload = {
				target      = target,
				duration    = S.mDuration,
				deviceBlock = S.mDevice,
				excludeAlts = S.mAlts,
				reason      = "admin",
				details     = (S.mDetails ~= "" and S.mDetails) or "Ban manuel via admin panel",
				displayMsg  = (S.mDetails ~= "" and S.mDetails) or "You have been banned by a moderator.",
			}
			if type(extra) == "table" then
				for k, v in pairs(extra) do payload[k] = v end
			end

			task.spawn(function()
				local ok, res = pcall(function() return doAct:InvokeServer(act, payload) end)
				if ok and type(res) == "table" then
					if act == "lookup" then
						S.lookup = res.ok and res or nil
						if not res.ok then toast(res.msg or "Introuvable", false) end
					else
						toast(res.msg or (res.ok and "OK" or "Échec"), res.ok == true)
						if res.ok then
							S.entries, S.cursor, S.hasMore = {}, nil, false
							S.logLoaded = false
							S.devLoaded = false
							S.lookup = nil
						end
					end
				else
					toast("Erreur de communication", false)
				end
				screen(false)
			end)
		end

		local gb = actionButton(gc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🔍", textSize = IS_MOBILE and 14 or 17, radius = 9, zIndex = 12 })
		gb.MouseButton1Click:Connect(function() callAction("lookup") end)
		box.FocusLost:Connect(function(enter) if enter then callAction("lookup") end end)

		-- Résultat de la recherche
		if S.lookup then
			local lk = S.lookup
			local rec = lk.record
			local active = rec and rec.active
			local _, rows = card(body, 2, "👤 " .. tostring(lk.name), active and C.RED or C.GREEN)
			statLine(rows, 1, "UserID", tostring(lk.userId), C.TEXT_WHITE)
			statLine(rows, 2, "En ligne", lk.online and "🟢 oui" or "⚪ non", lk.online and C.GREEN or C.TEXT_DIM)
			if lk.accountAge then
				statLine(rows, 3, "Âge du compte", tostring(lk.accountAge) .. " j",
					(S.cfg and lk.accountAge < (S.cfg.naMinDays or 7)) and C.ORANGE or C.TEXT_WHITE)
			end
			if active then
				statLine(rows, 4, "Statut", "🚫 BANNI", C.RED)
				statLine(rows, 5, "Raison", RLBL[rec.r] or tostring(rec.r), RCOL[rec.r] or C.TEXT_WHITE)
				statLine(rows, 6, "Détails", tostring(rec.dt or "—"), C.TEXT_GREY)
				statLine(rows, 7, "Depuis", fmtAgo(rec.t), C.TEXT_GREY)
				statLine(rows, 8, "Expire", fmtUntil(rec.ex), C.TEXT_WHITE)
				statLine(rows, 9, "Appareil bloqué", rec.db and "📵 oui" or "non", rec.db and C.ORANGE or C.TEXT_DIM)
				statLine(rows, 10, "Par", tostring(rec.by or "?"), C.TEXT_GREY)
			elseif lk.legacy then
				statLine(rows, 4, "Statut", "🚫 BANNI (fiche héritée)", C.RED)
				statLine(rows, 5, "Raison", tostring(lk.legacy), C.TEXT_GREY)
			else
				statLine(rows, 4, "Statut", "✅ pas de ban actif", C.GREEN)
			end

			-- 📵 État appareil
			if lk.device then
				local st, txt = deviceState(lk.device)
				statLine(rows, 20, "── 📵 Appareil ──", "", C.TEXT_DIM)
				statLine(rows, 21, "État", txt, st == "pending" and PENDING_COL or DEVICE_COL)
				if st == "pending" then
					statLine(rows, 22, "En attente depuis", fmtAgo(lk.device.qAt), C.TEXT_GREY)
				elseif st == "active" then
					statLine(rows, 22, "Blocage expire", fmtUntil(lk.device.exAt), C.TEXT_WHITE)
				end
			end
		end

		sectionLabel(body, 10, "DURÉE DU BAN")
		acTabBar(body, 11, DURATIONS, S.mDuration, ACCENT, function(id)
			S.mDuration = id; screen(false)
		end)

		sectionLabel(body, 12, "OU DURÉE PERSONNALISÉE (EN JOURS)")
		stepperRow(body, 13, durToDays(S.mDuration), 1, 3650, "jour(s)", function(v)
			S.mDuration = v * 86400; screen(false)
		end)

		toggleRow(body, 14, "📵 Bloquer l'appareil", S.mDevice,
			function(v) S.mDevice = v; screen(false) end)

		if S.mDevice then
			local online = S.lookup and S.lookup.online
			if S.lookup and not online then
				noteCard(body, 15, "⏳ Ce joueur est HORS LIGNE : la demande sera mise en attente et "
					.. "appliquée dès qu'il rejoint (compte banni + PC bloqué 24 h). "
					.. "Tu la retrouveras dans l'onglet 📵 Appareils.", PENDING_COL)
			elseif online then
				noteCard(body, 15, "📵 Ce joueur est EN LIGNE : le ban et le blocage d'appareil "
					.. "partent immédiatement.", DEVICE_COL)
			else
				noteCard(body, 15, "📵 Si le joueur est en ligne → blocage immédiat. S'il est hors ligne → "
					.. "mise en attente automatique, appliquée à son prochain join.", DEVICE_COL)
			end
		end

		toggleRow(body, 16, "👥 Épargner les comptes alternatifs", S.mAlts,
			function(v) S.mAlts = v; screen(false) end)

		sectionLabel(body, 17, "RAISON AFFICHÉE AU JOUEUR")
		local rb = Instance.new("TextBox")
		rb.LayoutOrder = 18
		rb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		rb.BackgroundColor3 = C.BG_DARK
		rb.BorderSizePixel = 0
		rb.Font = FONT
		rb.PlaceholderText = "Ex: Exploiting — permanent ban"
		rb.PlaceholderColor3 = C.TEXT_DIM
		rb.Text = S.mDetails or ""
		rb.TextColor3 = C.TEXT_WHITE
		rb.TextSize = IS_MOBILE and 11 or 14
		rb.TextXAlignment = Enum.TextXAlignment.Left
		rb.ClearTextOnFocus = false
		rb.ZIndex = 11
		rb.Parent = body
		corner(rb, 8); stroke(rb, C.BORDER_SUBTLE, 1)
		local rp = Instance.new("UIPadding"); rp.PaddingLeft = UDim.new(0, 10); rp.Parent = rb
		rb:GetPropertyChangedSignal("Text"):Connect(function() S.mDetails = rb.Text end)

		bigBtn(body, 20, "🔨 BANNIR", C.RED, C.RED_DARK, true, function() callAction("ban") end)
		bigBtn(body, 21, "📵 METTRE UN DEVICE BAN EN ATTENTE", DEVICE_DARK, DEVICE_COL, true, function()
			callAction("devicequeue")
		end)
		bigBtn(body, 22, "👟 KICK (joueur en ligne)", C.ORANGE, C.ORANGE_DARK, false, function() callAction("kick") end)
		bigBtn(body, 23, "✅ DÉBANNIR", C.GREEN, C.GREEN_DARK, true, function() callAction("unban") end)

		noteCard(body, 24, "Le débannissement retire le ban Roblox, la fiche interne, la fiche héritée "
			.. "(BannedPlayers), lève le blocage d'appareil ET annule une demande en attente.", C.TEXT_DIM)
	end

	----------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "bans"

		if reset then
			S.entries, S.cursor, S.hasMore = {}, nil, false
			S.logLoaded = false
			S.cfgFailed = false
			S.lookup    = nil
			S.devLoaded = false
		end

		local body = buildScreen("🚫 GESTION DES BANS", true, ACCENT, nil, function()
			S.cfg = nil
			screen(true)
		end)

		acTabBar(body, 0, {
			{ id = "cfg",    label = "⚙️ Réglages" },
			{ id = "log",    label = "📜 Journal" },
			{ id = "device", label = "📵 Appareils"
				.. ((S.devCount.pending or 0) > 0 and (" (" .. S.devCount.pending .. ")") or "") },
			{ id = "manual", label = "🔨 Manuel" },
		}, S.tab, ACCENT, function(id) S.tab = id; screen(false) end)

		local function refreshIfStillHere(tab)
			if currentScreen == "bans" and window.Visible and S.tab == tab then
				screen(false)
			end
		end

		-- Config : une seule tentative automatique, ensuite c'est le bouton 🔄
		if not S.cfg and getCfg and not S.loadingCfg and not S.cfgFailed then
			S.loadingCfg = true
			task.spawn(function()
				local ok, res = pcall(function() return getCfg:InvokeServer() end)
				S.loadingCfg = false
				if ok and type(res) == "table" and type(res.config) == "table" then
					S.cfg     = res.config
					S.totals  = res.totals
					S.session = res.session
					S.devOk   = res.deviceBlockSupported ~= false
					S.dirty   = false
					S.devCount.pending = res.devicePending or 0
					S.devCount.active  = res.deviceActive or 0
					if S.mDuration == -1 and res.config.adDuration then
						S.mDuration = res.config.adDuration
					end
					S.mDevice = res.config.adDeviceBlock == true
				else
					S.cfgFailed = true
				end
				refreshIfStillHere("cfg")
			end)
		end

		if S.tab == "cfg" then
			renderSettings(body)

		elseif S.tab == "manual" then
			renderManual(body)

		elseif S.tab == "device" then
			if not S.devLoaded and getDev and not S.devLoading then
				S.devLoading = true
				task.spawn(function()
					local ok, res = pcall(function() return getDev:InvokeServer(true) end)
					S.devLoading = false
					if ok and type(res) == "table" and res.throttled then
						task.wait(1.5)
						refreshIfStillHere("device")
						return
					end
					S.devLoaded = true
					if ok and type(res) == "table" then
						S.devEntries = res.entries or {}
						S.devOk = res.deviceBlockSupported ~= false
						local ids = {}
						for _, e in ipairs(S.devEntries) do table.insert(ids, e.userId) end
						resolveUsernames(ids, function()
							resolvePoints(ids, function() refreshIfStillHere("device") end)
						end)
					else
						refreshIfStillHere("device")
					end
				end)
			end
			renderDevices(body)

		else
			-- Journal : UNE seule tentative automatique, pilotée par S.logLoaded
			if not S.logLoaded and getLog and not S.loadingLog then
				S.loadingLog = true
				task.spawn(function()
					local ok, res = pcall(function() return getLog:InvokeServer(nil, 30) end)
					S.loadingLog = false
					if ok and type(res) == "table" and res.throttled then
						task.wait(1.5)
						refreshIfStillHere("log")
						return
					end
					S.logLoaded = true
					if ok and type(res) == "table" then
						S.entries = res.entries or {}
						S.cursor  = res.cursor
						S.hasMore = res.hasMore == true
						local ids = {}
						for _, e in ipairs(S.entries) do table.insert(ids, e.u) end
						resolveUsernames(ids, function()
							resolvePoints(ids, function() refreshIfStillHere("log") end)
						end)
					else
						refreshIfStillHere("log")
					end
				end)
			end
			renderJournal(body)
		end
	end

	----------------------------------------------------------------------
	-- 📵 CARTE "DEVICE BAN" — injectée dans TOUS les profils et fiches joueur
	----------------------------------------------------------------------
	local function deviceBanCard(parent, order, userId, username, isOnline)
		local host, rows = card(parent, order, "📵 DEVICE BAN — blocage d'appareil", DEVICE_COL)

		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1, 0, 0, 0)
		info.AutomaticSize = Enum.AutomaticSize.Y
		info.BackgroundTransparency = 1
		info.Font = FONT
		info.Text = isOnline
			and "🟢 Joueur EN LIGNE : le ban et le blocage d'appareil partent immédiatement. "
			.. "24 h de blocage (limite Roblox), PC Windows/macOS uniquement."
			or  "⚪ Joueur HORS LIGNE : la demande est MISE EN ATTENTE et appliquée à la seconde où il "
			.. "rejoint. Roblox ne peut pas bloquer un appareil absent — c'est la seule méthode qui marche."
		info.TextColor3 = isOnline and C.TEXT_GREY or PENDING_COL
		info.TextSize = IS_MOBILE and 9 or 11
		info.TextWrapped = true
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.LayoutOrder = 1
		info.ZIndex = 13
		info.Parent = rows

		-- Ligne d'état, remplie dès que le serveur répond
		local statusRow = statLine(rows, 2, "État actuel", "…", C.TEXT_DIM)

		local grid = Instance.new("Frame")
		grid.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		grid.BackgroundTransparency = 1
		grid.LayoutOrder = 3
		grid.ZIndex = 13
		grid.Parent = rows
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = grid

		local function refreshStatus()
			if not doAct then return end
			task.spawn(function()
				local ok, res = pcall(function()
					return doAct:InvokeServer("devicestatus", { target = tostring(userId) })
				end)
				if not (ok and type(res) == "table" and res.ok) then return end
				if not (statusRow and statusRow.Parent) then return end

				local lbls = statusRow:GetChildren()
				local valueLbl
				for _, ch in ipairs(lbls) do
					if ch:IsA("TextLabel") and ch.TextXAlignment == Enum.TextXAlignment.Right then
						valueLbl = ch
					end
				end
				if not valueLbl then return end

				if res.device then
					local st, txt, col = deviceState(res.device)
					if st == "pending" then
						valueLbl.Text = txt .. " (" .. fmtAgo(res.device.qAt) .. ")"
					elseif st == "active" then
						valueLbl.Text = txt .. " — expire " .. fmtUntil(res.device.exAt)
					else
						valueLbl.Text = txt
					end
					valueLbl.TextColor3 = col
				else
					valueLbl.Text = "aucun"
					valueLbl.TextColor3 = C.GREEN
				end
			end)
		end
		refreshStatus()

		local function opt(o, text, dur)
			local c = Instance.new("Frame")
			c.LayoutOrder = o
			c.BackgroundTransparency = 1
			c.ZIndex = 13
			c.Parent = grid

			local b, lbl = actionButton(c, {
				color = isOnline and DEVICE_DARK or PENDING_COL,
				strokeColor = isOnline and DEVICE_COL or C.ORANGE_DARK,
				text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13,
			})

			local armed = false
			b.MouseButton1Click:Connect(function()
				if not armed then
					armed = true
					lbl.Text = "⚠️ Confirmer"
					task.delay(3, function()
						if lbl and lbl.Parent then armed = false; lbl.Text = text end
					end)
					return
				end
				armed = false; lbl.Text = text

				-- Le serveur décide tout seul : en ligne → immédiat, hors ligne → file d'attente.
				callServer("ban", {
					target      = tostring(userId),
					duration    = dur,
					deviceBlock = true,
					reason      = "admin",
					details     = "Device ban via admin panel (" .. fmtDur(dur) .. ")",
					displayMsg  = "You have been banned. Your device is blocked for 24 hours.",
				}, function(res)
					if res and res.ok then
						S.entries, S.cursor, S.hasMore = {}, nil, false
						S.logLoaded = false
						S.devLoaded = false
					end
					refreshStatus()
				end)
			end)
		end

		local prefix = isOnline and "📵 " or "⏳ "
		opt(1, prefix .. "24 h",    86400)
		opt(2, prefix .. "7 j",     7 * 86400)
		opt(3, prefix .. "♾️ Perm", -1)

		-- Bouton d'annulation (utile si une demande traîne)
		local cancelWrap = Instance.new("Frame")
		cancelWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 32)
		cancelWrap.BackgroundTransparency = 1
		cancelWrap.LayoutOrder = 4
		cancelWrap.ZIndex = 13
		cancelWrap.Parent = rows
		local cb, clbl = actionButton(cancelWrap, {
			color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "✕ Annuler / retirer la fiche appareil",
			textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13,
		})
		local armedC = false
		cb.MouseButton1Click:Connect(function()
			if not armedC then
				armedC = true
				clbl.Text = "⚠️ Confirmer"
				task.delay(3, function()
					if clbl and clbl.Parent then armedC = false
						clbl.Text = "✕ Annuler / retirer la fiche appareil" end
				end)
				return
			end
			armedC = false
			clbl.Text = "✕ Annuler / retirer la fiche appareil"
			callServer("devicecancel", { target = tostring(userId) }, function()
				S.devLoaded = false
				refreshStatus()
			end)
		end)

		return host
	end

	-- 👤 Tous les profils (écran PROFILE) reçoivent la carte automatiquement
	local previousRenderProfile = renderProfile
	renderProfile = function(body, profile)
		previousRenderProfile(body, profile)
		if type(profile) == "table" and not profile.error and profile.userId then
			deviceBanCard(body, 22, profile.userId,
				profile.username or profile.name, profile.isOnline == true)
		end
	end

	-- 👤 Toutes les fiches "MANAGE PLAYER" la reçoivent aussi
	local previousScreenManage = screenManage
	screenManage = function(info, backFn)
		previousScreenManage(info, backFn)
		if type(info) ~= "table" or not info.userId then return end
		local body = window:FindFirstChildOfClass("ScrollingFrame")
		if not body then return end
		deviceBanCard(body, 500, info.userId,
			info.username or tostring(info.userId),
			Players:GetPlayerByUserId(info.userId) ~= nil)
	end

	----------------------------------------------------------------------
	-- 🔗 AUTO-ENREGISTREMENT DANS LE MENU
	----------------------------------------------------------------------
	table.insert(ACTIONS, { id = "bans", name = "🚫 BANS", color = ACCENT })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "bans" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()


--════════════════════════════════════════════════════════════════════════════
-- 🎁 BLOC 2 — SECTION GIFT LOG   ⟦ v2 — TOUS LES TYPES DE GIFT ⟧
--
--  ⚠️ CE BLOC REMPLACE INTÉGRALEMENT TON ANCIEN BLOC 2.
--     Supprime l'IIFE qui commence par :
--         ;(function()
--             local GOLD   = Color3.fromRGB(255, 205, 60)
--             local GIFT   = Color3.fromRGB(255, 140, 200)
--     ...jusqu'à son `end)()`, et colle celui-ci à la place (même endroit,
--     entre le bloc 1 🚫 BANS et le bloc 3 🔐 ESCROW).
--
--  Ce qui change :
--     • Le fil affiche l'ICÔNE et le NOM de ce qui a été offert — plus
--       seulement un montant de points. Une arme, un VIP, un boost x25 de
--       30 min : chacun a sa tête et sa couleur.
--     • Nouvelle rangée de filtres PAR TYPE (points / boosts / VIP / armes /
--       spins), en plus des filtres par statut.
--     • Les statuts « 📦 En attente » et « ✅ Livré » sont enfin reconnus
--       (avant, tout s'affichait en gris « ? »).
--     • La carte 🎁 GIFTS d'un profil détaille CE QU'IL A OFFERT ET REÇU
--       PAR TYPE, et l'historique montre l'objet, pas juste des points.
--     • Le message personnalisé écrit par le joueur s'affiche tel quel.
--
--  Prérequis serveur : GiftLog_Server.lua (v2) dans ServerScriptService.
--════════════════════════════════════════════════════════════════════════════

;(function()
	local GOLD   = Color3.fromRGB(255, 205, 60)
	local GIFT   = Color3.fromRGB(255, 140, 200)
	local GIFT_D = Color3.fromRGB(150, 50, 105)
	local RECV   = Color3.fromRGB(120, 220, 255)

	local getLog    = ReplicatedStorage:WaitForChild("AdminGetGiftLog", 10)
	local getPlayer = ReplicatedStorage:WaitForChild("AdminGetGiftPlayer", 10)
	local getTop    = ReplicatedStorage:WaitForChild("AdminGetGiftTop", 10)
	local doAct     = ReplicatedStorage:WaitForChild("AdminGiftAction", 10)

	if not getLog then
		warn("[Admin] AdminGetGiftLog introuvable → ajoute GiftLog_Server.lua (v2) "
			.. "dans ServerScriptService")
	end

	-- Config des gifts : sert de repli pour l'icône et le libellé quand une
	-- vieille ligne du journal n'en a pas (fiches d'avant la v2).
	local GCFG
	pcall(function()
		local m = ReplicatedStorage:WaitForChild("GIFT_CONFIG", 8)
		if m then GCFG = require(m) end
	end)

	----------------------------------------------------------------------
	-- 🎨 LES SIX TYPES
	----------------------------------------------------------------------
	local K = {
		points     = { l = "Points",         tag = "POINTS", c = GOLD,                        e = "💎" },
		boost_temp = { l = "Boost temporaire",tag = "TEMP",  c = Color3.fromRGB(255, 165, 60), e = "⏱️" },
		boost_perm = { l = "Boost permanent", tag = "PERM",  c = Color3.fromRGB(180, 130, 255),e = "♾️" },
		vip        = { l = "VIP",             tag = "VIP",   c = Color3.fromRGB(255, 225, 120),e = "👑" },
		weapon     = { l = "Arme PVP",        tag = "GUN",   c = Color3.fromRGB(255, 110, 110),e = "🔫" },
		spins      = { l = "Spins",           tag = "SPINS", c = Color3.fromRGB(140, 235, 190),e = "🎡" },
	}
	local K_ORDER = { "points", "boost_temp", "boost_perm", "vip", "weapon", "spins" }

	--  Type d'une entrée. Les lignes écrites AVANT que les autres types
	--  existent n'ont pas de champ `k` : à l'époque un gift ne pouvait être
	--  que des points, donc on les classe là plutôt que de les afficher en
	--  « ? » gris au milieu du fil.
	local function ek(e)
		local k = e and e.k
		if k == nil or k == "" then return "points" end
		return tostring(k)
	end

	local function kMeta(k)
		return K[tostring(k or "")] or
			{ l = tostring(k or "?"), tag = "?", c = C.TEXT_GREY, e = "🎁" }
	end

	----------------------------------------------------------------------
	-- 📬 LES STATUTS DE LIVRAISON
	--    « En attente » n'est PAS une erreur : un gift acheté pendant que le
	--    receveur est hors ligne l'attend dans sa file, et lui est remis à sa
	--    prochaine connexion. Il ne devient anormal que s'il traîne des jours
	--    alors que le joueur s'est reconnecté depuis.
	----------------------------------------------------------------------
	local ST = {
		QUEUED             = { l = "📦 En attente",          c = C.ORANGE,     g = "pending"  },
		CLAIMED            = { l = "✅ Livré",                c = C.GREEN,      g = "ok"       },
		DELIVERED          = { l = "✅ Livré direct",         c = C.GREEN,      g = "ok"       },
		IMPORTED           = { l = "📦 Importé",              c = C.TEXT_GREY,  g = "other"    },
		PENDING_OFFLINE    = { l = "📦 En attente",           c = C.ORANGE,     g = "pending"  },
		REQUEUED           = { l = "🔁 Remis en file",        c = C.ORANGE,     g = "pending"  },
		FALLBACK_NO_TICKET = { l = "⚠️ Sans ticket",          c = C.RED,        g = "fallback" },
		FALLBACK_OFFLINE   = { l = "⚠️ Repli hors ligne",     c = C.RED,        g = "fallback" },
	}
	local function stMeta(s)
		return ST[tostring(s or "")] or { l = tostring(s or "?"), c = C.TEXT_GREY, g = "other" }
	end

	local TOPS = {
		{ id = "sent_pts", label = "💎 Pts offerts", col = GIFT, unit = "points",
			note = "Somme des POINTS offerts (les autres types ne comptent pas ici)" },
		{ id = "sent_cnt", label = "🎁 Nb offerts",  col = GIFT, unit = "gifts",
			note = "Nombre de gifts offerts, TOUS TYPES confondus" },
		{ id = "recv_pts", label = "📥 Pts reçus",   col = RECV, unit = "points",
			note = "Somme des POINTS reçus" },
		{ id = "recv_cnt", label = "📬 Nb reçus",    col = RECV, unit = "gifts",
			note = "Nombre de gifts reçus, TOUS TYPES confondus" },
	}

	local S = {
		tab = "log",
		entries = {}, cursor = nil, hasMore = false,
		filter = "all",        -- statut / drapeaux
		kind = "all",          -- type de gift
		search = "",
		totals = nil, session = nil,
		loading = false, loaded = false,
		top = nil, topMetric = "sent_pts", topLoading = false,
	}

	local screen  -- fwd

	----------------------------------------------------------------------
	-- 🧱 PETITS COMPOSANTS
	----------------------------------------------------------------------
	local function msgText(e)
		if e.mt and e.mt ~= "" then return e.mt end
		if GCFG and GCFG.GetMessageText and e.m then
			local ok, t = pcall(function() return GCFG.GetMessageText(e.m) end)
			if ok and t then return t end
		end
		return nil
	end

	-- Icône de l'objet offert.
	--   1. celle enregistrée AVEC le gift (fiable même si tu retires le produit)
	--   2. sinon celle de GIFT_CONFIG pour ce produit
	--   3. sinon rien → on retombe sur l'emoji du type
	local function itemImage(e)
		local raw = e.ic
		if type(raw) == "string" and raw ~= "" then
			if raw:match("^rbxassetid://") then return raw end
			local digits = raw:match("(%d+)")
			if digits then return "rbxassetid://" .. digits end
		end
		if GCFG and GCFG.GetItem and e.pr and e.pr ~= 0 then
			local ok, item = pcall(function() return GCFG.GetItem(e.pr) end)
			if ok and type(item) == "table" and item.icon then return item.icon end
		end
		return nil
	end

	local function itemLabel(e)
		if e.lb and e.lb ~= "" then return e.lb end
		if GCFG and GCFG.GetItem and GCFG.GetDisplayName and e.pr and e.pr ~= 0 then
			local ok, item = pcall(function() return GCFG.GetItem(e.pr) end)
			if ok and type(item) == "table" then
				local ok2, n = pcall(function() return GCFG.GetDisplayName(item) end)
				if ok2 and n then return n end
			end
		end
		if (tonumber(e.p) or 0) > 0 then return fmtNum(e.p) .. " points" end
		return kMeta(ek(e)).l
	end

	local function fmtWhen(e)
		if e.unk or not e.t or e.t == 0 then return "📅 date inconnue" end
		return fmtAgo(e.t)
	end

	local function noteCard(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	-- Vignette carrée d'un objet : image si on l'a, sinon l'emoji du type.
	local function itemThumb(parent, e, size, z)
		local km = kMeta(ek(e))
		local img = itemImage(e)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(0, size, 0, size)
		holder.BackgroundColor3 = C.BG_ITEM
		holder.BackgroundTransparency = 0.45
		holder.BorderSizePixel = 0
		holder.ZIndex = z
		holder.Parent = parent
		corner(holder, math.floor(size * 0.22))
		stroke(holder, km.c, 1, 0.45)
		if img then
			local im = Instance.new("ImageLabel")
			im.Size = UDim2.new(1, -4, 1, -4)
			im.Position = UDim2.fromScale(0.5, 0.5)
			im.AnchorPoint = Vector2.new(0.5, 0.5)
			im.BackgroundTransparency = 1
			im.Image = img
			im.ScaleType = Enum.ScaleType.Fit
			im.ZIndex = z + 1
			im.Parent = holder
		else
			label(holder, { text = km.e, size = UDim2.fromScale(1, 1),
				color = km.c, textSize = math.floor(size * 0.55), zIndex = z + 1 })
		end
		return holder
	end

	----------------------------------------------------------------------
	--  Carte d'un gift — lecture immédiate, de gauche à droite :
	--
	--     ┌──────────────────────────────────────────────┐
	--     │  [pfp] Donneur   [🔫] ──▶   Receveur [pfp]   │
	--     │        @pseudo    GUN        @pseudo          │
	--     │  🔫 AK47 · ✅ Livré · il y a 3 h              │
	--     │  💬 « message » · 🆔 111 ➜ 222                │
	--     └──────────────────────────────────────────────┘
	--
	--  Moitié gauche → profil du donneur.  Moitié droite → profil du receveur.
	--  Le centre dit CE QUI a été offert : icône du produit + étiquette du
	--  type. Un gift de points garde son montant, les autres montrent leur
	--  objet — c'est tout ce qui change par rapport à avant.
	----------------------------------------------------------------------
	local function giftCard(parent, order, e, backFn)
		local su, ru = tonumber(e.su) or 0, tonumber(e.ru) or 0
		local sn = unameCache[su] or e.sn or tostring(su)
		local rn = unameCache[ru] or e.rn or tostring(ru)
		local meta = stMeta(e.st)
		local km   = kMeta(ek(e))
		local lbl  = itemLabel(e)
		local isPoints = (ek(e) == "points")

		local H    = (IS_MOBILE and 112 or 132) + economy.FOOTER_H
		local botH = IS_MOBILE and 32 or 38
		local topH = H - botH
		local avS  = IS_MOBILE and 34 or 44

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, H)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10)
		stroke(box, e.self and C.ORANGE or km.c, 1)

		-- ── Zone d'un joueur (gauche ou droite), cliquable ──
		local function side(isLeft, uid, disp, uname, ringCol, sub)
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(0.36, 0, 0, topH)
			btn.Position = UDim2.new(isLeft and 0 or 0.64, 0, 0, 0)
			btn.BackgroundColor3 = C.BG_ITEM
			btn.BackgroundTransparency = 0.82      -- affordance permanente
			btn.AutoButtonColor = false
			btn.BorderSizePixel = 0
			btn.Text = ""
			btn.ZIndex = 12
			btn.Parent = box
			btn:SetAttribute("AdminEconomyReservedHeight", economy.FOOTER_H)
			corner(btn, 8)
			local bs = stroke(btn, ringCol, 1, 1)   -- contour invisible au repos

			local av = makeAvatar(btn, uid, avS, ringCol)
			av.AnchorPoint = Vector2.new(isLeft and 0 or 1, 0.5)
			av.Position = UDim2.new(isLeft and 0 or 1, isLeft and 8 or -8, 0.5, 0)

			local tx = avS + 14
			local align = isLeft and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right

			local nameLbl = label(btn, {
				text = esc(disp),
				size = UDim2.new(1, -tx - 6, 0, IS_MOBILE and 16 or 20),
				position = UDim2.new(0, isLeft and tx or 6, 0, IS_MOBILE and 10 or 14),
				xAlign = align, color = C.TEXT_WHITE,
				textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13,
			})
			label(btn, {
				text = "@" .. uname,
				size = UDim2.new(1, -tx - 6, 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, isLeft and tx or 6, 0, IS_MOBILE and 27 or 35),
				xAlign = align, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13,
			})

			local hint = label(btn, {
				text = isLeft and "👤 voir le profil" or "voir le profil 👤",
				size = UDim2.new(1, -tx - 6, 0, IS_MOBILE and 12 or 14),
				position = UDim2.new(0, isLeft and tx or 6, 0, IS_MOBILE and 43 or 54),
				xAlign = align, color = ringCol,
				textSize = IS_MOBILE and 8 or 10, truncate = true, zIndex = 13,
			})
			hint.TextTransparency = 0.55

			btn.MouseEnter:Connect(function()
				btn.BackgroundTransparency = 0.4
				bs.Transparency = 0
				hint.TextTransparency = 0
				nameLbl.TextColor3 = ringCol
			end)
			btn.MouseLeave:Connect(function()
				btn.BackgroundTransparency = 0.82
				bs.Transparency = 1
				hint.TextTransparency = 0.55
				nameLbl.TextColor3 = C.TEXT_WHITE
			end)
			btn.MouseButton1Click:Connect(function()
				screenManage({ userId = uid, displayName = disp, username = uname, sub = sub }, backFn)
			end)
			return btn
		end

		side(true,  su, e.sd or sn, sn, GIFT,
			"🎁 A offert " .. lbl .. " à " .. rn)
		side(false, ru, e.rd or rn, rn, RECV,
			"📥 A reçu " .. lbl .. " de " .. sn)

		-- ── Milieu : CE QUI a été offert, puis la flèche ──
		local mid = Instance.new("Frame")
		mid.Size = UDim2.new(0.28, 0, 0, topH)
		mid.Position = UDim2.new(0.36, 0, 0, 0)
		mid.BackgroundTransparency = 1
		mid.ZIndex = 12
		mid.Parent = box

		local thumbS = IS_MOBILE and 26 or 32
		local th = itemThumb(mid, e, thumbS, 13)
		th.AnchorPoint = Vector2.new(0.5, 0)
		th.Position = UDim2.new(0.5, 0, 0, IS_MOBILE and 5 or 7)

		-- Sous la vignette : le montant pour les points, l'étiquette du type
		-- pour tout le reste. Deux gifts de types différents ne peuvent donc
		-- jamais être confondus au premier coup d'œil.
		label(mid, {
			text = isPoints and ("💎 " .. fmtNum(e.p or 0)) or km.tag,
			size = UDim2.new(1, -4, 0, IS_MOBILE and 16 or 19),
			position = UDim2.new(0.5, 0, 0, IS_MOBILE and 34 or 42),
			anchor = Vector2.new(0.5, 0),
			color = isPoints and GOLD or km.c,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13,
		})

		-- La flèche : un trait + une pointe
		local lineY = IS_MOBILE and 0.82 or 0.80
		local line = Instance.new("Frame")
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Position = UDim2.new(0.5, -3, lineY, 0)
		line.Size = UDim2.new(1, -22, 0, 2)
		line.BackgroundColor3 = e.self and C.ORANGE or km.c
		line.BorderSizePixel = 0
		line.ZIndex = 13
		line.Parent = mid

		label(mid, {
			text = "▶",
			size = UDim2.new(0, 14, 0, 14),
			position = UDim2.new(1, -5, lineY, 0), anchor = Vector2.new(1, 0.5),
			color = e.self and C.ORANGE or km.c,
			textSize = IS_MOBILE and 11 or 13, zIndex = 13,
		})

		-- ── Bas : le nom exact de l'objet, le statut, puis le message ──
		local bot = Instance.new("Frame")
		bot.Size = UDim2.new(1, -16, 0, botH)
		bot.Position = UDim2.new(0, 8, 0, topH)
		bot.BackgroundTransparency = 1
		bot.ZIndex = 12
		bot.Parent = box

		local l1 = km.e .. " " .. lbl .. "  ·  " .. meta.l .. "  ·  " .. fmtWhen(e)
		if e.g    then l1 = l1 .. "  ·  🌍 annoncé" end
		if e.self then l1 = l1 .. "  ·  🪞 auto-gift" end
		if e.lg   then l1 = l1 .. "  ·  📦 importé" end
		-- 🧾 Une livraison différée écrit une SECONDE ligne, sans recompter le
		--    gift. Sans ce repère, on croirait qu'un joueur a reçu deux fois
		--    la même arme alors qu'il s'agit de l'achat puis de sa remise.
		if e.nc   then l1 = l1 .. "  ·  🧾 confirmation" end

		label(bot, {
			text = l1,
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, 0, 0, 0),
			xAlign = Enum.TextXAlignment.Left, color = km.c,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13,
		})

		local mt = msgText(e)
		local l2 = mt and ("💬 « " .. mt .. " »") or ""
		if e.pr and e.pr ~= 0 then
			l2 = (l2 ~= "" and (l2 .. "  ·  ") or "") .. "produit " .. tostring(e.pr)
		end
		l2 = (l2 ~= "" and (l2 .. "  ·  ") or "") .. "🆔 " .. tostring(su) .. " ➜ " .. tostring(ru)
		if e.sv and e.sv ~= "" then l2 = l2 .. "  ·  🖥️ " .. tostring(e.sv):sub(1, 6) end

		label(bot, {
			text = l2,
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, 0, 0, IS_MOBILE and 15 or 18),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13,
		})

		return box
	end

	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs(S.entries) do
			local grp = stMeta(e.st).g

			local okF
			if S.filter == "all" then okF = true
			elseif S.filter == "_self" then okF = (e.self == true)
			elseif S.filter == "_legacy" then okF = (e.lg == true)
			elseif S.filter == "_global" then okF = (e.g == true)
			elseif S.filter == "_claim"  then okF = (e.nc == true)
			elseif S.filter == "_real"   then okF = (e.nc ~= true)
			else okF = (grp == S.filter) end

			-- Filtre par type. « boost » regroupe temporaire ET permanent :
			-- quand on cherche un abus de multiplicateur, on veut les deux.
			local okK
			if S.kind == "all" then okK = true
			elseif S.kind == "boost" then okK = (ek(e) == "boost_temp" or ek(e) == "boost_perm")
			else okK = (ek(e) == S.kind) end

			local okQ = true
			if #q > 0 then
				local sn = (unameCache[tonumber(e.su) or 0] or ""):lower()
				local rn = (unameCache[tonumber(e.ru) or 0] or ""):lower()
				okQ = (tostring(e.sn or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.rn or ""):lower():find(q, 1, true) ~= nil)
					or (sn:find(q, 1, true) ~= nil)
					or (rn:find(q, 1, true) ~= nil)
					or (tostring(e.su) == q) or (tostring(e.ru) == q)
					or (tostring(e.lb or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(msgText(e) or ""):lower():find(q, 1, true) ~= nil)
			end

			if okF and okK and okQ then table.insert(out, e) end
		end
		table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
		return out
	end

	----------------------------------------------------------------------
	-- 🏆 ONGLET TOP
	----------------------------------------------------------------------
	local function renderTop(body)
		acTabBar(body, 1, TOPS, S.topMetric, GOLD, function(id)
			S.topMetric = id; S.top = nil; screen(false)
		end)

		local meta
		for _, t in ipairs(TOPS) do if t.id == S.topMetric then meta = t end end

		noteCard(body, 2, "Les deux classements « 💎 Pts » ne comptent QUE les gifts de "
			.. "points — c'est ce que tu voulais garder tel quel.\n\n"
			.. "Les deux classements « nombre » comptent TOUS les types : un VIP, une "
			.. "arme ou un boost valent chacun 1 gift. Un joueur peut donc être premier "
			.. "en nombre sans apparaître en points.", C.TEXT_DIM)

		local st = Instance.new("Frame")
		st.Size = UDim2.new(1, 0, 0, 44); st.BackgroundTransparency = 1
		st.LayoutOrder = 3; st.ZIndex = 11; st.Parent = body
		local stl = label(st, { text = "Chargement du classement...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		if not getTop then stl.Text = "❌ GiftLog_Server.lua pas installé."; return end

		local function paint(entries)
			if not st.Parent then return end
			st:Destroy()
			if #entries == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 50); f.BackgroundTransparency = 1
				f.LayoutOrder = 4; f.ZIndex = 11; f.Parent = body
				label(f, { text = "Aucun gift enregistré pour l'instant.", size = UDim2.fromScale(1, 1),
					color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
				return
			end
			for i, e in ipairs(entries) do
				acRow(body, 10 + i, i, e.userId, e.value, false, meta.col, function() screen(false) end)
			end

			local note = Instance.new("Frame")
			note.Size = UDim2.new(1, 0, 0, 22); note.BackgroundTransparency = 1
			note.LayoutOrder = 9999; note.ZIndex = 11; note.Parent = body
			label(note, {
				text = "Valeur = " .. meta.note .. " — cumul de toute l'histoire du jeu",
				size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 11 })

			-- 📦 Maintenance : ré-import de l'historique
			if doAct then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 10000; mc.ZIndex = 11; mc.Parent = body
				local mb, mlbl = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "📦 Ré-importer l'historique des gifts",
					textSize = IS_MOBILE and 11 or 13, radius = 9, zIndex = 11 })
				local armed = false
				mb.MouseButton1Click:Connect(function()
					if not armed then
						armed = true
						mlbl.Text = "⚠️ Appuie encore pour confirmer"
						task.delay(3, function()
							if mlbl and mlbl.Parent then
								armed = false
								mlbl.Text = "📦 Ré-importer l'historique des gifts"
							end
						end)
						return
					end
					armed = false
					mlbl.Text = "⏳ Import en cours (1 à 2 min)…"
					toast("Import lancé, ça peut prendre 1 à 2 minutes…", true)
					task.spawn(function()
						local ok, res = pcall(function()
							return doAct:InvokeServer("importlegacy", {})
						end)
						if ok and type(res) == "table" then
							toast(res.msg or (res.ok and "Import terminé" or "Échec"), res.ok == true)
						else
							toast("Erreur de communication", false)
						end
						S.entries, S.cursor, S.hasMore = {}, nil, false
						S.loaded, S.top = false, nil
						screen(false)
					end)
				end)
			end
		end

		if S.top then
			local ids = {}
			for _, e in ipairs(S.top) do table.insert(ids, e.userId) end
			resolveUsernames(ids, function() resolvePoints(ids, function() paint(S.top) end) end)
		elseif not S.topLoading then
			S.topLoading = true
			task.spawn(function()
				local ok, res = pcall(function() return getTop:InvokeServer(S.topMetric, 50) end)
				S.topLoading = false
				if not st.Parent then return end
				if not ok or type(res) ~= "table" then stl.Text = "Impossible de charger (🔄)."; return end
				S.top = res.entries or {}
				local ids = {}
				for _, e in ipairs(S.top) do table.insert(ids, e.userId) end
				resolveUsernames(ids, function() resolvePoints(ids, function() paint(S.top) end) end)
			end)
		end
	end

	----------------------------------------------------------------------
	-- 📜 ONGLET JOURNAL
	----------------------------------------------------------------------
	local function renderJournal(body)
		local back = function() screen(false) end

		-- Recherche
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 1; sw.ZIndex = 11; sw.Parent = body

		local sb = Instance.new("TextBox")
		sb.Size = UDim2.new(1, 0, 1, 0)
		sb.BackgroundColor3 = C.BG_DARK
		sb.BorderSizePixel = 0
		sb.Font = FONT
		sb.PlaceholderText = "🔍 Donneur, receveur, UserID, objet ou message..."
		sb.PlaceholderColor3 = C.TEXT_DIM
		sb.Text = S.search or ""
		sb.TextColor3 = C.TEXT_WHITE
		sb.TextSize = IS_MOBILE and 11 or 14
		sb.TextXAlignment = Enum.TextXAlignment.Left
		sb.ClearTextOnFocus = false
		sb.ZIndex = 12
		sb.Parent = sw
		corner(sb, 8); stroke(sb, C.BORDER_SUBTLE, 1)
		local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sb

		-- 🎁 Filtres PAR TYPE (deux rangées : ça ne tient pas sur une seule)
		acTabBar(body, 2, {
			{ id = "all",    label = "🌐 Tout" },
			{ id = "points", label = "💎 Points" },
			{ id = "boost",  label = "⏱️ Boosts" },
		}, S.kind, GOLD, function(id) S.kind = id; screen(false) end)

		acTabBar(body, 3, {
			{ id = "vip",    label = "👑 VIP" },
			{ id = "weapon", label = "🔫 Armes" },
			{ id = "spins",  label = "🎡 Spins" },
		}, S.kind, GOLD, function(id) S.kind = id; screen(false) end)

		-- Filtres par statut / drapeau
		acTabBar(body, 4, {
			{ id = "all",      label = "📬 Tous" },
			{ id = "ok",       label = "✅ Livrés" },
			{ id = "pending",  label = "📦 En attente" },
			{ id = "fallback", label = "⚠️ Replis" },
		}, S.filter, GIFT, function(id) S.filter = id; screen(false) end)

		acTabBar(body, 5, {
			{ id = "_real",   label = "🎁 Achats seuls" },
			{ id = "_global", label = "🌍 Annoncés" },
			{ id = "_self",   label = "🪞 Auto-gifts" },
			{ id = "_legacy", label = "📦 Importés" },
		}, S.filter, C.PURPLE, function(id) S.filter = id; screen(false) end)

		-- Compteurs
		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 74 or 86)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 6; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 52),
			wrapped = true, xAlign = Enum.TextXAlignment.Left, yAlign = Enum.TextYAlignment.Top,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		label(cf, {
			text = "👤 Touche le donneur (gauche) ou le receveur (droite) d'une carte pour ouvrir son profil.",
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16),
			position = UDim2.new(0, 0, 0, IS_MOBILE and 44 or 52),
			xAlign = Enum.TextXAlignment.Left, color = GIFT,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 11,
		})

		-- Un gift livré plus tard laisse DEUX lignes : l'achat, puis la
		-- confirmation « 🧾 ». Les totaux ne comptent que la première — dit
		-- ici, parce que sinon on croit à un doublon.
		label(cf, {
			text = "🧾 Une ligne « confirmation » = livraison différée d'un gift déjà listé. « 🎁 Achats seuls » les masque.",
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16),
			position = UDim2.new(0, 0, 0, IS_MOBILE and 58 or 68),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 11,
		})

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 7; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local render
		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end

			local list = visible()
			local shownPts = 0
			for _, e in ipairs(list) do shownPts = shownPts + (e.p or 0) end

			local t = S.totals or {}
			local bk = (type(t.byKind) == "table") and t.byKind or {}

			-- Récap par type : c'est là qu'on voit d'un coup si un type
			-- explose par rapport aux autres.
			local parts = {}
			for _, k in ipairs(K_ORDER) do
				local n = tonumber(bk[k]) or 0
				if n > 0 then
					table.insert(parts, K[k].e .. " " .. n)
				end
			end

			cLbl.Text = string.format(
				"%d affiché(s) · %s pts affichés  •  %d chargé(s)\n"
					.. "TOTAL JEU : %d gift(s) · %s pts · %d en attente · %d auto-gift(s)\n%s",
				#list, fmtNum(shownPts), #S.entries,
				t.all or 0, fmtNum(t.points or 0), t.pending or 0, t.selfGifts or 0,
				(#parts > 0) and ("PAR TYPE : " .. table.concat(parts, "  ·  ")) or "")

			if #list == 0 then
				local msg
				if S.loading then msg = "Chargement du journal..."
				elseif not getLog then msg = "❌ GiftLog_Server.lua pas installé côté serveur."
				elseif #S.entries == 0 then
					msg = "Aucun gift enregistré.\n\nSi des gifts ont déjà eu lieu, l'import "
						.. "automatique de GiftPurchaseLog_v1 tourne 40 s après le démarrage "
						.. "du serveur — reviens dans une minute, ou lance-le à la main depuis "
						.. "l'onglet 🏆 Classements."
				else msg = "Rien ne correspond à ces filtres." end
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 90); f.BackgroundTransparency = 1
				f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
				label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			else
				for i, e in ipairs(list) do giftCard(holder, i, e, back) end
			end

			if S.hasMore then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = holder
				local mb, mlbl = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger plus", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					if S.loading then return end
					S.loading = true
					mlbl.Text = "⏳ Chargement..."
					task.spawn(function()
						local ok, res = pcall(function() return getLog:InvokeServer(S.cursor, 30) end)
						S.loading = false
						if ok and type(res) == "table" and res.throttled then
							toast("Trop rapide, réessaie dans 1 s", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
							return
						end
						if ok and type(res) == "table" then
							local ids = {}
							for _, e in ipairs(res.entries or {}) do
								table.insert(S.entries, e)
								table.insert(ids, e.su); table.insert(ids, e.ru)
							end
							S.cursor  = res.cursor
							S.hasMore = res.hasMore == true
							if res.totals then S.totals = res.totals end
							resolveUsernames(ids, function()
								resolvePoints(ids, function()
									if holder and holder.Parent then render() end
								end)
							end)
						else
							toast("Chargement impossible", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
						end
					end)
				end)
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text; render()
		end)

		render()
	end

	----------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "giftlog"
		if reset then
			S.entries, S.cursor, S.hasMore = {}, nil, false
			S.loaded = false
			S.top = nil
		end

		local body = buildScreen("🎁 GIFT LOG", true, GIFT, nil, function() screen(true) end)

		acTabBar(body, 0, {
			{ id = "log", label = "📜 Journal" },
			{ id = "top", label = "🏆 Classements" },
		}, S.tab, GIFT, function(id) S.tab = id; screen(false) end)

		local function refreshIfStillHere(tab)
			if currentScreen == "giftlog" and window.Visible and S.tab == tab then
				screen(false)
			end
		end

		if not getLog then
			noteCard(body, 1, "❌ GiftLog_Server.lua (v2) n'est pas installé dans "
				.. "ServerScriptService.\nAjoute-le, puis redémarre le serveur.", C.RED)
			return
		end

		if S.tab == "top" then
			renderTop(body)
			return
		end

		-- Journal : une seule tentative automatique
		if not S.loaded and not S.loading then
			S.loading = true
			task.spawn(function()
				local ok, res = pcall(function() return getLog:InvokeServer(nil, 30) end)
				S.loading = false
				if ok and type(res) == "table" and res.throttled then
					task.wait(1.5)
					refreshIfStillHere("log")
					return
				end
				S.loaded = true
				if ok and type(res) == "table" then
					S.entries = res.entries or {}
					S.cursor  = res.cursor
					S.hasMore = res.hasMore == true
					S.totals  = res.totals
					S.session = res.session
					local ids = {}
					for _, e in ipairs(S.entries) do
						table.insert(ids, e.su); table.insert(ids, e.ru)
					end
					resolveUsernames(ids, function()
						resolvePoints(ids, function() refreshIfStillHere("log") end)
					end)
				else
					refreshIfStillHere("log")
				end
			end)
		end

		renderJournal(body)
	end

	----------------------------------------------------------------------
	-- 👤 CARTE "GIFTS" — injectée dans tous les profils
	----------------------------------------------------------------------
	local function giftProfileCard(parent, order, userId)
		if not getPlayer then return end

		local host = Instance.new("Frame")
		host.Size = UDim2.new(1, 0, 0, 0)
		host.AutomaticSize = Enum.AutomaticSize.Y
		host.BackgroundColor3 = C.BG_DARK
		host.BorderSizePixel = 0
		host.LayoutOrder = order
		host.ZIndex = 11
		host.Parent = parent
		corner(host, 10); stroke(host, GIFT, 1)

		label(host, { text = "🎁 GIFTS", size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
			color = GIFT, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })

		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = host

		local rl = Instance.new("UIListLayout"); rl.Padding = UDim.new(0, 2)
		rl.SortOrder = Enum.SortOrder.LayoutOrder; rl.Parent = rows
		local rp = Instance.new("UIPadding")
		rp.PaddingBottom = UDim.new(0, 8); rp.PaddingLeft = UDim.new(0, 10)
		rp.PaddingRight = UDim.new(0, 10); rp.Parent = rows

		local function line(o, key, val, col)
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
			row.BackgroundTransparency = 1
			row.LayoutOrder = o; row.ZIndex = 13; row.Parent = rows
			label(row, { text = key, size = UDim2.new(0.55, 0, 1, 0), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 14 })
			label(row, { text = tostring(val), size = UDim2.new(0.45, 0, 1, 0),
				position = UDim2.new(0.55, 0, 0, 0), xAlign = Enum.TextXAlignment.Right,
				color = col or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13,
				truncate = true, zIndex = 14 })
			return row
		end

		--  Une ligne d'historique :
		--    [pfp de l'autre]  ▶/◀  [🔫]  Nom de l'objet      quand
		--                             son nom à lui
		--  Un clic ouvre le profil de CET autre joueur.
		local function histLine(o, e, isSent)
			local other = isSent and (tonumber(e.ru) or 0) or (tonumber(e.su) or 0)
			local oname = unameCache[other]
				or (isSent and (e.rn or e.rd) or (e.sn or e.sd))
				or tostring(other)
			local km  = kMeta(ek(e))
			local lbl = itemLabel(e)
			local isPoints = (ek(e) == "points")

			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
			row.BackgroundColor3 = C.BG_ITEM
			row.BackgroundTransparency = 1
			row.AutoButtonColor = false
			row.Text = ""
			row.BorderSizePixel = 0
			row.LayoutOrder = o
			row.ZIndex = 13
			row.Parent = rows
			corner(row, 6)

			local s = IS_MOBILE and 24 or 28
			local av = makeAvatar(row, other, s, isSent and RECV or GIFT)
			av.AnchorPoint = Vector2.new(0, 0.5)
			av.Position = UDim2.new(0, 2, 0.5, 0)

			-- Sens du gift, en couleur : rose = il donne, bleu = il reçoit
			label(row, {
				text = isSent and "▶" or "◀",
				size = UDim2.new(0, 12, 1, 0),
				position = UDim2.new(0, s + 5, 0, 0),
				color = isSent and GIFT or RECV,
				textSize = IS_MOBILE and 11 or 13, zIndex = 14,
			})

			-- Vignette de l'objet : c'est elle qui dit ce qui a changé de main
			local thumbS = IS_MOBILE and 22 or 26
			local th = itemThumb(row, e, thumbS, 14)
			th.AnchorPoint = Vector2.new(0, 0.5)
			th.Position = UDim2.new(0, s + 19, 0.5, 0)

			local tx   = s + 19 + thumbS + 7
			local valW = IS_MOBILE and 92 or 118
			local dirCol = isSent and RECV or GIFT

			local nameLbl = label(row, {
				text = lbl,
				size = UDim2.new(1, -tx - valW - 6, 0, IS_MOBILE and 15 or 18),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 4 or 5),
				xAlign = Enum.TextXAlignment.Left, color = km.c,
				textSize = IS_MOBILE and 11 or 13, truncate = true, zIndex = 14,
			})
			label(row, {
				text = (isSent and "à " or "de ") .. esc(oname),
				size = UDim2.new(1, -tx - valW - 6, 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 19 or 23),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 14,
			})

			local right = (isPoints and ("💎 " .. fmtNum(e.p or 0) .. "\n") or
				(stMeta(e.st).l .. "\n")) .. fmtWhen(e)
			label(row, {
				text = right,
				size = UDim2.new(0, valW, 1, 0),
				position = UDim2.new(1, -4, 0.5, 0), anchor = Vector2.new(1, 0.5),
				xAlign = Enum.TextXAlignment.Right,
				color = isPoints and GOLD or stMeta(e.st).c,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 14,
			})

			row.MouseEnter:Connect(function()
				row.BackgroundTransparency = 0.4
				nameLbl.TextColor3 = dirCol
			end)
			row.MouseLeave:Connect(function()
				row.BackgroundTransparency = 1
				nameLbl.TextColor3 = km.c
			end)
			row.MouseButton1Click:Connect(function()
				screenManage({ userId = other, displayName = oname, username = oname,
					sub = isSent and ("📥 A reçu " .. lbl .. " de ce joueur")
						or ("🎁 A offert " .. lbl .. " à ce joueur") },
				function() openProfileDetail(unameCache[userId] or tostring(userId), nil) end)
			end)

			return row
		end

		line(1, "Chargement...", "", C.TEXT_DIM)

		task.spawn(function()
			-- Le serveur limite les appels rapprochés. Comme le panel ouvre
			-- parfois deux cartes GIFTS d'affilée (fiche + profil), on retente
			-- une fois plutôt que d'afficher « aucune donnée » à tort.
			local ok, res = pcall(function() return getPlayer:InvokeServer(userId, false) end)
			if ok and type(res) == "table" and res.throttled then
				task.wait(0.6)
				if not host.Parent then return end
				ok, res = pcall(function() return getPlayer:InvokeServer(userId, false) end)
			end
			if not host.Parent then return end

			for _, ch in ipairs(rows:GetChildren()) do
				if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
			end

			if not (ok and type(res) == "table" and res.ok and type(res.record) == "table") then
				line(1, "Aucune donnée de gift", "—", C.TEXT_DIM)
				return
			end

			local d = res.record
			local sent, sentPts = d.s or 0, d.sp or 0
			local recv, recvPts = d.r or 0, d.rp or 0
			local sk = (type(d.sk) == "table") and d.sk or {}
			local rk = (type(d.rk) == "table") and d.rk or {}

			if sent == 0 and recv == 0 then
				line(1, "Ce joueur n'a jamais gift ni reçu", "—", C.TEXT_DIM)
				return
			end

			-- Résumé : deux lignes, une par sens.
			line(1, "🎁 Il a offert",
				sent .. (sent > 1 and " gifts" or " gift") .. "  ·  💎 " .. fmtNum(sentPts),
				sent > 0 and GIFT or C.TEXT_DIM)
			line(2, "📥 Il a reçu",
				recv .. (recv > 1 and " gifts" or " gift") .. "  ·  💎 " .. fmtNum(recvPts),
				recv > 0 and RECV or C.TEXT_DIM)

			local bal = sentPts - recvPts
			line(3, "⚖️ Solde points",
				(bal >= 0 and "+" or "−") .. fmtNum(math.abs(bal)) .. " pts",
				bal >= 0 and GIFT or RECV)

			-- 🧩 Détail par type — offert vs reçu, sur la même ligne.
			--    C'est ce qui permet de voir en un regard qu'un joueur a reçu
			--    six boosts permanents sans jamais rien offrir.
			local hasKinds = false
			for _, k in ipairs(K_ORDER) do
				if (tonumber(sk[k]) or 0) > 0 or (tonumber(rk[k]) or 0) > 0 then hasKinds = true end
			end
			if hasKinds then
				line(9, "── 🧩 DÉTAIL PAR TYPE ──", "offert / reçu", C.TEXT_DIM)
				local o = 10
				for _, k in ipairs(K_ORDER) do
					local a = tonumber(sk[k]) or 0
					local b = tonumber(rk[k]) or 0
					if a > 0 or b > 0 then
						o = o + 1
						line(o, "  " .. K[k].e .. " " .. K[k].l,
							tostring(a) .. " / " .. tostring(b), K[k].c)
					end
				end
				-- Fiche antérieure à la v2 : le serveur a reconstruit ce
				-- détail depuis l'historique conservé. Le dire évite de
				-- prendre un chiffre partiel pour un total.
				if d.skPartial or d.rkPartial then
					line(19, "  ⚠️ Détail reconstruit",
						"partiel (30 derniers)", C.ORANGE)
				end
			end

			-- Ce qu'il a offert
			local hs = d.hs or {}
			if #hs > 0 then
				line(20, "── 🎁 CE QU'IL A OFFERT ──", "", C.TEXT_DIM)
				local n, ids = 0, {}
				for i = #hs, 1, -1 do
					n = n + 1
					if n > 12 then break end
					table.insert(ids, tonumber(hs[i].ru) or 0)
					histLine(20 + n, hs[i], true)
				end
				resolveUsernames(ids, function() end)
			end

			-- Ce qu'il a reçu
			local hr = d.hr or {}
			if #hr > 0 then
				line(50, "── 📥 CE QU'IL A REÇU ──", "", C.TEXT_DIM)
				local n, ids = 0, {}
				for i = #hr, 1, -1 do
					n = n + 1
					if n > 12 then break end
					table.insert(ids, tonumber(hr[i].su) or 0)
					histLine(50 + n, hr[i], false)
				end
				resolveUsernames(ids, function() end)
			end
		end)

		return host
	end

	-- 👤 Profils — LayoutOrder 12 = juste après les cartes UGC
	--    (🎽 UGC REDEEMED = 10, 🔐 UGC ESCROW = 11, 🎁 GIFTS = 12)
	local previousRenderProfile = renderProfile
	renderProfile = function(body, profile)
		previousRenderProfile(body, profile)
		if type(profile) == "table" and not profile.error and profile.userId then
			giftProfileCard(body, 12, profile.userId)
		end
	end

	-- 👤 Fiches "MANAGE PLAYER"
	local previousScreenManage = screenManage
	screenManage = function(info, backFn)
		previousScreenManage(info, backFn)
		if type(info) ~= "table" or not info.userId then return end
		local body = window:FindFirstChildOfClass("ScrollingFrame")
		if not body then return end
		giftProfileCard(body, 501, info.userId)
	end

	----------------------------------------------------------------------
	-- 🔗 AUTO-ENREGISTREMENT DANS LE MENU
	----------------------------------------------------------------------
	table.insert(ACTIONS, { id = "giftlog", name = "🎁 GIFT LOG", color = GIFT })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "giftlog" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🛑 BLOC 2-BIS — COUPURE D'URGENCE DES CADEAUX
--
--  ⚠️ OÙ LE COLLER
--     Juste APRÈS le `end)()` qui termine le BLOC 2 (🎁 GIFT LOG), et avant
--     le BLOC 3 (🔐 ESCROW). Il n'écrase rien : il s'ajoute.
--
--  CE QU'IL AJOUTE
--     • Une entrée rouge « 🛑 GIFT KILL SWITCH » dans le menu du panneau.
--     • Une carte d'état en haut de l'écran 🎁 GIFT LOG, qui montre d'un coup
--       d'œil si les cadeaux tournent, et ouvre l'écran de coupure.
--
--  POURQUOI UN ÉCRAN À PART ET PAS UN BOUTON DANS LE JOURNAL
--     Le journal se fait défiler. Un gros bouton rouge qui coupe l'économie
--     du jeu n'a rien à faire sur un écran qu'on parcourt au doigt : une
--     fausse manœuvre coûterait des heures de ventes. La carte d'état, elle,
--     est bien dans le gift log — c'est l'information qui doit y être visible.
--
--  Prérequis serveur : GiftKillSwitch.server.lua dans ServerScriptService.
--════════════════════════════════════════════════════════════════════════════

;(function()
	local KILL   = Color3.fromRGB(255, 70, 80)
	local KILL_D = Color3.fromRGB(150, 25, 35)
	local LIVE   = Color3.fromRGB(70, 210, 120)

	local killGet = ReplicatedStorage:WaitForChild("AdminGiftKillGet", 10)
	local killSet = ReplicatedStorage:WaitForChild("AdminGiftKillSet", 10)

	if not (killGet and killSet) then
		warn("[Admin] AdminGiftKillGet / AdminGiftKillSet introuvables → ajoute "
			.. "GiftKillSwitch.server.lua dans ServerScriptService")
	end

	--  État local de l'écran. `armed` est l'anti-fausse-manœuvre : le premier
	--  clic arme, le second exécute, et l'armement retombe tout seul.
	local S = {
		snap = nil, snapAt = 0, loading = false, failed = false,
		--  `armedFor` retient CE QU'ON a armé ("cut" / "open"). Sans lui, un
		--  écran armé pour couper qui se redessine parce que l'état est
		--  arrivé entre-temps — un autre admin a coupé — présentait le bouton
		--  vert « RÉACTIVER » exactement là où le doigt allait retomber : le
		--  second appui rouvrait les cadeaux en plein incident.
		armed = false, armedFor = nil, armedAt = 0,
		busy = false, result = nil, resultColor = nil,
		reason = "",
	}
	local ARM_WINDOW = 6

	----------------------------------------------------------------------
	-- Petits constructeurs
	--
	--  ⚠️ noteCard est redéfini ici : celui du BLOC 2 est un local à SON
	--     IIFE, donc invisible depuis ce bloc. corner / stroke / label /
	--     buildScreen viennent d'un bloc antérieur au niveau du script et
	--     sont, eux, bien accessibles.
	----------------------------------------------------------------------
	local function noteCard(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	local function bigButton(parent, order, txt, bg, edge, h, onClick)
		local b = Instance.new("TextButton")
		b.Size             = UDim2.new(1, 0, 0, h)
		b.BackgroundColor3 = bg
		b.BorderSizePixel  = 0
		b.AutoButtonColor  = false
		b.Text             = txt
		b.Font             = FONT
		b.TextSize         = IS_MOBILE and 15 or 19
		b.TextColor3       = Color3.fromRGB(255, 255, 255)
		b.TextWrapped      = true
		b.LayoutOrder      = order
		b.ZIndex           = 12
		b.Parent           = parent
		corner(b, 12)
		stroke(b, edge, 2)

		local veil = Instance.new("Frame")
		veil.Size                   = UDim2.new(1, 0, 1, 0)
		veil.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
		veil.BackgroundTransparency = 1
		veil.BorderSizePixel        = 0
		veil.ZIndex                 = 12
		veil.Parent                 = b
		corner(veil, 12)

		local function fade(v)
			TweenService:Create(veil, TweenInfo.new(0.1),
				{ BackgroundTransparency = v }):Play()
		end
		if not IS_MOBILE then
			b.MouseEnter:Connect(function() fade(0.9) end)
			b.MouseLeave:Connect(function() fade(1) end)
		end
		b.MouseButton1Down:Connect(function() fade(0.8) end)
		b.MouseButton1Up:Connect(function() fade(IS_MOBILE and 1 or 0.9) end)
		b.MouseButton1Click:Connect(onClick)
		return b
	end

	local function infoRow(parent, order, k, v, col)
		local row = Instance.new("Frame")
		row.Size               = UDim2.new(1, 0, 0, IS_MOBILE and 20 or 24)
		row.BackgroundTransparency = 1
		row.LayoutOrder        = order
		row.ZIndex             = 12
		row.Parent             = parent
		label(row, { text = k, size = UDim2.new(0.42, 0, 1, 0),
			position = UDim2.new(0, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, zIndex = 13 })
		label(row, { text = v, size = UDim2.new(0.58, 0, 1, 0),
			position = UDim2.new(0.42, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = col or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 12, zIndex = 13 })
		return row
	end

	--  ⚠️ InvokeServer n'a AUCUN timeout. Si le remote existe mais que
	--     personne ne l'a branché côté serveur — le script du switch a planté
	--     après avoir créé les remotes, ou le DataStore throttle la lecture —
	--     l'appel ne revient jamais. Les drapeaux `loading` / `busy`
	--     restaient alors coincés à true et l'écran ne pouvait plus RIEN
	--     faire, bouton « Rafraîchir » compris. C'est l'écran qu'on utilise
	--     sous pression : il doit toujours répondre.
	local function invokeBounded(remote, seconds, ...)
		local args = table.pack(...)
		local done, res = false, nil
		task.spawn(function()
			local ok, r = pcall(function()
				return remote:InvokeServer(table.unpack(args, 1, args.n))
			end)
			if ok then res = r end
			done = true
		end)
		local waited = 0
		while not done and waited < seconds do
			task.wait(0.1)
			waited = waited + 0.1
		end
		return done, res
	end

	local function when(t)
		t = tonumber(t) or 0
		if t <= 0 then return "—" end
		return os.date("!%d/%m/%Y %H:%M UTC", t)
	end

	----------------------------------------------------------------------
	-- CHARGEMENT DE L'ÉTAT
	----------------------------------------------------------------------
	local screen   -- forward
	local function refreshIfStillHere()
		if currentScreen == "giftkill" and window.Visible then screen(false) end
	end

	--  ⚠️ `failed` est indispensable.
	--
	--     screen() appelle load() quand snap est vide, et load() rappelle
	--     screen() quand il a fini. Si l'appel échoue, snap reste vide : sans
	--     ce drapeau, les deux fonctions se relançaient l'une l'autre en
	--     boucle et martelaient le serveur aussi vite que le réseau le
	--     permet. Après un échec, on attend que l'admin appuie sur
	--     « Rafraîchir ».
	local function load()
		if S.loading or not killGet then return end
		S.loading = true
		task.spawn(function()
			local done, res = invokeBounded(killGet, 8)
			S.loading = false
			if done and type(res) == "table" then
				S.snap   = res
				S.snapAt = os.clock()
				S.failed = false
			else
				S.failed = true
			end
			refreshIfStillHere()
		end)
	end

	----------------------------------------------------------------------
	-- LA BASCULE
	----------------------------------------------------------------------
	local CODES = {
		applied      = { "✅ Appliqué sur TOUS les serveurs.", nil },
		no_broadcast = { "⚠️ Enregistré, mais la diffusion instantanée a échoué.\n"
			.. "Les autres serveurs suivront dans 30 s maximum.", nil },
		local_only   = { "🚨 Écriture DataStore impossible.\n"
			.. "La coupure n'est active QUE sur ce serveur. Réessaie dans un "
			.. "instant pour la propager partout.", nil },
		write_failed = { "❌ Écriture DataStore impossible — RIEN n'a changé.\n"
			.. "Réessaie. (Une réactivation n'est jamais appliquée localement : "
			.. "les autres serveurs resteraient coupés sans que tu le saches.)", nil },
		busy         = { "⏳ Trop rapide, attends deux secondes.", nil },
		denied       = { "🚫 Refusé : tu n'es pas dans ADMIN_IDS côté serveur.", nil },
		bad_arg      = { "❌ Requête invalide.", nil },
	}

	local function apply(turnOn)
		if S.busy or not killSet then return end
		S.busy   = true
		S.armed, S.armedFor = false, nil
		S.result = "⏳ Envoi…"
		S.resultColor = C.ORANGE
		refreshIfStillHere()

		task.spawn(function()
			local done, res = invokeBounded(killSet, 12, turnOn, S.reason)
			S.busy = false

			if not done or type(res) ~= "table" then
				S.result = done
					and "❌ Le serveur n'a pas répondu. Rien n'a changé."
					or  "⏱️ Pas de réponse en 12 s. L'action a peut-être abouti : "
					.. "rafraîchis l'état avant de réessayer."
				S.resultColor = C.RED
			else
				local meta = CODES[tostring(res.code)]
				S.result = meta and meta[1] or ("Code : " .. tostring(res.code))
				S.resultColor = res.ok and (res.code == "applied" and C.GREEN or C.ORANGE) or C.RED
				if type(res.snapshot) == "table" then
					S.snap   = res.snapshot
					S.snapAt = os.clock()
					S.failed = false
				end
			end

			refreshIfStillHere()
			--  On relit la vérité serveur : le snapshot renvoyé vient d'UN
			--  serveur, la lecture fraîche vient du DataStore.
			task.delay(1, load)
		end)
	end

	----------------------------------------------------------------------
	-- ÉCRAN
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "giftkill"
		if reset then
			S.armed, S.armedFor = false, nil
			S.result, S.resultColor = nil, nil
			S.snap = nil
		end

		local body = buildScreen("🛑 GIFT KILL SWITCH", true, KILL, nil,
			function() screen(true) end)

		if not (killGet and killSet) then
			noteCard(body, 1, "❌ GiftKillSwitch.server.lua n'est pas installé dans "
				.. "ServerScriptService.\nAjoute-le, puis redémarre le serveur.", C.RED)
			return
		end

		if not S.snap and not S.loading and not S.failed then load() end

		if S.failed and not S.snap then
			noteCard(body, 1, "⚠️ Impossible de lire l'état du kill switch.\n"
				.. "Appuie sur « Rafraîchir l'état » en bas de l'écran.", C.ORANGE)
		end

		local snap = S.snap
		--  `on`       = coupure GLOBALE (écrite dans le DataStore)
		--  `localOnly`= ce serveur est coupé en secours, mais pas les autres.
		--
		--  Les confondre affichait « coupé sur tous les serveurs » alors qu'un
		--  seul l'était, ET ne proposait plus que « RÉACTIVER » — donc aucun
		--  moyen de réessayer la coupure globale depuis l'écran qui venait de
		--  dire de réessayer.
		local on        = snap and snap.on == true
		local localOnly = (snap and snap.localCut == true) and not on

		------------------------------------------------------------------
		-- Bandeau d'état
		------------------------------------------------------------------
		local banner = Instance.new("Frame")
		banner.Size               = UDim2.new(1, 0, 0, IS_MOBILE and 62 or 76)
		local headline, subline, tone
		if not snap then
			headline, subline, tone =
				"⏳ Lecture de l'état…", "", C.TEXT_GREY
		elseif on then
			headline, subline, tone =
				"🛑 CADEAUX COUPÉS",
			"Aucun achat de cadeau n'est possible, sur aucun serveur.",
			KILL
		elseif localOnly then
			headline, subline, tone =
				"⚠️ COUPÉ SUR CE SERVEUR SEULEMENT",
			"L'écriture globale a échoué. Appuie sur COUPER pour réessayer "
				.. "de propager la coupure partout.",
			C.ORANGE
		else
			headline, subline, tone =
				"🟢 CADEAUX ACTIFS",
			"Le système de cadeaux fonctionne normalement.",
			LIVE
		end

		banner.BackgroundColor3   = on and KILL_D or C.BG_DARK
		banner.BorderSizePixel    = 0
		banner.LayoutOrder        = 0
		banner.ZIndex             = 11
		banner.Parent             = body
		corner(banner, 12); stroke(banner, tone, 2)

		label(banner, {
			text = headline,
			size = UDim2.new(1, -20, 0, IS_MOBILE and 26 or 32),
			position = UDim2.new(0, 10, 0, IS_MOBILE and 8 or 10),
			color = tone,
			textSize = IS_MOBILE and 16 or 21, zIndex = 12 })

		label(banner, {
			text = subline,
			size = UDim2.new(1, -20, 0, IS_MOBILE and 22 or 26),
			position = UDim2.new(0, 10, 0, IS_MOBILE and 34 or 44),
			xAlign = Enum.TextXAlignment.Center,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, zIndex = 12 })

		------------------------------------------------------------------
		-- Détail
		------------------------------------------------------------------
		if snap then
			local infoCard = Instance.new("Frame")
			infoCard.Size             = UDim2.new(1, 0, 0, 0)
			infoCard.AutomaticSize    = Enum.AutomaticSize.Y
			infoCard.BackgroundColor3 = C.BG_DARK
			infoCard.BorderSizePixel  = 0
			infoCard.LayoutOrder      = 1
			infoCard.ZIndex           = 11
			infoCard.Parent           = body
			corner(infoCard, 10); stroke(infoCard, C.BORDER_SUBTLE, 1)

			local rows = Instance.new("Frame")
			rows.Size               = UDim2.new(1, -20, 0, 0)
			rows.Position           = UDim2.new(0, 10, 0, 8)
			rows.AutomaticSize      = Enum.AutomaticSize.Y
			rows.BackgroundTransparency = 1
			rows.ZIndex             = 12
			rows.Parent             = infoCard
			local lay = Instance.new("UIListLayout")
			lay.Padding   = UDim.new(0, 2)
			lay.SortOrder = Enum.SortOrder.LayoutOrder
			lay.Parent    = rows
			local p = Instance.new("UIPadding")
			p.PaddingBottom = UDim.new(0, 8)
			p.Parent = rows

			infoRow(rows, 1, "Dernier changement", when(snap.t))
			infoRow(rows, 2, "Par", (snap.by ~= "" and snap.by or "—")
				.. (snap.byId and snap.byId > 0 and (" (" .. snap.byId .. ")") or ""))
			infoRow(rows, 3, "Raison notée", snap.reason ~= "" and snap.reason or "—")
			infoRow(rows, 4, "Version", tostring(snap.v or 0), C.TEXT_DIM)
			infoRow(rows, 5, "État lu sur ce serveur",
				snap.ready and "oui" or "NON (cadeaux bloqués par sécurité)",
				snap.ready and C.GREEN or C.ORANGE)
		end

		------------------------------------------------------------------
		-- Raison (optionnelle) — écrite dans le journal du switch
		------------------------------------------------------------------
		local reasonCard = Instance.new("Frame")
		reasonCard.Size             = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 50)
		reasonCard.BackgroundColor3 = C.BG_ITEM
		reasonCard.BorderSizePixel  = 0
		reasonCard.LayoutOrder      = 2
		reasonCard.ZIndex           = 11
		reasonCard.Parent           = body
		corner(reasonCard, 10); stroke(reasonCard, C.BORDER_SUBTLE, 1)

		local reasonBox = Instance.new("TextBox")
		reasonBox.Size                   = UDim2.new(1, -20, 1, -10)
		reasonBox.Position               = UDim2.new(0, 10, 0, 5)
		reasonBox.BackgroundTransparency = 1
		reasonBox.ClearTextOnFocus       = false
		reasonBox.Text                   = S.reason
		reasonBox.PlaceholderText        = "Raison (facultatif) — ex : faille suspectée sur les boosts"
		reasonBox.PlaceholderColor3      = C.TEXT_DIM
		reasonBox.Font                   = FONT
		reasonBox.TextSize               = IS_MOBILE and 11 or 13
		reasonBox.TextColor3             = C.TEXT_WHITE
		reasonBox.TextXAlignment         = Enum.TextXAlignment.Left
		reasonBox.TextTruncate           = Enum.TextTruncate.AtEnd
		reasonBox.ZIndex                 = 12
		reasonBox.Parent                 = reasonCard
		reasonBox:GetPropertyChangedSignal("Text"):Connect(function()
			if #reasonBox.Text > 140 then reasonBox.Text = reasonBox.Text:sub(1, 140) end
			S.reason = reasonBox.Text
		end)

		------------------------------------------------------------------
		-- LE BOUTON
		------------------------------------------------------------------
		--  L'action que CE rendu propose. Si l'état a bougé depuis l'armement
		--  — un autre admin est passé par là — l'armement ne vaut plus rien :
		--  on désarme, et le deuxième appui de l'admin ne fait que réarmer.
		--  Les deux sens demandent confirmation : rouvrir en plein incident
		--  est aussi grave que couper par erreur.
		local want = on and "open" or "cut"
		if S.armed and S.armedFor ~= want then
			S.armed, S.armedFor = false, nil
		end
		local isArmed = S.armed and (os.clock() - S.armedAt) < ARM_WINDOW

		if S.busy then
			bigButton(body, 3, "⏳ ENVOI EN COURS…", C.BG_LIGHT, C.BORDER_BRIGHT,
				IS_MOBILE and 54 or 62, function() end)

		elseif isArmed then
			--  Deuxième appui : c'est celui qui agit.
			bigButton(body, 3,
				(want == "cut") and "⚠️  CONFIRMER — COUPER MAINTENANT"
					or "⚠️  CONFIRMER — ROUVRIR LES CADEAUX",
				(want == "cut") and KILL or C.GREEN,
				Color3.fromRGB(255, 255, 255),
				IS_MOBILE and 60 or 70,
				function() apply(want == "cut") end)

			bigButton(body, 4, "Annuler", C.BG_LIGHT, C.BORDER_SUBTLE,
				IS_MOBILE and 36 or 42, function()
					S.armed, S.armedFor = false, nil
					screen(false)
				end)

			--  L'armement retombe tout seul : un panneau laissé ouvert ne doit
			--  pas rester à un appui d'une bascule.
			task.delay(ARM_WINDOW + 0.1, function()
				if S.armed and (os.clock() - S.armedAt) >= ARM_WINDOW then
					S.armed, S.armedFor = false, nil
					refreshIfStillHere()
				end
			end)

		elseif on then
			bigButton(body, 3, "▶  RÉACTIVER LES CADEAUX", C.GREEN, LIVE,
				IS_MOBILE and 54 or 62, function()
					S.armed, S.armedFor, S.armedAt = true, "open", os.clock()
					S.result = nil
					screen(false)
				end)

		else
			bigButton(body, 3,
				localOnly and "🛑  RÉESSAYER — COUPER PARTOUT" or "🛑  COUPER LES CADEAUX",
				KILL_D, KILL,
				IS_MOBILE and 54 or 62, function()
					S.armed, S.armedFor, S.armedAt = true, "cut", os.clock()
					S.result = nil
					screen(false)
				end)

			--  Sortie de secours pour l'état « coupé ici seulement ». Sans
			--  arming : ça ne rouvre QUE ce serveur, alors que tous les autres
			--  sont déjà ouverts — la portée est minuscule et l'admin doit
			--  pouvoir défaire sa coupure locale sans détour.
			if localOnly then
				bigButton(body, 4, "Annuler la coupure locale (ce serveur)",
					C.BG_LIGHT, C.BORDER_SUBTLE,
					IS_MOBILE and 36 or 42, function() apply(false) end)
			end
		end

		------------------------------------------------------------------
		-- Résultat de la dernière action
		------------------------------------------------------------------
		if S.result then
			noteCard(body, 5, S.result, S.resultColor or C.TEXT_GREY)
		end

		------------------------------------------------------------------
		-- Ce que la coupure fait, en clair
		------------------------------------------------------------------
		noteCard(body, 6,
			"CE QUE LA COUPURE FAIT\n"
				.. "• Plus aucune fenêtre d'achat de cadeau ne s'ouvre, sur aucun serveur.\n"
				.. "• Le panneau cadeau se ferme et affiche le message de sécurité.\n"
				.. "• Les livraisons sont GELÉES : les cadeaux déjà payés restent dans "
				.. "la file et repartiront à la réouverture. Rien n'est perdu.",
			C.TEXT_GREY)

		noteCard(body, 7,
			"CE QU'ELLE NE FAIT PAS, ET C'EST VOULU\n"
				.. "Un achat lancé juste avant la coupure est quand même encaissé : "
				.. "Roblox a déjà débité le joueur, refuser le receipt reviendrait à "
				.. "garder son argent. Le cadeau part dans la file, gelé, et sera "
				.. "livré à la réouverture.\n\n"
				.. "Propagation : instantanée par MessagingService, 30 s au pire si un "
				.. "message se perd.",
			C.TEXT_DIM)

		bigButton(body, 8, "🔄 Rafraîchir l'état", C.BG_LIGHT, C.BORDER_SUBTLE,
			IS_MOBILE and 36 or 42, function()
				S.snap, S.failed = nil, false
				screen(false)
			end)
	end

	----------------------------------------------------------------------
	-- 🔗 ENTRÉE DE MENU
	----------------------------------------------------------------------
	table.insert(ACTIONS, { id = "giftkill", name = "🛑 GIFT KILL SWITCH", color = KILL })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "giftkill" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end

	----------------------------------------------------------------------
	-- 🎁 CARTE D'ÉTAT DANS L'ÉCRAN GIFT LOG
	--
	--  On enveloppe buildScreen plutôt que le `screen()` du bloc 2, qui est
	--  un local inaccessible d'ici. La carte est donc reconstruite à chaque
	--  rafraîchissement du journal, y compris au changement d'onglet.
	--
	--  Tout est sous pcall : une carte d'information ne doit jamais pouvoir
	--  empêcher le gift log de s'afficher.
	----------------------------------------------------------------------
	local previousBuildScreen = buildScreen
	buildScreen = function(title, ...)
		local r = table.pack(previousBuildScreen(title, ...))
		local body = r[1]

		if title == "🎁 GIFT LOG" and body and killGet then
			pcall(function()
				local strip = Instance.new("TextButton")
				strip.Size             = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
				strip.BackgroundColor3 = C.BG_DARK
				strip.BorderSizePixel  = 0
				strip.AutoButtonColor  = false
				strip.Text             = ""
				strip.LayoutOrder      = -1     -- au-dessus de la barre d'onglets
				strip.ZIndex           = 11
				strip.Parent           = body
				corner(strip, 10)
				local edge = stroke(strip, C.BORDER_SUBTLE, 1)

				--  TextLabel construit à la main : ce label est modifié plus
				--  tard depuis un autre thread, on ne veut dépendre d'aucun
				--  contrat de retour d'un helper d'un autre bloc.
				local txt = Instance.new("TextLabel")
				txt.Size                   = UDim2.new(1, -20, 1, 0)
				txt.Position               = UDim2.new(0, 10, 0, 0)
				txt.BackgroundTransparency = 1
				txt.Font                   = FONT
				txt.Text                   = "⏳ Kill switch — lecture…"
				txt.TextColor3             = C.TEXT_GREY
				txt.TextSize               = IS_MOBILE and 11 or 13
				txt.TextXAlignment         = Enum.TextXAlignment.Left
				txt.TextTruncate           = Enum.TextTruncate.AtEnd
				txt.ZIndex                 = 12
				txt.Parent                 = strip

				strip.MouseButton1Click:Connect(function()
					S.snap, S.failed = nil, false
					screen(true)
				end)

				task.spawn(function()
					--  Le gift log se redessine à chaque onglet et à chaque
					--  chargement. Sans ce cache de 10 s, un aller-retour dans
					--  le journal déclencherait un appel serveur par redessin.
					local res = S.snap
					if not (res and (os.clock() - S.snapAt) < 10) then
						local ok, r = pcall(function() return killGet:InvokeServer() end)
						res = (ok and type(r) == "table") and r or nil
						if res then S.snap, S.snapAt, S.failed = res, os.clock(), false end
					end
					if not strip.Parent then return end
					if type(res) == "table" then
						if res.on then
							txt.Text = "🛑 CADEAUX COUPÉS — appuie pour gérer"
							txt.TextColor3 = KILL
							if edge then edge.Color = KILL end
							strip.BackgroundColor3 = KILL_D
						elseif res.localCut then
							txt.Text = "⚠️ Coupé sur CE serveur seulement — appuie pour propager"
							txt.TextColor3 = C.ORANGE
							if edge then edge.Color = C.ORANGE end
						else
							txt.Text = "🟢 Cadeaux actifs — appuie pour couper en urgence"
							txt.TextColor3 = LIVE
							if edge then edge.Color = C.BORDER_SUBTLE end
						end
					else
						txt.Text = "⚠️ Kill switch injoignable — appuie pour ouvrir"
						txt.TextColor3 = C.ORANGE
					end
				end)
			end)
		end

		return table.unpack(r, 1, r.n)
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🔐 BLOC 3/3 — SECTION ESCROW COMPLÈTE
--
--  ⚠️ CE BLOC REMPLACE TA SECTION ESCROW EXISTANTE.
--     Supprime l'IIFE qui commence par :
--         ;(function()
--             local CYAN = Color3.fromRGB(120, 220, 255)
--             local getLog  = ReplicatedStorage:WaitForChild("AdminGetUGCEscrow", 10)
--     ...jusqu'à son `end)()` et le pavé de commentaires « ✅ CE QUE TU VERRAS »
--     qui le suit.
--
--     ⚠️ GARDE la ligne `local ESC = {}` (elle est en dehors de l'IIFE, plus
--        haut dans ton script, juste avant `local UGC_PINK`).
--
--  Rien d'autre à toucher : l'entrée de menu 🔐 ESCROW et le dispatch dans
--  openAction existent déjà et continuent de fonctionner.
--
--  Six onglets, sur deux rangées :
--     📜 Journal   · 🔴 Ouverts  · 🅿️ De côté
--     💸 Dettes    · 🚨 Suspects · ⚙️ Réglages
--
--  Chaque réglage passe par une fenêtre de confirmation qui explique ce que le
--  changement fait concrètement, avec un compte à rebours avant que le bouton
--  devienne cliquable — impossible de basculer un interrupteur par réflexe.
--
--  Prérequis : A_UGCEscrow.server.lua (v3)
--════════════════════════════════════════════════════════════════════════════
;(function()
	local CY   = Color3.fromRGB(120, 220, 255)
	local CY_D = Color3.fromRGB(25, 90, 140)
	local WARN = Color3.fromRGB(255, 185, 70)

	local getLog  = ReplicatedStorage:WaitForChild("AdminGetUGCEscrow", 10)
	local getOpen = ReplicatedStorage:WaitForChild("AdminGetUGCEscrowOpen", 10)
	local doAct   = ReplicatedStorage:WaitForChild("AdminUGCEscrowAction", 10)
	local getCfg  = ReplicatedStorage:WaitForChild("AdminGetUGCEscrowConfig", 10)
	local setCfg  = ReplicatedStorage:WaitForChild("AdminSetUGCEscrowConfig", 10)

	if not getLog then warn("[Admin] AdminGetUGCEscrow introuvable → ajoute A_UGCEscrow.server.lua") end
	if not getCfg then warn("[Admin] AdminGetUGCEscrowConfig introuvable → mets A_UGCEscrow à jour (v3)") end

	local EV = {
		open            = { l = "📤 Ouvert",             c = CY,           g = "flow"  },
		failed          = { l = "⚠️ Échec annoncé",      c = C.ORANGE,     g = "flow"  },
		confirm         = { l = "✅ Confirmé",           c = C.GREEN,      g = "money" },
		quit_confirm    = { l = "✅ Livré avant quit",   c = C.GREEN,      g = "risk"  },
		rededuct        = { l = "💸 Re-déduit",          c = C.ORANGE,     g = "risk"  },
		refund          = { l = "↩️ Remboursé",          c = C.TEXT_WHITE, g = "money" },
		refund_due      = { l = "⏳ Rembours. dû",       c = C.ORANGE,     g = "flow"  },
		refund_deferred = { l = "⏳ Rembours. reporté",  c = C.ORANGE,     g = "flow"  },
		payout_failed   = { l = "🚨 Paiement échoué",    c = C.RED,        g = "risk"  },
		deferred        = { l = "⏸️ Différé (rejoin)",   c = C.TEXT_GREY,  g = "flow"  },
		quit            = { l = "🚪 Quit en achat",      c = C.ORANGE,     g = "risk"  },
		cancelled       = { l = "🚫 Prompt non affiché", c = C.TEXT_GREY,  g = "flow"  },
		closed          = { l = "⚪ Clôturé",             c = C.TEXT_DIM,   g = "flow"  },
		await_admin     = { l = "🙋 À valider",          c = C.ORANGE,     g = "flow"  },
		debt            = { l = "🔴 DETTE",              c = C.RED,        g = "risk"  },
		debt_paid       = { l = "💸 Dette payée",        c = C.GREEN,      g = "money" },
		debt_forgiven   = { l = "🩹 Dette annulée",      c = C.PURPLE,     g = "money" },
		debt_waived     = { l = "💨 Reliquat effacé",    c = WARN,         g = "money" },
		external        = { l = "🌐 Hors shop",          c = C.RED,        g = "risk"  },
		off_shop        = { l = "❓ Achat hors shop",    c = C.ORANGE,     g = "risk"  },
		legacy_owned    = { l = "📷 Possédée avant",     c = C.TEXT_GREY,  g = "flow"  },
		parked          = { l = "🅿️ Mise de côté",       c = CY,           g = "flow"  },
		parked_resolved = { l = "🅿️ Résolue",            c = C.GREEN,      g = "money" },
		parked_cleared  = { l = "🗑️ Parkées vidées",     c = C.TEXT_DIM,   g = "flow"  },
	}
	local function ev(id) return EV[tostring(id)] or { l = tostring(id), c = C.TEXT_GREY, g = "flow" } end

	local S = {
		tab = "log",
		entries = {}, cursor = nil, hasMore = false, filter = "all", search = "",
		cfg = nil, stats = nil, shopSize = 0,
		dirty = false, cfgLoading = false, cfgFailed = false,
		park = {}, parkLoaded = false, parkLoading = false,
		debt = {}, debtLoaded = false, debtLoading = false,
	}

	----------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	----------------------------------------------------------------------
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	local function statCard(parent, order, title, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 10); stroke(f, color, 1)
		label(f, { text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
			color = color, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })
		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = f
		local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 2); l.Parent = rows
		local p = Instance.new("UIPadding")
		p.PaddingBottom = UDim.new(0, 8); p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = rows
		return f, rows
	end

	local function statLine(parent, order, key, val, color)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order; row.ZIndex = 12; row.Parent = parent
		label(row, { text = key, size = UDim2.new(0.6, 0, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })
		label(row, { text = tostring(val), size = UDim2.new(0.4, 0, 1, 0),
			position = UDim2.new(0.6, 0, 0, 0), xAlign = Enum.TextXAlignment.Right,
			color = color or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13, zIndex = 13 })
	end

	local function bigBtn(parent, order, text, col, colD, fn)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 42 or 48)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b = actionButton(c, { color = col, strokeColor = colD, text = text,
			textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b
	end

	local screen  -- fwd

	local function callAct(action, payload, onDone)
		if not doAct then toast("Escrow pas installé côté serveur", false); return end
		task.spawn(function()
			local ok, res = pcall(function() return doAct:InvokeServer(action, payload) end)
			if ok and type(res) == "table" then
				toast(res.msg or (res.ok and "OK" or "Échec"), res.ok == true)
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

	----------------------------------------------------------------------
	-- 🛑 FENÊTRE DE CONFIRMATION AVEC DÉLAI
	--
	--    Elle explique en toutes lettres ce que le changement fait, puis
	--    n'autorise la validation qu'après un compte à rebours. Le but est
	--    qu'un réglage sensible ne puisse pas être basculé par réflexe.
	--
	--    opts = { title, lines = {...}, warn = "…", confirmText, danger, delay, onConfirm }
	----------------------------------------------------------------------
	local function confirmDialog(opts)
		local delay = tonumber(opts.delay) or (opts.danger and 5 or 3)

		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.45
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.94, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12)
		stroke(card, opts.danger and C.RED or CY, 1.5)
		padding(card, 12)

		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8)
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Parent = card

		-- Titre
		local t1 = Instance.new("Frame")
		t1.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t1.BackgroundTransparency = 1
		t1.LayoutOrder = 1; t1.ZIndex = 52; t1.Parent = card
		label(t1, { text = opts.title or "Confirmer ?",
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = opts.danger and C.RED or CY,
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 52 })

		-- Explication
		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundColor3 = C.BG_ITEM
		body.BackgroundTransparency = 0.3
		body.BorderSizePixel = 0
		body.Font = FONT
		body.Text = table.concat(opts.lines or {}, "\n\n")
		body.TextColor3 = C.TEXT_WHITE
		body.TextSize = IS_MOBILE and 11 or 13
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.LayoutOrder = 2
		body.ZIndex = 52
		body.Parent = card
		corner(body, 8)
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 8)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = body

		-- Avertissement éventuel
		if opts.warn then
			local w = Instance.new("TextLabel")
			w.Size = UDim2.new(1, 0, 0, 0)
			w.AutomaticSize = Enum.AutomaticSize.Y
			w.BackgroundTransparency = 1
			w.Font = FONT
			w.Text = opts.warn
			w.TextColor3 = opts.danger and C.RED or WARN
			w.TextSize = IS_MOBILE and 10 or 12
			w.TextWrapped = true
			w.TextXAlignment = Enum.TextXAlignment.Left
			w.LayoutOrder = 3
			w.ZIndex = 52
			w.Parent = card
		end

		-- Boutons
		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 4; btns.ZIndex = 52; btns.Parent = card
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 10, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder
		bg.Parent = btns

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 52; w1.Parent = btns
		local cancelBtn = actionButton(w1, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Annuler", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })
		cancelBtn.MouseButton1Click:Connect(close)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 52; w2.Parent = btns
		local okBtn, okLbl = actionButton(w2, {
			color = C.BG_MEDIUM, strokeColor = C.BORDER_SUBTLE,
			text = "⏳ " .. delay .. " s",
			textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52,
		})

		-- Compte à rebours : le bouton ne devient actif qu'à la fin
		local armed = false
		task.spawn(function()
			for remaining = delay, 1, -1 do
				if closed then return end
				okLbl.Text = "⏳ Lis d'abord — " .. remaining .. " s"
				task.wait(1)
			end
			if closed then return end
			armed = true
			okBtn.BackgroundColor3 = opts.danger and C.RED or C.GREEN
			okLbl.Text = opts.confirmText or "✅ Confirmer"
		end)

		okBtn.MouseButton1Click:Connect(function()
			if not armed then
				toast("Prends le temps de lire — le bouton s'active tout seul", false)
				return
			end
			close()
			if opts.onConfirm then opts.onConfirm() end
		end)

		return close
	end

	----------------------------------------------------------------------
	-- ⚙️ ONGLET RÉGLAGES
	----------------------------------------------------------------------
	-- Applique un réglage et l'enregistre tout de suite (après confirmation)
	local function applyCfg(key, value, okMsg)
		if not setCfg or not S.cfg then toast("Réglages pas chargés", false); return end
		local payload = {}
		for k, v in pairs(S.cfg) do payload[k] = v end
		payload[key] = value

		task.spawn(function()
			local ok, res = pcall(function() return setCfg:InvokeServer(payload) end)
			if ok and type(res) == "table" and res.ok then
				S.cfg = res.config or payload
				S.dirty = false
				toast(okMsg or "Réglage appliqué ✅", true)
			else
				toast((type(res) == "table" and res.msg) or "Échec de l'enregistrement", false)
			end
			screen(false)
		end)
	end

	-- Interrupteur : titre, état actuel expliqué, et confirmation détaillée
	local function switchRow(parent, order, opt)
		local value = opt.value
		local onCol = opt.onColor or C.GREEN

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 9)
		stroke(box, value and onCol or C.BORDER_SUBTLE, value and 1.5 or 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 4)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = box
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 4); bp.PaddingBottom = UDim.new(0, 9)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = box

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		btn.BackgroundTransparency = 1
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.LayoutOrder = 1
		btn.ZIndex = 12
		btn.Parent = box

		local pw = IS_MOBILE and 52 or 64
		label(btn, {
			text = opt.title,
			size = UDim2.new(1, -pw - 10, 1, 0),
			position = UDim2.new(0, 0, 0, 0),
			xAlign = Enum.TextXAlignment.Left,
			color = value and C.TEXT_WHITE or C.TEXT_GREY,
			textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 13,
		})

		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, 0, 0.5, 0)
		pill.Size = UDim2.new(0, pw, 0, IS_MOBILE and 22 or 26)
		pill.BackgroundColor3 = value and onCol or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = value and "ON" or "OFF"
		pill.TextColor3 = value and C.BG_BLACK or C.TEXT_GREY
		pill.TextSize = IS_MOBILE and 11 or 13
		pill.ZIndex = 13
		pill.Parent = btn
		corner(pill, 6)

		local d = Instance.new("TextLabel")
		d.Size = UDim2.new(1, 0, 0, 0)
		d.AutomaticSize = Enum.AutomaticSize.Y
		d.BackgroundTransparency = 1
		d.Font = FONT
		d.Text = value and opt.onDesc or opt.offDesc
		d.TextColor3 = C.TEXT_DIM
		d.TextSize = IS_MOBILE and 9 or 11
		d.TextWrapped = true
		d.TextXAlignment = Enum.TextXAlignment.Left
		d.LayoutOrder = 2
		d.ZIndex = 12
		d.Parent = box

		btn.MouseButton1Click:Connect(function()
			local newValue = not value
			local goingDangerous = (newValue and opt.dangerOn) or (not newValue and opt.dangerOff)

			confirmDialog({
				title = (newValue and "Activer" or "Désactiver") .. " : " .. opt.title,
				danger = goingDangerous == true,
				delay  = goingDangerous and 5 or 3,
				confirmText = newValue and "✅ Activer" or "✅ Désactiver",
				lines = {
					"Tu passes ce réglage de " .. (value and "ON" or "OFF")
						.. " à " .. (newValue and "ON" or "OFF") .. ".",
					"À partir de maintenant :\n" .. (newValue and opt.onDesc or opt.offDesc),
					"Ce que ça change concrètement :\n"
						.. (newValue and (opt.onEffect or "—") or (opt.offEffect or "—")),
				},
				warn = goingDangerous and (newValue and opt.warnOn or opt.warnOff) or nil,
				onConfirm = function()
					applyCfg(opt.key, newValue,
						opt.title .. " → " .. (newValue and "ON" or "OFF"))
				end,
			})
		end)

		return box
	end

	local function stepper(parent, order, value, minV, maxV, step, suffix, onSet)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		row.BackgroundColor3 = C.BG_DARK
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 8); stroke(row, CY, 1)

		local bw = IS_MOBILE and 38 or 46
		local function sideBtn(isPlus)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(isPlus and 1 or 0, 0.5)
			c.Position = UDim2.new(isPlus and 1 or 0, isPlus and -6 or 6, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 28 or 34)
			c.BackgroundTransparency = 1
			c.ZIndex = 12
			c.Parent = row
			local b = actionButton(c, {
				color = isPlus and C.GREEN or C.BG_LIGHT,
				strokeColor = isPlus and C.GREEN_DARK or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 16 or 20, radius = 7, zIndex = 12,
			})
			b.MouseButton1Click:Connect(function()
				onSet(math.clamp(value + (isPlus and step or -step), minV, maxV))
			end)
		end
		sideBtn(false); sideBtn(true)

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.Position = UDim2.new(0.5, 0, 0.5, 0)
		box.Size = UDim2.new(1, -(bw * 2 + 24), 1, -10)
		box.BackgroundTransparency = 1
		box.Font = FONT
		box.Text = tostring(value) .. " " .. suffix
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 14 or 17
		box.ClearTextOnFocus = true
		box.ZIndex = 12
		box.Parent = row
		box.FocusLost:Connect(function()
			local v = tonumber(box.Text:match("%d+"))
			if v then onSet(math.clamp(math.floor(v), minV, maxV))
			else box.Text = tostring(value) .. " " .. suffix end
		end)
		return row
	end

	local function renderCfg(body)
		local cfg = S.cfg
		if not cfg then
			local msg = (not getCfg) and "❌ A_UGCEscrow.server.lua (v3) pas installé."
				or (S.cfgFailed and "⚠️ Réglages illisibles. Appuie sur 🔄 en haut." or "Chargement...")
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = body
			label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
				color = S.cfgFailed and C.ORANGE or C.TEXT_GREY,
				textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			return
		end

		note(body, 0, "Chaque interrupteur demande une confirmation qui explique ce qu'il "
			.. "fait, avec quelques secondes d'attente avant de pouvoir valider. Les "
			.. "garanties anti-exploit (points déduits avant le prompt, créance écrite avant "
			.. "la livraison, remboursement verrouillé) ne dépendent d'AUCUN de ces réglages : "
			.. "elles restent actives quoi que tu coches.", CY)

		sectionLabel(body, 1, "RÉCUPÉRATION DES POINTS")

		switchRow(body, 2, {
			key = "debtEnabled", value = cfg.debtEnabled, title = "💸 Système de dette",
			onColor = C.ORANGE, dangerOff = true,
			onDesc = "Si on doit reprendre des points à un joueur et que son solde ne suffit "
				.. "pas, le reliquat devient une dette, prélevée dès qu'il a de quoi payer.",
			offDesc = "Le reliquat est simplement effacé. Rien n'est jamais récupéré.",
			onEffect = "Un joueur remboursé à tort qui dépense les points avant de revenir "
				.. "finit avec une dette, et on récupère la différence plus tard. C'est la "
				.. "dernière pièce qui empêche d'avoir deux UGC pour le prix d'une.",
			offEffect = "Les reliquats sont abandonnés. Tu verras des lignes « 💨 Reliquat "
				.. "effacé » dans le journal au lieu de « 🔴 DETTE ».",
			warnOff = "⚠️ En éteignant ça, tu ouvres une petite fenêtre : si un "
				.. "remboursement part à tort et que le joueur dépense les points avant de "
				.. "se reconnecter, ils sont perdus pour de bon. Ce n'est PAS ce réglage qui "
				.. "gênait tes joueurs honnêtes — c'est le blocage des achats, juste en "
				.. "dessous, qui est déjà éteint.",
		})

		if cfg.debtEnabled then
			switchRow(body, 3, {
				key = "debtBlocksPurchases", value = cfg.debtBlocksPurchases,
				title = "🔒 Bloquer les achats en cas de dette",
				onColor = C.RED, dangerOn = true,
				onDesc = "Un joueur qui doit des points ne peut plus rien acheter tant qu'il "
					.. "n'a pas réglé.",
				offDesc = "Il peut continuer à acheter normalement. La dette est prélevée en "
					.. "arrière-plan dès qu'il a de quoi payer.",
				onEffect = "Tout joueur avec la moindre dette voit ses achats UGC refusés. "
					.. "Y compris ceux dont la dette vient d'un bug ou d'une déconnexion.",
				offEffect = "Personne n'est jamais bloqué. Chaque achat coûte de toute façon "
					.. "le prix plein, donc rester endetté ne rapporte rien.",
				warnOn = "⚠️ C'est CE réglage qui punissait tes joueurs honnêtes, pas la "
					.. "dette elle-même. Ne le rallume que si tu constates des abus répétés.",
			})
		end

		sectionLabel(body, 5, "REMBOURSEMENTS AUTOMATIQUES")

		switchRow(body, 6, {
			key = "autoRefund", value = cfg.autoRefund, title = "↩️ Remboursement automatique",
			onColor = C.GREEN, dangerOff = true,
			onDesc = "Un joueur dont la vérification prouve qu'il n'a PAS reçu son UGC est "
				.. "recrédité tout seul à sa reconnexion.",
			offDesc = "Rien d'automatique. Chaque cas t'attend dans l'onglet 🔴 Ouverts et tu "
				.. "cliques ↩️ Rembourser toi-même.",
			onEffect = "Un crash ou une coupure réseau pendant un achat ne coûte plus rien au "
				.. "joueur : il retrouve ses points à sa prochaine connexion.",
			offEffect = "Chaque incident devient du travail manuel pour toi. Un joueur qui "
				.. "plante pendant un achat de 2 000 000 points attend que tu t'en occupes.",
			warnOff = "⚠️ Sans ça, un simple crash fait perdre ses points à un joueur "
				.. "honnête jusqu'à ce que tu interviennes à la main.",
		})

		sectionLabel(body, 7, "DÉLAI AVANT DE VÉRIFIER LA POSSESSION")
		stepper(body, 8, cfg.verifyDelay, 5, 300, 5, "secondes", function(v)
			cfg.verifyDelay = v ; S.dirty = true ; screen(false)
		end)
		note(body, 9, "Après un échec d'achat annoncé par Roblox, on attend ce délai avant de "
			.. "demander « possède-t-il l'item ? ». L'inventaire Roblox met du temps à se "
			.. "propager : trop court, et on rembourse des achats qui ont pourtant abouti — "
			.. "c'est ce qui créait ensuite des dettes injustifiées. "
			.. (cfg.verifyDelay < 20
				and "⚠️ En dessous de 20 s, tu reprends le risque."
				or "30 s est un bon compromis."),
			cfg.verifyDelay < 20 and C.ORANGE or C.TEXT_DIM)

		sectionLabel(body, 10, "SURVEILLANCE")

		switchRow(body, 11, {
			key = "suspicionEnabled", value = cfg.suspicionEnabled, title = "🚨 Score de suspicion",
			onColor = C.PURPLE,
			onDesc = "Chaque situation douteuse ajoute des points à un score visible dans "
				.. "l'onglet 🚨 Suspects.",
			offDesc = "Plus aucun score n'est calculé. Les événements restent tous tracés "
				.. "dans le journal.",
			onEffect = "Tu vois qui accumule des situations bizarres. Purement indicatif : "
				.. "ça ne protège rien, la faille est déjà fermée en amont.",
			offEffect = "L'onglet 🚨 Suspects se vide au fil du temps. Le ban automatique "
				.. "devient inopérant.",
		})

		switchRow(body, 12, {
			key = "autoBan", value = cfg.autoBan, title = "🔨 Ban automatique",
			onColor = C.RED, dangerOn = true,
			onDesc = "Ban si le score de suspicion dépasse le seuil ET qu'au moins une vraie "
				.. "dette existe.",
			offDesc = "Aucun ban automatique. Tu bannis toi-même depuis le panel.",
			onEffect = "Des joueurs peuvent être bannis définitivement sans que tu aies "
				.. "regardé leur dossier.",
			offEffect = "Rien ne se passe tout seul. Tu gardes la main sur chaque sanction.",
			warnOn = "⚠️ Un ban automatique est définitif et part sans que tu aies vu le "
				.. "dossier. Regarde d'abord l'onglet 🚨 Suspects pendant quelques semaines "
				.. "pour juger si les signaux sont fiables chez toi.",
		})

		if cfg.autoBan and not cfg.debtEnabled then
			note(body, 13, "ℹ️ Le ban automatique exige une dette réelle pour se déclencher. "
				.. "Avec le système de dette éteint, il ne se déclenchera jamais.", C.TEXT_DIM)
		end

		sectionLabel(body, 14, "AUDIT DE POSSESSION")

		switchRow(body, 15, {
			key = "auditEnabled", value = cfg.auditEnabled, title = "🔍 Audit toutes les 24 h",
			onColor = WARN, dangerOn = true,
			onDesc = "Une fois par jour et par joueur, on vérifie s'il possède des UGC du shop "
				.. "sans achat enregistré.",
			offDesc = "Aucun audit. Les UGC obtenues hors du shop ne sont plus détectées "
				.. "automatiquement.",
			onEffect = "Un appel Roblox par UGC du catalogue et par joueur, chaque jour. "
				.. "Ça remplit les logs d'avertissements et ça consomme la vérification "
				.. "fiable qui sert aux créances.",
			offEffect = "Zéro appel supplémentaire, logs propres, et les vérifications de "
				.. "créance restent fiables.",
			warnOn = "⚠️ C'est l'audit qui remplissait tes logs d'avertissements jaunes. "
				.. "Ne le rallume que si tu cherches activement des UGC obtenues hors shop.",
		})

		sectionLabel(body, 16, "MISE DE CÔTÉ DES CRÉANCES BLOQUÉES")
		stepper(body, 17, cfg.parkAfterHours, 1, 168, 1, "heures", function(v)
			cfg.parkAfterHours = v ; S.dirty = true ; screen(false)
		end)
		note(body, 18, "Quand la vérification est impossible, la créance était conservée "
			.. "indéfiniment et le joueur ne pouvait plus rien acheter. Passé ce délai (ou "
			.. tostring(cfg.parkAfterFails) .. " tentatives), elle est mise de côté : le "
			.. "joueur est libre, la créance t'attend dans l'onglet 🅿️, et le système retente "
			.. "tout seul à chaque reconnexion.", CY)

		-- Enregistrement des valeurs numériques (les interrupteurs s'appliquent seuls)
		if S.dirty then
			bigBtn(body, 20, "💾 ENREGISTRER LES DURÉES", C.GREEN, C.GREEN_DARK, function()
				confirmDialog({
					title = "Enregistrer les durées",
					delay = 3,
					confirmText = "💾 Enregistrer",
					lines = {
						"Tu vas appliquer ces valeurs sur TOUS tes serveurs :",
						"⏱️ Vérification de possession : " .. tostring(cfg.verifyDelay) .. " s\n"
							.. "🅿️ Mise de côté après : " .. tostring(cfg.parkAfterHours) .. " h",
						"Les parties en cours ne sont pas perturbées : le changement ne "
							.. "s'applique qu'aux achats suivants.",
					},
					warn = (cfg.verifyDelay < 20)
						and "⚠️ Un délai sous 20 s fait rembourser des achats qui ont "
						.. "pourtant abouti, et recrée des dettes injustifiées." or nil,
					danger = cfg.verifyDelay < 20,
					onConfirm = function()
						applyCfg("verifyDelay", cfg.verifyDelay, "Durées enregistrées ✅")
					end,
				})
			end)
		end

		local st = S.stats or {}
		local _, rows = statCard(body, 21, "📊 DEPUIS LE DÉMARRAGE DE CE SERVEUR", CY)
		statLine(rows, 1, "✅ Achats confirmés", tostring(st.confirms or 0), C.GREEN)
		statLine(rows, 2, "↩️ Remboursements", tostring(st.refunds or 0), C.TEXT_WHITE)
		statLine(rows, 3, "🅿️ Créances mises de côté", tostring(st.parked or 0),
			(st.parked or 0) > 0 and CY or C.TEXT_DIM)
		statLine(rows, 4, "💨 Reliquats effacés", tostring(st.waived or 0),
			(st.waived or 0) > 0 and WARN or C.TEXT_DIM)
		statLine(rows, 5, "🔴 Dettes créées", tostring(st.debts or 0),
			(st.debts or 0) > 0 and C.RED or C.GREEN)
		statLine(rows, 6, "💸 Points repris sur dettes", fmtNum(st.collected or 0), C.TEXT_WHITE)
		statLine(rows, 7, "🩹 Dettes annulées à la main", fmtNum(st.forgiven or 0), C.TEXT_GREY)
		statLine(rows, 8, "🎽 UGC au catalogue", tostring(S.shopSize or 0), C.TEXT_GREY)
	end

	----------------------------------------------------------------------
	-- 📜 ONGLET JOURNAL
	----------------------------------------------------------------------
	local function logCard(parent, order, e, backFn)
		local uid   = tonumber(e.u) or 0
		local uname = unameCache[uid] or e.n or tostring(uid)
		local meta  = ev(e.ev)
		local H     = IS_MOBILE and 66 or 78

		local c = Instance.new("TextButton")
		c.Size = UDim2.new(1, 0, 0, H)
		c.BackgroundColor3 = C.BG_DARK
		c.AutoButtonColor = false ; c.Text = "" ; c.BorderSizePixel = 0
		c.LayoutOrder = order ; c.ZIndex = 11 ; c.Parent = parent
		corner(c, 10)
		local cs = stroke(c, meta.c, 1)

		local imgS = H - 18
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(0, imgS, 0, imgS)
		img.Position = UDim2.new(0, 8, 0.5, 0) ; img.AnchorPoint = Vector2.new(0, 0.5)
		img.BackgroundColor3 = C.BG_ITEM ; img.BorderSizePixel = 0
		img.Image = (function(v) v = tostring(v); return v:find("://") and v or ("rbxassetid://" .. v) end)(e.ai or e.a or 0)
		img.ScaleType = Enum.ScaleType.Fit ; img.ZIndex = 12 ; img.Parent = c
		corner(img, 7)

		local tx  = 8 + imgS + 10
		local prW = IS_MOBILE and 78 or 100

		label(c, { text = meta.l,
			size = UDim2.new(1, -tx - prW - 10, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 6 or 9),
			xAlign = Enum.TextXAlignment.Left, color = meta.c,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12 })

		label(c, { text = (e.p and e.p > 0) and ("💎 " .. fmtNum(e.p)) or "—",
			size = UDim2.new(0, prW, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(1, -8, 0, IS_MOBILE and 6 or 9), anchor = Vector2.new(1, 0),
			xAlign = Enum.TextXAlignment.Right, color = Color3.fromRGB(120, 220, 255),
			textSize = IS_MOBILE and 11 or 14, zIndex = 12 })

		label(c, { text = esc(tostring(e.an or "?")) .. "  <font color=\"#8A8A98\">@" .. esc(uname) .. "</font>",
			richText = true,
			size = UDim2.new(1, -tx - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 23 or 29),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 11 or 13, truncate = true, zIndex = 12 })

		local nt = (e.nt and e.nt ~= "") and e.nt or (e.st and ("état " .. tostring(e.st)) or "")
		label(c, { text = fmtAgo(e.t) .. (nt ~= "" and ("  ·  " .. nt) or ""),
			size = UDim2.new(1, -tx - 12, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 41 or 51),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })

		c.MouseEnter:Connect(function() c.BackgroundColor3 = C.BG_MEDIUM ; cs.Color = CY end)
		c.MouseLeave:Connect(function() c.BackgroundColor3 = C.BG_DARK ; cs.Color = meta.c end)
		c.MouseButton1Click:Connect(function()
			screenManage({ userId = uid, displayName = e.n or uname, username = uname,
				sub = meta.l .. " · " .. tostring(e.an) }, backFn)
		end)
	end

	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs(S.entries) do
			local g = ev(e.ev).g
			local okF = (S.filter == "all") or (g == S.filter)
			local okQ = true
			if #q > 0 then
				local un = (unameCache[tonumber(e.u) or 0] or ""):lower()
				okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
					or (un:find(q, 1, true) ~= nil)
					or (tostring(e.an or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.ev or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.u) == q)
			end
			if okF and okQ then table.insert(out, e) end
		end
		table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
		return out
	end

	local function renderLog(body, back)
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		sw.BackgroundTransparency = 1 ; sw.LayoutOrder = 1 ; sw.ZIndex = 11 ; sw.Parent = body

		local sb = Instance.new("TextBox")
		sb.Size = UDim2.new(1, 0, 1, 0) ; sb.BackgroundColor3 = C.BG_DARK
		sb.BorderSizePixel = 0 ; sb.Font = FONT
		sb.PlaceholderText = "🔍 Joueur, UserID, UGC ou type d'événement..."
		sb.PlaceholderColor3 = C.TEXT_DIM ; sb.Text = S.search or ""
		sb.TextColor3 = C.TEXT_WHITE ; sb.TextSize = IS_MOBILE and 11 or 14
		sb.TextXAlignment = Enum.TextXAlignment.Left ; sb.ClearTextOnFocus = false
		sb.ZIndex = 12 ; sb.Parent = sw
		corner(sb, 8) ; stroke(sb, C.BORDER_SUBTLE, 1)
		local sp = Instance.new("UIPadding") ; sp.PaddingLeft = UDim.new(0, 10) ; sp.Parent = sb

		acTabBar(body, 2, {
			{ id = "all",   label = "🌐 Tout" },
			{ id = "risk",  label = "🚨 À risque" },
			{ id = "money", label = "💎 Argent" },
			{ id = "flow",  label = "⚙️ Flux" },
		}, S.filter, C.RED, function(id) S.filter = id ; screen(false) end)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1 ; cf.LayoutOrder = 3 ; cf.ZIndex = 11 ; cf.Parent = body
		local cl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0) ; holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1 ; holder.LayoutOrder = 4 ; holder.ZIndex = 11
		holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder ; hl.Parent = holder

		local render
		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			local list = visible()
			local risk = 0
			for _, e in ipairs(S.entries) do if ev(e.ev).g == "risk" then risk = risk + 1 end end
			cl.Text = string.format("%d affiché(s)  •  %d chargé(s)  •  %d à risque",
				#list, #S.entries, risk)

			if #list == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 60) ; f.BackgroundTransparency = 1
				f.LayoutOrder = 1 ; f.ZIndex = 11 ; f.Parent = holder
				label(f, { text = "Rien ne correspond à ces filtres.", size = UDim2.fromScale(1, 1),
					color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			else
				for i, e in ipairs(list) do logCard(holder, i, e, back) end
			end

			if S.hasMore then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1 ; mc.LayoutOrder = 99999
				mc.ZIndex = 11 ; mc.Parent = holder
				local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger plus", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					local ok, res = pcall(function() return getLog:InvokeServer(S.cursor, 30) end)
					if ok and type(res) == "table" then
						local ids = {}
						for _, e in ipairs(res.entries or {}) do
							table.insert(S.entries, e) ; table.insert(ids, e.u)
						end
						S.cursor, S.hasMore = res.cursor, res.hasMore == true
						resolveUsernames(ids, function() resolvePoints(ids, function() render() end) end)
					else render() end
				end)
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text ; render()
		end)

		render()
	end

	----------------------------------------------------------------------
	-- 🔴 ONGLET CRÉANCES OUVERTES
	----------------------------------------------------------------------
	local function openRow(parent, order, entry, back)
		local uid   = entry.userId
		local uname = unameCache[uid] or tostring(uid)
		local info  = entry.info or {}
		local o     = info.open or {}

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0) ; box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK ; box.BorderSizePixel = 0
		box.LayoutOrder = order ; box.ZIndex = 11 ; box.Parent = parent
		corner(box, 10) ; stroke(box, C.ORANGE, 1.5) ; padding(box, 10)

		local l = Instance.new("UIListLayout") ; l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder ; l.Parent = box

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		head.BackgroundTransparency = 1 ; head.LayoutOrder = 1 ; head.ZIndex = 12 ; head.Parent = box

		local avS = IS_MOBILE and 30 or 36
		local av = makeAvatar(head, uid, avS, C.ORANGE)
		av.AnchorPoint = Vector2.new(0, 0.5) ; av.Position = UDim2.new(0, 0, 0.5, 0)

		label(head, { text = esc(uname) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -avS - 10, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 1 or 2),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })
		label(head, { text = string.format("💎 %s pts gelés  ·  état %s  ·  %s",
			fmtNum(o.p or 0), tostring(o.st or "?"), fmtAgo(o.t or entry.value)),
			size = UDim2.new(1, -avS - 10, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = C.ORANGE,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13 })

		local acts = Instance.new("Frame")
		acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		acts.BackgroundTransparency = 1 ; acts.LayoutOrder = 2 ; acts.ZIndex = 12 ; acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1/4, -5, 1, 0) ; g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder ; g.Parent = acts

		local function act(o2, text, col, colD, fn)
			local wrap = Instance.new("Frame")
			wrap.LayoutOrder = o2 ; wrap.BackgroundTransparency = 1 ; wrap.ZIndex = 12 ; wrap.Parent = acts
			local b = actionButton(wrap, { color = col, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(fn)
		end

		act(1, IS_MOBILE and "🔎" or "🔎 Résoudre", CY, C.TURQUOISE_DARK, function()
			callAct("resolve", { userId = uid }, function() task.wait(0.5) screen(false) end)
		end)

		act(2, IS_MOBILE and "✅" or "✅ Confirmer", C.GREEN, C.GREEN_DARK, function()
			confirmDialog({
				title = "Confirmer l'achat de " .. uname,
				danger = true, delay = 4, confirmText = "✅ Confirmer l'achat",
				lines = {
					"Tu déclares que ce joueur a bien reçu son UGC.",
					"Les " .. fmtNum(o.p or 0) .. " points déjà déduits restent déduits. "
						.. "La créance est soldée et il pourra racheter d'autres UGC.",
					"À faire seulement si tu as vérifié qu'il possède vraiment l'item.",
				},
				warn = "⚠️ S'il ne l'a pas reçue, il perd ses points définitivement. "
					.. "Dans le doute, utilise 🔎 Résoudre : le serveur vérifie tout seul.",
				onConfirm = function()
					callAct("confirm", { userId = uid }, function() task.wait(0.5) screen(false) end)
				end,
			})
		end)

		act(3, IS_MOBILE and "↩️" or "↩️ Rembourser", C.ORANGE, C.ORANGE_DARK, function()
			confirmDialog({
				title = "Rembourser " .. uname,
				danger = true, delay = 4, confirmText = "↩️ Rembourser",
				lines = {
					"Tu vas rendre " .. fmtNum(o.p or 0) .. " points à ce joueur.",
					"Le serveur refusera tout seul s'il constate qu'il possède déjà l'UGC — "
						.. "tu ne peux pas offrir un item par erreur.",
					"La créance est fermée avant le versement, donc aucun risque de payer "
						.. "deux fois.",
				},
				warn = "⚠️ Le joueur doit être en ligne pour être remboursé.",
				onConfirm = function()
					callAct("refund", { userId = uid }, function() task.wait(0.5) screen(false) end)
				end,
			})
		end)

		act(4, IS_MOBILE and "👤" or "👤 Profil", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(uname, back)
		end)
	end

	----------------------------------------------------------------------
	-- 💸 ONGLET DETTES
	----------------------------------------------------------------------
	local function debtRow(parent, order, uid, value, info, back)
		local uname = unameCache[uid] or tostring(uid)
		local amount = tonumber(value) or 0

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, C.RED, 1.5); padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = box

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local avS = IS_MOBILE and 30 or 36
		local av = makeAvatar(head, uid, avS, C.RED)
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 0, 0.5, 0)

		local amtW = IS_MOBILE and 92 or 118
		label(head, { text = esc(uname) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -avS - amtW - 16, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 1 or 2),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })
		label(head, { text = "ID " .. tostring(uid)
			.. ((info and info.debtCount and info.debtCount > 1)
				and ("  ·  " .. info.debtCount .. " incidents") or ""),
			size = UDim2.new(1, -avS - amtW - 16, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13 })

		label(head, { text = "🔴 " .. fmtNum(amount) .. "\npts dus",
			size = UDim2.new(0, amtW, 1, 0),
			position = UDim2.new(1, 0, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right, color = C.RED,
			textSize = IS_MOBILE and 11 or 13, zIndex = 13 })

		local online = Players:GetPlayerByUserId(uid) ~= nil
		local ctx = Instance.new("TextLabel")
		ctx.Size = UDim2.new(1, 0, 0, 0)
		ctx.AutomaticSize = Enum.AutomaticSize.Y
		ctx.BackgroundColor3 = C.BG_ITEM
		ctx.BackgroundTransparency = 0.35
		ctx.BorderSizePixel = 0
		ctx.Font = FONT
		ctx.Text = online
			and "🟢 En ligne — le prélèvement peut se faire tout de suite."
			or "⚪ Hors ligne — la dette sera prélevée toute seule à sa reconnexion, "
			.. "dès qu'il aura de quoi payer."
		ctx.TextColor3 = online and C.GREEN or C.TEXT_GREY
		ctx.TextSize = IS_MOBILE and 9 or 11
		ctx.TextWrapped = true
		ctx.TextXAlignment = Enum.TextXAlignment.Left
		ctx.TextYAlignment = Enum.TextYAlignment.Top
		ctx.LayoutOrder = 2
		ctx.ZIndex = 12
		ctx.Parent = box
		corner(ctx, 7)
		local cp = Instance.new("UIPadding")
		cp.PaddingTop = UDim.new(0, 6); cp.PaddingBottom = UDim.new(0, 6)
		cp.PaddingLeft = UDim.new(0, 8); cp.PaddingRight = UDim.new(0, 8)
		cp.Parent = ctx

		local acts = Instance.new("Frame")
		acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		acts.BackgroundTransparency = 1
		acts.LayoutOrder = 3; acts.ZIndex = 12; acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local function act(o, text, col, colD, fn)
			local w = Instance.new("Frame")
			w.LayoutOrder = o; w.BackgroundTransparency = 1; w.ZIndex = 12; w.Parent = acts
			local b = actionButton(w, { color = col, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(fn)
		end

		act(1, IS_MOBILE and "🩹 Annuler" or "🩹 Annuler la dette", C.GREEN, C.GREEN_DARK, function()
			confirmDialog({
				title = "Annuler la dette de " .. uname,
				delay = 4, confirmText = "🩹 Annuler la dette",
				lines = {
					"Tu effaces " .. fmtNum(amount) .. " points de dette.",
					"Le joueur ne perd rien et ne paiera jamais cette somme. Si le blocage "
						.. "des achats est actif, il redevient libre d'acheter immédiatement.",
					"L'annulation est tracée dans le journal avec ton nom.",
				},
				warn = "⚠️ Irréversible. Si la dette venait d'un vrai abus, tu offres "
					.. fmtNum(amount) .. " points.",
				onConfirm = function()
					callAct("forgive_debt", { userId = uid }, function()
						S.debtLoaded = false ; screen(false)
					end)
				end,
			})
		end)

		act(2, IS_MOBILE and "💸 Prélever" or "💸 Prélever maintenant", C.ORANGE, C.ORANGE_DARK, function()
			confirmDialog({
				title = "Prélever la dette de " .. uname,
				delay = 3, confirmText = "💸 Prélever",
				lines = {
					"Tu tentes de reprendre " .. fmtNum(amount) .. " points tout de suite.",
					"On ne prend que ce qu'il a : si son solde ne suffit pas, le reste "
						.. "attend et sera prélevé plus tard.",
					online and "Le joueur est en ligne, ça va marcher."
						or "⚠️ Le joueur est hors ligne : le prélèvement se fera tout seul "
						.. "à sa reconnexion.",
				},
				onConfirm = function()
					callAct("collect_debt", { userId = uid }, function()
						task.wait(0.4) ; S.debtLoaded = false ; screen(false)
					end)
				end,
			})
		end)

		act(3, IS_MOBILE and "👤 Profil" or "👤 Profil", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(uname, back)
		end)
	end

	local function renderDebt(body, back)
		local cfg = S.cfg
		note(body, 0, "Une dette veut dire : on a dû reprendre des points au joueur (parce "
			.. "qu'il a bien reçu son UGC après un remboursement), et son solde ne suffisait "
			.. "pas. Le reliquat est prélevé automatiquement dès qu'il a de quoi payer. Si tu "
			.. "penses que c'est une erreur, annule-la — le joueur ne perd rien.", C.RED)

		if cfg and not cfg.debtEnabled then
			note(body, 1, "⚠️ Le système de dette est ÉTEINT dans les réglages. Ces dettes "
				.. "datent d'avant : elles ne sont plus prélevées et ne bloquent plus rien. "
				.. "Tu peux les annuler pour faire le ménage.", WARN)
		elseif cfg and cfg.debtBlocksPurchases then
			note(body, 1, "🔒 Le blocage des achats est ACTIF : ces joueurs ne peuvent rien "
				.. "acheter tant qu'ils n'ont pas réglé.", WARN)
		end

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 2; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 3; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		if not getOpen then cLbl.Text = "❌ Serveur pas à jour." return end

		if #S.debt == 0 then
			cLbl.Text = S.debtLoading and "Chargement..." or "0 joueur endetté"
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
			label(f, { text = S.debtLoading and "Chargement du registre..."
				or "✅ Personne ne doit de points. Tout est réglé.",
				size = UDim2.fromScale(1, 1), wrapped = true,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			return
		end

		local total = 0
		for _, e in ipairs(S.debt) do total = total + (tonumber(e.value) or 0) end
		cLbl.Text = string.format("%d joueur(s) endetté(s)  ·  %s pts au total",
			#S.debt, fmtNum(total))

		for i, e in ipairs(S.debt) do
			debtRow(holder, i, e.userId, e.value, e.info, back)
		end
	end

	----------------------------------------------------------------------
	-- 🅿️ ONGLET CRÉANCES MISES DE CÔTÉ
	----------------------------------------------------------------------
	local function parkRow(parent, order, uid, info, back)
		local uname = unameCache[uid] or tostring(uid)
		local list  = (info and info.parked) or {}

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, CY, 1.5); padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = box

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local avS = IS_MOBILE and 30 or 36
		local av = makeAvatar(head, uid, avS, CY)
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 0, 0.5, 0)

		label(head, { text = esc(uname) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -avS - 10, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 1 or 2),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })
		label(head, { text = string.format("🅿️ %d créance(s) de côté  ·  ID %d", #list, uid),
			size = UDim2.new(1, -avS - 10, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = CY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13 })

		for i, o in ipairs(list) do
			local det = Instance.new("TextLabel")
			det.Size = UDim2.new(1, 0, 0, 0)
			det.AutomaticSize = Enum.AutomaticSize.Y
			det.BackgroundColor3 = C.BG_ITEM
			det.BackgroundTransparency = 0.35
			det.BorderSizePixel = 0
			det.Font = FONT
			det.Text = string.format("#%d  ·  asset %s  ·  💎 %s pts  ·  ouverte %s\n%s",
				i, tostring(o.a), fmtNum(o.p or 0), fmtAgo(o.t or 0), tostring(o.why or ""))
			det.TextColor3 = C.TEXT_GREY
			det.TextSize = IS_MOBILE and 9 or 11
			det.TextWrapped = true
			det.TextXAlignment = Enum.TextXAlignment.Left
			det.TextYAlignment = Enum.TextYAlignment.Top
			det.LayoutOrder = 10 + i * 2
			det.ZIndex = 12
			det.Parent = box
			corner(det, 7)
			local dp = Instance.new("UIPadding")
			dp.PaddingTop = UDim.new(0, 6); dp.PaddingBottom = UDim.new(0, 6)
			dp.PaddingLeft = UDim.new(0, 8); dp.PaddingRight = UDim.new(0, 8)
			dp.Parent = det

			local acts = Instance.new("Frame")
			acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 32)
			acts.BackgroundTransparency = 1
			acts.LayoutOrder = 11 + i * 2; acts.ZIndex = 12; acts.Parent = box
			local g = Instance.new("UIGridLayout")
			g.CellSize = UDim2.new(0.5, -4, 1, 0)
			g.CellPadding = UDim2.new(0, 8, 0, 0)
			g.SortOrder = Enum.SortOrder.LayoutOrder
			g.Parent = acts

			local function act(o2, text, col, colD, fn)
				local w = Instance.new("Frame")
				w.LayoutOrder = o2; w.BackgroundTransparency = 1; w.ZIndex = 12; w.Parent = acts
				local b = actionButton(w, { color = col, strokeColor = colD, text = text,
					textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
				b.MouseButton1Click:Connect(fn)
			end

			act(1, IS_MOBILE and "↩️ Rembourser" or "↩️ Rembourser", C.ORANGE, C.ORANGE_DARK, function()
				confirmDialog({
					title = "Rembourser une créance de côté",
					danger = true, delay = 4, confirmText = "↩️ Rembourser",
					lines = {
						"Tu vas rendre " .. fmtNum(o.p or 0) .. " points à " .. uname .. ".",
						"Le serveur refusera tout seul s'il constate qu'il possède l'UGC.",
						"Cette créance n'a pas pu être vérifiée automatiquement — c'est "
							.. "pour ça qu'elle est ici.",
					},
					warn = "⚠️ Le joueur doit être en ligne.",
					onConfirm = function()
						callAct("park_refund", { userId = uid, index = i }, function()
							S.parkLoaded = false; screen(false)
						end)
					end,
				})
			end)

			act(2, IS_MOBILE and "✅ Solder" or "✅ Solder (il l'a eue)", C.GREEN, C.GREEN_DARK, function()
				confirmDialog({
					title = "Solder une créance de côté",
					danger = true, delay = 4, confirmText = "✅ Solder",
					lines = {
						"Tu déclares que " .. uname .. " a bien reçu cette UGC.",
						"Les " .. fmtNum(o.p or 0) .. " points restent déduits et la créance "
							.. "disparaît de cette liste.",
					},
					warn = "⚠️ S'il ne l'a pas reçue, il perd ses points définitivement.",
					onConfirm = function()
						callAct("park_confirm", { userId = uid, index = i }, function()
							S.parkLoaded = false; screen(false)
						end)
					end,
				})
			end)
		end

		local bottom = Instance.new("Frame")
		bottom.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 32)
		bottom.BackgroundTransparency = 1
		bottom.LayoutOrder = 9000; bottom.ZIndex = 12; bottom.Parent = box
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -4, 1, 0)
		bg.CellPadding = UDim2.new(0, 8, 0, 0)
		bg.Parent = bottom

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 12; w1.Parent = bottom
		local b1 = actionButton(w1, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "👤 Profil", textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
		b1.MouseButton1Click:Connect(function() openProfileDetail(uname, back) end)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 12; w2.Parent = bottom
		local b2 = actionButton(w2, { color = CY_D, strokeColor = CY,
			text = "🔎 Relancer la résolution", textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
		b2.MouseButton1Click:Connect(function()
			callAct("resolve", { userId = uid }, function()
				task.wait(1) S.parkLoaded = false screen(false)
			end)
		end)
	end

	local function renderPark(body, back)
		note(body, 0, "Ces créances n'ont pas pu être vérifiées (API Roblox indisponible, ou "
			.. "reconnexion trop rapide sur le même serveur). Elles sont mises de côté pour ne "
			.. "PAS bloquer les achats du joueur — ses points restent déduits, rien n'est "
			.. "offert. Le système retente tout seul à chaque reconnexion ; tu peux aussi "
			.. "trancher toi-même ici.", CY)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 1; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 2; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		if not getOpen then cLbl.Text = "❌ Serveur pas à jour." return end

		if #S.park == 0 then
			cLbl.Text = S.parkLoading and "Chargement..." or "0 créance de côté"
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
			label(f, { text = S.parkLoading and "Chargement du registre..."
				or "✅ Aucune créance mise de côté. Tout est résolu.",
				size = UDim2.fromScale(1, 1), wrapped = true,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			return
		end

		cLbl.Text = string.format("%d joueur(s) avec des créances de côté", #S.park)
		for i, e in ipairs(S.park) do
			parkRow(holder, i, e.userId, e.info, back)
		end
	end

	----------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "ugcescrow"

		if reset then
			S.entries, S.cursor, S.hasMore = {}, nil, false
			S.cfg = nil ; S.cfgFailed = false ; S.dirty = false
			S.park = {} ; S.parkLoaded = false
			S.debt = {} ; S.debtLoaded = false
		end

		local body = buildScreen("🔐 UGC ESCROW", true, CY, nil, function() screen(true) end)
		local back = function() screen(false) end

		-- Deux rangées d'onglets : les listes, puis le reste
		acTabBar(body, -2, {
			{ id = "log",  label = "📜 Journal" },
			{ id = "open", label = "🔴 Ouverts" },
			{ id = "park", label = "🅿️ De côté" .. (#S.park > 0 and (" (" .. #S.park .. ")") or "") },
		}, S.tab, CY, function(id) S.tab = id ; screen(false) end)

		acTabBar(body, -1, {
			{ id = "debt", label = "💸 Dettes" .. (#S.debt > 0 and (" (" .. #S.debt .. ")") or "") },
			{ id = "susp", label = "🚨 Suspects" },
			{ id = "cfg",  label = "⚙️ Réglages" },
		}, S.tab, CY, function(id) S.tab = id ; screen(false) end)

		if not getLog then
			note(body, 1, "❌ A_UGCEscrow.server.lua n'est pas installé dans ServerScriptService.",
				C.RED)
			return
		end

		local function refreshIfHere(tab)
			if currentScreen == "ugcescrow" and window.Visible and S.tab == tab then
				screen(false)
			end
		end

		-- Réglages : chargés dès qu'on en a besoin (aussi pour l'onglet Dettes)
		if not S.cfg and getCfg and not S.cfgLoading and not S.cfgFailed then
			S.cfgLoading = true
			task.spawn(function()
				local ok, res = pcall(function() return getCfg:InvokeServer() end)
				S.cfgLoading = false
				if ok and type(res) == "table" and type(res.config) == "table" then
					S.cfg      = res.config
					S.stats    = res.stats
					S.shopSize = res.shopSize or 0
				else
					S.cfgFailed = true
				end
				if S.tab == "cfg" or S.tab == "debt" then refreshIfHere(S.tab) end
			end)
		end

		--── ⚙️ RÉGLAGES ─────────────────────────────────────────
		if S.tab == "cfg" then
			renderCfg(body)
			return
		end

		--── 💸 DETTES ───────────────────────────────────────────
		if S.tab == "debt" then
			if not S.debtLoaded and getOpen and not S.debtLoading then
				S.debtLoading = true
				task.spawn(function()
					local ok, res = pcall(function() return getOpen:InvokeServer(50, "debt") end)
					S.debtLoading = false
					S.debtLoaded = true
					if ok and type(res) == "table" and type(res.entries) == "table" then
						S.debt = res.entries
						local ids = {}
						for _, e in ipairs(S.debt) do table.insert(ids, e.userId) end
						resolveUsernames(ids, function()
							resolvePoints(ids, function() refreshIfHere("debt") end)
						end)
					else
						refreshIfHere("debt")
					end
				end)
			end
			renderDebt(body, back)
			return
		end

		--── 🅿️ DE CÔTÉ ──────────────────────────────────────────
		if S.tab == "park" then
			if not S.parkLoaded and getOpen and not S.parkLoading then
				S.parkLoading = true
				task.spawn(function()
					local ok, res = pcall(function() return getOpen:InvokeServer(50, "park") end)
					S.parkLoading = false
					S.parkLoaded = true
					if ok and type(res) == "table" and type(res.entries) == "table" then
						S.park = res.entries
						local ids = {}
						for _, e in ipairs(S.park) do table.insert(ids, e.userId) end
						resolveUsernames(ids, function()
							resolvePoints(ids, function() refreshIfHere("park") end)
						end)
					else
						refreshIfHere("park")
					end
				end)
			end
			renderPark(body, back)
			return
		end

		--── 🔴 OUVERTS  /  🚨 SUSPECTS ──────────────────────────
		if S.tab == "open" or S.tab == "susp" then
			local isSusp = (S.tab == "susp")
			local st = Instance.new("Frame")
			st.Size = UDim2.new(1, 0, 0, 44) ; st.BackgroundTransparency = 1
			st.LayoutOrder = 2 ; st.ZIndex = 11 ; st.Parent = body
			local stl = label(st, { text = "Chargement...", size = UDim2.fromScale(1, 1),
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

			if not getOpen then stl.Text = "❌ Remote manquant." return end

			task.spawn(function()
				local ok, res = pcall(function()
					return getOpen:InvokeServer(50, isSusp and "susp" or "open")
				end)
				if not st.Parent then return end
				if not ok or type(res) ~= "table" or type(res.entries) ~= "table" then
					stl.Text = "Impossible de charger (réessaie 🔄)." return
				end
				local list = res.entries
				if #list == 0 then
					stl.Text = isSusp and "Aucun joueur suspect ✅" or "Aucune créance ouverte ✅"
					return
				end
				local ids = {}
				for _, e in ipairs(list) do table.insert(ids, e.userId) end
				resolveUsernames(ids, function()
					resolvePoints(ids, function()
						if not st.Parent then return end
						st:Destroy()
						if isSusp then
							note(body, 3, "Score = quits avec UGC livrée, dettes, UGC hors shop. "
								.. "Purement indicatif : la faille est déjà fermée en amont. "
								.. "Le ban automatique exige en plus une dette réelle.", C.TEXT_DIM)
							for i, e in ipairs(list) do
								acRow(body, 10 + i, i, e.userId, e.value, false, C.RED, back)
							end
						else
							for i, e in ipairs(list) do openRow(body, 10 + i, e, back) end
						end
					end)
				end)
			end)
			return
		end

		--── 📜 JOURNAL ──────────────────────────────────────────
		if #S.entries > 0 and not reset then
			renderLog(body, back)
			return
		end

		local ld = Instance.new("Frame")
		ld.Size = UDim2.new(1, 0, 0, 40) ; ld.BackgroundTransparency = 1
		ld.LayoutOrder = 1 ; ld.ZIndex = 11 ; ld.Parent = body
		local ldl = label(ld, { text = "Chargement du journal escrow...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		task.spawn(function()
			local ok, res = pcall(function() return getLog:InvokeServer(nil, 30) end)
			if not body.Parent then return end
			if not ok or type(res) ~= "table" then ldl.Text = "Impossible de charger (🔄)." return end
			S.entries = res.entries or {}
			S.cursor, S.hasMore = res.cursor, res.hasMore == true
			local ids = {}
			for _, e in ipairs(S.entries) do table.insert(ids, e.u) end
			resolveUsernames(ids, function()
				resolvePoints(ids, function()
					if currentScreen == "ugcescrow" and window.Visible and S.tab == "log" then
						screen(false)
					end
				end)
			end)
		end)
	end

	-- 🔗 On réutilise l'entrée de menu 🔐 ESCROW qui existe déjà dans ton script.
	ESC.screen = screen
end)()

--════════════════════════════════════════════════════════════════════════════
--  ✅ CE QUE TU VERRAS DANS 🔐 UGC ESCROW
--
--  📜 Journal — la séquence complète de chaque achat :
--       📤 Ouvert → ✅ Confirmé                    = achat normal
--       📤 Ouvert → ⚠️ Échec → ↩️ Remboursé        = annulation honnête
--       📤 Ouvert → 🚪 Quit → ✅ Livré avant quit  = LA TENTATIVE, neutralisée
--       📤 Ouvert → 🚪 Quit → 💸 Re-déduit + 🔴 DETTE = vol avec solde vidé
--       📷 Possédée avant                          = photo de départ, RAS
--       🌐 Hors shop                               = à vérifier
--     Le filtre « 🚨 À risque » ne garde que quit / re-déduction / dette /
--     hors shop. C'est ta liste de suspects.
--
--  🔴 Ouverts — les achats en cours (points gelés). Une créance qui traîne
--     plusieurs heures = joueur parti pendant un achat. Le bouton ↩️ refuse si
--     le joueur possède déjà l'UGC.
--
--  🅿️ De côté — les créances qu'on n'a pas pu vérifier. Elles ne bloquent plus
--     les achats du joueur, et le serveur retente tout seul à chaque rejoin.
--
--  💸 Dettes — qui doit quoi. 🩹 Annuler · 💸 Prélever · 👤 Profil.
--
--  🚨 Suspects — classement par score. Indicatif : le ban automatique exige en
--     plus une dette réelle, donc jamais un joueur qui plante.
--
--  ⚙️ Réglages — les interrupteurs, chacun avec une confirmation qui explique
--     ce qu'il fait et un compte à rebours avant validation.
--
--  👤 Profil — carte « 🔐 UGC ESCROW » : créance, dette, suspicion, UGC
--     validées, possédées hors shop, et tous les compteurs.
--════════════════════════════════════════════════════════════════════════════

--════════════════════════════════════════════════════════════════════════════
-- 📦 BLOC 4 — RÉGLAGES DU STOCK  (source du stock + édition manuelle)
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     Concrètement : après le `end)()` du bloc 🔐 ESCROW et après le pavé
--     de commentaires « ✅ CE QUE TU VERRAS ». Rien à supprimer.
--
--  Ce bloc ajoute un bouton « ⚙️ RÉGLAGES DU STOCK » en haut de ton écran
--  🎽 UGC LOG. Il n'ajoute AUCUNE variable au script principal (IIFE).
--
--  Prérequis serveur : le bloc UGCStock_LiveSystem.lua collé à la fin de ton
--  script serveur de stock.
--════════════════════════════════════════════════════════════════════════════
;(function()
	local HOUSE = Color3.fromRGB(255, 190, 90)    -- 📦 compteur maison
	local LIVE  = Color3.fromRGB(90, 220, 160)    -- 🌐 stock Roblox
	local HOUSE_D = Color3.fromRGB(150, 105, 25)
	local LIVE_D  = Color3.fromRGB(25, 120, 85)

	-- ⏳ Le bloc serveur ne se charge qu'APRÈS le `task.wait(3)` et le
	--    chargement DataStore du script de stock. Sur un serveur qui vient de
	--    démarrer, ses remotes peuvent donc arriver après nous. On ne fige pas
	--    la référence au chargement : on la recherche à chaque besoin.
	local R = {}

	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	-- 👁️ La visibilité est publiée par UGCSalesLock sous forme d'attributs
	--    répliqués : on la LIT gratuitement, sans aucun aller-retour serveur.
	--    Seule l'écriture passe par un remote.
	local function ugcHidden(assetId)
		local f = ReplicatedStorage:FindFirstChild("UGCSalesLock")
		if not f then return false end
		return f:GetAttribute("Hide_" .. tostring(assetId)) == true
	end

	task.spawn(function()
		for _, n in ipairs({ "AdminGetStockPanel", "AdminSetStockMode",
			"AdminStockAction", "AdminSetUGCVisible" }) do
			R[n] = ReplicatedStorage:WaitForChild(n, 40)
		end
		if not R.AdminGetStockPanel then
			warn("[Admin] AdminGetStockPanel toujours introuvable après 40 s → le bloc "
				.. "UGCStock_LiveSystem.lua est-il bien collé à la fin de ton script "
				.. "serveur de stock ? Regarde aussi la console serveur : une erreur plus "
				.. "haut dans ce script empêcherait le bloc de s'exécuter.")
		end
	end)

	local S = {
		data = nil, loading = false, failed = false, failMsg = nil,
		draftProxy = nil,   -- texte en cours de saisie, pas encore enregistré
	}

	local screen  -- forward decl

	------------------------------------------------------------------
	-- 🧱 PETITS COMPOSANTS
	------------------------------------------------------------------
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	-- Fenêtre de confirmation avec compte à rebours, comme dans la section escrow
	local function ask(opts)
		local wait = tonumber(opts.delay) or 3
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.45
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.94, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12)
		stroke(card, opts.accent or C.TURQUOISE, 1.5)
		padding(card, 12)

		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8)
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Parent = card

		local t = Instance.new("Frame")
		t.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t.BackgroundTransparency = 1
		t.LayoutOrder = 1; t.ZIndex = 52; t.Parent = card
		label(t, { text = opts.title or "Confirmer ?", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = opts.accent or C.TURQUOISE,
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 52 })

		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundColor3 = C.BG_ITEM
		body.BackgroundTransparency = 0.3
		body.BorderSizePixel = 0
		body.Font = FONT
		body.Text = table.concat(opts.lines or {}, "\n\n")
		body.TextColor3 = C.TEXT_WHITE
		body.TextSize = IS_MOBILE and 11 or 13
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.LayoutOrder = 2; body.ZIndex = 52; body.Parent = card
		corner(body, 8)
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 8)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = body

		if opts.warn then
			local w = Instance.new("TextLabel")
			w.Size = UDim2.new(1, 0, 0, 0)
			w.AutomaticSize = Enum.AutomaticSize.Y
			w.BackgroundTransparency = 1
			w.Font = FONT
			w.Text = opts.warn
			w.TextColor3 = opts.danger and C.RED or C.ORANGE
			w.TextSize = IS_MOBILE and 10 or 12
			w.TextWrapped = true
			w.TextXAlignment = Enum.TextXAlignment.Left
			w.LayoutOrder = 3; w.ZIndex = 52; w.Parent = card
		end

		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 4; btns.ZIndex = 52; btns.Parent = card
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 10, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder
		bg.Parent = btns

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 52; w1.Parent = btns
		local cancelBtn = actionButton(w1, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Annuler", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })
		cancelBtn.MouseButton1Click:Connect(close)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 52; w2.Parent = btns
		local okBtn, okLbl = actionButton(w2, { color = C.BG_MEDIUM, strokeColor = C.BORDER_SUBTLE,
			text = "⏳", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })

		local armed = false
		task.spawn(function()
			for r = wait, 1, -1 do
				if closed then return end
				okLbl.Text = "⏳ Lis d'abord — " .. r .. " s"
				task.wait(1)
			end
			if closed then return end
			armed = true
			okBtn.BackgroundColor3 = opts.danger and C.RED or (opts.accent or C.GREEN)
			okLbl.Text = opts.confirmText or "✅ Confirmer"
		end)

		okBtn.MouseButton1Click:Connect(function()
			if not armed then
				toast("Prends le temps de lire — le bouton s'active tout seul", false)
				return
			end
			close()
			if opts.onConfirm then opts.onConfirm() end
		end)
	end

	local function call(action, payload, after)
		local fn = remote("AdminStockAction")
		if not fn then toast("Le serveur n'a pas encore chargé le système de stock", false); return end
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" then
				toast(res.msg or (res.ok and "OK" or "Échec"), res.ok == true)
			else
				toast("Erreur de communication", false)
			end
			if after then after() end
		end)
	end

	local function saveCfg(patch, okMsg)
		local fn = remote("AdminSetStockMode")
		if not fn or not S.data then toast("Réglages pas chargés", false); return end
		local cfg = {}
		for k, v in pairs(S.data.cfg) do cfg[k] = v end
		for k, v in pairs(patch) do cfg[k] = v end

		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(cfg) end)
			if ok and type(res) == "table" and res.ok then
				toast(okMsg or res.msg or "Enregistré ✅", true)
			else
				toast((type(res) == "table" and res.msg) or "Échec de l'enregistrement", false)
			end
			S.data = nil
			screen(false)
		end)
	end

	------------------------------------------------------------------
	-- 🎛️ LES DEUX GROSSES CARTES DE MODE
	------------------------------------------------------------------
	local function modeCard(parent, order, opt)
		local sel = opt.selected
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 0)
		btn.AutomaticSize = Enum.AutomaticSize.Y
		btn.BackgroundColor3 = sel and C.BG_MEDIUM or C.BG_DARK
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.BorderSizePixel = 0
		btn.LayoutOrder = order
		btn.ZIndex = 11
		btn.Parent = parent
		corner(btn, 10)
		local bs = stroke(btn, sel and opt.color or C.BORDER_SUBTLE, sel and 2 or 1)
		padding(btn, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 4)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = btn

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = btn

		local pw = IS_MOBILE and 62 or 78
		label(head, { text = opt.title,
			size = UDim2.new(1, -pw - 8, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = sel and opt.color or C.TEXT_GREY,
			textSize = IS_MOBILE and 13 or 16, truncate = true, zIndex = 13 })

		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, 0, 0.5, 0)
		pill.Size = UDim2.new(0, pw, 0, IS_MOBILE and 20 or 24)
		pill.BackgroundColor3 = sel and opt.color or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = sel and "● ACTIF" or "activer"
		pill.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		pill.TextSize = IS_MOBILE and 9 or 11
		pill.ZIndex = 13
		pill.Parent = head
		corner(pill, 6)

		local d = Instance.new("TextLabel")
		d.Size = UDim2.new(1, 0, 0, 0)
		d.AutomaticSize = Enum.AutomaticSize.Y
		d.BackgroundTransparency = 1
		d.Font = FONT
		d.Text = opt.desc
		d.TextColor3 = C.TEXT_DIM
		d.TextSize = IS_MOBILE and 9 or 11
		d.TextWrapped = true
		d.TextXAlignment = Enum.TextXAlignment.Left
		d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = btn

		if not sel then
			btn.MouseEnter:Connect(function() bs.Color = opt.color end)
			btn.MouseLeave:Connect(function() bs.Color = C.BORDER_SUBTLE end)
			btn.MouseButton1Click:Connect(opt.onPick)
		end
		return btn
	end

	------------------------------------------------------------------
	-- 📋 UNE LIGNE D'UGC
	------------------------------------------------------------------
	local function itemRow(parent, order, it, isLive)
		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10)

		-- Contour rouge si le compteur maison et Roblox ne racontent pas la
		-- même histoire : c'est exactement le cas qui t'obligeait à corriger
		-- toi-même après un exploit.
		local drift  = (it.liveRem ~= nil) and (it.liveRem ~= it.internal)
		local hidden = ugcHidden(it.assetId)

		-- Un UGC masqué se voit au premier coup d'œil : bord éteint, contenu
		-- assombri. Sinon on finit par oublier qu'on en a laissé un de côté.
		box.BackgroundColor3 = hidden and Color3.fromRGB(22, 22, 26) or C.BG_DARK
		stroke(box,
			hidden and C.TEXT_DIM
				or (drift and C.RED or (it.shown == 0 and C.TEXT_DIM or C.BORDER_SUBTLE)),
			(drift and not hidden) and 1.5 or 1)
		padding(box, 9)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = box

		--── Ligne 1 : image, nom, valeur affichée ──
		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 46)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local s = IS_MOBILE and 34 or 42
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(0, s, 0, s)
		img.Position = UDim2.new(0, 0, 0.5, 0)
		img.AnchorPoint = Vector2.new(0, 0.5)
		img.BackgroundColor3 = C.BG_ITEM
		img.BorderSizePixel = 0
		img.Image = (function(v) v = tostring(v); return v:find("://") and v or ("rbxassetid://" .. v) end)(it.imageId or it.assetId)
		img.ScaleType = Enum.ScaleType.Fit
		img.ImageTransparency = hidden and 0.6 or 0
		img.ZIndex = 13
		img.Parent = head
		corner(img, 7)

		local tx = s + 10
		local vw = IS_MOBILE and 84 or 106

		label(head, { text = (hidden and "⚫ " or "") .. tostring(it.name),
			size = UDim2.new(1, -tx - vw - 8, 0, IS_MOBILE and 16 or 19),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 2 or 4),
			xAlign = Enum.TextXAlignment.Left,
			color = hidden and C.TEXT_DIM or C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 13 })

		local srcTxt
		if it.source == "live" then
			srcTxt = "🌐 lu chez Roblox"
		elseif it.source == "degraded" then
			srcTxt = "⚠️ repli — dernier stock connu"
		else
			srcTxt = "📦 compteur maison"
		end
		label(head, { text = srcTxt .. "  ·  départ " .. tostring(it.initial),
			size = UDim2.new(1, -tx - vw - 8, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 19 or 24),
			xAlign = Enum.TextXAlignment.Left,
			color = (it.source == "degraded") and C.ORANGE
				or ((it.source == "live") and LIVE or HOUSE),
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })

		label(head, { text = tostring(it.shown) .. " / " .. tostring(it.shownTotal),
			size = UDim2.new(0, vw, 1, 0),
			position = UDim2.new(1, 0, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right,
			color = (it.shown == 0) and C.RED
				or ((it.shown <= (it.shownTotal or 1) * 0.3) and C.ORANGE or C.GREEN),
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 13 })

		--── Ligne 2 : comparaison maison / Roblox ──
		if it.liveRem ~= nil or isLive then
			local cmp = Instance.new("TextLabel")
			cmp.Size = UDim2.new(1, 0, 0, 0)
			cmp.AutomaticSize = Enum.AutomaticSize.Y
			cmp.BackgroundColor3 = C.BG_ITEM
			cmp.BackgroundTransparency = 0.4
			cmp.BorderSizePixel = 0
			cmp.Font = FONT
			cmp.TextColor3 = drift and C.RED or C.TEXT_DIM
			cmp.TextSize = IS_MOBILE and 9 or 11
			cmp.TextWrapped = true
			cmp.TextXAlignment = Enum.TextXAlignment.Left
			cmp.TextYAlignment = Enum.TextYAlignment.Top
			cmp.LayoutOrder = 2; cmp.ZIndex = 12; cmp.Parent = box
			corner(cmp, 6)
			local cp = Instance.new("UIPadding")
			cp.PaddingTop = UDim.new(0, 5); cp.PaddingBottom = UDim.new(0, 5)
			cp.PaddingLeft = UDim.new(0, 8); cp.PaddingRight = UDim.new(0, 8)
			cp.Parent = cmp

			local lines = {}
			table.insert(lines, string.format("📦 Maison : %d      🌐 Roblox : %s",
				it.internal,
				it.liveRem ~= nil and (tostring(it.liveRem) .. "/" .. tostring(it.liveTotal or "?"))
					or "pas encore lu"))
			if drift then
				local d = it.internal - it.liveRem
				table.insert(lines, string.format(
					"⚠️ Écart de %d — ton compteur %s de %d par rapport à la réalité.",
					math.abs(d), d > 0 and "surestime" or "sous-estime", math.abs(d)))
			end
			if it.liveAt then
				table.insert(lines, "Lu " .. fmtAgo(it.liveAt)
					.. (it.liveFresh and "" or "  ·  ⌛ périmé"))
			end
			cmp.Text = table.concat(lines, "\n")
		end

		--── Ligne 3 : édition du compteur maison ──
		local edit = Instance.new("Frame")
		edit.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		edit.BackgroundTransparency = 1
		edit.LayoutOrder = 3; edit.ZIndex = 12; edit.Parent = box

		local gw = IS_MOBILE and 34 or 42
		local function step(x, txt, delta)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(0, 0.5)
			c.Position = UDim2.new(0, x, 0.5, 0)
			c.Size = UDim2.new(0, gw, 1, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = edit
			local b = actionButton(c, {
				color = delta > 0 and C.GREEN or C.BG_LIGHT,
				strokeColor = delta > 0 and C.GREEN_DARK or C.BORDER_BRIGHT,
				text = txt, textSize = IS_MOBILE and 11 or 13, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				local target = math.max(0, (it.internal or 0) + delta)
				call("setstock", { assetId = it.assetId, amount = target }, function()
					S.data = nil; screen(false)
				end)
			end)
		end

		step(0, "−10", -10)
		step(gw + 4, "−1", -1)

		local boxX = (gw + 4) * 2
		local rightW = (gw + 4) * 2 + (IS_MOBILE and 44 or 54)
		local tb = Instance.new("TextBox")
		tb.Position = UDim2.new(0, boxX, 0, 0)
		tb.Size = UDim2.new(1, -boxX - rightW - 4, 1, 0)
		tb.BackgroundColor3 = C.BG_ITEM
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.Text = tostring(it.internal)
		tb.PlaceholderText = "stock exact"
		tb.PlaceholderColor3 = C.TEXT_DIM
		tb.TextColor3 = C.TEXT_WHITE
		tb.TextSize = IS_MOBILE and 12 or 15
		tb.ClearTextOnFocus = true
		tb.ZIndex = 12
		tb.Parent = edit
		corner(tb, 7); stroke(tb, HOUSE, 1)

		tb.FocusLost:Connect(function(enter)
			if not enter then tb.Text = tostring(it.internal) return end
			local v = tonumber(tb.Text:match("%-?%d+"))
			if not v or v < 0 then
				toast("Entre un nombre entier positif", false)
				tb.Text = tostring(it.internal)
				return
			end
			call("setstock", { assetId = it.assetId, amount = math.floor(v) }, function()
				S.data = nil; screen(false)
			end)
		end)

		local rx = rightW
		local function rstep(fromRight, txt, delta)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, -fromRight, 0.5, 0)
			c.Size = UDim2.new(0, gw, 1, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = edit
			local b = actionButton(c, {
				color = C.GREEN, strokeColor = C.GREEN_DARK,
				text = txt, textSize = IS_MOBILE and 11 or 13, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				call("setstock", { assetId = it.assetId, amount = math.max(0, (it.internal or 0) + delta) },
				function() S.data = nil; screen(false) end)
			end)
		end

		local resetW = IS_MOBILE and 40 or 50
		rstep(resetW + 4 + gw + 4, "+1", 1)
		rstep(resetW + 4, "+10", 10)

		local rc = Instance.new("Frame")
		rc.AnchorPoint = Vector2.new(1, 0.5)
		rc.Position = UDim2.new(1, 0, 0.5, 0)
		rc.Size = UDim2.new(0, resetW, 1, 0)
		rc.BackgroundTransparency = 1
		rc.ZIndex = 12; rc.Parent = edit
		local rb = actionButton(rc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "♻️", textSize = IS_MOBILE and 12 or 14, radius = 7, zIndex = 12 })
		--── 👁️ Visible ou non dans le shop ──
		local visRow = Instance.new("Frame")
		visRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		visRow.BackgroundTransparency = 1
		visRow.LayoutOrder = 4
		visRow.ZIndex = 12
		visRow.Parent = box

		local visBtn, visLbl = actionButton(visRow, {
			color = hidden and C.BG_LIGHT or LIVE,
			strokeColor = hidden and C.BORDER_BRIGHT or LIVE_D,
			text = hidden and "⚫ MASQUÉ — appuie pour l'afficher"
				or "🟢 VISIBLE dans le shop — appuie pour le masquer",
			textColor = hidden and C.TEXT_GREY or C.BG_BLACK,
			textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12,
		})

		visBtn.MouseButton1Click:Connect(function()
			local fn = remote("AdminSetUGCVisible")
			if not fn then
				toast("UGCSalesLock_Server pas installé côté serveur", false)
				return
			end
			visLbl.Text = "⏳ …"
			task.spawn(function()
				local ok, res = pcall(function()
					return fn:InvokeServer(it.assetId, hidden)   -- masqué → on affiche
				end)
				if ok and type(res) == "table" and res.ok then
					toast(res.msg or "Visibilité changée", true)
				else
					toast((type(res) == "table" and res.msg) or "Échec", false)
				end
				S.data = nil; screen(false)
			end)
		end)

		rb.MouseButton1Click:Connect(function()
			ask({
				title = "Remettre « " .. it.name .. " » à " .. tostring(it.initial),
				accent = C.PURPLE, delay = 3, confirmText = "♻️ Remettre à " .. tostring(it.initial),
				lines = {
					"Le compteur maison repasse de " .. tostring(it.internal)
						.. " à " .. tostring(it.initial) .. " (ta valeur InitialStock).",
					isLive and "Tu es en 🌐 Stock Roblox : cette valeur ne s'affichera pas "
						.. "tant que l'API répond. Elle sert uniquement de repli."
						or "Les joueurs verront le nouveau chiffre immédiatement.",
				},
				onConfirm = function()
					call("resetstock", { assetId = it.assetId }, function()
						S.data = nil; screen(false)
					end)
				end,
			})
		end)

		return box
	end

	------------------------------------------------------------------
	-- 🖥️ L'ÉCRAN
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "stockcfg"
		if reset then S.data = nil; S.failed = false; S.draftProxy = nil end

		local body = buildScreen("📦 RÉGLAGES DU STOCK", true, HOUSE,
			function() screenUGCLog(false) end,
			function() S.data = nil; screen(true) end)

		if not remote("AdminGetStockPanel") then
			note(body, 1, "❌ Le serveur n'a pas le système de stock.\n\n"
				.. "Colle le fichier UGCStock_LiveSystem.lua à la fin de ton script "
				.. "serveur de stock UGC, puis redémarre le serveur.", C.RED)
			return
		end

		-- Chargement, une seule tentative automatique
		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetStockPanel")

				-- ⚠️ NE JAMAIS écrire `local ok, res = fn and pcall(...)` :
				--    en Lua, `a and f()` tronque à UNE seule valeur. `ok` aurait
				--    reçu true et `res` serait resté nil — le serveur répond
				--    correctement mais on jette sa réponse, et l'écran affiche
				--    « impossible de lire les réglages » sans aucune raison.
				local ok, res = false, nil
				if fn then
					ok, res = pcall(function() return fn:InvokeServer() end)
				end

				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data = res
					S.failMsg = nil
				else
					S.failed = true
					-- On garde la raison exacte donnée par le serveur : sans elle,
					-- « impossible de charger » ne dit pas si c'est un refus de
					-- droits, un remote absent ou une vraie erreur.
					if type(res) == "table" and res.msg then
						S.failMsg = tostring(res.msg)
					elseif fn == nil then
						S.failMsg = "Le remote AdminGetStockPanel n'existe pas encore. "
							.. "Le serveur a-t-il fini de charger ?"
					elseif ok == false then
						S.failMsg = "Erreur pendant l'appel : " .. tostring(res)
					else
						S.failMsg = "Le serveur a répondu un " .. type(res)
							.. " au lieu d'une table. Lance _G.UGCStock_Diag() "
							.. "dans la barre de commande."
					end
				end
				if currentScreen == "stockcfg" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Impossible de lire les réglages.\n\n"
					.. (S.failMsg and (tostring(S.failMsg) .. "\n\n") or "")
					.. "Appuie sur 🔄 en haut pour réessayer.")
				or "Chargement des réglages du stock...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		local cfg    = S.data.cfg
		local st     = S.data.state or {}
		local items  = S.data.items or {}
		local isLive = (cfg.mode == "live")

		--── Bandeau d'état ──────────────────────────────────
		local degraded = false
		local drifts = 0
		for _, it in ipairs(items) do
			if it.source == "degraded" then degraded = true end
			if it.liveRem ~= nil and it.liveRem ~= it.internal then drifts = drifts + 1 end
		end

		if isLive and degraded then
			note(body, 0, "⚠️ REPLI ACTIF — l'API Roblox ne répond pas. Le shop affiche le "
				.. "compteur maison, qui contient le dernier stock réel connu et continue de "
				.. "descendre à chaque achat. Les joueurs ne voient aucune erreur.\n\n"
				.. "Dernière erreur : " .. tostring(st.err or "?")
				.. "\nDernière lecture réussie : "
				.. ((st.lastOk and st.lastOk > 0) and fmtAgo(st.lastOk) or "jamais"),
				C.ORANGE)
		elseif isLive then
			note(body, 0, "🌐 Le shop affiche le stock réel de Roblox.\n"
				.. "Dernière lecture : "
				.. ((st.lastOk and st.lastOk > 0) and fmtAgo(st.lastOk) or "jamais")
				.. "  ·  " .. tostring(st.lastMs or 0) .. " ms  ·  "
				.. tostring(st.okCount or 0) .. " OK / " .. tostring(st.failCount or 0) .. " échec(s)"
				.. (drifts > 0 and ("\n\n🔴 " .. drifts .. " UGC ont un écart entre ton compteur "
					.. "et Roblox — c'est ce que le mode live corrige tout seul.") or ""),
				LIVE)
		else
			note(body, 0, "📦 Le shop affiche TON compteur, celui que tu contrôles ici.\n"
				.. "C'est le fonctionnement que tu as depuis le début : fiable et instantané, "
				.. "mais si un achat passe sans être compté, l'écart reste jusqu'à ce que tu le "
				.. "corriges."
				.. (drifts > 0 and ("\n\n🔴 " .. drifts .. " UGC ont déjà un écart avec Roblox. "
					.. "Vois le détail plus bas.") or ""),
				HOUSE)
		end

		--── Choix du mode ───────────────────────────────────
		sectionLabel(body, 1, "SOURCE DU STOCK AFFICHÉ")

		modeCard(body, 2, {
			title = "📦 Compteur maison", color = HOUSE, selected = not isLive,
			desc = "Le stock est un nombre que tu possèdes. Il descend à chaque achat "
				.. "confirmé et tu le corriges à la main ici. Aucune dépendance externe, "
				.. "affichage instantané — mais un achat qui échappe au système laisse un "
				.. "écart que tu dois rattraper toi-même.",
			onPick = function()
				ask({
					title = "Passer en 📦 Compteur maison",
					accent = HOUSE, delay = 3, confirmText = "📦 Activer le compteur maison",
					lines = {
						"Le shop affichera de nouveau TON compteur.",
						"Les valeurs actuelles sont déjà les bonnes : elles ont été alignées "
							.. "sur Roblox à chaque lecture réussie du mode live.",
						"Tu retrouves l'édition manuelle immédiate, et plus aucun appel HTTP "
							.. "n'est fait.",
					},
					warn = "⚠️ Si un exploit passe, l'écart avec le vrai stock ne se corrigera "
						.. "plus tout seul.",
					onConfirm = function() saveCfg({ mode = "internal" }, "📦 Compteur maison actif") end,
				})
			end,
		})

		modeCard(body, 3, {
			title = "🌐 Stock Roblox", color = LIVE, selected = isLive,
			desc = "Le stock affiché est celui que Roblox connaît vraiment. Impossible à "
				.. "désynchroniser : même si un achat échappe à ton système, le chiffre reste "
				.. "juste. Se rafraîchit toutes les " .. tostring(cfg.pollSeconds) .. " s, et "
				.. "bascule tout seul sur le compteur maison si l'API tombe.",
			onPick = function()
				ask({
					title = "Passer en 🌐 Stock Roblox",
					accent = LIVE, delay = 4, confirmText = "🌐 Activer le stock Roblox",
					lines = {
						"Le shop affichera le stock réel du catalogue Roblox, rafraîchi toutes "
							.. "les " .. tostring(cfg.pollSeconds) .. " secondes.",
						"Plus jamais besoin de corriger un compteur après un exploit : le "
							.. "chiffre vient de la source.",
						"Ton compteur maison continue de tourner en arrière-plan et sera "
							.. "réaligné sur Roblox à chaque lecture — il sert de repli.",
					},
					warn = (cfg.proxyHost == "")
						and "⚠️ Aucun proxy configuré. Roblox interdit à HttpService d'appeler "
						.. "ses propres domaines : sans proxy, chaque lecture échouera et tu "
						.. "resteras en repli permanent. Configure-le juste en dessous, puis "
						.. "utilise 🧪 Tester."
						or nil,
					danger = (cfg.proxyHost == ""),
					onConfirm = function() saveCfg({ mode = "live" }, "🌐 Stock Roblox actif") end,
				})
			end,
		})

		--── Réglages du mode live ───────────────────────────
		sectionLabel(body, 10, "RELAIS VERS L'API ROBLOX")

		local pw = Instance.new("Frame")
		pw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		pw.BackgroundTransparency = 1
		pw.LayoutOrder = 11; pw.ZIndex = 11; pw.Parent = body

		local btnW = IS_MOBILE and 74 or 96
		local pb = Instance.new("TextBox")
		pb.AnchorPoint = Vector2.new(0, 0.5)
		pb.Position = UDim2.new(0, 0, 0.5, 0)
		pb.Size = UDim2.new(1, -btnW - 8, 1, 0)
		pb.BackgroundColor3 = C.BG_DARK
		pb.BorderSizePixel = 0
		pb.Font = FONT
		pb.PlaceholderText = "roproxy.com  (vide = appel direct)"
		pb.PlaceholderColor3 = C.TEXT_DIM
		pb.Text = S.draftProxy or cfg.proxyHost or ""
		pb.TextColor3 = C.TEXT_WHITE
		pb.TextSize = IS_MOBILE and 11 or 14
		pb.TextXAlignment = Enum.TextXAlignment.Left
		pb.ClearTextOnFocus = false
		pb.ZIndex = 12
		pb.Parent = pw
		corner(pb, 8); stroke(pb, LIVE, 1)
		local pp = Instance.new("UIPadding"); pp.PaddingLeft = UDim.new(0, 10); pp.Parent = pb

		pb:GetPropertyChangedSignal("Text"):Connect(function() S.draftProxy = pb.Text end)

		local sc = Instance.new("Frame")
		sc.AnchorPoint = Vector2.new(1, 0.5)
		sc.Position = UDim2.new(1, 0, 0.5, 0)
		sc.Size = UDim2.new(0, btnW, 1, 0)
		sc.BackgroundTransparency = 1
		sc.ZIndex = 12; sc.Parent = pw
		local sb = actionButton(sc, { color = LIVE_D, strokeColor = LIVE,
			text = "💾 Poser", textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })
		sb.MouseButton1Click:Connect(function()
			saveCfg({ proxyHost = pb.Text }, "Relais enregistré")
		end)

		note(body, 12, "Roblox refuse que ton serveur appelle catalog.roblox.com directement. "
			.. "Il faut un relais qui répète la requête.\n\n"
			.. "• Le plus rapide : tape roproxy.com — service public gratuit, rien à installer, "
			.. "mais partagé donc parfois lent ou saturé.\n"
			.. "• Le plus fiable : ton propre Cloudflare Worker (gratuit, 5 minutes, le code "
			.. "complet est dans INSTALL_STOCK.md). Tu tapes alors le domaine de ton worker.\n\n"
			.. "Actuellement : " .. ((cfg.proxyHost ~= "" and cfg.proxyHost)
				or "aucun — appel direct, qui échouera"),
			(cfg.proxyHost == "") and C.ORANGE or C.TEXT_DIM)

		local tc = Instance.new("Frame")
		tc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		tc.BackgroundTransparency = 1
		tc.LayoutOrder = 13; tc.ZIndex = 11; tc.Parent = body
		local tb2 = actionButton(tc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🧪 Tester la connexion", textSize = IS_MOBILE and 12 or 14,
			radius = 9, zIndex = 11 })
		tb2.MouseButton1Click:Connect(function()
			toast("Test en cours...", true)
			call("test", {}, function() S.data = nil; screen(false) end)
		end)

		sectionLabel(body, 14, "INTERVALLE ENTRE DEUX LECTURES")

		local iw = Instance.new("Frame")
		iw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		iw.BackgroundTransparency = 1
		iw.LayoutOrder = 15; iw.ZIndex = 11; iw.Parent = body
		local ig = Instance.new("UIGridLayout")
		ig.CellSize = UDim2.new(0.25, -5, 1, 0)
		ig.CellPadding = UDim2.new(0, 6, 0, 0)
		ig.SortOrder = Enum.SortOrder.LayoutOrder
		ig.Parent = iw

		for i, opt in ipairs({ { 60, "1 min" }, { 120, "2 min" }, { 300, "5 min" }, { 600, "10 min" } }) do
			local c = Instance.new("Frame")
			c.LayoutOrder = i; c.BackgroundTransparency = 1; c.ZIndex = 11; c.Parent = iw
			local sel = (cfg.pollSeconds == opt[1])
			local b = actionButton(c, {
				color = sel and LIVE or C.BG_DARK,
				strokeColor = sel and LIVE or C.BORDER_SUBTLE,
				text = opt[2], textColor = sel and C.BG_BLACK or C.TEXT_GREY,
				textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 11 })
			if not sel then
				b.MouseButton1Click:Connect(function()
					saveCfg({ pollSeconds = opt[1] }, "Intervalle : " .. opt[2])
				end)
			end
		end

		note(body, 16, "Chaque lecture fait un appel par UGC, soit " .. tostring(#items)
			.. " appels toutes les " .. tostring(cfg.pollSeconds) .. " s, et ce depuis CHACUN "
			.. "de tes serveurs. Si tu vois des erreurs 429, allonge l'intervalle. "
			.. "2 minutes convient à la plupart des jeux.", C.TEXT_DIM)

		--── Actions globales ────────────────────────────────
		sectionLabel(body, 20, "ACTIONS")

		local aw = Instance.new("Frame")
		aw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		aw.BackgroundTransparency = 1
		aw.LayoutOrder = 21; aw.ZIndex = 11; aw.Parent = body
		local ag = Instance.new("UIGridLayout")
		ag.CellSize = UDim2.new(0.5, -5, 1, 0)
		ag.CellPadding = UDim2.new(0, 10, 0, 0)
		ag.SortOrder = Enum.SortOrder.LayoutOrder
		ag.Parent = aw

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 11; w1.Parent = aw
		local rb2 = actionButton(w1, { color = LIVE_D, strokeColor = LIVE,
			text = "🔄 Sonder maintenant", textSize = IS_MOBILE and 11 or 13,
			radius = 9, zIndex = 11 })
		rb2.MouseButton1Click:Connect(function()
			if not isLive then toast("Active d'abord le mode 🌐 Stock Roblox", false) return end
			toast("Sondage en cours...", true)
			call("refresh", {}, function() S.data = nil; screen(false) end)
		end)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 11; w2.Parent = aw
		local sb2 = actionButton(w2, { color = HOUSE_D, strokeColor = HOUSE,
			text = "🪞 Aligner mes compteurs", textSize = IS_MOBILE and 11 or 13,
			radius = 9, zIndex = 11 })
		sb2.MouseButton1Click:Connect(function()
			ask({
				title = "Aligner le compteur maison sur Roblox",
				accent = HOUSE, delay = 4, confirmText = "🪞 Aligner",
				lines = {
					"Chaque compteur maison est écrasé par la valeur réelle lue chez Roblox.",
					drifts > 0
						and ("Ça corrigera les " .. drifts .. " écart(s) détecté(s) ci-dessous.")
						or "Aucun écart détecté pour l'instant : l'opération ne changera rien.",
					"C'est exactement la correction que tu faisais à la main après un exploit.",
				},
				warn = "⚠️ Irréversible. Les UGC sans donnée live sont laissés tels quels.",
				onConfirm = function()
					call("syncfromlive", {}, function() S.data = nil; screen(false) end)
				end,
			})
		end)

		--── Liste des UGC ───────────────────────────────────
		sectionLabel(body, 30, "STOCK DE CHAQUE UGC ("
			.. (isLive and "édition = compteur de repli" or "édition immédiate") .. ")")

		if isLive then
			note(body, 31, "Tu es en 🌐 Stock Roblox : ce que tu modifies ici n'est PAS ce que "
				.. "les joueurs voient. Tu règles le compteur de repli, celui qui prendra le "
				.. "relais si l'API tombe. Il est de toute façon réaligné à chaque lecture "
				.. "réussie.", C.ORANGE)
		end

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 32; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		if #items == 0 then
			note(holder, 1, "Aucun UGC dans UGC_CONFIG.", C.TEXT_DIM)
		else
			for i, it in ipairs(items) do
				itemRow(holder, i, it, isLive)
			end
		end
	end

	------------------------------------------------------------------
	-- 🔗 BOUTON ⚙️ EN HAUT DE L'ÉCRAN 🎽 UGC LOG
	------------------------------------------------------------------
	local previousScreenUGCLog = screenUGCLog

	screenUGCLog = function(reset)
		previousScreenUGCLog(reset)
		if currentScreen ~= "ugclog" then return end

		local body = window:FindFirstChildOfClass("ScrollingFrame")
		if not body then return end

		-- LayoutOrder négatif → le bouton se place au-dessus des onglets
		-- Log / Top, qui sont à 0.
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		c.BackgroundTransparency = 1
		c.LayoutOrder = -5
		c.ZIndex = 11
		c.Parent = body

		local b = actionButton(c, {
			color = HOUSE_D, strokeColor = HOUSE,
			text = "⚙️ RÉGLAGES DU STOCK",
			textSize = IS_MOBILE and 12 or 15, radius = 9, zIndex = 11,
		})
		b.MouseButton1Click:Connect(function() screen(true) end)
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🛑 BLOC 5 — VERROU D'URGENCE DES VENTES UGC
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     Après le bloc 📦 RÉGLAGES DU STOCK. Rien à supprimer.
--
--  Ajoute une entrée « 🛑 VENTES UGC » sur l'ACCUEIL du panel : un seul appui
--  depuis l'écran d'accueil, parce qu'un bouton d'urgence enterré à trois
--  niveaux de profondeur n'est pas un bouton d'urgence.
--
--  Prérequis serveur : UGCSalesLock_Server.lua dans ServerScriptService,
--  + le patch de 6 lignes dans A_UGCEscrow (voir PATCH_SALESLOCK.md).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local STOP   = Color3.fromRGB(235, 60, 65)
	local STOP_D = Color3.fromRGB(140, 25, 30)
	local OPEN   = Color3.fromRGB(60, 200, 110)
	local OPEN_D = Color3.fromRGB(28, 120, 65)

	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	task.spawn(function()
		for _, n in ipairs({ "AdminGetSalesLock", "AdminSetSalesLock" }) do
			R[n] = ReplicatedStorage:WaitForChild(n, 40)
		end
		if not R.AdminGetSalesLock then
			warn("[Admin] AdminGetSalesLock introuvable → ajoute UGCSalesLock_Server.lua "
				.. "dans ServerScriptService")
		end
	end)

	local S = { data = nil, loading = false, failed = false, failMsg = nil, draftNote = nil }
	local screen

	------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	------------------------------------------------------------------
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	-- Confirmation avec compte à rebours. Court pour geler (c'est l'urgence),
	-- long pour rouvrir (c'est la décision risquée).
	local function ask(opts)
		local wait = tonumber(opts.delay) or 3
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.45
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.94, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12); stroke(card, opts.accent or STOP, 1.5); padding(card, 12)

		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8)
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Parent = card

		local t = Instance.new("Frame")
		t.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t.BackgroundTransparency = 1
		t.LayoutOrder = 1; t.ZIndex = 52; t.Parent = card
		label(t, { text = opts.title, size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = opts.accent or STOP,
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 52 })

		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundColor3 = C.BG_ITEM
		body.BackgroundTransparency = 0.3
		body.BorderSizePixel = 0
		body.Font = FONT
		body.Text = table.concat(opts.lines or {}, "\n\n")
		body.TextColor3 = C.TEXT_WHITE
		body.TextSize = IS_MOBILE and 11 or 13
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.LayoutOrder = 2; body.ZIndex = 52; body.Parent = card
		corner(body, 8)
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 8)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = body

		if opts.warn then
			local w = Instance.new("TextLabel")
			w.Size = UDim2.new(1, 0, 0, 0)
			w.AutomaticSize = Enum.AutomaticSize.Y
			w.BackgroundTransparency = 1
			w.Font = FONT
			w.Text = opts.warn
			w.TextColor3 = opts.danger and STOP or C.ORANGE
			w.TextSize = IS_MOBILE and 10 or 12
			w.TextWrapped = true
			w.TextXAlignment = Enum.TextXAlignment.Left
			w.LayoutOrder = 3; w.ZIndex = 52; w.Parent = card
		end

		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 4; btns.ZIndex = 52; btns.Parent = card
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 10, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder
		bg.Parent = btns

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 52; w1.Parent = btns
		local cb = actionButton(w1, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Annuler", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })
		cb.MouseButton1Click:Connect(close)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 52; w2.Parent = btns
		local okBtn, okLbl = actionButton(w2, { color = C.BG_MEDIUM,
			strokeColor = C.BORDER_SUBTLE, text = "⏳",
			textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })

		local armed = false
		task.spawn(function()
			for r = wait, 1, -1 do
				if closed then return end
				okLbl.Text = "⏳ " .. r .. " s"
				task.wait(1)
			end
			if closed then return end
			armed = true
			okBtn.BackgroundColor3 = opts.accent or STOP
			okLbl.Text = opts.confirmText or "✅ Confirmer"
		end)

		okBtn.MouseButton1Click:Connect(function()
			if not armed then toast("Une seconde…", false) return end
			close()
			if opts.onConfirm then opts.onConfirm() end
		end)
	end

	------------------------------------------------------------------
	-- 🖥️ ÉCRAN
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "saleslock"
		if reset then S.data = nil; S.failed = false; S.failMsg = nil; S.draftNote = nil end

		local body = buildScreen("🛑 VENTES UGC", true, STOP, nil, function()
			S.data = nil; screen(true)
		end)

		if not remote("AdminGetSalesLock") then
			note(body, 1, "❌ Le serveur n'a pas le verrou des ventes.\n\n"
				.. "Ajoute UGCSalesLock_Server.lua dans ServerScriptService, "
				.. "puis redémarre le serveur.", STOP)
			return
		end

		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetSalesLock")
				local ok, res = false, nil
				if fn then ok, res = pcall(function() return fn:InvokeServer() end) end
				S.loading = false

				if ok and type(res) == "table" and res.ok then
					S.data = res
					S.failMsg = nil
				else
					S.failed = true
					if type(res) == "table" and res.msg then
						S.failMsg = tostring(res.msg)
					elseif ok == false then
						S.failMsg = "Erreur pendant l'appel : " .. tostring(res)
					else
						S.failMsg = "Réponse inattendue du serveur. Lance "
							.. "_G.UGCSales_Diag() dans la barre de commande."
					end
				end
				if currentScreen == "saleslock" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Impossible de lire l'état.\n\n"
					.. (S.failMsg and (S.failMsg .. "\n\n") or "")
					.. "Appuie sur 🔄 en haut.")
				or "Lecture de l'état des ventes...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		local d       = S.data
		local frozen  = d.frozen == true
		local ready   = d.loaded == true

		--── Grande carte d'état ─────────────────────────────
		local hero = Instance.new("Frame")
		hero.Size = UDim2.new(1, 0, 0, 0)
		hero.AutomaticSize = Enum.AutomaticSize.Y
		hero.BackgroundColor3 = C.BG_DARK
		hero.BorderSizePixel = 0
		hero.LayoutOrder = 0
		hero.ZIndex = 11
		hero.Parent = body
		corner(hero, 12)
		stroke(hero, frozen and STOP or OPEN, 2)
		padding(hero, 12)

		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, 6)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = hero

		local t1 = Instance.new("Frame")
		t1.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 38)
		t1.BackgroundTransparency = 1
		t1.LayoutOrder = 1; t1.ZIndex = 12; t1.Parent = hero
		label(t1, {
			text = frozen and "🔴 VENTES GELÉES" or "🟢 VENTES OUVERTES",
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = frozen and STOP or OPEN,
			textSize = IS_MOBILE and 20 or 26, truncate = true, zIndex = 13,
		})

		local sub = Instance.new("TextLabel")
		sub.Size = UDim2.new(1, 0, 0, 0)
		sub.AutomaticSize = Enum.AutomaticSize.Y
		sub.BackgroundTransparency = 1
		sub.Font = FONT
		sub.TextColor3 = C.TEXT_GREY
		sub.TextSize = IS_MOBILE and 10 or 12
		sub.TextWrapped = true
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.LayoutOrder = 2; sub.ZIndex = 12; sub.Parent = hero

		local lines = {}
		if frozen then
			table.insert(lines, "Aucun joueur ne peut acheter d'UGC, sur aucun serveur. "
				.. "Le serveur refuse avant la moindre déduction de points.")
		else
			table.insert(lines, "Les achats fonctionnent normalement.")
		end
		if d.by and d.by ~= "" then
			table.insert(lines, "Dernière décision : " .. tostring(d.by)
				.. ((d.at and d.at > 0) and ("  ·  " .. fmtAgo(d.at)) or ""))
		end
		if d.note and d.note ~= "" then
			table.insert(lines, "Note affichée aux joueurs : « " .. tostring(d.note) .. " »")
		end
		table.insert(lines, tostring(d.players or "?") .. " joueur(s) sur ce serveur.")
		sub.Text = table.concat(lines, "\n")

		if not ready then
			note(body, 1, "⚠️ Ce serveur n'a pas encore réussi à lire l'état dans le "
				.. "DataStore. Par sécurité, les ventes sont BLOQUÉES en attendant : un "
				.. "verrou d'urgence ne doit jamais s'ouvrir tout seul. La lecture est "
				.. "retentée toutes les 15 s.", C.ORANGE)
		end

		--── LE bouton ───────────────────────────────────────
		local bc = Instance.new("Frame")
		bc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 60 or 72)
		bc.BackgroundTransparency = 1
		bc.LayoutOrder = 2; bc.ZIndex = 11; bc.Parent = body

		local big = actionButton(bc, {
			color = frozen and OPEN or STOP,
			strokeColor = frozen and OPEN_D or STOP_D,
			text = frozen and "🟢 ROUVRIR LES VENTES" or "🛑 GELER TOUTES LES VENTES",
			textSize = IS_MOBILE and 15 or 19, radius = 12, zIndex = 11,
		})

		big.MouseButton1Click:Connect(function()
			local noteTxt = S.draftNote or d.note or ""

			if not frozen then
				-- Geler : c'est l'urgence, on ne fait pas patienter longtemps.
				ask({
					title = "Geler toutes les ventes UGC",
					accent = STOP, danger = true, delay = 2,
					confirmText = "🛑 GELER MAINTENANT",
					lines = {
						"Plus aucun joueur ne pourra acheter d'UGC, sur TOUS tes serveurs, "
							.. "dans la seconde.",
						"Ce qui continue normalement : les achats déjà en cours vont au bout "
							.. "(livraison, confirmation, remboursement). Personne ne perd de "
							.. "points à cause du gel.",
						"Ce qui s'arrête : tout nouvel achat. Le joueur voit un message qui "
							.. "explique la situation et le rassure sur ses points.",
					},
					onConfirm = function()
						local fn = remote("AdminSetSalesLock")
						if not fn then toast("Serveur indisponible", false) return end
						task.spawn(function()
							local ok, res = pcall(function()
								return fn:InvokeServer(true, noteTxt)
							end)
							if ok and type(res) == "table" and res.ok then
								toast(res.msg or "Ventes gelées", true)
							else
								toast((type(res) == "table" and res.msg) or "Échec", false)
							end
							S.data = nil; screen(false)
						end)
					end,
				})
			else
				ask({
					title = "Rouvrir les ventes UGC",
					accent = OPEN, delay = 5,
					confirmText = "🟢 ROUVRIR",
					lines = {
						"Les achats redeviennent possibles immédiatement, sur tous les serveurs.",
						"Avant de rouvrir, vérifie que la faille est bien fermée : une fois "
							.. "les UGC distribuées, elles sont irrécupérables.",
						"Le journal 🔐 ESCROW et l'onglet 🚨 Suspects te disent si quelque "
							.. "chose d'anormal s'est produit pendant la fermeture.",
					},
					warn = "⚠️ Si le farm de points n'est pas corrigé, tes UGC repartent "
						.. "à la seconde où tu appuies.",
					onConfirm = function()
						local fn = remote("AdminSetSalesLock")
						if not fn then toast("Serveur indisponible", false) return end
						task.spawn(function()
							local ok, res = pcall(function()
								return fn:InvokeServer(false, "")
							end)
							if ok and type(res) == "table" and res.ok then
								toast(res.msg or "Ventes rouvertes", true)
							else
								toast((type(res) == "table" and res.msg) or "Échec", false)
							end
							S.data = nil; screen(false)
						end)
					end,
				})
			end
		end)

		--── Note optionnelle ────────────────────────────────
		sectionLabel(body, 10, "LIGNE À AJOUTER AU MESSAGE DES JOUEURS (FACULTATIF)")

		local nb = Instance.new("TextBox")
		nb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		nb.BackgroundColor3 = C.BG_DARK
		nb.BorderSizePixel = 0
		nb.Font = FONT
		nb.PlaceholderText = "Ex : Back in ~2 hours. Check #announcements."
		nb.PlaceholderColor3 = C.TEXT_DIM
		nb.Text = S.draftNote or d.note or ""
		nb.TextColor3 = C.TEXT_WHITE
		nb.TextSize = IS_MOBILE and 11 or 13
		nb.TextXAlignment = Enum.TextXAlignment.Left
		nb.ClearTextOnFocus = false
		nb.TextWrapped = true
		nb.LayoutOrder = 11
		nb.ZIndex = 11
		nb.Parent = body
		corner(nb, 8); stroke(nb, C.BORDER_SUBTLE, 1)
		local np = Instance.new("UIPadding")
		np.PaddingLeft = UDim.new(0, 10); np.PaddingRight = UDim.new(0, 10)
		np.Parent = nb
		nb:GetPropertyChangedSignal("Text"):Connect(function() S.draftNote = nb.Text end)

		note(body, 12, "Le message principal est déjà écrit et rassurant : il dit que "
			.. "l'arrêt vient d'un admin à cause d'un exploit, que les points du joueur "
			.. "sont intacts, et de consulter le support communautaire. Cette ligne vient "
			.. "s'ajouter en dessous, en jaune. Laisse vide si tu n'as rien à préciser.\n\n"
			.. "Elle est prise en compte au moment où tu appuies sur le gros bouton.",
			C.TEXT_DIM)

		--── Rappel de ce que ça fait ────────────────────────
		sectionLabel(body, 20, "CE QUE LE VERROU FAIT, ET NE FAIT PAS")

		note(body, 21, "✅ Bloque tout nouvel achat UGC, côté SERVEUR, avant la moindre "
			.. "déduction de points. Un exploiteur qui trafique son interface se fait "
			.. "refuser pareil.\n\n"
			.. "✅ S'applique à tous tes serveurs en même temps, et survit à un "
			.. "redémarrage.\n\n"
			.. "✅ Laisse les achats DÉJÀ EN COURS se terminer normalement — sinon un "
			.. "joueur qui a cliqué une seconde trop tôt perdrait ses points.\n\n"
			.. "❌ N'empêche PAS de gagner des points, de gift, ou de jouer. Ce n'est pas "
			.. "un arrêt du jeu, c'est une mise hors vente des UGC.", C.TEXT_DIM)
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "saleslock", name = "🛑 VENTES UGC", color = STOP })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "saleslock" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🔔 BLOC 6 — SECTION « WHAT'S NEW » POUR L'ADMIN PANEL
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     ⚠️ SI TU AVAIS DÉJÀ COLLÉ UNE VERSION PRÉCÉDENTE DE CE BLOC
--        (celle qui commence par `;(function()  local BELL = ...`),
--        SUPPRIME-LA ENTIÈREMENT et remplace-la par celle-ci.
--
--  C'est une IIFE : elle n'ajoute AUCUNE variable locale au script principal
--  (tu restes loin de la limite de 200 registres).
--
--  Trois écrans :
--     📰 LE FIL       — toutes tes publications, gérables une par une
--     ✏️ L'ÉDITEUR    — écrire / modifier / republier / dupliquer / supprimer
--     ⚙️ LES RÉGLAGES — titre du panel, event, notifications, limites
--
--  Prérequis serveur : EventInfo_Server.lua (version fil) dans ServerScriptService.
--════════════════════════════════════════════════════════════════════════════

;(function()
	local BELL   = Color3.fromRGB(255, 205, 90)
	local BELL_D = Color3.fromRGB(160, 120, 30)
	local GRN    = Color3.fromRGB(56, 196, 100)
	local GRN_D  = Color3.fromRGB(28, 122, 62)
	local CYAN   = Color3.fromRGB(110, 200, 255)

	local SocialService = game:GetService("SocialService")

	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	task.spawn(function()
		for _, n in ipairs({ "AdminGetEventInfo", "AdminEventInfoAction" }) do
			R[n] = ReplicatedStorage:WaitForChild(n, 40)
		end
		if not R.AdminEventInfoAction then
			warn("[Admin] AdminEventInfoAction introuvable → mets EventInfo_Server.lua "
				.. "à jour (version fil de publications)")
		end
	end)

	local S = {
		data = nil, loading = false, failed = false, failMsg = nil,
		view = "feed",        -- "feed" | "drafts" | "post" | "settings"
		editId = nil,         -- id d'une publication publiée en cours d'édition
		editDid = nil,        -- id d'un BROUILLON en cours d'édition
		-- editId et editDid tous les deux nil = on écrit quelque chose de neuf
		from = "feed",        -- où revient la flèche « retour »
		draft = nil,          -- contenu en cours de saisie dans l'éditeur
		sdraft = nil,         -- brouillon des réglages
		dirty = false, saveLbl = nil,
		ev = nil, evErr = nil, evLoading = false, evFor = nil,
	}

	local screen   -- forward decl

	------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	------------------------------------------------------------------

	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	-- Confirmation avec compte à rebours : impossible de supprimer par réflexe
	local function ask(opts)
		local wait = tonumber(opts.delay) or 3
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.45
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.94, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12); stroke(card, opts.accent or BELL, 1.5); padding(card, 12)

		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8)
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Parent = card

		local t = Instance.new("Frame")
		t.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t.BackgroundTransparency = 1
		t.LayoutOrder = 1; t.ZIndex = 52; t.Parent = card
		label(t, { text = opts.title, size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = opts.accent or BELL,
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 52 })

		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundColor3 = C.BG_ITEM
		body.BackgroundTransparency = 0.3
		body.BorderSizePixel = 0
		body.Font = FONT
		body.Text = table.concat(opts.lines or {}, "\n\n")
		body.TextColor3 = C.TEXT_WHITE
		body.TextSize = IS_MOBILE and 11 or 13
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.LayoutOrder = 2; body.ZIndex = 52; body.Parent = card
		corner(body, 8)
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 8)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = body

		if opts.warn then
			local w = Instance.new("TextLabel")
			w.Size = UDim2.new(1, 0, 0, 0)
			w.AutomaticSize = Enum.AutomaticSize.Y
			w.BackgroundTransparency = 1
			w.Font = FONT
			w.Text = opts.warn
			w.TextColor3 = opts.danger and C.RED or C.ORANGE
			w.TextSize = IS_MOBILE and 10 or 12
			w.TextWrapped = true
			w.TextXAlignment = Enum.TextXAlignment.Left
			w.LayoutOrder = 3; w.ZIndex = 52; w.Parent = card
		end

		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 4; btns.ZIndex = 52; btns.Parent = card
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 10, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder
		bg.Parent = btns

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 52; w1.Parent = btns
		local cb = actionButton(w1, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Annuler", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })
		cb.MouseButton1Click:Connect(close)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 52; w2.Parent = btns
		local okBtn, okLbl = actionButton(w2, { color = C.BG_MEDIUM,
			strokeColor = C.BORDER_SUBTLE, text = "⏳",
			textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })

		local armed = false
		task.spawn(function()
			for r = wait, 1, -1 do
				if closed then return end
				okLbl.Text = "⏳ " .. r .. " s"
				task.wait(1)
			end
			if closed then return end
			armed = true
			okBtn.BackgroundColor3 = opts.danger and C.RED or (opts.accent or GRN)
			okLbl.Text = opts.confirmText or "✅ Confirmer"
		end)

		okBtn.MouseButton1Click:Connect(function()
			if not armed then toast("Prends le temps de lire", false) return end
			close()
			if opts.onConfirm then opts.onConfirm() end
		end)
	end

	-- Champ texte. On ne redessine JAMAIS pendant la frappe (ça détruirait la
	-- TextBox et ferait perdre le curseur) : l'aperçu se rafraîchit au blur.
	local function field(parent, order, opt)
		local store = opt.store or S.draft
		local h = opt.multiline and (IS_MOBILE and 110 or 140) or (IS_MOBILE and 36 or 42)
		local tb = Instance.new("TextBox")
		tb.Size = UDim2.new(1, 0, 0, h)
		tb.BackgroundColor3 = C.BG_DARK
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.PlaceholderText = opt.placeholder or ""
		tb.PlaceholderColor3 = C.TEXT_DIM
		tb.Text = opt.value or ""
		tb.TextColor3 = C.TEXT_WHITE
		tb.TextSize = IS_MOBILE and 11 or 13
		tb.TextXAlignment = Enum.TextXAlignment.Left
		tb.ClearTextOnFocus = false
		tb.LayoutOrder = order
		tb.ZIndex = 11
		tb.Parent = parent
		corner(tb, 8); stroke(tb, opt.accent or C.BORDER_SUBTLE, 1)

		if opt.multiline then
			tb.MultiLine      = true
			tb.TextWrapped    = true
			tb.TextYAlignment = Enum.TextYAlignment.Top
		end

		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, opt.multiline and 8 or 0)
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = tb

		tb:GetPropertyChangedSignal("Text"):Connect(function()
			if opt.max and #tb.Text > opt.max then
				tb.Text = tb.Text:sub(1, opt.max)
				return
			end
			store[opt.key] = tb.Text
			S.dirty = true
			if S.saveLbl and S.saveLbl.Parent and opt.saveText then
				S.saveLbl.Text = opt.saveText
			end
		end)

		tb.FocusLost:Connect(function()
			if currentScreen == "eventinfo" and window.Visible then screen(false) end
		end)

		return tb
	end

	local function toggle(parent, order, opt)
		local store = opt.store or S.draft
		local v = opt.value
		local onCol = opt.onColor or GRN
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.Text = ""
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 9); stroke(row, v and onCol or C.BORDER_SUBTLE, v and 1.5 or 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 4)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = row
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 5); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = row

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 26 or 30)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = row

		local pw = IS_MOBILE and 54 or 66
		label(head, { text = opt.title,
			size = UDim2.new(1, -pw - 8, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = v and C.TEXT_WHITE or C.TEXT_GREY,
			textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 13 })

		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, 0, 0.5, 0)
		pill.Size = UDim2.new(0, pw, 0, IS_MOBILE and 21 or 25)
		pill.BackgroundColor3 = v and onCol or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = v and "ON" or "OFF"
		pill.TextColor3 = v and C.BG_BLACK or C.TEXT_GREY
		pill.TextSize = IS_MOBILE and 10 or 12
		pill.ZIndex = 13
		pill.Parent = head
		corner(pill, 6)

		local d = Instance.new("TextLabel")
		d.Size = UDim2.new(1, 0, 0, 0)
		d.AutomaticSize = Enum.AutomaticSize.Y
		d.BackgroundTransparency = 1
		d.Font = FONT
		d.Text = v and opt.onDesc or opt.offDesc
		d.TextColor3 = C.TEXT_DIM
		d.TextSize = IS_MOBILE and 9 or 11
		d.TextWrapped = true
		d.TextXAlignment = Enum.TextXAlignment.Left
		d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = row

		row.MouseButton1Click:Connect(function()
			store[opt.key] = not v
			S.dirty = true
			screen(false)
		end)

		return row
	end

	local function stepper(parent, order, opt)
		local store = opt.store or S.sdraft
		local value = opt.value
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		row.BackgroundColor3 = C.BG_DARK
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 8); stroke(row, opt.accent or BELL, 1)

		local bw = IS_MOBILE and 38 or 46
		local function side(isPlus)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(isPlus and 1 or 0, 0.5)
			c.Position = UDim2.new(isPlus and 1 or 0, isPlus and -6 or 6, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 28 or 34)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = row
			local b = actionButton(c, {
				color = isPlus and GRN or C.BG_LIGHT,
				strokeColor = isPlus and GRN_D or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 16 or 20, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				store[opt.key] = math.clamp(value + (isPlus and 1 or -1), opt.min, opt.max)
				S.dirty = true
				screen(false)
			end)
		end
		side(false); side(true)

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.Position = UDim2.new(0.5, 0, 0.5, 0)
		box.Size = UDim2.new(1, -(bw * 2 + 24), 1, -10)
		box.BackgroundTransparency = 1
		box.Font = FONT
		box.Text = tostring(value) .. " " .. opt.suffix
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 14 or 17
		box.ClearTextOnFocus = true
		box.ZIndex = 12
		box.Parent = row
		box.FocusLost:Connect(function()
			local v = tonumber(box.Text:match("%d+"))
			if v then
				store[opt.key] = math.clamp(math.floor(v), opt.min, opt.max)
				S.dirty = true
				screen(false)
			else
				box.Text = tostring(value) .. " " .. opt.suffix
			end
		end)
		return row
	end

	local function bigBtn(parent, order, text, col, colD, fn, textCol)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 50)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b, lbl = actionButton(c, { color = col, strokeColor = colD, text = text,
			textColor = textCol, textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b, lbl
	end

	------------------------------------------------------------------
	-- 📅 EVENTS ROBLOX  (API client-only, appelée directement d'ici)
	------------------------------------------------------------------

	local function toUnix(v)
		if v == nil then return nil end
		if typeof(v) == "DateTime" then return v.UnixTimestamp end
		if type(v) == "number" then return math.floor(v) end
		if type(v) == "string" then
			local ok, dt = pcall(DateTime.fromIsoDate, v)
			if ok and dt then return dt.UnixTimestamp end
		end
		return nil
	end

	local function fmtStart(unix)
		if not unix then return "date inconnue" end
		local left = unix - os.time()
		local when = os.date("!%d/%m/%Y %H:%M", unix) .. " UTC"
		if left <= 0 then return when .. "  ·  🔴 en cours / passé" end
		local d = math.floor(left / 86400)
		local h = math.floor((left % 86400) / 3600)
		if d > 0 then return when .. string.format("  ·  dans %dj %dh", d, h) end
		local m = math.floor((left % 3600) / 60)
		return when .. string.format("  ·  dans %dh %dmin", h, m)
	end

	local function packEvent(data, fallbackId)
		return {
			id     = tostring(data.Id or fallbackId or "?"),
			title  = tostring(data.Title or "Sans titre"),
			startU = toUnix(data.StartTime),
			ended  = (data.HasEnded == true),
		}
	end

	local function fetchUpcoming()
		local ok, res = pcall(function()
			return SocialService:GetUpcomingExperienceEventsAsync()
		end)
		if not ok then return nil, tostring(res) end
		if type(res) ~= "table" then return nil, "réponse vide" end
		return res, nil
	end

	local function resolvePreview()
		local want = (S.sdraft and S.sdraft.eventId) or "auto"
		if want == "" then want = "auto" end
		if S.evLoading then return end
		if S.evFor == want and S.ev ~= nil then return end

		S.evLoading = true
		task.spawn(function()
			local data, err
			if want ~= "auto" then
				local ok, res = pcall(function()
					return SocialService:GetExperienceEventAsync(want)
				end)
				if ok and type(res) == "table" then data = res
				else err = "ID introuvable ou event d'une autre expérience" end
			else
				local list, e2 = fetchUpcoming()
				if list then
					for _, ev in ipairs(list) do
						if ev.HasEnded ~= true and ev.Id then data = ev break end
					end
					if not data then err = "aucun event à venir dans ton expérience" end
				else
					err = e2 or "API indisponible"
				end
			end

			S.evLoading = false
			S.evFor = want
			if data then S.ev, S.evErr = packEvent(data, want), nil
			else S.ev, S.evErr = false, err end
			if currentScreen == "eventinfo" and window.Visible then screen(false) end
		end)
	end

	local function pickEvent()
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.5
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.95, 0, 0.82, 0)
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12); stroke(card, BELL, 1.5); padding(card, 10)

		local HH = IS_MOBILE and 26 or 30
		label(card, { text = "📋 Events à venir", size = UDim2.new(1, -70, 0, HH),
			position = UDim2.new(0, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = BELL, textSize = IS_MOBILE and 14 or 17, zIndex = 52 })

		local xc = Instance.new("Frame")
		xc.AnchorPoint = Vector2.new(1, 0)
		xc.Position = UDim2.new(1, 0, 0, 0)
		xc.Size = UDim2.new(0, IS_MOBILE and 56 or 66, 0, HH)
		xc.BackgroundTransparency = 1
		xc.ZIndex = 52; xc.Parent = card
		local xb = actionButton(xc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Fermer", textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 52 })
		xb.MouseButton1Click:Connect(close)

		local list = Instance.new("ScrollingFrame")
		list.Position = UDim2.new(0, 0, 0, HH + 8)
		list.Size = UDim2.new(1, 0, 1, -(HH + 8))
		list.BackgroundTransparency = 1
		list.BorderSizePixel = 0
		list.ScrollBarThickness = 4
		list.ScrollBarImageColor3 = C.BORDER_SUBTLE
		list.CanvasSize = UDim2.new(0, 0, 0, 0)
		list.AutomaticCanvasSize = Enum.AutomaticSize.Y
		list.ScrollingDirection = Enum.ScrollingDirection.Y
		list.Active = true
		list.ZIndex = 52
		list.Parent = card
		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, IS_MOBILE and 6 or 8)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = list

		local function choose(id)
			S.sdraft.eventId = id
			S.dirty = true
			S.ev, S.evErr, S.evFor = nil, nil, nil
			close()
			screen(false)
		end

		local sel0 = (S.sdraft.eventId == "auto")
		local autoRow = Instance.new("TextButton")
		autoRow.Size = UDim2.new(1, -6, 0, IS_MOBILE and 46 or 54)
		autoRow.BackgroundColor3 = sel0 and C.BG_MEDIUM or C.BG_ITEM
		autoRow.AutoButtonColor = false
		autoRow.Text = ""
		autoRow.BorderSizePixel = 0
		autoRow.LayoutOrder = 1
		autoRow.ZIndex = 53
		autoRow.Parent = list
		corner(autoRow, 9); stroke(autoRow, sel0 and GRN or C.BORDER_SUBTLE, 1.5)
		label(autoRow, { text = "🤖 Prochain event automatique",
			size = UDim2.new(1, -20, 0, IS_MOBILE and 16 or 19),
			position = UDim2.new(0, 10, 0, IS_MOBILE and 6 or 8),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 54 })
		label(autoRow, { text = "Suit tout seul tes events — recommandé",
			size = UDim2.new(1, -20, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, 10, 0, IS_MOBILE and 24 or 29),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 54 })
		autoRow.MouseButton1Click:Connect(function() choose("auto") end)

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, -6, 0, 60)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 2; status.ZIndex = 53; status.Parent = list
		local sl = label(status, { text = "Lecture des events...", size = UDim2.fromScale(1, 1),
			wrapped = true, color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 13, zIndex = 53 })

		task.spawn(function()
			local evs, err = fetchUpcoming()
			if closed then return end
			if not evs then
				sl.Text = "⚠️ Impossible de lire les events (" .. tostring(err) .. ").\n\n"
					.. "Ces API sont client-only et ne renvoient RIEN en Studio sur une "
					.. "place non publiée. Teste en jeu."
				sl.TextColor3 = C.ORANGE
				return
			end
			if #evs == 0 then
				sl.Text = "Aucun event à venir.\n\nCrée-en un depuis le Creator Hub "
					.. "(Experience → Events), il apparaîtra ici."
				return
			end
			status:Destroy()

			for i, raw in ipairs(evs) do
				local e = packEvent(raw)
				local sel = (S.sdraft.eventId == e.id)
				local row = Instance.new("TextButton")
				row.Size = UDim2.new(1, -6, 0, IS_MOBILE and 50 or 58)
				row.BackgroundColor3 = sel and C.BG_MEDIUM or C.BG_ITEM
				row.AutoButtonColor = false
				row.Text = ""
				row.BorderSizePixel = 0
				row.LayoutOrder = 10 + i
				row.ZIndex = 53
				row.Parent = list
				corner(row, 9)
				local rs = stroke(row, sel and GRN or C.BORDER_SUBTLE, sel and 1.5 or 1)

				label(row, { text = (sel and "✅ " or "") .. e.title,
					size = UDim2.new(1, -20, 0, IS_MOBILE and 16 or 19),
					position = UDim2.new(0, 10, 0, IS_MOBILE and 6 or 8),
					xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
					textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 54 })
				label(row, { text = fmtStart(e.startU) .. "  ·  ID " .. e.id,
					size = UDim2.new(1, -20, 0, IS_MOBILE and 14 or 17),
					position = UDim2.new(0, 10, 0, IS_MOBILE and 25 or 31),
					xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
					textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 54 })

				if not IS_MOBILE then
					row.MouseEnter:Connect(function() rs.Color = BELL end)
					row.MouseLeave:Connect(function()
						rs.Color = sel and GRN or C.BORDER_SUBTLE
					end)
				end
				row.MouseButton1Click:Connect(function() choose(e.id) end)
			end
		end)
	end

	------------------------------------------------------------------
	-- 📡 APPEL SERVEUR
	------------------------------------------------------------------

	local function callAct(action, payload, onDone)
		local fn = remote("AdminEventInfoAction")
		if not fn then toast("EventInfo_Server pas installé", false) return end
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" and res.ok then
				toast(res.msg or "OK", true)
				S.data = nil
				S.dirty = false
				if onDone then onDone(true) end
			else
				toast((type(res) == "table" and res.msg) or "Échec", false)
				if onDone then onDone(false) end
			end
			screen(false)
		end)
	end

	local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
		"Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }

	local function fmtWhen(at)
		at = tonumber(at)
		if not at or at <= 0 then return "date inconnue" end
		local d = os.date("!*t", at)
		return string.format("%s %d, %d  ·  %s",
			MONTHS[d.month] or "?", d.day, d.year, fmtAgo(at))
	end

	-- 👁️ Nombre de vues, lisible d'un coup d'œil
	local function fmtViews(n)
		n = tonumber(n) or 0
		if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
		if n >= 1000    then return string.format("%.1fK", n / 1000) end
		return tostring(math.floor(n))
	end

	local function findPost(id)
		for _, p in ipairs((S.data and S.data.posts) or {}) do
			if p.id == id then return p end
		end
		return nil
	end

	local function findDraft(did)
		for _, d in ipairs((S.data and S.data.drafts) or {}) do
			if d.did == did then return d end
		end
		return nil
	end

	-- Ouvre l'éditeur. post = publication publiée, draft = brouillon, rien = neuf
	local function openEditor(postId, draftId, from)
		S.view    = "post"
		S.editId  = postId
		S.editDid = draftId
		S.from    = from or "feed"
		S.draft   = nil
		S.dirty   = false
		screen(false)
	end

	------------------------------------------------------------------
	-- 📰 ÉCRAN 1 — LE FIL
	------------------------------------------------------------------

	local function postRow(parent, order, p)
		local H = IS_MOBILE and 106 or 122

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, H)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10)
		stroke(box, p.autoOpen and CYAN or C.BORDER_SUBTLE, p.autoOpen and 1.5 or 1)

		local topH = H - (IS_MOBILE and 32 or 36)

		-- Zone cliquable : ouvre l'éditeur
		local open = Instance.new("TextButton")
		open.Size = UDim2.new(1, 0, 0, topH)
		open.BackgroundTransparency = 1
		open.AutoButtonColor = false
		open.Text = ""
		open.ZIndex = 12
		open.Parent = box
		open.MouseButton1Click:Connect(function() openEditor(p.id, nil, "feed") end)

		local ih = topH - 20
		local iw = math.floor(ih * 16 / 9)
		local holder = Instance.new("Frame")
		holder.AnchorPoint = Vector2.new(0, 0.5)
		holder.Position = UDim2.new(0, 10, 0.5, 0)
		holder.Size = UDim2.new(0, iw, 0, ih)
		holder.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
		holder.BorderSizePixel = 0
		holder.ClipsDescendants = true
		holder.ZIndex = 13
		holder.Parent = open
		corner(holder, 7)

		if p.imageId and p.imageId ~= "" then
			local im = Instance.new("ImageLabel")
			im.Size = UDim2.new(1, 0, 1, 0)
			im.BackgroundTransparency = 1
			im.Image = p.imageId
			im.ScaleType = Enum.ScaleType.Crop
			im.ZIndex = 14
			im.Parent = holder
		else
			label(holder, { text = "📝", size = UDim2.fromScale(1, 1),
				color = C.TEXT_DIM, textSize = IS_MOBILE and 14 or 17, zIndex = 14 })
		end

		local tx = 10 + iw + 10
		local idW = IS_MOBILE and 74 or 96

		label(open, { text = (p.title ~= "" and p.title) or "(sans titre)",
			size = UDim2.new(1, -tx - idW - 14, 0, IS_MOBILE and 17 or 20),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 10 or 14),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 13 or 15, truncate = true, zIndex = 13 })

		local views = tonumber(p.views) or 0
		label(open, { text = "👁️ " .. fmtViews(views),
			size = UDim2.new(0, idW, 0, IS_MOBILE and 17 or 20),
			position = UDim2.new(1, -10, 0, IS_MOBILE and 8 or 11),
			anchor = Vector2.new(1, 0), xAlign = Enum.TextXAlignment.Right,
			color = views > 0 and CYAN or C.TEXT_DIM,
			textSize = IS_MOBILE and 12 or 15, zIndex = 13 })

		label(open, { text = "#" .. p.id,
			size = UDim2.new(0, idW, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(1, -10, 0, IS_MOBILE and 25 or 32),
			anchor = Vector2.new(1, 0), xAlign = Enum.TextXAlignment.Right,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, zIndex = 13 })

		label(open, { text = "🗓️ " .. fmtWhen(p.at),
			size = UDim2.new(1, -tx - idW - 14, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 29 or 36),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })

		local extra = p.autoOpen and "🚪 ouvre le panel au join" or ""
		local bodyPreview = tostring(p.body or ""):gsub("\n", " ")
		if extra == "" then
			extra = (#bodyPreview > 0) and bodyPreview or "(pas de texte)"
		end
		label(open, { text = extra,
			size = UDim2.new(1, -tx - 14, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 46 or 56),
			xAlign = Enum.TextXAlignment.Left,
			color = p.autoOpen and CYAN or C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })

		-- Barre d'actions
		local acts = Instance.new("Frame")
		acts.AnchorPoint = Vector2.new(0, 1)
		acts.Position = UDim2.new(0, 10, 1, -8)
		acts.Size = UDim2.new(1, -20, 0, IS_MOBILE and 26 or 30)
		acts.BackgroundTransparency = 1
		acts.ZIndex = 13
		acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(0.25, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local function act(o, text, col, colD, fn)
			local w = Instance.new("Frame")
			w.LayoutOrder = o; w.BackgroundTransparency = 1; w.ZIndex = 13; w.Parent = acts
			local b = actionButton(w, { color = col, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13 })
			b.MouseButton1Click:Connect(fn)
		end

		act(1, IS_MOBILE and "✏️" or "✏️ Modifier", C.PURPLE, C.PURPLE_DARK, function()
			openEditor(p.id, nil, "feed")
		end)

		act(2, IS_MOBILE and "🔁" or "🔁 Republier", BELL, BELL_D, function()
			ask({
				title = "Republier « " .. ((p.title ~= "" and p.title) or "sans titre") .. " »",
				accent = BELL, delay = 3, confirmText = "🔁 Republier",
				lines = {
					"Elle remonte tout en haut du fil, avec la date d'aujourd'hui.",
					"Tout le monde revoit la pastille rouge, comme pour une nouvelle "
						.. "publication. C'est ce qu'il faut pour remettre en avant une "
						.. "annonce que les joueurs ont ratée.",
					"Le texte, l'image et le titre ne changent pas.",
				},
				onConfirm = function() callAct("bump", { id = p.id }) end,
			})
		end)

		act(3, IS_MOBILE and "📋" or "📋 Copier", CYAN, Color3.fromRGB(30, 100, 150), function()
			callAct("duplicate", { id = p.id })
		end)

		act(4, IS_MOBILE and "🗑️" or "🗑️ Supprimer", C.RED, C.RED_DARK, function()
			ask({
				title = "Supprimer « " .. ((p.title ~= "" and p.title) or "sans titre") .. " »",
				accent = C.RED, danger = true, delay = 4, confirmText = "🗑️ Supprimer",
				lines = {
					"Elle disparaît du fil pour tous les joueurs, immédiatement.",
					"Le texte et l'image ne sont récupérables nulle part ensuite.",
				},
				warn = "⚠️ Irréversible. Si tu veux juste la masquer un temps, il n'y a "
					.. "pas d'option pour ça — copie son texte quelque part avant.",
				onConfirm = function() callAct("delete", { id = p.id }) end,
			})
		end)

		return box
	end

	------------------------------------------------------------------
	-- 📝 ÉCRAN 1bis — LES BROUILLONS
	------------------------------------------------------------------

	-- Onglets communs au fil et aux brouillons
	local function feedTabs(body, order)
		local nd = #((S.data and S.data.drafts) or {})
		acTabBar(body, order, {
			{ id = "feed",   label = "📰 Le fil" },
			{ id = "drafts", label = (nd > 0) and ("📝 Brouillons (" .. nd .. ")")
				or "📝 Brouillons" },
		}, S.view, BELL, function(id)
			S.view, S.editId, S.editDid, S.draft, S.dirty = id, nil, nil, nil, false
			screen(false)
		end)
	end

	local function draftRow(parent, order, d)
		local H = IS_MOBILE and 100 or 116

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, H)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, C.PURPLE, 1.5)

		local topH = H - (IS_MOBILE and 32 or 36)

		local open = Instance.new("TextButton")
		open.Size = UDim2.new(1, 0, 0, topH)
		open.BackgroundTransparency = 1
		open.AutoButtonColor = false
		open.Text = ""
		open.ZIndex = 12
		open.Parent = box
		open.MouseButton1Click:Connect(function() openEditor(nil, d.did, "drafts") end)

		local ih = topH - 20
		local iw = math.floor(ih * 16 / 9)
		local holder = Instance.new("Frame")
		holder.AnchorPoint = Vector2.new(0, 0.5)
		holder.Position = UDim2.new(0, 10, 0.5, 0)
		holder.Size = UDim2.new(0, iw, 0, ih)
		holder.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
		holder.BorderSizePixel = 0
		holder.ClipsDescendants = true
		holder.ZIndex = 13
		holder.Parent = open
		corner(holder, 7)

		if d.imageId and d.imageId ~= "" then
			local im = Instance.new("ImageLabel")
			im.Size = UDim2.new(1, 0, 1, 0)
			im.BackgroundTransparency = 1
			im.Image = d.imageId
			im.ScaleType = Enum.ScaleType.Crop
			im.ImageTransparency = 0.25   -- grisé : ce n'est pas encore en ligne
			im.ZIndex = 14
			im.Parent = holder
		else
			label(holder, { text = "📝", size = UDim2.fromScale(1, 1),
				color = C.TEXT_DIM, textSize = IS_MOBILE and 14 or 17, zIndex = 14 })
		end

		local tx = 10 + iw + 10
		local tagW = IS_MOBILE and 70 or 88

		label(open, { text = (d.title ~= "" and d.title) or "(sans titre)",
			size = UDim2.new(1, -tx - tagW - 14, 0, IS_MOBILE and 17 or 20),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 10 or 14),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 13 or 15, truncate = true, zIndex = 13 })

		label(open, { text = "📝 BROUILLON",
			size = UDim2.new(0, tagW, 0, IS_MOBILE and 17 or 20),
			position = UDim2.new(1, -10, 0, IS_MOBILE and 10 or 14),
			anchor = Vector2.new(1, 0), xAlign = Enum.TextXAlignment.Right,
			color = C.PURPLE, textSize = IS_MOBILE and 9 or 11, zIndex = 13 })

		label(open, { text = "✍️ Enregistré " .. fmtWhen(d.savedAt),
			size = UDim2.new(1, -tx - 14, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 29 or 36),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })

		local extra = d.autoOpen and "🚪 ouvrira le panel au join une fois publié" or ""
		if extra == "" then
			local bp = tostring(d.body or ""):gsub("\n", " ")
			extra = (#bp > 0) and bp or "(pas de texte)"
		end
		label(open, { text = extra,
			size = UDim2.new(1, -tx - 14, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 46 or 56),
			xAlign = Enum.TextXAlignment.Left,
			color = d.autoOpen and CYAN or C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })

		local acts = Instance.new("Frame")
		acts.AnchorPoint = Vector2.new(0, 1)
		acts.Position = UDim2.new(0, 10, 1, -8)
		acts.Size = UDim2.new(1, -20, 0, IS_MOBILE and 26 or 30)
		acts.BackgroundTransparency = 1
		acts.ZIndex = 13
		acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 7, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local function act(o, text, col, colD, fn)
			local w = Instance.new("Frame")
			w.LayoutOrder = o; w.BackgroundTransparency = 1; w.ZIndex = 13; w.Parent = acts
			local b = actionButton(w, { color = col, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13 })
			b.MouseButton1Click:Connect(fn)
		end

		act(1, IS_MOBILE and "✏️" or "✏️ Modifier", C.PURPLE, C.PURPLE_DARK, function()
			openEditor(nil, d.did, "drafts")
		end)

		act(2, IS_MOBILE and "🚀" or "🚀 Publier", BELL, BELL_D, function()
			ask({
				title = "Publier « " .. ((d.title ~= "" and d.title) or "sans titre") .. " »",
				accent = BELL, delay = 3, confirmText = "🚀 Publier",
				lines = {
					"Le brouillon devient une vraie publication : il arrive en haut du "
						.. "fil, daté d'aujourd'hui, et disparaît de cette liste.",
					"Tout le monde voit la pastille rouge sur la cloche, dans la seconde.",
					d.autoOpen
						and "🚪 Ouverture auto ACTIVÉE : le panel s'ouvrira tout seul "
						.. "dessus au prochain join de chaque joueur."
						or "Le panel ne s'ouvrira pas tout seul (option décochée).",
				},
				onConfirm = function() callAct("draftPublish", { did = d.did }) end,
			})
		end)

		act(3, IS_MOBILE and "🗑️" or "🗑️ Supprimer", C.RED, C.RED_DARK, function()
			ask({
				title = "Supprimer le brouillon",
				accent = C.RED, danger = true, delay = 3, confirmText = "🗑️ Supprimer",
				lines = {
					"Aucun joueur ne l'a jamais vu — rien ne change côté jeu.",
					"Mais le texte et l'image que tu avais préparés sont perdus.",
				},
				onConfirm = function() callAct("draftDelete", { did = d.did }) end,
			})
		end)

		return box
	end

	local function renderDrafts(body)
		local drafts = S.data.drafts or {}
		local maxD = S.data.maxDrafts or 20

		note(body, 0, "📝 Un brouillon, c'est une publication écrite d'avance qui n'existe "
			.. "que pour toi.\n\n"
			.. "Aucun joueur ne le voit, aucune pastille rouge, aucune date de parution : "
			.. "elle est fixée au moment où tu appuies sur 🚀 Publier. Tu peux en préparer "
			.. "trois la veille d'un event et les sortir quand tu veux.", C.PURPLE)

		feedTabs(body, 1)

		bigBtn(body, 2, "➕ NOUVEAU BROUILLON", C.PURPLE, C.PURPLE_DARK, function()
			openEditor(nil, nil, "drafts")
		end)

		sectionLabel(body, 3, string.format("MES BROUILLONS  (%d / %d)", #drafts, maxD))

		if #drafts == 0 then
			note(body, 4, "Aucun brouillon pour l'instant.\n\n"
				.. "Deux façons d'en créer un :\n"
				.. "  • ➕ NOUVEAU BROUILLON ci-dessus\n"
				.. "  • ouvrir une publication du fil et faire « 📝 Copier dans les "
				.. "brouillons » — pratique pour repartir de la mise en forme d'une "
				.. "annonce précédente.", C.TEXT_DIM)
			return
		end

		for i, d in ipairs(drafts) do
			draftRow(body, 100 + i, d)
		end
	end

	------------------------------------------------------------------
	-- 📰 ÉCRAN 1 — LE FIL  (suite)
	------------------------------------------------------------------

	local function renderFeed(body)
		local posts = S.data.posts or {}
		local st = S.data.settings

		-- Bandeau d'état
		local line = string.format("📰 %d publication(s) dans le fil  ·  👁️ %s vue(s) au total",
			#posts, fmtViews(S.data.totalViews or 0))
		if st.feedLimitOn then
			line = line .. string.format("  ·  les joueurs en voient %d", st.feedLimit)
		else
			line = line .. "  ·  les joueurs voient tout"
		end
		if st.storeLimitOn then
			line = line .. string.format("\n🧹 Conservation : %d max (les plus vieilles "
				.. "partent toutes seules)", st.storeLimit)
		end
		if st.enabled == false then
			line = line .. "\n\n⚫ LA CLOCHE EST CACHÉE — aucun joueur ne peut ouvrir le panel."
		end
		local nd = #(S.data.drafts or {})
		if nd > 0 then
			line = line .. string.format("\n📝 %d brouillon(s) en attente — onglet ci-dessous", nd)
		end
		note(body, 0, line, st.enabled == false and C.ORANGE or BELL)

		if not S.data.loaded then
			note(body, 1, "⚠️ Ce serveur n'a pas encore lu le DataStore. Tes modifications "
				.. "seront refusées tant que ce n'est pas résolu (relecture toutes les 45 s).",
				C.ORANGE)
		end

		feedTabs(body, 2)

		bigBtn(body, 3, "➕ NOUVELLE PUBLICATION", GRN, GRN_D, function()
			openEditor(nil, nil, "feed")
		end)

		bigBtn(body, 4, "⚙️ Réglages du panel", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			S.view, S.sdraft, S.dirty = "settings", nil, false
			screen(false)
		end)

		sectionLabel(body, 5, "LE FIL — DE LA PLUS RÉCENTE À LA PLUS ANCIENNE")

		if #posts == 0 then
			note(body, 6, "Le fil est vide. Appuie sur ➕ NOUVELLE PUBLICATION pour écrire "
				.. "la première : elle apparaîtra dans le panel des joueurs, avec sa date, "
				.. "et la cloche se mettra à clignoter en rouge pour tout le monde.",
				C.TEXT_DIM)
			return
		end

		-- ⚠️ LayoutOrder doit rester un ENTIER : on avance de 2 en 2 pour
		--    pouvoir glisser un repère entre deux publications.
		for i, p in ipairs(posts) do
			postRow(body, 100 + i * 2, p)
			-- Repère : à partir d'ici les joueurs ne voient plus rien
			if st.feedLimitOn and i == st.feedLimit and i < #posts then
				note(body, 100 + i * 2 + 1, "── ⬆️ les joueurs s'arrêtent ici ──\n"
					.. "Les publications ci-dessous sont conservées mais invisibles en jeu. "
					.. "Augmente la limite dans les réglages pour les afficher.", C.TEXT_DIM)
			end
		end
	end

	------------------------------------------------------------------
	-- ✏️ ÉCRAN 2 — L'ÉDITEUR
	------------------------------------------------------------------

	local function newPostDraft(p)
		if p then
			return {
				title    = tostring(p.title or ""),
				body     = tostring(p.body or ""),
				imageId  = tostring(p.imageId or ""),
				autoOpen = p.autoOpen == true,
			}
		end
		return { title = "", body = "", imageId = "", autoOpen = false }
	end

	local function previewCard(parent, order)
		local d = S.draft
		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 12); stroke(box, C.BORDER_SUBTLE, 1.5); padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 7)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = box

		local dateF = Instance.new("Frame")
		dateF.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
		dateF.BackgroundTransparency = 1
		dateF.LayoutOrder = 1; dateF.ZIndex = 12; dateF.Parent = box
		-- Un brouillon n'a pas encore de date : elle sera celle de la publication
		local p = (not S.editDid) and S.editId and findPost(S.editId) or nil
		label(dateF, { text = "🗓️ " .. (p and fmtWhen(p.at) or "aujourd'hui (à la publication)"),
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })

		if d.title ~= "" then
			local t = Instance.new("TextLabel")
			t.Size = UDim2.new(1, 0, 0, 0)
			t.AutomaticSize = Enum.AutomaticSize.Y
			t.BackgroundTransparency = 1
			t.Font = FONT
			t.Text = d.title
			t.TextColor3 = C.TEXT_WHITE
			t.TextSize = IS_MOBILE and 14 or 17
			t.TextWrapped = true
			t.TextXAlignment = Enum.TextXAlignment.Left
			t.LayoutOrder = 2; t.ZIndex = 12; t.Parent = box
		end

		local digits = tostring(d.imageId or ""):match("(%d+)")
		if digits then
			local iw = Instance.new("Frame")
			iw.Size = UDim2.new(1, 0, 0, 0)
			iw.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			iw.BorderSizePixel = 0
			iw.ClipsDescendants = true
			iw.LayoutOrder = 3; iw.ZIndex = 12; iw.Parent = box
			corner(iw, 10)
			local ar = Instance.new("UIAspectRatioConstraint")
			ar.AspectRatio = 16 / 9
			ar.DominantAxis = Enum.DominantAxis.Width
			ar.Parent = iw
			local im = Instance.new("ImageLabel")
			im.Size = UDim2.new(1, 0, 1, 0)
			im.BackgroundTransparency = 1
			im.Image = "rbxassetid://" .. digits
			im.ScaleType = Enum.ScaleType.Crop
			im.ZIndex = 13
			im.Parent = iw
		end

		if d.body ~= "" then
			local b = Instance.new("TextLabel")
			b.Size = UDim2.new(1, 0, 0, 0)
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.BackgroundTransparency = 1
			b.Font = FONT
			b.Text = d.body
			b.TextColor3 = digits and C.TEXT_GREY or C.TEXT_WHITE
			b.TextSize = digits and (IS_MOBILE and 10 or 12) or (IS_MOBILE and 11 or 14)
			b.TextWrapped = true
			b.RichText = true
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.TextYAlignment = Enum.TextYAlignment.Top
			b.LayoutOrder = 4; b.ZIndex = 12; b.Parent = box
		end

		return box
	end

	local function renderPost(body)
		local isDraft  = (S.editDid ~= nil)
		local isNew    = (S.editId == nil and not isDraft)
		local existing = S.editId and findPost(S.editId) or nil
		local dr       = isDraft and findDraft(S.editDid) or nil

		if S.editId and not existing then
			note(body, 1, "⚠️ Cette publication n'existe plus (supprimée depuis un autre "
				.. "serveur ?). Reviens au fil.", C.ORANGE)
			return
		end
		if isDraft and not dr then
			note(body, 1, "⚠️ Ce brouillon n'existe plus (supprimé ou publié depuis un "
				.. "autre serveur ?). Reviens à la liste.", C.ORANGE)
			return
		end

		S.draft = S.draft or newPostDraft(existing or dr)
		local d = S.draft

		-- Le libellé du bouton d'enregistrement change selon le mode : il est
		-- rafraîchi à la frappe par field(), donc il doit être décidé ici.
		local saveText = isDraft and "💾 ENREGISTRER LE BROUILLON"
			or "💾 ENREGISTRER (sans renotifier)"

		if isDraft then
			note(body, 0, "📝 Brouillon #" .. dr.did
				.. "\n✍️ Enregistré " .. fmtWhen(dr.savedAt)
				.. "\n⚫ Invisible pour les joueurs — aucune pastille rouge", C.PURPLE)
			note(body, 1, "Tant que tu n'appuies pas sur 🚀 PUBLIER, rien ne sort d'ici. "
				.. "La date de parution sera celle du moment où tu publies, pas celle "
				.. "d'aujourd'hui.\n\n"
				.. "🚀 PUBLIER prend ce que tu as sous les yeux, même sans avoir cliqué "
				.. "sur 💾 avant.", C.TEXT_DIM)
		elseif existing then
			local v = tonumber(existing.views) or 0
			note(body, 0, "✏️ Publication #" .. existing.id
				.. "\n🗓️ Publiée le " .. fmtWhen(existing.at)
				.. "\n👁️ Vue par " .. fmtViews(v) .. " joueur(s)", BELL)
			note(body, 1, "Une vue = un joueur qui a ouvert le panel alors qu'il "
				.. "n'avait pas encore lu cette publication. Un même joueur n'est "
				.. "jamais compté deux fois.\n\n"
				.. "Les vues remontent par paquets toutes les 2 minutes : juste après "
				.. "une publication, le compteur a un peu de retard, c'est normal.\n\n"
				.. "🔁 Republier ne remet PAS le compteur à zéro : les vues de la "
				.. "nouvelle diffusion s'ajoutent aux anciennes.", C.TEXT_DIM)
		else
			note(body, 0, "➕ Nouvelle publication.\nElle arrivera tout en haut du fil, "
				.. "datée d'aujourd'hui, et fera clignoter la cloche en rouge pour tous "
				.. "les joueurs.", GRN)
		end

		sectionLabel(body, 2, "TITRE (60 CARACTÈRES MAX)")
		field(body, 3, {
			key = "title", value = d.title, max = 60, accent = BELL,
			saveText = saveText,
			placeholder = "Ex : Halloween Update — 3 nouveaux UGC",
		})

		sectionLabel(body, 4, "IMAGE (FACULTATIF)")
		field(body, 5, {
			key = "imageId", value = d.imageId, max = 200, accent = BELL,
			saveText = saveText,
			placeholder = "ID ou URL de l'image — laisse vide si tu n'en veux pas",
		})
		note(body, 6, "Colle ce que tu veux : « 1234567890 », « rbxassetid://1234567890 » "
			.. "ou l'URL du catalogue — le serveur extrait l'ID.\n\n"
			.. "📐 Format 16:9 (1280×720 par exemple). Une autre proportion est recadrée "
			.. "au centre.\n\n"
			.. "Sans image, le texte de la publication s'affiche un peu plus gros : c'est "
			.. "lui qui porte tout le message.", C.TEXT_DIM)

		sectionLabel(body, 7, "TEXTE (1500 CARACTÈRES MAX)")
		field(body, 8, {
			key = "body", value = d.body, max = 1500, multiline = true, accent = BELL,
			saveText = saveText,
			placeholder = "Ce que voit le joueur...",
		})
		note(body, 9, "Entrée pour aller à la ligne. Mise en forme RichText possible :\n"
			.. "  <b>gras</b>   ·   <i>italique</i>   ·   "
			.. "<font color=\"#FFD24A\">couleur</font>\n\n"
			.. "L'aperçu plus bas se met à jour dès que tu cliques ailleurs.", C.TEXT_DIM)

		sectionLabel(body, 10, "OUVERTURE AUTOMATIQUE")
		toggle(body, 11, {
			key = "autoOpen", value = d.autoOpen, onColor = CYAN,
			title = "🚪 Ouvrir le panel tout seul sur cette publication",
			onDesc = "Quand un joueur rejoint le jeu et n'a pas encore lu cette "
				.. "publication, le panel s'ouvre de lui-même dessus, 3,5 s après son "
				.. "arrivée. Une seule fois par joueur.",
			offDesc = "Le joueur voit seulement la pastille rouge sur la cloche, et ouvre "
				.. "le panel s'il en a envie.",
		})
		note(body, 12, "À réserver aux grosses annonces. Si tu coches ça sur chaque "
			.. "publication, les joueurs se font ouvrir une fenêtre à chaque connexion et "
			.. "finiront par la fermer sans lire.\n\n"
			.. "Ça ne se déclenche PAS pour les joueurs déjà en partie au moment où tu "
			.. "publies : leur arracher l'écran en pleine game serait pire que la pastille.",
			C.TEXT_DIM)

		sectionLabel(body, 13, "APERÇU — CE QUE VOIT LE JOUEUR")
		previewCard(body, 14)

		--── Actions ──
		sectionLabel(body, 20, "APPLIQUER")

		-- Le contenu de l'éditeur, prêt à partir au serveur
		local function payload(extra)
			local pl = {}
			for k, v in pairs(d) do pl[k] = v end
			if extra then for k, v in pairs(extra) do pl[k] = v end end
			return pl
		end

		local function isEmpty()
			return d.title:gsub("%s", "") == "" and d.body:gsub("%s", "") == ""
		end

		--── Mode BROUILLON ──
		if isDraft then
			local _, lbl = bigBtn(body, 21,
				S.dirty and "💾 ENREGISTRER LE BROUILLON" or "✅ Brouillon à jour",
				S.dirty and C.PURPLE or C.BG_MEDIUM,
				S.dirty and C.PURPLE_DARK or C.BORDER_SUBTLE, function()
					if isEmpty() then
						toast("Écris au moins un titre ou un texte", false)
						return
					end
					callAct("draftSave", payload({ did = S.editDid }))
				end)
			S.saveLbl = lbl

			bigBtn(body, 22, "🚀 PUBLIER CE BROUILLON", BELL, BELL_D, function()
				if isEmpty() then
					toast("Écris au moins un titre ou un texte", false)
					return
				end
				ask({
					title = "Publier ce brouillon",
					accent = BELL, delay = 3, confirmText = "🚀 PUBLIER",
					lines = {
						"Il devient une vraie publication : en haut du fil, daté "
							.. "d'aujourd'hui, et il quitte la liste des brouillons.",
						"Une pastille rouge apparaît sur la cloche de TOUS les joueurs, "
							.. "sur tous les serveurs, dans la seconde.",
						S.dirty
							and "✏️ Tes modifications non enregistrées SONT incluses : "
							.. "c'est ce que tu as sous les yeux qui part."
							or "C'est le contenu ci-dessus qui part, tel quel.",
						d.autoOpen
							and "🚪 Ouverture auto ACTIVÉE : le panel s'ouvrira tout seul "
							.. "dessus au prochain join de chaque joueur."
							or "Le panel ne s'ouvrira pas tout seul (option décochée).",
					},
					onConfirm = function()
						callAct("draftPublish", payload({ did = S.editDid }), function(ok)
							if ok then
								S.view, S.editId, S.editDid, S.draft = "feed", nil, nil, nil
							end
						end)
					end,
				})
			end, C.BG_BLACK)

			bigBtn(body, 23, "🗑️ SUPPRIMER LE BROUILLON", C.RED, C.RED_DARK, function()
				ask({
					title = "Supprimer ce brouillon",
					accent = C.RED, danger = true, delay = 3, confirmText = "🗑️ Supprimer",
					lines = {
						"Aucun joueur ne l'a jamais vu — rien ne change côté jeu.",
						"Mais le texte et l'image que tu avais préparés sont perdus.",
					},
					onConfirm = function()
						callAct("draftDelete", { did = S.editDid }, function(ok)
							if ok then
								S.view, S.editId, S.editDid, S.draft = "drafts", nil, nil, nil
							end
						end)
					end,
				})
			end, C.TEXT_WHITE)

			--── Mode NOUVEAU ──
		elseif isNew then
			bigBtn(body, 21, "🔔 PUBLIER MAINTENANT", BELL, BELL_D, function()
				if isEmpty() then
					toast("Écris au moins un titre ou un texte", false)
					return
				end
				ask({
					title = "Publier cette annonce",
					accent = BELL, delay = 3, confirmText = "🔔 PUBLIER",
					lines = {
						"Elle arrive en haut du fil, datée d'aujourd'hui.",
						"Une pastille rouge apparaît sur la cloche de TOUS les joueurs, "
							.. "sur tous les serveurs, dans la seconde. Elle disparaît "
							.. "quand le joueur ouvre le panel.",
						d.autoOpen
							and "🚪 Ouverture auto ACTIVÉE : le panel s'ouvrira tout seul "
							.. "sur cette publication au prochain join de chaque joueur."
							or "Le panel ne s'ouvrira pas tout seul (option décochée).",
					},
					onConfirm = function()
						callAct("create", d, function(ok)
							if ok then S.view, S.editId, S.draft = "feed", nil, nil end
						end)
					end,
				})
			end, C.BG_BLACK)

			bigBtn(body, 22, "📝 ENREGISTRER COMME BROUILLON", C.PURPLE, C.PURPLE_DARK,
				function()
					if isEmpty() then
						toast("Écris au moins un titre ou un texte", false)
						return
					end
					callAct("draftSave", d, function(ok)
						if ok then
							S.view, S.editId, S.editDid, S.draft = "drafts", nil, nil, nil
						end
					end)
				end)
			note(body, 23, "Le brouillon est gardé côté serveur : tu le retrouves après un "
				.. "redémarrage, depuis n'importe quel serveur, et tes autres admins le "
				.. "voient aussi. Rien n'arrive aux joueurs tant que tu ne publies pas.",
				C.TEXT_DIM)
		else
			local _, lbl = bigBtn(body, 21,
				S.dirty and "💾 ENREGISTRER (sans renotifier)" or "✅ Rien à enregistrer",
				C.BG_LIGHT, C.BORDER_BRIGHT, function()
					if not S.dirty then toast("Aucune modification", false) return end
					callAct("update", payload({ id = S.editId }))
				end)
			S.saveLbl = lbl

			bigBtn(body, 22, "🔁 REPUBLIER EN HAUT DU FIL", BELL, BELL_D, function()
				ask({
					title = "Republier cette annonce",
					accent = BELL, delay = 3, confirmText = "🔁 Republier",
					lines = {
						"Elle remonte en haut du fil avec la date d'aujourd'hui, et tout "
							.. "le monde revoit la pastille rouge.",
						"⚠️ Tes modifications en cours ne sont PAS incluses : enregistre "
							.. "d'abord avec 💾, puis republie.",
					},
					onConfirm = function() callAct("bump", { id = S.editId }) end,
				})
			end, C.BG_BLACK)

			bigBtn(body, 23, "📋 DUPLIQUER (publiée tout de suite)", CYAN,
				Color3.fromRGB(30, 100, 150), function()
					callAct("duplicate", { id = S.editId }, function(ok)
						if ok then S.view, S.editId, S.draft = "feed", nil, nil end
					end)
				end, C.BG_BLACK)

			bigBtn(body, 24, "📝 COPIER DANS LES BROUILLONS", C.PURPLE, C.PURPLE_DARK,
				function()
					callAct("draftFromPost", { id = S.editId }, function(ok)
						if ok then
							S.view, S.editId, S.editDid, S.draft = "drafts", nil, nil, nil
						end
					end)
				end)
			note(body, 25, "📋 Dupliquer crée une copie PUBLIÉE immédiatement.\n"
				.. "📝 Copier dans les brouillons crée une copie que tu peux retravailler "
				.. "tranquillement avant de la sortir — l'originale ne bouge pas dans les "
				.. "deux cas.", C.TEXT_DIM)

			bigBtn(body, 26, "🗑️ SUPPRIMER", C.RED, C.RED_DARK, function()
				ask({
					title = "Supprimer cette publication",
					accent = C.RED, danger = true, delay = 4, confirmText = "🗑️ Supprimer",
					lines = {
						"Elle disparaît du fil pour tous les joueurs, immédiatement.",
						"Le texte et l'image ne sont récupérables nulle part ensuite.",
					},
					warn = "⚠️ Irréversible.",
					onConfirm = function()
						callAct("delete", { id = S.editId }, function(ok)
							if ok then S.view, S.editId, S.draft = "feed", nil, nil end
						end)
					end,
				})
			end, C.TEXT_WHITE)
		end
	end

	------------------------------------------------------------------
	-- ⚙️ ÉCRAN 3 — LES RÉGLAGES
	------------------------------------------------------------------

	local function newSettingsDraft(st)
		return {
			enabled      = st.enabled ~= false,
			panelTitle   = tostring(st.panelTitle or "What's new ?"),
			eventId      = tostring(st.eventId or "auto"),
			btnText      = tostring(st.btnText or "Notify Me"),
			autoOptIn    = st.autoOptIn ~= false,
			feedLimitOn  = st.feedLimitOn == true,
			feedLimit    = tonumber(st.feedLimit) or 10,
			storeLimitOn = st.storeLimitOn ~= false,
			storeLimit   = tonumber(st.storeLimit) or 30,
		}
	end

	local function renderSettings(body)
		S.sdraft = S.sdraft or newSettingsDraft(S.data.settings)
		local d = S.sdraft
		local maxKeep = S.data.maxKeep or 100

		resolvePreview()

		sectionLabel(body, 0, "LA CLOCHE")
		toggle(body, 1, {
			key = "enabled", value = d.enabled, store = d,
			title = "🔔 Cloche visible pour les joueurs",
			onDesc = "La cloche s'affiche dans la barre du haut, entre le ⚙️ et « How To "
				.. "Play ».",
			offDesc = "Cachée pour tout le monde. Pratique pendant que tu prépares une "
				.. "série d'annonces.",
		})

		sectionLabel(body, 2, "TITRE DU PANEL")
		field(body, 3, {
			key = "panelTitle", value = d.panelTitle, max = 60, accent = BELL, store = d,
			placeholder = "What's new ?",
		})

		sectionLabel(body, 4, "COMBIEN DE PUBLICATIONS LES JOUEURS VOIENT")
		toggle(body, 5, {
			key = "feedLimitOn", value = d.feedLimitOn, store = d, onColor = BELL,
			title = "👁️ Limiter le fil affiché",
			onDesc = "Les joueurs ne voient que les N plus récentes. Les autres restent "
				.. "conservées côté serveur, invisibles.",
			offDesc = "Les joueurs voient tout le fil, du plus récent au plus ancien.",
		})
		if d.feedLimitOn then
			stepper(body, 6, { key = "feedLimit", value = d.feedLimit, store = d,
				min = 1, max = maxKeep, suffix = "publication(s)" })
		end
		note(body, 7, "Le fil est envoyé à chaque joueur qui se connecte. Une limite basse "
			.. "(5 à 15) garde le panel lisible et l'envoi léger.", C.TEXT_DIM)

		sectionLabel(body, 8, "COMBIEN DE PUBLICATIONS SONT CONSERVÉES")
		toggle(body, 9, {
			key = "storeLimitOn", value = d.storeLimitOn, store = d, onColor = C.ORANGE,
			title = "🧹 Supprimer automatiquement les plus vieilles",
			onDesc = "Au-delà de la limite, la plus ancienne est supprimée à chaque "
				.. "nouvelle publication.",
			offDesc = "Rien n'est jamais supprimé tout seul. Tu gardes tout l'historique "
				.. "et fais le ménage à la main.",
		})
		if d.storeLimitOn then
			stepper(body, 10, { key = "storeLimit", value = d.storeLimit, store = d,
				min = 1, max = maxKeep, accent = C.ORANGE, suffix = "publication(s)" })
		end
		note(body, 11, "Différent de la limite du dessus : celle-ci décide de ce qui est "
			.. "GARDÉ, l'autre de ce qui est MONTRÉ.\n\n"
			.. "⚠️ La suppression automatique est définitive : une publication effacée "
			.. "n'est récupérable nulle part. Plafond dur : " .. maxKeep .. ".", C.ORANGE)

		sectionLabel(body, 12, "BOUTON VERT — EVENT ROBLOX")
		field(body, 13, {
			key = "btnText", value = d.btnText, max = 24, accent = GRN, store = d,
			placeholder = "Notify Me",
		})

		local isAuto = (d.eventId == "auto" or d.eventId == "")
		acTabBar(body, 14, {
			{ id = "auto",   label = "🤖 Prochain event auto" },
			{ id = "pinned", label = "📌 Un event précis" },
		}, isAuto and "auto" or "pinned", BELL, function(id)
			d.eventId = (id == "auto") and "auto" or ""
			S.dirty = true
			S.ev, S.evErr, S.evFor = nil, nil, nil
			screen(false)
		end)

		local pc = Instance.new("Frame")
		pc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		pc.BackgroundTransparency = 1
		pc.LayoutOrder = 15; pc.ZIndex = 11; pc.Parent = body
		local pb = actionButton(pc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "📋 Choisir dans la liste de mes events",
			textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
		pb.MouseButton1Click:Connect(pickEvent)

		if not isAuto then
			field(body, 16, {
				key = "eventId", value = d.eventId, max = 40, accent = BELL, store = d,
				placeholder = "ID de l'event (chiffres uniquement)",
			})
		end

		if S.evLoading or S.ev == nil then
			note(body, 17, "⏳ Lecture de l'event...", C.TEXT_GREY)
		elseif S.ev == false then
			note(body, 17, "⚠️ Aucun event résolu : " .. tostring(S.evErr or "?") .. "\n\n"
				.. "Ces API sont client-only et ne renvoient RIEN en Studio sur une place "
				.. "non publiée — si tu testes dans Studio, c'est normal.", C.ORANGE)
		else
			note(body, 17, "✅ Event résolu : « " .. S.ev.title .. " »  (ID " .. S.ev.id .. ")"
				.. "\n📅 " .. fmtStart(S.ev.startU), GRN)
		end

		sectionLabel(body, 18, "BOUTON CARRÉ 🔔 — NOTIFICATIONS DU JEU")
		toggle(body, 19, {
			key = "autoOptIn", value = d.autoOptIn, store = d, onColor = CYAN,
			title = "🎁 Proposer les notifs à la 1re ouverture",
			onDesc = "La toute première fois qu'un joueur ouvre le panel, la fenêtre "
				.. "Roblox « active les notifications » s'ouvre d'elle-même après 1,6 s. "
				.. "Une seule fois dans sa vie de joueur.",
			offDesc = "Rien d'automatique : le joueur doit appuyer lui-même sur le bouton "
				.. "carré.",
		})
		note(body, 20, "Roblox refuse d'afficher cette fenêtre si le joueur a déjà activé "
			.. "les notifications, s'il a moins de 13 ans, ou si on lui a déjà proposé dans "
			.. "les 30 derniers jours. Le code demande l'autorisation AVANT : si Roblox dit "
			.. "non, rien ne s'affiche et le joueur ne voit aucune erreur.\n\n"
			.. "En testant sur ton compte tu ne verras probablement rien — c'est que tu as "
			.. "déjà activé les notifs de ton jeu.", C.TEXT_DIM)

		bigBtn(body, 30, S.dirty and "💾 ENREGISTRER LES RÉGLAGES" or "✅ Réglages à jour",
			S.dirty and GRN or C.BG_MEDIUM, S.dirty and GRN_D or C.BORDER_SUBTLE,
			function()
				if not S.dirty then toast("Aucune modification", false) return end
				local willTrim = d.storeLimitOn and (#(S.data.posts or {}) > d.storeLimit)
				if willTrim then
					ask({
						title = "Enregistrer — des publications vont disparaître",
						accent = C.ORANGE, danger = true, delay = 4,
						confirmText = "💾 Enregistrer quand même",
						lines = {
							string.format("Ton fil contient %d publication(s) et tu limites "
								.. "la conservation à %d.", #(S.data.posts or {}), d.storeLimit),
							string.format("Les %d plus anciennes vont être supprimées "
								.. "définitivement.", #(S.data.posts or {}) - d.storeLimit),
						},
						warn = "⚠️ Irréversible.",
						onConfirm = function()
							callAct("settings", d, function(ok)
								if ok then S.sdraft = nil end
							end)
						end,
					})
				else
					callAct("settings", d, function(ok)
						if ok then S.sdraft = nil end
					end)
				end
			end)
	end

	------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	------------------------------------------------------------------

	screen = function(reset)
		currentScreen = "eventinfo"
		if reset then
			S.data = nil; S.failed = false; S.failMsg = nil
			S.view, S.from, S.editId, S.editDid = "feed", "feed", nil, nil
			S.draft, S.sdraft, S.dirty = nil, nil, false
		end

		local postTitle = "➕ NOUVELLE PUBLI"
		if S.editDid then postTitle = "📝 BROUILLON"
		elseif S.editId then postTitle = "✏️ MODIFIER" end

		local titles = {
			feed     = "🔔 WHAT'S NEW",
			drafts   = "📝 BROUILLONS",
			post     = postTitle,
			settings = "⚙️ RÉGLAGES DU PANEL",
		}

		local backFn
		if S.view == "feed" then
			backFn = nil        -- retour à l'accueil du panel admin
		else
			-- L'éditeur revient là d'où on l'a ouvert : le fil ou les brouillons
			local dest = (S.view == "post") and (S.from or "feed") or "feed"
			backFn = function()
				S.view, S.editId, S.editDid = dest, nil, nil
				S.draft, S.sdraft, S.dirty = nil, nil, false
				screen(false)
			end
		end

		local body = buildScreen(titles[S.view] or "🔔 WHAT'S NEW", true, BELL, backFn,
			function() screen(true) end)

		if not remote("AdminGetEventInfo") then
			note(body, 1, "❌ Le serveur n'a pas le système What's new.\n\n"
				.. "Installe EventInfo_Server.lua (version fil de publications) dans "
				.. "ServerScriptService, puis redémarre le serveur.", C.RED)
			return
		end

		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetEventInfo")
				local ok, res = false, nil
				if fn then ok, res = pcall(function() return fn:InvokeServer() end) end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data, S.failMsg = res, nil
				else
					S.failed = true
					if type(res) == "table" and res.msg then S.failMsg = tostring(res.msg)
					elseif ok == false then S.failMsg = "Erreur pendant l'appel : " .. tostring(res)
					else S.failMsg = "Réponse inattendue. Lance _G.EventInfo_Diag() côté serveur." end
				end
				if currentScreen == "eventinfo" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Impossible de lire le fil.\n\n"
					.. (S.failMsg and (S.failMsg .. "\n\n") or "")
					.. "Appuie sur 🔄 en haut.")
				or "Chargement du fil...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		if S.view == "post" then
			renderPost(body)
		elseif S.view == "drafts" then
			renderDrafts(body)
		elseif S.view == "settings" then
			renderSettings(body)
		else
			renderFeed(body)
		end
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "eventinfo", name = "🔔 WHAT'S NEW", color = BELL })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "eventinfo" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 👑 BLOC 7 — SECTION VIP POUR L'ADMIN PANEL
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     Après le bloc 🔔 WHAT'S NEW. Rien à supprimer.
--
--  C'est une IIFE : elle n'ajoute AUCUNE variable locale au script principal
--  (tu restes loin de la limite de 200 registres).
--
--  Ajoute une entrée « 👑 VIP » sur l'ACCUEIL du panel, quatre onglets :
--     👑 La liste           — tous les VIP, qui les a accordés et quand
--     ➕ Ajouter             — cherche un joueur, montre sa fiche, puis confirme
--     📜 Journal            — historique des attributions et des retraits
--     🔒 Sécurité & infos   — comment c'est verrouillé + qui est admin
--
--  ❌ AUCUNE COMMANDE CHAT : tout se fait ici.
--
--  Prérequis serveur : VIPManager.server.lua dans ServerScriptService
--  (il remplace ton ancien VIPChecker.lua).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local GOLD    = Color3.fromRGB(255, 205, 60)
	local GOLD_D  = Color3.fromRGB(160, 120, 25)
	local PASS    = Color3.fromRGB(120, 205, 255)   -- VIP par gamepass
	local PASS_D  = Color3.fromRGB(30, 100, 150)
	local BYADMIN = Color3.fromRGB(190, 130, 255)   -- VIP accordé par un admin
	local BYADM_D = Color3.fromRGB(95, 50, 160)
	local BYGIFT  = Color3.fromRGB(255, 145, 195)   -- VIP reçu en CADEAU (acheté par un joueur)
	local BYGIFT_D= Color3.fromRGB(150, 55, 105)

	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	task.spawn(function()
		for _, n in ipairs({ "AdminGetVIPList", "AdminVIPAction" }) do
			R[n] = ReplicatedStorage:WaitForChild(n, 40)
		end
		if not R.AdminGetVIPList then
			warn("[Admin] AdminGetVIPList introuvable → remplace ton VIPChecker.lua "
				.. "par VIPManager.server.lua dans ServerScriptService")
		end
	end)

	local S = {
		data = nil, loading = false, failed = false, failMsg = nil,
		tab = "list",          -- "list" | "add" | "audit" | "info"
		search = "",
		filter = "all",        -- "all" | "admin" | "gamepass"
		query = "",            -- champ de l'onglet Ajouter
		note = "",
		found = nil,           -- résultat du lookup
		looking = false,
		audit = nil, auditLoading = false,
	}

	local screen  -- forward decl

	------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	------------------------------------------------------------------
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	-- Confirmation avec compte à rebours : impossible d'accorder un VIP par réflexe
	local function ask(opts)
		local wait = tonumber(opts.delay) or 3
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.45
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.94, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12); stroke(card, opts.accent or GOLD, 1.5); padding(card, 12)

		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8)
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Parent = card

		local t = Instance.new("Frame")
		t.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t.BackgroundTransparency = 1
		t.LayoutOrder = 1; t.ZIndex = 52; t.Parent = card
		label(t, { text = opts.title, size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = opts.accent or GOLD,
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 52 })

		-- Fiche du joueur concerné, pour être sûr de ne pas se tromper de cible
		if opts.userId then
			local ph = Instance.new("Frame")
			ph.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 52)
			ph.BackgroundColor3 = C.BG_ITEM
			ph.BackgroundTransparency = 0.3
			ph.BorderSizePixel = 0
			ph.LayoutOrder = 2; ph.ZIndex = 52; ph.Parent = card
			corner(ph, 8)
			local avS = IS_MOBILE and 34 or 40
			local av = makeAvatar(ph, opts.userId, avS, opts.accent or GOLD)
			av.AnchorPoint = Vector2.new(0, 0.5)
			av.Position = UDim2.new(0, 8, 0.5, 0)
			label(ph, { text = esc(opts.userName or tostring(opts.userId)),
				size = UDim2.new(1, -(avS + 24), 0, IS_MOBILE and 17 or 20),
				position = UDim2.new(0, avS + 16, 0, IS_MOBILE and 5 or 6),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
				textSize = IS_MOBILE and 13 or 15, truncate = true, zIndex = 53 })
			label(ph, { text = "🆔 " .. tostring(opts.userId),
				size = UDim2.new(1, -(avS + 24), 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, avS + 16, 0, IS_MOBILE and 23 or 27),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 53 })
		end

		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundColor3 = C.BG_ITEM
		body.BackgroundTransparency = 0.3
		body.BorderSizePixel = 0
		body.Font = FONT
		body.Text = table.concat(opts.lines or {}, "\n\n")
		body.TextColor3 = C.TEXT_WHITE
		body.TextSize = IS_MOBILE and 11 or 13
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.LayoutOrder = 3; body.ZIndex = 52; body.Parent = card
		corner(body, 8)
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 8)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = body

		if opts.warn then
			local w = Instance.new("TextLabel")
			w.Size = UDim2.new(1, 0, 0, 0)
			w.AutomaticSize = Enum.AutomaticSize.Y
			w.BackgroundTransparency = 1
			w.Font = FONT
			w.Text = opts.warn
			w.TextColor3 = opts.danger and C.RED or C.ORANGE
			w.TextSize = IS_MOBILE and 10 or 12
			w.TextWrapped = true
			w.TextXAlignment = Enum.TextXAlignment.Left
			w.LayoutOrder = 4; w.ZIndex = 52; w.Parent = card
		end

		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 5; btns.ZIndex = 52; btns.Parent = card
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 10, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder
		bg.Parent = btns

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 52; w1.Parent = btns
		local cb = actionButton(w1, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Annuler", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })
		cb.MouseButton1Click:Connect(close)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 52; w2.Parent = btns
		local okBtn, okLbl = actionButton(w2, { color = C.BG_MEDIUM,
			strokeColor = C.BORDER_SUBTLE, text = "⏳",
			textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })

		local armed = false
		task.spawn(function()
			for r = wait, 1, -1 do
				if closed then return end
				okLbl.Text = "⏳ Lis d'abord — " .. r .. " s"
				task.wait(1)
			end
			if closed then return end
			armed = true
			okBtn.BackgroundColor3 = opts.danger and C.RED or (opts.accent or GOLD)
			okLbl.Text = opts.confirmText or "✅ Confirmer"
		end)

		okBtn.MouseButton1Click:Connect(function()
			if not armed then
				toast("Prends le temps de lire — le bouton s'active tout seul", false)
				return
			end
			close()
			if opts.onConfirm then opts.onConfirm() end
		end)
	end

	local function bigBtn(parent, order, text, col, colD, fn, textCol)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 50)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b = actionButton(c, { color = col, strokeColor = colD, text = text,
			textColor = textCol, textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b
	end

	local function callAct(action, payload, onDone)
		local fn = remote("AdminVIPAction")
		if not fn then toast("VIPManager pas installé côté serveur", false) return end
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" then
				if res.msg then toast(res.msg, res.ok == true) end
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

	------------------------------------------------------------------
	-- 👑 ONGLET LISTE
	------------------------------------------------------------------
	-- 🎁 Trois origines DISTINCTES, à ne pas confondre :
	--    admin    = un admin l'a donné à la main depuis ce panel
	--    gift     = un joueur l'a OFFERT à un autre en payant des Robux
	--    gamepass = acheté par le joueur lui-même
	--  Avant, « gift » retombait dans le cas par défaut et s'affichait
	--  « 🎟️ GAMEPASS · obtenu automatiquement en achetant le gamepass » —
	--  faux, et c'est ce qui rendait le diagnostic impossible.
	local function srcMeta(s)
		if s == "admin" then
			return "🎁 OFFERT", BYADMIN, BYADM_D
		elseif s == "gift" then
			return "💝 CADEAU", BYGIFT, BYGIFT_D
		end
		return "🎟️ GAMEPASS", PASS, PASS_D
	end

	local function vipRow(parent, order, e)
		local uid   = e.userId
		local uname = unameCache[uid] or tostring(uid)
		local onlinePl = Players:GetPlayerByUserId(uid)
		local disp  = onlinePl and onlinePl.DisplayName or uname
		local badgeTxt, badgeCol, badgeDark = srcMeta(e.s)

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, badgeCol, 1.5); padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = box

		--── Ligne 1 : avatar + nom + badge de source ──
		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local avS = IS_MOBILE and 30 or 36
		local av = makeAvatar(head, uid, avS, badgeCol)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, 0, 0.5, 0)

		local bdW = IS_MOBILE and 78 or 96
		label(head, {
			text = "👑 " .. esc(disp) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -avS - bdW - 16, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 1 or 2),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13,
		})
		label(head, {
			text = "@" .. uname .. "  ·  " .. tostring(uid),
			size = UDim2.new(1, -avS - bdW - 16, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13,
		})

		local badge = Instance.new("TextLabel")
		badge.AnchorPoint = Vector2.new(1, 0.5)
		badge.Position = UDim2.new(1, 0, 0.5, 0)
		badge.Size = UDim2.new(0, bdW, 0, IS_MOBILE and 20 or 24)
		badge.BackgroundColor3 = badgeCol
		badge.BorderSizePixel = 0
		badge.Font = FONT
		badge.Text = badgeTxt
		badge.TextColor3 = C.BG_BLACK
		badge.TextSize = IS_MOBILE and 9 or 11
		badge.ZIndex = 13
		badge.Parent = head
		corner(badge, 5)

		--── Ligne 2 : la traçabilité, c'est ce bloc ──
		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1, 0, 0, 0)
		info.AutomaticSize = Enum.AutomaticSize.Y
		info.BackgroundColor3 = C.BG_ITEM
		info.BackgroundTransparency = 0.35
		info.BorderSizePixel = 0
		info.Font = FONT
		info.TextColor3 = C.TEXT_GREY
		info.TextSize = IS_MOBILE and 9 or 11
		info.TextWrapped = true
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.LayoutOrder = 2
		info.ZIndex = 12
		info.Parent = box
		corner(info, 7)
		local ip = Instance.new("UIPadding")
		ip.PaddingTop = UDim.new(0, 6); ip.PaddingBottom = UDim.new(0, 6)
		ip.PaddingLeft = UDim.new(0, 8); ip.PaddingRight = UDim.new(0, 8)
		ip.Parent = info

		local lines = {}
		if e.s == "admin" then
			table.insert(lines, "🎁 Offert par 👮 " .. tostring(e.by or "?")
				.. ((e.bi and e.bi > 0) and ("  ·  ID " .. e.bi) or ""))
		elseif e.s == "gift" then
			table.insert(lines, "💝 Reçu en CADEAU d'un autre joueur (payé en Robux)")
		else
			table.insert(lines, "🎟️ Obtenu automatiquement en achetant le gamepass")
		end
		if e.t and e.t > 0 then
			table.insert(lines, "📅 " .. os.date("!%d/%m/%Y %H:%M", e.t) .. " UTC  ·  " .. fmtAgo(e.t))
		else
			table.insert(lines, "📅 Date inconnue (fiche héritée de l'ancien système)")
		end
		if e.n and e.n ~= "" then
			table.insert(lines, "📝 " .. tostring(e.n))
		end
		table.insert(lines, onlinePl and "🟢 En ligne sur ce serveur" or "⚪ Hors ligne")
		info.Text = table.concat(lines, "\n")

		--── Ligne 3 : actions ──
		local acts = Instance.new("Frame")
		acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		acts.BackgroundTransparency = 1
		acts.LayoutOrder = 3; acts.ZIndex = 12; acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local function act(o, text, col, colD, fn)
			local w = Instance.new("Frame")
			w.LayoutOrder = o; w.BackgroundTransparency = 1; w.ZIndex = 12; w.Parent = acts
			local b = actionButton(w, { color = col, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(fn)
		end

		act(1, IS_MOBILE and "👤" or "👤 Profil", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(uname, function() screen(false) end)
		end)

		act(2, IS_MOBILE and "🔄" or "🔄 Gamepass ?", PASS_D, PASS, function()
			callAct("recheck", { userId = uid })
		end)

		act(3, IS_MOBILE and "❌" or "❌ Retirer", C.RED, C.RED_DARK, function()
			ask({
				title = "Retirer le VIP de " .. uname,
				userId = uid, userName = disp,
				accent = C.RED, danger = true, delay = 4, confirmText = "❌ Retirer le VIP",
				lines = {
					"Il perdra son badge doré sur TOUS les leaderboards, dans la seconde.",
					(e.s == "gamepass")
						and "⚠️ Ce VIP vient du GAMEPASS. Si le joueur le possède toujours, "
						.. "il sera automatiquement remis dans la liste à sa prochaine "
						.. "connexion — le retirer ne sert donc à rien tant qu'il a le pass."
						or ((e.s == "gift")
							and "💝 Ce VIP a été PAYÉ EN ROBUX par un autre joueur qui le lui "
							.. "a offert. Le retirer, c'est retirer quelque chose d'acheté : "
							.. "à ne faire qu'en cas de fraude avérée."
							or ("Ce VIP avait été offert par 👮 " .. tostring(e.by or "?")
								.. ". Le retirer est définitif : il faudra le ré-accorder à la main.")),
					"Le retrait est tracé dans la console serveur avec ton nom.",
				},
				onConfirm = function()
					callAct("remove", { userId = uid }, function(res)
						if res and res.ok then S.data, S.audit = nil, nil; screen(false) end
					end)
				end,
			})
		end)

		return box
	end

	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs((S.data and S.data.entries) or {}) do
			local okF = (S.filter == "all")
				or (S.filter == "admin"    and e.s == "admin")
				or (S.filter == "gift"     and e.s == "gift")
				or (S.filter == "gamepass" and e.s ~= "admin" and e.s ~= "gift")
			local okQ = true
			if #q > 0 then
				local un = (unameCache[e.userId] or ""):lower()
				okQ = (un:find(q, 1, true) ~= nil)
					or (tostring(e.userId) == q)
					or (tostring(e.by or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
			end
			if okF and okQ then table.insert(out, e) end
		end
		return out
	end

	local function renderList(body)
		local d = S.data

		local head = string.format(
			"👑 %d VIP au total  ·  🎟️ %d gamepass  ·  🎁 %d offerts  ·  💝 %d cadeaux",
			d.total or 0, d.byPass or 0, d.byAdmin or 0, d.byGift or 0)

		-- 🛰️ Santé de la synchro multi-serveurs. Si ça dit HS, c'est LA raison
		--    pour laquelle un VIP pourrait « disparaître » d'un serveur.
		if d.syncOk == false then
			head = head .. "\n⚠️ MessagingService HS sur ce serveur — la liste reste "
				.. "juste (relecture auto), mais avec jusqu'à 60 s de retard."
		end
		if d.truncated then
			head = head .. string.format("\n⚠️ Seuls les %d plus récents sont affichés ici "
				.. "(les autres restent bien VIP en jeu).", d.maxShown or 300)
		end
		note(body, 0, head, GOLD)

		if not d.loaded then
			note(body, 1, "⚠️ Ce serveur n'a pas encore lu la liste dans le DataStore. "
				.. "Toute modification sera refusée en attendant — nouvelle tentative "
				.. "toutes les 15 s.", C.ORANGE)
		end

		--── Recherche ──
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 2; sw.ZIndex = 11; sw.Parent = body
		local sb = Instance.new("TextBox")
		sb.Size = UDim2.new(1, 0, 1, 0)
		sb.BackgroundColor3 = C.BG_DARK
		sb.BorderSizePixel = 0
		sb.Font = FONT
		sb.PlaceholderText = "🔍 Pseudo, UserID, ou nom de l'admin qui l'a offert..."
		sb.PlaceholderColor3 = C.TEXT_DIM
		sb.Text = S.search or ""
		sb.TextColor3 = C.TEXT_WHITE
		sb.TextSize = IS_MOBILE and 11 or 14
		sb.TextXAlignment = Enum.TextXAlignment.Left
		sb.ClearTextOnFocus = false
		sb.ZIndex = 12
		sb.Parent = sw
		corner(sb, 8); stroke(sb, C.BORDER_SUBTLE, 1)
		local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sb

		--── Filtres ──
		acTabBar(body, 3, {
			{ id = "all",      label = IS_MOBILE and "🌐" or "🌐 Tous" },
			{ id = "gamepass", label = IS_MOBILE and "🎟️" or "🎟️ Gamepass" },
			{ id = "admin",    label = IS_MOBILE and "🎁" or "🎁 Offerts" },
			{ id = "gift",     label = IS_MOBILE and "💝" or "💝 Cadeaux" },
		}, S.filter, GOLD, function(id) S.filter = id; screen(false) end)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 4; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 5; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local render
		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			local list = visible()
			cLbl.Text = string.format("%d affiché(s) sur %d chargé(s)",
				#list, #((S.data and S.data.entries) or {}))
			if #list == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 70); f.BackgroundTransparency = 1
				f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
				label(f, {
					text = (#((S.data and S.data.entries) or {}) == 0)
						and "Aucun VIP pour l'instant.\n\nUtilise l'onglet ➕ Ajouter, ou attends "
						.. "qu'un joueur achète le gamepass."
						or "Rien ne correspond à ce filtre.",
					size = UDim2.fromScale(1, 1), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			else
				for i, e in ipairs(list) do vipRow(holder, i, e) end
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text; render()
		end)

		-- Résoudre les @pseudos de tout le monde en un seul appel
		local ids = {}
		for _, e in ipairs(d.entries or {}) do table.insert(ids, e.userId) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if holder and holder.Parent then render() end
			end)
		end)
		render()
	end

	------------------------------------------------------------------
	-- ➕ ONGLET AJOUTER
	------------------------------------------------------------------
	local function renderAdd(body)
		note(body, 0, "Cherche un joueur, vérifie que c'est bien lui, puis accorde-lui le "
			.. "VIP. Ton nom sera enregistré sur sa fiche : n'importe quel admin verra "
			.. "ensuite que c'est toi qui l'a offert, et quand.", GOLD)

		--── Barre de recherche ──
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 1; sw.ZIndex = 11; sw.Parent = body

		local btnW = IS_MOBILE and 62 or 82
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.Size = UDim2.new(1, -btnW - 8, 1, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.Font = FONT
		box.PlaceholderText = "Pseudo exact ou UserID..."
		box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = S.query or ""
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 12 or 15
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.ZIndex = 12
		box.Parent = sw
		corner(box, 9); stroke(box, GOLD, 1)
		local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box
		box:GetPropertyChangedSignal("Text"):Connect(function() S.query = box.Text end)

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, 0, 0.5, 0)
		gc.Size = UDim2.new(0, btnW, 1, 0)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 12; gc.Parent = sw

		local function lookup()
			local q = (S.query or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if #q < 2 then toast("Entre un pseudo ou un UserID", false) return end
			if S.looking then return end
			S.looking = true
			S.found = nil
			screen(false)
			callAct("lookup", { target = q }, function(res)
				S.looking = false
				if res and res.ok then S.found = res end
				screen(false)
			end)
		end

		local gb = actionButton(gc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🔍", textSize = IS_MOBILE and 14 or 17, radius = 9, zIndex = 12 })
		gb.MouseButton1Click:Connect(lookup)
		box.FocusLost:Connect(function(enter) if enter then lookup() end end)

		if S.looking then
			note(body, 2, "⏳ Recherche en cours...", C.TEXT_GREY)
			return
		end

		if not S.found then
			note(body, 2, "Tape un pseudo exact (celui de Roblox, pas le nom affiché) ou un "
				.. "UserID, puis appuie sur 🔍.\n\n"
				.. "Astuce : dans 🏆 BOARDS ou 👤 PROFILE, chaque fiche a un UserID "
				.. "copiable — pratique si le pseudo contient des caractères spéciaux.",
				C.TEXT_DIM)
			return
		end

		--── Fiche du joueur trouvé ──
		local f = S.found
		local hc = Instance.new("Frame")
		hc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 84 or 104)
		hc.BackgroundColor3 = C.BG_DARK
		hc.BorderSizePixel = 0
		hc.LayoutOrder = 2
		hc.ZIndex = 12
		hc.Parent = body
		corner(hc, 10); stroke(hc, f.isVip and GOLD or C.BORDER_SUBTLE, 1.5)
		gradient(hc, C.BG_DARK, C.BG_ITEM)

		local avSize = IS_MOBILE and 58 or 76
		local av = makeAvatar(hc, f.userId, avSize, f.isVip and GOLD or C.PURPLE)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, 10, 0.5, 0)

		local ix = 10 + avSize + 12
		label(hc, { text = (f.isVip and "👑 " or "") .. esc(f.name),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 20 or 26),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 8 or 12),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 15 or 19, truncate = true, zIndex = 13 })
		label(hc, { text = "🆔 " .. tostring(f.userId)
			.. (f.online and "  ·  🟢 en ligne" or "  ·  ⚪ hors ligne"),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 30 or 40),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })

		local passTxt, passCol
		if f.hasPass == true then
			passTxt, passCol = "🎟️ Possède le gamepass VIP", PASS
		elseif f.hasPass == false then
			passTxt, passCol = "🚫 Ne possède PAS le gamepass", C.ORANGE
		else
			passTxt, passCol = "❓ Roblox n'a pas répondu sur le gamepass", C.TEXT_DIM
		end
		label(hc, { text = passTxt,
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 48 or 62),
			xAlign = Enum.TextXAlignment.Left, color = passCol,
			textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 13 })

		--── Déjà VIP ? ──
		if f.isVip then
			local r = f.record or {}
			local who = (r.s == "admin")
				and ("🎁 Offert par 👮 " .. tostring(r.by or "?"))
				or (r.s == "gift")
				and "💝 Reçu en CADEAU d'un autre joueur (payé en Robux)"
				or "🎟️ Obtenu via le gamepass"
			note(body, 3, "✅ Ce joueur est DÉJÀ VIP.\n\n" .. who
				.. ((r.t and r.t > 0) and ("\n📅 " .. fmtAgo(r.t)) or "")
				.. ((r.n and r.n ~= "") and ("\n📝 " .. r.n) or ""), GOLD)
			bigBtn(body, 4, "❌ RETIRER SON VIP", C.RED, C.RED_DARK, function()
				ask({
					title = "Retirer le VIP de " .. f.name,
					userId = f.userId, userName = f.name,
					accent = C.RED, danger = true, delay = 4, confirmText = "❌ Retirer",
					lines = {
						"Il perdra son badge doré sur tous les leaderboards immédiatement.",
						(r.s == "gamepass" and f.hasPass == true)
							and "⚠️ Il possède le gamepass : il sera automatiquement remis "
							.. "VIP à sa prochaine connexion. Le retrait ne tiendra pas."
							or (r.s == "gift")
							and "💝 Ce VIP a été PAYÉ EN ROBUX par le joueur qui le lui a "
							.. "offert. À ne retirer qu'en cas de fraude avérée."
							or "Le retrait est définitif — il faudra le ré-accorder à la main.",
					},
					onConfirm = function()
						callAct("remove", { userId = f.userId }, function(res)
							if res and res.ok then
								S.found, S.data, S.audit = nil, nil, nil
								S.tab = "list"
								screen(false)
							end
						end)
					end,
				})
			end, C.TEXT_WHITE)
			return
		end

		--── Note libre ──
		sectionLabel(body, 5, "NOTE (FACULTATIF — VISIBLE PAR LES AUTRES ADMINS)")
		local nb = Instance.new("TextBox")
		nb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		nb.BackgroundColor3 = C.BG_DARK
		nb.BorderSizePixel = 0
		nb.Font = FONT
		nb.PlaceholderText = "Ex : gagnant du concours de novembre"
		nb.PlaceholderColor3 = C.TEXT_DIM
		nb.Text = S.note or ""
		nb.TextColor3 = C.TEXT_WHITE
		nb.TextSize = IS_MOBILE and 11 or 13
		nb.TextXAlignment = Enum.TextXAlignment.Left
		nb.ClearTextOnFocus = false
		nb.LayoutOrder = 6
		nb.ZIndex = 11
		nb.Parent = body
		corner(nb, 8); stroke(nb, C.BORDER_SUBTLE, 1)
		local np = Instance.new("UIPadding")
		np.PaddingLeft = UDim.new(0, 10); np.PaddingRight = UDim.new(0, 10)
		np.Parent = nb
		nb:GetPropertyChangedSignal("Text"):Connect(function() S.note = nb.Text end)

		bigBtn(body, 7, "👑 ACCORDER LE VIP", GOLD, GOLD_D, function()
			ask({
				title = "Accorder le VIP à " .. f.name,
				userId = f.userId, userName = f.name,
				accent = GOLD, delay = 4, confirmText = "👑 ACCORDER LE VIP",
				lines = {
					"Il aura le badge doré, l'anneau sur son avatar et le reflet sur son "
						.. "entrée, sur TOUS tes leaderboards, dans la seconde.",
					"Ta fiche sera enregistrée : « offert par 👮 " .. player.Name
						.. " », avec la date. Les autres admins la verront dans la liste.",
					(f.hasPass == false)
						and "🚫 Ce joueur ne possède pas le gamepass : c'est donc un VIP "
						.. "offert, qui restera acquis même s'il n'achète jamais le pass."
						or "🎟️ Il possède déjà le gamepass — la fiche notera quand même que "
						.. "c'est toi qui l'as ajouté manuellement.",
				},
				warn = "⚠️ Le VIP offert ne s'enlève pas tout seul. Pour le retirer il "
					.. "faudra revenir ici à la main.",
				onConfirm = function()
					callAct("add", { userId = f.userId, note = S.note }, function(res)
						if res and res.ok then
							S.found, S.query, S.note, S.data, S.audit = nil, "", "", nil, nil
							S.tab = "list"
							screen(false)
						end
					end)
				end,
			})
		end, C.BG_BLACK)

		bigBtn(body, 8, "👤 Voir son profil complet", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(f.name, function() screen(false) end)
		end)
	end

	------------------------------------------------------------------
	-- 📜 ONGLET JOURNAL D'AUDIT
	------------------------------------------------------------------
	local function auditRow(parent, order, e)
		local uid   = tonumber(e.u) or 0
		local uname = unameCache[uid] or tostring(uid)
		local isGrant = (e.a ~= "revoke")
		local col   = isGrant and GOLD or C.RED
		local H     = IS_MOBILE and 70 or 82

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, H)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, col, 1)

		local avS = H - 26
		local av = makeAvatar(box, uid, avS, col)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, 9, 0.5, 0)

		local tx  = 9 + avS + 10
		local bdW = IS_MOBILE and 68 or 86

		label(box, { text = esc(uname),
			size = UDim2.new(1, -tx - bdW - 14, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 7 or 10),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12 })

		local badge = Instance.new("TextLabel")
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, -9, 0, IS_MOBILE and 7 or 10)
		badge.Size = UDim2.new(0, bdW, 0, IS_MOBILE and 17 or 20)
		badge.BackgroundColor3 = col
		badge.BorderSizePixel = 0
		badge.Font = FONT
		badge.Text = isGrant and "👑 DONNÉ" or "❌ RETIRÉ"
		badge.TextColor3 = C.BG_BLACK
		badge.TextSize = IS_MOBILE and 9 or 11
		badge.ZIndex = 12
		badge.Parent = box
		corner(badge, 5)

		local who = (e.bi and e.bi > 0)
			and ("👮 " .. tostring(e.by or "?"))
			or "🤖 automatique (gamepass)"
		label(box, { text = who .. "  ·  " .. ((e.t and e.t > 0) and fmtAgo(e.t) or "?"),
			size = UDim2.new(1, -tx - 14, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 25 or 32),
			xAlign = Enum.TextXAlignment.Left,
			color = (e.bi and e.bi > 0) and BYADMIN or PASS,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })

		local detail = "🆔 " .. tostring(uid)
		if e.t and e.t > 0 then
			detail = detail .. "  ·  " .. os.date("!%d/%m/%Y %H:%M", e.t) .. " UTC"
		end
		if e.n and e.n ~= "" then detail = detail .. "  ·  📝 " .. tostring(e.n) end
		label(box, { text = detail,
			size = UDim2.new(1, -tx - 14, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 42 or 53),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })

		return box
	end

	local function renderAudit(body)
		note(body, 0, "Chaque attribution et chaque retrait est écrit ici, sur une clé "
			.. "DataStore séparée. Même après avoir retiré un VIP, tu sais qui l'avait "
			.. "donné et quand.\n\n"
			.. "Les 200 dernières actions sont conservées. Ce journal ne quitte jamais le "
			.. "serveur vers un joueur ordinaire.", GOLD)

		if not S.audit and not S.auditLoading then
			S.auditLoading = true
			callAct("audit", {}, function(res)
				S.auditLoading = false
				S.audit = (res and res.ok and res.entries) or {}
				if currentScreen == "vip" and window.Visible and S.tab == "audit" then
					screen(false)
				end
			end)
		end

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 1; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 2; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		if S.auditLoading or not S.audit then
			cLbl.Text = "Chargement du journal..."
			return
		end

		local list = S.audit
		cLbl.Text = string.format("%d action(s) enregistrée(s)", #list)

		if #list == 0 then
			label(holder, { text = "Aucune action enregistrée pour l'instant.",
				size = UDim2.new(1, 0, 0, 60), wrapped = true,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			return
		end

		-- ⚠️ resolveUsernames appelle son callback SYNCHRONEMENT si tous les
		-- pseudos sont déjà en cache : on ne dessine donc QUE dans le callback,
		-- sinon chaque ligne apparaîtrait en double.
		local ids = {}
		for _, e in ipairs(list) do table.insert(ids, tonumber(e.u) or 0) end
		resolveUsernames(ids, function()
			if not holder.Parent then return end
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			for i, e in ipairs(list) do auditRow(holder, i, e) end
		end)
	end

	------------------------------------------------------------------
	-- ⚙️ ONGLET INFOS
	------------------------------------------------------------------
	local function renderInfo(body)
		local d = S.data

		sectionLabel(body, -1, "🔒 SÉCURITÉ — POURQUOI PERSONNE NE PEUT SE DONNER LE VIP")
		note(body, 0, "1️⃣ Aucune décision n'est prise sur ton PC. Le panel ne fait "
			.. "qu'envoyer une demande ; c'est le serveur qui accepte ou refuse.\n\n"
			.. "2️⃣ Quand un client appelle une remote, Roblox y attache lui-même "
			.. "l'identité du joueur. Un exploiteur peut mentir sur TOUT ce qu'il envoie, "
			.. "jamais sur qui il est. C'est cette identité, et elle seule, qui est "
			.. "comparée à la liste d'admins.\n\n"
			.. "3️⃣ La liste d'admins vit dans le script serveur. Elle n'est jamais "
			.. "envoyée à un joueur ordinaire et ne peut pas être modifiée en cours de "
			.. "partie.\n\n"
			.. "4️⃣ Un joueur qui bricole les remotes reçoit « Accès refusé » et "
			.. "apparaît dans la console serveur avec son UserID et son nombre de "
			.. "tentatives.", C.GREEN)

		note(body, 1, "🕵️ CE QUI SORT VERS LES JOUEURS ORDINAIRES\n\n"
			.. "Uniquement la liste des UserID qui sont VIP — c'est indispensable pour "
			.. "afficher le badge sur les leaderboards.\n\n"
			.. "Ni les noms des admins, ni les dates, ni les notes, ni ce journal ne "
			.. "quittent le serveur vers un joueur normal.", C.TEXT_DIM)

		note(body, 2, "✍️ FIABILITÉ DES ÉCRITURES\n\n"
			.. "La vérification « est-il déjà VIP ? » se fait à l'intérieur de la "
			.. "transaction DataStore, sur la valeur réelle en base — pas sur une copie "
			.. "en mémoire qui pourrait être périmée.\n\n"
			.. "Conséquence : deux admins sur deux serveurs différents ne peuvent plus "
			.. "s'écraser mutuellement, et un double-clic ne crée pas deux fiches. "
			.. "(L'ancien VIPChecker utilisait SetAsync et perdait des VIP dans ce cas.)",
			C.GREEN)

		sectionLabel(body, 3, "🎟️ GAMEPASS " .. tostring(d.passId or "?"))
		note(body, 4, "Quand un joueur rejoint, le serveur demande à Roblox s'il possède "
			.. "ce gamepass. Si oui et qu'il n'est pas déjà dans la liste, il y est ajouté "
			.. "avec la source « gamepass ».\n\n"
			.. "⚠️ Personne n'est JAMAIS retiré tout seul, même sans le pass. C'est "
			.. "volontaire : l'API Roblox répond mal de temps en temps, et un joueur "
			.. "perdrait son badge à cause d'une simple erreur réseau.", PASS)

		sectionLabel(body, 5, "🎁 VIP OFFERT")
		note(body, 6, "C'est ce que tu fais depuis l'onglet ➕ Ajouter. La fiche garde ton "
			.. "nom, ton UserID, la date et ta note.\n\n"
			.. "Un VIP offert ne disparaît jamais tout seul — seul un admin peut le "
			.. "retirer, et le retrait est tracé dans le journal.", BYADMIN)

		sectionLabel(body, 7, "💾 OÙ C'EST STOCKÉ")
		note(body, 8, "Une clé DataStore (« all_vips » dans VIPPlayers_v1) pour la liste, "
			.. "une autre (« vip_audit ») pour le journal.\n\n"
			.. "À chaque changement, tous les clients reçoivent la nouvelle liste : les "
			.. "leaderboards se mettent à jour dans la seconde, sans attendre leur cycle "
			.. "de refresh de 2 minutes.", C.TEXT_DIM)

		sectionLabel(body, 9, "QUI PEUT FAIRE ÇA")
		note(body, 10, "Seuls les UserID ci-dessous peuvent ouvrir cette section et "
			.. "modifier la liste. Le serveur revérifie à CHAQUE appel.\n\n"
			.. "Pour ajouter un admin il faut modifier ADMIN_IDS dans les DEUX fichiers "
			.. "(le panel client ET VIPManager.server.lua), puis redémarrer les serveurs. "
			.. "Si tu ne le mets que côté client, la personne verra le bouton mais toutes "
			.. "ses actions seront refusées — ce qui est le comportement voulu.",
			C.TEXT_DIM)

		local admins = d.admins or {}
		for i, a in ipairs(admins) do
			local uname = unameCache[a.userId] or a.name or tostring(a.userId)
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 46 or 54)
			row.BackgroundColor3 = C.BG_DARK
			row.BorderSizePixel = 0
			row.LayoutOrder = 100 + i
			row.ZIndex = 11
			row.Parent = body
			corner(row, 9)
			stroke(row, (a.userId == player.UserId) and GOLD or C.BORDER_SUBTLE,
				(a.userId == player.UserId) and 1.5 or 1)

			local avS = IS_MOBILE and 30 or 36
			local av = makeAvatar(row, a.userId, avS,
				(a.userId == player.UserId) and GOLD or C.PURPLE)
			av.AnchorPoint = Vector2.new(0, 0.5)
			av.Position = UDim2.new(0, 8, 0.5, 0)

			local tx = 8 + avS + 10
			label(row, {
				text = "👮 " .. esc(uname)
					.. ((a.userId == player.UserId) and "   ← toi" or ""),
				size = UDim2.new(1, -tx - 10, 0, IS_MOBILE and 16 or 19),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 7 or 9),
				xAlign = Enum.TextXAlignment.Left,
				color = (a.userId == player.UserId) and GOLD or C.TEXT_WHITE,
				textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 12 })
			label(row, { text = "🆔 " .. tostring(a.userId),
				size = UDim2.new(1, -tx - 10, 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 25 or 30),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })
		end

		sectionLabel(body, 200, "MAINTENANCE")
		bigBtn(body, 201, "♻️ Recharger la liste depuis le DataStore",
			C.BG_LIGHT, C.BORDER_BRIGHT, function()
				callAct("reload", {}, function(res)
					if res and res.ok then S.data, S.audit = nil, nil; screen(false) end
				end)
			end)
		note(body, 202, "À utiliser si un autre serveur a modifié la liste et que celui-ci "
			.. "affiche encore l'ancienne version. Ça relit la clé DataStore et rediffuse "
			.. "la liste à tous les joueurs de ce serveur.", C.TEXT_DIM)
	end

	------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "vip"
		if reset then
			S.data = nil; S.failed = false; S.failMsg = nil
			S.tab = "list"; S.search = ""; S.filter = "all"
			S.query = ""; S.note = ""; S.found = nil; S.looking = false
			S.audit = nil; S.auditLoading = false
		end

		local body = buildScreen("👑 GESTION VIP", true, GOLD, nil, function()
			S.data, S.audit = nil, nil
			screen(false)
		end)

		if not remote("AdminGetVIPList") then
			note(body, 1, "❌ Le serveur n'a pas le gestionnaire VIP.\n\n"
				.. "Supprime ton ancien VIPChecker.lua et mets VIPManager.server.lua "
				.. "dans ServerScriptService, puis redémarre le serveur.", C.RED)
			return
		end

		acTabBar(body, -2, {
			{ id = "list", label = "👑 La liste" },
			{ id = "add",  label = "➕ Ajouter" },
		}, S.tab, GOLD, function(id)
			S.tab = id
			if id ~= "add" then S.found = nil end
			screen(false)
		end)
		acTabBar(body, -1, {
			{ id = "audit", label = "📜 Journal" },
			{ id = "info",  label = "🔒 Sécurité & infos" },
		}, S.tab, GOLD, function(id)
			S.tab   = id
			S.found = nil
			screen(false)
		end)

		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetVIPList")
				local ok, res = false, nil
				if fn then ok, res = pcall(function() return fn:InvokeServer() end) end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data, S.failMsg = res, nil
				else
					S.failed = true
					if type(res) == "table" and res.msg then S.failMsg = tostring(res.msg)
					elseif ok == false then S.failMsg = "Erreur pendant l'appel : " .. tostring(res)
					else S.failMsg = "Réponse inattendue du serveur." end
				end
				if currentScreen == "vip" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Impossible de lire la liste VIP.\n\n"
					.. (S.failMsg and (S.failMsg .. "\n\n") or "")
					.. "Appuie sur 🔄 en haut pour réessayer.")
				or "Chargement de la liste VIP...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		if S.tab == "add" then
			renderAdd(body)
		elseif S.tab == "audit" then
			renderAudit(body)
		elseif S.tab == "info" then
			renderInfo(body)
		else
			renderList(body)
		end
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "vip", name = "👑 VIP", color = GOLD })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "vip" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- ↕️ BLOC 13 — ORDRE DU SHOP (dans 📦 RÉGLAGES DU STOCK)
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », JUSTE AVANT le bloc
--     « 📜 BLOC 11 — CONSERVER LA POSITION DE DÉFILEMENT »
--     (le bloc 11 doit rester le DERNIER). Rien à supprimer.
--
--  Ajoute en haut de l'écran 📦 RÉGLAGES DU STOCK :
--   • 📊 STATS DU STOCK  • ↕️ ORDRE DANS LE SHOP  • ❤️ case nombre de likes Aucune variable ajoutée au script principal (IIFE).
--
--  Prérequis : UGCShopOrder_Server (ServerScriptService)
--              + patch UGC_CONFIG (avant `return UGC_CONFIG`).
--  ⚠️ Le ";" au début de ";(function()" est OBLIGATOIRE.
--════════════════════════════════════════════════════════════════════════════
;(function()
	local ACC   = Color3.fromRGB(120, 200, 255)
	local ACC_D = Color3.fromRGB(35, 95, 150)
	local STOCK_TITLE = "📦 RÉGLAGES DU STOCK"
	local TITLE       = "↕️ ORDRE DU SHOP"

	local ROW    = IS_MOBILE and 52 or 62
	local BTN    = IS_MOBILE and 30 or 36
	local BAR_H  = IS_MOBILE and 50 or 60

	local CFG
	local function cfg()
		if CFG then return CFG end
		local m = ReplicatedStorage:FindFirstChild("UGC_CONFIG")
		if m then
			local ok, r = pcall(require, m)
			if ok then CFG = r end
		end
		return CFG
	end
	local function key(id) return string.format("%.0f", tonumber(id) or 0) end
	local function folder() return ReplicatedStorage:FindFirstChild("UGCShopOrder") end
	local function remote() return ReplicatedStorage:FindFirstChild("AdminSetShopOrder") end
	local function isHidden(id)
		local f = ReplicatedStorage:FindFirstChild("UGCSalesLock")
		return f ~= nil and f:GetAttribute("Hide_" .. key(id)) == true
	end

	local S = {
		base = nil,      -- ordre enregistré (liste de clés)
		draft = nil,     -- ordre en cours d'édition
		sel = nil,       -- index sélectionné
		busy = false,
		confirmReset = false,
		backFn = nil,    -- retour vers 📦 RÉGLAGES DU STOCK
		hookedFolder = nil,
		warnedOther = false,
		expectV = nil,   -- version attendue après un 💾
	}
	local screen -- forward decl

	------------------------------------------------------------------
	-- Données
	------------------------------------------------------------------
	local function itemsByKey()
		local map, list = {}, {}
		local c = cfg()
		if not c then return map, list end
		for _, it in ipairs(c.GetSortedItems()) do
			local k = key(it.AssetId)
			if not map[k] then
				map[k] = it
				table.insert(list, k)
			end
		end
		return map, list
	end

	local function copy(t)
		local o = {}
		for i, v in ipairs(t) do o[i] = v end
		return o
	end

	local function isDirty()
		if not S.base or not S.draft then return false end
		for i, k in ipairs(S.draft) do
			if S.base[i] ~= k then return true end
		end
		return #S.draft ~= #S.base
	end

	local function movedCount()
		if not S.base or not S.draft then return 0 end
		local n = 0
		for i, k in ipairs(S.draft) do
			if S.base[i] ~= k then n = n + 1 end
		end
		return n
	end

	-- Relit l'ordre effectif. Le brouillon garde tes déplacements :
	-- UGC supprimés retirés, nouveaux UGC ajoutés en haut.
	local function reconcile()
		local map, current = itemsByKey()
		-- Juste après 💾 : on garde l'ordre renvoyé par le serveur tant que
		-- la nouvelle version n'est pas encore arrivée par réplication.
		local f = folder()
		if S.expectV and f and (tonumber(f:GetAttribute("Version")) or 0) < S.expectV and S.base then
			if not S.draft then S.draft = copy(S.base) end
			return map
		end
		S.expectV = nil
		S.base = current
		if not S.draft or not isDirty() then
			S.draft = copy(current)
			return map
		end
		local inDraft, kept = {}, {}
		for _, k in ipairs(S.draft) do
			if map[k] and not inDraft[k] then inDraft[k] = true; table.insert(kept, k) end
		end
		local fresh = {}
		for _, k in ipairs(current) do
			if not inDraft[k] then table.insert(fresh, k) end
		end
		for _, k in ipairs(kept) do table.insert(fresh, k) end
		S.draft = fresh
		return map
	end

	local function hookFolder()
		local f = folder()
		if not f or S.hookedFolder == f then return end
		S.hookedFolder = f
		f:GetAttributeChangedSignal("NewIds"):Connect(function()
			if currentScreen == "shoporder" and not S.busy then screen() end
		end)
		f:GetAttributeChangedSignal("Version"):Connect(function()
			if currentScreen ~= "shoporder" or S.busy then return end
			if isDirty() then
				if not S.warnedOther then
					S.warnedOther = true
					toast("⚠️ Un autre admin vient de changer l'ordre du shop", false)
				end
				return
			end
			S.draft = nil
			screen()
		end)
	end

	local function ago(t)
		t = tonumber(t) or 0
		if t <= 0 then return nil end
		local d = math.max(0, os.time() - t)
		if d < 60 then return "à l'instant" end
		if d < 3600 then return ("il y a %d min"):format(d // 60) end
		if d < 86400 then return ("il y a %d h"):format(d // 3600) end
		return ("il y a %d j"):format(d // 86400)
	end

	------------------------------------------------------------------
	-- Actions
	------------------------------------------------------------------
	local function move(from, to)
		local d = S.draft
		if not d or from == to or from < 1 or to < 1 or from > #d or to > #d then return end
		local k = table.remove(d, from)
		table.insert(d, to, k)
		S.sel = nil
		S.confirmReset = false
		screen()
	end

	local function send(action, payload)
		local r = remote()
		if not r then toast("UGCShopOrder_Server pas installé côté serveur", false); return end
		if S.busy then return end
		S.busy = true
		screen()
		task.spawn(function()
			local ok, res = pcall(function() return r:InvokeServer(action, payload) end)
			S.busy = false
			if ok and type(res) == "table" and res.ok then
				local o = {}
				for i, id in ipairs(res.order or {}) do o[i] = key(id) end
				S.base, S.draft, S.sel, S.warnedOther = o, copy(o), nil, false
				S.expectV = tonumber(res.v)
				toast(res.msg or "✅ Enregistré", true)
			else
				toast((type(res) == "table" and res.msg) or ("❌ Erreur : " .. tostring(res)), false)
			end
			if currentScreen == "shoporder" then screen() end
		end)
	end

	------------------------------------------------------------------
	-- UI helpers
	------------------------------------------------------------------
	local function note(parent, order, text, color)
		local l = label(parent, {
			text = text, size = UDim2.new(1, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = color or C.TEXT_GREY, textSize = IS_MOBILE and 11 or 13, wrapped = true, zIndex = 11,
		})
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.LayoutOrder = order
		return l
	end

	local function smallBtn(parent, x, text, color, strokeCol, enabled, onClick)
		local c = Instance.new("Frame")
		c.AnchorPoint = Vector2.new(1, 0.5)
		c.Position = UDim2.new(1, x, 0.5, 0)
		c.Size = UDim2.new(0, BTN, 0, BTN)
		c.BackgroundTransparency = 1
		c.ZIndex = 13
		c.Parent = parent
		local b = actionButton(c, {
			color = enabled and color or C.BG_MEDIUM, strokeColor = enabled and strokeCol or C.BORDER_SUBTLE,
			text = text, textSize = IS_MOBILE and 13 or 16, radius = 8, zIndex = 13,
			textColor = enabled and C.TEXT_WHITE or C.TEXT_DIM,
		})
		if enabled then b.MouseButton1Click:Connect(onClick) end
		return b
	end

	local function wideBtn(parent, order, text, color, strokeCol, h, onClick)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, h or (IS_MOBILE and 36 or 42))
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b = actionButton(c, {
			color = color, strokeColor = strokeCol, text = text,
			textSize = IS_MOBILE and 12 or 15, radius = 9, zIndex = 11,
		})
		b.MouseButton1Click:Connect(onClick)
		return b, c
	end

	local function itemImage(it)
		local img = it.ImageId
		if img == nil then return "" end
		if type(img) == "string" and img:find("://") then return img end
		return "rbxassetid://" .. key(img)
	end

	------------------------------------------------------------------
	-- 🖱️ DRAG & DROP (PC / souris) : maintiens un UGC et glisse-le
	------------------------------------------------------------------
	local UIS        = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	local RunService = game:GetService("RunService")
	local DRAG_START_PX = 6
	local D = { from = nil, startY = nil, y = 0, active = false, target = nil, dropAt = 0 }
	local rows = {}   -- [i] = { row, stroke, color, thick } de l'écran affiché

	-- Position souris dans le même repère que AbsolutePosition
	local function guiY(input)
		local y = input.Position.Y
		local sg = window:FindFirstAncestorOfClass("ScreenGui")
		if sg and sg.IgnoreGuiInset then y = y + GuiService:GetGuiInset().Y end
		return y
	end

	local function targetAt(y)
		local n = #rows
		if n == 0 then return nil end
		for i, r in ipairs(rows) do
			if y < r.row.AbsolutePosition.Y + r.row.AbsoluteSize.Y then return i end
		end
		return n
	end

	local function paint()
		for i, r in ipairs(rows) do
			if r.row.Parent then
				local isFrom = D.active and i == D.from
				local isTgt  = D.active and i == D.target and i ~= D.from
				r.row.BackgroundTransparency = isFrom and 0.55 or 0
				r.stroke.Color     = isTgt and ACC or r.color
				r.stroke.Thickness = isTgt and 3 or r.thick
			end
		end
	end

	local function endDrag(commit)
		local from, to, was = D.from, D.target, D.active
		D.from, D.startY, D.active, D.target = nil, nil, false, nil
		if not was then return end
		D.dropAt = os.clock()
		if commit and from and to and from ~= to and not S.busy then
			move(from, to)
		else
			paint()
		end
	end

	UIS.InputChanged:Connect(function(input)
		if not D.from or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local y = guiY(input)
		D.y = y
		if not D.startY then D.startY = y; return end
		if not D.active then
			if math.abs(y - D.startY) < DRAG_START_PX then return end
			D.active = true
		end
		local t = targetAt(y)
		if t ~= D.target then D.target = t; paint() end
	end)

	UIS.InputEnded:Connect(function(input)
		if D.from and input.UserInputType == Enum.UserInputType.MouseButton1 then endDrag(true) end
	end)

	-- Défilement auto quand tu tiens l'UGC près du haut / bas de la liste
	RunService.Heartbeat:Connect(function(dt)
		if not D.active then return end
		local first = rows[1] and rows[1].row
		local body = first and first.Parent
		if not body or not body:IsA("ScrollingFrame") then endDrag(false); return end
		local top = body.AbsolutePosition.Y
		local bot = top + body.AbsoluteSize.Y
		local edge = 45
		local speed = 0
		if D.y < top + edge then
			speed = -math.min(edge, top + edge - D.y)
		elseif D.y > bot - edge then
			speed = math.min(edge, D.y - (bot - edge))
		end
		if speed ~= 0 then
			local maxY = math.max(0, body.AbsoluteCanvasSize.Y - body.AbsoluteWindowSize.Y)
			body.CanvasPosition = Vector2.new(0, math.clamp(body.CanvasPosition.Y + speed * dt * 10, 0, maxY))
			local t = targetAt(D.y)
			if t ~= D.target then D.target = t; paint() end
		end
	end)

	------------------------------------------------------------------
	-- Ligne d'un UGC
	------------------------------------------------------------------
	local function itemRow(body, i, k, it, baseIdx, n)
		local selected = (S.sel == i)
		local c0IsNew = cfg() and cfg().IsNew
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, ROW)
		row.BackgroundColor3 = selected and C.BG_SELECTED or C.BG_DARK
		row.AutoButtonColor = false
		row.BorderSizePixel = 0
		row.Text = ""
		row.LayoutOrder = 100 + i * 2
		row.ZIndex = 11
		row.Parent = body
		corner(row, 10)
		local rColor = selected and ACC or ((S.sel and not selected) and ACC_D or C.BORDER_SUBTLE)
		local rThick = selected and 2 or 1
		local rStroke = stroke(row, rColor, rThick)
		rows[i] = { row = row, stroke = rStroke, color = rColor, thick = rThick }
		if UIS.MouseEnabled then
			row.MouseButton1Down:Connect(function()
				if S.busy then return end
				D.from, D.startY, D.active, D.target = i, nil, false, nil
			end)
		end

		-- #rang
		label(row, {
			text = "#" .. i, size = UDim2.new(0, IS_MOBILE and 30 or 38, 1, 0),
			position = UDim2.new(0, 6, 0, 0), color = ACC,
			textSize = IS_MOBILE and 13 or 16, zIndex = 12,
		})

		-- image
		local isz = ROW - 14
		local x0 = (IS_MOBILE and 36 or 46) + 4
		local im = Instance.new("ImageLabel")
		im.BackgroundTransparency = 1
		im.Image = itemImage(it)
		im.ScaleType = Enum.ScaleType.Fit
		im.AnchorPoint = Vector2.new(0, 0.5)
		im.Position = UDim2.new(0, x0, 0.5, 0)
		im.Size = UDim2.new(0, isz, 0, isz)
		im.ZIndex = 12
		im.Parent = row

		local tx = x0 + isz + 8
		local rightW = BTN * 2 + 18
		label(row, {
			text = tostring(it.Name or k), size = UDim2.new(1, -tx - rightW, 0, IS_MOBILE and 16 or 20),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 8 or 10),
			xAlign = Enum.TextXAlignment.Left, textSize = IS_MOBILE and 13 or 16,
			zIndex = 12, truncate = true,
		})

		local sub = "Order config : " .. tostring(it.Order or "?")
		if baseIdx and baseIdx ~= i then
			local d = baseIdx - i
			if d > 0 then
				sub = sub .. ('  <font color="#5ADC8C">▲%d</font>'):format(d)
			else
				sub = sub .. ('  <font color="#FFAA46">▼%d</font>'):format(-d)
			end
		end
		if isHidden(k) then sub = sub .. "  ⚫ caché" end
		if (c0IsNew and c0IsNew(it)) or (not c0IsNew and it.IsNew) then sub = sub .. "  🆕 NEW" end
		label(row, {
			text = sub, richText = true,
			size = UDim2.new(1, -tx - rightW, 0, IS_MOBILE and 13 or 15),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 28 or 34),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 12, zIndex = 12, truncate = true,
		})

		-- ↑ ↓
		smallBtn(row, -(BTN + 12), "↑", ACC_D, ACC, i > 1 and not S.busy, function() move(i, i - 1) end)
		smallBtn(row, -6, "↓", ACC_D, ACC, i < n and not S.busy, function() move(i, i + 1) end)

		-- Tap : sélectionner, puis taper la place voulue
		row.MouseButton1Click:Connect(function()
			if S.busy or os.clock() - D.dropAt < 0.3 then return end
			if S.sel == nil then
				S.sel = i; screen()
			elseif S.sel == i then
				S.sel = nil; screen()
			else
				move(S.sel, i)
			end
		end)

		-- Options de la ligne sélectionnée
		if selected then
			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
			bar.BackgroundTransparency = 1
			bar.LayoutOrder = 100 + i * 2 + 1
			bar.ZIndex = 11
			bar.Parent = body
			-- 🆕 badge NEW : enregistré TOUT DE SUITE (pas besoin de 💾), sur tous les serveurs
			local isNewNow = (c0IsNew and c0IsNew(it)) or false
			local canNew = c0IsNew ~= nil and not S.busy and tonumber(it.AssetId) ~= nil
			local specs = {
				{ "⤒ En haut", i > 1, function() move(i, 1) end },
				{ "⤓ En bas", i < n, function() move(i, n) end },
				{ isNewNow and "🆕 NEW ✓" or "🆕 NEW", canNew, function()
					local r = remote()
					if not r or S.newBusy then return end
					S.newBusy = true
					task.spawn(function()
						local ok, res = pcall(function()
							return r:InvokeServer("setnew", { assetId = it.AssetId, on = not isNewNow })
						end)
						S.newBusy = false
						if ok and type(res) == "table" and res.ok then
							toast(res.msg or "✅", true)
						else
							toast((type(res) == "table" and res.msg) or ("❌ " .. tostring(res)), false)
						end
						if currentScreen == "shoporder" then screen() end
					end)
				end },
				{ "✕", true, function() S.sel = nil; screen() end },
			}
			local w = { 0.29, 0.29, 0.29, 0.13 }
			local xs = 0
			for j, sp in ipairs(specs) do
				local c = Instance.new("Frame")
				c.Size = UDim2.new(w[j], -6, 1, 0)
				c.Position = UDim2.new(xs, 3, 0, 0)
				c.BackgroundTransparency = 1
				c.ZIndex = 11
				c.Parent = bar
				xs = xs + w[j]
				local b = actionButton(c, {
					color = sp[2] and (j == #specs and C.BG_LIGHT or (j == 3 and isNewNow and C.GREEN_DARK or ACC_D)) or C.BG_MEDIUM,
					strokeColor = sp[2] and ACC or C.BORDER_SUBTLE,
					text = sp[1], textSize = IS_MOBILE and 11 or 14, radius = 8, zIndex = 11,
					textColor = sp[2] and C.TEXT_WHITE or C.TEXT_DIM,
				})
				if sp[2] then b.MouseButton1Click:Connect(sp[3]) end
			end
		end
	end

	------------------------------------------------------------------
	-- 🖥️ L'ÉCRAN
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "shoporder"
		D.from, D.startY, D.active, D.target = nil, nil, false, nil
		table.clear(rows)
		if reset then S.draft = nil; S.sel = nil; S.confirmReset = false; S.warnedOther = false end

		local body = buildScreen(TITLE, true, ACC, S.backFn, function()
			if not isDirty() then S.draft = nil end
			S.sel = nil
			screen()
		end)

		local c = cfg()
		if not c or not c.GetDefaultSortedItems then
			note(body, 1, "❌ Patch UGC_CONFIG manquant.\n\nColle le bloc « ORDRE PERSONNALISÉ DU SHOP » "
				.. "juste avant `return UGC_CONFIG` dans ton module UGC_CONFIG.", C.RED)
			return
		end
		if not remote() then
			note(body, 1, "❌ Le serveur n'a pas UGCShopOrder_Server.\n\n"
				.. "Ajoute UGCShopOrder_Server dans ServerScriptService puis redémarre le serveur.", C.RED)
			return
		end
		hookFolder()

		local map = reconcile()
		local n = #S.draft
		local baseIdx = {}
		for i, k in ipairs(S.base) do baseIdx[k] = i end

		-- En-tête
		local f = folder()
		local custom = f and type(f:GetAttribute("Order")) == "string" and f:GetAttribute("Order") ~= ""
		local status = custom and "Ordre actuel : <b>personnalisé</b>" or "Ordre actuel : <b>par défaut</b> (Order ↓)"
		local by = f and f:GetAttribute("By")
		local when = f and ago(f:GetAttribute("At"))
		if custom and by and by ~= "" then
			status = status .. "  ·  par " .. by .. (when and (" " .. when) or "")
		end
		local st = note(body, 1, status, custom and ACC or C.TEXT_GREY)
		st.RichText = true

		note(body, 2, (UIS.MouseEnabled and "🖱️ Maintiens un UGC et glisse-le à sa nouvelle place. " or "")
			.. "Tape un UGC pour le sélectionner, puis tape la place où tu veux le mettre. "
			.. "Ou utilise ↑ ↓. Rien ne change dans le shop tant que tu n'as pas appuyé sur 💾.", C.TEXT_GREY)

		-- ♻️ Revenir à l'ordre par défaut (double appui)
		if custom then
			wideBtn(body, 3,
				S.confirmReset and "⚠️ Appuie encore pour confirmer" or "♻️ Revenir à l'ordre par défaut",
				S.confirmReset and C.RED or C.BG_LIGHT, S.confirmReset and C.RED_DARK or C.BORDER_BRIGHT,
				IS_MOBILE and 32 or 38,
				function()
					if S.busy then return end
					if S.confirmReset then
						S.confirmReset = false
						send("reset")
					else
						S.confirmReset = true
						screen()
						task.delay(4, function()
							if S.confirmReset then S.confirmReset = false; if currentScreen == "shoporder" then screen() end end
						end)
					end
				end)
		end

		sectionLabel(body, 4, ("UGC DU SHOP (%d) — #1 = affiché en premier"):format(n))

		if n == 0 then
			note(body, 5, "Aucun UGC dans UGC_CONFIG.", C.TEXT_DIM)
		end
		for i, k in ipairs(S.draft) do
			itemRow(body, i, k, map[k] or { Name = k }, baseIdx[k], n)
		end

		note(body, 100 + n * 2 + 10, "ℹ️ Par défaut, le shop trie par « Order » (le plus grand en premier). "
			.. "Un UGC ajouté plus tard dans UGC_CONFIG apparaît automatiquement EN HAUT, "
			.. "jusqu'à ce que tu le replaces ici. ⚫ = caché du shop (verrou des ventes).", C.TEXT_DIM)

		-- Espace pour ne pas finir sous la barre
		local sp = Instance.new("Frame")
		sp.Size = UDim2.new(1, 0, 0, 4)
		sp.BackgroundTransparency = 1
		sp.LayoutOrder = 100 + n * 2 + 11
		sp.Parent = body

		-- Barre du bas fixe : 💾 / ↩️
		body.Size = body.Size - UDim2.new(0, 0, 0, BAR_H)
		local bar = Instance.new("Frame")
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.new(0, 0, 1, 0)
		bar.Size = UDim2.new(1, 0, 0, BAR_H)
		bar.BackgroundColor3 = C.BG_DARK
		bar.BorderSizePixel = 0
		bar.ZIndex = 12
		bar.Parent = window
		corner(bar, 14)
		local topMask = Instance.new("Frame")
		topMask.Size = UDim2.new(1, 0, 0, 14)
		topMask.BackgroundColor3 = C.BG_DARK
		topMask.BorderSizePixel = 0
		topMask.ZIndex = 12
		topMask.Parent = bar
		local line = Instance.new("Frame")
		line.Size = UDim2.new(1, 0, 0, 1)
		line.BackgroundColor3 = ACC
		line.BackgroundTransparency = 0.5
		line.BorderSizePixel = 0
		line.ZIndex = 13
		line.Parent = bar

		local dirty = isDirty()
		local moved = movedCount()
		local pad = IS_MOBILE and 7 or 9
		local saveC = Instance.new("Frame")
		saveC.Position = UDim2.new(0, pad, 0, pad)
		saveC.Size = UDim2.new(0.64, -pad * 1.5, 1, -pad * 2)
		saveC.BackgroundTransparency = 1
		saveC.ZIndex = 13
		saveC.Parent = bar
		local saveTxt = S.busy and "⏳ Enregistrement..."
			or (dirty and ("💾 ENREGISTRER (" .. moved .. ")") or "✅ À jour")
		local saveBtn = actionButton(saveC, {
			color = dirty and C.GREEN_DARK or C.BG_MEDIUM,
			strokeColor = dirty and C.GREEN or C.BORDER_SUBTLE,
			text = saveTxt, textSize = IS_MOBILE and 12 or 15, radius = 9, zIndex = 13,
			textColor = dirty and C.TEXT_WHITE or C.TEXT_DIM,
		})
		saveBtn.MouseButton1Click:Connect(function()
			if not dirty or S.busy then return end
			local ids = {}
			for i, k in ipairs(S.draft) do ids[i] = k end
			send("set", { order = ids })
		end)

		local undoC = Instance.new("Frame")
		undoC.AnchorPoint = Vector2.new(1, 0)
		undoC.Position = UDim2.new(1, -pad, 0, pad)
		undoC.Size = UDim2.new(0.36, -pad * 1.5, 1, -pad * 2)
		undoC.BackgroundTransparency = 1
		undoC.ZIndex = 13
		undoC.Parent = bar
		local undoBtn = actionButton(undoC, {
			color = dirty and C.BG_LIGHT or C.BG_MEDIUM,
			strokeColor = dirty and C.BORDER_BRIGHT or C.BORDER_SUBTLE,
			text = "↩️ Annuler", textSize = IS_MOBILE and 12 or 15, radius = 9, zIndex = 13,
			textColor = dirty and C.TEXT_WHITE or C.TEXT_DIM,
		})
		undoBtn.MouseButton1Click:Connect(function()
			if not dirty or S.busy then return end
			S.draft = copy(S.base)
			S.sel = nil
			screen()
		end)
	end

	------------------------------------------------------------------
	-- 📊 STATS DU STOCK
	--   • Stock restant : GetStockFunction (le même remote que le shop)
	--   • Ventes : le log 🎽 UGC REDEEMERS (AdminGetUGCRedeems), lu en entier
	--     une fois puis gardé en mémoire jusqu'au 🔄.
	--   Heures et jours = heure de TON ordi.
	------------------------------------------------------------------
	local STAT_C   = Color3.fromRGB(255, 205, 90)
	local STAT_D   = Color3.fromRGB(140, 100, 20)
	local STATS_TITLE = "📊 STATS DU STOCK"
	local PAGE_SIZE, MAX_PAGES = 30, 250          -- jusqu'à 7 500 achats lus
	local DAY = 86400
	local SRC_GRP = {
		shop = "paid", late = "paid", timeout = "paid", quit = "paid", bugfix = "paid",
		free = "free", admin = "free", exploit = "flag", external = "flag",
	}
	local WDAY = { "dim.", "lun.", "mar.", "mer.", "jeu.", "ven.", "sam." }

	-- 💳 PACKS DE POINTS (dev products)  pts = points donnés, rbx = prix
	--    Achetés pour SOI : le financé est l'acheteur.
	local SELF_PACKS = {
		[3606598188] = { pts = 1000,    rbx = 2   },
		[3606598763] = { pts = 2500,    rbx = 4   },
		[3606598849] = { pts = 100000,  rbx = 29  },
		[3606598712] = { pts = 500000,  rbx = 149 },
		[3606598746] = { pts = 2000000, rbx = 499 },
	}
	--    GIFTS : l'acheteur paie, mais c'est le RECEVEUR qui a les points.
	local GIFT_PACKS = {
		[3606598024] = { pts = 1000,    rbx = 2   },
		[3606597991] = { pts = 2500,    rbx = 4   },
		[3606597929] = { pts = 100000,  rbx = 29  },
		[3606597886] = { pts = 500000,  rbx = 149 },
		[3606597825] = { pts = 2000000, rbx = 499 },
	}
	local BEST_RATE = 499 / 2000000   -- R$ par point (gifts trop anciens pour l'historique)
	local RBX_C = Color3.fromRGB(90, 220, 140)

	local ST = {
		loading = false, err = nil, progress = 0, progLbl = nil,
		entries = nil, stocks = nil, truncated = false, loadedAt = 0,
		scope = "paid",   -- "paid" | "all"
		perSort = "sold", -- "sold" | "rupture"
		robux = false,    -- 💳 bouton : compter les UGC financés en Robux à part
		rbx = nil,        -- [uid] = { n = packs achetés, spent = R$ }
		rbxLoading = false, rbxProgress = "", rbxErr = nil,
	}
	local statsScreen -- forward decl
	local loadRobux   -- forward decl

	local function nfmt(n)
		n = tonumber(n) or 0
		if math.abs(n) >= 999500 then return ("%.2fM"):format(n / 1e6) end
		if math.abs(n) >= 1e4 then return ("%.1fK"):format(n / 1e3) end
		if n ~= math.floor(n) then
			return (n >= 10) and ("%.0f"):format(n) or ("%.1f"):format(n)
		end
		local s = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1 "):reverse()
		return (s:gsub("^ ", ""))
	end

	local function daysFmt(d)
		if not d or d == math.huge or d ~= d then return "∞" end
		if d < 1 then return ("%.0f h"):format(math.max(1, d * 24)) end
		if d < 60 then return ("%.0f j"):format(d) end
		if d < 730 then return ("%.1f mois"):format(d / 30.44) end
		return ("%.1f ans"):format(d / 365)
	end

	local function midnight(t)
		local d = os.date("*t", t)   -- heure locale
		return t - (d.hour * 3600 + d.min * 60 + d.sec)
	end

	local function configItems()
		local c = cfg()
		if not c then return {} end
		local ok, list = pcall(function() return c.GetSortedItems() end)
		return (ok and type(list) == "table") and list or (c.Items or {})
	end

	local function loadStats()
		if ST.loading then return end
		ST.loading, ST.err, ST.progress, ST.truncated = true, nil, 0, false
		if currentScreen == "shopstats" then statsScreen() end
		task.spawn(function()
			-- 1) Stock de chaque UGC (en parallèle)
			local stocks = {}
			local stockFn = ReplicatedStorage:FindFirstChild("GetStockFunction")
			if stockFn then
				local items = configItems()
				local left = #items
				for _, it in ipairs(items) do
					task.spawn(function()
						local ok, d = pcall(function() return stockFn:InvokeServer(it.AssetId) end)
						if ok and type(d) == "table" then
							local total = tonumber(d.Total)
								or (type(d.Config) == "table" and tonumber(d.Config.InitialStock))
								or tonumber(it.InitialStock)
							stocks[key(it.AssetId)] = { cur = tonumber(d.CurrentStock), total = total }
						end
						left -= 1
					end)
				end
				local t0 = os.clock()
				while left > 0 and os.clock() - t0 < 15 do task.wait(0.05) end
			end

			-- 2) Tout le log des UGC récupérés
			local entries, cursor, pages = {}, nil, 0
			local logFn = ReplicatedStorage:FindFirstChild("AdminGetUGCRedeems")
			local cutoff = os.time() - 400 * DAY
			if not logFn then
				ST.err = "AdminGetUGCRedeems introuvable → UGCRedeemLog_Server pas installé."
			else
				while true do
					local ok, res = pcall(function() return logFn:InvokeServer(cursor, PAGE_SIZE) end)
					if not ok or type(res) ~= "table" or type(res.entries) ~= "table" then
						if pages == 0 then
							ST.err = "Lecture du log impossible : " .. tostring(type(res) == "table" and res.msg or res)
						else
							ST.truncated = true
						end
						break
					end
					local oldest = math.huge
					for _, e in ipairs(res.entries) do
						table.insert(entries, e)
						oldest = math.min(oldest, tonumber(e.t) or math.huge)
					end
					pages += 1
					ST.progress = #entries
					if ST.progLbl and ST.progLbl.Parent then
						ST.progLbl.Text = ("⏳ Lecture du log… %d achats"):format(#entries)
					end
					cursor = res.cursor
					if res.hasMore ~= true or cursor == nil or #res.entries == 0 then break end
					if oldest < cutoff then break end              -- plus d'un an : assez
					if pages >= MAX_PAGES then ST.truncated = true; break end
					task.wait(0.12)
				end
			end

			ST.stocks, ST.entries = stocks, entries
			ST.loading, ST.loadedAt = false, os.time()
			if ST.robux and not ST.rbx then loadRobux() end
			if currentScreen == "shopstats" then statsScreen() end
		end)
	end

	-- 💳 Combien de points chaque acheteur d'UGC a-t-il eus grâce à des Robux ?
	--    • packs achetés POUR LUI-MÊME   → AdminSpending (AdminSpending_Get / _Details)
	--    • gifts de points REÇUS         → GiftLog (AdminGetGiftPlayer)
	--    Les packs « Gift » achetés par un joueur ne comptent PAS pour lui :
	--    c'est le receveur qui a les points, donc c'est lui qui est financé.
	loadRobux = function()
		if ST.rbxLoading then return end
		ST.rbxLoading, ST.rbxErr, ST.rbxProgress = true, nil, ""
		task.spawn(function()
			local getFn = ReplicatedStorage:FindFirstChild("AdminSpending_Get")
			local detFn = ReplicatedStorage:FindFirstChild("AdminSpending_Details")
			local gpFn  = ReplicatedStorage:FindFirstChild("AdminGetGiftPlayer")
			local map = {}
			local function progress(txt)
				ST.rbxProgress = txt
				if ST.progLbl and ST.progLbl.Parent then ST.progLbl.Text = txt end
			end
			local function invoke(fn, ...)
				local args = table.pack(...)
				for _ = 1, 20 do
					local ok, res = pcall(function() return fn:InvokeServer(table.unpack(args, 1, args.n)) end)
					if ok and not (type(res) == "table" and res.throttled) then return res end
					task.wait(0.4)
				end
				return nil
			end

			local ids, seen = {}, {}
			for _, e in ipairs(ST.entries or {}) do
				local uid = tonumber(e.u)
				local g = SRC_GRP[tostring(e.s)] or "paid"
				if uid and g == "paid" and not seen[uid] then
					seen[uid] = true
					table.insert(ids, uid)
					map[uid] = { pts = 0, rbx = 0, gpts = 0 }
				end
			end

			-- 1) Packs achetés pour soi (AdminSpending)
			if not getFn or not detFn then
				ST.rbxErr = "AdminSpending_Server introuvable → les packs achetés pour soi ne sont pas comptés."
			else
				local spenders = {}
				for i = 1, #ids, 50 do
					local chunk = {}
					for j = i, math.min(i + 49, #ids) do table.insert(chunk, ids[j]) end
					local res = invoke(getFn, chunk, false)
					if type(res) == "table" then
						for _, uid in ipairs(chunk) do
							local v = res[tostring(uid)]
							if type(v) == "table" and (tonumber(v.total) or 0) > 0 then table.insert(spenders, uid) end
						end
					end
					progress(("💳 Achats Robux… %d / %d joueurs"):format(math.min(i + 49, #ids), #ids))
				end
				for i, uid in ipairs(spenders) do
					local det = invoke(detFn, uid)
					if type(det) == "table" then
						for _, pr in ipairs(det.products or {}) do
							local pack = SELF_PACKS[tonumber(pr.id)]
							if pack then
								local n = tonumber(pr.count) or 0
								map[uid].pts += n * pack.pts
								map[uid].rbx += tonumber(pr.spent) or (n * pack.rbx)
							end
						end
					end
					progress(("💳 Détail des packs… %d / %d"):format(i, #spenders))
				end
			end

			-- 2) Gifts de points reçus (GiftLog), 6 lectures en parallèle
			if not gpFn then
				ST.rbxErr = (ST.rbxErr and (ST.rbxErr .. "\n") or "")
					.. "GiftLog introuvable (AdminGetGiftPlayer) → les gifts reçus ne sont pas comptés."
			else
				local idx, done = 0, 0
				local function worker()
					while true do
						idx += 1
						local uid = ids[idx]
						if not uid then return end
						local res = invoke(gpFn, uid, false)
						local rec = type(res) == "table" and res.record
						if type(rec) == "table" then
							local rp = tonumber(rec.rp) or 0
							if rp > 0 then
								-- Valeur exacte pour les gifts encore dans l'historique…
								local kPts, kRbx = 0, 0
								for _, h in ipairs(type(rec.hr) == "table" and rec.hr or {}) do
									local pack = GIFT_PACKS[tonumber(h.pr)]
									if pack and (h.k == nil or h.k == "points") then
										kPts += pack.pts; kRbx += pack.rbx
									end
								end
								kPts = math.min(kPts, rp)
								-- …et au meilleur taux (2M = 499 R$) pour les plus anciens
								local rest = rp - kPts
								map[uid].gpts += rp
								map[uid].pts += rp
								map[uid].rbx += kRbx + rest * BEST_RATE
							end
						end
						done += 1
						progress(("🎁 Gifts reçus… %d / %d joueurs"):format(done, #ids))
					end
				end
				local running = 0
				for _ = 1, math.min(6, #ids) do
					running += 1
					task.spawn(function() worker(); running -= 1 end)
				end
				local t0 = os.clock()
				while running > 0 and os.clock() - t0 < 180 do task.wait(0.1) end
			end

			for uid, info in pairs(map) do
				if info.pts <= 0 then map[uid] = nil end
			end
			ST.rbx, ST.rbxLoading = map, false
			if currentScreen == "shopstats" then statsScreen() end
		end)
	end

	-- Tous les calculs
	local function compute()
		local now = os.time()
		local today0 = midnight(now)
		local yest0 = midnight(today0 - DAY / 2)
		local R = {
			total = 0, today = 0, yest = 0, d7 = 0, d30 = 0, d365 = 0,
			pts7 = 0, pts30 = 0, ptsAll = 0, paidN = 0, flags = 0, free30 = 0,
			first = nil, byDay = {}, byHour = {}, byWday = {}, per = {},
			buyers30 = 0, repeat30 = 0,
			out7 = 0, out30 = 0,   -- toutes les sorties (pour la rupture)
			r = { today = 0, yest = 0, d7 = 0, d30 = 0, d365 = 0, total = 0, rev = 0,
				rev7 = 0, rev30 = 0, byDay = {}, buyers = 0, viaGift = 0, leftPts = 0, leftRbx = 0 },
		}
		local buyers = {}

		-- 💳 Quelle part de chaque UGC a été payée avec des points achetés en
		--    Robux ? Chaque joueur a un « budget » de points Robux (packs achetés
		--    pour lui-même + gifts de points REÇUS). On le dépense sur ses UGC
		--    payés, du plus récent au plus ancien. Un UGC peut être financé en
		--    partie (ex. 0,5 = moitié Robux, moitié grind).
		--    Le log ne dit pas QUAND les points ont été achetés : la répartition
		--    par jour est une estimation, les totaux sont fiables.
		local rbxShare = {}   -- [entry] = fraction 0..1
		local rbxRate  = {}   -- [uid] = R$ par point
		if ST.robux and ST.rbx then
			local byUser = {}
			for _, e in ipairs(ST.entries or {}) do
				local uid = tonumber(e.u)
				local g = SRC_GRP[tostring(e.s)] or "paid"
				if uid and g == "paid" and not e.f and (tonumber(e.p) or 0) > 0 and ST.rbx[uid] and tonumber(e.t) then
					byUser[uid] = byUser[uid] or {}
					table.insert(byUser[uid], e)
				end
			end
			for uid, info in pairs(ST.rbx) do
				if info.pts > 0 then
					rbxRate[uid] = info.rbx / info.pts
					local list = byUser[uid] or {}
					table.sort(list, function(a, b) return (tonumber(a.t) or 0) > (tonumber(b.t) or 0) end)
					local budget = info.pts
					for _, e in ipairs(list) do
						if budget <= 0 then break end
						local p = tonumber(e.p)
						local f = math.min(1, budget / p)
						rbxShare[e] = f
						budget -= f * p
					end
					R.r.buyers += 1
					if info.gpts > 0 then R.r.viaGift += 1 end
					R.r.leftPts += budget
					R.r.leftRbx += budget * rbxRate[uid]
				end
			end
		end
		for _, e in ipairs(ST.entries or {}) do
			local t = tonumber(e.t)
			local g = SRC_GRP[tostring(e.s)] or "paid"
			if g == "flag" then
				R.flags += 1
			elseif t and (ST.scope == "all" or g == "paid") then
				local age = now - t
				-- Toutes les sorties : rupture + détail par UGC
				if age < 7 * DAY then R.out7 += 1 end
				if age < 30 * DAY then R.out30 += 1 end
				local k = key(e.a)
				local P = R.per[k] or { total = 0, d7 = 0, d30 = 0, last = 0, rbx = 0 }
				P.total += 1
				if age < 7 * DAY then P.d7 += 1 end
				if age < 30 * DAY then P.d30 += 1 end
				P.last = math.max(P.last, t)
				R.per[k] = P
				local dk = os.date("%Y-%m-%d", t)
				R.first = math.min(R.first or t, t)
				local p = (not e.f) and tonumber(e.p) or 0

				local f = rbxShare[e] or 0
				if f > 0 then
					-- 💳 part payée en Robux : comptée à part, pas comme un cadeau
					local r = R.r
					local rev = f * p * (rbxRate[tonumber(e.u)] or 0)
					r.total += f
					r.rev += rev
					P.rbx += f
					if t >= today0 then r.today += f elseif t >= yest0 then r.yest += f end
					if age < 7 * DAY then r.d7 += f; r.rev7 += rev end
					if age < 30 * DAY then r.d30 += f; r.rev30 += rev end
					if age < 365 * DAY then r.d365 += f end
					r.byDay[dk] = (r.byDay[dk] or 0) + f
				end

				local w = 1 - f   -- part vraiment « donnée » (grind)
				if w > 0.0001 then
					R.total += w
					if t >= today0 then R.today += w elseif t >= yest0 then R.yest += w end
					R.ptsAll += p * w
					if p > 0 then R.paidN += w end
					if age < 7 * DAY then R.d7 += w; R.pts7 += p * w end
					if age < 30 * DAY then
						R.d30 += w; R.pts30 += p * w
						if g == "free" then R.free30 += w end
						local u = tostring(e.u)
						buyers[u] = (buyers[u] or 0) + 1
					end
					if age < 365 * DAY then R.d365 += w end
					R.byDay[dk] = (R.byDay[dk] or 0) + w
					local dt = os.date("*t", t)
					R.byHour[dt.hour] = (R.byHour[dt.hour] or 0) + w
					R.byWday[dt.wday] = (R.byWday[dt.wday] or 0) + w
				end
			end
		end
		for _, n in pairs(buyers) do
			R.buyers30 += 1
			if n > 1 then R.repeat30 += 1 end
		end

		-- Période couverte par les données (évite de sous-estimer si le log est récent)
		R.spanDays = R.first and math.max(1, (now - R.first) / DAY) or 1
		local function win(w) return math.min(w, R.spanDays) end
		R.perDayAll = R.total / R.spanDays
		R.rate7  = R.d7 / win(7)
		R.rate30 = R.d30 / win(30)
		R.outRate7  = R.out7 / win(7)
		R.outRate30 = R.out30 / win(30)

		-- Meilleur jour
		R.bestDay, R.bestN = nil, 0
		for dk, n in pairs(R.byDay) do
			if n > R.bestN then R.bestDay, R.bestN = dk, n end
		end
		local bh, bn = nil, 0
		for h, n in pairs(R.byHour) do if n > bn then bh, bn = h, n end end
		R.bestHour = bh
		local bw, bwn = nil, 0
		for w, n in pairs(R.byWday) do if n > bwn then bw, bwn = w, n end end
		R.bestWday = bw

		-- 14 derniers jours (pour le graphique)
		R.last14 = {}
		for i = 13, 0, -1 do
			local t = today0 - i * DAY + DAY / 2
			local dk = os.date("%Y-%m-%d", t)
			table.insert(R.last14, { day = os.date("*t", t), n = R.byDay[dk] or 0,
				r = R.r.byDay[dk] or 0, today = (i == 0) })
		end

		-- Stock restant
		R.rem, R.init, R.known, R.out = 0, 0, 0, 0
		for _, s in pairs(ST.stocks or {}) do
			if s.cur then
				R.rem += s.cur; R.known += 1
				if s.cur <= 0 then R.out += 1 end
			end
			if s.total then R.init += s.total end
		end
		return R
	end

	-- Tuile : titre / grosse valeur / sous-titre
	local function tile(grid, order, title, value, sub, color)
		local f = Instance.new("Frame")
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = grid
		corner(f, 10)
		stroke(f, C.BORDER_SUBTLE, 1)
		label(f, {
			text = title, size = UDim2.new(1, -14, 0, IS_MOBILE and 13 or 16), position = UDim2.new(0, 8, 0, 6),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12,
			zIndex = 12, truncate = true,
		})
		label(f, {
			text = value, size = UDim2.new(1, -14, 0, IS_MOBILE and 22 or 28),
			position = UDim2.new(0, 8, 0, IS_MOBILE and 19 or 23),
			xAlign = Enum.TextXAlignment.Left, color = color or C.TEXT_WHITE,
			textSize = IS_MOBILE and 19 or 24, zIndex = 12, truncate = true,
		})
		if sub then
			label(f, {
				text = sub, richText = true, size = UDim2.new(1, -14, 0, IS_MOBILE and 12 or 14),
				position = UDim2.new(0, 8, 1, IS_MOBILE and -16 or -19),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11,
				zIndex = 12, truncate = true,
			})
		end
	end

	local function grid(body, order)
		local g = Instance.new("Frame")
		g.Size = UDim2.new(1, 0, 0, 0)
		g.AutomaticSize = Enum.AutomaticSize.Y
		g.BackgroundTransparency = 1
		g.LayoutOrder = order
		g.ZIndex = 11
		g.Parent = body
		local gl = Instance.new("UIGridLayout")
		gl.CellPadding = UDim2.new(0, 6, 0, 6)
		gl.CellSize = UDim2.new(0.5, -3, 0, IS_MOBILE and 62 or 76)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = g
		return g
	end

	local function barChart(body, order, days)
		local H = IS_MOBILE and 120 or 150
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, H)
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = body
		corner(f, 10)
		stroke(f, C.BORDER_SUBTLE, 1)
		local max = 1
		for _, d in ipairs(days) do max = math.max(max, d.n + (d.r or 0)) end
		local n = #days
		local top, bottom = IS_MOBILE and 18 or 22, IS_MOBILE and 18 or 22
		for i, d in ipairs(days) do
			local col = Instance.new("Frame")
			col.BackgroundTransparency = 1
			col.Size = UDim2.new(1 / n, -4, 1, -8)
			col.Position = UDim2.new((i - 1) / n, 2, 0, 4)
			col.ZIndex = 12
			col.Parent = f
			local rb = d.r or 0
			local sum = d.n + rb
			local h = sum / max
			local plot = Instance.new("Frame")
			plot.BackgroundTransparency = 1
			plot.Position = UDim2.new(0, 0, 0, top)
			plot.Size = UDim2.new(1, 0, 1, -(top + bottom))
			plot.ZIndex = 12
			plot.Parent = col
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 1)
			bar.Position = UDim2.new(0.5, 0, 1, 0)
			bar.Size = UDim2.new(0.72, 0, h, sum > 0 and 0 or 2)
			bar.BackgroundColor3 = d.today and STAT_C or ACC_D
			bar.BorderSizePixel = 0
			bar.ZIndex = 12
			bar.Parent = plot
			corner(bar, 3)
			if rb > 0 then
				-- 💳 part financée en Robux, en vert en bas de la barre
				local rf = Instance.new("Frame")
				rf.AnchorPoint = Vector2.new(0, 1)
				rf.Position = UDim2.new(0, 0, 1, 0)
				rf.Size = UDim2.new(1, 0, rb / sum, 0)
				rf.BackgroundColor3 = RBX_C
				rf.BorderSizePixel = 0
				rf.ZIndex = 13
				rf.Parent = bar
				corner(rf, 3)
			end
			if sum > 0 then
				-- la valeur juste au-dessus de la barre
				label(plot, {
					text = nfmt(sum), size = UDim2.new(1, 0, 0, IS_MOBILE and 12 or 14),
					position = UDim2.new(0, 0, 1 - h, -2), anchor = Vector2.new(0, 1),
					color = d.today and STAT_C or C.TEXT_GREY, textSize = IS_MOBILE and 9 or 11, zIndex = 13,
				})
			end
			label(col, {
				text = (d.day.day == 1 or i == 1) and (d.day.day .. "/" .. d.day.month) or tostring(d.day.day),
				size = UDim2.new(1, 4, 0, bottom - 4), position = UDim2.new(0, -2, 1, -(bottom - 4)),
				color = d.today and STAT_C or C.TEXT_DIM, textSize = IS_MOBILE and 8 or 10, zIndex = 13,
			})
		end
	end

	statsScreen = function()
		currentScreen = "shopstats"
		local body = buildScreen(STATS_TITLE, true, STAT_C, S.backFn, function()
			ST.entries = nil
			ST.rbx = nil
			loadStats()
		end)

		if not ST.entries then
			local l = note(body, 1, ST.loading and ("⏳ Lecture du log… %d achats"):format(ST.progress)
				or "⏳ Chargement…", C.TEXT_GREY)
			ST.progLbl = l
			if not ST.loading then loadStats() end
			return
		end
		ST.progLbl = nil

		if ST.err then note(body, 1, "❌ " .. ST.err, C.RED) end

		-- 💳 Case à cocher : compter les UGC financés en Robux à part
		do
			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
			row.BackgroundColor3 = C.BG_DARK
			row.AutoButtonColor = false
			row.BorderSizePixel = 0
			row.Text = ""
			row.LayoutOrder = 3
			row.ZIndex = 11
			row.Parent = body
			corner(row, 9)
			stroke(row, ST.robux and RBX_C or C.BORDER_SUBTLE, 1)
			local bs = IS_MOBILE and 22 or 26
			local box = Instance.new("Frame")
			box.AnchorPoint = Vector2.new(0, 0.5)
			box.Position = UDim2.new(0, 10, 0.5, 0)
			box.Size = UDim2.new(0, bs, 0, bs)
			box.BackgroundColor3 = ST.robux and C.GREEN_DARK or C.BG_MEDIUM
			box.BorderSizePixel = 0
			box.ZIndex = 12
			box.Parent = row
			corner(box, 6)
			stroke(box, ST.robux and C.GREEN or C.BORDER_BRIGHT, 1.5)
			if ST.robux then
				label(box, { text = "✓", size = UDim2.fromScale(1, 1), textSize = IS_MOBILE and 15 or 18, zIndex = 13 })
			end
			label(row, {
				text = "💳 UGC payées en Robux → 🎽 UGC STATS (calcul exact)",
				size = UDim2.new(1, -(bs + 30), 1, 0), position = UDim2.new(0, bs + 20, 0, 0),
				xAlign = Enum.TextXAlignment.Left, textSize = IS_MOBILE and 11 or 14, zIndex = 12, truncate = true,
			})
			row.MouseButton1Click:Connect(function()
				if _G.AdminOpenUGCStats then _G.AdminOpenUGCStats() end
			end)
		end

		if ST.robux and ST.rbxLoading then
			ST.progLbl = note(body, 4, ST.rbxProgress ~= "" and ST.rbxProgress or "💳 Lecture des achats Robux…", RBX_C)
		elseif ST.robux and ST.rbxErr then
			note(body, 4, "❌ " .. ST.rbxErr, C.RED)
		end

		acTabBar(body, 2, {
			{ id = "paid", label = "💎 Achats payés" },
			{ id = "all",  label = "🌐 Payés + gratuits" },
		}, ST.scope, STAT_D, function(id) ST.scope = id; statsScreen() end)

		local R = compute()

		-- ── STOCK ──
		sectionLabel(body, 10, "📦 STOCK")
		local g1 = grid(body, 11)
		local soldPct = (R.init > 0) and ((1 - R.rem / R.init) * 100) or nil
		tile(g1, 1, "Stock restant total", nfmt(R.rem),
			("sur %s au départ%s"):format(nfmt(R.init), soldPct and ("  ·  %.0f%% parti"):format(soldPct) or ""), C.GREEN)
		tile(g1, 2, "UGC épuisés", ("%d / %d"):format(R.out, R.known),
			(R.known - R.out) .. " encore en vente", R.out > 0 and C.ORANGE or C.TEXT_WHITE)
		tile(g1, 3, "Rupture totale estimée", daysFmt(R.outRate7 > 0 and R.rem / R.outRate7 or nil),
			"au rythme des 7 derniers jours", STAT_C)
		tile(g1, 4, "Rupture au rythme 30 j", daysFmt(R.outRate30 > 0 and R.rem / R.outRate30 or nil),
			("≈ %s/jour"):format(nfmt(R.outRate30)), STAT_C)

		-- ── 💳 ROBUX ──
		local rbxOn = ST.robux and ST.rbx ~= nil and not ST.rbxLoading
		if rbxOn then
			local r = R.r
			local R_ = function(n) return nfmt(math.floor(n + 0.5)) .. " R$" end
			sectionLabel(body, 15, "💳 UGC PAYÉS AVEC DES POINTS ACHETÉS EN ROBUX")
			local g5 = grid(body, 16)
			tile(g5, 1, "Aujourd'hui", nfmt(r.today), "hier : " .. nfmt(r.yest), RBX_C)
			tile(g5, 2, "7 derniers jours", nfmt(r.d7), "≈ " .. R_(r.rev7), RBX_C)
			tile(g5, 3, "30 derniers jours", nfmt(r.d30), "≈ " .. R_(r.rev30), RBX_C)
			tile(g5, 4, "365 derniers jours", nfmt(r.d365), ("%s au total"):format(nfmt(r.total)), RBX_C)
			local all30 = r.d30 + R.d30
			tile(g5, 5, "Part payée en Robux (30 j)", all30 > 0 and ("%.0f%%"):format(r.d30 / all30 * 100) or "—",
				("%s donnés vs %s en Robux"):format(nfmt(R.d30), nfmt(r.d30)), RBX_C)
			tile(g5, 6, "Robux dans ces UGC", R_(r.rev),
				("≈ %s/jour  ·  %s/mois"):format(R_(r.rev / R.spanDays), R_(r.rev / R.spanDays * 30.44)), RBX_C)
			tile(g5, 7, "Joueurs financés en Robux", nfmt(r.buyers),
				("dont %d grâce à un gift reçu"):format(r.viaGift))
			tile(g5, 8, "Points Robux pas encore dépensés", nfmt(r.leftPts),
				"≈ " .. R_(r.leftRbx) .. " · encore sur leur solde", r.leftPts > 0 and C.ORANGE or C.TEXT_WHITE)
		end
		-- ── SORTIES ──
		sectionLabel(body, 20, rbxOn and "🎁 UGC VRAIMENT DONNÉS (sans 💳 Robux)" or "📉 SORTIES DE STOCK")
		local g2 = grid(body, 21)
		tile(g2, 1, "Aujourd'hui", nfmt(R.today), "depuis minuit", STAT_C)
		local diff = math.floor(R.today - R.yest + 0.5)
		tile(g2, 2, "Hier", nfmt(R.yest),
			(diff >= 0 and '<font color="#5ADC8C">+%d</font> vs hier' or '<font color="#FFAA46">%d</font> vs hier'):format(diff))
		tile(g2, 3, "7 derniers jours", nfmt(R.d7), ("≈ %s/jour"):format(nfmt(R.rate7)))
		tile(g2, 4, "30 derniers jours", nfmt(R.d30), ("≈ %s/jour"):format(nfmt(R.rate30)))
		tile(g2, 5, "365 derniers jours", nfmt(R.d365), ("%s au total dans le log"):format(nfmt(R.total)))
		tile(g2, 6, "Tendance", R.rate30 > 0 and ("%+.0f%%"):format((R.rate7 / R.rate30 - 1) * 100) or "—",
			"rythme 7 j vs 30 j", (R.rate7 >= R.rate30) and C.GREEN or C.ORANGE)

		-- ── MOYENNES ──
		sectionLabel(body, 30, ("📊 MOYENNES%s  (sur %s de données)"):format(
			rbxOn and " DES UGC DONNÉS" or "", daysFmt(R.spanDays)))
		local g3 = grid(body, 31)
		tile(g3, 1, "Par jour", nfmt(R.perDayAll), ("récent (7 j) : %s"):format(nfmt(R.rate7)), ACC)
		tile(g3, 2, "Par semaine", nfmt(R.perDayAll * 7), ("récent : %s"):format(nfmt(R.rate7 * 7)), ACC)
		tile(g3, 3, "Par mois", nfmt(R.perDayAll * 30.44), ("récent : %s"):format(nfmt(R.rate30 * 30.44)), ACC)
		tile(g3, 4, "Par an", nfmt(R.perDayAll * 365), ("récent : %s"):format(nfmt(R.rate30 * 365)), ACC)

		-- ── GRAPHIQUE ──
		sectionLabel(body, 40, rbxOn and "🗓️ 14 DERNIERS JOURS  (vert = 💳 payé en Robux)" or "🗓️ 14 DERNIERS JOURS")
		barChart(body, 41, R.last14)

		-- ── AUTRES ──
		sectionLabel(body, 50, "✨ AUTRES STATS")
		local g4 = grid(body, 51)
		local bd = R.bestDay and R.bestDay:gsub("^(%d+)%-(%d+)%-(%d+)$", "%3/%2/%1") or "—"
		tile(g4, 1, "Meilleur jour", nfmt(R.bestN), bd, STAT_C)
		tile(g4, 2, "Heure la plus active", R.bestHour and ("%dh–%dh"):format(R.bestHour, (R.bestHour + 1) % 24) or "—",
			"heure de ton ordi")
		tile(g4, 3, "Jour le plus actif", R.bestWday and WDAY[R.bestWday] or "—", "sur toute la période")
		tile(g4, 4, "Acheteurs (30 j)", nfmt(R.buyers30),
			("%d en ont pris plus d'un"):format(R.repeat30))
		tile(g4, 5, "Points dépensés (30 j)", nfmt(R.pts30), ("7 j : %s"):format(nfmt(R.pts7)), Color3.fromRGB(120, 220, 255))
		tile(g4, 6, "Prix moyen payé", R.paidN > 0 and nfmt(R.ptsAll / R.paidN) or "—",
			("total : %s pts"):format(nfmt(R.ptsAll)), Color3.fromRGB(120, 220, 255))
		if ST.scope == "all" then
			tile(g4, 7, "Gratuits (30 j)", nfmt(R.free30), "free + admin")
		end
		tile(g4, 8, "🚨 Hors shop (log)", nfmt(R.flags), "exploit / external, jamais comptés",
			R.flags > 0 and C.RED or C.TEXT_WHITE)

		-- ── PAR UGC ──
		sectionLabel(body, 60, "🎽 PAR UGC")
		acTabBar(body, 61, {
			{ id = "sold",    label = "Les + vendus (7 j)" },
			{ id = "rupture", label = "Rupture la + proche" },
		}, ST.perSort, STAT_D, function(id) ST.perSort = id; statsScreen() end)

		local rowsData = {}
		for _, it in ipairs(configItems()) do
			local k = key(it.AssetId)
			local P = R.per[k] or { total = 0, d7 = 0, d30 = 0, last = 0, rbx = 0 }
			local s = (ST.stocks or {})[k] or {}
			local rate = P.d7 / math.min(7, R.spanDays)
			local eta = (s.cur and s.cur > 0 and rate > 0) and (s.cur / rate) or nil
			table.insert(rowsData, { it = it, k = k, P = P, s = s, rate = rate, eta = eta })
		end
		table.sort(rowsData, function(a, b)
			if ST.perSort == "rupture" then
				local ea = (a.s.cur == 0) and -1 or (a.eta or math.huge)
				local eb = (b.s.cur == 0) and -1 or (b.eta or math.huge)
				if ea ~= eb then return ea < eb end
			end
			if a.P.d7 ~= b.P.d7 then return a.P.d7 > b.P.d7 end
			return a.P.total > b.P.total
		end)

		local RH = IS_MOBILE and 56 or 66
		for i, d in ipairs(rowsData) do
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, RH)
			row.BackgroundColor3 = C.BG_DARK
			row.BorderSizePixel = 0
			row.LayoutOrder = 100 + i
			row.ZIndex = 11
			row.Parent = body
			corner(row, 10)
			stroke(row, (d.s.cur == 0) and C.RED_DARK or C.BORDER_SUBTLE, 1)
			local isz = RH - 14
			local im = Instance.new("ImageLabel")
			im.BackgroundTransparency = 1
			im.Image = itemImage(d.it)
			im.ScaleType = Enum.ScaleType.Fit
			im.AnchorPoint = Vector2.new(0, 0.5)
			im.Position = UDim2.new(0, 8, 0.5, 0)
			im.Size = UDim2.new(0, isz, 0, isz)
			im.ZIndex = 12
			im.Parent = row
			local tx = 8 + isz + 8
			local rw = IS_MOBILE and 86 or 116
			label(row, {
				text = tostring(d.it.Name or d.k) .. (isHidden(d.k) and "  ⚫" or ""),
				size = UDim2.new(1, -tx - rw - 8, 0, IS_MOBILE and 16 or 19),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 7 or 9),
				xAlign = Enum.TextXAlignment.Left, textSize = IS_MOBILE and 12 or 15, zIndex = 12, truncate = true,
			})
			label(row, {
				text = ("7 j : <b>%d</b>  ·  30 j : %d  ·  total : %d  ·  %s/j"):format(
					d.P.d7, d.P.d30, d.P.total, nfmt(d.rate))
					.. ((rbxOn and d.P.rbx > 0) and ('  ·  <font color="#5ADC8C">💳 %s</font>'):format(nfmt(d.P.rbx)) or ""),
				richText = true,
				size = UDim2.new(1, -tx - rw - 8, 0, IS_MOBILE and 13 or 15),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 27 or 32),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 12, zIndex = 12, truncate = true,
			})
			local stockTxt = d.s.cur and (("%s/%s"):format(nfmt(d.s.cur), d.s.total and nfmt(d.s.total) or "?")) or "?"
			label(row, {
				text = stockTxt, size = UDim2.new(0, rw, 0, IS_MOBILE and 16 or 19),
				position = UDim2.new(1, -8, 0, IS_MOBILE and 7 or 9), anchor = Vector2.new(1, 0),
				xAlign = Enum.TextXAlignment.Right, textSize = IS_MOBILE and 12 or 15, zIndex = 12,
				color = (d.s.cur == 0) and C.RED or C.GREEN,
			})
			label(row, {
				text = (d.s.cur == 0) and "ÉPUISÉ" or ("rupture : " .. daysFmt(d.eta)),
				size = UDim2.new(0, rw, 0, IS_MOBILE and 13 or 15),
				position = UDim2.new(1, -8, 0, IS_MOBILE and 27 or 32), anchor = Vector2.new(1, 0),
				xAlign = Enum.TextXAlignment.Right, textSize = IS_MOBILE and 9 or 12, zIndex = 12,
				color = (d.s.cur == 0) and C.RED or ((d.eta and d.eta < 3) and C.ORANGE or C.TEXT_DIM),
			})
		end

		local info = ("ℹ️ %d achats lus dans le log%s · chargé %s. "
			.. "« Rupture » = stock restant ÷ ventes/jour des 7 derniers jours. "
			.. "Les moyennes sont calculées sur la période réellement couverte par le log.")
			:format(#(ST.entries or {}), ST.truncated and " (⚠️ log tronqué, les plus vieux ne sont pas comptés)" or "",
		ago(ST.loadedAt) or "")
		note(body, 9000, info, C.TEXT_DIM)
	end

	------------------------------------------------------------------
	-- ❤️ CASE À COCHER : nombre de likes visible dans le shop
	------------------------------------------------------------------
	local likesBusy = false
	local function likesToggle(body)
		local f = folder()
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.BorderSizePixel = 0
		row.Text = ""
		row.LayoutOrder = -1
		row.ZIndex = 11
		row.Parent = body
		corner(row, 9)
		local st = stroke(row, C.BORDER_SUBTLE, 1)

		local bs = IS_MOBILE and 22 or 26
		local box = Instance.new("Frame")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 10, 0.5, 0)
		box.Size = UDim2.new(0, bs, 0, bs)
		box.BorderSizePixel = 0
		box.ZIndex = 12
		box.Parent = row
		corner(box, 6)
		local bst = stroke(box, C.BORDER_BRIGHT, 1.5)
		local tick_ = label(box, {
			text = "✓", size = UDim2.fromScale(1, 1), textSize = IS_MOBILE and 15 or 18, zIndex = 13,
		})

		label(row, {
			text = "❤️ Afficher le nombre de likes dans le shop",
			size = UDim2.new(1, -(bs + 30) - 60, 1, 0), position = UDim2.new(0, bs + 20, 0, 0),
			xAlign = Enum.TextXAlignment.Left, textSize = IS_MOBILE and 12 or 15, zIndex = 12, truncate = true,
		})
		local state = label(row, {
			text = "", size = UDim2.new(0, 56, 1, 0), position = UDim2.new(1, -10, 0, 0),
			anchor = Vector2.new(1, 0), xAlign = Enum.TextXAlignment.Right,
			textSize = IS_MOBILE and 11 or 13, zIndex = 12,
		})

		local function paint()
			if not row.Parent then return end
			local fo = folder()
			local on = fo ~= nil and fo:GetAttribute("ShowLikeCount") == true
			box.BackgroundColor3 = on and C.GREEN_DARK or C.BG_MEDIUM
			bst.Color = on and C.GREEN or C.BORDER_BRIGHT
			st.Color = on and C.GREEN_DARK or C.BORDER_SUBTLE
			tick_.Visible = on
			state.Text = likesBusy and "⏳" or (fo == nil and "—" or (on and "ON" or "OFF"))
			state.TextColor3 = on and C.GREEN or C.TEXT_DIM
		end
		paint()
		if f then
			local conn
			conn = f:GetAttributeChangedSignal("ShowLikeCount"):Connect(function()
				if not row.Parent then conn:Disconnect(); return end
				paint()
			end)
		end

		row.MouseButton1Click:Connect(function()
			local r, fo = remote(), folder()
			if not r or not fo then toast("UGCShopOrder_Server pas installé côté serveur", false); return end
			if likesBusy then return end
			likesBusy = true; paint()
			local want = fo:GetAttribute("ShowLikeCount") ~= true
			task.spawn(function()
				local ok, res = pcall(function() return r:InvokeServer("likes", { show = want }) end)
				likesBusy = false
				if ok and type(res) == "table" and res.ok then
					toast(res.msg, true)
				else
					toast((type(res) == "table" and res.msg) or ("❌ Erreur : " .. tostring(res)), false)
				end
				paint()
			end)
		end)
	end

	------------------------------------------------------------------
	-- 🔗 BOUTON ↕️ EN HAUT DE 📦 RÉGLAGES DU STOCK
	------------------------------------------------------------------
	local previousBuildScreen = buildScreen
	buildScreen = function(titleText, showBack, accent, backFn, refreshFn, ...)
		local r = table.pack(previousBuildScreen(titleText, showBack, accent, backFn, refreshFn, ...))
		if titleText == STOCK_TITLE then
			-- Le 🔄 de l'écran stock le rouvre : parfait comme bouton ← BACK
			S.backFn = refreshFn
			local body = r[1]
			if typeof(body) == "Instance" and body:IsA("ScrollingFrame") then
				local c = Instance.new("Frame")
				c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
				c.BackgroundTransparency = 1
				c.LayoutOrder = -2
				c.ZIndex = 11
				c.Parent = body
				local b = actionButton(c, {
					color = ACC_D, strokeColor = ACC,
					text = "↕️ ORDRE DANS LE SHOP",
					textSize = IS_MOBILE and 12 or 15, radius = 9, zIndex = 11,
				})
				b.MouseButton1Click:Connect(function() screen(true) end)

				local c2 = Instance.new("Frame")
				c2.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
				c2.BackgroundTransparency = 1
				c2.LayoutOrder = -3
				c2.ZIndex = 11
				c2.Parent = body
				local b2 = actionButton(c2, {
					color = STAT_D, strokeColor = STAT_C,
					text = "📊 STATS DU STOCK",
					textSize = IS_MOBILE and 12 or 15, radius = 9, zIndex = 11,
				})
				b2.MouseButton1Click:Connect(function() statsScreen() end)

				likesToggle(body)
			end
		end
		return table.unpack(r, 1, r.n)
	end
end)()

--════════════════════════════════════════════════════════════════════════════
--
--   🎪  BLOC 12 — ADMIN ABUSE   (v4)
--
--   📍 OÙ LE COLLER ?
--      Dans ton LocalScript « ADMIN PANEL — CLIENT ».
--      Tu SUPPRIMES entièrement l'ancien bloc 12 et tu colles celui-ci à la
--      place. ⚠️ Le bloc 11 (mémoire de défilement) doit RESTER le dernier
--      bloc du fichier.
--
--   C'est une IIFE : zéro variable ajoutée au script principal.
--
--════════════════════════════════════════════════════════════════════════════
--
--   LES DEUX BUGS QUE TU AS TROUVÉS, ET CE QUI LES CAUSAIT
--
--   🐛 1. « Je clique sur une option de la liste et ça me renvoie à l'écran
--          des events, je ne peux rien modifier. »
--
--      C'était une ligne. En fermant la liste je remettais `S.view = nil`,
--      c'est-à-dire « retour à l'accueil », au lieu de « retour à l'écran
--      d'où je viens ». L'éditeur, lui, VIT dans S.view = "edit" : le vider
--      revenait donc à le fermer à chaque choix. Impossible de régler quoi
--      que ce soit — tu avais raison, c'était terrible.
--
--      Maintenant la liste MÉMORISE l'écran appelant et y revient. Elle
--      marche donc aussi bien depuis l'éditeur que depuis le planning ou
--      depuis l'onglet des cadeaux, sans cas particulier.
--
--   🐛 2. « Je ne peux pas déplacer les barres, le drag ne fait rien. »
--
--      J'avais réparé la mauvaise moitié : le glisser-déposer d'UI dépend de
--      trop de choses (qui capte l'entrée, quel élément la mange, le décalage
--      de la barre Roblox, le défilement tactile qui prend la main). Sur ton
--      installation, quelque chose l'avale — et je ne peux pas le déboguer à
--      l'aveugle.
--
--      Donc je l'ai supprimé comme mécanisme principal. Le placement se fait
--      maintenant avec des BOUTONS : 9 ancrages (coins, bords, centre) et
--      quatre flèches pour ajuster au pixel près. Un bouton, ça ne peut pas
--      « ne rien faire ». Et un bouton, ça marche au doigt sans viser.
--
--════════════════════════════════════════════════════════════════════════════
--
--   LES TROIS PRINCIPES DE L'INTERFACE
--
--   1. UNE QUESTION À LA FOIS. Chaque réglage est une ligne : son nom, sa
--      valeur, et une phrase qui dit ce que ça fait. Tu ne devines jamais.
--   2. DES LISTES, PAS DES NOMBRES. Chaque choix montre sa description avant
--      que tu cliques. Les nombres ont des boutons − / + et des raccourcis.
--   3. DES DÉPARTS EN UN CLIC. 6 plannings déjà rythmés, 8 cadeaux prêts.
--
--   🌐 Tout le texte affiché est en ANGLAIS. Commentaires en français.
--   ❌ Aucune commande chat : le serveur revérifie qui tu es à CHAQUE clic.
--
--════════════════════════════════════════════════════════════════════════════
;(function()

	--  Plus aucune dépendance à UserInputService : le placement se fait
	--  entièrement au bouton, donc il n'y a plus d'entrée à capter.
	local RSX = game:GetService("ReplicatedStorage")

	local AA   = Color3.fromRGB(255, 120, 190)
	local AA_D = Color3.fromRGB(150, 40, 100)
	local OK_C = Color3.fromRGB(90, 220, 140)
	local OK_D = Color3.fromRGB(30, 120, 70)
	local INFO = Color3.fromRGB(120, 205, 255)

	local CFG = nil
	do
		local mod = RSX:FindFirstChild("AdminAbuse_Config")
		if mod then
			local ok, res = pcall(require, mod)
			if ok and type(res) == "table" then CFG = res end
		end
	end

	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = RSX:FindFirstChild(name)
		R[name] = r
		return r
	end
	task.spawn(function()
		R.AdminAbuseGet    = RSX:WaitForChild("AdminAbuseGet", 40)
		R.AdminAbuseAction = RSX:WaitForChild("AdminAbuseAction", 40)
	end)

	------------------------------------------------------------------
	-- 🧠 ÉTAT LOCAL
	------------------------------------------------------------------
	local S = {
		tab = "start",
		view = nil,            -- nil | "plan" | "edit" | "pick"
		loaded = false, loading = false, failed = false, failMsg = nil,

		run = nil, custom = {}, plans = {}, tools = {},
		mc  = CFG and CFG.MessageDefaults() or {},
		hud = CFG and CFG.HudDefaults() or {},
		sched = CFG and CFG.SchedDefaults() or {},

		steps = {}, planTitle = "", saveName = "",
		edit = nil, editId = nil, editNew = false,
		pick = nil,
		msg = { text = "", rainbow = true },

		--  Placement des barres : quelle barre je déplace, et de combien.
		place = "gf", placeStep = 0.02,

		confirmKey = nil, confirmAt = 0,
		busy = false, stats = nil, statsLoading = false, hudPreview = false,
	}

	local screen   -- forward

	------------------------------------------------------------------
	-- 📡 APPELS SERVEUR
	--    Ce qu'on envoie n'est qu'une DEMANDE. Le serveur revalide tout :
	--    qui tu es, chaque nombre, chaque nom. Un panel modifié ne gagne
	--    rien de plus qu'un panel normal.
	------------------------------------------------------------------
	local function srvGet(what, cb)
		local fn = remote("AdminAbuseGet")
		if not fn then cb(nil, "AdminAbuse_Server is not installed") return end
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(what) end)
			if ok and type(res) == "table" and res.ok then cb(res, nil)
			else cb(nil, (type(res) == "table" and res.err) or tostring(res)) end
		end)
	end

	local function srvAct(action, payload, cb)
		local fn = remote("AdminAbuseAction")
		if not fn then toast("AdminAbuse_Server is not installed", false) return end
		if S.busy then toast("Hold on - one action at a time", false) return end
		S.busy = true
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			S.busy = false
			if ok and type(res) == "table" and res.ok then
				toast(tostring(res.msg or "Done"), true)
				if type(res.run) == "table" then S.run = res.run end
				if cb then cb(true, res) end
			else
				toast((type(res) == "table" and res.err) or tostring(res), false)
				if cb then cb(false, res) end
			end
			if currentScreen == "adminabuse" and window.Visible then screen(false) end
		end)
	end

	------------------------------------------------------------------
	-- 🧰 PETITS OUTILS
	------------------------------------------------------------------
	local function mmss(sec)
		sec = math.max(0, math.floor(tonumber(sec) or 0))
		if sec >= 3600 then
			return string.format("%dh%02d", math.floor(sec / 3600), math.floor(sec / 60) % 60)
		end
		if sec >= 60 then
			local m, s = math.floor(sec / 60), sec % 60
			if s == 0 then return m .. " min" end
			return string.format("%dm%02d", m, s)
		end
		return sec .. "s"
	end

	--  Séparateur de milliers : « 1 250 000 » se lit, « 1250000 » non.
	local function comma(n)
		local s = tostring(math.floor(tonumber(n) or 0))
		local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
		return (out:gsub("^%s+", ""))
	end

	--  ✅ Confirmation en DEUX APPUIS, sans fenêtre par-dessus. Une boîte de
	--     dialogue coûte un écran entier et casse le fil ; deux appuis
	--     suffisent à empêcher le clic accidentel, et le bouton dit lui-même
	--     ce qui va se passer.
	local function armed(key)
		return S.confirmKey == key and (os.clock() - S.confirmAt) < 6
	end
	local function arm(key) S.confirmKey, S.confirmAt = key, os.clock() end
	local function disarm() S.confirmKey = nil end

	------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	--    Tout est défini ici. Ce bloc ne dépend que de `corner`, `stroke`,
	--    `actionButton`, `toast`, `buildScreen`, `C`, `FONT` et `IS_MOBILE`
	--    — les seules briques du panel principal dont je suis certain. Rien
	--    ne peut casser à cause d'un autre bloc.
	------------------------------------------------------------------
	local FS = IS_MOBILE and 0.86 or 1

	local function lbl(parent, props)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Font           = FONT
		l.Text           = props.text or ""
		l.TextColor3     = props.color or C.TEXT_WHITE
		l.TextSize       = (props.size or 13) * FS
		l.TextXAlignment = props.xAlign or Enum.TextXAlignment.Left
		l.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
		l.TextWrapped    = props.wrap or false
		l.Size           = props.frame or UDim2.new(1, 0, 1, 0)
		if props.pos then l.Position = props.pos end
		if props.auto then l.AutomaticSize = Enum.AutomaticSize.Y end
		if props.truncate then l.TextTruncate = Enum.TextTruncate.AtEnd end
		l.ZIndex = props.z or 12
		l.Parent = parent
		return l
	end

	--  📄 Encart d'explication. La brique la plus utilisée du panel : partout
	--     où il y a une décision à prendre, il y a une phrase.
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.3
		f.BorderSizePixel = 0
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		corner(f, 8) ; stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 8) ; p.PaddingBottom = UDim.new(0, 8)
		p.PaddingLeft = UDim.new(0, 10) ; p.PaddingRight = UDim.new(0, 10)
		p.Parent = f
		lbl(f, { text = text, color = color or C.TEXT_GREY, size = IS_MOBILE and 11 or 12.5,
			wrap = true, auto = true, frame = UDim2.new(1, 0, 0, 0),
			yAlign = Enum.TextYAlignment.Top })
		return f
	end

	local function head(parent, order, text)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 26 or 30)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		lbl(f, { text = text, color = AA, size = IS_MOBILE and 12 or 14,
			yAlign = Enum.TextYAlignment.Bottom })
		return f
	end

	local function spacer(parent, order, px)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, px or 6)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.Parent = parent
		return f
	end

	local function big(parent, order, text, col, colD, fn, height)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, height or (IS_MOBILE and 44 or 50))
		c.BackgroundTransparency = 1
		c.LayoutOrder = order ; c.ZIndex = 11 ; c.Parent = parent
		local b = actionButton(c, { color = col, strokeColor = colD, text = text,
			textSize = IS_MOBILE and 13 or 15, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b
	end

	local function row2(parent, order, a, b)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order ; c.ZIndex = 11 ; c.Parent = parent
		local function half(def, left)
			local h = Instance.new("Frame")
			h.Size = UDim2.new(0.5, -4, 1, 0)
			h.Position = left and UDim2.new(0, 0, 0, 0) or UDim2.new(0.5, 4, 0, 0)
			h.BackgroundTransparency = 1
			h.ZIndex = 11 ; h.Parent = c
			local btn = actionButton(h, { color = def.col, strokeColor = def.colD,
				text = def.text, textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
			btn.MouseButton1Click:Connect(def.fn)
		end
		if a then half(a, true) end
		if b then half(b, false) end
		return c
	end

	--  Une rangée de N boutons égaux. Sert aux ancrages, aux flèches et aux
	--  raccourcis de valeur.
	local function btnGrid(parent, order, items, height)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, height or (IS_MOBILE and 34 or 40))
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		local lay = Instance.new("UIListLayout")
		lay.FillDirection = Enum.FillDirection.Horizontal
		lay.Padding = UDim.new(0, 4)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		lay.Parent = f
		for i, it in ipairs(items) do
			local c = Instance.new("Frame")
			c.Size = UDim2.new(1 / #items, -4, 1, 0)
			c.BackgroundTransparency = 1
			c.LayoutOrder = i ; c.ZIndex = 11 ; c.Parent = f
			local b = actionButton(c, {
				color = it.sel and AA_D or (it.col or C.BG_LIGHT),
				strokeColor = it.sel and AA or (it.colD or C.BORDER_BRIGHT),
				text = it.text, textSize = it.textSize or (IS_MOBILE and 12 or 14),
				radius = 8, zIndex = 11 })
			b.MouseButton1Click:Connect(it.fn)
		end
		return f
	end

	--  🃏 La carte cliquable : un titre, une explication, une pastille à
	--     droite. Tu sais ce que fait un élément AVANT de cliquer dessus.
	local function card(parent, order, o)
		local h = o.height or (IS_MOBILE and 56 or 66)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, 0, 0, h)
		b.BackgroundColor3 = o.selected and C.BG_MEDIUM or C.BG_ITEM
		b.BackgroundTransparency = 0.2
		b.AutoButtonColor = false
		b.Text = "" ; b.BorderSizePixel = 0
		b.LayoutOrder = order ; b.ZIndex = 11 ; b.Parent = parent
		corner(b, 10)
		local st = stroke(b, o.selected and (o.color or AA) or C.BORDER_SUBTLE,
			o.selected and 1.8 or 1)

		local x = 12
		if o.icon then
			local img = Instance.new("ImageLabel")
			img.BackgroundTransparency = 1
			img.ScaleType = Enum.ScaleType.Fit
			img.Image = o.icon
			img.Size = UDim2.new(0, h - 22, 0, h - 22)
			img.Position = UDim2.new(0, 10, 0.5, 0)
			img.AnchorPoint = Vector2.new(0, 0.5)
			img.ZIndex = 12 ; img.Parent = b
			x = 10 + (h - 22) + 10
		end

		local rightW = o.right and (IS_MOBILE and 70 or 92) or 16
		lbl(b, { text = o.title or "", color = o.titleColor or C.TEXT_WHITE,
			size = IS_MOBILE and 13 or 15, truncate = true,
			frame = UDim2.new(1, -x - rightW, 0, IS_MOBILE and 18 or 20),
			pos = UDim2.new(0, x, 0, o.sub and (IS_MOBILE and 8 or 11) or (h / 2 - 10)) })
		if o.sub then
			lbl(b, { text = o.sub, color = o.subColor or C.TEXT_GREY,
				size = IS_MOBILE and 10 or 11.5, wrap = true,
				frame = UDim2.new(1, -x - rightW, 0, IS_MOBILE and 26 or 30),
				pos = UDim2.new(0, x, 0, IS_MOBILE and 25 or 30),
				yAlign = Enum.TextYAlignment.Top })
		end
		if o.right then
			lbl(b, { text = o.right, color = o.rightColor or AA,
				size = IS_MOBILE and 12 or 14, xAlign = Enum.TextXAlignment.Right,
				frame = UDim2.new(0, rightW - 8, 1, 0),
				pos = UDim2.new(1, -rightW, 0, 0) })
		end

		if o.onClick then
			b.MouseEnter:Connect(function()
				b.BackgroundColor3 = C.BG_MEDIUM ; st.Color = o.color or AA
			end)
			b.MouseLeave:Connect(function()
				if o.selected then return end
				b.BackgroundColor3 = C.BG_ITEM ; st.Color = C.BORDER_SUBTLE
			end)
			b.MouseButton1Click:Connect(o.onClick)
		end
		return b
	end

	------------------------------------------------------------------
	-- 🎚️ LES LIGNES DE RÉGLAGE
	--    Toutes bâties pareil : nom à gauche, valeur à droite, phrase en
	--    dessous. C'est la régularité qui rend l'écran lisible.
	------------------------------------------------------------------
	local function helpUnder(parent, order, text)
		if not text or text == "" then return end
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 4) ; p.PaddingRight = UDim.new(0, 4)
		p.PaddingBottom = UDim.new(0, 6) ; p.Parent = f
		lbl(f, { text = text, color = C.TEXT_DIM, size = IS_MOBILE and 9.5 or 11,
			wrap = true, auto = true, frame = UDim2.new(1, 0, 0, 0),
			yAlign = Enum.TextYAlignment.Top })
	end

	local function choiceRow(parent, order, title, valueText, onOpen, help)
		card(parent, order, {
			title = title, right = "\u{203A}", rightColor = AA,
			height = IS_MOBILE and 38 or 44, onClick = onOpen,
		})
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 18)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order + 1 ; f.ZIndex = 11 ; f.Parent = parent
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 12) ; p.Parent = f
		lbl(f, { text = valueText, color = OK_C, size = IS_MOBILE and 11.5 or 13 })
		helpUnder(parent, order + 2, help)
	end

	--  🔢 Un nombre, réglé au doigt : − / + et des raccourcis. Aucun clavier
	--     n'est nécessaire, ce qui compte sur téléphone.
	local function numberRow(parent, order, title, value, minV, maxV, stepV, onSet, help, fmt, quick)
		local h = IS_MOBILE and 40 or 46
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, h)
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.2
		f.BorderSizePixel = 0
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		corner(f, 10) ; stroke(f, C.BORDER_SUBTLE, 1)

		local btnW = IS_MOBILE and 34 or 40
		local valW = IS_MOBILE and 62 or 78

		lbl(f, { text = title, color = C.TEXT_WHITE, size = IS_MOBILE and 12 or 14,
			truncate = true, frame = UDim2.new(1, -(btnW * 2 + valW + 24), 1, 0),
			pos = UDim2.new(0, 12, 0, 0) })

		local function step(dir)
			local v = (tonumber(value) or 0) + dir * stepV
			v = math.clamp(v, minV, maxV)
			--  On arrondit au pas : sinon 0.1 + 0.2 finit par afficher
			--  2.9999999 et on croit à un bug.
			v = math.floor(v / stepV + 0.5) * stepV
			onSet(v)
		end

		local function mk(px, text, dir)
			local c = Instance.new("Frame")
			c.Size = UDim2.new(0, btnW, 0, h - 12)
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, -px, 0.5, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12 ; c.Parent = f
			local b = actionButton(c, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
				text = text, textSize = IS_MOBILE and 15 or 18, radius = 8, zIndex = 12 })
			b.MouseButton1Click:Connect(function() step(dir) end)
		end
		mk(8, "+", 1)
		mk(8 + btnW + valW + 4, "\u{2212}", -1)

		lbl(f, { text = fmt and fmt(value) or tostring(value), color = OK_C,
			size = IS_MOBILE and 13 or 15, xAlign = Enum.TextXAlignment.Center,
			frame = UDim2.new(0, valW, 1, 0),
			pos = UDim2.new(1, -(8 + btnW + valW), 0, 0) })

		local nx = order + 1
		if quick and #quick > 0 then
			local items = {}
			for _, it in ipairs(quick) do
				items[#items + 1] = { text = it.label, sel = (tonumber(value) == it.v),
					fn = function() onSet(it.v) end, textSize = IS_MOBILE and 10 or 12 }
			end
			btnGrid(parent, nx, items, IS_MOBILE and 26 or 30)
			nx = nx + 1
		end
		helpUnder(parent, nx, help)
		return nx + 1
	end

	local function toggleRow(parent, order, title, on, onSet, help)
		card(parent, order, {
			title = title,
			right = on and "ON" or "OFF",
			rightColor = on and OK_C or C.TEXT_DIM,
			color = on and OK_C or AA,
			height = IS_MOBILE and 38 or 44,
			onClick = function() onSet(not on) end,
		})
		helpUnder(parent, order + 1, help)
		return order + 2
	end

	local function textRow(parent, order, title, value, maxLen, onSet, help, placeholder)
		local h = IS_MOBILE and 38 or 44
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, h)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent

		local labW = IS_MOBILE and 0.34 or 0.30
		lbl(f, { text = title, color = C.TEXT_WHITE, size = IS_MOBILE and 12 or 14,
			truncate = true, frame = UDim2.new(labW, -6, 1, 0), pos = UDim2.new(0, 2, 0, 0) })

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1 - labW, 0, 1, 0)
		box.Position = UDim2.new(labW, 0, 0, 0)
		box.BackgroundColor3 = C.BG_ITEM
		box.BackgroundTransparency = 0.15
		box.BorderSizePixel = 0
		box.Font = FONT
		box.Text = tostring(value or "")
		box.PlaceholderText = placeholder or ""
		box.PlaceholderColor3 = C.TEXT_DIM
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 12 or 14
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextTruncate = Enum.TextTruncate.AtEnd
		box.ClipsDescendants = true
		box.ClearTextOnFocus = false
		box.ZIndex = 12 ; box.Parent = f
		corner(box, 8) ; stroke(box, C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 9) ; p.PaddingRight = UDim.new(0, 9)
		p.Parent = box

		--  ✂️ On coupe en CARACTÈRES, jamais en octets : couper au milieu d'un
		--     emoji fabrique une demi-lettre, et c'est exactement ce qui
		--     faisait échouer la sauvegarde entière côté DataStore.
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local t = box.Text
			local n = utf8.len(t)
			if n and maxLen and n > maxLen then
				local off = utf8.offset(t, maxLen + 1)
				t = t:sub(1, (off or 1) - 1)
				box.Text = t
			end
			onSet(t)
		end)
		helpUnder(parent, order + 1, help)
		return order + 2
	end

	--  🎨 Une couleur sans roue chromatique : 12 pastilles + AUTO. Une roue
	--     RGB c'est trois curseurs et une décision de graphiste ; douze
	--     pastilles c'est un clic.
	local PALETTE = {
		{ "Auto",    0, 0, 0 },
		{ "Pink",  255, 110, 190 }, { "Red",    255, 90, 100 },
		{ "Orange",255, 165,  70 }, { "Gold",   255, 205,  70 },
		{ "Lime",  170, 255, 110 }, { "Green",   90, 220, 140 },
		{ "Teal",  110, 240, 220 }, { "Cyan",   110, 210, 255 },
		{ "Blue",  120, 150, 255 }, { "Violet", 180, 130, 255 },
		{ "White", 245, 245, 255 },
	}

	local function colorRow(parent, order, title, value, onSet, help)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 24 or 28)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		lbl(f, { text = title, color = C.TEXT_WHITE, size = IS_MOBILE and 12 or 14 })

		local g = Instance.new("Frame")
		g.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		g.BackgroundTransparency = 1
		g.LayoutOrder = order + 1 ; g.ZIndex = 11 ; g.Parent = parent
		local lay = Instance.new("UIListLayout")
		lay.FillDirection = Enum.FillDirection.Horizontal
		lay.Padding = UDim.new(0, 4)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		lay.Parent = g

		local cur = value or { 0, 0, 0 }
		for i, p in ipairs(PALETTE) do
			local cc = Instance.new("TextButton")
			cc.Size = UDim2.new(1 / #PALETTE, -4, 1, 0)
			cc.BackgroundColor3 = (i == 1) and C.BG_LIGHT or Color3.fromRGB(p[2], p[3], p[4])
			cc.AutoButtonColor = false
			cc.Text = (i == 1) and "A" or ""
			cc.Font = FONT
			cc.TextSize = IS_MOBILE and 10 or 12
			cc.TextColor3 = C.TEXT_GREY
			cc.BorderSizePixel = 0
			cc.LayoutOrder = i ; cc.ZIndex = 12 ; cc.Parent = g
			corner(cc, 6)
			local same = (cur[1] == p[2] and cur[2] == p[3] and cur[3] == p[4])
			stroke(cc, same and C.TEXT_WHITE or C.BORDER_SUBTLE, same and 2.2 or 1)
			cc.MouseButton1Click:Connect(function() onSet({ p[2], p[3], p[4] }) end)
		end
		helpUnder(parent, order + 2, help)
		return order + 3
	end

	------------------------------------------------------------------
	-- 📚 LES DONNÉES
	------------------------------------------------------------------
	local function allEvents()
		local out = {}
		if CFG then
			for _, id in ipairs(CFG.BUILTIN_ORDER) do
				local w = CFG.Builtin(id)
				if w then out[#out + 1] = w end
			end
		end
		for _, w in pairs(S.custom or {}) do out[#out + 1] = w end
		return out
	end

	local function findEvent(id)
		for _, w in ipairs(allEvents()) do
			if w.id == id then return w end
		end
		return nil
	end

	--  Les listes lues EN DIRECT dans tes dossiers : tu glisses un objet dans
	--  ReplicatedStorage et il apparaît ici, sans rien redémarrer.
	local function folderChoices(folderName, className, emptyLabel, emptyDesc, itemDesc)
		local out = { { id = "", label = emptyLabel, desc = emptyDesc } }
		local folder = folderName and RSX:FindFirstChild(folderName)
		if folder then
			local names = {}
			for _, c in ipairs(folder:GetChildren()) do
				if c:IsA(className) then names[#names + 1] = c.Name end
			end
			table.sort(names)
			for _, n in ipairs(names) do
				out[#out + 1] = { id = n, label = n, desc = itemDesc }
			end
		end
		return out
	end

	local function skyChoices()
		return folderChoices(CFG and CFG.SKY_FOLDER, "Sky",
			"Keep the current sky",
			"Only the light changes. Safe, and the fastest to load.",
			"From your sky folder.")
	end

	local function musicChoices()
		return folderChoices(CFG and CFG.MUSIC_FOLDER, "Sound",
			"No music",
			"The player's normal playlist keeps going, untouched.",
			"From your Party music folder.")
	end

	local function toolChoices()
		local out = { { id = "", label = "No item", desc = "Players get nothing to hold." } }
		for _, n in ipairs(S.tools or {}) do
			out[#out + 1] = { id = n, label = n,
				desc = "Lent for the step, then taken back automatically." }
		end
		return out
	end

	local function labelOf(list, id, fallback)
		for _, o in ipairs(list) do
			if o.id == id then return o.label end
		end
		return fallback or tostring(id)
	end

	local function stepsTotal()
		local t = 0
		for _, w in ipairs(S.steps) do t = t + (tonumber(w.duration) or 0) end
		return t
	end

	------------------------------------------------------------------
	-- 📋 ÉCRAN « CHOISIR DANS UNE LISTE »
	--
	--  🐛 LE BUG QUE TU AS TROUVÉ ÉTAIT ICI.
	--
	--     Avant, en refermant la liste je faisais `S.view = nil`. Or
	--     l'éditeur d'événement VIT dans `S.view = "edit"` : le vider
	--     revenait à fermer l'éditeur. Chaque choix te ramenait donc à la
	--     liste des événements, et modifier quoi que ce soit devenait
	--     impossible.
	--
	--     La liste mémorise maintenant l'écran appelant et y revient. Un
	--     seul champ (`back`) règle le problème pour TOUS les écrans : celui
	--     de l'éditeur, du planning et des cadeaux — pas de cas particulier
	--     à écrire, donc pas de cas particulier à oublier.
	------------------------------------------------------------------
	local function openPick(title, options, current, onPick, intro)
		S.pick = { title = title, options = options, current = current,
			onPick = onPick, intro = intro, back = S.view }
		S.view = "pick"
		screen(false)
	end

	local function closePick()
		local back = S.pick and S.pick.back or nil
		S.pick = nil
		S.view = back          -- ⬅️ on RETOURNE d'où on vient
		screen(false)
	end

	local function renderPick(body)
		local p = S.pick
		if not p then S.view = nil ; screen(false) return end

		big(body, -1, "\u{2039}  BACK", C.BG_LIGHT, C.BORDER_BRIGHT, closePick,
			IS_MOBILE and 36 or 40)
		head(body, 0, p.title)
		if p.intro then note(body, 1, p.intro, C.TEXT_GREY) end

		for i, o in ipairs(p.options) do
			local sel = (o.id == p.current)
			card(body, 2 + i, {
				title = o.label, sub = o.desc, selected = sel,
				right = sel and "\u{2713}" or nil, rightColor = OK_C, color = AA,
				onClick = function()
					p.onPick(o.id)
					closePick()
				end,
			})
		end
	end

	------------------------------------------------------------------
	-- ✏️ ÉCRAN « CONSTRUIRE UN ÉVÉNEMENT »
	------------------------------------------------------------------
	local function renderEdit(body)
		local w = S.edit
		if not w or not CFG then S.view = nil ; screen(false) return end

		big(body, -3, "\u{2039}  BACK (nothing is saved yet)", C.BG_LIGHT, C.BORDER_BRIGHT,
			function() S.view = nil ; S.edit = nil ; disarm() ; screen(false) end,
			IS_MOBILE and 36 or 40)

		note(body, -2, "Start with a sky and a particle effect - that alone makes a good "
			.. "event. The light, the fog and the glow are all optional and all "
			.. "start OFF.", INFO)

		local n = 0
		for _, sec in ipairs(CFG.SIMPLE_SCHEMA) do
			n = n + 1 ; head(body, n, sec.title)
			if sec.blurb then n = n + 1 ; note(body, n, sec.blurb, C.TEXT_DIM) end

			for _, f in ipairs(sec.fields) do
				n = n + 1
				local key = f.key

				if f.kind == "text" then
					n = textRow(body, n, f.label, w[key], f.maxLen,
						function(v) w[key] = v end, f.help,
						key == "msg" and "Written for you if you leave it empty" or nil) - 1

				elseif f.kind == "num" then
					local quick = nil
					if key == "duration" then
						quick = { { label = "1 min", v = 60 }, { label = "2 min", v = 120 },
							{ label = "3 min", v = 180 }, { label = "5 min", v = 300 },
							{ label = "10 min", v = 600 } }
					elseif key == "boost" then
						quick = { { label = "Off", v = 0 }, { label = "+2", v = 2 },
							{ label = "+5", v = 5 }, { label = "+10", v = 10 },
							{ label = "+25", v = 25 } }
					elseif key == "fxAmount" then
						quick = { { label = "Light", v = 50 }, { label = "Normal", v = 100 },
							{ label = "Heavy", v = 160 } }
					end
					local fmt = nil
					if key == "duration" then fmt = mmss
					elseif key == "fxAmount" then fmt = function(v) return tostring(v) .. "%" end end
					n = numberRow(body, n, f.label, w[key], f.min, f.max, f.step,
						function(v) w[key] = v ; screen(false) end, f.help, fmt, quick) - 1

				elseif f.kind == "bool" then
					n = toggleRow(body, n, f.label, w[key] == true,
						function(v) w[key] = v ; screen(false) end, f.help) - 1

				elseif f.kind == "color" then
					n = colorRow(body, n, f.label, w[key],
						function(v) w[key] = v ; screen(false) end, f.help) - 1

				elseif f.kind == "sky" or f.kind == "music" or f.kind == "tool" then
					local list, empty, intro
					if f.kind == "sky" then
						list  = skyChoices()
						empty = "Keep the current sky"
						intro = (#list <= 1) and ("Your sky folder is empty. Create a folder "
							.. "called \"" .. CFG.SKY_FOLDER .. "\" in ReplicatedStorage and "
							.. "drop Sky objects into it - they show up here instantly.") or nil
					elseif f.kind == "music" then
						list  = musicChoices()
						empty = "No music"
						intro = (#list <= 1) and ("No music found. Create a folder called \""
							.. CFG.MUSIC_FOLDER .. "\" in ReplicatedStorage and put Sound "
							.. "objects inside.") or nil
					else
						list  = toolChoices()
						empty = "No item"
						intro = (#list <= 1) and ("No item found. Create a folder called \""
							.. CFG.TOOLS_FOLDER .. "\" in ServerStorage and put your Tools "
							.. "inside (magic carpet, jetpack, coils, guns...).") or nil
					end
					local shown = (w[key] == "" or w[key] == nil) and empty or w[key]
					choiceRow(body, n, f.label, shown, function()
						openPick(string.upper(f.label), list, w[key],
							function(v) w[key] = v end, intro)
					end, f.help)
					n = n + 2

				elseif f.kind == "asset" then
					n = textRow(body, n, f.label, tostring(w[key] or 0), 20,
						function(v) w[key] = tonumber(v:match("%d+")) or 0 end,
						f.help, "0") - 1

				else -- choice
					choiceRow(body, n, f.label, labelOf(f.choices, w[key], "?"), function()
						openPick(string.upper(f.label), f.choices, w[key],
							function(v) w[key] = v end, f.help)
					end, f.help)
					n = n + 2
				end
			end
			n = n + 1 ; spacer(body, n, 8)
		end

		n = n + 1
		big(body, n, S.editNew and "CREATE THIS EVENT" or "SAVE CHANGES", OK_C, OK_D, function()
			--  On efface la note auto pour qu'elle soit réécrite d'après les
			--  nouveaux choix : sinon un ancien résumé survivrait à une
			--  modification et dirait le contraire de la réalité.
			local before = findEvent(S.editId)
			if before and before.desc == w.desc then w.desc = "" end
			srvAct("saveWeather", w, function(ok)
				if ok then S.loaded = false ; S.view = nil ; S.edit = nil end
			end)
		end)

		if not S.editNew and S.editId and S.custom[S.editId] then
			n = n + 1
			local a = armed("delW")
			big(body, n, a and "PRESS AGAIN TO DELETE" or "Delete this event",
				a and C.RED or C.BG_LIGHT, a and C.RED_DARK or C.BORDER_BRIGHT, function()
					if not a then arm("delW") ; screen(false) return end
					disarm()
					srvAct("deleteWeather", { id = S.editId }, function(ok)
						if ok then S.loaded = false ; S.view = nil ; S.edit = nil end
					end)
				end)
		end
	end

	------------------------------------------------------------------
	-- 🎬 ÉCRAN « MON PLANNING »
	--    Le rythme compte plus que le contenu : monter, culminer,
	--    redescendre. Le total est affiché en permanence.
	------------------------------------------------------------------
	local function renderPlan(body)
		big(body, -3, "\u{2039}  BACK", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			S.view = nil ; disarm() ; screen(false)
		end, IS_MOBILE and 36 or 40)

		head(body, -2, "MY SCHEDULE")
		note(body, -1, string.format(
			"%d step(s), %s in total. Steps play top to bottom. Put \"Cool Down\" last "
				.. "so the world eases back instead of snapping.",
			#S.steps, mmss(stepsTotal())),
			#S.steps > 0 and OK_C or C.TEXT_GREY)

		local n = 0
		for i, w in ipairs(S.steps) do
			n = n + 1
			card(body, n, {
				icon = CFG and CFG.Icon(w.icon) or nil,
				title = i .. ".  " .. tostring(w.name),
				sub = tostring(w.desc or ""),
				right = mmss(w.duration),
			})
			n = n + 1
			row2(body, n,
				{ text = "\u{2191} Up", col = C.BG_LIGHT, colD = C.BORDER_BRIGHT, fn = function()
					if i > 1 then
						S.steps[i], S.steps[i - 1] = S.steps[i - 1], S.steps[i]
						screen(false)
					end
				end },
				{ text = "Remove", col = C.BG_LIGHT, colD = C.RED_DARK, fn = function()
					table.remove(S.steps, i) ; screen(false)
				end })
		end

		n = n + 1 ; spacer(body, n, 6)
		n = n + 1
		big(body, n, "+  ADD A STEP", AA, AA_D, function()
			local list = {}
			for _, w in ipairs(allEvents()) do
				list[#list + 1] = { id = w.id,
					label = w.name .. "  (" .. mmss(w.duration) .. ")", desc = w.desc }
			end
			openPick("ADD A STEP", list, nil, function(id)
				local w = findEvent(id)
				if w then
					--  Copie : changer la durée d'une étape ne doit pas
					--  modifier l'événement d'origine.
					local c = {}
					for k, v in pairs(w) do c[k] = v end
					S.steps[#S.steps + 1] = c
				end
			end, "Tap an event to add it at the end of the schedule.")
		end)

		if #S.steps > 0 then
			n = n + 1
			n = textRow(body, n, "Title", S.planTitle, 28,
				function(v) S.planTitle = v end,
				"Shown on every player's screen while the event runs.", "ADMIN ABUSE")

			n = n + 1
			local a = armed("start")
			big(body, n, a and "PRESS AGAIN TO GO LIVE" or "\u{25B6}  START THIS EVENT NOW",
				a and OK_C or AA, a and OK_D or AA_D, function()
					if not a then arm("start") ; screen(false) return end
					disarm()
					srvAct("start", { title = S.planTitle, steps = S.steps }, function(ok)
						if ok then S.view = nil ; S.tab = "start" ; S.stats = nil end
					end)
				end, IS_MOBILE and 50 or 58)
			if a then
				n = n + 1
				note(body, n, "This starts on EVERY server, for EVERY player, right now.",
					C.ORANGE)
			end

			n = n + 1
			n = textRow(body, n, "Save as", S.saveName or "", 28,
				function(v) S.saveName = v end,
				"Give it a name to reuse it later in one click.", "My party")
			n = n + 1
			big(body, n, "Save this schedule", C.BG_LIGHT, C.BORDER_BRIGHT, function()
				if (S.saveName or "") == "" then toast("Give it a name first", false) return end
				srvAct("savePlan", { name = S.saveName, steps = S.steps }, function(ok)
					if ok then S.loaded = false end
				end)
			end)
		end
	end

	------------------------------------------------------------------
	-- ▶️ ONGLET « START »
	------------------------------------------------------------------
	local function renderStart(body)
		local run = S.run
		local live = run and run.on

		if live then
			local w = run.w or {}
			note(body, 1, string.format(
				"LIVE RIGHT NOW  -  %s\nStep %s/%s: %s\nEnds in %s.",
				tostring(run.title or "?"), tostring(run.idx or "?"), tostring(run.n or "?"),
				tostring(w.name or "?"),
				mmss(math.max(0, (tonumber(run.runEnd) or os.time()) - os.time()))), OK_C)

			--══════════════════════════════════════════════════════════
			--  💰 LE CHIFFRE QUE TU M'AS DEMANDÉ
			--
			--     Combien de points cet événement a AJOUTÉ à l'économie,
			--     tous serveurs confondus. C'est ce nombre qui te dit
			--     quand arrêter, donc il est affiché en grand, en haut,
			--     et il se recharge tout seul à l'ouverture de l'onglet.
			--══════════════════════════════════════════════════════════
			if not S.stats and not S.statsLoading then
				S.statsLoading = true
				srvGet("stats", function(res, err)
					S.statsLoading = false
					if res then S.stats = res.stats ; S.run = res.run or S.run end
					if currentScreen == "adminabuse" and window.Visible then screen(false) end
				end)
			end

			if S.stats then
				local total = tonumber(S.stats.pointsTotal) or 0
				local who   = tonumber(S.stats.pointsPlayers) or 0
				local cap   = (S.sched and S.sched.sc_capOn) and tonumber(S.sched.sc_cap) or nil
				local scope = (tostring(S.stats.scope) == "global")
					and ("all " .. tostring(S.stats.serversSeen or 1) .. " servers")
					or "THIS server only"
				note(body, 2, string.format(
					"EXTRA POINTS GIVEN BY THIS EVENT:  %s\n"
						.. "Across %s, to %d player(s).%s",
					comma(total), scope, who,
					cap and ("\nEach player can gain at most " .. comma(cap)
						.. " from one event.") or
						"\nNo cap is set - one player can gain a lot. See Gifts > Limits."),
					total > 0 and AA or C.TEXT_GREY)
				big(body, 3, "Refresh that number", C.BG_LIGHT, C.BORDER_BRIGHT, function()
					S.stats = nil ; screen(false)
				end, IS_MOBILE and 32 or 36)
			else
				note(body, 2, "Reading how many points this event has handed out...",
					C.TEXT_GREY)
			end

			local a = armed("stop")
			big(body, 4, a and "PRESS AGAIN TO STOP EVERYTHING" or "\u{25A0}  STOP THE EVENT",
				a and C.RED or C.BG_LIGHT, a and C.RED_DARK or C.BORDER_BRIGHT, function()
					if not a then arm("stop") ; screen(false) return end
					disarm()
					srvAct("stop", nil, function() S.stats = nil end)
				end, IS_MOBILE and 48 or 54)
			note(body, 5, "Stopping removes every boost, every speed change and every "
				.. "loaned item, on every server, immediately. Points already given stay "
				.. "- they are real points.", C.TEXT_DIM)
			spacer(body, 6, 10)
			head(body, 7, "REPLACE IT WITH SOMETHING ELSE")
		else
			note(body, 1, "No event is running. Pick a ready-made party below and it "
				.. "starts on every server, for every player.", C.TEXT_GREY)
			head(body, 7, "READY-MADE PARTIES  -  ONE CLICK")
		end

		local n = 7
		for _, p in ipairs((CFG and CFG.PRESET_PLANS) or {}) do
			n = n + 1
			local total, steps = 0, {}
			for _, id in ipairs(p.steps) do
				local w = CFG.Builtin(id)
				if w then
					steps[#steps + 1] = w
					total = total + (tonumber(w.duration) or 0)
				end
			end
			local key = "preset_" .. p.id
			local a = armed(key)
			card(body, n, {
				icon = CFG.Icon("gift"),
				title = a and ("TAP AGAIN TO START  \u{2192}  " .. p.name) or p.name,
				sub = a and ("Starts now on every server. " .. #steps .. " steps, "
					.. mmss(total) .. ".")
					or (p.desc .. "  (" .. #steps .. " steps, " .. mmss(total) .. ")"),
				right = a and "GO" or mmss(total),
				rightColor = a and OK_C or AA,
				color = a and OK_C or AA, selected = a,
				height = IS_MOBILE and 66 or 76,
				onClick = function()
					if not a then arm(key) ; screen(false) return end
					disarm()
					srvAct("start", { title = p.name, steps = steps },
					function() S.stats = nil end)
				end,
			})
		end

		n = n + 1 ; spacer(body, n, 10)
		n = n + 1 ; head(body, n, "BUILD MY OWN")
		n = n + 1
		big(body, n, "\u{270E}  BUILD A SCHEDULE STEP BY STEP", C.BG_LIGHT, AA_D, function()
			S.view = "plan" ; disarm() ; screen(false)
		end)

		if #(S.plans or {}) > 0 then
			n = n + 1 ; head(body, n, "MY SAVED SCHEDULES")
			for _, pl in ipairs(S.plans) do
				n = n + 1
				local t = 0
				for _, st in ipairs(pl.steps or {}) do t = t + (tonumber(st.duration) or 0) end
				card(body, n, {
					title = pl.name, sub = #(pl.steps or {}) .. " steps, " .. mmss(t),
					right = "OPEN",
					onClick = function()
						S.steps = {}
						for _, st in ipairs(pl.steps or {}) do
							local c = {}
							for k, v in pairs(st) do c[k] = v end
							S.steps[#S.steps + 1] = c
						end
						S.planTitle = pl.name ; S.saveName = pl.name
						S.view = "plan" ; disarm() ; screen(false)
					end,
				})
				n = n + 1
				local a = armed("delp_" .. pl.name)
				big(body, n, a and ("PRESS AGAIN TO DELETE \"" .. pl.name .. "\"")
					or ("Delete \"" .. pl.name .. "\""),
					a and C.RED or C.BG_LIGHT, a and C.RED_DARK or C.BORDER_BRIGHT,
					function()
						if not a then arm("delp_" .. pl.name) ; screen(false) return end
						disarm()
						srvAct("deletePlan", { name = pl.name }, function(ok)
							if ok then S.loaded = false end
						end)
					end, IS_MOBILE and 32 or 36)
			end
		end
	end

	------------------------------------------------------------------
	-- 🌦️ ONGLET « EVENTS »
	------------------------------------------------------------------
	local function renderEvents(body)
		if not CFG then note(body, 1, "AdminAbuse_Config not found.", C.RED) return end

		note(body, 1, "These are the building blocks. An event is ONE sky, ONE effect and "
			.. "ONE set of rewards - a schedule plays several of them in a row.",
			C.TEXT_GREY)

		big(body, 2, "+  CREATE A NEW EVENT", AA, AA_D, function()
			S.edit = CFG.SimpleDefaults()
			S.edit.name = "My Event"
			S.editId = nil ; S.editNew = true
			S.view = "edit" ; disarm() ; screen(false)
		end)

		local function open(w, asCopy)
			--  On repart des CHOIX de l'événement, pas de son rendu : une
			--  copie d'un événement prêt devient un événement à toi, tout de
			--  suite modifiable.
			local e = CFG.SimpleDefaults()
			for _, k in ipairs(CFG.SIMPLE_KEYS) do
				if w[k] ~= nil then
					if type(w[k]) == "table" then e[k] = { w[k][1], w[k][2], w[k][3] }
					else e[k] = w[k] end
				end
			end
			if asCopy then
				e.name = string.sub(tostring(w.name) .. " copy", 1, 28)
				S.editId, S.editNew = nil, true
			else
				e.id = w.id
				S.editId, S.editNew = w.id, false
			end
			S.edit = e ; S.view = "edit" ; disarm() ; screen(false)
		end

		local n = 3
		head(body, n, "MY EVENTS")
		local any = false
		for _, w in pairs(S.custom or {}) do
			any = true ; n = n + 1
			card(body, n, {
				icon = CFG.Icon(w.icon), title = w.name, sub = w.desc,
				right = mmss(w.duration), height = IS_MOBILE and 62 or 72,
				onClick = function() open(w, false) end,
			})
		end
		if not any then
			n = n + 1
			note(body, n, "None yet. Create one above, or copy a ready-made one below - "
				.. "copying is the easiest way to start.", C.TEXT_DIM)
		end

		n = n + 1 ; spacer(body, n, 10)
		n = n + 1 ; head(body, n, "READY-MADE EVENTS  (tap to copy and tweak)")
		for _, id in ipairs(CFG.BUILTIN_ORDER) do
			local w = CFG.Builtin(id)
			if w then
				n = n + 1
				card(body, n, {
					icon = CFG.Icon(w.icon), title = w.name, sub = w.desc,
					right = mmss(w.duration), height = IS_MOBILE and 62 or 72,
					onClick = function() open(w, true) end,
				})
			end
		end
	end

	------------------------------------------------------------------
	-- 🎁 ONGLET « GIFTS »
	------------------------------------------------------------------
	local function renderGifts(body)
		if not CFG then note(body, 1, "AdminAbuse_Config not found.", C.RED) return end

		head(body, 1, "SEND SOMETHING RIGHT NOW")
		note(body, 2, "Goes to every player online on every server, at the same second. "
			.. "Only players already connected when you press get it - so nobody can "
			.. "hop servers to receive it twice.", C.TEXT_GREY)

		local n = 2
		for _, g in ipairs(CFG.GIFT_PRESETS) do
			n = n + 1
			local key = "gp_" .. g.id
			local a = armed(key)
			card(body, n, {
				icon = CFG.Icon(g.kind == "points" and "points" or "boost10"),
				title = a and ("TAP AGAIN TO SEND  \u{2192}  " .. g.label) or g.label,
				sub = a and "Everyone online gets it immediately." or nil,
				right = a and "GO" or "SEND",
				rightColor = a and OK_C or AA,
				selected = a, color = a and OK_C or AA,
				height = IS_MOBILE and 46 or 54,
				onClick = function()
					if not a then arm(key) ; screen(false) return end
					disarm()
					srvAct("gift", {
						kind = g.kind, amount = g.amount, dur = g.dur or 1800,
						keep = g.keep == true, popup = true, note = "", tool = "",
					})
				end,
			})
		end

		n = n + 1 ; spacer(body, n, 6)
		n = n + 1
		big(body, n, "Send an item instead (jetpack, carpet, gun...)", C.BG_LIGHT, AA_D,
			function()
				openPick("SEND AN ITEM", toolChoices(), "", function(id)
					if id == "" then return end
					srvAct("gift", { kind = "tool", tool = id, amount = 0, dur = 1800,
						popup = true, note = "" })
				end, "Everyone online gets it for 30 minutes, then it is taken back "
					.. "automatically. Nobody can keep it.")
			end)

		--══════════════════════════════════════════════════════════════
		--  💰 LE PLAFOND DE POINTS
		--══════════════════════════════════════════════════════════════
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "LIMITS  -  HOW MUCH ONE PLAYER CAN GAIN")
		n = n + 1
		note(body, n, "Without a cap, a one-hour event with Point rain can hand a single "
			.. "player hundreds of thousands of points, and your UGC economy does not "
			.. "recover from that. When a player reaches the cap they simply stop "
			.. "receiving points - everything else keeps working and they never see an "
			.. "error.", C.TEXT_GREY)

		--  Le plafond vit dans le même enregistrement que les cadeaux
		--  automatiques (section « limits » du schéma) : c'est ce qui évite
		--  d'ajouter un deuxième chemin de sauvegarde côté serveur.
		local sc = S.sched
		for _, sec in ipairs(CFG.SCHED_SCHEMA) do
			if sec.id == "limits" then
				for _, f in ipairs(sec.fields) do
					n = n + 1
					if f.kind == "bool" then
						n = toggleRow(body, n, f.label, sc[f.key] == true,
							function(v) sc[f.key] = v ; screen(false) end, f.help) - 1
					else
						local quick = { { label = "5k", v = 5000 }, { label = "25k", v = 25000 },
							{ label = "50k", v = 50000 }, { label = "100k", v = 100000 },
							{ label = "250k", v = 250000 } }
						n = numberRow(body, n, f.label, sc[f.key], f.min, f.max, f.step,
							function(v) sc[f.key] = v ; screen(false) end, f.help,
							function(v) return comma(v) end, quick) - 1
					end
				end
			end
		end

		--══════════════════════════════════════════════════════════════
		--  ⏲️ CADEAUX AUTOMATIQUES
		--══════════════════════════════════════════════════════════════
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "AUTOMATIC GIFTS  (on a timer, forever)")

		local liveSc = S.run and S.run.sc
		local at     = S.run and tonumber(S.run.giftAt) or 0
		n = n + 1
		if liveSc and liveSc.on and at > 0 then
			note(body, n, string.format(
				"RUNNING  -  next gift in %s (+%s points to everyone online).",
				mmss(math.max(0, at - os.time())), comma(liveSc.amount or 0)), OK_C)
		else
			note(body, n, "Off. Turn it on below and every player sees the same "
				.. "countdown on their screen.", C.TEXT_GREY)
		end

		for _, sec in ipairs(CFG.SCHED_SCHEMA) do
			if sec.id ~= "limits" then
				for _, f in ipairs(sec.fields) do
					n = n + 1
					if f.kind == "bool" then
						n = toggleRow(body, n, f.label, sc[f.key] == true,
							function(v) sc[f.key] = v ; screen(false) end, f.help) - 1
					elseif f.kind == "num" then
						local quick = nil
						if f.key == "sc_every" then
							quick = { { label = "5 min", v = 300 }, { label = "15 min", v = 900 },
								{ label = "30 min", v = 1800 }, { label = "1 h", v = 3600 } }
						elseif f.key == "sc_amount" then
							quick = { { label = "250", v = 250 }, { label = "500", v = 500 },
								{ label = "1k", v = 1000 }, { label = "5k", v = 5000 } }
						end
						n = numberRow(body, n, f.label, sc[f.key], f.min, f.max, f.step,
							function(v) sc[f.key] = v ; screen(false) end, f.help,
							f.key == "sc_every" and mmss or nil, quick) - 1
					elseif f.kind == "choice" then
						choiceRow(body, n, f.label, labelOf(f.choices, sc[f.key], "?"), function()
							openPick("GIFT MESSAGE", f.choices, sc[f.key],
								function(v) sc[f.key] = v end,
								"\"Surprise me\" picks a different line every time, so it "
									.. "never sounds like a robot.")
						end, f.help)
						n = n + 2
					elseif f.kind == "text" then
						--  Le champ perso ne s'affiche QUE s'il sert : un champ
						--  grisé qu'on ne peut pas utiliser est du bruit.
						if sc.sc_msgId == "custom" then
							n = textRow(body, n, f.label, sc[f.key], f.maxLen,
								function(v) sc[f.key] = v end, f.help, "Say something nice") - 1
						else
							n = n - 1
						end
					end
				end
			end
		end

		--  UN SEUL bouton pour les deux blocs : le plafond et les cadeaux
		--  automatiques sont enregistrés ensemble, parce qu'ils vivent dans
		--  le même enregistrement. Deux boutons laisseraient croire qu'on
		--  peut sauvegarder l'un sans l'autre.
		n = n + 1
		big(body, n, "SAVE THE LIMIT AND THE AUTOMATIC GIFTS", AA, AA_D, function()
			srvAct("schedConfig", { sched = sc }, function(ok)
				if ok then S.loaded = false end
			end)
		end)
	end

	--══════════════════════════════════════════════════════════════════
	--
	-- 🖥️ ONGLET « LOOK » — LE PLACEMENT DES BARRES
	--
	--   🐛 POURQUOI IL N'Y A PLUS DE GLISSER-DÉPOSER
	--
	--      Le drag d'UI dépend de trop de choses qui peuvent l'avaler : quel
	--      élément capte l'entrée, le défilement tactile qui prend la main,
	--      le décalage de la barre Roblox selon IgnoreGuiInset, et le drag
	--      de la fenêtre du panel lui-même. Chez toi, quelque chose le
	--      mangeait — et je ne peux pas le déboguer à l'aveugle.
	--
	--      Un bouton, lui, ne peut pas « ne rien faire ». Donc : 9 ancrages
	--      (les coins, les bords, le centre) pour arriver au bon endroit en
	--      un clic, et quatre flèches pour ajuster. C'est aussi bien plus
	--      simple au doigt : pas besoin de viser une petite pastille.
	--
	--      Le rectangle reste, mais comme APERÇU : il montre où tombent les
	--      trois barres. Et « Show the live bars » les affiche pour de vrai
	--      sur ton écran pendant que tu règles.
	--
	--══════════════════════════════════════════════════════════════════
	local PLACE_TARGETS = {
		{ id = "gf", label = "Next gift bar", col = Color3.fromRGB(255, 205, 70) },
		{ id = "ev", label = "Event bar",     col = Color3.fromRGB(120, 235, 255) },
		{ id = "mc", label = "Message",       col = AA },
	}

	local function placeGet(id)
		if id == "gf" then return tonumber(S.hud.gf_x) or 0.5, tonumber(S.hud.gf_y) or 0.02 end
		if id == "ev" then return tonumber(S.hud.ev_x) or 0.5, tonumber(S.hud.ev_y) or 0.09 end
		return tonumber(S.mc.posX) or 0.5, tonumber(S.mc.posY) or 0.03
	end

	local function placeSet(id, x, y)
		x = math.clamp(x, 0, 1) ; y = math.clamp(y, 0, 1)
		--  On arrondit au millième : sinon on accumule des 0.30000000004 qui
		--  ne veulent rien dire et rendent l'affichage illisible.
		x = math.floor(x * 1000 + 0.5) / 1000
		y = math.floor(y * 1000 + 0.5) / 1000
		if id == "gf" then S.hud.gf_x, S.hud.gf_y = x, y
		elseif id == "ev" then S.hud.ev_x, S.hud.ev_y = x, y
		else S.mc.posX, S.mc.posY = x, y end
		--  L'aperçu à l'écran suit en direct, si tu l'as allumé.
		if S.hudPreview and _G.AdminAbusePreviewHud then
			pcall(_G.AdminAbusePreviewHud, true, S.hud)
		end
	end

	local function renderLook(body)
		if not CFG then note(body, 1, "AdminAbuse_Config not found.", C.RED) return end

		head(body, 1, "SAY SOMETHING TO EVERYONE")
		note(body, 2, "Your profile picture shows on the left of the bar, so players know "
			.. "straight away it is you talking. The text goes through the Roblox filter "
			.. "first - if the filter is down, nothing is sent at all.", C.TEXT_GREY)

		local n = 3
		n = textRow(body, n, "Message", S.msg.text, CFG.LIMITS.MESSAGE_LEN_MAX,
			function(v) S.msg.text = v end, nil, "Type your message here")
		n = toggleRow(body, n, "Rainbow text", S.msg.rainbow == true,
			function(v) S.msg.rainbow = v ; screen(false) end,
			"A rainbow gradient that slides across the letters only - it never colours "
				.. "the bar itself.")

		row2(body, n, {
			text = "Preview (only me)", col = C.BG_LIGHT, colD = AA_D, fn = function()
				srvAct("preview", { mc = S.mc, text = S.msg.text })
			end },
		{ text = armed("bc") and "AGAIN TO SEND" or "Broadcast",
			col = armed("bc") and OK_C or AA, colD = armed("bc") and OK_D or AA_D,
			fn = function()
				if S.msg.text == "" then toast("Write a message first", false) return end
				if not armed("bc") then arm("bc") ; screen(false) return end
				disarm()
				srvAct("message", { text = S.msg.text, rainbow = S.msg.rainbow })
			end })
		n = n + 1

		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "WHERE THE BARS SIT ON SCREEN")
		n = n + 1
		note(body, n, "Pick a bar, then tap an anchor to send it there, or use the arrows "
			.. "to nudge it. Positions are saved as fractions of the screen, so they land "
			.. "in the same relative place on a phone and on a 27-inch monitor - and they "
			.. "can never fall off the edge.", C.TEXT_GREY)

		--── 1. Quelle barre ? ──
		n = n + 1
		local sel = {}
		for _, t in ipairs(PLACE_TARGETS) do
			sel[#sel + 1] = { text = t.label, sel = (S.place == t.id),
				fn = function() S.place = t.id ; screen(false) end,
				textSize = IS_MOBILE and 10 or 12 }
		end
		btnGrid(body, n, sel, IS_MOBILE and 32 or 38)

		--── 2. L'aperçu ──
		n = n + 1
		local prev = Instance.new("Frame")
		prev.Size = UDim2.new(1, 0, 0, IS_MOBILE and 150 or 200)
		prev.BackgroundColor3 = Color3.fromRGB(26, 32, 44)
		prev.BorderSizePixel = 0
		prev.ClipsDescendants = true
		prev.LayoutOrder = n ; prev.ZIndex = 11 ; prev.Parent = body
		corner(prev, 10) ; stroke(prev, AA_D, 1.5)

		local vline = Instance.new("Frame")
		vline.Size = UDim2.new(0, 1, 1, 0) ; vline.Position = UDim2.new(0.5, 0, 0, 0)
		vline.BackgroundColor3 = C.BORDER_SUBTLE ; vline.BackgroundTransparency = 0.55
		vline.BorderSizePixel = 0 ; vline.ZIndex = 11 ; vline.Parent = prev
		local hline = Instance.new("Frame")
		hline.Size = UDim2.new(1, 0, 0, 1) ; hline.Position = UDim2.new(0, 0, 0.5, 0)
		hline.BackgroundColor3 = C.BORDER_SUBTLE ; hline.BackgroundTransparency = 0.55
		hline.BorderSizePixel = 0 ; hline.ZIndex = 11 ; hline.Parent = prev

		for _, t in ipairs(PLACE_TARGETS) do
			local x, y = placeGet(t.id)
			local chip = Instance.new("TextLabel")
			chip.Size = UDim2.new(0, IS_MOBILE and 74 or 96, 0, IS_MOBILE and 20 or 24)
			chip.AnchorPoint = Vector2.new(math.clamp(x, 0, 1), math.clamp(y, 0, 1))
			chip.Position = UDim2.fromScale(math.clamp(x, 0, 1), math.clamp(y, 0, 1))
			chip.BackgroundColor3 = t.col
			chip.BackgroundTransparency = (S.place == t.id) and 0 or 0.55
			chip.BorderSizePixel = 0
			chip.Font = FONT ; chip.Text = t.label
			chip.TextColor3 = C.BG_BLACK
			chip.TextSize = IS_MOBILE and 8.5 or 10.5
			chip.TextTruncate = Enum.TextTruncate.AtEnd
			chip.ZIndex = (S.place == t.id) and 15 or 13
			chip.Parent = prev
			corner(chip, 6)
			if S.place == t.id then stroke(chip, C.TEXT_WHITE, 2) end
		end

		--── 3. Les 9 ancrages ──
		local cx, cy = placeGet(S.place)
		local function anchorRow(order, yy, labels)
			local items = {}
			for _, a in ipairs(labels) do
				items[#items + 1] = { text = a.t,
					sel = (math.abs(cx - a.x) < 0.001 and math.abs(cy - yy) < 0.001),
					fn = function() placeSet(S.place, a.x, yy) ; screen(false) end,
					textSize = IS_MOBILE and 13 or 16 }
			end
			btnGrid(body, order, items, IS_MOBILE and 30 or 34)
		end
		n = n + 1 ; head(body, n, "SEND IT TO...")
		n = n + 1 ; anchorRow(n, 0.02, { { t = "\u{2196}", x = 0.02 }, { t = "\u{2191}", x = 0.5 }, { t = "\u{2197}", x = 0.98 } })
		n = n + 1 ; anchorRow(n, 0.50, { { t = "\u{2190}", x = 0.02 }, { t = "\u{2022}", x = 0.5 }, { t = "\u{2192}", x = 0.98 } })
		n = n + 1 ; anchorRow(n, 0.98, { { t = "\u{2199}", x = 0.02 }, { t = "\u{2193}", x = 0.5 }, { t = "\u{2198}", x = 0.98 } })

		--── 4. Le réglage fin ──
		n = n + 1 ; head(body, n, "NUDGE IT")
		n = n + 1
		btnGrid(body, n, {
			{ text = "Fine",  sel = (S.placeStep == 0.005), fn = function() S.placeStep = 0.005 ; screen(false) end },
			{ text = "Small", sel = (S.placeStep == 0.02),  fn = function() S.placeStep = 0.02 ; screen(false) end },
			{ text = "Big",   sel = (S.placeStep == 0.05),  fn = function() S.placeStep = 0.05 ; screen(false) end },
		}, IS_MOBILE and 28 or 32)
		n = n + 1
		local st = S.placeStep
		btnGrid(body, n, {
			{ text = "\u{2190}", fn = function() placeSet(S.place, cx - st, cy) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
			{ text = "\u{2191}", fn = function() placeSet(S.place, cx, cy - st) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
			{ text = "\u{2193}", fn = function() placeSet(S.place, cx, cy + st) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
			{ text = "\u{2192}", fn = function() placeSet(S.place, cx + st, cy) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
		}, IS_MOBILE and 34 or 40)

		n = n + 1
		note(body, n, string.format("%s  -  x %.3f   y %.3f\n(0 = edge, 0.5 = middle, 1 = "
			.. "the other edge)", labelOf(PLACE_TARGETS, S.place, "?"), cx, cy), C.TEXT_DIM)

		n = n + 1
		row2(body, n,
			{ text = "Reset all three", col = C.BG_LIGHT, colD = C.BORDER_BRIGHT, fn = function()
				S.hud.gf_x, S.hud.gf_y = 0.5, 0.02
				S.hud.ev_x, S.hud.ev_y = 0.5, 0.09
				S.mc.posX,  S.mc.posY  = 0.5, 0.03
				if S.hudPreview and _G.AdminAbusePreviewHud then
					pcall(_G.AdminAbusePreviewHud, true, S.hud)
				end
				screen(false)
			end },
			{ text = S.hudPreview and "Hide the live bars" or "Show the live bars",
				col = S.hudPreview and OK_C or C.BG_LIGHT,
				colD = S.hudPreview and OK_D or AA_D, fn = function()
					S.hudPreview = not S.hudPreview
					if _G.AdminAbusePreviewHud then
						pcall(_G.AdminAbusePreviewHud, S.hudPreview, S.hud)
					end
					screen(false)
				end })
		n = n + 1

		n = n + 1
		big(body, n, "SAVE THE POSITIONS", AA, AA_D, function()
			--  Deux enregistrements : les barres (hud) et la bannière (mc). On
			--  enchaîne, parce que le serveur n'accepte qu'une action à la
			--  fois — c'est ce qui empêche deux admins de s'écraser.
			srvAct("hudConfig", { hud = S.hud }, function(ok)
				if not ok then return end
				task.delay(0.25, function()
					srvAct("msgConfig", { mc = S.mc }, function(ok2)
						if ok2 then S.loaded = false end
					end)
				end)
			end)
		end)

		--── 5. Le style des barres ──
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "HOW THE BARS LOOK")
		n = n + 1
		note(body, n, "There is NO box behind the bars - just the icon, the text, the "
			.. "countdown, and a soft horizontal glow that is wide in the middle and "
			.. "fades out at both ends.", C.TEXT_DIM)

		for _, sec in ipairs(CFG.HUD_SCHEMA) do
			n = n + 1 ; head(body, n, sec.title)
			for _, f in ipairs(sec.fields) do
				n = n + 1
				local v = S.hud[f.key]
				if f.kind == "bool" then
					n = toggleRow(body, n, f.label, v == true,
						function(nv) S.hud[f.key] = nv ; screen(false) end, f.help) - 1
				elseif f.kind == "num" then
					--  Les positions ont leur propre écran plus haut : les
					--  répéter ici en − / + serait deux façons de faire la
					--  même chose, donc deux façons de se tromper.
					if f.key:match("_x$") or f.key:match("_y$") then
						n = n - 1
					else
						n = numberRow(body, n, f.label, v, f.min, f.max, f.step,
							function(nv) S.hud[f.key] = nv ; screen(false) end, f.help) - 1
					end
				elseif f.kind == "color" then
					n = colorRow(body, n, f.label, v,
						function(nv) S.hud[f.key] = nv ; screen(false) end, f.help) - 1
				elseif f.kind == "choice" then
					choiceRow(body, n, f.label, labelOf(f.choices, v, "?"), function()
						openPick(string.upper(f.label), f.choices, v,
							function(nv) S.hud[f.key] = nv end, f.help)
					end, f.help)
					n = n + 2
				else
					n = textRow(body, n, f.label, v, f.maxLen or 40,
						function(nv) S.hud[f.key] = nv end, f.help) - 1
				end
			end
		end

		n = n + 1
		big(body, n, "SAVE THE BAR STYLE", AA, AA_D, function()
			srvAct("hudConfig", { hud = S.hud }, function(ok)
				if ok then S.loaded = false end
			end)
		end)

		--── 6. Les statistiques ──
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "STATISTICS")
		n = n + 1
		big(body, n, "Read the counters", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			S.stats = nil
			srvGet("stats", function(res, err)
				if res then S.stats = res.stats ; S.run = res.run or S.run
				else toast(tostring(err), false) end
				if currentScreen == "adminabuse" and window.Visible then screen(false) end
			end)
		end)
		if S.stats then
			n = n + 1
			note(body, n, (tostring(S.stats.scope) == "global")
				and ("Total across " .. tostring(S.stats.serversSeen or 1) .. " server(s).")
				or "THIS server only - the shared store did not answer. Better an honest "
				.. "number than a fake total.",
				(tostring(S.stats.scope) == "global") and OK_C or C.ORANGE)
			for _, s in ipairs(CFG.STAT_LABELS) do
				local val = tonumber(S.stats[s.key])
				if val and val > 0 then
					n = n + 1
					card(body, n, { title = s.label, right = comma(val),
						height = IS_MOBILE and 32 or 36 })
				end
			end
		end
	end

	------------------------------------------------------------------
	-- 🗂️ BARRE D'ONGLETS
	------------------------------------------------------------------
	local TABS = {
		{ id = "start",  label = "Start" },
		{ id = "events", label = "Events" },
		{ id = "gifts",  label = "Gifts" },
		{ id = "look",   label = "Look" },
	}

	local function tabBar(parent, order)
		local items = {}
		for _, t in ipairs(TABS) do
			items[#items + 1] = { text = t.label, sel = (S.tab == t.id), fn = function()
				S.tab = t.id ; S.view = nil ; disarm()
				--  On coupe l'aperçu en quittant l'onglet Look : sinon une
				--  fausse barre resterait collée sur ton écran, et rien
				--  n'irait plus jamais l'éteindre.
				if t.id ~= "look" then
					S.hudPreview = false
					if _G.AdminAbusePreviewHud then pcall(_G.AdminAbusePreviewHud, false) end
				end
				screen(false)
			end }
		end
		return btnGrid(parent, order, items, IS_MOBILE and 36 or 42)
	end

	------------------------------------------------------------------
	-- 🖥️ ÉCRAN
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "adminabuse"
		if reset then
			S.tab = "start" ; S.view = nil
			S.loaded, S.loading, S.failed, S.failMsg = false, false, false, nil
			S.edit, S.editId, S.pick, S.stats = nil, nil, nil, nil
			S.statsLoading = false
			disarm()
			S.hudPreview = false
			if _G.AdminAbusePreviewHud then pcall(_G.AdminAbusePreviewHud, false) end
		end

		local body = buildScreen("ADMIN ABUSE", true, AA, nil, function()
			S.loaded, S.stats = false, nil
			screen(false)
		end)

		if not remote("AdminAbuseGet") then
			note(body, 1, "The server does not have the ADMIN ABUSE system.\n\n"
				.. "Put AdminAbuse_Server in ServerScriptService and AdminAbuse_Config "
				.. "in ReplicatedStorage, then restart the server.", C.RED)
			return
		end

		--  Les sous-écrans occupent toute la place : pas d'onglets, pas de
		--  bruit. Une tâche à la fois.
		if S.view == "pick" then renderPick(body) return end

		if not S.loaded and not S.loading then
			S.loading = true
			srvGet("panel", function(res, err)
				S.loading = false
				if res then
					S.loaded = true ; S.failed = false
					S.run    = res.run
					S.custom = res.weathers or {}
					S.plans  = res.plans or {}
					S.tools  = res.tools or {}
					if CFG then
						if type(res.mc) == "table" then S.mc = CFG.ValidateMessageConfig(res.mc) end
						if type(res.hud) == "table" then S.hud = CFG.ValidateHud(res.hud) end
						if type(res.sched) == "table" then S.sched = CFG.ValidateSched(res.sched) end
					end
				else
					S.failed = true ; S.failMsg = tostring(err)
				end
				if currentScreen == "adminabuse" and window.Visible then screen(false) end
			end)
		end

		if not S.loaded then
			note(body, 1, S.failed
				and ("Could not read.\n\n" .. (S.failMsg or "")
					.. "\n\nPress the refresh button at the top to try again.")
				or "Loading...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		if S.view == "edit" then renderEdit(body) return end
		if S.view == "plan" then renderPlan(body) return end

		tabBar(body, -5)
		if S.tab == "events" then renderEvents(body)
		elseif S.tab == "gifts" then renderGifts(body)
		elseif S.tab == "look" then renderLook(body)
		else renderStart(body) end
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "adminabuse", name = "Admin Abuse", color = AA })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "adminabuse" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end

	print("✅ Bloc 12 chargé — 🎪 ADMIN ABUSE (v4)")
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🚫 BLOC 8 — PRIVATION D'UGC + MODES DE L'ANTI-CHEAT
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     Après le bloc 👑 VIP. Rien à supprimer.
--
--  C'est une IIFE : elle n'ajoute AUCUNE variable locale au script principal
--  (tu restes loin de la limite de 200 registres).
--
--  Ajoute une entrée « 🚫 UGC BAN » sur l'ACCUEIL, quatre onglets :
--     🚫 Restreints  — qui est privé d'UGC, pourquoi, depuis quand
--     ➕ Restreindre — chercher un joueur, voir sa fiche, puis trancher
--     📊 Détail      — les stats anti-cheat d'un joueur, et les remettre à zéro
--     ⚙️ Réglages    — LE mode (ban / privation UGC) et la case shadow
--
--  Prérequis serveur : AntiCheat_UGCRestrict.server.lua dans ServerScriptService.
--════════════════════════════════════════════════════════════════════════════
;(function()
	local RED     = Color3.fromRGB(235, 60, 65)
	local RED_D   = Color3.fromRGB(140, 25, 30)
	local ORANGE  = Color3.fromRGB(255, 170, 60)
	local ORANGE_D= Color3.fromRGB(150, 95, 20)
	local GREEN   = Color3.fromRGB(55, 195, 100)
	local GREEN_D = Color3.fromRGB(28, 122, 62)
	local CYAN    = Color3.fromRGB(110, 200, 255)

	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	task.spawn(function()
		for _, n in ipairs({ "AdminGetUGCRestrict", "AdminUGCRestrictAction" }) do
			R[n] = ReplicatedStorage:WaitForChild(n, 40)
		end
		if not R.AdminGetUGCRestrict then
			warn("[Admin] AdminGetUGCRestrict introuvable → ajoute "
				.. "AntiCheat_UGCRestrict.server.lua dans ServerScriptService")
		end
	end)

	local S = {
		data = nil, loading = false, failed = false, failMsg = nil,
		tab = "list",          -- "list" | "add" | "detail" | "cfg"
		search = "",
		query = "", note = "", found = nil, looking = false,
		detailFor = nil,       -- userId affiché dans l'onglet 📊
		draft = nil,           -- brouillon des réglages
		dirty = false,
	}

	local screen  -- forward decl

	------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	------------------------------------------------------------------
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	--  Confirmation avec compte à rebours. Priver quelqu'un d'UGC n'est pas
	--  anodin : on impose une pause pour que ça ne parte pas d'un réflexe.
	local function ask(opts)
		local wait = tonumber(opts.delay) or 3
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.45
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 50
		ov.Parent = window

		local closed = false
		local function close()
			if closed then return end
			closed = true
			ov:Destroy()
		end
		ov.MouseButton1Click:Connect(close)

		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.94, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 51
		card.Parent = ov
		corner(card, 12); stroke(card, opts.accent or RED, 1.5); padding(card, 12)

		local cl = Instance.new("UIListLayout")
		cl.Padding = UDim.new(0, 8)
		cl.SortOrder = Enum.SortOrder.LayoutOrder
		cl.Parent = card

		local t = Instance.new("Frame")
		t.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t.BackgroundTransparency = 1
		t.LayoutOrder = 1; t.ZIndex = 52; t.Parent = card
		label(t, { text = opts.title, size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = opts.accent or RED,
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 52 })

		if opts.userId then
			local ph = Instance.new("Frame")
			ph.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 52)
			ph.BackgroundColor3 = C.BG_ITEM
			ph.BackgroundTransparency = 0.3
			ph.BorderSizePixel = 0
			ph.LayoutOrder = 2; ph.ZIndex = 52; ph.Parent = card
			corner(ph, 8)
			local avS = IS_MOBILE and 34 or 40
			local av = makeAvatar(ph, opts.userId, avS, opts.accent or RED)
			av.AnchorPoint = Vector2.new(0, 0.5)
			av.Position = UDim2.new(0, 8, 0.5, 0)
			label(ph, { text = esc(opts.userName or tostring(opts.userId)),
				size = UDim2.new(1, -(avS + 24), 0, IS_MOBILE and 17 or 20),
				position = UDim2.new(0, avS + 16, 0, IS_MOBILE and 5 or 6),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
				textSize = IS_MOBILE and 13 or 15, truncate = true, zIndex = 53 })
			label(ph, { text = "🆔 " .. tostring(opts.userId),
				size = UDim2.new(1, -(avS + 24), 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, avS + 16, 0, IS_MOBILE and 23 or 27),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 53 })
		end

		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, 0, 0, 0)
		body.AutomaticSize = Enum.AutomaticSize.Y
		body.BackgroundColor3 = C.BG_ITEM
		body.BackgroundTransparency = 0.3
		body.BorderSizePixel = 0
		body.Font = FONT
		body.Text = table.concat(opts.lines or {}, "\n\n")
		body.TextColor3 = C.TEXT_WHITE
		body.TextSize = IS_MOBILE and 11 or 13
		body.TextWrapped = true
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.LayoutOrder = 3; body.ZIndex = 52; body.Parent = card
		corner(body, 8)
		local bp = Instance.new("UIPadding")
		bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 8)
		bp.PaddingLeft = UDim.new(0, 10); bp.PaddingRight = UDim.new(0, 10)
		bp.Parent = body

		if opts.warn then
			local w = Instance.new("TextLabel")
			w.Size = UDim2.new(1, 0, 0, 0)
			w.AutomaticSize = Enum.AutomaticSize.Y
			w.BackgroundTransparency = 1
			w.Font = FONT
			w.Text = opts.warn
			w.TextColor3 = opts.danger and RED or ORANGE
			w.TextSize = IS_MOBILE and 10 or 12
			w.TextWrapped = true
			w.TextXAlignment = Enum.TextXAlignment.Left
			w.LayoutOrder = 4; w.ZIndex = 52; w.Parent = card
		end

		local btns = Instance.new("Frame")
		btns.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		btns.BackgroundTransparency = 1
		btns.LayoutOrder = 5; btns.ZIndex = 52; btns.Parent = card
		local bg = Instance.new("UIGridLayout")
		bg.CellSize = UDim2.new(0.5, -5, 1, 0)
		bg.CellPadding = UDim2.new(0, 10, 0, 0)
		bg.SortOrder = Enum.SortOrder.LayoutOrder
		bg.Parent = btns

		local w1 = Instance.new("Frame")
		w1.LayoutOrder = 1; w1.BackgroundTransparency = 1; w1.ZIndex = 52; w1.Parent = btns
		local cb = actionButton(w1, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "Annuler", textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })
		cb.MouseButton1Click:Connect(close)

		local w2 = Instance.new("Frame")
		w2.LayoutOrder = 2; w2.BackgroundTransparency = 1; w2.ZIndex = 52; w2.Parent = btns
		local okBtn, okLbl = actionButton(w2, { color = C.BG_MEDIUM,
			strokeColor = C.BORDER_SUBTLE, text = "⏳",
			textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 52 })

		local armed = false
		task.spawn(function()
			for r = wait, 1, -1 do
				if closed then return end
				okLbl.Text = "⏳ Lis d'abord — " .. r .. " s"
				task.wait(1)
			end
			if closed then return end
			armed = true
			okBtn.BackgroundColor3 = opts.danger and RED or (opts.accent or GREEN)
			okLbl.Text = opts.confirmText or "✅ Confirmer"
		end)

		okBtn.MouseButton1Click:Connect(function()
			if not armed then
				toast("Prends le temps de lire — le bouton s'active tout seul", false)
				return
			end
			close()
			if opts.onConfirm then opts.onConfirm() end
		end)
	end

	local function bigBtn(parent, order, text, col, colD, fn, textCol)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 50)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b = actionButton(c, { color = col, strokeColor = colD, text = text,
			textColor = textCol, textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b
	end

	local function statLine(parent, order, key, val, color)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order; row.ZIndex = 12; row.Parent = parent
		label(row, { text = key, size = UDim2.new(0.58, 0, 1, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })
		label(row, { text = tostring(val), size = UDim2.new(0.42, 0, 1, 0),
			position = UDim2.new(0.58, 0, 0, 0), xAlign = Enum.TextXAlignment.Right,
			color = color or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13,
			truncate = true, zIndex = 13 })
	end

	local function card(parent, order, title, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 10); stroke(f, color, 1)
		label(f, { text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
			color = color, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })
		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = f
		local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 2); l.Parent = rows
		local p = Instance.new("UIPadding")
		p.PaddingBottom = UDim.new(0, 8)
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = rows
		return f, rows
	end

	local function callAct(action, payload, onDone)
		local fn = remote("AdminUGCRestrictAction")
		if not fn then toast("Module serveur pas installé", false) return end
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" then
				if res.msg then toast(res.msg, res.ok == true) end
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

	------------------------------------------------------------------
	-- 🚫 ONGLET LISTE
	------------------------------------------------------------------
	local function restrictRow(parent, order, rec)
		local uid = rec.userId
		local uname = unameCache[uid] or rec.name or tostring(uid)
		local onlinePl = Players:GetPlayerByUserId(uid)
		local disp = onlinePl and onlinePl.DisplayName or (rec.name or uname)
		local col = rec.auto and RED or Color3.fromRGB(190, 130, 255)

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10); stroke(box, col, 1.5); padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = box

		--── Ligne 1 : avatar + nom + badge origine ──
		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local avS = IS_MOBILE and 30 or 36
		local av = makeAvatar(head, uid, avS, col)
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 0, 0.5, 0)

		local bdW = IS_MOBILE and 78 or 98
		label(head, { text = "🚫 " .. esc(disp) .. ptsSuffixLive(uid), richText = true,
			size = UDim2.new(1, -avS - bdW - 16, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 1 or 2),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })
		label(head, { text = "@" .. uname .. "  ·  " .. tostring(uid),
			size = UDim2.new(1, -avS - bdW - 16, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, avS + 8, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13 })

		local badge = Instance.new("TextLabel")
		badge.AnchorPoint = Vector2.new(1, 0.5)
		badge.Position = UDim2.new(1, 0, 0.5, 0)
		badge.Size = UDim2.new(0, bdW, 0, IS_MOBILE and 20 or 24)
		badge.BackgroundColor3 = col
		badge.BorderSizePixel = 0
		badge.Font = FONT
		badge.Text = rec.auto and "🤖 AUTO" or "👮 MANUEL"
		badge.TextColor3 = C.BG_BLACK
		badge.TextSize = IS_MOBILE and 9 or 11
		badge.ZIndex = 13
		badge.Parent = head
		corner(badge, 5)

		--── Ligne 2 : la traçabilité ──
		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1, 0, 0, 0)
		info.AutomaticSize = Enum.AutomaticSize.Y
		info.BackgroundColor3 = C.BG_ITEM
		info.BackgroundTransparency = 0.35
		info.BorderSizePixel = 0
		info.Font = FONT
		info.TextColor3 = C.TEXT_GREY
		info.TextSize = IS_MOBILE and 9 or 11
		info.TextWrapped = true
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.TextYAlignment = Enum.TextYAlignment.Top
		info.LayoutOrder = 2; info.ZIndex = 12; info.Parent = box
		corner(info, 7)
		local ip = Instance.new("UIPadding")
		ip.PaddingTop = UDim.new(0, 6); ip.PaddingBottom = UDim.new(0, 6)
		ip.PaddingLeft = UDim.new(0, 8); ip.PaddingRight = UDim.new(0, 8)
		ip.Parent = info

		local lines = {}
		table.insert(lines, "📅 " .. os.date("!%d/%m/%Y %H:%M", rec.at or 0) .. " UTC  ·  "
			.. fmtAgo(rec.at or 0))
		table.insert(lines, "👮 Par " .. tostring(rec.by or "?"))
		if rec.details and rec.details ~= "" then
			table.insert(lines, "📝 " .. tostring(rec.details))
		end
		table.insert(lines, string.format(
			"📊 Au moment de la sanction : %d warning(s), %d détection(s)",
			rec.warnings or 0, rec.detections or 0))

		local bt = {}
		for t, n in pairs(rec.byType or {}) do table.insert(bt, t .. "=" .. n) end
		table.sort(bt)
		if #bt > 0 then table.insert(lines, "   " .. table.concat(bt, "  ·  ")) end

		if (rec.attempts or 0) > 0 then
			table.insert(lines, string.format("🔁 %d tentative(s) d'achat bloquée(s)%s",
				rec.attempts,
				(rec.lastTryAt and rec.lastTryAt > 0)
					and ("  ·  dernière " .. fmtAgo(rec.lastTryAt)) or ""))
		end
		if (rec.leaks or 0) > 0 then
			table.insert(lines, string.format(
				"🚨 %d UGC PASSÉE(S) MALGRÉ LA SANCTION — un chemin d'achat n'est pas protégé !",
				rec.leaks))
		end
		info.Text = table.concat(lines, "\n")

		--── Ligne 3 : actions ──
		local acts = Instance.new("Frame")
		acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		acts.BackgroundTransparency = 1
		acts.LayoutOrder = 3; acts.ZIndex = 12; acts.Parent = box
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local function act(o, text, colB, colD, fn)
			local w = Instance.new("Frame")
			w.LayoutOrder = o; w.BackgroundTransparency = 1; w.ZIndex = 12; w.Parent = acts
			local b = actionButton(w, { color = colB, strokeColor = colD, text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(fn)
		end

		act(1, IS_MOBILE and "👤" or "👤 Profil", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(uname, function() screen(false) end)
		end)
		act(2, IS_MOBILE and "📊" or "📊 Détail", CYAN, Color3.fromRGB(30, 100, 150), function()
			S.tab = "detail" ; S.detailFor = uid ; screen(false)
		end)
		act(3, IS_MOBILE and "✅" or "✅ Lever", GREEN, GREEN_D, function()
			ask({
				title = "Rendre l'accès UGC à " .. uname,
				userId = uid, userName = disp,
				accent = GREEN, delay = 3, confirmText = "✅ Lever la sanction",
				lines = {
					"Il pourra de nouveau récupérer des UGC, immédiatement, sur tous "
						.. "tes serveurs.",
					rec.auto
						and ("Cette privation était AUTOMATIQUE, après " .. (rec.warnings or 0)
							.. " warning(s). Si tu la lèves sans remettre ses compteurs à zéro "
							.. "(onglet 📊), la prochaine détection peut la redéclencher tout "
							.. "de suite.")
						or ("Elle avait été posée à la main par " .. tostring(rec.by) .. "."),
					"La levée est tracée avec ton nom.",
				},
				onConfirm = function()
					callAct("remove", { userId = uid }, function(res)
						if res and res.ok then S.data = nil ; screen(false) end
					end)
				end,
			})
		end)

		return box
	end

	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, rec in ipairs((S.data and S.data.entries) or {}) do
			local ok = true
			if #q > 0 then
				local un = (unameCache[rec.userId] or ""):lower()
				ok = (tostring(rec.name or ""):lower():find(q, 1, true) ~= nil)
					or (un:find(q, 1, true) ~= nil)
					or (tostring(rec.userId) == q)
					or (tostring(rec.by or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(rec.details or ""):lower():find(q, 1, true) ~= nil)
			end
			if ok then table.insert(out, rec) end
		end
		table.sort(out, function(a, b) return (a.at or 0) > (b.at or 0) end)
		return out
	end

	local function renderList(body)
		local d = S.data
		local entries = d.entries or {}
		local auto, manual, tries, leaks = 0, 0, 0, 0
		for _, r in ipairs(entries) do
			if r.auto then auto = auto + 1 else manual = manual + 1 end
			tries = tries + (r.attempts or 0)
			leaks = leaks + (r.leaks or 0)
		end

		local c = d.config or {}
		local head = string.format(
			"🚫 %d joueur(s) privé(s) d'UGC  ·  🤖 %d auto  ·  👮 %d manuel",
			#entries, auto, manual)
		if tries > 0 then
			head = head .. string.format("\n🔁 %d tentative(s) d'achat bloquée(s) au total", tries)
		end
		if c.shadow then
			head = head .. "\n\n🧪 SHADOW ACTIF — plus aucune privation automatique ne tombera. "
				.. "Les détections continuent d'être enregistrées, mais personne n'est puni."
		elseif c.mode ~= "ugc" then
			head = head .. "\n\n⚠️ Le mode actuel est BAN, pas privation d'UGC. Cette liste "
				.. "n'évoluera plus toute seule."
		end
		note(body, 0, head, c.shadow and CYAN or RED)

		if leaks > 0 then
			note(body, 1, string.format(
				"🚨 %d UGC ont été livrées à des comptes restreints.\n\n"
					.. "Ça veut dire qu'un chemin d'achat n'est pas protégé : le patch de "
					.. "8 lignes dans ton script de points n'est probablement pas collé. "
					.. "Regarde la console serveur, chaque fuite y est tracée avec le nom "
					.. "du joueur et l'AssetId.", leaks), RED)
		end

		if d.listError then
			note(body, 2, "⚠️ " .. tostring(d.listError) .. "\nAppuie sur 🔄 en haut.", ORANGE)
		end

		--── Recherche ──
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 3; sw.ZIndex = 11; sw.Parent = body
		local sb = Instance.new("TextBox")
		sb.Size = UDim2.new(1, 0, 1, 0)
		sb.BackgroundColor3 = C.BG_DARK
		sb.BorderSizePixel = 0
		sb.Font = FONT
		sb.PlaceholderText = "🔍 Pseudo, UserID, admin, ou motif..."
		sb.PlaceholderColor3 = C.TEXT_DIM
		sb.Text = S.search or ""
		sb.TextColor3 = C.TEXT_WHITE
		sb.TextSize = IS_MOBILE and 11 or 14
		sb.TextXAlignment = Enum.TextXAlignment.Left
		sb.ClearTextOnFocus = false
		sb.ZIndex = 12
		sb.Parent = sw
		corner(sb, 8); stroke(sb, C.BORDER_SUBTLE, 1)
		local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sb

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 4; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local render
		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			local list = visible()
			if #list == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 70); f.BackgroundTransparency = 1
				f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
				label(f, {
					text = (#entries == 0)
						and "✅ Personne n'est privé d'UGC.\n\nSoit ton anti-cheat ne trouve "
						.. "rien, soit tu es en shadow. Regarde l'onglet ⚙️."
						or "Rien ne correspond à cette recherche.",
					size = UDim2.fromScale(1, 1), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			else
				for i, rec in ipairs(list) do restrictRow(holder, i, rec) end
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text ; render()
		end)

		local ids = {}
		for _, r in ipairs(entries) do table.insert(ids, r.userId) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if holder and holder.Parent then render() end
			end)
		end)
		render()
	end

	------------------------------------------------------------------
	-- ➕ ONGLET RESTREINDRE
	------------------------------------------------------------------
	local function renderAdd(body)
		note(body, 0, "Cherche un joueur, regarde ce que l'anti-cheat a relevé sur lui, "
			.. "PUIS tranche. Ton nom est enregistré sur la fiche : n'importe quel admin "
			.. "verra ensuite que c'est toi, et quand.", RED)

		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 1; sw.ZIndex = 11; sw.Parent = body

		local btnW = IS_MOBILE and 62 or 82
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.Size = UDim2.new(1, -btnW - 8, 1, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.Font = FONT
		box.PlaceholderText = "Pseudo exact ou UserID..."
		box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = S.query or ""
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 12 or 15
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.ZIndex = 12
		box.Parent = sw
		corner(box, 9); stroke(box, RED, 1)
		local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box
		box:GetPropertyChangedSignal("Text"):Connect(function() S.query = box.Text end)

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, 0, 0.5, 0)
		gc.Size = UDim2.new(0, btnW, 1, 0)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 12; gc.Parent = sw

		local function lookup()
			local q = (S.query or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if #q < 2 then toast("Entre un pseudo ou un UserID", false) return end
			if S.looking then return end
			S.looking = true ; S.found = nil ; screen(false)
			callAct("lookup", { target = q }, function(res)
				S.looking = false
				if res and res.ok then S.found = res end
				screen(false)
			end)
		end

		local gb = actionButton(gc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🔍", textSize = IS_MOBILE and 14 or 17, radius = 9, zIndex = 12 })
		gb.MouseButton1Click:Connect(lookup)
		box.FocusLost:Connect(function(enter) if enter then lookup() end end)

		if S.looking then
			note(body, 2, "⏳ Recherche en cours...", C.TEXT_GREY)
			return
		end
		if not S.found then
			note(body, 2, "Tape le pseudo exact (celui de Roblox, pas le nom affiché) ou un "
				.. "UserID.\n\nAstuce : dans 👤 PROFILE ou 🏆 BOARDS, chaque fiche a un UserID "
				.. "copiable.", C.TEXT_DIM)
			return
		end

		local f = S.found
		local already = f.record ~= nil

		--── Carte joueur ──
		local hc = Instance.new("Frame")
		hc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 84 or 104)
		hc.BackgroundColor3 = C.BG_DARK
		hc.BorderSizePixel = 0
		hc.LayoutOrder = 2
		hc.ZIndex = 12
		hc.Parent = body
		corner(hc, 10); stroke(hc, already and RED or C.BORDER_SUBTLE, 1.5)
		gradient(hc, C.BG_DARK, C.BG_ITEM)

		local avSize = IS_MOBILE and 58 or 76
		local av = makeAvatar(hc, f.userId, avSize, already and RED or C.PURPLE)
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 10, 0.5, 0)

		local ix = 10 + avSize + 12
		label(hc, { text = (already and "🚫 " or "") .. esc(f.name),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 20 or 26),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 8 or 12),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 15 or 19, truncate = true, zIndex = 13 })
		label(hc, { text = "🆔 " .. tostring(f.userId)
			.. (f.online and "  ·  🟢 en ligne" or "  ·  ⚪ hors ligne")
			.. (f.isAdmin and "  ·  👮 ADMIN" or ""),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 30 or 40),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })

		local live = f.live
		local liveTxt = "Aucune détection sur ce serveur"
		local liveCol = GREEN
		if type(live) == "table" and (live.total or 0) > 0 then
			liveTxt = string.format("%d détection(s) · %d warning(s) ici",
				live.total or 0, live.simWarnings or 0)
			liveCol = ORANGE
		end
		label(hc, { text = "📊 " .. liveTxt,
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 48 or 62),
			xAlign = Enum.TextXAlignment.Left, color = liveCol,
			textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 13 })

		if f.readFail then
			note(body, 3, "⚠️ Le registre n'a pas pu être lu pour ce joueur. Tant que c'est "
				.. "le cas, le serveur REFUSE ses achats par sécurité (il voit un message "
				.. "qui dit que ce n'est pas une sanction). Appuie sur 🔄 pour réessayer.",
				ORANGE)
			return
		end

		if f.isAdmin then
			note(body, 3, "👮 C'est un admin. Il ne peut pas être restreint, et l'anti-cheat "
				.. "ne l'analyse jamais.", C.TEXT_DIM)
			return
		end

		if already then
			local r = f.record
			local _, rows = card(body, 4, "🚫 DÉJÀ PRIVÉ D'UGC", RED)
			statLine(rows, 1, "Depuis", fmtAgo(r.at or 0), C.TEXT_WHITE)
			statLine(rows, 2, "Par", tostring(r.by or "?"), C.TEXT_GREY)
			statLine(rows, 3, "Origine", r.auto and "🤖 automatique" or "👮 manuelle",
				r.auto and RED or C.PURPLE)
			statLine(rows, 4, "Motif", tostring(r.details or "—"), C.TEXT_GREY)
			statLine(rows, 5, "Warnings au moment T", tostring(r.warnings or 0), ORANGE)
			statLine(rows, 6, "Tentatives bloquées", tostring(r.attempts or 0), C.TEXT_WHITE)

			bigBtn(body, 5, "✅ LEVER LA SANCTION", GREEN, GREEN_D, function()
				ask({
					title = "Rendre l'accès UGC à " .. f.name,
					userId = f.userId, userName = f.name,
					accent = GREEN, delay = 3, confirmText = "✅ Lever",
					lines = {
						"Il pourra de nouveau récupérer des UGC, immédiatement.",
						"Pense à remettre ses compteurs anti-cheat à zéro (onglet 📊) si "
							.. "tu conclus à un faux positif — sinon la sanction peut "
							.. "retomber dès la prochaine détection.",
					},
					onConfirm = function()
						callAct("remove", { userId = f.userId }, function(res)
							if res and res.ok then
								S.found, S.data = nil, nil
								S.tab = "list" ; screen(false)
							end
						end)
					end,
				})
			end, C.BG_BLACK)
			return
		end

		--── Note libre ──
		sectionLabel(body, 5, "MOTIF (VISIBLE PAR LES AUTRES ADMINS)")
		local nb = Instance.new("TextBox")
		nb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		nb.BackgroundColor3 = C.BG_DARK
		nb.BorderSizePixel = 0
		nb.Font = FONT
		nb.PlaceholderText = "Ex : vidéo de fly envoyée par 3 joueurs"
		nb.PlaceholderColor3 = C.TEXT_DIM
		nb.Text = S.note or ""
		nb.TextColor3 = C.TEXT_WHITE
		nb.TextSize = IS_MOBILE and 11 or 13
		nb.TextXAlignment = Enum.TextXAlignment.Left
		nb.ClearTextOnFocus = false
		nb.LayoutOrder = 6
		nb.ZIndex = 11
		nb.Parent = body
		corner(nb, 8); stroke(nb, C.BORDER_SUBTLE, 1)
		local np = Instance.new("UIPadding")
		np.PaddingLeft = UDim.new(0, 10); np.PaddingRight = UDim.new(0, 10)
		np.Parent = nb
		nb:GetPropertyChangedSignal("Text"):Connect(function() S.note = nb.Text end)

		bigBtn(body, 7, "🚫 PRIVER D'UGC", RED, RED_D, function()
			ask({
				title = "Priver " .. f.name .. " d'UGC",
				userId = f.userId, userName = f.name,
				accent = RED, danger = true, delay = 4, confirmText = "🚫 PRIVER",
				lines = {
					"Il ne pourra plus récupérer aucune UGC, sur aucun de tes serveurs, "
						.. "jusqu'à ce qu'un admin lève la sanction.",
					"Il n'est PAS banni : il garde ses points et continue de jouer "
						.. "normalement. Un panneau lui explique la situation et l'invite "
						.. "à contacter le support avec des preuves.",
					"Ta fiche sera enregistrée : « par 👮 " .. player.Name .. " », avec la "
						.. "date et ton motif.",
				},
				warn = "⚠️ Cette sanction ne s'enlève pas toute seule.",
				onConfirm = function()
					callAct("add", { userId = f.userId, note = S.note }, function(res)
						if res and res.ok then
							S.found, S.query, S.note, S.data = nil, "", "", nil
							S.tab = "list" ; screen(false)
						end
					end)
				end,
			})
		end, C.TEXT_WHITE)

		bigBtn(body, 8, "👤 Voir son profil complet", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(f.name, function() screen(false) end)
		end)
	end

	------------------------------------------------------------------
	-- 📊 ONGLET DÉTAIL
	------------------------------------------------------------------
	local function renderDetail(body)
		local uid = S.detailFor
		if not uid then
			note(body, 0, "Choisis un joueur depuis l'onglet 🚫 Restreints (bouton 📊) ou "
				.. "depuis ➕ Restreindre.", C.TEXT_DIM)
			return
		end

		local uname = unameCache[uid] or tostring(uid)
		note(body, 0, "Ce que l'anti-cheat a relevé sur ce joueur, sur CE serveur (données "
			.. "live) et en cumulé (données persistées). C'est ce que tu regardes pour juger "
			.. "un appel.", CYAN)

		local statusF = Instance.new("Frame")
		statusF.Size = UDim2.new(1, 0, 0, 44); statusF.BackgroundTransparency = 1
		statusF.LayoutOrder = 1; statusF.ZIndex = 11; statusF.Parent = body
		local stl = label(statusF, { text = "Chargement...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		callAct("lookup", { target = uid }, function(res)
			if not statusF.Parent then return end
			if not (res and res.ok) then stl.Text = "Chargement impossible (🔄)." return end
			statusF:Destroy()

			local live = res.live
			local _, rows = card(body, 2, "📊 " .. esc(res.name) .. " — CE SERVEUR", CYAN)
			if type(live) == "table" then
				statLine(rows, 1, "Détections", tostring(live.total or 0),
					(live.total or 0) > 0 and ORANGE or GREEN)
				statLine(rows, 2, "Warnings", tostring(live.simWarnings or 0),
					(live.simWarnings or 0) > 0 and ORANGE or GREEN)
				statLine(rows, 3, "Dernier type", tostring(live.lastType or "—"), C.TEXT_GREY)
				local o = 10
				for t, n in pairs(live.detections or {}) do
					o = o + 1
					statLine(rows, o, "  " .. t, tostring(n), C.TEXT_GREY)
				end
				local rec = live.recent or {}
				if #rec > 0 then
					statLine(rows, 50, "── Événements récents ──", "", C.TEXT_DIM)
					local n = 0
					for _, e in ipairs(rec) do
						n = n + 1
						if n > 15 then break end
						statLine(rows, 60 + n * 2,
							(e.kind == "warning")
								and ("WARNING " .. tostring(e.count or "?"))
								or tostring(e.vType),
							(e.t and fmtAgo(e.t)) or "?",
							e.kind == "warning" and RED or ORANGE)
						if e.details and e.details ~= "" then
							local d = Instance.new("Frame")
							d.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
							d.BackgroundTransparency = 1
							d.LayoutOrder = 61 + n * 2
							d.ZIndex = 13
							d.Parent = rows
							label(d, { text = "   " .. e.details, size = UDim2.fromScale(1, 1),
								xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
								textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
						end
					end
				end
			else
				statLine(rows, 1, "Aucune détection sur ce serveur", "clean ✅", GREEN)
			end

			if res.record then
				local r = res.record
				local _, rr = card(body, 3, "🚫 PRIVATION EN COURS", RED)
				statLine(rr, 1, "Depuis", fmtAgo(r.at or 0), C.TEXT_WHITE)
				statLine(rr, 2, "Par", tostring(r.by or "?"), C.TEXT_GREY)
				statLine(rr, 3, "Motif", tostring(r.details or "—"), C.TEXT_GREY)
				statLine(rr, 4, "Tentatives bloquées", tostring(r.attempts or 0), C.TEXT_WHITE)
			end

			bigBtn(body, 10, "🧹 Remettre ses compteurs anti-cheat à zéro",
				C.PURPLE, C.PURPLE_DARK, function()
					ask({
						title = "Remettre à zéro les compteurs de " .. res.name,
						userId = uid, userName = res.name,
						accent = C.PURPLE, delay = 3, confirmText = "🧹 Remettre à zéro",
						lines = {
							"Ses détections, ses strikes et ses warnings anti-cheat repartent "
								.. "de zéro.",
							"À faire quand tu conclus à un faux positif : sinon, même après "
								.. "avoir levé la privation, la prochaine détection la "
								.. "redéclenche aussitôt.",
							"⚠️ Ça ne lève PAS la privation elle-même — c'est l'onglet 🚫.",
						},
						onConfirm = function()
							callAct("clearstats", { userId = uid }, function()
								screen(false)
							end)
						end,
					})
				end)

			bigBtn(body, 11, "👤 Voir son profil complet", C.PURPLE, C.PURPLE_DARK, function()
				openProfileDetail(res.name, function() screen(false) end)
			end)
		end)
	end

	------------------------------------------------------------------
	-- ⚙️ ONGLET RÉGLAGES
	------------------------------------------------------------------
	local function applyCfg(patch, okMsg)
		local base = (S.draft or (S.data and S.data.config) or {})
		local out = {}
		for k, v in pairs(base) do out[k] = v end
		for k, v in pairs(patch) do out[k] = v end
		callAct("setconfig", { config = out }, function(res)
			if res and res.ok then
				S.data = nil ; S.draft = nil ; S.dirty = false
				if okMsg then toast(okMsg, true) end
			end
			screen(false)
		end)
	end

	local function modeCard(parent, order, opt)
		local sel = opt.selected
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 0)
		btn.AutomaticSize = Enum.AutomaticSize.Y
		btn.BackgroundColor3 = sel and C.BG_MEDIUM or C.BG_DARK
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.BorderSizePixel = 0
		btn.LayoutOrder = order
		btn.ZIndex = 11
		btn.Parent = parent
		corner(btn, 10)
		local bs = stroke(btn, sel and opt.color or C.BORDER_SUBTLE, sel and 2 or 1)
		padding(btn, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 4); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = btn

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = btn

		local pw = IS_MOBILE and 62 or 78
		label(head, { text = opt.title,
			size = UDim2.new(1, -pw - 8, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = sel and opt.color or C.TEXT_GREY,
			textSize = IS_MOBILE and 13 or 16, truncate = true, zIndex = 13 })

		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, 0, 0.5, 0)
		pill.Size = UDim2.new(0, pw, 0, IS_MOBILE and 20 or 24)
		pill.BackgroundColor3 = sel and opt.color or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = sel and "● ACTIF" or "activer"
		pill.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		pill.TextSize = IS_MOBILE and 9 or 11
		pill.ZIndex = 13
		pill.Parent = head
		corner(pill, 6)

		local d = Instance.new("TextLabel")
		d.Size = UDim2.new(1, 0, 0, 0)
		d.AutomaticSize = Enum.AutomaticSize.Y
		d.BackgroundTransparency = 1
		d.Font = FONT
		d.Text = opt.desc
		d.TextColor3 = C.TEXT_DIM
		d.TextSize = IS_MOBILE and 9 or 11
		d.TextWrapped = true
		d.TextXAlignment = Enum.TextXAlignment.Left
		d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = btn

		if not sel then
			btn.MouseEnter:Connect(function() bs.Color = opt.color end)
			btn.MouseLeave:Connect(function() bs.Color = C.BORDER_SUBTLE end)
			btn.MouseButton1Click:Connect(opt.onPick)
		end
		return btn
	end

	local function toggleRow(parent, order, opt)
		local v = opt.value
		local onCol = opt.onColor or GREEN

		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.Text = ""
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 9); stroke(row, v and onCol or C.BORDER_SUBTLE, v and 1.5 or 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 4); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = row
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 5); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = row

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 26 or 30)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = row

		local pw = IS_MOBILE and 52 or 64
		label(head, { text = opt.title,
			size = UDim2.new(1, -pw - 10, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = v and C.TEXT_WHITE or C.TEXT_GREY,
			textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 13 })

		local pill = Instance.new("TextLabel")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, 0, 0.5, 0)
		pill.Size = UDim2.new(0, pw, 0, IS_MOBILE and 22 or 26)
		pill.BackgroundColor3 = v and onCol or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.Font = FONT
		pill.Text = v and "ON" or "OFF"
		pill.TextColor3 = v and C.BG_BLACK or C.TEXT_GREY
		pill.TextSize = IS_MOBILE and 11 or 13
		pill.ZIndex = 13
		pill.Parent = head
		corner(pill, 6)

		local d = Instance.new("TextLabel")
		d.Size = UDim2.new(1, 0, 0, 0)
		d.AutomaticSize = Enum.AutomaticSize.Y
		d.BackgroundTransparency = 1
		d.Font = FONT
		d.Text = v and opt.onDesc or opt.offDesc
		d.TextColor3 = C.TEXT_DIM
		d.TextSize = IS_MOBILE and 9 or 11
		d.TextWrapped = true
		d.TextXAlignment = Enum.TextXAlignment.Left
		d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = row

		row.MouseButton1Click:Connect(function()
			local nv = not v
			local dangerous = (nv and opt.dangerOn) or ((not nv) and opt.dangerOff)
			ask({
				title = (nv and "Activer" or "Désactiver") .. " : " .. opt.title,
				accent = dangerous and RED or CYAN,
				danger = dangerous == true,
				delay = dangerous and 5 or 3,
				confirmText = nv and "✅ Activer" or "✅ Désactiver",
				lines = {
					"Tu passes ce réglage de " .. (v and "ON" or "OFF")
						.. " à " .. (nv and "ON" or "OFF") .. ", sur TOUS tes serveurs.",
					"À partir de maintenant :\n" .. (nv and opt.onDesc or opt.offDesc),
					"Ce que ça change concrètement :\n"
						.. (nv and (opt.onEffect or "—") or (opt.offEffect or "—")),
				},
				warn = dangerous and (nv and opt.warnOn or opt.warnOff) or nil,
				onConfirm = function()
					applyCfg({ [opt.key] = nv },
					opt.title .. " → " .. (nv and "ON" or "OFF"))
				end,
			})
		end)
		return row
	end

	local function stepper(parent, order, opt)
		local value = opt.value
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		row.BackgroundColor3 = C.BG_DARK
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 8); stroke(row, RED, 1)

		local bw = IS_MOBILE and 38 or 46
		local function side(isPlus)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(isPlus and 1 or 0, 0.5)
			c.Position = UDim2.new(isPlus and 1 or 0, isPlus and -6 or 6, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 28 or 34)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = row
			local b = actionButton(c, {
				color = isPlus and GREEN or C.BG_LIGHT,
				strokeColor = isPlus and GREEN_D or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 16 or 20, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				applyCfg({ [opt.key] = math.clamp(value + (isPlus and 1 or -1), opt.min, opt.max) })
			end)
		end
		side(false); side(true)

		local lbl = Instance.new("TextLabel")
		lbl.AnchorPoint = Vector2.new(0.5, 0.5)
		lbl.Position = UDim2.new(0.5, 0, 0.5, 0)
		lbl.Size = UDim2.new(1, -(bw * 2 + 24), 1, -10)
		lbl.BackgroundTransparency = 1
		lbl.Font = FONT
		lbl.Text = tostring(value) .. " " .. opt.suffix
		lbl.TextColor3 = C.TEXT_WHITE
		lbl.TextSize = IS_MOBILE and 14 or 17
		lbl.ZIndex = 12
		lbl.Parent = row
		return row
	end

	local function renderCfg(body)
		local c = (S.data and S.data.config) or {}

		if c._loaded == false then
			note(body, -1, "⚠️ Le serveur n'a pas réussi à lire la config en DataStore. "
				.. "Il tourne donc sur les valeurs les plus douces (shadow actif, personne "
				.. "n'est puni). Appuie sur 🔄 pour réessayer.", ORANGE)
		end

		--── LA case qui compte ──
		sectionLabel(body, 0, "OBSERVATION")
		toggleRow(body, 1, {
			key = "shadow", value = c.shadow == true, onColor = CYAN,
			title = "🧪 Shadow — détecter sans jamais punir",
			onDesc = "Tout est détecté et enregistré, mais AUCUNE sanction n'est appliquée : "
				.. "ni ban, ni kick, ni privation d'UGC. Le panel te montre ce qui SERAIT "
				.. "arrivé.",
			offDesc = "Les sanctions du mode choisi ci-dessous s'appliquent réellement.",
			onEffect = "Tes joueurs ne subissent plus rien. C'est ce que tu veux tant que tu "
				.. "n'as pas vérifié, pendant quelques jours, que la liste des joueurs "
				.. "flaggés ne contient que de vrais tricheurs.",
			offEffect = "À partir du prochain warning, les sanctions tombent pour de vrai.",
			dangerOff = true,
			warnOff = "⚠️ Avant de couper le shadow : ouvre l'onglet 🚫 et vérifie que les "
				.. "joueurs listés comme « seraient sanctionnés » sont bien des tricheurs. "
				.. "S'il y a un seul joueur honnête dedans, garde le shadow et corrige "
				.. "d'abord la cause.",
		})

		if not c.shadow then
			toggleRow(body, 2, {
				key = "shadowCorrect", value = c.shadowCorrect == true, onColor = ORANGE,
				title = "↩️ Corriger la position à chaque détection",
				onDesc = "Le joueur détecté est remis au sol et reçoit un petit message.",
				offDesc = "Aucune correction visible : on se contente de compter.",
				onEffect = "Un tricheur est gêné tout de suite. Un faux positif, lui, se fait "
					.. "téléporter au sol en pleine tentative d'obby — c'est ce qui énerve "
					.. "le plus vite des joueurs honnêtes.",
				offEffect = "Personne n'est dérangé pendant que tu observes.",
			})
		end

		--── Le mode ──
		sectionLabel(body, 5, "QUE SE PASSE-T-IL AU BOUT DES WARNINGS ?")

		modeCard(body, 6, {
			title = "🚫 Privation d'UGC", color = RED,
			selected = c.mode == "ugc",
			desc = "Le joueur n'est JAMAIS banni ni kické. Au bout du nombre de warnings "
				.. "réglé plus bas, il perd l'accès aux UGC — définitivement, jusqu'à ce "
				.. "qu'un admin lève la sanction. Il garde ses points et continue de jouer. "
				.. "C'est la sanction qui coûte le moins cher en cas d'erreur : un joueur "
				.. "honnête flaggé par erreur ne perd rien d'irréversible.",
			onPick = function()
				ask({
					title = "Passer en privation d'UGC",
					accent = RED, delay = 3, confirmText = "🚫 Activer ce mode",
					lines = {
						"Plus aucun ban ni kick ne viendra de l'anti-fly.",
						"Au lieu de ça, un joueur qui atteint le seuil de warnings perd "
							.. "l'accès aux UGC et reçoit un panneau qui l'invite à "
							.. "contacter ton support avec des preuves.",
						"Les bans déjà posés ne sont pas levés pour autant.",
					},
					onConfirm = function() applyCfg({ mode = "ugc" }, "Mode privation d'UGC actif") end,
				})
			end,
		})

		modeCard(body, 7, {
			title = "🔨 Ban", color = ORANGE,
			selected = c.mode == "ban",
			desc = "L'échelle classique : notification, notification, kick, kick, puis ban "
				.. "permanent au 5e warning. C'est la sanction la plus lourde — et la plus "
				.. "coûteuse si l'anti-cheat se trompe, parce qu'un joueur banni ne revient "
				.. "pas t'expliquer.",
			onPick = function()
				ask({
					title = "Passer en mode ban",
					accent = ORANGE, danger = true, delay = 5, confirmText = "🔨 Activer",
					lines = {
						"L'anti-fly pourra de nouveau kicker puis bannir définitivement.",
						"À n'activer que si tu as observé plusieurs jours en shadow et que "
							.. "la liste des joueurs flaggés ne contient que des tricheurs.",
					},
					warn = "⚠️ Un ban automatique part sans que tu aies vu le dossier. "
						.. "En cas de faux positif, tu perds le joueur pour de bon.",
					onConfirm = function() applyCfg({ mode = "ban" }, "Mode ban actif") end,
				})
			end,
		})

		--── Seuil ──
		if c.mode == "ugc" then
			sectionLabel(body, 10, "COMBIEN DE WARNINGS AVANT LA PRIVATION")
			stepper(body, 11, {
				key = "warningsToRestrict",
				value = tonumber(c.warningsToRestrict) or 2,
				min = 1, max = 20, suffix = "warning(s)",
			})
			note(body, 12, "Rappel de l'échelle : il faut 3 détections rapprochées pour "
				.. "produire 1 warning, et les détections d'une même glissade ne comptent "
				.. "qu'une fois. À 2 warnings, tu es donc déjà sur un comportement répété "
				.. "sur plusieurs minutes.\n\n"
				.. "1 = très sévère, tu vas ramasser des faux positifs.\n"
				.. "2 = recommandé.\n"
				.. "4+ = tu ne prives que les cas flagrants.", C.TEXT_DIM)

			toggleRow(body, 13, {
				key = "notifyOnRestrict", value = c.notifyOnRestrict ~= false, onColor = GREEN,
				title = "💬 Prévenir le joueur",
				onDesc = "Un panneau lui explique la sanction et l'invite à contacter le "
					.. "support avec des preuves.",
				offDesc = "Il découvre le blocage tout seul en cliquant sur Buy.",
				onEffect = "Il sait pourquoi, il sait quoi faire, et ton support reçoit des "
					.. "appels utiles au lieu de « ça marche pas ».",
				offEffect = "Tu vas recevoir des tickets « le shop est cassé ».",
			})

			toggleRow(body, 14, {
				key = "kickOnRestrict", value = c.kickOnRestrict == true, onColor = ORANGE,
				title = "👟 Le kicker une fois au moment de la sanction",
				onDesc = "Il est déconnecté une fois, avec le message. Il peut revenir "
					.. "immédiatement.",
				offDesc = "Rien ne l'interrompt : il continue sa partie, seul le shop refuse.",
				onEffect = "Le message est impossible à rater. En contrepartie, un joueur "
					.. "honnête en plein run d'obby perd sa progression de session.",
				offEffect = "Personne n'est interrompu.",
				dangerOn = true,
				warnOn = "⚠️ En obby, couper un joueur en plein run est ce qui énerve le "
					.. "plus. La privation se suffit à elle-même.",
			})
		end

		--── État courant ──
		local _, rows = card(body, 20, "📋 ÉTAT ACTUEL", CYAN)
		statLine(rows, 1, "Mode", c.mode == "ugc" and "🚫 Privation d'UGC" or "🔨 Ban",
			c.mode == "ugc" and RED or ORANGE)
		statLine(rows, 2, "Shadow", c.shadow and "🧪 OUI — rien n'est appliqué" or "non",
			c.shadow and CYAN or GREEN)
		statLine(rows, 3, "Seuil", tostring(c.warningsToRestrict or 2) .. " warning(s)", C.TEXT_WHITE)
		statLine(rows, 4, "Config lue en base", c._loaded ~= false and "oui" or "NON",
			c._loaded ~= false and GREEN or ORANGE)

		bigBtn(body, 30, "♻️ Recharger config + registre", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			callAct("reload", {}, function() S.data = nil ; screen(false) end)
		end)

		note(body, 31, "Le mode et la case shadow sont enregistrés en DataStore et diffusés "
			.. "à tous tes serveurs dans la seconde. Tu n'as jamais à toucher au code de "
			.. "l'anti-fly : il lit ces réglages à chaque mesure.", C.TEXT_DIM)
	end

	------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "ugcban"
		if reset then
			S.data = nil ; S.failed = false ; S.failMsg = nil
			S.tab = "list" ; S.search = ""
			S.query = "" ; S.note = "" ; S.found = nil ; S.looking = false
			S.detailFor = nil ; S.draft = nil ; S.dirty = false
		end

		local body = buildScreen("🚫 UGC BAN", true, RED, nil, function()
			S.data = nil ; screen(false)
		end)

		acTabBar(body, -2, {
			{ id = "list", label = "🚫 Restreints" },
			{ id = "add",  label = "➕ Restreindre" },
		}, S.tab, RED, function(id)
			S.tab = id
			if id ~= "add" then S.found = nil end
			screen(false)
		end)

		acTabBar(body, -1, {
			{ id = "detail", label = "📊 Détail" },
			{ id = "cfg",    label = "⚙️ Réglages" },
		}, S.tab, RED, function(id)
			S.tab = id ; S.found = nil ; screen(false)
		end)

		if not remote("AdminGetUGCRestrict") then
			note(body, 1, "❌ Le serveur n'a pas le module de privation d'UGC.\n\n"
				.. "Ajoute AntiCheat_UGCRestrict.server.lua dans ServerScriptService, "
				.. "puis redémarre le serveur.", RED)
			return
		end

		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetUGCRestrict")
				local ok, res = false, nil
				if fn then ok, res = pcall(function() return fn:InvokeServer(true) end) end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data = res ; S.failMsg = nil
				else
					S.failed = true
					S.failMsg = (type(res) == "table" and res.msg)
						or (ok == false and ("Erreur : " .. tostring(res)))
						or "Réponse inattendue du serveur."
				end
				if currentScreen == "ugcban" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Chargement impossible.\n\n" .. (S.failMsg or "") .. "\n\nAppuie sur 🔄.")
				or "Chargement du registre...",
				S.failed and ORANGE or C.TEXT_GREY)
			return
		end

		if S.tab == "add" then
			renderAdd(body)
		elseif S.tab == "detail" then
			renderDetail(body)
		elseif S.tab == "cfg" then
			renderCfg(body)
		else
			renderList(body)
		end
	end

	------------------------------------------------------------------
	-- 👤 CARTE « ACCÈS UGC » DANS TOUS LES PROFILS
	------------------------------------------------------------------
	local function ugcRestrictCard(parent, order, userId, uname)
		if not remote("AdminUGCRestrictAction") then return end

		local host, rows = card(parent, order, "🚫 ACCÈS UGC", C.TEXT_DIM)
		statLine(rows, 1, "État", "…", C.TEXT_DIM)

		local btnWrap = Instance.new("Frame")
		btnWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		btnWrap.BackgroundTransparency = 1
		btnWrap.LayoutOrder = 5
		btnWrap.ZIndex = 13
		btnWrap.Parent = rows

		task.spawn(function()
			local fn = remote("AdminUGCRestrictAction")
			local ok, res = pcall(function()
				return fn:InvokeServer("lookup", { target = userId })
			end)
			if not (ok and type(res) == "table" and res.ok) then return end
			if not host.Parent then return end

			for _, ch in ipairs(rows:GetChildren()) do
				if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and ch ~= btnWrap then
					ch:Destroy()
				end
			end

			local r = res.record
			if r then
				stroke(host, RED, 1.5)
				statLine(rows, 1, "État", "🚫 PRIVÉ D'UGC", RED)
				statLine(rows, 2, "Depuis", fmtAgo(r.at or 0), C.TEXT_GREY)
				statLine(rows, 3, "Par", tostring(r.by or "?"), C.TEXT_GREY)
				statLine(rows, 4, "Motif", tostring(r.details or "—"), C.TEXT_GREY)
			elseif res.isAdmin then
				statLine(rows, 1, "État", "👮 admin — jamais restreint", C.PURPLE)
				return
			elseif res.readFail then
				statLine(rows, 1, "État", "⚠️ registre illisible", ORANGE)
				return
			else
				statLine(rows, 1, "État", "✅ accès normal", GREEN)
			end

			local b, lbl = actionButton(btnWrap, {
				color = r and GREEN or RED,
				strokeColor = r and GREEN_D or RED_D,
				text = r and "✅ Rendre l'accès UGC" or "🚫 Priver d'UGC",
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13,
			})
			b.MouseButton1Click:Connect(function()
				if r then
					ask({
						title = "Rendre l'accès UGC", userId = userId, userName = uname,
						accent = GREEN, delay = 3, confirmText = "✅ Lever",
						lines = { "Il pourra de nouveau récupérer des UGC, immédiatement." },
						onConfirm = function()
							callAct("remove", { userId = userId })
						end,
					})
				else
					ask({
						title = "Priver d'UGC", userId = userId, userName = uname,
						accent = RED, danger = true, delay = 4, confirmText = "🚫 PRIVER",
						lines = {
							"Il ne pourra plus récupérer aucune UGC, sur aucun serveur, "
								.. "jusqu'à ce qu'un admin lève la sanction.",
							"Il n'est pas banni : il garde ses points et continue de jouer.",
						},
						onConfirm = function()
							callAct("add", { userId = userId,
								note = "Depuis la fiche profil" })
						end,
					})
				end
			end)
		end)

		return host
	end

	--  Injectée dans les profils complets…
	local previousRenderProfile = renderProfile
	renderProfile = function(body, profile)
		previousRenderProfile(body, profile)
		if type(profile) == "table" and not profile.error and profile.userId then
			ugcRestrictCard(body, 23, profile.userId, profile.username or profile.name)
		end
	end

	--  …et dans les fiches « MANAGE PLAYER ».
	local previousScreenManage = screenManage
	screenManage = function(info, backFn)
		previousScreenManage(info, backFn)
		if type(info) ~= "table" or not info.userId then return end
		local b = window:FindFirstChildOfClass("ScrollingFrame")
		if not b then return end
		ugcRestrictCard(b, 502, info.userId, info.username or tostring(info.userId))
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "ugcban", name = "🚫 UGC BAN", color = RED })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "ugcban" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🚨 BLOC 9 — REFONTE DE LA SECTION ANTI-CHEAT
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     APRÈS le bloc 🚫 UGC BAN. Rien à supprimer : ce bloc remplace la
--     fonction `screenACBoards` à chaud, ton ancien code reste en place mais
--     n'est plus appelé. Si un jour tu veux revenir en arrière, tu n'as qu'à
--     retirer ce bloc.
--
--  ─────────────────────────────────────────────────────────────
--  🐌 POURQUOI TES CLASSEMENTS METTAIENT SI LONGTEMPS
--  ─────────────────────────────────────────────────────────────
--  Afficher 50 joueurs déclenchait, dans cet ordre et l'un APRÈS l'autre :
--    • 1 à 3 lectures d'OrderedDataStore,
--    • jusqu'à 50 résolutions de pseudo (appels web, ~200 ms chacun),
--    • puis 50 lectures de points + 50 lectures de ban, avec une pause de
--      0,05 s imposée entre chaque.
--  Soit plus de 150 allers-retours en file indienne. Et l'écran restait
--  VIDE pendant tout ce temps, parce que rien ne s'affichait avant que la
--  toute dernière réponse soit arrivée.
--
--  Ici, trois changements :
--    1. Les lignes s'affichent IMMÉDIATEMENT, dès que les UserId sont connus.
--       Les noms et les points se remplissent tout seuls après coup, sans
--       redessiner quoi que ce soit.
--    2. Le serveur résout tout en PARALLÈLE, par vagues de 12.
--    3. Un cache qui survit à la fermeture du panel : la deuxième ouverture
--       est instantanée.
--
--  Prérequis serveur : AntiCheat_UGCRestrict.server.lua (version à jour).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local RED    = Color3.fromRGB(235, 60, 65)
	local RED_D  = Color3.fromRGB(140, 25, 30)
	local ORANGE = Color3.fromRGB(255, 170, 60)
	local GREEN  = Color3.fromRGB(55, 195, 100)
	local CYAN   = Color3.fromRGB(110, 200, 255)
	local GOLD   = Color3.fromRGB(255, 205, 60)
	local PURPLE = Color3.fromRGB(190, 130, 255)

	--  Le prix d'une UGC. C'est l'unité qui rend le classement « risque »
	--  lisible : un joueur ne devient dangereux pour ton économie qu'à partir
	--  du moment où il peut convertir sa triche en objet.
	local UGC_PRICE = 2000000

	--════════════════════════════════════════════════════════════════
	-- 🗄️ CACHES DE SESSION
	--    Ils survivent à la fermeture du panel. C'est ce qui rend la
	--    deuxième ouverture instantanée.
	--════════════════════════════════════════════════════════════════
	local CACHE = {
		name = {},        -- [userId] = pseudo
		pts  = {},        -- [userId] = points
		ban  = {},        -- [userId] = bool
		restr = {},       -- [userId] = bool (privé d'UGC)
		board = {},       -- [clé] = { entries, at }
		BOARD_TTL = 45,
	}

	local ST = {
		tab = "feed",           -- feed | risk | boards | card
		sys = "fly",            -- système affiché dans l'onglet Classements
		metric = "fly_warnings",
		count = 50,
		loading = false,
		entries = nil,          -- entrées de l'onglet courant
		error = nil,
		cardFor = nil,
		cardData = nil,
		cardLoading = false,
		search = "",
		riskMinUGC = 0,         -- filtre : au moins N UGC finançables
	}

	local screenACBoards_new   -- forward decl

	local function acRemote(name)
		return ReplicatedStorage:FindFirstChild(name)
	end

	--════════════════════════════════════════════════════════════════
	-- 🧱 COMPOSANTS
	--════════════════════════════════════════════════════════════════
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	local function statLine(parent, order, key, val, color)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order; row.ZIndex = 12; row.Parent = parent
		label(row, { text = key, size = UDim2.new(0.56, 0, 1, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 13 })
		label(row, { text = tostring(val), size = UDim2.new(0.44, 0, 1, 0),
			position = UDim2.new(0.56, 0, 0, 0), xAlign = Enum.TextXAlignment.Right,
			color = color or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13,
			truncate = true, zIndex = 13 })
	end

	local function card(parent, order, title, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 10); stroke(f, color, 1)
		label(f, { text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
			color = color, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })
		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = f
		local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 2); l.Parent = rows
		local p = Instance.new("UIPadding")
		p.PaddingBottom = UDim.new(0, 8)
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = rows
		return f, rows
	end

	local function bigBtn(parent, order, text, col, colD, fn, textCol)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 42 or 48)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b = actionButton(c, { color = col, strokeColor = colD, text = text,
			textColor = textCol, textSize = IS_MOBILE and 12 or 15, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b
	end

	--════════════════════════════════════════════════════════════════
	-- 📞 APPELS SERVEUR
	--════════════════════════════════════════════════════════════════
	local function callAC(action, payload, cb, attempt)
		local fn = acRemote("AdminUGCRestrictAction")
		if not fn then if cb then cb(nil) end return end
		attempt = attempt or 1
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			--  Une limite de débit n'est pas une panne : on réessaie tout seul.
			if ok and type(res) == "table" and res.throttled and attempt < 3 then
				task.wait(0.35 * attempt)
				callAC(action, payload, cb, attempt + 1)
				return
			end
			if cb then cb((ok and type(res) == "table") and res or nil) end
		end)
	end

	--  Résolution en lot : ne demande que ce qui MANQUE, et remplit le cache.
	local function resolveAC(ids, cb)
		local need = {}
		for _, id in ipairs(ids) do
			if not CACHE.name[id] then need[#need + 1] = id end
		end
		if #need == 0 then if cb then cb() end return end

		callAC("resolve", { ids = need }, function(res)
			if res and res.ok and type(res.data) == "table" then
				for key, e in pairs(res.data) do
					local id = tonumber(key)
					if id and type(e) == "table" then
						if e.name then CACHE.name[id] = e.name end
						if e.points ~= nil then CACHE.pts[id] = e.points end
						if e.banned ~= nil then CACHE.ban[id] = e.banned end
						--  (statut « restreint » : pris UNIQUEMENT des classements, qui le
						--   lisent dans le registre des sanctions)
					end
				end
			end
			if cb then cb() end
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 📏 OUTILS
	--════════════════════════════════════════════════════════════════
	local function nameOf(id)
		local pl = Players:GetPlayerByUserId(id)
		if pl then CACHE.name[id] = pl.Name ; return pl.Name end
		return CACHE.name[id]
	end

	local function pointsOf(id)
		local pl = Players:GetPlayerByUserId(id)
		if pl then
			local a = pl:GetAttribute("Points")
			if type(a) == "number" then return a end
		end
		return CACHE.pts[id]
	end

	--  Combien d'UGC ce joueur peut s'offrir MAINTENANT.
	local function ugcPower(points)
		if not points then return nil end
		return points / UGC_PRICE
	end

	--  Le score de risque. Il répond à une question précise : parmi les
	--  joueurs suspects, lesquels sont assez riches pour transformer ça en
	--  objet ? Un tricheur à 200 points ne coûte rien à ton économie ; le
	--  même à 1,9 million est à un pas de vider ton stock.
	local function riskScore(warnings, points)
		local w = tonumber(warnings) or 0
		if w <= 0 then return 0 end
		local pw = ugcPower(points)
		if pw == nil then return w * 0.2 end            -- points inconnus : poids minimal
		return w * (0.2 + math.clamp(pw, 0, 4))
	end

	local function confColor(c)
		c = tonumber(c) or 0
		if c >= 85 then return RED end
		if c >= 70 then return ORANGE end
		if c >= 55 then return GOLD end
		return C.TEXT_GREY
	end

	--════════════════════════════════════════════════════════════════
	-- 📋 LIGNE À REMPLISSAGE PROGRESSIF
	--
	--    C'est le cœur de la correction de lenteur. La ligne est construite
	--    tout de suite avec ce qu'on sait (l'UserId), puis on garde une
	--    référence à ses deux labels. Quand le serveur répond, on écrit
	--    dedans — on ne reconstruit RIEN.
	--════════════════════════════════════════════════════════════════
	local function acLine(parent, order, opt)
		local id = opt.userId
		local accent = opt.accent or CYAN

		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, ROW_H)
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.Text = ""
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 10)
		local rs = stroke(row, C.BORDER_SUBTLE, 1)

		local rankW = IS_MOBILE and 28 or 36
		if opt.rank then
			label(row, { text = "#" .. opt.rank, size = UDim2.new(0, rankW, 1, 0),
				position = UDim2.new(0, 4, 0, 0), color = rankColor(opt.rank),
				textSize = IS_MOBILE and 11 or 15, zIndex = 12 })
		else
			rankW = 2
		end

		local avS = ROW_H - 18
		local av = makeAvatar(row, id, avS)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, rankW + 6, 0.5, 0)

		local tx = rankW + 6 + avS + 8
		local valW = IS_MOBILE and 86 or 112

		--  Ligne 1 : le pseudo. Affiché « … » puis rempli.
		local nameLbl = label(row, {
			text = ((CACHE.restr[id] == true) and "🚫 " or "") .. (nameOf(id) or "…"),
			size = UDim2.new(1, -tx - valW - 10, 0, IS_MOBILE and 15 or 19),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 8 or 12),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12,
		})

		--  Ligne 2 : la ligne de contexte (points, UGC finançables, statut).
		local subLbl = label(row, {
			text = opt.sub or "chargement…",
			size = UDim2.new(1, -tx - valW - 10, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 26 or 34),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 12,
		})

		--  Colonne de droite : la valeur du classement courant.
		local valLbl = label(row, {
			text = opt.value or "",
			size = UDim2.new(0, valW, 1, 0),
			position = UDim2.new(1, -8, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right, color = opt.valueColor or accent,
			textSize = IS_MOBILE and 12 or 15, zIndex = 12, truncate = true,
		})

		--  🚫 V4 : joueur restreint → ligne violette + étiquette RESTREINT sous l'avatar
		local isR = CACHE.restr[id] == true
		local baseBg = isR and Color3.fromRGB(48, 26, 66) or C.BG_DARK
		local baseSt = isR and PURPLE or C.BORDER_SUBTLE
		row.BackgroundColor3 = baseBg ; rs.Color = baseSt
		if isR then
			rs.Thickness = 2
			local tag = Instance.new("TextLabel")
			tag.AnchorPoint = Vector2.new(0.5, 1)
			tag.Position = UDim2.new(0, rankW + 6 + avS / 2, 1, -2)
			tag.Size = UDim2.new(0, avS + 14, 0, IS_MOBILE and 11 or 13)
			tag.BackgroundColor3 = PURPLE
			tag.BorderSizePixel = 0
			tag.Font = FONT
			tag.Text = "RESTREINT"
			tag.TextColor3 = Color3.new(0, 0, 0)
			tag.TextScaled = true
			tag.ZIndex = 14
			tag.Parent = row
			corner(tag, 4)
		end
		row.MouseEnter:Connect(function() row.BackgroundColor3 = C.BG_MEDIUM ; rs.Color = accent end)
		row.MouseLeave:Connect(function() row.BackgroundColor3 = baseBg ; rs.Color = baseSt end)
		row.MouseButton1Click:Connect(function()
			ST.tab = "card" ; ST.cardFor = id ; ST.cardData = nil
			screenACBoards_new()
		end)

		return { row = row, name = nameLbl, sub = subLbl, value = valLbl, userId = id }
	end

	--  Remplit les lignes une fois la résolution revenue.
	local function fillLines(refs, subBuilder)
		for _, r in ipairs(refs) do
			if r.name.Parent then
				r.name.Text = ((CACHE.restr[r.userId] == true) and "🚫 " or "")
					.. (nameOf(r.userId) or ("UserId " .. r.userId))
				if subBuilder then
					local txt, col = subBuilder(r.userId)
					r.sub.Text = txt
					if col then r.sub.TextColor3 = col end
				end
			end
		end
	end

	--  La ligne de contexte standard : points, pouvoir d'achat UGC, statut.
	local function stdSub(id)
		local p = pointsOf(id)
		local parts = {}
		if p then
			table.insert(parts, fmtNum(p) .. " pts")
			local pw = ugcPower(p)
			if pw and pw >= 1 then
				table.insert(parts, string.format("🎽 %d UGC finançable(s)", math.floor(pw)))
			elseif pw then
				table.insert(parts, string.format("🎽 %d %% d'une UGC", math.floor(pw * 100)))
			end
		else
			table.insert(parts, "Points : —")
		end
		if CACHE.restr[id] then table.insert(parts, 1, "🚫 RESTREINT (privé d'UGC)") end
		if CACHE.ban[id] then table.insert(parts, "⛔ banni") end
		if Players:GetPlayerByUserId(id) then table.insert(parts, "🟢 en ligne") end

		local col = C.TEXT_GREY
		if CACHE.restr[id] then col = PURPLE
		elseif CACHE.ban[id] then col = RED
		elseif p and p >= UGC_PRICE then col = ORANGE end
		return table.concat(parts, "  ·  "), col
	end

	--════════════════════════════════════════════════════════════════
	-- 📡 ONGLET « RÉCENT »
	--════════════════════════════════════════════════════════════════
	local function renderFeed(body)
		note(body, 0, "Les joueurs dont l'anti-cheat a RETENU un signal récemment, tous "
			.. "serveurs confondus. Les signaux écartés par le filtre de certitude "
			.. "n'apparaissent pas ici — c'est volontaire : cette liste ne doit contenir "
			.. "que des dossiers qui méritent ton temps.\n\n"
			.. "Touche une ligne pour ouvrir le dossier complet.", CYAN)

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 1; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Lecture du fil...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 2; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local function paint(entries)
			if not status.Parent then return end
			status:Destroy()

			if #entries == 0 then
				label(holder, { text = "✅ Aucune détection retenue récemment.\n\n"
					.. "Soit personne ne triche, soit tu es en shadow depuis peu — le fil "
					.. "se remplit avec un décalage de 90 secondes maximum.",
					size = UDim2.new(1, 0, 0, 80), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
				return
			end

			--  ① On dessine TOUT DE SUITE, avec les UserId. L'écran n'est
			--     jamais vide, même si la résolution prend deux secondes.
			local refs, ids = {}, {}
			for i, e in ipairs(entries) do
				ids[#ids + 1] = e.userId
				if e.restricted ~= nil then CACHE.restr[e.userId] = (e.restricted == true) end
				refs[#refs + 1] = acLine(holder, i, {
					userId = e.userId, rank = i, accent = ORANGE,
					value = e.at and fmtAgo(e.at) or "?",
					valueColor = ORANGE,
				})
			end

			--  ② Puis on remplit, sans rien reconstruire.
			resolveAC(ids, function()
				if holder.Parent then fillLines(refs, stdSub) end
			end)
		end

		if not acRemote("AdminUGCRestrictAction") then
			stl.Text = "❌ AntiCheat_UGCRestrict.server.lua manquant côté serveur."
			return
		end

		callAC("feed", { limit = 50, hideRestricted = ST.hideR == true }, function(res)
			if not status.Parent then return end
			if not (res and res.ok) then
				stl.Text = "Lecture impossible. Appuie sur 🔄."
				return
			end
			paint(res.entries or {})
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 🎯 ONGLET « RISQUE ÉCONOMIQUE »
	--════════════════════════════════════════════════════════════════
	local function renderRisk(body)
		note(body, 0, string.format(
			"Ce classement répond à UNE question : parmi les joueurs suspects, lesquels "
				.. "sont assez riches pour transformer leur triche en objet ?\n\n"
				.. "Un tricheur à 200 points ne coûte rien à ton économie. Le même à "
				.. "1,9 million est à un pas de vider ton stock. Le score combine donc les "
				.. "warnings et le pouvoir d'achat, une UGC valant %s points.",
			fmtNum(UGC_PRICE)), GOLD)

		--  Filtre : ne montrer que ceux qui peuvent réellement acheter.
		acTabBar(body, 1, {
			{ id = 0, label = "🌐 Tous" },
			{ id = 1, label = "🎽 ≥ 1 UGC" },
			{ id = 2, label = "🎽 ≥ 2 UGC" },
		}, ST.riskMinUGC, GOLD, function(id)
			ST.riskMinUGC = id ; screenACBoards_new()
		end)

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 2; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Calcul du risque...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 3; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local gb = acRemote("AdminGetACBoard")
		if not gb then
			stl.Text = "❌ AdminGetACBoard manquant — mets AdminPanel_Server à jour."
			return
		end

		task.spawn(function()
			--  On part du classement des warnings : c'est la seule dimension
			--  « suspicion » qui a du sens économiquement (un simple signal
			--  écarté ne veut rien dire).
			local ok, res = pcall(function() return gb:InvokeServer("fly_warnings", 60, ST.hideR == true) end)
			if not status.Parent then return end
			if not (ok and type(res) == "table" and type(res.entries) == "table") then
				stl.Text = "Lecture du classement impossible. Appuie sur 🔄."
				return
			end

			local entries = res.entries
			if #entries == 0 then
				status:Destroy()
				label(holder, { text = "✅ Aucun joueur avec des warnings.\n\n"
					.. "Rien à classer — c'est la meilleure nouvelle possible.",
					size = UDim2.new(1, 0, 0, 70), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
				return
			end

			--  Les points sont indispensables au tri ici : on attend, mais on
			--  prévient l'utilisateur de ce qui se passe.
			stl.Text = string.format("Lecture des soldes de %d joueur(s)...", #entries)

			local ids = {}
			for _, e in ipairs(entries) do ids[#ids + 1] = e.userId end

			resolveAC(ids, function()
				if not status.Parent then return end
				status:Destroy()

				local rows = {}
				for _, e in ipairs(entries) do
					if e.restricted ~= nil then CACHE.restr[e.userId] = (e.restricted == true) end
					local p = pointsOf(e.userId)
					local pw = ugcPower(p) or 0
					if pw >= ST.riskMinUGC then
						rows[#rows + 1] = {
							userId = e.userId,
							warnings = e.value,
							points = p,
							pw = pw,
							score = riskScore(e.value, p),
						}
					end
				end

				table.sort(rows, function(a, b) return a.score > b.score end)

				if #rows == 0 then
					label(holder, { text = "Aucun joueur ne correspond à ce filtre.\n\n"
						.. "Personne avec des warnings n'a assez de points pour s'offrir "
						.. "le nombre d'UGC demandé.",
						size = UDim2.new(1, 0, 0, 70), wrapped = true,
						color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
					return
				end

				for i, r in ipairs(rows) do
					local col = (r.pw >= 1 and r.warnings >= 2) and RED
						or (r.pw >= 1 and ORANGE or C.TEXT_GREY)
					local ref = acLine(holder, i, {
						userId = r.userId, rank = i, accent = GOLD,
						value = string.format("%.0f", r.score),
						valueColor = col,
					})
					--  Ligne de contexte spécifique : on veut voir les deux
					--  facteurs du score côte à côte, pas un total opaque.
					ref.sub.Text = (CACHE.restr[r.userId] and "🚫 RESTREINT  ·  " or "")
						.. string.format("⚠️ %d warning(s)  ·  💎 %s  ·  🎽 %s",
							r.warnings,
							r.points and fmtNum(r.points) or "—",
							r.pw >= 1 and (math.floor(r.pw) .. " UGC")
							or (math.floor(r.pw * 100) .. " % d'une UGC"))
					ref.sub.TextColor3 = CACHE.restr[r.userId] and PURPLE or col
					ref.name.Text = ((CACHE.restr[r.userId] == true) and "🚫 " or "")
						.. (nameOf(r.userId) or ("UserId " .. r.userId))
				end

				local nf = Instance.new("Frame")
				nf.Size = UDim2.new(1, 0, 0, 24)
				nf.BackgroundTransparency = 1
				nf.LayoutOrder = 99999
				nf.ZIndex = 11
				nf.Parent = holder
				label(nf, { text = "Score = warnings × pouvoir d'achat en UGC",
					size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, zIndex = 11 })
			end)
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 🏆 ONGLET « CLASSEMENTS »  (tes boards d'origine, en rapide)
	--════════════════════════════════════════════════════════════════
	local AC_SYS = {
		{ id = "fly", label = "🛡️ Fly", color = C.BLUE, metrics = {
			{ id = "fly_strikes",  label = "Signaux" },
			{ id = "fly_warnings", label = "Warnings" },
			{ id = "fly_kicks",    label = "Kicks" },
			{ id = "fly_bans",     label = "Sanctions", isDate = true },
		} },
		{ id = "smart", label = "🧠 SmartAC", color = C.PURPLE, metrics = {
			{ id = "smart_infractions", label = "Total" },
			{ id = "smart_suspicious",  label = "Suspects" },
			{ id = "smart_dangerous",   label = "Dangereux" },
		} },
		{ id = "exploit", label = "🚫 Exploit", color = RED, metrics = {
			{ id = "exploit_infractions", label = "Infractions" },
		} },
	}

	local function renderBoards(body)
		local sys
		for _, s in ipairs(AC_SYS) do if s.id == ST.sys then sys = s end end
		if not sys then sys = AC_SYS[1] ; ST.sys = sys.id end

		local valid = false
		for _, m in ipairs(sys.metrics) do if m.id == ST.metric then valid = true end end
		if not valid then ST.metric = sys.metrics[1].id end

		local sysItems = {}
		for _, s in ipairs(AC_SYS) do table.insert(sysItems, { id = s.id, label = s.label }) end
		acTabBar(body, 0, sysItems, ST.sys, RED, function(id)
			ST.sys = id ; ST.metric = nil ; screenACBoards_new()
		end)
		acTabBar(body, 1, sys.metrics, ST.metric, sys.color, function(id)
			ST.metric = id ; screenACBoards_new()
		end)

		local isDate = false
		for _, m in ipairs(sys.metrics) do if m.id == ST.metric then isDate = m.isDate end end

		--── 🗑️ Zone dangereuse (fly uniquement), inchangée dans l'esprit ──
		if ST.sys == "fly" then
			local dz = Instance.new("Frame")
			dz.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
			dz.BackgroundTransparency = 1
			dz.LayoutOrder = 2; dz.ZIndex = 11; dz.Parent = body
			local ag = Instance.new("UIGridLayout")
			ag.CellSize = UDim2.new(0.5, -4, 1, 0)
			ag.CellPadding = UDim2.new(0, 8, 0, 0)
			ag.Parent = dz

			local function danger(order, text, actionId)
				local c = Instance.new("Frame")
				c.LayoutOrder = order; c.BackgroundTransparency = 1
				c.ZIndex = 11; c.Parent = dz
				local b, lbl = actionButton(c, { color = Color3.fromRGB(150, 40, 40),
					strokeColor = RED, text = text,
					textSize = IS_MOBILE and 10 or 12, radius = 8, zIndex = 11 })
				local armed = false
				b.MouseButton1Click:Connect(function()
					if not armed then
						armed = true ; lbl.Text = "⚠️ Appuie encore"
						task.delay(3, function()
							if lbl and lbl.Parent then armed = false ; lbl.Text = text end
						end)
						return
					end
					armed = false
					adminEvent:FireServer(actionId)
					-- ⏳ L'effacement ne peut PAS être instantané : un OrderedDataStore
					--    se vide clé par clé, et les lectures triées de Roblox mettent
					--    jusqu'à une minute à refléter les suppressions. On relit donc
					--    plusieurs fois au lieu d'annoncer une fausse fin au bout de 2 s.
					toast("Effacement lancé — ça prend jusqu'à 1 min", true)
					local steps = { 4, 10, 18, 30, 45, 60 }
					task.spawn(function()
						local t0 = os.clock()
						for i, at in ipairs(steps) do
							while os.clock() - t0 < at do
								if lbl and lbl.Parent then
									lbl.Text = string.format("⏳ %ds…",
										math.max(0, math.floor(at - (os.clock() - t0))))
								end
								task.wait(0.5)
							end
							-- Le cache client ET la relecture serveur, à chaque passe.
							CACHE.board = {}
							if currentScreen ~= "acboards" then return end
							screenACBoards_new()
							if i == #steps and lbl and lbl.Parent then
								lbl.Text = text
							end
						end
					end)
				end)
			end
			danger(1, "🗑️ Effacer les stats", "wipeflytest")
			danger(2, "🗑️ Effacer les warnings", "wipeflyreal")
		end

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 4; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Chargement...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 5; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local gb = acRemote("AdminGetACBoard")
		if not gb then
			stl.Text = "❌ AdminGetACBoard manquant — mets AdminPanel_Server à jour."
			return
		end

		local function paint(entries, testMode)
			if not status.Parent then return end
			status:Destroy()

			if ST.sys == "fly" then
				local bf = Instance.new("Frame")
				bf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
				bf.BackgroundTransparency = 1
				bf.LayoutOrder = 0; bf.ZIndex = 11; bf.Parent = holder
				label(bf, {
					text = testMode and "🧪 Données du mode shadow (rien n'a été appliqué)"
						or "🛡️ Données réelles (sanctions actives)",
					size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
					color = testMode and CYAN or ORANGE,
					textSize = IS_MOBILE and 10 or 12, zIndex = 11 })
			end

			if #entries == 0 then
				label(holder, { text = (testMode == false
					and (ST.metric == "fly_strikes" or ST.metric == "fly_kicks"))
					and "⏸️ Signaux et kicks ne sont suivis qu'en mode shadow."
					or "Aucune donnée pour ce classement.",
					size = UDim2.new(1, 0, 0, 60), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
				return
			end

			local refs, ids = {}, {}
			for i, e in ipairs(entries) do
				ids[#ids + 1] = e.userId
				if e.restricted ~= nil then CACHE.restr[e.userId] = (e.restricted == true) end
				refs[#refs + 1] = acLine(holder, i + 1, {
					userId = e.userId, rank = i, accent = sys.color,
					value = isDate
						and ((e.value and e.value > 0) and fmtAgo(e.value) or "?")
						or fmtNum(e.value),
					valueColor = sys.color,
				})
			end
			resolveAC(ids, function()
				if holder.Parent then fillLines(refs, stdSub) end
			end)

			if #entries >= ST.count and ST.count < 200 then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = holder
				local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger 50 de plus", textSize = IS_MOBILE and 11 or 13,
					radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					ST.count = ST.count + 50
					CACHE.board[ST.metric .. "_" .. ST.count] = nil
					screenACBoards_new()
				end)
			end
		end

		--  Cache de 45 s : rebasculer entre deux onglets ne relit pas le
		--  DataStore. C'est ce qui rend la navigation instantanée.
		local key = ST.metric .. "_" .. ST.count .. (ST.hideR and "_h" or "")
		local cached = CACHE.board[key]
		if cached and (os.clock() - cached.at) < CACHE.BOARD_TTL then
			paint(cached.entries, cached.testMode)
			return
		end

		task.spawn(function()
			local ok, res = pcall(function() return gb:InvokeServer(ST.metric, ST.count, ST.hideR == true) end)
			if not status.Parent then return end
			if not (ok and type(res) == "table" and type(res.entries) == "table") then
				stl.Text = "Lecture impossible. Appuie sur 🔄."
				return
			end
			CACHE.board[key] = { entries = res.entries, testMode = res.testMode, at = os.clock() }
			paint(res.entries, res.testMode)
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 🔍 ONGLET « DOSSIER »
	--════════════════════════════════════════════════════════════════
	local function renderCard(body)
		--  Recherche libre : on peut ouvrir un dossier sans passer par une liste.
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 0; sw.ZIndex = 11; sw.Parent = body

		local btnW = IS_MOBILE and 58 or 76
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.Size = UDim2.new(1, -btnW - 8, 1, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.Font = FONT
		box.PlaceholderText = "Pseudo exact ou UserID..."
		box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = ST.search or ""
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 11 or 14
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.ZIndex = 12
		box.Parent = sw
		corner(box, 8); stroke(box, CYAN, 1)
		local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box
		box:GetPropertyChangedSignal("Text"):Connect(function() ST.search = box.Text end)

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, 0, 0.5, 0)
		gc.Size = UDim2.new(0, btnW, 1, 0)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 12; gc.Parent = sw

		local function lookup()
			local q = (ST.search or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if #q < 2 then toast("Entre un pseudo ou un UserID", false) return end
			ST.cardFor = tonumber(q) or q
			ST.cardData = nil
			screenACBoards_new()
		end

		local gb2 = actionButton(gc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🔍", textSize = IS_MOBILE and 13 or 16, radius = 8, zIndex = 12 })
		gb2.MouseButton1Click:Connect(lookup)
		box.FocusLost:Connect(function(enter) if enter then lookup() end end)

		if not ST.cardFor then
			note(body, 1, "Choisis un joueur dans 📡 Récent, 🎯 Risque ou 🏆 Classements, "
				.. "ou cherche-le ici.\n\nLe dossier te donne le pourcentage de certitude, "
				.. "le détail de chaque signal, et les facteurs exacts qui l'ont fait monter "
				.. "ou descendre.", C.TEXT_DIM)
			return
		end

		if not ST.cardData and not ST.cardLoading then
			ST.cardLoading = true
			callAC("lookup", { target = ST.cardFor, deep = true }, function(res)
				ST.cardLoading = false
				ST.cardData = res or { ok = false }
				if currentScreen == "acboards" and window.Visible then
					screenACBoards_new()
				end
			end)
		end

		if not ST.cardData then
			note(body, 1, "⏳ Ouverture du dossier...", C.TEXT_GREY)
			return
		end

		local d = ST.cardData
		if not d.ok then
			note(body, 1, "❌ " .. tostring(d.msg or "Joueur introuvable"), RED)
			return
		end

		local uid  = d.userId
		local live = d.live
		local per  = d.persisted
		local conf = (type(live) == "table" and tonumber(live.confidence)) or 0

		--── En-tête ──
		local hc = Instance.new("Frame")
		hc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 84 or 104)
		hc.BackgroundColor3 = C.BG_DARK
		hc.BorderSizePixel = 0
		hc.LayoutOrder = 1
		hc.ZIndex = 12
		hc.Parent = body
		corner(hc, 10); stroke(hc, confColor(conf), 1.5)
		gradient(hc, C.BG_DARK, C.BG_ITEM)

		local avSize = IS_MOBILE and 58 or 76
		local av = makeAvatar(hc, uid, avSize, confColor(conf))
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 10, 0.5, 0)

		local ix = 10 + avSize + 12
		label(hc, { text = esc(d.name),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 20 or 26),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 8 or 12),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 15 or 19, truncate = true, zIndex = 13 })

		local p = pointsOf(uid)
		label(hc, { text = "🆔 " .. tostring(uid)
			.. (d.online and "  ·  🟢 en ligne" or "  ·  ⚪ hors ligne")
			.. (d.isAdmin and "  ·  👮 admin" or "")
			.. (p and ("  ·  💎 " .. fmtNum(p)) or ""),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 30 or 40),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 13 })

		label(hc, { text = string.format("🎯 Certitude du dossier : %d %%", conf),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 48 or 62),
			xAlign = Enum.TextXAlignment.Left, color = confColor(conf),
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })

		--── Lecture du chiffre, en français ──
		local verdict, vcol
		if conf >= 85 then
			verdict = "Dossier solide. Plusieurs signaux concordants, rien dans le contexte "
				.. "ne les explique. C'est ce niveau qui autorise une sanction automatique."
			vcol = RED
		elseif conf >= 70 then
			verdict = "Comportement anormal établi, mais pas au niveau requis pour "
				.. "sanctionner tout seul. Regarde le détail avant de trancher."
			vcol = ORANGE
		elseif conf >= 55 then
			verdict = "Signaux retenus, mais faibles. Un bug de ton obby peut produire ça. "
				.. "N'agis pas là-dessus seul — attends que ça se répète."
			vcol = GOLD
		else
			verdict = "Rien de retenu contre ce joueur. Les signaux éventuels ont été "
				.. "écartés par le filtre parce que le contexte les expliquait."
			vcol = GREEN
		end
		note(body, 2, verdict, vcol)

		--── Compteurs ──
		local _, rows = card(body, 3, "📊 SUR CE SERVEUR", CYAN)
		if type(live) == "table" then
			statLine(rows, 1, "Signaux retenus", tostring(live.counted or 0),
				(live.counted or 0) > 0 and ORANGE or GREEN)
			statLine(rows, 2, "Signaux écartés par le filtre", tostring(live.ignored or 0),
				C.TEXT_GREY)
			statLine(rows, 3, "Warnings", tostring(live.simWarnings or 0),
				(live.simWarnings or 0) > 0 and ORANGE or GREEN)
			statLine(rows, 4, "Pic de certitude", tostring(live.confMax or 0) .. " %",
				confColor(live.confMax))
			local o = 10
			for t, n in pairs(live.detections or {}) do
				o = o + 1
				statLine(rows, o, "  " .. t, tostring(n), C.TEXT_GREY)
			end
		else
			statLine(rows, 1, "Aucun signal sur ce serveur", "clean ✅", GREEN)
		end

		if type(per) == "table" then
			local pAvg = ((per.confCount or 0) > 0)
				and math.floor(per.confSum / per.confCount) or 0
			local _, prows = card(body, 4, "💾 CUMUL TOUS SERVEURS", PURPLE)
			statLine(prows, 1, "Certitude moyenne", pAvg .. " %", confColor(pAvg))
			statLine(prows, 2, "Signaux retenus", tostring(per.total or 0),
				(per.total or 0) > 0 and ORANGE or GREEN)
			statLine(prows, 3, "Signaux écartés", tostring(per.detIgnored or 0), C.TEXT_GREY)
			statLine(prows, 4, "Warnings", tostring(per.warnEvents or 0), C.TEXT_WHITE)
			statLine(prows, 5, "Kicks", tostring(per.kickEvents or 0), C.TEXT_WHITE)
			statLine(prows, 6, "Sanction finale", per.wouldBan and "🚫 oui" or "non",
				per.wouldBan and RED or GREEN)
			if per.firstSeen then
				statLine(prows, 7, "Premier signal", fmtAgo(per.firstSeen), C.TEXT_GREY)
			end
			if per.lastSeen then
				statLine(prows, 8, "Dernier signal", fmtAgo(per.lastSeen), C.TEXT_GREY)
			end
			local o = 20
			for t, n in pairs(per.detByType or {}) do
				o = o + 1
				statLine(prows, o, "  " .. t, tostring(n), C.TEXT_GREY)
			end
		end

		--── Privation en cours ──
		if d.record then
			local r = d.record
			local _, rr = card(body, 5, "🚫 PRIVÉ D'UGC", RED)
			statLine(rr, 1, "Depuis", fmtAgo(r.at or 0), C.TEXT_WHITE)
			statLine(rr, 2, "Par", tostring(r.by or "?"), C.TEXT_GREY)
			statLine(rr, 3, "Certitude au moment T",
				(r.confidence and (r.confidence .. " %")) or "—", confColor(r.confidence))
			statLine(rr, 4, "Tentatives bloquées", tostring(r.attempts or 0), C.TEXT_WHITE)
			-- 📝 V4 : la raison exacte de la sanction
			local why = r.reasonText or r.details
			if why and why ~= "" then note(rr, 5, "📝 RAISON\n" .. tostring(why), RED) end
		end

		--── 🎯 LE RAPPORT DÉTAILLÉ ──
		local rec = (type(live) == "table" and live.recent) or {}
		if #rec > 0 then
			local _, drows = card(body, 6, "🎯 CE QUE LA MACHINE A VU", ORANGE)
			note(drows, 0, "Chaque ligne « + » a fait monter la certitude, chaque ligne "
				.. "« − » l'a fait descendre. Un signal écarté (⚪) n'a rien coûté au joueur.",
				C.TEXT_DIM)

			local n = 0
			for _, e in ipairs(rec) do
				n = n + 1
				if n > 10 then break end
				local base = 100 + n * 30

				local head = (e.kind == "warning")
					and ("⚠️ WARNING " .. tostring(e.count or "?"))
					or ((e.counted and "✅ " or "⚪ ") .. tostring(e.vType))
				statLine(drows, base, head,
					((e.conf and e.conf > 0) and (e.conf .. " % · ") or "")
						.. ((e.t and fmtAgo(e.t)) or "?"),
					e.kind == "warning" and RED or (e.counted and ORANGE or C.TEXT_DIM))

				local function sub(o, txt, col)
					local fr = Instance.new("Frame")
					fr.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
					fr.BackgroundTransparency = 1
					fr.LayoutOrder = o; fr.ZIndex = 13; fr.Parent = drows
					label(fr, { text = txt, size = UDim2.fromScale(1, 1),
						xAlign = Enum.TextXAlignment.Left, color = col,
						textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
				end

				if e.details and e.details ~= "" then
					sub(base + 1, "   " .. e.details, C.TEXT_DIM)
				end
				local nf = 0
				for _, f in ipairs(e.factors or {}) do
					nf = nf + 1
					if nf > 9 then break end
					local dv = tonumber(f.delta) or 0
					sub(base + 1 + nf,
						string.format("      %s%d   %s", dv > 0 and "+" or "", dv,
							tostring(f.label or "?")),
						dv > 0 and ORANGE or GREEN)
				end
			end
		end

		--── Actions ──
		bigBtn(body, 20, "👤 Voir le profil complet", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(d.name, function() screenACBoards_new() end)
		end)

		if d.record then
			bigBtn(body, 21, "✅ Rendre l'accès UGC", GREEN, Color3.fromRGB(28, 122, 62),
				function()
					callAC("remove", { userId = uid }, function(res)
						if res and res.msg then toast(res.msg, res.ok == true) end
						ST.cardData = nil ; CACHE.restr[uid] = nil
						CACHE.board = {} ; ST.restrList = nil
						screenACBoards_new()
					end)
				end, C.BG_BLACK)
		else
			bigBtn(body, 21, "🚫 Priver d'UGC", RED, RED_D, function()
				callAC("add", { userId = uid, note = "Depuis le dossier anti-cheat" },
				function(res)
					if res and res.msg then toast(res.msg, res.ok == true) end
					ST.cardData = nil ; CACHE.restr[uid] = true
					CACHE.board = {} ; ST.restrList = nil
					screenACBoards_new()
				end)
			end, C.TEXT_WHITE)
		end

		bigBtn(body, 22, "🧹 Remettre ses compteurs à zéro", C.BG_LIGHT, C.BORDER_BRIGHT,
			function()
				callAC("clearstats", { userId = uid }, function(res)
					if res and res.msg then toast(res.msg, res.ok == true) end
					ST.cardData = nil ; CACHE.board = {}
					screenACBoards_new()
				end)
			end)
		note(body, 23, "À faire quand tu conclus à un faux positif. Sans ça, même après "
			.. "avoir levé une sanction, les anciens signaux continuent de peser sur son "
			.. "score de certitude.", C.TEXT_DIM)
	end

	--════════════════════════════════════════════════════════════════
	-- 🖥️ ÉCRAN PRINCIPAL
	--════════════════════════════════════════════════════════════════
	--════════════════════════════════════════════════════════════════
	-- 🚫 ONGLET « RESTREINTS »  (V4)
	--    Tous les joueurs privés d'UGC, avec la RAISON EXACTE de la
	--    sanction. Ils sortent des classements et arrivent ici.
	--    Recherche : pseudo, UserId, admin, ou mot de la raison.
	--════════════════════════════════════════════════════════════════
	local TYPE_FR_R = { FLY_STATE = "vol", FLY_HOVER = "vol stationnaire",
		FLY_ASCENT = "montée sans appui", FLY_UPSPEED = "montée trop rapide",
		TELEPORT = "téléportation", SPEED = "vitesse anormale" }

	local function reasonOf(r)
		if type(r.reasonText) == "string" and r.reasonText ~= "" then return r.reasonText end
		local d = tostring(r.details or "")
		if d == "" then d = tostring(r.reason or "?") end
		return d
	end

	local function restrictedCard(holder, order, rec)
		local uid = rec.userId
		local col = rec.auto and RED or PURPLE
		local name = rec.name or nameOf(uid) or ("UserId " .. tostring(uid))
		local _, rows = card(holder, order, (rec.auto and "🤖 " or "👮 ") .. esc(name), col)

		statLine(rows, 1, "🆔 UserId", tostring(uid), C.TEXT_GREY)
		statLine(rows, 2, "📅 Restreint",
			os.date("!%d/%m/%Y %H:%M", rec.at or 0) .. " UTC · " .. fmtAgo(rec.at or 0), C.TEXT_WHITE)
		statLine(rows, 3, "👮 Par", rec.auto and "anti-cheat (auto)" or tostring(rec.by or "?"), C.TEXT_GREY)
		if rec.confidence then
			statLine(rows, 4, "🎯 Certitude", tostring(rec.confidence) .. " %", confColor(rec.confidence))
		end
		statLine(rows, 5, "📊 Au moment T", string.format("%d warning(s) · %d détection(s)",
			rec.warnings or 0, rec.detections or 0), C.TEXT_GREY)
		if (rec.attempts or 0) > 0 then
			statLine(rows, 6, "🔁 Achats bloqués", tostring(rec.attempts), ORANGE)
		end
		if rec.until_ then
			statLine(rows, 7, "⏳ Fin", os.date("!%d/%m/%Y %H:%M", rec.until_) .. " UTC", GOLD)
		end
		statLine(rows, 8, "👁️ Panneau vu par le joueur", rec.noticeShown and "oui" or "pas encore",
			rec.noticeShown and GREEN or C.TEXT_GREY)
		if (rec.leaks or 0) > 0 then
			statLine(rows, 9, "🚨 UGC reçue(s) malgré la sanction", tostring(rec.leaks), RED)
		end

		note(rows, 10, "📝 RAISON\n" .. reasonOf(rec), col)

		if type(rec.signals) == "table" and #rec.signals > 0 then
			local lines = {}
			for _, sg in ipairs(rec.signals) do
				if type(sg) == "table" then
					table.insert(lines, string.format("• %s · %s — %s (%s %%)",
						sg.t and os.date("!%d/%m %H:%M", sg.t) or "?",
						TYPE_FR_R[sg.type] or tostring(sg.type or "?"),
						tostring(sg.details or ""), tostring(sg.conf or "?")))
				end
			end
			note(rows, 11, "🧾 Derniers signaux retenus\n" .. table.concat(lines, "\n"), C.TEXT_GREY)
		end

		local acts = Instance.new("Frame")
		acts.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 36)
		acts.BackgroundTransparency = 1
		acts.LayoutOrder = 12; acts.ZIndex = 13; acts.Parent = rows
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(0.5, -4, 1, 0)
		g.CellPadding = UDim2.new(0, 8, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = acts

		local c1 = Instance.new("Frame")
		c1.LayoutOrder = 1; c1.BackgroundTransparency = 1; c1.ZIndex = 13; c1.Parent = acts
		local b1 = actionButton(c1, { color = CYAN, strokeColor = Color3.fromRGB(30, 100, 150),
			text = "🔍 Dossier", textSize = IS_MOBILE and 10 or 12, radius = 8, zIndex = 13 })
		b1.MouseButton1Click:Connect(function()
			ST.tab = "card" ; ST.cardFor = uid ; ST.cardData = nil
			screenACBoards_new()
		end)

		local c2 = Instance.new("Frame")
		c2.LayoutOrder = 2; c2.BackgroundTransparency = 1; c2.ZIndex = 13; c2.Parent = acts
		local b2, l2 = actionButton(c2, { color = GREEN, strokeColor = Color3.fromRGB(28, 122, 62),
			text = "✅ Lever", textColor = C.BG_BLACK, textSize = IS_MOBILE and 10 or 12,
			radius = 8, zIndex = 13 })
		local armed = false
		b2.MouseButton1Click:Connect(function()
			if not armed then
				armed = true
				if l2 then l2.Text = "⚠️ Confirmer" end
				task.delay(3, function()
					armed = false
					if l2 and l2.Parent then l2.Text = "✅ Lever" end
				end)
				return
			end
			armed = false
			callAC("remove", { userId = uid }, function(res)
				if res and res.msg then toast(res.msg, res.ok == true) end
				ST.restrList = nil ; CACHE.board = {} ; CACHE.restr[uid] = nil
				screenACBoards_new()
			end)
		end)
	end

	local function renderRestricted(body)
		local gr = acRemote("AdminGetUGCRestrict")
		if not gr then
			note(body, 0, "❌ AntiCheat_UGCRestrict manquant côté serveur.", RED)
			return
		end

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 0; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Lecture de la liste...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local function paint(entries)
			if not status.Parent then return end
			status:Destroy()
			local auto, manual = 0, 0
			for _, r in ipairs(entries) do
				if r.auto then auto = auto + 1 else manual = manual + 1 end
			end
			note(body, 1, string.format(
				"🚫 %d joueur(s) privé(s) d'UGC  ·  🤖 %d par l'anti-cheat  ·  👮 %d à la main\n\n"
					.. "Ils ne sont plus dans les classements : ils sont ici. Chaque fiche "
					.. "donne la raison exacte (type, mesure, position, outil en main, "
					.. "certitude) et les derniers signaux retenus.", #entries, auto, manual), PURPLE)

			local sw = Instance.new("Frame")
			sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
			sw.BackgroundTransparency = 1
			sw.LayoutOrder = 2; sw.ZIndex = 11; sw.Parent = body
			local sb = Instance.new("TextBox")
			sb.Size = UDim2.new(1, 0, 1, 0)
			sb.BackgroundColor3 = C.BG_DARK
			sb.BorderSizePixel = 0
			sb.Font = FONT
			sb.PlaceholderText = "🔍 Pseudo, UserID, admin, ou mot de la raison (vol, téléport…)"
			sb.PlaceholderColor3 = C.TEXT_DIM
			sb.Text = ST.restrSearch or ""
			sb.TextColor3 = C.TEXT_WHITE
			sb.TextSize = IS_MOBILE and 11 or 14
			sb.TextXAlignment = Enum.TextXAlignment.Left
			sb.ClearTextOnFocus = false
			sb.ZIndex = 12
			sb.Parent = sw
			corner(sb, 8); stroke(sb, PURPLE, 1)
			local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sb

			local holder = Instance.new("Frame")
			holder.Size = UDim2.new(1, 0, 0, 0)
			holder.AutomaticSize = Enum.AutomaticSize.Y
			holder.BackgroundTransparency = 1
			holder.LayoutOrder = 3; holder.ZIndex = 11; holder.Parent = body
			local hl = Instance.new("UIListLayout")
			hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
			hl.SortOrder = Enum.SortOrder.LayoutOrder
			hl.Parent = holder

			local function draw()
				for _, ch in ipairs(holder:GetChildren()) do
					if not ch:IsA("UIListLayout") then ch:Destroy() end
				end
				local q = tostring(ST.restrSearch or ""):lower()
				local list = {}
				for _, r in ipairs(entries) do
					local ok = true
					if #q > 0 then
						local hay = table.concat({
							tostring(r.name or ""), tostring(nameOf(r.userId) or ""),
							tostring(r.userId), tostring(r.by or ""),
							reasonOf(r), tostring(r.details or ""),
						}, " "):lower()
						ok = hay:find(q, 1, true) ~= nil
					end
					if ok then table.insert(list, r) end
				end
				table.sort(list, function(a, b) return (a.at or 0) > (b.at or 0) end)
				if #list == 0 then
					label(holder, { text = (#entries == 0)
						and "✅ Personne n'est privé d'UGC pour l'instant."
						or "Rien ne correspond à cette recherche.",
						size = UDim2.new(1, 0, 0, 60), wrapped = true,
						color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
					return
				end
				--  On n'affiche que les 40 premiers : la recherche sert pour le reste.
				for i = 1, math.min(#list, 40) do restrictedCard(holder, i, list[i]) end
				if #list > 40 then
					label(holder, { text = string.format("… et %d autre(s). Affine la recherche.", #list - 40),
						size = UDim2.new(1, 0, 0, 30), color = C.TEXT_DIM,
						textSize = IS_MOBILE and 10 or 12, zIndex = 11 }).LayoutOrder = 9999
				end
			end
			sb:GetPropertyChangedSignal("Text"):Connect(function()
				ST.restrSearch = sb.Text ; draw()
			end)
			draw()
		end

		if ST.restrList and (os.clock() - (ST.restrAt or 0)) < 30 then
			paint(ST.restrList)
			return
		end
		task.spawn(function()
			local ok, res = pcall(function() return gr:InvokeServer(true, false) end)
			if not status.Parent then return end
			if not (ok and type(res) == "table" and res.ok) then
				stl.Text = "Lecture impossible. Appuie sur 🔄."
				return
			end
			ST.restrList = res.entries or {}
			ST.restrAt = os.clock()
			paint(ST.restrList)
		end)
	end

	screenACBoards_new = function(a)
		currentScreen = "acboards"

		--  Compat : l'ancien code appelait screenACBoards("fly", "fly_warnings", 50).
		--  On accepte ces appels sans rien casser.
		if a == "fly" or a == "smart" or a == "exploit" then
			ST.sys = a ; ST.metric = nil ; ST.tab = "boards"
		elseif a == "feed" or a == "risk" or a == "boards" or a == "card" or a == "restricted" then
			ST.tab = a
		end

		local body = buildScreen("🚨 ANTI-CHEAT", true, RED, nil, function()
			--  🔄 vide tous les caches : c'est le seul chemin qui relit
			--  vraiment le DataStore.
			CACHE.board = {} ; CACHE.pts = {} ; CACHE.ban = {} ; CACHE.restr = {}
			ST.cardData = nil ; ST.entries = nil ; ST.restrList = nil
			screenACBoards_new()
		end)

		acTabBar(body, -3, {
			{ id = "feed", label = "📡 Récent" },
			{ id = "risk", label = "🎯 Risque" },
			{ id = "restricted", label = "🚫 Restreints" },
		}, ST.tab, RED, function(id) ST.tab = id ; screenACBoards_new() end)

		acTabBar(body, -2, {
			{ id = "boards", label = "🏆 Classements" },
			{ id = "card",   label = "🔍 Dossier" },
		}, ST.tab, RED, function(id) ST.tab = id ; screenACBoards_new() end)

		--  🙈 V4 : masquer / afficher les joueurs restreints dans les listes
		if ST.tab == "feed" or ST.tab == "risk" or ST.tab == "boards" then
			local hb = Instance.new("Frame")
			hb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
			hb.BackgroundTransparency = 1
			hb.LayoutOrder = -1 ; hb.ZIndex = 11 ; hb.Parent = body
			local on = ST.hideR == true
			local hbtn = actionButton(hb, {
				color = on and PURPLE or C.BG_DARK, strokeColor = PURPLE,
				text = on and "🙈 Restreints masqués (liste complétée) — Afficher"
					or "🚫 Masquer les restreints et compléter la liste",
				textColor = on and Color3.new(0, 0, 0) or C.TEXT_WHITE,
				textSize = IS_MOBILE and 10 or 13, radius = 9, zIndex = 12 })
			hbtn.MouseButton1Click:Connect(function()
				ST.hideR = not on
				CACHE.board = {}
				screenACBoards_new()
			end)
		end

		if ST.tab == "restricted" then
			renderRestricted(body)
		elseif ST.tab == "risk" then
			renderRisk(body)
		elseif ST.tab == "boards" then
			renderBoards(body)
		elseif ST.tab == "card" then
			renderCard(body)
		else
			renderFeed(body)
		end
	end

	--  🔁 On remplace la fonction d'origine. Le dispatch de l'accueil
	--     (openAction → screenACBoards) pointe sur une variable locale du
	--     script principal : en la réassignant ici, tous les appels — y
	--     compris ceux déjà écrits dans ton ancien code — arrivent sur la
	--     nouvelle version.
	screenACBoards = screenACBoards_new
end)()

--════════════════════════════════════════════════════════════════════════════
-- ⚙️ BLOC 10 — PARAMÈTRES PAR MODE  +  MESSAGES AUX JOUEURS
--
--  📍 OÙ COLLER ?
--     Dans ton LocalScript « ADMIN PANEL — CLIENT », tout à la fin,
--     JUSTE AVANT la ligne :
--         print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")
--
--     APRÈS le bloc 8 (🚫 UGC BAN) et le bloc 9 (🛡️ ANTI-CHEAT).
--     Rien à supprimer, rien à modifier ailleurs.
--
--  C'est une IIFE : zéro variable locale ajoutée au script principal.
--
--  Ajoute une entrée « ⚙️ MODES & MSG » sur l'ACCUEIL, avec deux sections :
--
--     ⚙️ MODES     — chaque mode a sa fiche complète et indépendante :
--                    🔨 Ban  / 🚫 UGC  / 🧪 Test (shadow)
--                    Tu peux régler le mode ban pendant que tu tournes en
--                    mode ugc : les trois fiches vivent en même temps, seul
--                    le mode sélectionné s'applique.
--
--     💬 MESSAGES  — le texte exact que voit le joueur :
--                    après plusieurs détections (carte orange),
--                    après un warning officiel (carte rouge),
--                    au moment de la privation,
--                    quand il clique sur Acheter et que c'est refusé,
--                    au moment du ban.
--                    Avec variables ({warnings}, {max}, {left}…) et aperçu.
--
--  Prérequis serveur : AntiCheat_UGCRestrict.server.lua à jour
--  (celui qui contient la section `modes = { … }` et `messages = { … }`).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local RED     = Color3.fromRGB(235, 60, 65)
	local RED_D   = Color3.fromRGB(140, 25, 30)
	local ORANGE  = Color3.fromRGB(255, 170, 60)
	local ORANGE_D= Color3.fromRGB(150, 95, 20)
	local GREEN   = Color3.fromRGB(55, 195, 100)
	local GREEN_D = Color3.fromRGB(28, 122, 62)
	local CYAN    = Color3.fromRGB(110, 200, 255)
	local CYAN_D  = Color3.fromRGB(30, 110, 155)
	local VIOLET  = Color3.fromRGB(175, 140, 255)

	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	local S = {
		cfg     = nil,      -- config serveur telle que reçue
		draft   = nil,      -- copie locale en cours d'édition
		loading = false,
		failed  = false,
		failMsg = nil,
		tab     = "modes",  -- "modes" | "messages"
		mode    = "ugc",    -- fiche affichée : "ban" | "ugc" | "test"
		msgTab  = "detect", -- "detect" | "warn" | "sanction" | "shop"
		dirty   = false,    -- des changements non enregistrés ?
	}

	local screen  -- forward decl

	--════════════════════════════════════════════════════════════════════
	-- 🧱 COMPOSANTS
	--════════════════════════════════════════════════════════════════════
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.Gotham
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	local function card(parent, order, title, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 10); stroke(f, color, 1)
		label(f, { text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 5), xAlign = Enum.TextXAlignment.Left,
			color = color, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })
		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 25 or 30)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = f
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 5); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = rows
		local p = Instance.new("UIPadding")
		p.PaddingBottom = UDim.new(0, 9)
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10)
		p.Parent = rows
		return f, rows
	end

	local function bigBtn(parent, order, text, col, colD, fn, textCol)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 50)
		c.BackgroundTransparency = 1
		c.LayoutOrder = order
		c.ZIndex = 11
		c.Parent = parent
		local b = actionButton(c, { color = col, strokeColor = colD, text = text,
			textColor = textCol, textSize = IS_MOBILE and 13 or 16, radius = 10, zIndex = 11 })
		b.MouseButton1Click:Connect(fn)
		return b
	end

	--════════════════════════════════════════════════════════════════════
	-- 📡 APPELS SERVEUR
	--    Même correctif que le bloc 8 : une limitation de débit renvoie
	--    `throttled` et on réessaie tout seul, au lieu d'afficher une
	--    fausse erreur et de se bloquer.
	--════════════════════════════════════════════════════════════════════
	local function callAct(action, payload, onDone, attempt)
		local fn = remote("AdminUGCRestrictAction")
		if not fn then toast("Module serveur pas installé", false) return end
		attempt = attempt or 1
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" and res.throttled then
				if attempt < 3 then
					task.wait(0.35 * attempt)
					callAct(action, payload, onDone, attempt + 1)
				else
					toast("Le serveur est saturé, réessaie dans un instant", false)
					if onDone then onDone(nil) end
				end
				return
			end
			if ok and type(res) == "table" then
				if res.msg then toast(res.msg, res.ok == true) end
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

	--════════════════════════════════════════════════════════════════════
	-- 🗂️ BROUILLON
	--
	--    On édite une COPIE locale, et on n'envoie au serveur que lorsque
	--    tu cliques sur ENREGISTRER. Deux raisons :
	--      • une écriture DataStore par clic de bouton, c'était exactement
	--        ce qui déclenchait « tu vas trop vite » ;
	--      • tu peux modifier plusieurs réglages puis annuler d'un coup.
	--════════════════════════════════════════════════════════════════════
	local DEF_MODES = {
		ban = { warningsToPunish = 3, kickBeforeBan = true, banDays = 0,
			alsoRestrictUGC = true, wipePoints = false, notifyBeforeKick = true },
		ugc = { warningsToPunish = 1, durationHours = 0, kickOnPunish = false,
			notifyOnPunish = true, remindOnJoin = false, blockGifts = true,
			blockRebirth = false, revealOnlyWhenAffordable = true },
		test = { correctPosition = false, notifyPlayer = false, logToConsole = true,
			separateStore = true, suggestAfterDays = 5 },
	}

	local function deepCopy(t)
		if type(t) ~= "table" then return t end
		local o = {}
		for k, v in pairs(t) do o[k] = deepCopy(v) end
		return o
	end

	--  Le brouillon est TOUJOURS complet : si le serveur tourne encore une
	--  ancienne config sans la section `modes`, on la reconstitue à partir
	--  des défauts. Comme ça le panel ne peut pas afficher un champ vide ni
	--  envoyer une config trouée.
	local function ensureDraft()
		if S.draft then return S.draft end
		local base = deepCopy(S.cfg or {})
		base.modes = base.modes or {}
		for name, def in pairs(DEF_MODES) do
			base.modes[name] = base.modes[name] or {}
			for k, v in pairs(def) do
				if base.modes[name][k] == nil then base.modes[name][k] = v end
			end
		end
		base.messages = base.messages or {}
		S.draft = base
		return base
	end

	local function setDraft(path, value)
		local d = ensureDraft()
		local t = d
		for i = 1, #path - 1 do
			t[path[i]] = t[path[i]] or {}
			t = t[path[i]]
		end
		t[path[#path]] = value
		S.dirty = true
	end

	local function getDraft(path, fallback)
		local t = ensureDraft()
		for i = 1, #path do
			if type(t) ~= "table" then return fallback end
			t = t[path[i]]
		end
		if t == nil then return fallback end
		return t
	end

	local function saveDraft()
		local d = ensureDraft()
		callAct("setconfig", { config = d }, function(res)
			if res and res.ok then
				S.cfg, S.draft, S.dirty = nil, nil, false
				S.failed, S.failMsg = false, nil
				toast("✅ Réglages enregistrés et diffusés à tous tes serveurs", true)
			end
			screen(false)
		end)
	end

	--════════════════════════════════════════════════════════════════════
	-- 🎛️ LIGNES DE RÉGLAGE
	--════════════════════════════════════════════════════════════════════
	local function toggleRow(parent, order, opt)
		local v = opt.value == true
		local onCol = opt.onColor or GREEN

		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.Text = ""
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 9); stroke(row, v and onCol or C.BORDER_SUBTLE, v and 1.5 or 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 3); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = row
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 6); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = row

		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 24 or 28)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = row

		label(head, { text = opt.title, size = UDim2.new(1, -58, 1, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 13 })

		local pill = Instance.new("Frame")
		pill.AnchorPoint = Vector2.new(1, 0.5)
		pill.Position = UDim2.new(1, 0, 0.5, 0)
		pill.Size = UDim2.new(0, IS_MOBILE and 46 or 54, 0, IS_MOBILE and 20 or 24)
		pill.BackgroundColor3 = v and onCol or C.BG_LIGHT
		pill.BorderSizePixel = 0
		pill.ZIndex = 13; pill.Parent = head
		corner(pill, 999)
		label(pill, { text = v and "ON" or "OFF", size = UDim2.fromScale(1, 1),
			color = v and Color3.new(0, 0, 0) or C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, zIndex = 14 })

		if opt.desc then
			local d = Instance.new("TextLabel")
			d.Size = UDim2.new(1, 0, 0, 0)
			d.AutomaticSize = Enum.AutomaticSize.Y
			d.BackgroundTransparency = 1
			d.Font = Enum.Font.Gotham
			d.Text = opt.desc
			d.TextColor3 = opt.descColor or C.TEXT_DIM
			d.TextSize = IS_MOBILE and 9 or 11
			d.TextWrapped = true
			d.TextXAlignment = Enum.TextXAlignment.Left
			d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = row
		end

		row.MouseButton1Click:Connect(function()
			setDraft(opt.path, not v)
			screen(false)
		end)
		return row
	end

	local function stepper(parent, order, opt)
		local value = tonumber(opt.value) or opt.min
		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, 0)
		wrap.AutomaticSize = Enum.AutomaticSize.Y
		wrap.BackgroundColor3 = C.BG_DARK
		wrap.BorderSizePixel = 0
		wrap.LayoutOrder = order
		wrap.ZIndex = 11
		wrap.Parent = parent
		corner(wrap, 9); stroke(wrap, opt.color or CYAN, 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 3); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = wrap
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 6); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = wrap

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 36)
		row.BackgroundTransparency = 1
		row.LayoutOrder = 1; row.ZIndex = 12; row.Parent = wrap

		label(row, { text = opt.title, size = UDim2.new(1, -(IS_MOBILE and 132 or 160), 1, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 13 })

		--  Disposition, alignée à droite : [ − ] [ valeur ] [ + ]
		--  Les décalages sont calculés dans des variables nommées, jamais
		--  inline : `bw + IS_MOBILE and 58 or 70` s'évalue en
		--  `(bw + IS_MOBILE) and 58 or 70` et fait une addition sur un
		--  booléen. C'est le genre d'erreur qui ne se voit qu'à l'exécution.
		local bw    = IS_MOBILE and 32 or 38     -- largeur d'un bouton
		local vw    = IS_MOBILE and 58 or 68     -- largeur de la valeur
		local gap   = 4
		local plusX  = 0                          -- collé à droite
		local valX   = plusX - bw - gap
		local minusX = valX - vw - gap

		local function side(isPlus, offset)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, offset, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 26 or 30)
			c.BackgroundTransparency = 1
			c.ZIndex = 13; c.Parent = row
			local b = actionButton(c, {
				color = isPlus and GREEN or C.BG_LIGHT,
				strokeColor = isPlus and GREEN_D or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 15 or 19, radius = 7, zIndex = 13 })
			b.MouseButton1Click:Connect(function()
				local step = opt.step or 1
				setDraft(opt.path, math.clamp(value + (isPlus and step or -step),
					opt.min, opt.max))
				screen(false)
			end)
		end
		side(true,  plusX)
		side(false, minusX)

		--  ✍️ V4 : la valeur est une CASE : touche-la et tape le nombre que tu veux
		--     (ex : 100), puis Entrée. Les boutons − / + marchent toujours.
		local vb = Instance.new("TextBox")
		vb.AnchorPoint = Vector2.new(1, 0.5)
		vb.Position = UDim2.new(1, valX, 0.5, 0)
		vb.Size = UDim2.new(0, vw, 0, IS_MOBILE and 26 or 30)
		vb.BackgroundColor3 = C.BG_ITEM
		vb.BorderSizePixel = 0
		vb.Font = FONT
		vb.Text = opt.format and opt.format(value) or tostring(value)
		vb.TextColor3 = opt.color or CYAN
		vb.TextSize = IS_MOBILE and 12 or 15
		vb.ClearTextOnFocus = false
		vb.ZIndex = 13
		vb.Parent = row
		corner(vb, 6); stroke(vb, opt.color or CYAN, 1)
		vb.Focused:Connect(function() vb.Text = tostring(value) end)
		vb.FocusLost:Connect(function()
			local n = tonumber((vb.Text:gsub("[^%d%.%-]", "")))
			if n then
				n = math.clamp(math.floor(n + 0.5), opt.min, opt.max)
				if n ~= value then
					setDraft(opt.path, n)
					screen(false)
					return
				end
			end
			vb.Text = opt.format and opt.format(value) or tostring(value)
		end)

		if opt.desc then
			local d = Instance.new("TextLabel")
			d.Size = UDim2.new(1, 0, 0, 0)
			d.AutomaticSize = Enum.AutomaticSize.Y
			d.BackgroundTransparency = 1
			d.Font = Enum.Font.Gotham
			d.Text = opt.desc
			d.TextColor3 = C.TEXT_DIM
			d.TextSize = IS_MOBILE and 9 or 11
			d.TextWrapped = true
			d.TextXAlignment = Enum.TextXAlignment.Left
			d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = wrap
		end
		return wrap
	end

	--════════════════════════════════════════════════════════════════════
	-- ✍️ CHAMP DE TEXTE MULTILIGNE
	--
	--    On n'enregistre PAS à chaque frappe : on écrit dans le brouillon
	--    quand tu quittes le champ (FocusLost). Sinon chaque lettre tapée
	--    déclencherait un re-rendu et tu perdrais le curseur.
	--════════════════════════════════════════════════════════════════════
	local function textField(parent, order, opt)
		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, 0)
		wrap.AutomaticSize = Enum.AutomaticSize.Y
		wrap.BackgroundColor3 = C.BG_DARK
		wrap.BorderSizePixel = 0
		wrap.LayoutOrder = order
		wrap.ZIndex = 11
		wrap.Parent = parent
		corner(wrap, 9); stroke(wrap, opt.color or VIOLET, 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 5); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = wrap
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 7); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = wrap

		label(wrap, { text = opt.title,
			size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = opt.color or VIOLET,
			textSize = IS_MOBILE and 10 or 13, zIndex = 12 })

		if opt.desc then
			local d = Instance.new("TextLabel")
			d.Size = UDim2.new(1, 0, 0, 0)
			d.AutomaticSize = Enum.AutomaticSize.Y
			d.BackgroundTransparency = 1
			d.Font = Enum.Font.Gotham
			d.Text = opt.desc
			d.TextColor3 = C.TEXT_DIM
			d.TextSize = IS_MOBILE and 9 or 11
			d.TextWrapped = true
			d.TextXAlignment = Enum.TextXAlignment.Left
			d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = wrap
		end

		local boxH = opt.multiline and (IS_MOBILE and 96 or 120) or (IS_MOBILE and 30 or 36)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, boxH)
		holder.BackgroundColor3 = C.BG_LIGHT
		holder.BorderSizePixel = 0
		holder.LayoutOrder = 3; holder.ZIndex = 12; holder.Parent = wrap
		corner(holder, 7); stroke(holder, C.BORDER_SUBTLE, 1)

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, -14, 1, -10)
		box.Position = UDim2.new(0, 7, 0, 5)
		box.BackgroundTransparency = 1
		box.Font = Enum.Font.Gotham
		box.Text = tostring(opt.value or "")
		box.PlaceholderText = opt.placeholder or "(vide = texte par défaut)"
		box.TextColor3 = C.TEXT_WHITE
		box.PlaceholderColor3 = C.TEXT_DIM
		box.TextSize = IS_MOBILE and 10 or 12
		box.TextWrapped = true
		box.ClearTextOnFocus = false
		box.MultiLine = opt.multiline == true
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = opt.multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
		box.ZIndex = 13
		box.Parent = holder

		--  On n'écrit dans le brouillon qu'à la sortie du champ : pas de
		--  re-rendu pendant la frappe, donc pas de curseur qui saute.
		box.FocusLost:Connect(function()
			local v = box.Text
			if #v > 1200 then
				v = v:sub(1, 1200)
				box.Text = v
				toast("Texte coupé à 1200 caractères", false)
			end
			if v ~= tostring(opt.value or "") then
				setDraft(opt.path, v)
				--  Re-rendu différé : laisse le clavier mobile se fermer
				--  proprement avant qu'on redessine l'écran.
				task.defer(function() screen(false) end)
			end
		end)
		return box
	end

	--════════════════════════════════════════════════════════════════════
	-- 👁️ APERÇU — rendu identique à celui du serveur
	--    Les mêmes variables, les mêmes règles. Ce que tu lis ici est
	--    exactement ce que le joueur verra, à un détail près : ici on
	--    affiche toujours {confidence}, pour que tu puisses vérifier ta
	--    phrase même quand tu as choisi de la cacher aux joueurs.
	--════════════════════════════════════════════════════════════════════
	local SAMPLE = {
		player = "SomePlayer", type = "TELEPORT", typefr = "téléportation",
		warnings = "1", max = "2", left = "1", confidence = "88", game = "ton obby",
	}
	local function preview(tpl)
		if type(tpl) ~= "string" or tpl == "" then return "(vide → texte par défaut)" end

		--  🔐 On reproduit EXACTEMENT la règle du serveur : quand l'affichage
		--     de la certitude est coupé, la ligne qui contient {confidence}
		--     est retirée en entier. Sans ça, l'aperçu te montrerait un texte
		--     que le joueur ne verra jamais — le pire défaut possible pour
		--     un aperçu.
		if getDraft({ "messages", "showConfidenceToPlayer" }, false) ~= true
			and tpl:find("{confidence}", 1, true) then
			local kept = {}
			for line in (tpl .. "\n"):gmatch("([^\n]*)\n") do
				if not line:find("{confidence}", 1, true) then
					table.insert(kept, line)
				end
			end
			tpl = table.concat(kept, "\n")
			tpl = tpl:gsub("\n\n\n+", "\n\n"):gsub("^%s*\n", "")
		end

		local out = tpl:gsub("{(%w+)}", function(k)
			return SAMPLE[k] or ("{" .. k .. "}")
		end)
		return (out:gsub("\\n", "\n"))
	end

	local function previewBox(parent, order, tpl)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = Color3.fromRGB(24, 12, 12)
		f.BorderSizePixel = 0
		f.LayoutOrder = order; f.ZIndex = 11; f.Parent = parent
		corner(f, 8); stroke(f, RED_D, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 8)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.Gotham
		l.Text = "👁️ CE QUE LE JOUEUR LIT\n\n" .. preview(tpl)
		l.TextColor3 = Color3.fromRGB(245, 215, 215)
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12; l.Parent = f
		return f
	end

	--════════════════════════════════════════════════════════════════════
	-- ⚙️ SECTION MODES
	--════════════════════════════════════════════════════════════════════
	local function modePicker(parent, order)
		local d = ensureDraft()
		local active = d.mode or "ugc"
		local shadow = d.shadow == true

		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		wrap.BackgroundTransparency = 1
		wrap.LayoutOrder = order; wrap.ZIndex = 11; wrap.Parent = parent

		local items = {
			{ id = "ban",  txt = "🔨 Ban",  col = ORANGE, colD = ORANGE_D },
			{ id = "ugc",  txt = "🚫 UGC",  col = RED,    colD = RED_D },
			{ id = "test", txt = "🧪 Test", col = CYAN,   colD = CYAN_D },
		}
		for i, it in ipairs(items) do
			local c = Instance.new("Frame")
			c.Size = UDim2.new(1 / 3, -5, 1, 0)
			c.Position = UDim2.new((i - 1) / 3, i == 1 and 0 or 3, 0, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = wrap

			--  La fiche affichée n'est pas forcément le mode actif : tu peux
			--  préparer le mode ban pendant que tu tournes en ugc.
			local shown = (S.mode == it.id)
			--  Un liseré plein signale le mode réellement en vigueur.
			local live = (it.id == "test") and shadow or (it.id == active and not shadow)

			local b = actionButton(c, {
				color = shown and it.col or C.BG_DARK,
				strokeColor = live and it.col or C.BORDER_SUBTLE,
				text = it.txt .. (live and "  ●" or ""),
				textColor = shown and Color3.new(0, 0, 0) or C.TEXT_GREY,
				textSize = IS_MOBILE and 11 or 13, radius = 9, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				S.mode = it.id
				screen(false)
			end)
		end
		return wrap
	end

	local function sectionModes(body)
		local d = ensureDraft()
		local active = d.mode or "ugc"
		local shadow = d.shadow == true

		note(body, 1,
			"📄 Tous ces réglages sont aussi dans ServerScriptService ▸ ANTICHEAT_CONFIG "
				.. "(fichier VERSION " .. tostring(d.fileVersion or "?") .. "). Ce que tu "
				.. "enregistres ICI s'applique tout de suite et reste actif tant que tu ne "
				.. "montes pas VERSION dans le fichier.\n\n"
				.. "Chaque mode a sa fiche complète, et les trois vivent en même temps. "
				.. "Tu peux régler le mode ban pendant que tu tournes en mode UGC : "
				.. "seule la fiche du mode SÉLECTIONNÉ ci-dessous s'applique.\n\n"
				.. "Le point ● marque ce qui est réellement en vigueur en ce moment.",
			C.TEXT_GREY)

		modePicker(body, 2)

		--──────────────────────────────────────────────────────────────
		-- Choix du mode actif + shadow
		--──────────────────────────────────────────────────────────────
		local _, actRows = card(body, 3, "🎚️ CE QUI TOURNE EN CE MOMENT", CYAN)

		local pickWrap = Instance.new("Frame")
		pickWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
		pickWrap.BackgroundTransparency = 1
		pickWrap.LayoutOrder = 1; pickWrap.ZIndex = 12; pickWrap.Parent = actRows
		for i, it in ipairs({
			{ id = "ugc", txt = "🚫 Privation d'UGC", col = RED,    colD = RED_D },
			{ id = "ban", txt = "🔨 Ban classique",   col = ORANGE, colD = ORANGE_D },
			}) do
			local c = Instance.new("Frame")
			c.Size = UDim2.new(0.5, -4, 1, 0)
			c.Position = UDim2.new((i - 1) * 0.5, i == 1 and 0 or 4, 0, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 13; c.Parent = pickWrap
			local on = (active == it.id)
			local b = actionButton(c, {
				color = on and it.col or C.BG_DARK,
				strokeColor = on and it.col or C.BORDER_SUBTLE,
				text = it.txt, textColor = on and Color3.new(0, 0, 0) or C.TEXT_GREY,
				textSize = IS_MOBILE and 10 or 13, radius = 8, zIndex = 13 })
			b.MouseButton1Click:Connect(function()
				setDraft({ "mode" }, it.id)
				S.mode = it.id
				screen(false)
			end)
		end

		toggleRow(actRows, 2, {
			title = "🧪 Mode test (shadow) par-dessus",
			value = shadow, onColor = CYAN, path = { "shadow" },
			desc = shadow
				and "ACTIF — rien n'est appliqué. Aucun ban, aucun kick, aucune privation. "
				.. "Tout est mesuré et enregistré, et le panel te montre ce qui SERAIT arrivé. "
				.. "C'est le seul état où tu ne peux pas faire de mal à un joueur honnête."
				or "COUPÉ — les sanctions du mode choisi s'appliquent pour de vrai.",
			descColor = shadow and CYAN or ORANGE,
		})

		--──────────────────────────────────────────────────────────────
		-- Fiche du mode sélectionné
		--──────────────────────────────────────────────────────────────
		if S.mode == "ban" then
			local _, rows = card(body, 10, "🔨 FICHE DU MODE BAN", ORANGE)

			stepper(rows, 1, {
				title = "Warnings avant le ban",
				value = getDraft({ "modes", "ban", "warningsToPunish" }, 3),
				path = { "modes", "ban", "warningsToPunish" },
				min = 1, max = 1000, step = 1, color = ORANGE,
				desc = "Rappel de l'échelle : 3 détections comptées et rapprochées = "
					.. "1 warning. Un seuil à 3 warnings, c'est donc un comportement "
					.. "répété sur plusieurs minutes, pas un accident.",
			})

			stepper(rows, 2, {
				title = "Durée du ban",
				value = getDraft({ "modes", "ban", "banDays" }, 0),
				path = { "modes", "ban", "banDays" },
				min = 0, max = 365, step = 1, color = ORANGE,
				format = function(v) return v == 0 and "définitif" or (v .. " j") end,
				desc = "0 = définitif. Sinon la date de fin est figée AU MOMENT du ban : "
					.. "si tu changes cette durée plus tard, les bans déjà posés gardent "
					.. "la leur — tu ne prolonges personne sans le vouloir.",
			})

			toggleRow(rows, 3, {
				title = "Kick d'avertissement avant le ban",
				value = getDraft({ "modes", "ban", "kickBeforeBan" }, true) == true,
				onColor = ORANGE, path = { "modes", "ban", "kickBeforeBan" },
				desc = "Au warning juste avant le dernier, le joueur est éjecté une fois. "
					.. "Il peut revenir : c'est un signal, pas une sanction. En pratique "
					.. "ça fait arrêter une bonne partie des curieux avant le ban.",
			})

			toggleRow(rows, 4, {
				title = "Priver aussi d'UGC",
				value = getDraft({ "modes", "ban", "alsoRestrictUGC" }, true) == true,
				onColor = RED, path = { "modes", "ban", "alsoRestrictUGC" },
				desc = "Recommandé surtout si le ban est temporaire : le joueur revient, "
					.. "mais ne peut pas convertir en UGC les points qu'il a obtenus "
					.. "en trichant.",
			})

			toggleRow(rows, 5, {
				title = "Afficher le panneau avant d'éjecter",
				value = getDraft({ "modes", "ban", "notifyBeforeKick" }, true) == true,
				onColor = ORANGE, path = { "modes", "ban", "notifyBeforeKick" },
				desc = "Le joueur lit la raison à l'écran pendant 4 secondes avant le kick, "
					.. "au lieu de ne voir que la boîte de déconnexion.",
			})

			toggleRow(rows, 6, {
				title = "⚠️ Remettre les points à 0",
				value = getDraft({ "modes", "ban", "wipePoints" }, false) == true,
				onColor = RED, path = { "modes", "ban", "wipePoints" },
				desc = "IRRÉVERSIBLE. Tu peux lever un ban ; tu ne peux pas rendre des points. "
					.. "Je te déconseille de l'activer tant que tu n'as pas tourné plusieurs "
					.. "semaines sans un seul faux positif.",
				descColor = RED,
			})

			note(body, 11,
				"Le mode ban reste le plus dur à rattraper : un joueur banni ne revient "
					.. "pas t'expliquer, donc tu n'apprends jamais que tu t'es trompé. "
					.. "C'est la raison pour laquelle le mode UGC est le défaut.", ORANGE)

		elseif S.mode == "ugc" then
			local _, rows = card(body, 10, "🚫 FICHE DU MODE PRIVATION D'UGC", RED)

			stepper(rows, 1, {
				title = "Warnings avant la privation",
				value = getDraft({ "modes", "ugc", "warningsToPunish" }, 1),
				path = { "modes", "ugc", "warningsToPunish" },
				min = 1, max = 1000, step = 1, color = RED,
				desc = "✍️ Touche le chiffre pour taper n'importe quel nombre (1 à 1000, ex : 100). "
					.. "C'est ce chiffre qui apparaît dans « Warning 1/2 » côté joueur. "
					.. "Un seul endroit le définit, donc l'affichage ne peut pas mentir "
					.. "sur le vrai seuil.",
			})

			stepper(rows, 2, {
				title = "Durée de la privation",
				value = getDraft({ "modes", "ugc", "durationHours" }, 0),
				path = { "modes", "ugc", "durationHours" },
				min = 0, max = 2160, step = 12, color = RED,
				format = function(v)
					if v == 0 then return "définitif" end
					if v < 48 then return v .. " h" end
					return math.floor(v / 24) .. " j"
				end,
				desc = "0 = jusqu'à ce qu'un admin lève la sanction (recommandé). "
					.. "Sinon la levée est automatique. Comme pour le ban, la date de fin "
					.. "est figée au moment de la sanction.",
			})

			toggleRow(rows, 3, {
				title = "Afficher le panneau au moment de la privation",
				value = getDraft({ "modes", "ugc", "notifyOnPunish" }, true) == true,
				onColor = RED, path = { "modes", "ugc", "notifyOnPunish" },
				desc = "Le joueur sait tout de suite pourquoi, et comment faire appel.",
			})

			toggleRow(rows, 4, {
				title = "Rappeler à chaque connexion",
				value = getDraft({ "modes", "ugc", "remindOnJoin" }, false) == true,
				onColor = RED, path = { "modes", "ugc", "remindOnJoin" },
				desc = "Évite la vague de tickets « mon shop est cassé ». Sans ce rappel, "
					.. "un joueur restreint croit à un bug et te le signale comme tel.",
			})

			toggleRow(rows, 5, {
				title = "Kicker une fois au moment de la privation",
				value = getDraft({ "modes", "ugc", "kickOnPunish" }, false) == true,
				onColor = ORANGE, path = { "modes", "ugc", "kickOnPunish" },
				desc = "Coupé par défaut : la privation se suffit à elle-même, et un kick "
					.. "sur un faux positif est ce qui fâche le plus un joueur honnête.",
			})

			toggleRow(rows, 6, {
				title = "Bloquer aussi les dons d'UGC",
				value = getDraft({ "modes", "ugc", "blockGifts" }, true) == true,
				onColor = RED, path = { "modes", "ugc", "blockGifts" },
				desc = "Sans ça, un tricheur restreint fait acheter l'UGC par un compte "
					.. "complice et se la fait offrir. La faille la plus évidente du mode. "
					.. "⚠️ Ton script de dons doit appeler _G.UGCRestrict.CheckPurchase.",
			})

			toggleRow(rows, 7, {
				title = "Bloquer aussi le rebirth",
				value = getDraft({ "modes", "ugc", "blockRebirth" }, false) == true,
				onColor = ORANGE, path = { "modes", "ugc", "blockRebirth" },
				desc = "Certains l'utilisent pour blanchir des points obtenus en trichant. "
					.. "Coupé par défaut : ça touche une mécanique de jeu, pas seulement "
					.. "une récompense.",
			})

			note(body, 11,
				"Pourquoi ce mode est le défaut : le joueur garde ses points, continue de "
					.. "jouer, et vient t'écrire avec une vidéo. Si tu t'es trompé, tu lèves la "
					.. "sanction et il n'a rien perdu d'irréversible. Si tu ne t'es pas trompé, "
					.. "il n'a rien coûté à ton économie non plus.", RED)

		else -- test
			local _, rows = card(body, 10, "🧪 FICHE DU MODE TEST (SHADOW)", CYAN)

			note(rows, 0,
				"Ces réglages décrivent ce qui se passe PENDANT une observation. "
					.. "Ils n'ont d'effet que si la case shadow ci-dessus est active.",
				C.TEXT_GREY)

			toggleRow(rows, 1, {
				title = "Corriger quand même la position",
				value = getDraft({ "modes", "test", "correctPosition" }, false) == true,
				onColor = CYAN, path = { "modes", "test", "correctPosition" },
				desc = "COUPÉ : le tricheur ne sait pas qu'il est mesuré, tu récoltes des "
					.. "données propres pendant plusieurs jours. ACTIVÉ : tu le gênes déjà, "
					.. "mais tu te trahis et il adapte son script.",
			})

			toggleRow(rows, 2, {
				title = "Le joueur voit les cartes d'avertissement",
				value = getDraft({ "modes", "test", "notifyPlayer" }, false) == true,
				onColor = CYAN, path = { "modes", "test", "notifyPlayer" },
				desc = "COUPÉ = observation totalement silencieuse. C'est ce que tu veux "
					.. "pour mesurer honnêtement ton taux de faux positifs : un joueur qui "
					.. "reçoit des cartes change son comportement.",
			})

			toggleRow(rows, 3, {
				title = "Écrire chaque décision dans la console",
				value = getDraft({ "modes", "test", "logToConsole" }, true) == true,
				onColor = CYAN, path = { "modes", "test", "logToConsole" },
				desc = "Les lignes 🧪 [SHADOW] … SERAIT-BANNI dans la sortie serveur.",
			})

			toggleRow(rows, 4, {
				title = "DataStores de test séparés",
				value = getDraft({ "modes", "test", "separateStore" }, true) == true,
				onColor = CYAN, path = { "modes", "test", "separateStore" },
				desc = "Les warnings de test ne polluent jamais les compteurs réels. "
					.. "À garder actif : sinon une session d'observation laisse des "
					.. "warnings sur des comptes qui n'ont rien fait.",
			})

			stepper(rows, 5, {
				title = "Rappel « tu peux couper le shadow » après",
				value = getDraft({ "modes", "test", "suggestAfterDays" }, 5),
				path = { "modes", "test", "suggestAfterDays" },
				min = 1, max = 90, step = 1, color = CYAN,
				format = function(v) return v .. " j" end,
				desc = "Purement informatif : le panel te le rappelle, il ne coupe rien "
					.. "tout seul. La décision reste la tienne.",
			})

			note(body, 11,
				"Ma recommandation : trois à cinq jours de shadow silencieux, puis tu ouvres "
					.. "l'onglet 🎯 Risque et tu regardes la liste. Tant qu'elle contient un nom "
					.. "que tu ne reconnais pas comme tricheur, il reste un bug à trouver.", CYAN)
		end

		--──────────────────────────────────────────────────────────────
		-- 🤫 V4 — Discrétion et durée de vie des warnings (tous modes)
		--──────────────────────────────────────────────────────────────
		local _, dRows = card(body, 15, "🤫 DISCRÉTION ET DURÉE DES WARNINGS", VIOLET)

		toggleRow(dRows, 1, {
			title = "🤫 Le joueur ne voit rien de ses warnings",
			value = getDraft({ "silent" }, true) == true,
			onColor = VIOLET, path = { "silent" },
			desc = getDraft({ "silent" }, true) == true
				and "ACTIF — aucune carte, aucun retour en arrière, aucun kick d'avertissement. "
				.. "Le joueur ne sait pas qu'il est mesuré ; il ne l'apprend qu'au moment de "
				.. "la sanction. (Remplace les cases « carte orange » et « carte rouge » de "
				.. "l'onglet Messages.)"
				or "COUPÉ — les cartes de l'onglet Messages et la correction de position "
				.. "s'appliquent.",
			descColor = VIOLET,
		})

		stepper(dRows, 2, {
			title = "⏳ Un warning disparaît après",
			value = getDraft({ "warningExpiryDays" }, 30),
			path = { "warningExpiryDays" }, min = 0, max = 365, step = 5, color = VIOLET,
			format = function(v) return v == 0 and "jamais" or (v .. " j") end,
			desc = "Chaque warning s'efface tout seul ce nombre de jours après avoir été "
				.. "reçu. Ça protège le joueur qui a pris UN faux warning par erreur. "
				.. "Garde-le long (30 j conseillé) : un tricheur qui recommence en accumule "
				.. "bien avant.",
		})

		toggleRow(dRows, 3, {
			title = "🛒 Ne montrer la sanction qu'à l'achat",
			value = getDraft({ "modes", "ugc", "revealOnlyWhenAffordable" }, true) == true,
			onColor = VIOLET, path = { "modes", "ugc", "revealOnlyWhenAffordable" },
			desc = "Après le panneau affiché UNE fois à la sanction, le joueur ne le revoit "
				.. "que s'il essaie d'acheter une UGC qu'il pourrait se payer. Sans assez de "
				.. "points, il voit le message normal « pas assez de points », et on ne lui "
				.. "propose pas d'acheter des points en Robux.",
		})

		--──────────────────────────────────────────────────────────────
		-- Seuils de certitude — communs à tous les modes
		--──────────────────────────────────────────────────────────────
		local _, cRows = card(body, 20, "🎯 NIVEAU DE PREUVE EXIGÉ (tous modes)", GREEN)

		stepper(cRows, 1, {
			title = "Compter une détection à partir de",
			value = getDraft({ "minConfidenceCount" }, 55),
			path = { "minConfidenceCount" }, min = 20, max = 95, step = 5, color = GREEN,
			format = function(v) return v .. " %" end,
			desc = "En dessous : la détection est écrite dans le journal mais ne produit "
				.. "NI rubber-band, NI strike, NI carte. Le joueur ne sent rien.",
		})
		stepper(cRows, 2, {
			title = "Émettre un warning à partir de",
			value = getDraft({ "minConfidenceWarn" }, 70),
			path = { "minConfidenceWarn" }, min = 30, max = 98, step = 5, color = GREEN,
			format = function(v) return v .. " %" end,
			desc = "Moyenne du LOT de strikes, pas de la détection la plus forte. "
				.. "Trois signaux à 58 % ne font pas un dossier.",
		})
		stepper(cRows, 3, {
			title = "Sanctionner à partir de",
			value = getDraft({ "minConfidenceSanction" }, 85),
			path = { "minConfidenceSanction" }, min = 50, max = 99, step = 5, color = GREEN,
			format = function(v) return v .. " %" end,
			desc = "Dernier verrou, re-vérifié au moment d'appliquer la sanction et pas "
				.. "seulement au moment du warning.",
		})

		toggleRow(cRows, 4, {
			title = "👮 Analyser les admins comme tout le monde",
			value = getDraft({ "analyzeAdmins" }, true) == true,
			onColor = CYAN, path = { "analyzeAdmins" },
			desc = getDraft({ "analyzeAdmins" }, true) == true
				and "AUCUN PRIVILÈGE. Un admin accumule des warnings et peut être privé "
				.. "d'UGC exactement comme un joueur. C'est le seul réglage qui te dise "
				.. "honnêtement si ton anti-cheat produit des faux positifs — parce que "
				.. "TU es le joueur dont tu sais avec certitude qu'il ne triche pas."
				or "Les admins sont ignorés par l'anti-cheat. Tu ne verras plus jamais un "
				.. "faux positif te concernant… ni ceux qui touchent tes joueurs.",
			descColor = CYAN,
		})

		note(body, 21,
			"Un détail volontaire : quand tu utilises GO TO ou BRING depuis le panel, la "
				.. "grâce de téléportation s'applique toujours, même avec « analyser les admins » "
				.. "actif. Ce n'est pas une immunité — c'est la correction d'une MESURE : le "
				.. "déplacement a réellement été causé par le panel. Sans ça, ton panel "
				.. "flaggerait ton panel.", C.TEXT_DIM)
	end

	--════════════════════════════════════════════════════════════════════
	-- 💬 SECTION MESSAGES
	--════════════════════════════════════════════════════════════════════
	local VARS_HELP =
		"Variables utilisables dans tous les textes :\n"
		.. "{player} nom  ·  {typefr} type de détection en français  ·  {type} en brut\n"
		.. "{warnings} warnings actuels  ·  {max} seuil  ·  {left} restants\n"
		.. "{confidence} certitude en %  ·  {game} nom de ton jeu\n"
		.. "Laisse un champ vide pour reprendre le texte par défaut."

	local function sectionMessages(body)
		acTabBar(body, 0, {
			{ id = "detect",   label = "⚠️ Détections" },
			{ id = "warn",     label = "🚨 Warnings" },
		}, S.msgTab, VIOLET, function(id) S.msgTab = id ; screen(false) end)

		acTabBar(body, 1, {
			{ id = "sanction", label = "🚫 Sanction" },
			{ id = "shop",     label = "🛒 Shop" },
		}, S.msgTab, VIOLET, function(id) S.msgTab = id ; screen(false) end)

		note(body, 2, VARS_HELP, C.TEXT_GREY)

		--────────────────────────────────────────────────────────────
		if S.msgTab == "detect" then
			local _, rows = card(body, 10, "⚠️ APRÈS PLUSIEURS DÉTECTIONS", ORANGE)

			note(rows, 0,
				"La carte ORANGE. Ce n'est pas encore un avertissement : la position du "
					.. "joueur a été corrigée, rien n'est compté contre lui au dossier. "
					.. "C'est le message que reçoit un joueur honnête si jamais il reste un "
					.. "bug quelque part — écris-le comme une question, pas comme une accusation.",
				C.TEXT_GREY)

			toggleRow(rows, 1, {
				title = "Afficher cette carte",
				value = getDraft({ "messages", "nudgeEnabled" }, true) == true,
				onColor = ORANGE, path = { "messages", "nudgeEnabled" },
				desc = "Coupée, le joueur ne voit rien du tout tant qu'il n'a pas de "
					.. "warning officiel. La correction de position, elle, continue.",
			})

			stepper(rows, 2, {
				title = "Afficher après combien de détections",
				value = getDraft({ "messages", "nudgeAfterDetections" }, 2),
				path = { "messages", "nudgeAfterDetections" },
				min = 1, max = 20, step = 1, color = ORANGE,
				desc = "Comptées, pas brutes : une mesure écartée pour certitude "
					.. "insuffisante ne rapproche personne d'une carte à l'écran. "
					.. "À 2, un joueur qui se coince une fois dans un mur ne voit rien.",
			})

			stepper(rows, 3, {
				title = "Délai minimum entre deux cartes",
				value = getDraft({ "messages", "nudgeCooldown" }, 10),
				path = { "messages", "nudgeCooldown" },
				min = 0, max = 120, step = 5, color = ORANGE,
				format = function(v) return v .. " s" end,
				desc = "Évite le mitraillage visuel quand une même zone produit plusieurs "
					.. "mesures d'affilée.",
			})

			textField(body, 11, {
				title = "TITRE de la carte orange",
				value = getDraft({ "messages", "nudgeTitle" }, ""),
				path = { "messages", "nudgeTitle" }, color = ORANGE,
			})
			textField(body, 12, {
				title = "TEXTE de la carte orange", multiline = true,
				value = getDraft({ "messages", "nudgeBody" }, ""),
				path = { "messages", "nudgeBody" }, color = ORANGE,
			})
			previewBox(body, 13,
				(getDraft({ "messages", "nudgeTitle" }, "") ~= ""
					and getDraft({ "messages", "nudgeTitle" }, "") .. "\n\n" or "")
					.. getDraft({ "messages", "nudgeBody" }, ""))

			--────────────────────────────────────────────────────────────
		elseif S.msgTab == "warn" then
			local _, rows = card(body, 10, "🚨 APRÈS UN WARNING OFFICIEL", RED)

			note(rows, 0,
				"La carte ROUGE. Là, un warning est réellement compté et persisté sur le "
					.. "compte. C'est le message qui décide si le joueur t'écrit avec une vidéo "
					.. "ou s'il part en claquant la porte — dis-lui clairement combien il lui "
					.. "reste de marge, et comment faire appel.",
				C.TEXT_GREY)

			toggleRow(rows, 1, {
				title = "Afficher cette carte",
				value = getDraft({ "messages", "warnEnabled" }, true) == true,
				onColor = RED, path = { "messages", "warnEnabled" },
				desc = "Coupée, le warning est TOUJOURS compté et persisté — le joueur "
					.. "n'en est simplement pas informé. Utile si tu veux laisser un "
					.. "tricheur continuer pendant que tu constitues son dossier.",
			})

			toggleRow(rows, 2, {
				title = "🔐 Afficher la certitude en % au joueur",
				value = getDraft({ "messages", "showConfidenceToPlayer" }, false) == true,
				onColor = ORANGE, path = { "messages", "showConfidenceToPlayer" },
				desc = "Fortement déconseillé. Un tricheur qui lit « 62 % » sait exactement "
					.. "de combien ralentir pour repasser sous le seuil : tu lui offres un "
					.. "banc d'essai. Toi, tu vois toujours le chiffre dans le panel. "
					.. "Quand c'est coupé, {confidence} est effacé de tes textes même si "
					.. "tu l'y as laissé.",
				descColor = ORANGE,
			})

			textField(body, 11, {
				title = "TITRE de la carte rouge",
				value = getDraft({ "messages", "warnTitle" }, ""),
				path = { "messages", "warnTitle" }, color = RED,
				desc = "Exemple : 🚨 Warning {warnings}/{max}",
			})
			textField(body, 12, {
				title = "TEXTE de la carte rouge", multiline = true,
				value = getDraft({ "messages", "warnBody" }, ""),
				path = { "messages", "warnBody" }, color = RED,
				desc = "Exemple : « Il te reste {left} avertissement(s) avant que l'accès "
					.. "aux UGC soit coupé. »",
			})
			previewBox(body, 13,
				(getDraft({ "messages", "warnTitle" }, "") ~= ""
					and getDraft({ "messages", "warnTitle" }, "") .. "\n\n" or "")
					.. getDraft({ "messages", "warnBody" }, ""))

			--────────────────────────────────────────────────────────────
		elseif S.msgTab == "sanction" then
			local _, rows = card(body, 10, "🚫 AU MOMENT DE LA SANCTION", RED)
			note(rows, 0,
				"Ce que le joueur lit quand la privation tombe, et ce qu'il relit à chaque "
					.. "connexion si tu as gardé le rappel. C'est ce texte qui détermine la "
					.. "qualité des appels que tu recevras : demande explicitement une vidéo, "
					.. "sinon tu recevras « c'est pas moi » cent fois.",
				C.TEXT_GREY)

			textField(body, 11, {
				title = "TITRE — privation d'UGC",
				value = getDraft({ "messages", "restrictTitle" }, ""),
				path = { "messages", "restrictTitle" }, color = RED,
			})
			textField(body, 12, {
				title = "TEXTE — privation d'UGC", multiline = true,
				value = getDraft({ "messages", "restrictBody" }, ""),
				path = { "messages", "restrictBody" }, color = RED,
				desc = "Vide = on réutilise l'ancien « message de support » que tu avais "
					.. "déjà réglé. Ta config existante n'est pas perdue.",
			})
			previewBox(body, 13,
				(getDraft({ "messages", "restrictTitle" }, "") ~= ""
					and getDraft({ "messages", "restrictTitle" }, "") .. "\n\n" or "")
					.. (getDraft({ "messages", "restrictBody" }, "") ~= ""
					and getDraft({ "messages", "restrictBody" }, "")
					or getDraft({ "supportMessage" }, "")))

			textField(body, 20, {
				title = "TITRE — ban (mode ban uniquement)",
				value = getDraft({ "messages", "banTitle" }, ""),
				path = { "messages", "banTitle" }, color = ORANGE,
			})
			textField(body, 21, {
				title = "TEXTE — ban", multiline = true,
				value = getDraft({ "messages", "banBody" }, ""),
				path = { "messages", "banBody" }, color = ORANGE,
			})

			--────────────────────────────────────────────────────────────
		else -- shop
			local _, rows = card(body, 10, "🛒 QUAND IL CLIQUE SUR ACHETER", RED)
			note(rows, 0,
				"Deux situations très différentes, et il faut absolument les distinguer :\n\n"
					.. "• REFUSÉ : le joueur est effectivement restreint. C'est une sanction.\n"
					.. "• VÉRIFICATION IMPOSSIBLE : le registre n'a pas répondu. Ce n'est PAS "
					.. "une sanction — on refuse par sécurité, mais ça peut arriver à n'importe "
					.. "qui. Si tu écris le même texte dans les deux, un joueur honnête croira "
					.. "être puni et ton support explosera.",
				C.TEXT_GREY)

			textField(body, 11, {
				title = "TITRE — achat refusé (restreint)",
				value = getDraft({ "messages", "shopBlockedTitle" }, ""),
				path = { "messages", "shopBlockedTitle" }, color = RED,
			})
			textField(body, 12, {
				title = "TEXTE — achat refusé (restreint)", multiline = true,
				value = getDraft({ "messages", "shopBlockedBody" }, ""),
				path = { "messages", "shopBlockedBody" }, color = RED,
				desc = "C'est LE message que tu m'as demandé : « le système d'anti-cheat "
					.. "pense que tu es un hacker, contacte le support avec des preuves ».",
			})
			previewBox(body, 13,
				(getDraft({ "messages", "shopBlockedTitle" }, "") ~= ""
					and getDraft({ "messages", "shopBlockedTitle" }, "") .. "\n\n" or "")
					.. getDraft({ "messages", "shopBlockedBody" }, ""))

			textField(body, 20, {
				title = "TITRE — vérification impossible",
				value = getDraft({ "messages", "shopUnverifiedTitle" }, ""),
				path = { "messages", "shopUnverifiedTitle" }, color = ORANGE,
			})
			textField(body, 21, {
				title = "TEXTE — vérification impossible", multiline = true,
				value = getDraft({ "messages", "shopUnverifiedBody" }, ""),
				path = { "messages", "shopUnverifiedBody" }, color = ORANGE,
				desc = "Rassure : ses points n'ont pas bougé, il peut réessayer. "
					.. "Ne parle surtout pas de triche ici.",
			})
			previewBox(body, 22,
				(getDraft({ "messages", "shopUnverifiedTitle" }, "") ~= ""
					and getDraft({ "messages", "shopUnverifiedTitle" }, "") .. "\n\n" or "")
					.. getDraft({ "messages", "shopUnverifiedBody" }, ""))
		end
	end

	--════════════════════════════════════════════════════════════════════
	-- 🖥️ ÉCRAN
	--════════════════════════════════════════════════════════════════════
	screen = function(reset)
		currentScreen = "acmodes"
		if reset then
			S.cfg, S.draft, S.dirty = nil, nil, false
			S.failed, S.failMsg = false, nil
			S.tab, S.msgTab = "modes", "detect"
		end

		local body = buildScreen("⚙️ MODES & MESSAGES", true, VIOLET, nil, function()
			--  Le bouton 🔄 efface AUSSI l'état d'échec et le brouillon :
			--  sans ça, un hoquet réseau laissait le panel bloqué jusqu'à la
			--  fermeture de la fenêtre. C'est le même bug que tu avais.
			S.cfg, S.draft, S.dirty = nil, nil, false
			S.failed, S.failMsg = false, nil
			screen(false)
		end)

		acTabBar(body, -3, {
			{ id = "modes",    label = "⚙️ Modes" },
			{ id = "messages", label = "💬 Messages" },
		}, S.tab, VIOLET, function(id) S.tab = id ; screen(false) end)

		if not remote("AdminUGCRestrictAction") then
			note(body, 1, "❌ Le serveur n'a pas le module d'anti-cheat.\n\n"
				.. "Ajoute AntiCheat_UGCRestrict.server.lua dans ServerScriptService, "
				.. "puis redémarre le serveur.", RED)
			return
		end

		--──────────────────────────────────────────────────────────────
		-- Chargement
		--──────────────────────────────────────────────────────────────
		if not S.cfg and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetUGCRestrict")
				local ok, res = false, nil
				for attempt = 1, 2 do
					if fn then
						--  `false` = on ne veut PAS la liste des restreints ici,
						--  seulement la config. Une requête plus légère.
						ok, res = pcall(function() return fn:InvokeServer(false, false) end)
					end
					if ok and type(res) == "table" and res.ok then break end
					if attempt == 1 then task.wait(0.7) end
				end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.cfg = res.config or {}
					S.mode = (S.cfg.mode == "ban") and "ban" or "ugc"
					S.failed, S.failMsg = false, nil
				else
					S.failed = true
					S.failMsg = (type(res) == "table" and res.msg)
						or "Le serveur n'a pas répondu. Réessaie avec 🔄."
				end
				if currentScreen == "acmodes" and window.Visible then screen(false) end
			end)
		end

		if S.loading and not S.cfg then
			note(body, 1, "⏳ Lecture de la configuration…", CYAN)
			return
		end
		if S.failed then
			note(body, 1, "❌ " .. tostring(S.failMsg or "Erreur"), RED)
			bigBtn(body, 2, "🔄 Réessayer", C.BG_LIGHT, C.BORDER_BRIGHT, function()
				S.failed, S.failMsg = false, nil
				screen(false)
			end)
			return
		end
		if not S.cfg then return end

		--──────────────────────────────────────────────────────────────
		-- Bandeau « non enregistré »
		--──────────────────────────────────────────────────────────────
		if S.dirty then
			note(body, -2,
				"✏️ Tu as des modifications NON ENREGISTRÉES. Rien n'est appliqué tant que "
					.. "tu n'as pas cliqué sur ENREGISTRER en bas de l'écran.", ORANGE)
		end

		if S.tab == "modes" then
			sectionModes(body)
		else
			sectionMessages(body)
		end

		--──────────────────────────────────────────────────────────────
		-- Barre d'enregistrement
		--
		--   Une seule écriture DataStore pour tous tes changements. C'est
		--   ce qui évite le « tu vas trop vite » : avant, chaque clic de
		--   bouton déclenchait sa propre écriture.
		--──────────────────────────────────────────────────────────────
		if S.dirty then
			bigBtn(body, 900, "💾 ENREGISTRER ET DIFFUSER", GREEN, GREEN_D, saveDraft,
				Color3.new(0, 0, 0))
			bigBtn(body, 901, "↩️ Annuler mes modifications", C.BG_LIGHT, C.BORDER_BRIGHT,
				function()
					S.draft, S.dirty = nil, false
					screen(false)
				end)
		else
			note(body, 900,
				"Tout est enregistré. Les réglages sont écrits en DataStore et diffusés à "
					.. "TOUS tes serveurs dans la seconde — tu n'as jamais à redémarrer, et tu "
					.. "n'as jamais à toucher au code de l'anti-fly : il relit ces valeurs à "
					.. "chaque mesure.", GREEN)
		end

		bigBtn(body, 910, "♻️ Recharger depuis le serveur", C.BG_LIGHT, C.BORDER_BRIGHT,
			function()
				callAct("reload", {}, function()
					S.cfg, S.draft, S.dirty = nil, nil, false
					S.failed, S.failMsg = false, nil
					screen(false)
				end)
			end)
	end

	--════════════════════════════════════════════════════════════════════
	-- 🔌 BRANCHEMENT SUR L'ACCUEIL
	--════════════════════════════════════════════════════════════════════
	table.insert(ACTIONS, { id = "acmodes", name = "⚙️ MODES & MSG", color = VIOLET })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "acmodes" then screen(true) return end
		return previousOpenAction(a)
	end

	print("✅ Bloc 10 chargé — ⚙️ MODES & MESSAGES")
end)()

--════════════════════════════════════════════════════════════════════════════
-- 💸 BLOC 14 — REVENUS  +  🎽 UGC STATS   (dans l'admin panel)
--
--  📍 OÙ COLLER ? Dans ton LocalScript « ADMIN PANEL — CLIENT », JUSTE AVANT
--     le bloc « 📜 BLOC 11 — CONSERVER LA POSITION DE DÉFILEMENT »
--     (le bloc 11 doit rester le DERNIER).
--  Ajoute 2 boutons à l'accueil : 💸 REVENUS et 🎽 UGC STATS (graphique réglable).
--  Tout arrive déjà calculé par EconomyStats_Server : rien n'est calculé ici.
--════════════════════════════════════════════════════════════════════════════
;(function()
	local GREEN   = Color3.fromRGB(90, 220, 140)
	local GREEN_D = Color3.fromRGB(30, 120, 70)
	local PINK    = Color3.fromRGB(255, 150, 220)
	local PINK_D  = Color3.fromRGB(120, 60, 110)
	local GOLD    = Color3.fromRGB(255, 205, 70)
	local SM = IS_MOBILE and 10 or 12
	local MD = IS_MOBILE and 12 or 15

	local Cat, UGCC
	pcall(function() Cat = require(ReplicatedStorage:WaitForChild("ProductCatalog", 15)) end)
	pcall(function() UGCC = require(ReplicatedStorage:WaitForChild("UGC_CONFIG", 15)) end)
	local SHARE = (Cat and Cat.CREATOR_SHARE) or 0.7
	local function cad(robux, perRobux)   -- « 12,34 $ CA »
		local v = (tonumber(robux) or 0) * (tonumber(perRobux) or 0.0038 * 1.42)
		return (string.format("%.2f", v):gsub("%.", ",")) .. " $ CA"
	end

	local ST = { revP = "today", ugcP = "today", cache = {}, token = 0 }
	local screenRevenue, screenUGC

	local PERIODS = {
		{ id = "today", label = "Aujourd'hui" }, { id = "7d", label = "7 jours" },
		{ id = "30d", label = "30 jours" }, { id = "all", label = "Tout" },
	}
	local PERIOD_TXT = { today = "aujourd'hui", ["7d"] = "7 derniers jours", ["30d"] = "30 derniers jours" }
	local PREV_TXT = { today = "hier", ["7d"] = "les 7 jours d'avant", ["30d"] = "les 30 jours d'avant" }
	local SRC = {
		shop = "🛒 Shop", late = "⏱️ Achat tardif", verified_delivered = "✅ Vérifié",
		rejoin_confirmed = "🔁 Confirmé au retour", parked_confirmed = "🅿️ Créance soldée",
		parked_late = "🅿️ Tardif", rejoin_recheck = "🔁 Repris", admin_confirm = "🛠️ Admin",
		admin_park_confirm = "🛠️ Admin", free = "🎁 Gratuit", admin = "🛠️ Admin",
		exploit = "🚨 Exploit", external = "🌐 Hors shop", quit = "🚪 Quit", bugfix = "🩹 Bugfix",
		timeout = "⌛ Timeout",
	}

	--════════════════════════════════════════════════════════
	-- 📡 SERVEUR
	--════════════════════════════════════════════════════════
	local function fetch(action, p, cb, key)
		key = key or (action .. "|" .. tostring(p))
		local c = ST.cache[key]
		if c and os.clock() - c.at < 30 then cb(c.data) return end
		local fn = ReplicatedStorage:FindFirstChild("AdminEcon_Get")
		if not fn then cb(nil, "EconomyStats_Server n'est pas installé.") return end
		task.spawn(function()
			for attempt = 1, 6 do
				local ok, res = pcall(function() return fn:InvokeServer(action, p) end)
				if ok and type(res) == "table" and res.ok then
					ST.cache[key] = { data = res, at = os.clock() }
					cb(res) return
				end
				if ok and type(res) == "table" and res.err then cb(nil, res.err) return end
				task.wait(0.5 * attempt)
			end
			cb(nil, "Serveur occupé, appuie sur 🔄.")
		end)
	end

	--════════════════════════════════════════════════════════
	-- 🔢 FORMATS
	--════════════════════════════════════════════════════════
	local function sep(n)
		n = math.floor((tonumber(n) or 0) + 0.5)
		local s = tostring(math.abs(n)):reverse():gsub("(%d%d%d)", "%1 "):reverse()
		return (n < 0 and "-" or "") .. s:gsub("^%s+", "")
	end
	local function R(n) return sep(n) .. " R$" end
	local function pct(a, b)
		a, b = tonumber(a) or 0, tonumber(b) or 0
		if b <= 0 then return "0 %" end
		return string.format("%.0f %%", a / b * 100)
	end
	local function deltaTxt(cur, prev)
		cur, prev = tonumber(cur) or 0, tonumber(prev) or 0
		if prev <= 0 then return nil end
		local p = (cur - prev) / prev * 100
		if math.abs(p) < 0.5 then return "= pareil que", C.TEXT_GREY end
		return string.format("%s %.0f %% vs", p > 0 and "▲" or "▼", math.abs(p)), p > 0 and GREEN or C.RED
	end
	local function ugcName(id, fallback)
		local u = UGCC and UGCC.GetByAssetId(tonumber(id))
		return (u and u.Name) or fallback or ("UGC " .. tostring(id)),
		u and (function(v) v = tostring(v); return v:find("://") and v or ("rbxassetid://" .. v) end)(u.ImageId or u.AssetId)
			or ("rbxthumb://type=Asset&id=" .. tostring(id) .. "&w=150&h=150")
	end

	--════════════════════════════════════════════════════════
	-- 🧱 COMPOSANTS
	--════════════════════════════════════════════════════════
	local function note(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8) ; stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop, p.PaddingBottom = UDim.new(0, 7), UDim.new(0, 7)
		p.PaddingLeft, p.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
		p.Parent = f
		local l = label(f, { text = text, size = UDim2.new(1, 0, 0, 0), color = color or C.TEXT_GREY,
			textSize = SM, wrapped = true, xAlign = Enum.TextXAlignment.Left, zIndex = 12 })
		l.AutomaticSize = Enum.AutomaticSize.Y
		return f
	end

	local function card(parent, order, h)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, h)
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 12) ; stroke(f, C.BORDER_SUBTLE, 1)
		return f
	end

	local function line(parent, y, h, text, color, size, rich)
		return label(parent, { text = text, size = UDim2.new(1, -24, 0, h), position = UDim2.new(0, 12, 0, y),
			xAlign = Enum.TextXAlignment.Left, color = color or C.TEXT_GREY, textSize = size or SM,
			truncate = true, richText = rich, zIndex = 12 })
	end

	-- Barres : v = total, v2 = part verte (en bas)
	local function barChart(parent, order, items, title, color, color2)
		local H = IS_MOBILE and 130 or 165
		local f = card(parent, order, H)
		local max = 0
		for _, it in ipairs(items) do max = math.max(max, tonumber(it.v) or 0) end
		line(f, 6, 16, title, C.TEXT_GREY, SM)
		if max <= 0 then
			label(f, { text = "Rien sur cette période", size = UDim2.fromScale(1, 1), color = C.TEXT_DIM,
				textSize = MD, zIndex = 12 })
			return f
		end
		local top, bottom = IS_MOBILE and 26 or 30, IS_MOBILE and 16 or 18
		local plot = Instance.new("Frame")
		plot.BackgroundTransparency = 1
		plot.Position = UDim2.new(0, 8, 0, top)
		plot.Size = UDim2.new(1, -16, 1, -(top + bottom))
		plot.ZIndex = 12
		plot.Parent = f
		local n = #items
		local every = math.max(1, math.ceil(n / (IS_MOBILE and 7 or 12)))
		local showVals = n <= (IS_MOBILE and 8 or 14)
		for i, it in ipairs(items) do
			local v, v2 = tonumber(it.v) or 0, tonumber(it.v2) or 0
			local col = Instance.new("Frame")
			col.BackgroundTransparency = 1
			col.Size = UDim2.new(1 / n, 0, 1, 0)
			col.Position = UDim2.new((i - 1) / n, 0, 0, 0)
			col.ZIndex = 12
			col.Parent = plot
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 1)
			bar.Position = UDim2.new(0.5, 0, 1, 0)
			bar.Size = UDim2.new(0.66, 0, v / max, v > 0 and 0 or 1)
			bar.BackgroundColor3 = it.hi and GOLD or color
			bar.BorderSizePixel = 0
			bar.ZIndex = 13
			bar.Parent = col
			if color2 and v > 0 and v2 > 0 then
				local g = Instance.new("Frame")
				g.AnchorPoint = Vector2.new(0, 1)
				g.Position = UDim2.new(0, 0, 1, 0)
				g.Size = UDim2.new(1, 0, math.clamp(v2 / v, 0, 1), 0)
				g.BackgroundColor3 = color2
				g.BorderSizePixel = 0
				g.ZIndex = 14
				g.Parent = bar
			end
			if showVals and v > 0 then
				label(col, { text = sep(v), size = UDim2.new(1, 12, 0, 12), position = UDim2.new(0.5, 0, 1 - v / max, -2),
					anchor = Vector2.new(0.5, 1), color = it.hi and GOLD or C.TEXT_GREY, textSize = IS_MOBILE and 8 or 10, zIndex = 15 })
			end
			if i % every == 0 or i == 1 or i == n then
				label(col, { text = it.l or "", size = UDim2.new(1, 16, 0, 12), position = UDim2.new(0.5, 0, 1, 3),
					anchor = Vector2.new(0.5, 0), color = it.hi and GOLD or C.TEXT_DIM, textSize = IS_MOBILE and 8 or 9, zIndex = 15 })
			end
		end
		return f
	end

	-- Ligne : image, titre, sous-titre, valeur à droite, barre de part
	local function row(parent, order, o)
		local h = IS_MOBILE and 50 or 58
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, 0, 0, h)
		b.BackgroundColor3 = C.BG_DARK
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Text = ""
		b.LayoutOrder = order
		b.ZIndex = 11
		b.Parent = parent
		corner(b, 10)
		local st = stroke(b, C.BORDER_SUBTLE, 1)
		local x = 10
		if o.image then
			local s = h - 14
			local im = Instance.new("ImageLabel")
			im.BackgroundColor3 = C.BG_LIGHT
			im.BackgroundTransparency = o.round and 0 or 1
			im.Image = o.image
			im.ScaleType = Enum.ScaleType.Fit
			im.AnchorPoint = Vector2.new(0, 0.5)
			im.Position = UDim2.new(0, 8, 0.5, 0)
			im.Size = UDim2.new(0, s, 0, s)
			im.ZIndex = 12
			im.Parent = b
			if o.round then corner(im, s / 2) end
			x = 8 + s + 10
		end
		local rw = IS_MOBILE and 92 or 128
		label(b, { text = o.title or "", size = UDim2.new(1, -x - rw - 8, 0, IS_MOBILE and 16 or 19),
			position = UDim2.new(0, x, 0, IS_MOBILE and 7 or 9), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_WHITE, textSize = MD, truncate = true, zIndex = 12 })
		if o.sub then
			label(b, { text = o.sub, size = UDim2.new(1, -x - 10, 0, 14), position = UDim2.new(0, x, 0, IS_MOBILE and 26 or 31),
				xAlign = Enum.TextXAlignment.Left, color = o.subColor or C.TEXT_GREY, textSize = SM, truncate = true, zIndex = 12 })
		end
		if o.right then
			label(b, { text = o.right, size = UDim2.new(0, rw, 0, IS_MOBILE and 16 or 19),
				position = UDim2.new(1, -10, 0, IS_MOBILE and 7 or 9), anchor = Vector2.new(1, 0),
				xAlign = Enum.TextXAlignment.Right, color = o.rightColor or GREEN, textSize = MD, truncate = true, zIndex = 12 })
		end
		if o.share then
			local bg = Instance.new("Frame")
			bg.Position = UDim2.new(0, x, 1, -6)
			bg.Size = UDim2.new(1, -x - 10, 0, 3)
			bg.BackgroundColor3 = C.BG_LIGHT
			bg.BorderSizePixel = 0
			bg.ZIndex = 12
			bg.Parent = b
			local fill = Instance.new("Frame")
			fill.Size = UDim2.new(math.clamp(o.share, 0, 1), 0, 1, 0)
			fill.BackgroundColor3 = o.shareColor or GREEN
			fill.BorderSizePixel = 0
			fill.ZIndex = 13
			fill.Parent = bg
		end
		b.MouseEnter:Connect(function() st.Color = o.hover or GREEN end)
		b.MouseLeave:Connect(function() st.Color = C.BORDER_SUBTLE end)
		if o.onClick then b.MouseButton1Click:Connect(o.onClick) end
		return b
	end

	local function popup(title, accent, lines, buttons)
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.4
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 60
		ov.Parent = window
		corner(ov, 14)
		local function close() ov:Destroy() end
		ov.MouseButton1Click:Connect(close)
		local box = Instance.new("TextButton")
		box.AutoButtonColor = false
		box.Text = ""
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.Position = UDim2.fromScale(0.5, 0.5)
		box.Size = UDim2.new(0.94, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.ZIndex = 61
		box.Parent = ov
		corner(box, 12) ; stroke(box, accent, 1.5) ; padding(box, 12)
		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 5)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = box
		local t = Instance.new("Frame")
		t.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
		t.BackgroundTransparency = 1 ; t.LayoutOrder = 0 ; t.ZIndex = 62 ; t.Parent = box
		label(t, { text = title, size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left, color = accent,
			textSize = IS_MOBILE and 15 or 18, truncate = true, zIndex = 62 })
		for i, ln in ipairs(lines) do
			local r = Instance.new("Frame")
			r.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 21)
			r.BackgroundTransparency = 1 ; r.LayoutOrder = i ; r.ZIndex = 62 ; r.Parent = box
			label(r, { text = ln[1], size = UDim2.new(0.45, 0, 1, 0), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_GREY, textSize = MD, truncate = true, zIndex = 62 })
			label(r, { text = tostring(ln[2]), size = UDim2.new(0.55, 0, 1, 0), position = UDim2.new(0.45, 0, 0, 0),
				xAlign = Enum.TextXAlignment.Right, color = ln[3] or C.TEXT_WHITE, textSize = MD, truncate = true, zIndex = 62 })
		end
		buttons = buttons or {}
		table.insert(buttons, { "Fermer", C.BG_LIGHT })
		local bw = Instance.new("Frame")
		bw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		bw.BackgroundTransparency = 1 ; bw.LayoutOrder = 100 ; bw.ZIndex = 62 ; bw.Parent = box
		for i, bt in ipairs(buttons) do
			local c = Instance.new("Frame")
			c.Size = UDim2.new(1 / #buttons, -6, 1, 0)
			c.Position = UDim2.new((i - 1) / #buttons, 3, 0, 0)
			c.BackgroundTransparency = 1 ; c.ZIndex = 62 ; c.Parent = bw
			local b = actionButton(c, { color = bt[2], strokeColor = C.BORDER_BRIGHT, text = bt[1],
				textSize = IS_MOBILE and 11 or 14, radius = 8, zIndex = 63 })
			b.MouseButton1Click:Connect(function() close() if bt[3] then bt[3]() end end)
		end
	end

	--════════════════════════════════════════════════════════
	-- 💸 REVENUS
	--════════════════════════════════════════════════════════
	screenRevenue = function(fresh)
		currentScreen = "revenue"
		ST.token += 1
		local tok = ST.token
		if fresh then ST.cache = {} end
		local body = buildScreen("💸 REVENUS", true, GREEN, nil, function() ST.cache = {} ; screenRevenue(false) end)
		local function alive() return ST.token == tok and currentScreen == "revenue" and body.Parent ~= nil end
		acTabBar(body, 1, PERIODS, ST.revP, GREEN_D, function(id) ST.revP = id ; screenRevenue(false) end)
		local loading = note(body, 2, "⏳ Chargement…")

		fetch("rev", ST.revP, function(res, err)
			if not alive() then return end
			loading:Destroy()
			if not res then note(body, 2, "❌ " .. tostring(err), C.RED) return end
			local p = res.period
			local net = math.floor((tonumber(res.gross) or 0) * SHARE)
			local when = PERIOD_TXT[p] or ("depuis le " .. tostring(res.since))

			-- ── Ce que tu as reçu ──
			local hero = card(body, 3, IS_MOBILE and 130 or 158)
			line(hero, 8, 16, "CE QUE TU AS REÇU · " .. string.upper(when), C.TEXT_GREY, SM)
			line(hero, IS_MOBILE and 24 or 26, IS_MOBILE and 32 or 40,
				R(net) .. string.format('  <font size="%d" color="#9A9AB0">≈ %s</font>', MD, cad(net, res.cadPerRobux)),
				GREEN, IS_MOBILE and 28 or 36, true)
			local dt, dc = deltaTxt(res.gross, res.prevGross)
			if dt then
				line(hero, IS_MOBILE and 60 or 72, 16, dt .. " " .. (PREV_TXT[p] or ""), dc, SM)
			elseif res.clipped or p == "all" then
				line(hero, IS_MOBILE and 60 or 72, 16, "Stats depuis le " .. tostring(res.since), C.TEXT_DIM, SM)
			end
			line(hero, IS_MOBILE and 84 or 104, 16, string.format("Payé par les joueurs : %s  ·  %s achat%s  ·  %s acheteur%s",
				R(res.gross), sep(res.n), (res.n or 0) > 1 and "s" or "", sep(res.buyers), (res.buyers or 0) > 1 and "s" or ""),
				C.TEXT_GREY, SM)
			-- 💱 Vrai taux ou taux de secours ?
			local rateTxt = (string.format("%.4f", tonumber(res.usdCad) or 1.42):gsub("%.", ","))
			if res.fxAt then
				line(hero, IS_MOBILE and 104 or 128, 16, "✅ Vrai taux du jour : 1 $ US = " .. rateTxt
					.. " $ CA  (récupéré le " .. tostring(res.fxAt) .. ")", GREEN, SM)
			else
				line(hero, IS_MOBILE and 104 or 128, 16, "⚠️ TAUX DE SECOURS : 1 $ US = " .. rateTxt
					.. " $ CA  (vrai taux indisponible, voir en bas)", C.ORANGE, SM)
			end

			-- ── Graphique ──
			barChart(body, 4, res.series, p == "today" and "R$ reçus par heure (heure de Montréal)"
				or ("R$ reçus par " .. tostring(res.unit)), GREEN_D)

			-- ── Ce qui rapporte ──
			sectionLabel(body, 5, "CE QUI RAPPORTE LE PLUS")
			local maxR = (res.products[1] and res.products[1].r) or 1
			for i, x in ipairs(res.products) do
				local name = Cat and Cat.Name(x.id) or ("Produit " .. tostring(x.id))
				local m = Cat and Cat.CATEGORIES[Cat.Category(x.id)]
				row(body, 5 + i, { title = (m and (m.emoji .. " ") or "") .. name,
					sub = string.format("%s vente%s · %s du total", sep(x.n), x.n > 1 and "s" or "", pct(x.r, res.gross)),
					right = "+" .. R(x.r * SHARE), share = x.r / math.max(1, maxR) })
			end
			if res.rest then
				row(body, 20, { title = "Autres produits", sub = sep(res.rest.n) .. " ventes",
					right = "+" .. R(res.rest.r * SHARE), rightColor = C.TEXT_GREY })
			end
			if #res.products == 0 then note(body, 6, "Aucune vente sur cette période.") end

			-- ── Derniers achats ──
			sectionLabel(body, 30, "DERNIERS ACHATS · touche pour voir tout ce qu'il a acheté")
			local ids = {}
			for _, e in ipairs(res.recent) do
				table.insert(ids, e.u)
				if e.g then table.insert(ids, e.g) end
			end
			resolveUsernames(ids, function()
				if not alive() then return end
				for i, e in ipairs(res.recent) do
					local name = Cat and Cat.Name(e.p) or tostring(e.p)
					local sub = name .. " · " .. tostring(e.ds)
					if e.g then sub = sub .. " · 🎁 pour @" .. (unameCache[e.g] or tostring(e.g)) end
					row(body, 30 + i, { image = "rbxthumb://type=AvatarHeadShot&id=" .. e.u .. "&w=48&h=48", round = true,
						title = "@" .. (unameCache[e.u] or tostring(e.u)) .. (e.f and "  🆕" or ""),
						sub = sub, right = "+" .. R((tonumber(e.r) or 0) * SHARE),
						onClick = function() economy.openPurchases(e.u) end })
				end
				if #res.recent == 0 then note(body, 31, "Aucun achat pour l'instant.") end
				note(body, 90, "Tu reçois 70 % de ce que paient les joueurs (Roblox garde 30 %). "
					.. string.format("≈ $ CA = DevEx 0,0038 $ US/R$ × %s %s. ",
						(string.format("%.4f", tonumber(res.usdCad) or 1.42):gsub("%.", ",")),
						res.fxAt and ("(vrai taux du jour, mis à jour toutes les 12 h, dernier : " .. tostring(res.fxAt) .. ")")
							or "(⚠️ taux de SECOURS de ProductCatalog : le vrai taux n'a pas pu être récupéré. "
							.. "Vérifie « Allow HTTP Requests » dans Game Settings › Security. En Studio, c'est le taux du jeu qui s'affiche dès qu'un vrai serveur l'a récupéré)")
						.. "🆕 = tout premier achat du joueur. "
						.. "Heures de Montréal. Stats depuis le " .. tostring(res.since) .. ".", C.TEXT_DIM)
			end)
		end)
	end

	--════════════════════════════════════════════════════════
	-- 🎽 UGC STATS
	--════════════════════════════════════════════════════════
	local TAG = {
		buy100 = { "💳 100 %", GREEN }, buy = { "💳 ", GREEN }, pass = { "⚡ pass/boost", C.ORANGE },
		free = { "🆓 farmée", C.TEXT_GREY }, gift = { "🎁 0 pt", C.TEXT_GREY }, unk = { "❔ inconnue", C.TEXT_DIM },
	}
	local VERDICT = {
		buy100 = "💳 100 % payée avec des points achetés", buy = "💳 En partie payée avec des points achetés",
		pass = "⚡ Payée en partie grâce à un pass/boost payé", free = "🆓 Payée avec des points farmés",
		gift = "🎁 Sortie sans points (gratuite / admin / hors shop)", unk = "❔ Inconnue (joueur pas encore chargé)",
	}

	local function ugcDetail(e)
		local name = ugcName(e.a, e.an)
		local who = unameCache[e.u] or tostring(e.u)
		local pp = tonumber(e.pp) or 0
		local rb, rm = tonumber(e.rb) or 0, tonumber(e.rm) or 0
		local how = "exact"
		if e.h then how = e.hu and "reconstitué (un achat sans date)" or "reconstitué (anciens logs)"
		elseif e.ap then how = "estimé (achat commencé avant)" end
		popup("🎽 " .. name, PINK, {
			{ "Joueur", "@" .. who },
			{ "Quand", tostring(e.ds) .. " (Montréal)" },
			{ "Prix payé", sep(pp) .. " pts" },
			{ "Voie", SRC[e.s] or tostring(e.s), (e.s == "exploit" or e.s == "external") and C.RED or nil },
			{ "💳 Points achetés", sep(rb) .. " pts  (≈ " .. R(e.rvb) .. ")", GREEN },
			{ "⚡ Points pass/boost", sep(rm) .. " pts", C.ORANGE },
			{ "🆓 Points farmés", sep(math.max(0, pp - rb - rm)) .. " pts" },
			{ "Résultat", VERDICT[e.c] or "?", (e.c == "buy100" or e.c == "buy") and GREEN or C.TEXT_WHITE },
			{ "Stock après", e.sa and (tostring(e.sa) .. " / " .. tostring(e.st or "?")) or "—" },
			{ "Calcul", how, C.TEXT_DIM },
		}, {
			{ "👤 Profil", C.PURPLE, function() openProfileDetail(who, function() screenUGC(false) end) end },
			{ "💸 Achats", GREEN_D, function() economy.openPurchases(e.u) end },
		})
	end

	--════════════════════════════════════════════════════════
	-- 📈 GRAPHIQUE UGC RÉGLABLE
	--════════════════════════════════════════════════════════
	local CLASSES = {
		{ k = "b100",  label = "💳 100 % Robux", color = Color3.fromRGB(70, 210, 120) },
		{ k = "bpart", label = "💳 En partie",   color = Color3.fromRGB(165, 235, 185) },
		{ k = "pass",  label = "⚡ Pass/boost",   color = Color3.fromRGB(235, 160, 40) },
		{ k = "free",  label = "🆓 Farmées",      color = Color3.fromRGB(225, 115, 195) },
		{ k = "gift",  label = "🎁 Sans points",  color = Color3.fromRGB(130, 130, 150) },
		{ k = "unk",   label = "❔ Inconnues",    color = Color3.fromRGB(85, 85, 100) },
	}
	local U = { p = "7d", off = 0, g = nil, asset = nil, metric = "n", cmp = false, hide = {}, sel = nil }
	local UPER = {
		{ id = "1d", label = "Jour" }, { id = "7d", label = "7 j" }, { id = "30d", label = "30 j" },
		{ id = "90d", label = "90 j" }, { id = "365d", label = "1 an" }, { id = "all", label = "Tout" },
	}
	local METRICS = {
		{ id = "n", label = "Nombre" }, { id = "pct", label = "% Robux" },
		{ id = "r", label = "R$ Robux" }, { id = "pts", label = "Points" },
	}
	local GROUP_TXT = { hour = "Par heure", day = "Par jour", week = "Par semaine", month = "Par mois" }

	local function okey(action, o)
		return action .. "|" .. table.concat({ tostring(o.p), tostring(o.off), tostring(o.g), tostring(o.asset),
			tostring(o.cmp), tostring(o.from), tostring(o.to), tostring(o.hour) }, "|")
	end
	local function buyN(b) return (tonumber(b.b100) or 0) + (tonumber(b.bpart) or 0) end
	local function mval(b)
		if U.metric == "pct" then return (b.n > 0) and (buyN(b) / b.n * 100) or 0 end
		if U.metric == "r" then return tonumber(b.r) or 0 end
		if U.metric == "pts" then return tonumber(b.pts) or 0 end
		local v = 0
		for _, c in ipairs(CLASSES) do
			if not U.hide[c.k] then v += tonumber(b[c.k]) or 0 end
		end
		return v
	end
	local function pval(pv)
		if not pv then return nil end
		if U.metric == "pct" then return (pv.n > 0) and (pv.y / pv.n * 100) or 0 end
		if U.metric == "r" then return tonumber(pv.r) or 0 end
		if U.metric == "pts" then return tonumber(pv.pts) or 0 end
		return tonumber(pv.n) or 0
	end
	local function mfmt(v)
		v = tonumber(v) or 0
		if U.metric == "pct" then return string.format("%.0f%%", v) end
		if U.metric == "pts" then return fmtPts(v) or "0" end
		if U.metric == "r" then return sep(v) .. " R$" end
		return sep(v)
	end
	local function niceMax(m)
		if U.metric == "pct" then return 100 end
		if m <= 0 then return 1 end
		local e = 10 ^ math.floor(math.log10(m))
		for _, f in ipairs({ 1, 2, 2.5, 5, 10 }) do
			if f * e >= m then return math.max(1, f * e) end
		end
		return 10 * e
	end

	-- Liste à choisir (UGC)
	local function pickerPopup(title, items)
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.4
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.BorderSizePixel = 0
		ov.ZIndex = 60
		ov.Parent = window
		corner(ov, 14)
		local function close() ov:Destroy() end
		ov.MouseButton1Click:Connect(close)
		local box = Instance.new("TextButton")
		box.AutoButtonColor = false
		box.Text = ""
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.Position = UDim2.fromScale(0.5, 0.5)
		box.Size = UDim2.new(0.94, 0, 0.84, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.ZIndex = 61
		box.Parent = ov
		corner(box, 12) ; stroke(box, PINK, 1.5) ; padding(box, 10)
		label(box, { text = title, size = UDim2.new(1, 0, 0, 24), xAlign = Enum.TextXAlignment.Left, color = PINK,
			textSize = IS_MOBILE and 15 or 18, truncate = true, zIndex = 62 })
		local sc = Instance.new("ScrollingFrame")
		sc.Position = UDim2.new(0, 0, 0, 30)
		sc.Size = UDim2.new(1, 0, 1, -76)
		sc.BackgroundTransparency = 1
		sc.BorderSizePixel = 0
		sc.ScrollBarThickness = 4
		sc.CanvasSize = UDim2.new(0, 0, 0, 0)
		sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
		sc.ScrollingDirection = Enum.ScrollingDirection.Y
		sc.ZIndex = 62
		sc.Parent = box
		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 4)
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Parent = sc
		for i, it in ipairs(items) do
			local r = row(sc, i, { image = it.image, title = it.title, right = it.right, rightColor = PINK, hover = PINK,
				onClick = function() close() it.on() end })
			r.ZIndex = 63
		end
		local bc = Instance.new("Frame")
		bc.AnchorPoint = Vector2.new(0, 1)
		bc.Position = UDim2.new(0, 0, 1, 0)
		bc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		bc.BackgroundTransparency = 1 ; bc.ZIndex = 62 ; bc.Parent = box
		local b = actionButton(bc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = "Fermer",
			textSize = IS_MOBILE and 12 or 14, radius = 8, zIndex = 63 })
		b.MouseButton1Click:Connect(close)
	end

	-- Le graphique : barres empilées, axe gradué, défilement horizontal, barre cliquable
	local function ugcChartView(body, order, res)
		local items = res.buckets
		local n = #items
		local H = IS_MOBILE and 210 or 270
		local f = card(body, order, H)
		local axisW = IS_MOBILE and 36 or 46
		local top, bottom = IS_MOBILE and 14 or 18, IS_MOBILE and 20 or 24
		local plotH = H - top - bottom
		local inner = panelSize().X.Offset - PAD * 2 - axisW - 10
		local colW = math.max(IS_MOBILE and 10 or 13, (n > 0) and (inner / n) or inner)
		local canvasW = math.floor(colW * n)
		local max = 0
		for i, b in ipairs(items) do
			max = math.max(max, mval(b), (res.prev and pval(res.prev[i])) or 0)
		end
		local vmax = niceMax(max)
		for _, q in ipairs({ 0, 0.25, 0.5, 0.75, 1 }) do
			local y = top + (1 - q) * plotH
			label(f, { text = mfmt(vmax * q), size = UDim2.new(0, axisW - 6, 0, 12), position = UDim2.new(0, 2, 0, y - 6),
				xAlign = Enum.TextXAlignment.Right, color = C.TEXT_DIM, textSize = IS_MOBILE and 8 or 10, zIndex = 12 })
			local gl = Instance.new("Frame")
			gl.Position = UDim2.new(0, axisW, 0, y)
			gl.Size = UDim2.new(1, -axisW - 6, 0, 1)
			gl.BackgroundColor3 = C.BORDER_SUBTLE
			gl.BackgroundTransparency = (q == 0) and 0.2 or 0.7
			gl.BorderSizePixel = 0
			gl.ZIndex = 12
			gl.Parent = f
		end
		if n == 0 or max <= 0 then
			label(f, { text = "Rien sur cette période", size = UDim2.fromScale(1, 1), color = C.TEXT_DIM, textSize = MD, zIndex = 13 })
			return f
		end
		local sc = Instance.new("ScrollingFrame")
		sc.Position = UDim2.new(0, axisW, 0, 0)
		sc.Size = UDim2.new(1, -axisW - 6, 1, 0)
		sc.BackgroundTransparency = 1
		sc.BorderSizePixel = 0
		sc.ScrollBarThickness = (canvasW > inner + 1) and 4 or 0
		sc.ScrollingDirection = Enum.ScrollingDirection.X
		sc.CanvasSize = UDim2.new(0, canvasW, 0, 0)
		sc.ZIndex = 12
		sc.Parent = f
		local keepX = U.keepX
		U.keepX = nil
		task.defer(function()
			if sc.Parent then
				sc.CanvasPosition = Vector2.new(keepX or math.max(0, canvasW - sc.AbsoluteSize.X), 0)
			end
		end)
		local every = math.max(1, math.ceil((IS_MOBILE and 36 or 44) / colW))
		local showVals = colW >= (IS_MOBILE and 24 or 30)
		local bw = math.max(3, math.floor(colW * 0.7))
		for i, b in ipairs(items) do
			local col = Instance.new("TextButton")
			col.Text = ""
			col.AutoButtonColor = false
			col.BackgroundColor3 = C.BG_LIGHT
			col.BackgroundTransparency = (i == U.sel) and 0.5 or 1
			col.BorderSizePixel = 0
			col.Position = UDim2.new(0, (i - 1) * colW, 0, 0)
			col.Size = UDim2.new(0, colW, 1, 0)
			col.ZIndex = 12
			col.Parent = sc
			col.MouseButton1Click:Connect(function()
				U.sel = i
				U.keepX = sc.CanvasPosition.X
				screenUGC(false)
			end)
			local base = top + plotH
			local pv = res.prev and pval(res.prev[i])
			if pv and pv > 0 then
				local gh = Instance.new("Frame")
				gh.AnchorPoint = Vector2.new(0.5, 1)
				gh.Position = UDim2.new(0.5, 0, 0, base)
				gh.Size = UDim2.new(0, math.max(4, colW * 0.92), 0, plotH * math.min(1, pv / vmax))
				gh.BackgroundColor3 = C.TEXT_GREY
				gh.BackgroundTransparency = 0.8
				gh.BorderSizePixel = 0
				gh.ZIndex = 13
				gh.Parent = col
			end
			local y = base
			local function seg(v, color)
				if v <= 0 then return end
				local h = plotH * math.min(1, v / vmax)
				local s = Instance.new("Frame")
				s.AnchorPoint = Vector2.new(0.5, 1)
				s.Position = UDim2.new(0.5, 0, 0, y)
				s.Size = UDim2.new(0, bw, 0, math.max(1, h))
				s.BackgroundColor3 = color
				s.BorderSizePixel = 0
				s.ZIndex = 14
				s.Parent = col
				y = y - h
			end
			if U.metric == "n" then
				for _, c in ipairs(CLASSES) do
					if not U.hide[c.k] then seg(tonumber(b[c.k]) or 0, c.color) end
				end
			else
				seg(mval(b), (U.metric == "pts") and PINK or GREEN)
			end
			local v = mval(b)
			if showVals and v > 0 then
				label(col, { text = mfmt(v), size = UDim2.new(0, colW + 10, 0, 12), position = UDim2.new(0.5, 0, 0, y - 1),
					anchor = Vector2.new(0.5, 1), color = (i == U.sel) and GOLD or C.TEXT_GREY,
					textSize = IS_MOBILE and 8 or 10, zIndex = 15 })
			end
			if (i - 1) % every == 0 or i == n or i == U.sel then
				label(col, { text = b.l or "", size = UDim2.new(0, math.max(colW, 44), 0, 12),
					position = UDim2.new(0.5, 0, 0, base + 4), anchor = Vector2.new(0.5, 0),
					color = (i == U.sel) and GOLD or C.TEXT_DIM, textSize = IS_MOBILE and 8 or 10, zIndex = 15 })
			end
		end
		return f
	end

	local function classLine(b)
		local parts = {}
		for _, c in ipairs(CLASSES) do
			local v = tonumber(b[c.k]) or 0
			if v > 0 then table.insert(parts, c.label .. " " .. sep(v)) end
		end
		return (#parts > 0) and table.concat(parts, "  ·  ") or "—"
	end

	local function navRow(body, order, res)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = body
		local function btn(x, w, txt, enabled, cb)
			local c = Instance.new("Frame")
			c.Position = UDim2.new(x, (x > 0) and 3 or 0, 0, 0)
			c.Size = UDim2.new(w, -3, 1, 0)
			c.BackgroundTransparency = 1 ; c.ZIndex = 11 ; c.Parent = f
			local b = actionButton(c, { color = enabled and C.BG_LIGHT or C.BG_MEDIUM,
				strokeColor = enabled and C.BORDER_BRIGHT or C.BORDER_SUBTLE, text = txt,
				textColor = enabled and C.TEXT_WHITE or C.TEXT_DIM, textSize = IS_MOBILE and 11 or 14, radius = 8, zIndex = 12 })
			if enabled then b.MouseButton1Click:Connect(cb) end
		end
		btn(0, 0.2, "◀", res.canPrev == true, function() U.off += 1 ; U.sel = nil ; screenUGC(false) end)
		local mid = Instance.new("Frame")
		mid.Position = UDim2.new(0.2, 3, 0, 0) ; mid.Size = UDim2.new(0.6, -6, 1, 0)
		mid.BackgroundColor3 = C.BG_DARK ; mid.BorderSizePixel = 0 ; mid.ZIndex = 11 ; mid.Parent = f
		corner(mid, 8)
		label(mid, { text = "📅 " .. tostring(res.label), size = UDim2.fromScale(1, 1), color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 12 })
		btn(0.8, 0.2, "▶", res.canNext == true, function() U.off = math.max(0, U.off - 1) ; U.sel = nil ; screenUGC(false) end)
	end

	local function optionsRow(body, order, res)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = body
		local function btn(x, w, txt, color, cb)
			local c = Instance.new("Frame")
			c.Position = UDim2.new(x, (x > 0) and 3 or 0, 0, 0)
			c.Size = UDim2.new(w, -3, 1, 0)
			c.BackgroundTransparency = 1 ; c.ZIndex = 11 ; c.Parent = f
			local b = actionButton(c, { color = color, strokeColor = C.BORDER_BRIGHT, text = txt,
				textSize = IS_MOBILE and 10 or 13, radius = 8, zIndex = 12 })
			b.MouseButton1Click:Connect(cb)
		end
		-- 🎽 Filtre UGC
		local aName = U.asset and (ugcName(U.asset)) or "Toutes les UGC"
		btn(0, 0.46, "🎽 " .. aName .. " ▾", U.asset and PINK_D or C.BG_LIGHT, function()
			local list = { { title = "🌐 Toutes les UGC", on = function() U.asset = nil ; U.sel = nil ; screenUGC(false) end } }
			for _, x in ipairs(U.assetsList or {}) do
				local name, img = ugcName(x.a)
				table.insert(list, { title = name, image = img, right = sep(x.n) .. " sortie" .. (x.n > 1 and "s" or ""),
					on = function() U.asset = x.a ; U.sel = nil ; screenUGC(false) end })
			end
			pickerPopup("🎽 Choisis une UGC", list)
		end)
		-- 📅 Regroupement (tourne entre les choix possibles)
		local allowed = res.allowed or { res.g }
		btn(0.46, 0.3, "📅 " .. (GROUP_TXT[res.g] or "?") .. ((#allowed > 1) and " ⟳" or ""), C.BG_LIGHT, function()
			if #allowed <= 1 then return end
			local i = table.find(allowed, res.g) or 0
			U.g = allowed[i % #allowed + 1]
			U.sel = nil
			screenUGC(false)
		end)
		-- ⇄ Comparer
		btn(0.76, 0.24, U.cmp and "⇄ Comparé" or "⇄ Comparer", U.cmp and PINK_D or C.BG_LIGHT, function()
			U.cmp = not U.cmp
			screenUGC(false)
		end)
	end

	local function legendRow(body, order, res)
		local g = Instance.new("Frame")
		g.Size = UDim2.new(1, 0, 0, 0)
		g.AutomaticSize = Enum.AutomaticSize.Y
		g.BackgroundTransparency = 1
		g.LayoutOrder = order ; g.ZIndex = 11 ; g.Parent = body
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.new(1 / 3, -4, 0, IS_MOBILE and 26 or 30)
		gl.CellPadding = UDim2.new(0, 4, 0, 4)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = g
		for i, c in ipairs(CLASSES) do
			local hidden = U.hide[c.k] == true
			local b = Instance.new("TextButton")
			b.Text = ""
			b.AutoButtonColor = false
			b.BackgroundColor3 = hidden and C.BG_MEDIUM or C.BG_DARK
			b.BorderSizePixel = 0
			b.LayoutOrder = i
			b.ZIndex = 12
			b.Parent = g
			corner(b, 7) ; stroke(b, hidden and C.BORDER_SUBTLE or c.color, 1)
			local dot = Instance.new("Frame")
			dot.AnchorPoint = Vector2.new(0, 0.5)
			dot.Position = UDim2.new(0, 6, 0.5, 0)
			dot.Size = UDim2.new(0, 10, 0, 10)
			dot.BackgroundColor3 = c.color
			dot.BackgroundTransparency = hidden and 0.7 or 0
			dot.BorderSizePixel = 0
			dot.ZIndex = 13
			dot.Parent = b
			corner(dot, 5)
			label(b, { text = c.label .. " " .. sep(res.tot[c.k]), size = UDim2.new(1, -22, 1, 0), position = UDim2.new(0, 20, 0, 0),
				xAlign = Enum.TextXAlignment.Left, color = hidden and C.TEXT_DIM or C.TEXT_WHITE,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
			b.MouseButton1Click:Connect(function()
				U.hide[c.k] = not hidden or nil
				U.keepX = nil
				screenUGC(false)
			end)
		end
	end

	local function salesList(body, order, res, b, alive)
		sectionLabel(body, order, "📜 VENTES · " .. tostring(b.full) .. " · touche pour le détail")
		local ld = note(body, order + 1, "⏳ Chargement des ventes…")
		local o = { from = b.from, to = b.to, asset = res.asset, hour = b.hr }
		fetch("ugcsales", o, function(sr, err)
			if not alive() then return end
			ld:Destroy()
			if not sr then note(body, order + 1, "❌ " .. tostring(err), C.RED) return end
			if sr.tooLong then
				note(body, order + 1, "Cette barre couvre plus de 7 jours. Passe en « Par jour » ou « Par semaine » "
					.. "(bouton 📅) pour voir chaque vente.", C.TEXT_GREY)
				return
			end
			if #sr.entries == 0 then
				note(body, order + 1, sr.expired and "Détail effacé après 90 jours (les totaux du graphique restent)."
					or "Aucune vente ici.", C.TEXT_DIM)
				return
			end
			local ids = {}
			for _, e in ipairs(sr.entries) do table.insert(ids, e.u) end
			resolveUsernames(ids, function()
				if not alive() then return end
				for i, e in ipairs(sr.entries) do
					local name, img = ugcName(e.a, e.an)
					local tag = TAG[e.c] or TAG.unk
					local right = tag[1]
					if e.c == "buy" then right = right .. pct(e.rb, e.pp) end
					local bad = (e.s == "exploit" or e.s == "external")
					row(body, order + 1 + i, { image = img, title = name,
						sub = "@" .. (unameCache[e.u] or tostring(e.u)) .. " · " .. tostring(e.ds) .. " · "
							.. (SRC[e.s] or tostring(e.s)) .. (e.h and " · 🕰️" or ""),
						subColor = bad and C.RED or nil, right = right, rightColor = tag[2], hover = PINK,
						onClick = function() ugcDetail(e) end })
				end
				if (sr.total or 0) > #sr.entries then
					note(body, order + 900, string.format("… %s ventes au total, les %d plus récentes affichées.",
						sep(sr.total), #sr.entries), C.TEXT_DIM)
				end
			end)
		end, okey("ugcsales", o))
	end

	screenUGC = function(fresh)
		currentScreen = "ugcstats"
		ST.token += 1
		local tok = ST.token
		if fresh then ST.cache = {} end
		local body = buildScreen("🎽 UGC STATS", true, PINK, nil, function() ST.cache = {} ; screenUGC(false) end)
		local function alive() return ST.token == tok and currentScreen == "ugcstats" and body.Parent ~= nil end
		acTabBar(body, 1, UPER, U.p, PINK_D, function(id)
			U.p, U.off, U.g, U.sel, U.keepX = id, 0, nil, nil, nil
			screenUGC(false)
		end)
		local loading = note(body, 2, "⏳ Chargement…")
		local o = { p = U.p, off = U.off, g = U.g, asset = U.asset, cmp = U.cmp }

		fetch("ugcchart", o, function(res, err)
			if not alive() then return end
			loading:Destroy()
			if not res then note(body, 2, "❌ " .. tostring(err), C.RED) return end
			U.off = res.off or U.off
			if not U.asset and res.assets and #res.assets > 0 then U.assetsList = res.assets end
			local selKey = tostring(res.label) .. "|" .. tostring(res.g) .. "|" .. tostring(res.asset)
			if U.selKey ~= selKey then U.selKey, U.sel = selKey, nil end
			local items = res.buckets
			if not U.sel or not items[U.sel] then
				U.sel = #items
				for i = #items, 1, -1 do
					if (items[i].n or 0) > 0 then U.sel = i break end
				end
			end

			navRow(body, 3, res)
			optionsRow(body, 4, res)

			-- ── Résumé de la période affichée ──
			local t = res.tot
			local hero = card(body, 5, IS_MOBILE and 104 or 124)
			line(hero, 8, 16, "UGC SORTIES" .. (res.asset and (" · " .. ugcName(res.asset)) or ""), C.TEXT_GREY, SM)
			line(hero, IS_MOBILE and 24 or 26, IS_MOBILE and 32 or 40, sep(t.n), PINK, IS_MOBILE and 28 or 36)
			if res.prevTot then
				local dt, dc = deltaTxt(t.n, res.prevTot.n)
				label(hero, { text = (dt or "—") .. " période d'avant (" .. sep(res.prevTot.n) .. ")",
					size = UDim2.new(0.6, -12, 0, 16), position = UDim2.new(0.4, 0, 0, IS_MOBILE and 34 or 38),
					xAlign = Enum.TextXAlignment.Right, color = dc or C.TEXT_GREY, textSize = SM, truncate = true, zIndex = 12 })
			end
			line(hero, IS_MOBILE and 60 or 70, IS_MOBILE and 18 or 22, string.format(
				"💳 %s payée%s avec des points achetés en Robux  (%s)  ·  ≈ %s", sep(buyN(t)), buyN(t) > 1 and "s" or "",
				pct(buyN(t), t.n), R(t.r)), GREEN, MD)
			line(hero, IS_MOBILE and 80 or 96, 16, string.format("dont %s à 100 %%  ·  %s pts dépensés",
				sep(t.b100), sep(t.pts)), C.TEXT_GREY, SM)

			-- ── Ce qu'on regarde ──
			acTabBar(body, 6, METRICS, U.metric, PINK_D, function(id) U.metric = id ; screenUGC(false) end)
			if U.metric == "n" then legendRow(body, 7, res) end

			-- ── Graphique ──
			if res.empty then
				note(body, 8, "Pas de données avant le " .. tostring(res.since) .. ".", C.TEXT_DIM)
			else
				ugcChartView(body, 8, res)
			end
			note(body, 9, "Touche une barre pour voir son détail et chacune de ses ventes"
				.. (U.metric == "n" and " · touche une catégorie pour la masquer" or "")
				.. (res.prev and " · gris = période d'avant" or "") .. ".", C.TEXT_DIM)

			if res.hist and res.hist.state ~= "done" then
				note(body, 10, string.format("⏳ Reconstitution des jours d'avant le %s en cours : %d %%.",
					tostring(res.installed), tonumber(res.hist.pct) or 0), C.ORANGE)
			elseif (t.h or 0) > 0 then
				note(body, 10, string.format("🕰️ %s UGC d'avant le %s sont reconstituées depuis tes anciens logs "
					.. "(points achetés datés + cadeaux reçus ; pass/boosts d'avant inconnus).",
					sep(t.h), tostring(res.installed)), C.TEXT_DIM)
			end

			-- ── Barre sélectionnée ──
			local b = items[U.sel]
			if b then
				local bc = card(body, 11, IS_MOBILE and 92 or 108)
				line(bc, 8, 18, "📅 " .. tostring(b.full), GOLD, MD)
				line(bc, IS_MOBILE and 30 or 34, 16, string.format("%s UGC  ·  💳 %s payées en Robux (%s)  ·  ≈ %s",
					sep(b.n), sep(buyN(b)), pct(buyN(b), b.n), R(b.r)), GREEN, SM)
				line(bc, IS_MOBILE and 50 or 56, 16, classLine(b), C.TEXT_GREY, SM)
				local pv = res.prev and res.prev[U.sel]
				if pv then
					line(bc, IS_MOBILE and 70 or 78, 16, string.format("Période d'avant (%s) : %s UGC · %s en Robux",
						tostring(pv.l), sep(pv.n), sep(pv.y)), C.TEXT_DIM, SM)
				end
				if (b.n or 0) > 0 then salesList(body, 20, res, b, alive) end
			end

			note(body, 2000, "💳 Règle : quand un joueur achète une UGC, ses points ACHETÉS en Robux (packs de points, "
				.. "cadeaux de points reçus) sont dépensés EN PREMIER. Il achète 2M de points puis une UGC à 2M → "
				.. "100 % Robux. 🕰️ = reconstituée depuis les anciens logs. Heures de Montréal.", C.TEXT_DIM)
		end, okey("ugcchart", o))
	end

	--════════════════════════════════════════════════════════
	-- 🏠 BOUTONS DE L'ACCUEIL
	--════════════════════════════════════════════════════════
	table.insert(ACTIONS, { id = "revenue", name = "💸 REVENUS", color = GREEN })
	table.insert(ACTIONS, { id = "ugcstats", name = "🎽 UGC STATS", color = PINK })
	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "revenue" then screenRevenue(true) return end
		if a and a.id == "ugcstats" then screenUGC(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
	_G.AdminOpenUGCStats = function() screenUGC(true) end

	print("✅ Bloc 14 chargé — 💸 REVENUS + 🎽 UGC STATS")
end)()


--════════════════════════════════════════════════════════════════════════════
-- 📊 BLOC 15 — STATS   (v3 : REMPLACE le bloc 15 v2)
--
--  📍 OÙ COLLER ? Dans « ADMIN PANEL — CLIENT », À LA PLACE de l'ancien bloc 15
--     (de sa ligne « 📊 BLOC 15 — STATS » jusqu'à son `end)()`),
--     donc toujours juste avant « 📜 BLOC 11 » (qui reste le DERNIER).
--  Bouton d'accueil : 📊 STATS. Deux onglets :
--    🎽 Joueurs & UGC  → script serveur « PLAYER UGC STATS » (nouveau)
--    💸 Achats & pubs  → script serveur « STATS » (v2, inchangé)
--  Tout est en tuiles et en barres : le chiffre important en gros, le détail
--  derrière « ℹ️ Comment lire ».
--════════════════════════════════════════════════════════════════════════════
;(function()
	local BLUE   = Color3.fromRGB(110, 180, 255)
	local BLUE_D = Color3.fromRGB(40, 90, 150)
	local ORANGE = Color3.fromRGB(255, 170, 70)
	local GREEN  = Color3.fromRGB(90, 220, 140)
	local PINK   = Color3.fromRGB(255, 150, 220)
	local GOLD   = Color3.fromRGB(255, 205, 70)
	local VIOLET = Color3.fromRGB(180, 140, 255)
	local GREY   = Color3.fromRGB(150, 150, 165)
	local SM = IS_MOBILE and 10 or 12
	local BIG = IS_MOBILE and 18 or 24

	local Cat
	pcall(function() Cat = require(ReplicatedStorage:WaitForChild("ProductCatalog", 15)) end)
	local function itemName(key)   -- "gp1891589121" / "dp3606598188"
		local id = tonumber(key:sub(3))
		local n = Cat and id and Cat.Name(id) or key
		return (key:sub(1, 2) == "gp" and "🎟️ " or "🛍️ ") .. n
	end

	local ST = { tab = "ugc", p = 7, scope = "all", away = 7, cache = {}, token = 0, help = {} }
	local PERIODS = {
		{ id = 1, label = "Aujourd'hui" }, { id = 7, label = "7 jours" }, { id = 30, label = "30 jours" },
	}

	--════════════════════════════════════════════════════════
	-- 📞 LECTURES
	--════════════════════════════════════════════════════════
	local function fetchFrom(remoteName, arg, key, ttl, cb)
		local c = ST.cache[key]
		if c and os.clock() - c.at < ttl then cb(c.data) return end
		local fn = ReplicatedStorage:FindFirstChild(remoteName)
		if not fn then
			cb(nil, remoteName == "AdminPlayerStats_Get"
				and "Le script serveur PLAYER UGC STATS n'est pas installé."
				or "Le script serveur STATS n'est pas installé.")
			return
		end
		task.spawn(function()
			for attempt = 1, 5 do
				local ok, res = pcall(function() return fn:InvokeServer(arg) end)
				if ok and type(res) == "table" and res.ok then
					ST.cache[key] = { data = res, at = os.clock() }
					cb(res) return
				end
				if ok and type(res) == "table" and res.err == "non admin" then cb(nil, res.err) return end
				task.wait(0.5 * attempt)
			end
			cb(nil, "Serveur occupé, appuie sur 🔄.")
		end)
	end

	local function sep(n)
		n = math.floor((tonumber(n) or 0) + 0.5)
		local s = tostring(math.abs(n)):reverse():gsub("(%d%d%d)", "%1 "):reverse()
		return (n < 0 and "-" or "") .. s:gsub("^%s+", "")
	end
	local function pct(a, b)
		a, b = tonumber(a) or 0, tonumber(b) or 0
		if b <= 0 then return "—" end
		local v = a / b * 100
		if v > 0 and v < 1 then return "<1 %" end
		return string.format("%.0f %%", v)
	end
	local function avg1(a, b)
		a, b = tonumber(a) or 0, tonumber(b) or 0
		if b <= 0 then return "—" end
		return string.format("%.1f", a / b)
	end
	local function dur(sec)
		sec = math.floor(tonumber(sec) or 0)
		local d, h, m = math.floor(sec / 86400), math.floor(sec % 86400 / 3600), math.floor(sec % 3600 / 60)
		if d > 0 then return string.format("%d j %d h", d, h) end
		if h > 0 then return string.format("%d h %02d", h, m) end
		return string.format("%d min", math.max(m, sec > 0 and 1 or 0))
	end
	local function quant(list, q)
		if #list == 0 then return nil end
		local i = math.clamp(math.floor((#list - 1) * q + 1.5), 1, #list)
		return list[i]
	end

	--════════════════════════════════════════════════════════
	-- 🧱 BRIQUES VISUELLES
	--════════════════════════════════════════════════════════
	local function card(parent, order, title, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 12) ; stroke(f, color or C.BORDER_SUBTLE, 1)
		local pad = Instance.new("UIPadding")
		pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 10)
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
		pad.Parent = f
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, IS_MOBILE and 5 or 7)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = f
		if title then
			local t = label(f, { text = title, size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20),
				xAlign = Enum.TextXAlignment.Left, color = color or C.TEXT_WHITE,
				textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12 })
			t.LayoutOrder = 0
		end
		return f
	end

	-- « ℹ️ Comment lire » : le texte d'explication reste caché tant qu'on ne le demande pas
	local function help(parent, order, id, text)
		local open = ST.help[id] == true
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, 0, 0, 0)
		b.AutomaticSize = Enum.AutomaticSize.Y
		b.BackgroundTransparency = 1
		b.Text = ""
		b.LayoutOrder = order
		b.ZIndex = 12
		b.Parent = parent
		local l = label(b, { text = open and ("ℹ️ " .. text) or "ℹ️ Comment lire",
			size = UDim2.new(1, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_DIM, textSize = SM, wrapped = true, zIndex = 13 })
		l.AutomaticSize = Enum.AutomaticSize.Y
		b.MouseButton1Click:Connect(function()
			ST.help[id] = not open
			open = not open
			l.Text = open and ("ℹ️ " .. text) or "ℹ️ Comment lire"
		end)
	end

	-- une rangée de 2 à 4 tuiles : gros chiffre + légende courte
	local function tiles(parent, order, items)
		local h = IS_MOBILE and 54 or 68
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, h)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order
		row.ZIndex = 12
		row.Parent = parent
		local n = math.max(1, #items)
		local gap = 6
		for i, it in ipairs(items) do
			local t = Instance.new("Frame")
			t.Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0)
			t.Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0)
			t.BackgroundColor3 = C.BG_ITEM
			t.BorderSizePixel = 0
			t.ZIndex = 12
			t.Parent = row
			corner(t, 10) ; stroke(t, it.color or C.BORDER_SUBTLE, 1, 0.4)
			label(t, { text = tostring(it.value), size = UDim2.new(1, -8, 0.58, 0), position = UDim2.new(0, 4, 0, 4),
				color = it.color or C.TEXT_WHITE, textSize = BIG, truncate = true, zIndex = 13 })
			local cap = label(t, { text = it.label, size = UDim2.new(1, -8, 0.4, -4), position = UDim2.new(0, 4, 0.58, 0),
				color = C.TEXT_GREY, textSize = IS_MOBILE and 9 or 11, wrapped = true, zIndex = 13 })
			cap.TextYAlignment = Enum.TextYAlignment.Top
		end
		return row
	end

	-- une barre horizontale : libellé · barre · valeur
	local function hbar(parent, order, text, frac, color, valueText)
		local h = IS_MOBILE and 20 or 24
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, h)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order
		row.ZIndex = 12
		row.Parent = parent
		label(row, { text = text, size = UDim2.new(0.34, -4, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_WHITE, textSize = SM, truncate = true, zIndex = 13 })
		local track = Instance.new("Frame")
		track.Size = UDim2.new(0.42, -4, 0, IS_MOBILE and 10 or 12)
		track.Position = UDim2.new(0.34, 0, 0.5, 0)
		track.AnchorPoint = Vector2.new(0, 0.5)
		track.BackgroundColor3 = C.BG_ITEM
		track.BorderSizePixel = 0
		track.ZIndex = 13
		track.Parent = row
		corner(track, 6)
		frac = math.clamp(tonumber(frac) or 0, 0, 1)
		if frac > 0 then
			local fill = Instance.new("Frame")
			fill.Size = UDim2.new(math.max(frac, 0.02), 0, 1, 0)
			fill.BackgroundColor3 = color or BLUE
			fill.BorderSizePixel = 0
			fill.ZIndex = 14
			fill.Parent = track
			corner(fill, 6)
		end
		label(row, { text = valueText or "", size = UDim2.new(0.24, 0, 1, 0), position = UDim2.new(0.76, 0, 0, 0),
			xAlign = Enum.TextXAlignment.Right, color = color or C.TEXT_WHITE, textSize = SM, truncate = true, zIndex = 13 })
		return row
	end

	-- une barre empilée (répartition) + sa légende
	local function stack(parent, order, text, parts)
		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		wrap.BackgroundTransparency = 1
		wrap.LayoutOrder = order
		wrap.ZIndex = 12
		wrap.Parent = parent
		label(wrap, { text = text, size = UDim2.new(1, 0, 0, IS_MOBILE and 13 or 15), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_WHITE, textSize = SM, truncate = true, zIndex = 13 })
		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 18)
		bar.Position = UDim2.new(0, 0, 1, 0)
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.BackgroundColor3 = C.BG_ITEM
		bar.BorderSizePixel = 0
		bar.ClipsDescendants = true
		bar.ZIndex = 13
		bar.Parent = wrap
		corner(bar, 6)
		local x = 0
		for _, p in ipairs(parts) do
			local w = math.clamp(tonumber(p.frac) or 0, 0, 1)
			if w > 0 then
				local s = Instance.new("Frame")
				s.Size = UDim2.new(w, 0, 1, 0)
				s.Position = UDim2.new(x, 0, 0, 0)
				s.BackgroundColor3 = p.color
				s.BorderSizePixel = 0
				s.ZIndex = 14
				s.Parent = bar
				if w >= 0.12 then
					label(s, { text = p.short or "", size = UDim2.fromScale(1, 1), color = Color3.new(0, 0, 0),
						textSize = IS_MOBILE and 8 or 10, truncate = true, zIndex = 15 })
				end
				x += w
			end
		end
		return wrap
	end

	local function legend(parent, order, parts)
		local t = {}
		for _, p in ipairs(parts) do
			table.insert(t, string.format('<font color="#%s">■</font> %s', p.color:ToHex(), p.label))
		end
		local l = label(parent, { text = table.concat(t, "   "), size = UDim2.new(1, 0, 0, 0), richText = true,
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = SM, wrapped = true, zIndex = 13 })
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.LayoutOrder = order
		return l
	end

	local function chips(parent, order, items, selected, color, onPick)
		return acTabBar(parent, order, items, selected, color, onPick)
	end

	local function statusNote(parent, order, text, color)
		local f = card(parent, order, nil, color)
		local l = label(f, { text = text, size = UDim2.new(1, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = color or C.TEXT_GREY, textSize = SM, wrapped = true, zIndex = 12 })
		l.AutomaticSize = Enum.AutomaticSize.Y
		return f
	end

	-- histogramme par jour (onglet achats)
	local function bars(parent, order, days, key, title, color)
		local H = IS_MOBILE and 110 or 140
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, H)
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 12) ; stroke(f, C.BORDER_SUBTLE, 1)
		label(f, { text = title, size = UDim2.new(1, -24, 0, 16), position = UDim2.new(0, 12, 0, 6),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = SM, truncate = true, zIndex = 12 })
		local max = 0
		for _, d in ipairs(days) do max = math.max(max, tonumber(d.v[key]) or 0) end
		if max <= 0 then
			label(f, { text = "Rien sur cette période", size = UDim2.fromScale(1, 1), color = C.TEXT_DIM,
				textSize = IS_MOBILE and 12 or 15, zIndex = 12 })
			return
		end
		local plot = Instance.new("Frame")
		plot.BackgroundTransparency = 1
		plot.Position = UDim2.new(0, 8, 0, 26)
		plot.Size = UDim2.new(1, -16, 1, -44)
		plot.ZIndex = 12
		plot.Parent = f
		local n = #days
		local every = math.max(1, math.ceil(n / (IS_MOBILE and 7 or 12)))
		for i, d in ipairs(days) do
			local v = tonumber(d.v[key]) or 0
			local col = Instance.new("Frame")
			col.BackgroundTransparency = 1
			col.Size = UDim2.new(1 / n, 0, 1, 0)
			col.Position = UDim2.new((i - 1) / n, 0, 0, 0)
			col.ZIndex = 12
			col.Parent = plot
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 1)
			bar.Position = UDim2.new(0.5, 0, 1, 0)
			bar.Size = UDim2.new(0.66, 0, v / max, v > 0 and 0 or 1)
			bar.BackgroundColor3 = color
			bar.BorderSizePixel = 0
			bar.ZIndex = 13
			bar.Parent = col
			if n <= 14 and v > 0 then
				label(col, { text = sep(v), size = UDim2.new(1, 12, 0, 12), position = UDim2.new(0.5, 0, 1 - v / max, -2),
					anchor = Vector2.new(0.5, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 8 or 10, zIndex = 15 })
			end
			if i % every == 0 or i == 1 or i == n then
				label(col, { text = d.l, size = UDim2.new(1, 16, 0, 12), position = UDim2.new(0.5, 0, 1, 3),
					anchor = Vector2.new(0.5, 0), color = C.TEXT_DIM, textSize = IS_MOBILE and 8 or 9, zIndex = 15 })
			end
		end
	end

	--════════════════════════════════════════════════════════
	-- 🎽 ONGLET JOUEURS & UGC
	--════════════════════════════════════════════════════════
	local TYPES = {
		{ id = 0, label = "🆓 Sans pass",     color = GREY },
		{ id = 1, label = "👑 VIP",           color = GOLD },
		{ id = 2, label = "⚡ Boost perm.",   color = BLUE },
		{ id = 3, label = "👑⚡ VIP + boost", color = VIOLET },
	}
	local U_BUCKETS = {   -- ce qu'on montre : 0, 1, 2, 3, 4-5, 6-9, 10+
		{ lo = 0, hi = 0, label = "0 UGC" }, { lo = 1, hi = 1, label = "1 UGC" },
		{ lo = 2, hi = 2, label = "2 UGC" }, { lo = 3, hi = 3, label = "3 UGC" },
		{ lo = 4, hi = 5, label = "4 – 5" }, { lo = 6, hi = 9, label = "6 – 9" },
		{ lo = 10, hi = 10, label = "10 et +" },
	}
	local function typeOf(f) -- 0 sans pass · 1 VIP · 2 boost · 3 VIP + boost
		f = math.floor(tonumber(f) or 0)
		local vip = f % 2 == 1
		local boost = f >= 2
		return (vip and 1 or 0) + (boost and 2 or 0)
	end
	local function dayIndex(dk)
		local y, m, d = tonumber(dk:sub(1, 4)), tonumber(dk:sub(5, 6)), tonumber(dk:sub(7, 8))
		if not (y and m and d) then return nil end
		return math.floor(os.time({ year = y, month = m, day = d, hour = 12 }) / 86400)
	end

	-- additionne les cases selon le filtre : "all" · "active" (vus il y a < away j) · "gone" (≥ away j)
	local function crunch(res, scope, away)
		local T = { n = 0, ugc = 0, withU = 0, u = {}, types = {}, vipx2 = 0 }
		for i = 0, 3 do T.types[i] = { n = 0, ugc = 0, withU = 0, u = {} } end
		local t0 = dayIndex(res.today or "") or 0
		for dk, cells in pairs(res.last or {}) do
			local di = dayIndex(dk)
			local ago = di and (t0 - di) or 0
			local keep = (scope == "all") or (scope == "active" and ago < away) or (scope == "gone" and ago >= away)
			if keep then
				for c, n in pairs(cells) do
					n = tonumber(n) or 0
					local f, u = c:match("^(%d+)|(%d+)$")
					f, u = tonumber(f), tonumber(u)
					if f and u and n ~= 0 then
						local ty = T.types[typeOf(f)]
						T.n += n ; ty.n += n
						T.ugc += n * u ; ty.ugc += n * u
						T.u[u] = (T.u[u] or 0) + n ; ty.u[u] = (ty.u[u] or 0) + n
						if u > 0 then T.withU += n ; ty.withU += n end
						if f % 2 == 1 and math.floor(f / 2) % 2 == 1 then T.vipx2 += n end
					end
				end
			end
		end
		return T
	end
	local function inBucket(t, b)
		local n = 0
		for u = b.lo, b.hi do n += math.max(0, t.u[u] or 0) end
		return n
	end

	local function renderUGC(body, order0)
		local order = order0
		local function nextO() order += 1 return order end
		local loading = statusNote(body, nextO(), "⏳ Chargement…")
		fetchFrom("AdminPlayerStats_Get", false, "ugc", 60, function(res, err)
			if not loading.Parent then return end
			loading:Destroy()
			if not res then statusNote(body, nextO(), "⚠️ " .. tostring(err), C.RED) return end

			-- 🎚️ qui on regarde
			local awayLbl = "Partis (+" .. ST.away .. " j)"
			chips(body, nextO(), {
				{ id = "all", label = "👥 Tous" }, { id = "active", label = "🟢 Actifs" }, { id = "gone", label = "💤 " .. awayLbl },
			}, ST.scope, BLUE_D, function(id) ST.scope = id ; ST.redraw() end)
			chips(body, nextO(), {
				{ id = 3, label = "3 j" }, { id = 7, label = "7 j" }, { id = 14, label = "14 j" }, { id = 30, label = "30 j" },
			}, ST.away, C.BG_LIGHT, function(id) ST.away = id ; ST.redraw() end)

			local T = crunch(res, ST.scope, ST.away)
			if not res.bf or not res.bf.done then
				statusNote(body, nextO(), string.format("📥 Les anciens joueurs sont en train d'être ajoutés (%s déjà). "
					.. "Les chiffres se complètent tout seuls dans les prochaines heures.", sep(res.bf and res.bf.n or 0)), ORANGE)
			end
			if res.studio then statusNote(body, nextO(), "🧪 Studio : lecture seule, rien n'est compté ici.", C.TEXT_DIM) end
			if T.n <= 0 then
				statusNote(body, nextO(), "Pas encore de joueur dans ce filtre.", C.TEXT_DIM)
				return
			end

			-- ① L'ESSENTIEL
			local c1 = card(body, nextO(), ST.scope == "gone" and ("💤 Joueurs partis (pas revenus depuis " .. ST.away .. " j)")
				or (ST.scope == "active" and ("🟢 Joueurs actifs (venus ces " .. ST.away .. " derniers jours)") or "👥 Tous les joueurs"), BLUE)
			tiles(c1, 1, {
				{ value = sep(T.n), label = "joueurs", color = C.TEXT_WHITE },
				{ value = pct(T.n - T.withU, T.n), label = "n'ont AUCUNE UGC", color = C.RED },
				{ value = pct(T.withU, T.n), label = "ont au moins 1 UGC", color = GREEN },
				{ value = avg1(T.ugc, T.n), label = "UGC en moyenne", color = PINK },
			})

			-- ② COMBIEN D'UGC ?
			local c2 = card(body, nextO(), "🎽 Combien d'UGC ont-ils ?", PINK)
			for i, b in ipairs(U_BUCKETS) do
				local n = inBucket(T, b)
				hbar(c2, i, b.label, n / T.n, b.lo == 0 and C.RED or PINK, pct(n, T.n) .. "  ·  " .. sep(n))
			end

			-- ③ PAR TYPE DE JOUEUR
			local c3 = card(body, nextO(), "🏷️ Par type de joueur", GOLD)
			tiles(c3, 1, {
				{ value = pct(T.types[1].n + T.types[3].n, T.n), label = "ont le 👑 VIP", color = GOLD },
				{ value = pct(T.types[2].n + T.types[3].n, T.n), label = "ont un ⚡ boost permanent", color = BLUE },
				{ value = pct(T.vipx2, T.n), label = "ont 👑 VIP + ⚡ x2", color = VIOLET },
			})
			local row = 1
			for _, ty in ipairs(TYPES) do
				local t = T.types[ty.id]
				if t.n > 0 then
					row += 1
					hbar(c3, row, ty.label, t.withU / t.n, ty.color,
						"moy. " .. avg1(t.ugc, t.n) .. " UGC  ·  " .. sep(t.n) .. " joueurs")
				end
			end
			help(c3, 99, "types", "Barre = part des joueurs de ce type qui ont au moins 1 UGC. « moy. » = UGC par joueur. "
				.. "Boost permanent = x2, x5 ou x10 (acheté ou offert).")

			-- ④ AVANT DE PARTIR (seulement les joueurs partis)
			local G = (ST.scope == "gone") and T or crunch(res, "gone", ST.away)
			local c4 = card(body, nextO(), "💤 Combien d'UGC avant d'arrêter de jouer ?", ORANGE)
			local PARTS = {
				{ lo = 0, hi = 0, color = C.RED, label = "0", short = "0" },
				{ lo = 1, hi = 1, color = ORANGE, label = "1", short = "1" },
				{ lo = 2, hi = 2, color = GOLD, label = "2", short = "2" },
				{ lo = 3, hi = 5, color = GREEN, label = "3 – 5", short = "3-5" },
				{ lo = 6, hi = 10, color = BLUE, label = "6 et +", short = "6+" },
			}
			if G.n <= 0 then
				statusNote(c4, 1, "Personne n'est parti depuis " .. ST.away .. " j (ou pas encore assez de recul).", C.TEXT_DIM)
			else
				local function partsOf(t)
					local out = {}
					for _, p in ipairs(PARTS) do
						table.insert(out, { frac = inBucket(t, p) / math.max(1, t.n), color = p.color, short = p.short })
					end
					return out
				end
				stack(c4, 1, "👥 Tous  ·  " .. sep(G.n) .. " partis  ·  moy. " .. avg1(G.ugc, G.n) .. " UGC", partsOf(G))
				local r = 1
				for _, ty in ipairs(TYPES) do
					local t = G.types[ty.id]
					if t.n > 0 then
						r += 1
						stack(c4, r, ty.label .. "  ·  " .. sep(t.n) .. "  ·  moy. " .. avg1(t.ugc, t.n), partsOf(t))
					end
				end
				legend(c4, 90, (function()
					local l = {}
					for _, p in ipairs(PARTS) do table.insert(l, { color = p.color, label = p.label .. " UGC" }) end
					return l
				end)())
			end
			help(c4, 99, "gone", "Un joueur « parti » n'est pas revenu depuis le nombre de jours choisi en haut "
				.. "(3, 7, 14 ou 30). On regarde combien d'UGC il avait à sa dernière visite.")

			-- ⑤ TEMPS POUR AVOIR UNE UGC
			local c5 = card(body, nextO(), "⏱️ Temps de jeu pour avoir une UGC", GREEN)
			local ord = {}
			local byType1 = {}
			for k, v in pairs(res.ttu or {}) do
				local f, o = tostring(k):match("^(%d+)|(%d+)$")
				f, o = tonumber(f), tonumber(o)
				if f and o and type(v) == "table" then
					local x = ord[o] or { 0, 0, 0, 0 }
					for j = 1, 4 do x[j] += tonumber(v[j]) or 0 end
					ord[o] = x
					if o == 1 then
						local ty = typeOf(f)
						local y = byType1[ty] or { 0, 0 }
						y[1] += tonumber(v[1]) or 0 ; y[2] += tonumber(v[2]) or 0
						byType1[ty] = y
					end
				end
			end
			local maxT = 0
			for o = 1, 5 do
				local x = ord[o]
				if x and x[1] > 0 then maxT = math.max(maxT, x[2] / x[1]) end
			end
			if maxT <= 0 then
				statusNote(c5, 1, "Pas encore mesuré : il faut qu'un joueur obtienne une UGC après l'installation.", C.TEXT_DIM)
			else
				local names = { "1re UGC", "2e UGC", "3e UGC", "4e UGC", "5e et +" }
				for o = 1, 5 do
					local x = ord[o]
					if x and x[1] > 0 then
						local a = x[2] / x[1]
						hbar(c5, o, names[o], a / maxT, GREEN, dur(a) .. "  ·  " .. sep(x[1]))
					end
				end
				local d1 = ord[1]
				if d1 and d1[3] > 0 then
					tiles(c5, 20, {
						{ value = string.format("%.1f j", d1[4] / d1[3]), label = "jours réels avant la 1re UGC (nouveaux joueurs)", color = GREEN },
						{ value = sep(d1[3]), label = "nouveaux joueurs mesurés", color = C.TEXT_WHITE },
					})
				end
				local r = 30
				local maxTy = 0
				for _, y in pairs(byType1) do if y[1] > 0 then maxTy = math.max(maxTy, y[2] / y[1]) end end
				for _, ty in ipairs(TYPES) do
					local y = byType1[ty.id]
					if y and y[1] > 0 then
						r += 1
						hbar(c5, r, "1re · " .. ty.label, (y[2] / y[1]) / math.max(maxTy, 1), ty.color, dur(y[2] / y[1]))
					end
				end
			end
			help(c5, 99, "ttu", "Temps de JEU (pas les jours) entre deux UGC : 1re = depuis le tout début, "
				.. "2e = depuis la 1re, etc. Le petit nombre à droite = UGC mesurées. Compté depuis l'installation.")
		end)
	end

	--════════════════════════════════════════════════════════
	-- 💸 ONGLET ACHATS & PUBS (données du script STATS v2)
	--════════════════════════════════════════════════════════
	local function bySource(T, renamed)
		local S = {}
		local function get(src)
			-- 🩹 anciens noms de provenance (ex. « toutes les 13 min ») regroupés sous le nom actuel
			src = (renamed and renamed[src]) or src
			local s = S[src]
			if not s then s = { src = src, pr = 0, by = 0, rb = 0, items = {} } S[src] = s end
			return s
		end
		for k, n in pairs(T) do
			local kind, src, item = k:match("^(%a%a)|(.-)|(%a%a%d+)$")
			if kind == "pr" or kind == "by" then
				local s = get(src)
				s[kind] += n
				local it = s.items[item]
				if not it then it = { pr = 0, by = 0 } s.items[item] = it end
				it[kind] += n
			else
				local src2 = k:match("^rb|(.+)$")
				if src2 then local g = get(src2) ; g.rb = g.rb + n end
			end
		end
		local list = {}
		for _, s in pairs(S) do table.insert(list, s) end
		table.sort(list, function(a, b)
			if a.rb ~= b.rb then return a.rb > b.rb end
			return a.pr > b.pr
		end)
		return list
	end

	local function renderBuy(body, order0)
		local order = order0
		local function nextO() order += 1 return order end
		chips(body, nextO(), PERIODS, ST.p, BLUE_D, function(id) ST.p = id ; ST.redraw() end)
		local loading = statusNote(body, nextO(), "⏳ Chargement…")
		fetchFrom("AdminEngage_Get", ST.p, "buy" .. ST.p, 30, function(res, err)
			if not loading.Parent then return end
			loading:Destroy()
			if not res then statusNote(body, nextO(), "⚠️ " .. tostring(err), C.RED) return end

			local T, samples = {}, {}
			for _, d in ipairs(res.days) do
				for k, n in pairs(d.v) do
					if k == "ttu" then
						if type(n) == "table" then for _, s in ipairs(n) do table.insert(samples, s) end end
					elseif type(n) == "number" then
						T[k] = (T[k] or 0) + n
					end
				end
			end
			-- 🩹 moyenne sur les jours qui ont des données (avant : les jours d'avant
			--    l'installation comptaient comme 0 joueur et faisaient baisser la moyenne)
			local nDays = 0
			for _, d in ipairs(res.days) do
				if (tonumber(d.v.players_u) or 0) > 0 then nDays += 1 end
			end
			nDays = math.max(1, nDays)
			local players = T.players_u or 0

			-- 👥 + 💸 L'ESSENTIEL
			local c1 = card(body, nextO(), "💸 L'essentiel", GREEN)
			tiles(c1, 1, {
				{ value = sep(players / nDays), label = "joueurs / jour", color = C.TEXT_WHITE },
				{ value = sep(T.by_tot), label = "achats", color = GREEN },
				{ value = pct(T.by_u, players), label = "des joueurs achètent (chaque jour)", color = GREEN },
				{ value = sep(T.rb_tot), label = "Robux (prix affiché)", color = GOLD },
			})
			tiles(c1, 2, {
				{ value = pct(T.by_tot, T.pr_tot), label = "fenêtres d'achat → achat", color = GREEN },
				{ value = pct(T.friend_u, players), label = "jouent avec un ami", color = BLUE },
			})
			bars(body, nextO(), res.days, "rb_tot", "💸 Robux par jour", GREEN)

			-- 🧭 D'OÙ VIENNENT LES ACHATS (Robux par provenance)
			local list = bySource(T, res.renamed)
			local c2 = card(body, nextO(), "🧭 D'où viennent les Robux", GOLD)
			local maxRb = 0
			for _, s in ipairs(list) do maxRb = math.max(maxRb, s.rb) end
			local shown = 0
			for _, s in ipairs(list) do
				if shown >= 10 then break end
				if s.rb > 0 or s.by > 0 then
					shown += 1
					hbar(c2, shown, s.src, maxRb > 0 and s.rb / maxRb or 0, GOLD,
						sep(s.rb) .. " R$  ·  " .. sep(s.by) .. " achat" .. (s.by == 1 and "" or "s"))
				end
			end
			if shown == 0 then statusNote(c2, 1, "Aucun achat sur cette période", C.TEXT_DIM) end
			-- le détail par objet, seulement si on le demande
			if shown > 0 then
				local open = ST.help.items == true
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26)
				b.BackgroundColor3 = C.BG_ITEM ; b.BorderSizePixel = 0 ; b.AutoButtonColor = false
				b.Font = FONT ; b.TextSize = SM ; b.TextColor3 = C.TEXT_GREY
				b.Text = open and "▲ Cacher le détail par objet" or "▼ Détail par objet"
				b.LayoutOrder = 50 ; b.ZIndex = 13 ; b.Parent = c2
				corner(b, 8)
				b.MouseButton1Click:Connect(function() ST.help.items = not open ; ST.redraw() end)
				if open then
					local r = 50
					for _, s in ipairs(list) do
						local items = {}
						for key, it in pairs(s.items) do if it.by > 0 then table.insert(items, { key = key, by = it.by, pr = it.pr }) end end
						table.sort(items, function(a, b2) return a.by > b2.by end)
						for i = 1, math.min(#items, 4) do
							r += 1
							local it = items[i]
							hbar(c2, r, "↳ " .. itemName(it.key), it.by / math.max(1, it.pr), C.TEXT_GREY,
								sep(it.by) .. "/" .. sep(it.pr) .. " fen.")
						end
					end
				end
			end
			help(c2, 99, "src", "Barre = Robux venus de cet endroit (prix affiché, Roblox en garde environ 30 %). "
				.. "Une « fenêtre » = la fenêtre d'achat Roblox affichée (achetée ou annulée).")

			-- 🔔 POPUPS — une fiche lisible par popup (v2)
			--   Avant : 3 popups seulement, une barre « achats ÷ affichages » même pour la pub
			--   et le popup de départ (qui ne vendent rien → toujours 0), et des titres
			--   avec des fréquences écrites en dur.
			local c3 = card(body, nextO(), "🔔 Popups : vus combien de fois, et ce qu'ils rapportent", PINK)
			local popIds = {}
			for id in pairs(res.popups or {}) do table.insert(popIds, id) end
			table.sort(popIds, function(a, b2)
				return (res.popups[a].order or 99) < (res.popups[b2].order or 99)
			end)
			local G_ = function(n) return '<font color="#7CF2A0">' .. n .. '</font>' end
			for i, id in ipairs(popIds) do
				local p = res.popups[id]
				local shows = T["pop|" .. id] or 0
				local viewers = T["popu|" .. id] or 0
				local parts = { "👁️ " .. sep(shows) .. " affichage" .. (shows == 1 and "" or "s")
					.. " · " .. sep(viewers) .. " joueur" .. (viewers == 1 and "" or "s") }
				if p.kind == "buy" then
					local s
					for _, x in ipairs(list) do if x.src == p.src then s = x end end
					local pr, by, rb = s and s.pr or 0, s and s.by or 0, s and s.rb or 0
					table.insert(parts, "🪟 " .. sep(pr) .. " fenêtre" .. (pr == 1 and "" or "s") .. " d'achat")
					table.insert(parts, G_("🛒 " .. sep(by) .. " achat" .. (by == 1 and "" or "s")
						.. " (" .. pct(by, shows) .. " des affichages)"))
					table.insert(parts, G_("💰 " .. sep(rb) .. " R$"))
				elseif p.kind == "ad" then
					table.insert(parts, G_("📺 " .. sep(T.ad_done or 0) .. " pubs regardées en entier"))
				elseif p.reward then
					local n = T[p.reward] or 0
					table.insert(parts, G_((p.kind == "reward" and "🎁 " or "✅ ") .. sep(n)
						.. (p.kind == "reward" and " récompenses prises" or " acceptés")
						.. " (" .. pct(n, shows) .. ")"))
				end
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 0)
				f.AutomaticSize = Enum.AutomaticSize.Y
				f.BackgroundColor3 = C.BG_ITEM
				f.BorderSizePixel = 0
				f.LayoutOrder = i
				f.ZIndex = 12
				f.Parent = c3
				corner(f, 8)
				local pad = Instance.new("UIPadding")
				pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 5), UDim.new(0, 6)
				pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
				pad.Parent = f
				local ll = Instance.new("UIListLayout")
				ll.SortOrder = Enum.SortOrder.LayoutOrder
				ll.Padding = UDim.new(0, 2)
				ll.Parent = f
				local t1 = label(f, { text = p.label, size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 17),
					xAlign = Enum.TextXAlignment.Left, color = shows > 0 and C.TEXT_WHITE or C.TEXT_DIM,
					textSize = IS_MOBILE and 11 or 13, truncate = true, zIndex = 13 })
				t1.LayoutOrder = 1
				local t2 = label(f, { text = shows > 0 and table.concat(parts, "   ") or "Pas affiché sur cette période",
					size = UDim2.new(1, 0, 0, 0), richText = true, xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_GREY, textSize = SM, wrapped = true, zIndex = 13 })
				t2.AutomaticSize = Enum.AutomaticSize.Y
				t2.LayoutOrder = 2
				if p.desc then   -- à quoi sert ce popup (toujours visible : plus de titres incompréhensibles)
					local t3 = label(f, { text = p.desc, size = UDim2.new(1, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
						color = C.TEXT_DIM, textSize = SM, wrapped = true, zIndex = 13 })
					t3.AutomaticSize = Enum.AutomaticSize.Y
					t3.LayoutOrder = 3
				end
			end
			help(c3, 99, "pop", "👁️ affichages = combien de fois le popup est apparu (le carrousel : 1 fois max par 20 s "
				.. "et par joueur) · joueurs = joueurs différents qui l'ont vu (comptés une fois par jour). "
				.. "🪟 fenêtre d'achat = la fenêtre Roblox s'est ouverte (achetée OU annulée). 🛒 achats = vraiment payés. "
				.. "💰 = prix affiché (Roblox en garde environ 30 %). "
				.. "Les réglages (activer, fréquence…) sont dans 🔔 POPUPS.")

			-- 🎽 1re UGC GRATUITE
			local c4 = card(body, nextO(), "🎽 1re UGC gratuite (joueurs qui n'ont rien payé)", GOLD)
			if #samples == 0 then
				statusNote(c4, 1, "Pas encore de joueur mesuré sur cette période", C.TEXT_DIM)
			else
				local pts, dcs = {}, {}
				for _, s in ipairs(samples) do
					table.insert(pts, tonumber(s.pt) or 0) ; table.insert(dcs, tonumber(s.dc) or 1)
				end
				table.sort(pts) ; table.sort(dcs)
				tiles(c4, 1, {
					{ value = dur(quant(pts, 0.5)), label = "de jeu (joueur typique)", color = GOLD },
					{ value = sep(quant(dcs, 0.5)) .. " j", label = "jours de connexion", color = GOLD },
					{ value = sep(#samples), label = "joueurs mesurés", color = C.TEXT_WHITE },
				})
				help(c4, 99, "free", "« Joueur typique » = la médiane : la moitié des joueurs l'ont eue plus vite, "
					.. "l'autre moitié plus lentement. 25 % / 75 % : " .. dur(quant(pts, 0.25)) .. " → " .. dur(quant(pts, 0.75)) .. ".")
			end

			-- 📨 INVITES + 📺 PUBS
			local c5 = card(body, nextO(), "📨 Invites", BLUE)
			tiles(c5, 1, {
				{ value = pct(T.inv_open_u, players), label = "des joueurs invitent", color = BLUE },
				{ value = sep(T.inv_join), label = "amis arrivés par invitation", color = GREEN },
				{ value = sep(T.ref_pts), label = "points de parrainage donnés", color = ORANGE },
			})
			local c6 = card(body, nextO(), "📺 Pubs", ORANGE)
			tiles(c6, 1, {
				{ value = pct(T.ad_done_u, players), label = "des joueurs regardent", color = ORANGE },
				{ value = sep(T.ad_done), label = "pubs vues en entier", color = GREEN },
				{ value = pct(T.ad_done, T.ad_show), label = "vont jusqu'au bout", color = C.TEXT_WHITE },
			})
			bars(body, nextO(), res.days, "ad_done", "📺 Pubs regardées par jour", ORANGE)
			if res.studio then statusNote(body, nextO(), "🧪 Studio : lecture seule, rien n'est compté ici.", C.TEXT_DIM) end
		end)
	end

	--════════════════════════════════════════════════════════
	-- 🖥️ L'ÉCRAN
	--════════════════════════════════════════════════════════
	local screenStats
	screenStats = function(fresh)
		currentScreen = "engage"
		ST.token += 1
		local tok = ST.token
		if fresh then ST.cache = {} end
		local body = buildScreen("📊 STATS", true, BLUE, nil, function() ST.cache = {} ; screenStats(false) end)
		ST.redraw = function() if ST.token == tok and currentScreen == "engage" then screenStats(false) end end
		acTabBar(body, 1, {
			{ id = "ugc", label = "🎽 Joueurs & UGC" }, { id = "buy", label = "💸 Achats & pubs" },
		}, ST.tab, BLUE, function(id) ST.tab = id ; screenStats(false) end)
		if ST.tab == "ugc" then renderUGC(body, 10) else renderBuy(body, 10) end
	end

	table.insert(ACTIONS, { id = "engage", name = "📊 STATS", color = BLUE })
	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "engage" then screenStats(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end

	print("✅ Bloc 15 chargé — 📊 STATS (v3 : 🎽 Joueurs & UGC + 💸 Achats & pubs)")
end)()



--════════════════════════════════════════════════════════════════════════════
-- 🔔 BLOC 18 — POPUPS : activer / régler les popups automatiques   (NOUVEAU)
--
--  Lit et modifie les réglages de PopupControl_Server (ServerScriptService).
--  Chaque changement est vérifié par le serveur, sauvegardé, et appliqué à
--  TOUS les serveurs en quelques secondes. Rien n'est stocké côté client.
--  ⚠️ Placé AVANT le bloc 11 (qui doit rester le dernier).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local PINK = Color3.fromRGB(255, 120, 190)
	local ON_COL = Color3.fromRGB(70, 205, 110)
	local SM = IS_MOBILE and 10 or 12
	local CFG
	pcall(function() CFG = require(ReplicatedStorage:WaitForChild("PopupControlConfig", 15)) end)

	local S = { values = nil, token = 0, err = nil }
	local screen

	local function call(action, id, key, value)
		local fn = ReplicatedStorage:FindFirstChild("PopupControl_Admin")
		if not fn then return nil, "Le script serveur PopupControl_Server n'est pas installé." end
		for attempt = 1, 3 do
			local ok, res = pcall(function() return fn:InvokeServer(action, id, key, value) end)
			if ok and type(res) == "table" then
				if res.ok then return res end
				if res.err ~= "trop rapide" then return nil, tostring(res.err) end
			end
			task.wait(0.3 * attempt)
		end
		return nil, "Serveur occupé, réessaie."
	end

	local function box(parent, order, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 12) ; stroke(f, color or C.BORDER_SUBTLE, 1)
		local pad = Instance.new("UIPadding")
		pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 10)
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
		pad.Parent = f
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, IS_MOBILE and 5 or 7)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = f
		return f
	end
	local function text(parent, order, t, color, size, wrapped)
		local l = label(parent, { text = t, size = UDim2.new(1, 0, 0, wrapped and 0 or (size + 6)),
			xAlign = Enum.TextXAlignment.Left, color = color, textSize = size,
			wrapped = wrapped, truncate = not wrapped, zIndex = 12 })
		if wrapped then l.AutomaticSize = Enum.AutomaticSize.Y end
		l.LayoutOrder = order
		return l
	end

	-- applique tout de suite à l'écran, envoie au serveur, revient en arrière si refusé
	local function setValue(id, key, v)
		local before = S.values[id][key]
		S.values[id][key] = v
		screen()
		task.spawn(function()
			local res, err = call("set", id, key, v)
			if res then
				S.values[id][key] = res.value
			else
				S.values[id][key] = before
				toast("❌ " .. tostring(err), false)
			end
			if currentScreen == "popups" then screen() end
		end)
	end

	local function fieldRow(parent, order, id, f)
		local v = S.values[id] and S.values[id][f.key]
		if v == nil then v = f.default end
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
		row.BackgroundTransparency = 1
		row.LayoutOrder = order
		row.ZIndex = 12
		row.Parent = parent
		local rightW = (f.type == "bool") and (IS_MOBILE and 54 or 64) or (IS_MOBILE and 130 or 156)
		label(row, { text = f.label, size = UDim2.new(1, -rightW - 6, 1, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_WHITE, textSize = IS_MOBILE and 11 or 13, truncate = true, zIndex = 13 })
		if f.type == "bool" then
			local b = Instance.new("TextButton")
			b.AnchorPoint = Vector2.new(1, 0.5)
			b.Position = UDim2.new(1, 0, 0.5, 0)
			b.Size = UDim2.new(0, rightW, 0, IS_MOBILE and 22 or 26)
			b.BackgroundColor3 = v and ON_COL or C.BG_LIGHT
			b.AutoButtonColor = true
			b.BorderSizePixel = 0
			b.Font = FONT
			b.Text = v and "ON" or "OFF"
			b.TextColor3 = v and Color3.new(0, 0, 0) or C.TEXT_DIM
			b.TextSize = IS_MOBILE and 11 or 13
			b.ZIndex = 13
			b.Parent = row
			corner(b, 999)
			b.MouseButton1Click:Connect(function() setValue(id, f.key, not v) end)
		else
			local bw, vw = IS_MOBILE and 30 or 36, IS_MOBILE and 58 or 70
			local function btn(txt, x, delta)
				local b = Instance.new("TextButton")
				b.AnchorPoint = Vector2.new(1, 0.5)
				b.Position = UDim2.new(1, x, 0.5, 0)
				b.Size = UDim2.new(0, bw, 0, IS_MOBILE and 24 or 28)
				b.BackgroundColor3 = delta > 0 and ON_COL or C.BG_LIGHT
				b.BorderSizePixel = 0
				b.Font = FONT
				b.Text = txt
				b.TextColor3 = delta > 0 and Color3.new(0, 0, 0) or C.TEXT_WHITE
				b.TextSize = IS_MOBILE and 14 or 17
				b.ZIndex = 13
				b.Parent = row
				corner(b, 7)
				b.MouseButton1Click:Connect(function()
					local nv = CFG.Sanitize(f, (tonumber(v) or 0) + delta * (f.step or 1))
					if nv ~= nil and nv ~= v then setValue(id, f.key, nv) end
				end)
			end
			btn("+", 0, 1)
			btn("−", -(bw + vw + 8), -1)
			local tb = Instance.new("TextBox")
			tb.AnchorPoint = Vector2.new(1, 0.5)
			tb.Position = UDim2.new(1, -(bw + 4), 0.5, 0)
			tb.Size = UDim2.new(0, vw, 0, IS_MOBILE and 24 or 28)
			tb.BackgroundColor3 = C.BG_ITEM
			tb.BorderSizePixel = 0
			tb.Font = FONT
			tb.Text = tostring(v)
			tb.TextColor3 = PINK
			tb.TextSize = IS_MOBILE and 12 or 15
			tb.ClearTextOnFocus = false
			tb.ZIndex = 13
			tb.Parent = row
			corner(tb, 6) ; stroke(tb, PINK, 1)
			tb.FocusLost:Connect(function()
				local nv = CFG.Sanitize(f, tb.Text)
				if nv == nil then tb.Text = tostring(v) return end
				if nv ~= v then setValue(id, f.key, nv) else tb.Text = tostring(v) end
			end)
		end
		if f.help then text(parent, order + 1, "   " .. f.help, C.TEXT_DIM, SM, true) end
	end

	local KIND_NOTE = {
		timer = "⏱️ Revient tout seul.",
		carousel = "🎠 Défile en continu.",
		deaths = "💀 Après des morts (pas d'offre en mode « seulement si inactif »).",
		action = "👆 Suit une action du joueur : pas concerné par « inactif » ni par la pause mini.",
		favorite = "⭐ Pas concerné par l'interrupteur général (ce n'est pas un achat).",
	}

	screen = function()
		currentScreen = "popups"
		S.token += 1
		local tok = S.token
		local body = buildScreen("🔔 POPUPS", true, PINK, nil, function() S.values = nil ; screen() end)
		if not CFG then
			local b = box(body, 1, C.RED)
			text(b, 1, "⚠️ Le module ReplicatedStorage ▸ PopupControlConfig est introuvable.", C.RED, SM, true)
			return
		end
		if not S.values then
			local b = box(body, 1)
			text(b, 1, S.err and ("⚠️ " .. S.err) or "⏳ Chargement…", S.err and C.RED or C.TEXT_GREY, SM, true)
			if not S.err then
				task.spawn(function()
					local res, err = call("get")
					if S.token ~= tok or currentScreen ~= "popups" then return end
					if res then S.values, S.err = res.values, nil else S.err = err end
					screen()
				end)
			else
				S.err = nil   -- 🔄 relance la lecture
			end
			return
		end

		local intro = box(body, 1, PINK)
		text(intro, 1, "Les popups qui s'ouvrent TOUT SEULS chez les joueurs. Chaque changement est appliqué à tous "
			.. "les serveurs en quelques secondes. Les boutons des shops ne sont jamais touchés. "
			.. "Les chiffres (affichages, achats, Robux) sont dans 📊 STATS ▸ 💸 Achats & pubs.", C.TEXT_GREY, SM, true)

		local g = box(body, 2, PINK)
		text(g, 0, "⚙️ Réglages généraux", PINK, IS_MOBILE and 12 or 15, false)
		for i, f in ipairs(CFG.Global) do fieldRow(g, i * 2, "_G", f) end

		for i, p in ipairs(CFG.Popups) do
			local on = S.values[p.id] and S.values[p.id].Enabled == true
			local c = box(body, 10 + i, on and ON_COL or C.BORDER_SUBTLE)
			text(c, 0, p.label, on and C.TEXT_WHITE or C.TEXT_DIM, IS_MOBILE and 12 or 15, false)
			text(c, 1, p.desc .. "  " .. (KIND_NOTE[p.kind] or ""), C.TEXT_DIM, SM, true)
			for j, f in ipairs(p.fields) do fieldRow(c, j * 2 + 2, p.id, f) end
		end

		local r = box(body, 100, C.BORDER_SUBTLE)
		local armed = false
		local rb, rl = actionButton(r, { color = C.BG_LIGHT, text = "↩️ Remettre les réglages d'origine",
			size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38), position = UDim2.new(0, 0, 0, 0),
			anchor = Vector2.new(0, 0), textSize = IS_MOBILE and 12 or 14, zIndex = 12 })
		rb.LayoutOrder = 1
		rb.MouseButton1Click:Connect(function()
			if not armed then
				armed = true
				rl.Text = "⚠️ Appuie encore pour confirmer"
				task.delay(3, function() if rl.Parent then armed = false ; rl.Text = "↩️ Remettre les réglages d'origine" end end)
				return
			end
			task.spawn(function()
				local res, err = call("reset")
				if res then S.values = res.values ; toast("✅ Réglages d'origine remis", true)
				else toast("❌ " .. tostring(err), false) end
				if currentScreen == "popups" then screen() end
			end)
		end)
	end

	table.insert(ACTIONS, { id = "popups", name = "🔔 POPUPS", color = PINK })
	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "popups" then S.values = nil ; screen() return end
		if previousOpenAction then return previousOpenAction(a) end
	end

	print("✅ Bloc 18 chargé — 🔔 POPUPS")
end)()


--════════════════════════════════════════════════════════════════════════════
-- 📜 BLOC 11 — CONSERVER LA POSITION DE DÉFILEMENT
--
--  Le problème : chaque réglage appelle screen(false) → buildScreen →
--  clearWindow(), qui DÉTRUIT la ScrollingFrame. La nouvelle naît à
--  CanvasPosition = 0, donc tu remontes en haut. Et le bouton
--  « appuie encore pour confirmer » repart hors écran, d'où le
--  double appui à deux endroits différents.
--
--  Ici on mémorise la position AVANT la destruction, et on la restaure
--  sur la nouvelle frame — uniquement si c'est le MÊME écran (même titre),
--  pour qu'une vraie navigation reparte bien du haut.
--
--  ⚠️ Doit être le DERNIER bloc : il enveloppe la version de buildScreen
--     déjà enveloppée par le bloc 2-bis (bandeau du gift log).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local previousBuildScreen = buildScreen
	local lastTitle, lastY = nil, 0

	buildScreen = function(titleText, ...)
		-- 1. On lit la position AVANT que clearWindow ne détruise la frame.
		local old = window:FindFirstChildOfClass("ScrollingFrame")
		if old then lastY = old.CanvasPosition.Y end

		local sameScreen = (titleText == lastTitle)
		local target     = lastY

		-- table.pack : buildScreen peut renvoyer plusieurs valeurs selon les
		-- enveloppes déjà posées. On ne doit rien perdre au passage.
		local r = table.pack(previousBuildScreen(titleText, ...))
		lastTitle = titleText

		local body = r[1]
		if sameScreen and target > 1 and typeof(body) == "Instance"
			and body:IsA("ScrollingFrame") then
			-- 2. Le contenu est ajouté APRÈS ce retour, et AutomaticCanvasSize
			--    ne connaît la hauteur qu'une fois les enfants posés. On
			--    réapplique donc pendant quelques frames, en s'arrêtant dès
			--    que le joueur touche lui-même au défilement.
			task.spawn(function()
				local applied = -1
				local t = 0
				while t < 0.5 do
					if not body.Parent then return end
					-- Le joueur a fait défiler : on lâche immédiatement.
					if applied >= 0 and math.abs(body.CanvasPosition.Y - applied) > 2 then
						return
					end
					local maxY = math.max(0,
						body.AbsoluteCanvasSize.Y - body.AbsoluteWindowSize.Y)
					if maxY > 0 then
						local y = math.min(target, maxY)
						body.CanvasPosition = Vector2.new(0, y)
						applied = y
					end
					t = t + task.wait()
				end
			end)
		end

		return table.unpack(r, 1, r.n)
	end
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🛡️ BLOC 16 — ÉCRAN ANTI-CHEAT UNIQUE (remplace « 🚫 UGC BAN », « 🚨 A-CHEAT »
--    et « ⚙️ MODES & MSG »)
--
--    🏠 Accueil · 📡 Fil récent · 👥 Joueurs · 🚫 Restreints · 🔍 Fiche · ⚙️ Réglages
--
--    Toute action importante passe par une PAGE DE CONFIRMATION qui dit
--    exactement ce qui va se passer. Les anciens écrans restent dans le
--    code mais ne sont plus accessibles depuis l'accueil.
--════════════════════════════════════════════════════════════════════════════
;(function()
	local RED    = Color3.fromRGB(235, 60, 65)
	local RED_D  = Color3.fromRGB(140, 25, 30)
	local ORANGE = Color3.fromRGB(255, 170, 60)
	local GREEN  = Color3.fromRGB(55, 195, 100)
	local GREEN_D = Color3.fromRGB(28, 122, 62)
	local CYAN   = Color3.fromRGB(110, 200, 255)
	local GOLD   = Color3.fromRGB(255, 205, 60)
	local PURPLE = Color3.fromRGB(190, 130, 255)
	local BLACK  = Color3.new(0, 0, 0)
	local TS     = IS_MOBILE and 10 or 12      -- petit texte
	local TM     = IS_MOBILE and 11 or 14      -- texte normal
	local TL     = IS_MOBILE and 13 or 16      -- titres

	--  Prix de l'UGC la moins chère du shop (sert au « pouvoir d'achat »)
	local UGC_PRICE = 2000000
	pcall(function()
		local m = ReplicatedStorage:FindFirstChild("UGC_CONFIG")
		local cfgU = m and require(m)
		local best
		for _, it in ipairs((cfgU and cfgU.Items) or {}) do
			local p = tonumber(it.Price)
			if p and p > 0 and (not best or p < best) then best = p end
		end
		if best then UGC_PRICE = best end
	end)

	local TYPE_LABEL = {
		FLY_STATE = "🕊️ Vol (état Flying)", FLY_HOVER = "🕊️ Vol stationnaire",
		FLY_ASCENT = "🕊️ Montée sans appui", FLY_UPSPEED = "🕊️ Montée trop rapide",
		TELEPORT = "🌀 Téléportation", SPEED = "💨 Vitesse anormale",
	}
	local function typeFamily(t)
		t = tostring(t or "")
		if t:sub(1, 3) == "FLY" then return "fly" end
		if t == "TELEPORT" then return "tp" end
		if t == "SPEED" then return "speed" end
		return "other"
	end
	local KIND = {
		detection = { "DÉTECTION", ORANGE }, warning = { "WARNING", RED },
		sanction = { "SANCTION", PURPLE }, manual = { "RESTREINT À LA MAIN", PURPLE },
		lift = { "SANCTION LEVÉE", GREEN },
	}

	--════════════════════════════════════════════════════════════════
	-- 🗄️ ÉTAT
	--════════════════════════════════════════════════════════════════
	local ST = {
		tab = "home",
		feed = { kind = "all", fam = "all", online = false, hideR = false, minConf = 0, search = "", show = 30, open = {}, detail = {} },
		pl = { sort = "last", desc = true, fam = "all", status = "all", online = false, search = "", show = 30 },
		rs = { sort = "recent", search = "" },
		card = nil, cardData = nil, cardLoading = false, cardSearch = "",
		set = { open = { essentiel = true }, search = "", draft = {}, resets = {} },
	}
	local DATA = { home = nil, feed = nil, cand = nil, files = {}, schema = nil, restricted = nil }
	local screenAC   -- forward

	--════════════════════════════════════════════════════════════════
	-- 📞 SERVEUR
	--════════════════════════════════════════════════════════════════
	local function call(action, payload, cb, attempt)
		local fn = ReplicatedStorage:FindFirstChild("AdminUGCRestrictAction")
		if not fn then if cb then cb(nil) end return end
		attempt = attempt or 1
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" and res.throttled and attempt < 4 then
				task.wait(0.4 * attempt)
				call(action, payload, cb, attempt + 1)
				return
			end
			if cb then cb((ok and type(res) == "table") and res or nil) end
		end)
	end
	local function alive() return currentScreen == "anticheat" and window.Visible end
	local function rerender() if alive() then screenAC() end end

	--  Détails de plusieurs joueurs, par paquets de 12, mis en cache 60 s.
	local function loadFiles(ids, onBatch, onDone)
		local need = {}
		for _, id in ipairs(ids) do
			local f = DATA.files[id]
			if not f or os.clock() - f._at > 60 then table.insert(need, id) end
		end
		task.spawn(function()
			local i, waits = 1, 0
			while i <= #need do
				if not alive() then break end   -- panel fermé : on arrête de lire
				local batch = {}
				for _ = 1, 8 do if need[i] then table.insert(batch, need[i]) end ; i = i + 1 end
				local done, res = false, nil
				call("file", { ids = batch }, function(r) res = r ; done = true end)
				local t0 = os.clock()
				while not done and os.clock() - t0 < 15 do task.wait(0.05) end
				if res and res.ok then
					for _, f in ipairs(res.files or {}) do
						f._at = os.clock()
						DATA.files[f.userId] = f
					end
					if onBatch then onBatch(batch) end
					--  le serveur garde des lectures pour le jeu (sauvegardes) :
					--  ce qu'il n'a pas lu est redemandé un peu plus tard
					if type(res.later) == "table" and #res.later > 0 and waits < 20 then
						waits = waits + 1
						for _, id in ipairs(res.later) do table.insert(need, id) end
						task.wait(tonumber(res.wait) or 6)
					end
				end
				task.wait(0.5)
			end
			if onDone then onDone() end
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 🧱 COMPOSANTS
	--════════════════════════════════════════════════════════════════
	local function frame(parent, order, h)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, h or 0)
		if not h then f.AutomaticSize = Enum.AutomaticSize.Y end
		f.BackgroundTransparency = 1
		f.LayoutOrder = order or 0
		f.ZIndex = 11
		f.Parent = parent
		return f
	end
	local function list(parent, pad)
		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, pad or 4)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = parent
		return l
	end
	local function text(parent, order, txt, color, size, bold)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = bold and FONT or Enum.Font.Gotham
		l.Text = txt or ""
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = size or TS
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.LayoutOrder = order or 0
		l.ZIndex = 12
		l.Parent = parent
		return l
	end
	--  Une boîte encadrée avec un titre (et une explication facultative).
	local function box(parent, order, title, color, intro)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order or 0
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 10) ; stroke(f, color or C.BORDER_SUBTLE, 1)
		padding(f, IS_MOBILE and 8 or 10)
		list(f, 5)
		if title then text(f, 0, title, color or C.TEXT_WHITE, TL, true) end
		if intro then text(f, 1, intro, C.TEXT_DIM, TS) end
		return f
	end
	local function note(parent, order, txt, color)
		local b = box(parent, order, nil, color or C.BORDER_SUBTLE)
		b.BackgroundColor3 = C.BG_ITEM
		text(b, 1, txt, color or C.TEXT_GREY, TS)
		return b
	end
	local function button(parent, order, txt, color, fn, h, textColor)
		local c = frame(parent, order, h or (IS_MOBILE and 34 or 40))
		local b, l = actionButton(c, { color = color, strokeColor = color, text = txt,
			textColor = textColor or C.TEXT_WHITE, textSize = IS_MOBILE and 11 or 13, radius = 9, zIndex = 13 })
		b.MouseButton1Click:Connect(fn)
		return b, l
	end
	--  Rangée de boutons côte à côte.
	local function buttonRow(parent, order, items, h)
		local c = frame(parent, order, h or (IS_MOBILE and 32 or 38))
		local g = Instance.new("UIGridLayout")
		local n = math.max(1, #items)
		g.CellSize = UDim2.new(1 / n, -6, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = c
		for i, it in ipairs(items) do
			local w = Instance.new("Frame")
			w.BackgroundTransparency = 1 ; w.LayoutOrder = i ; w.ZIndex = 12 ; w.Parent = c
			local b = actionButton(w, { color = it.color or C.BG_LIGHT, strokeColor = it.color or C.BORDER_BRIGHT,
				text = it.text, textColor = it.textColor or C.TEXT_WHITE,
				textSize = IS_MOBILE and 10 or 12, radius = 8, zIndex = 13 })
			b.MouseButton1Click:Connect(it.fn)
		end
		return c
	end
	--  Puces de choix (plusieurs lignes si besoin). `cols` = puces par ligne.
	local function chips(parent, order, items, selected, color, onPick, cols)
		cols = cols or 3
		local rows = math.ceil(#items / cols)
		local h = IS_MOBILE and 26 or 30
		local c = frame(parent, order, rows * h + (rows - 1) * 4)
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / cols, -4, 0, h)
		g.CellPadding = UDim2.new(0, 4, 0, 4)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = c
		for i, it in ipairs(items) do
			local on = (it.id == selected)
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.BackgroundColor3 = on and color or C.BG_ITEM
			b.AutoButtonColor = false
			b.BorderSizePixel = 0
			b.Font = FONT
			b.Text = it.label
			b.TextColor3 = on and BLACK or C.TEXT_GREY
			b.TextSize = IS_MOBILE and 9 or 11
			b.TextWrapped = true
			b.ZIndex = 12
			b.Parent = c
			corner(b, 7) ; stroke(b, on and color or C.BORDER_SUBTLE, 1)
			b.MouseButton1Click:Connect(function() onPick(it.id) end)
		end
		return c
	end
	local function toggleChip(parent, order, label_, on, color, onPick)
		return chips(parent, order, { { id = true, label = (on and "✅ " or "⬜ ") .. label_ } },
		on and true or false, color, function() onPick(not on) end, 1)
	end
	local function searchBox(parent, order, placeholder, value, onChange, color)
		local c = frame(parent, order, IS_MOBILE and 32 or 38)
		local tb = Instance.new("TextBox")
		tb.Size = UDim2.fromScale(1, 1)
		tb.BackgroundColor3 = C.BG_ITEM
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.PlaceholderText = placeholder
		tb.PlaceholderColor3 = C.TEXT_DIM
		tb.Text = value or ""
		tb.TextColor3 = C.TEXT_WHITE
		tb.TextSize = TM
		tb.TextXAlignment = Enum.TextXAlignment.Left
		tb.ClearTextOnFocus = false
		tb.ZIndex = 12
		tb.Parent = c
		corner(tb, 8) ; stroke(tb, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding") ; p.PaddingLeft = UDim.new(0, 10) ; p.Parent = tb
		tb.FocusLost:Connect(function() onChange(tb.Text) end)
		return tb
	end
	local function status(parent, order, txt)
		return text(parent, order, txt or "⏳ Chargement…", C.TEXT_GREY, TM, true)
	end
	local function confColor(c)
		c = tonumber(c) or 0
		if c >= 85 then return RED elseif c >= 70 then return ORANGE elseif c >= 55 then return GOLD end
		return C.TEXT_GREY
	end
	local function dateOf(t)
		if not t or t <= 0 then return "?" end
		return os.date("!%d/%m %H:%M", t) .. " UTC (" .. fmtAgo(t) .. ")"
	end
	local function ugcPow(p)
		p = tonumber(p)
		if not p then return "?" end
		local x = p / UGC_PRICE
		if x >= 1 then return string.format("%d UGC", math.floor(x)) end
		return string.format("%d %% d'une UGC", math.floor(x * 100))
	end

	--════════════════════════════════════════════════════════════════
	-- ⚠️ PAGE DE CONFIRMATION
	--    opt = { title, color, userId, userName, lines = {…}, confirmText,
	--            input = "placeholder" (facultatif), onConfirm = function(text) }
	--    Le bouton « Confirmer » ne s'active qu'après 2 secondes : impossible
	--    de valider par erreur en double-cliquant.
	--════════════════════════════════════════════════════════════════
	local function confirmPage(opt)
		local back = function() screenAC() end
		local body = buildScreen("⚠️ CONFIRMATION", true, opt.color or ORANGE, back)
		local b = box(body, 1, opt.title, opt.color or ORANGE)
		if opt.userId then
			local h = frame(b, 2, IS_MOBILE and 44 or 54)
			local av = makeAvatar(h, opt.userId, IS_MOBILE and 40 or 50, opt.color)
			av.Position = UDim2.new(0, 0, 0, 2)
			label(h, { text = tostring(opt.userName or opt.userId) .. "  ·  " .. tostring(opt.userId),
				size = UDim2.new(1, -60, 1, 0), position = UDim2.new(0, IS_MOBILE and 48 or 60, 0, 0),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE, textSize = TM, zIndex = 13, truncate = true })
		end
		text(b, 3, "Ce qui va se passer :", C.TEXT_WHITE, TM, true)
		for i, l in ipairs(opt.lines or {}) do text(b, 3 + i, "• " .. l, C.TEXT_GREY, TS) end
		local input
		if opt.input then
			text(b, 50, "Note (facultative, visible dans la fiche) :", C.TEXT_WHITE, TS, true)
			input = searchBox(b, 51, opt.input, "", function() end, opt.color)
		end
		--  ☑️ Case à cocher facultative (ex : ignorer les anciens warnings)
		local checked = opt.checkbox and (opt.checkbox.default == true) or false
		if opt.checkbox then
			local cbH = frame(b, 60, IS_MOBILE and 44 or 50)
			local cb, cbl = actionButton(cbH, { color = C.BG_ITEM, strokeColor = opt.color or ORANGE,
				text = "", textColor = C.TEXT_WHITE, textSize = TS, radius = 8, zIndex = 13 })
			cbl.TextWrapped = true
			local function paint()
				cbl.Text = (checked and "☑️  " or "⬜  ") .. opt.checkbox.label
				cb.BackgroundColor3 = checked and Color3.fromRGB(45, 60, 45) or C.BG_ITEM
			end
			paint()
			cb.MouseButton1Click:Connect(function() checked = not checked ; paint() end)
			if opt.checkbox.desc then text(b, 61, opt.checkbox.desc, C.TEXT_DIM, TS) end
		end
		local okBtn, okLbl = button(body, 3, "⏳ Lis bien… (2)", C.BG_LIGHT, function() end, nil)
		local armed = false
		okBtn.MouseButton1Click:Connect(function()
			if not armed then return end
			armed = false
			okLbl.Text = "⏳ En cours…"
			opt.onConfirm(input and input.Text or nil, checked)
		end)
		task.spawn(function()
			for s = 2, 1, -1 do
				if not okLbl.Parent then return end
				okLbl.Text = "⏳ Lis bien… (" .. s .. ")"
				task.wait(1)
			end
			if okLbl.Parent then
				armed = true
				okBtn.BackgroundColor3 = opt.color or ORANGE
				okLbl.Text = opt.confirmText or "✅ Confirmer"
				okLbl.TextColor3 = BLACK
			end
		end)
		button(body, 4, "↩️ Annuler, ne rien changer", C.BG_LIGHT, back)
	end

	--  Les 3 actions sur un joueur, toujours avec confirmation.
	local function askRestrict(uid, name)
		confirmPage({ title = "🚫 Priver ce joueur d'UGC", color = RED, userId = uid, userName = name,
			confirmText = "🚫 Oui, le priver d'UGC", input = "Pourquoi ? (ex : vu en vidéo en train de voler)",
			lines = {
				"Il ne pourra plus obtenir AUCUNE UGC, sur tous tes serveurs, tout de suite.",
				"Il garde ses points et continue de jouer normalement.",
				"Il verra le message « UGC désactivées » une fois, puis seulement s'il essaie d'acheter.",
				"Tu pourras lever la sanction à tout moment (onglet 🚫 Restreints).",
				"L'action est enregistrée avec ton nom.",
			},
			onConfirm = function(note_)
				call("add", { userId = uid, note = (note_ and note_ ~= "") and note_ or "Privation manuelle depuis le panel" },
				function(res)
					toast(res and res.msg or "Erreur", res and res.ok == true)
					DATA.files[uid] = nil ; DATA.restricted = nil ; DATA.cand = nil ; DATA.feed = nil ; DATA.home = nil
					ST.cardData = nil
					screenAC()
				end)
			end })
	end
	local function askLift(uid, name)
		confirmPage({ title = "✅ Lever la sanction", color = GREEN, userId = uid, userName = name,
			confirmText = "✅ Oui, lui rendre l'accès aux UGC",
			lines = {
				"Il pourra de nouveau obtenir des UGC, tout de suite, sur tous tes serveurs.",
				"⚠️ Ses warnings ne sont PAS effacés : s'il en reçoit encore, il peut être de nouveau sanctionné. Si c'était une erreur, utilise aussi « 🧹 Remettre à zéro ».",
				"L'action est enregistrée avec ton nom.",
			},
			onConfirm = function()
				call("remove", { userId = uid }, function(res)
					toast(res and res.msg or "Erreur", res and res.ok == true)
					DATA.files[uid] = nil ; DATA.restricted = nil ; DATA.cand = nil ; DATA.feed = nil ; DATA.home = nil
					ST.cardData = nil
					screenAC()
				end)
			end })
	end
	local function askReset(uid, name)
		confirmPage({ title = "🧹 Réinitialiser les warnings de ce joueur", color = CYAN, userId = uid, userName = name,
			confirmText = "🧹 Oui, remettre ses warnings à 0",
			lines = {
				"Ses warnings repassent à 0, sur tous tes serveurs.",
				"Ses statistiques de détection (certitude, nombre de détections) sont aussi effacées.",
				"Sa sanction, s'il en a une, n'est PAS levée (utilise « ✅ Lever » pour ça).",
				"À faire quand tu conclus à une erreur de l'anti-cheat.",
			},
			onConfirm = function()
				call("clearstats", { userId = uid }, function(res)
					toast(res and res.msg or "Erreur", res and res.ok == true)
					DATA.files[uid] = nil ; DATA.cand = nil ; ST.cardData = nil
					screenAC()
				end)
			end })
	end
	local function openCard(uid)
		ST.tab = "card" ; ST.card = uid ; ST.cardData = nil ; ST.cardUI = {}
		screenAC()
	end

	--  ⋯ MENU RAPIDE : agir sur un joueur sans ouvrir sa fiche.
	local function playerMenu(uid, name, restricted)
		uid = tonumber(uid)
		if not uid then return end
		local ov = Instance.new("TextButton")
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = BLACK
		ov.BackgroundTransparency = 0.35
		ov.AutoButtonColor = false
		ov.Text = ""
		ov.ZIndex = 60
		ov.Parent = window
		corner(ov, 14)
		ov.MouseButton1Click:Connect(function() ov:Destroy() end)
		local card = Instance.new("Frame")
		card.AnchorPoint = Vector2.new(0.5, 0.5)
		card.Position = UDim2.fromScale(0.5, 0.5)
		card.Size = UDim2.new(0.86, 0, 0, 0)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.BackgroundColor3 = C.BG_DARK
		card.BorderSizePixel = 0
		card.ZIndex = 61
		card.Parent = ov
		corner(card, 12) ; stroke(card, restricted and PURPLE or CYAN, 1.5) ; padding(card, 12)
		list(card, 8)
		local t = text(card, 1, "⋯ " .. tostring(name or ("UserId " .. uid)) .. (restricted and "  ·  🚫 restreint" or ""), C.TEXT_WHITE, TM, true)
		t.ZIndex = 62
		local function item(order, txt, color, fn, textColor)
			local c = Instance.new("Frame")
			c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
			c.BackgroundTransparency = 1 ; c.LayoutOrder = order ; c.ZIndex = 61 ; c.Parent = card
			local b = actionButton(c, { color = color, strokeColor = color, text = txt, textColor = textColor or C.TEXT_WHITE,
				textSize = IS_MOBILE and 11 or 13, radius = 9, zIndex = 62 })
			b.MouseButton1Click:Connect(function() ov:Destroy() ; fn() end)
		end
		item(2, "🔍 Ouvrir sa fiche", CYAN, function() openCard(uid) end, BLACK)
		item(3, "👤 Profil complet (admin)", C.PURPLE, function() openProfileDetail(name, function() screenAC() end) end)
		if restricted then
			item(4, "✅ Lever sa sanction", GREEN, function() askLift(uid, name) end, BLACK)
		else
			item(4, "🚫 Le priver d'UGC", RED, function() askRestrict(uid, name) end)
		end
		item(5, "🧹 Réinitialiser ses warnings", C.BG_LIGHT, function() askReset(uid, name) end)
		item(6, "✖ Fermer", C.BG_ITEM, function() end)
	end

	--════════════════════════════════════════════════════════════════
	-- 🧑 EN-TÊTE JOUEUR (avatar + nom + badges)
	--════════════════════════════════════════════════════════════════
	local function playerHead(parent, order, uid, name, restricted, online, rightText, rightColor, noMenu)
		local h = frame(parent, order, IS_MOBILE and 36 or 44)
		local mw = noMenu and 0 or (IS_MOBILE and 30 or 36)
		if not noMenu then
			local mc = Instance.new("Frame")
			mc.AnchorPoint = Vector2.new(1, 0)
			mc.Position = UDim2.new(1, 0, 0, 0)
			mc.Size = UDim2.new(0, mw - 4, 0, IS_MOBILE and 26 or 30)
			mc.BackgroundTransparency = 1 ; mc.ZIndex = 13 ; mc.Parent = h
			local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = "⋯",
				textSize = IS_MOBILE and 15 or 18, radius = 7, zIndex = 14 })
			mb.MouseButton1Click:Connect(function() playerMenu(uid, name, restricted) end)
		end
		local s = IS_MOBILE and 32 or 40
		uid = tonumber(uid)
		if uid then
			local av = makeAvatar(h, uid, s, restricted and PURPLE or nil)
			av.Position = UDim2.new(0, 0, 0, 2)
		end
		local rw = IS_MOBILE and 80 or 110
		label(h, { text = (restricted and "🚫 " or "") .. tostring(name or ("UserId " .. uid)),
			size = UDim2.new(1, -s - rw - mw - 12, 0, IS_MOBILE and 16 or 20), position = UDim2.new(0, s + 8, 0, 2),
			xAlign = Enum.TextXAlignment.Left, color = restricted and PURPLE or C.TEXT_WHITE,
			textSize = TM, truncate = true, zIndex = 13 })
		label(h, { text = (online and "🟢 en ligne" or "⚪ hors ligne") .. "  ·  " .. tostring(uid)
			.. (restricted and "  ·  🚫 RESTREINT" or ""),
			size = UDim2.new(1, -s - rw - mw - 12, 0, IS_MOBILE and 14 or 16),
			position = UDim2.new(0, s + 8, 0, IS_MOBILE and 18 or 23),
			xAlign = Enum.TextXAlignment.Left, color = restricted and PURPLE or C.TEXT_DIM,
			textSize = TS, truncate = true, zIndex = 13 })
		if rightText then
			label(h, { text = rightText, size = UDim2.new(0, rw, 1, 0), position = UDim2.new(1, -mw, 0, 0),
				anchor = Vector2.new(1, 0), xAlign = Enum.TextXAlignment.Right, color = rightColor or C.TEXT_GREY,
				textSize = TS, zIndex = 13, wrapped = true })
		end
		return h
	end

	--════════════════════════════════════════════════════════════════
	-- 📰 UNE ENTRÉE DU FIL (détaillée)
	--════════════════════════════════════════════════════════════════
	--════════════════════════════════════════════════════════════════
	-- 🔎 DÉTAILS D'UN ÉVÉNEMENT — toujours les MÊMES rubriques, pour une
	--    détection, un warning, une sanction ou une action admin.
	--    S'ouvre PAR-DESSUS le panel : on ne quitte jamais l'écran.
	--════════════════════════════════════════════════════════════════
	local TYPE_EXPLAIN = {
		FLY_STATE   = "Son personnage était en état « vol » (Flying) : impossible sans triche dans ce jeu.",
		FLY_HOVER   = "Il est resté en l'air sans tomber, sans rien sous les pieds.",
		FLY_ASCENT  = "Il est monté sans sauter et sans s'appuyer sur quoi que ce soit.",
		FLY_UPSPEED = "Il est monté plus vite qu'un saut normal (même avec les coils).",
		TELEPORT    = "Il s'est déplacé d'un coup sur une distance impossible à parcourir.",
		SPEED       = "Il s'est déplacé plus vite que ce que sa vitesse de marche permet.",
	}
	local NONE = "— non enregistré pour cet événement"

	--  Liste des « + / − » : nouveau format (fac) ou ancien (why, 5 max)
	local function factorsOf(e)
		local out, old = {}, false
		if type(e.fac) == "table" and #e.fac > 0 then
			for _, f in ipairs(e.fac) do
				table.insert(out, { d = tonumber(f.d) or 0, l = tostring(f.l or "?") })
			end
		elseif type(e.why) == "table" then
			old = true
			for _, w in ipairs(e.why) do
				local sgn, rest = tostring(w):match("^%s*([%+%-]%d+)%s+(.*)$")
				table.insert(out, { d = tonumber(sgn) or 0, l = rest or tostring(w) })
			end
		end
		return out, old
	end

	--  Les rubriques d'un événement : { title, color, rows = { {texte, couleur}, … } }
	local function eventSections(e)
		local S = {}
		local function sec(title, color) local s = { title = title, color = color, rows = {} } table.insert(S, s) return s end
		local function row(s, txt, color) table.insert(s.rows, { tostring(txt), color or C.TEXT_GREY }) end
		local k = KIND[e.kind] or { tostring(e.kind or "?"):upper(), C.TEXT_GREY }
		local admin = (e.kind == "manual" or e.kind == "lift")

		--  1. L'événement
		local s1 = sec("🏷️ " .. k[1], k[2])
		row(s1, "🕒 " .. dateOf(e.t))
		row(s1, "🖥️ Serveur : " .. tostring(e.server or "?"))
		row(s1, e.shadow and "🧪 Mode sans sanction : il n'a pas été puni" or "⚖️ Mode réel", e.shadow and GOLD or C.TEXT_GREY)
		row(s1, "👮 Par : " .. (e.by and tostring(e.by) or (admin and "?" or "l'anti-cheat (automatique)")))

		--  2. Ce qu'il a fait
		local s2 = sec("📝 Ce qu'il a fait", C.TEXT_WHITE)
		if admin then
			row(s2, tostring(e.details or "?"), C.TEXT_WHITE)
		else
			row(s2, TYPE_LABEL[e.type] or tostring(e.type or "?"), C.TEXT_WHITE)
			row(s2, TYPE_EXPLAIN[e.type] or "—")
			row(s2, "📏 Mesure : " .. ((e.details and e.details ~= "") and tostring(e.details) or "—"))
		end

		--  3. Où et avec quoi
		local s3 = sec("📍 Où et avec quoi", CYAN)
		local cx = type(e.ctx) == "table" and e.ctx or nil
		if admin then
			row(s3, "— (action d'un admin)")
		elseif not cx then
			row(s3, NONE, C.TEXT_DIM)
		else
			row(s3, "📍 Position : " .. tostring(cx.pos or "?"))
			row(s3, "🧰 Outil en main : " .. tostring(cx.tool or "aucun"))
			row(s3, cx.speed and string.format("💨 Vitesse : %s studs/s (verticale %s)", tostring(cx.speed), tostring(cx.vy or 0)) or "💨 Vitesse : ?")
			row(s3, "🚶 Vitesse de marche : " .. tostring(cx.walk or "?"))
			row(s3, cx.arena and "🥊 En arène PvP" or "🏃 Hors arène")
			row(s3, "ℹ️ Contexte : " .. tostring(cx.notes or "rien de spécial"), cx.notes and GOLD or C.TEXT_GREY)
		end

		--  4. La certitude, + par +
		local s4 = sec(e.conf and string.format("🎯 Certitude : %d %%", tonumber(e.conf) or 0) or "🎯 Certitude", confColor(e.conf))
		if admin then
			row(s4, "— (pas de calcul : décision d'un admin)")
		else
			row(s4, "🔴 « + » = rend la triche plus probable  ·  🟢 « − » = une explication normale existe", C.TEXT_DIM)
			local fs, old = factorsOf(e)
			if #fs == 0 then row(s4, NONE, C.TEXT_DIM) end
			local sum = 0
			for _, f in ipairs(fs) do
				sum = sum + f.d
				row(s4, string.format("%+4d   %s", f.d, f.l), f.d > 0 and RED or (f.d < 0 and GREEN or C.TEXT_GREY))
			end
			if #fs > 0 and not old then
				local c = tonumber(e.conf)
				if c and c ~= sum then
					row(s4, string.format("= %d, ramené à %d %% (plafond / plancher de la certitude)", sum, c), C.TEXT_WHITE)
				else
					row(s4, string.format("= %d %%", sum), C.TEXT_WHITE)
				end
			elseif old and #fs > 0 then
				row(s4, "(seulement les 5 principaux : événement d'avant la mise à jour)", C.TEXT_DIM)
			end
			if e.kind ~= "detection" and type(e.batch) == "table" and #e.batch > 0 then
				local parts, tot = {}, 0
				for _, v in ipairs(e.batch) do tot = tot + (tonumber(v) or 0) ; table.insert(parts, tostring(v) .. " %") end
				row(s4, string.format("📦 Ce warning vient de %d détection(s) : %s → moyenne %d %%",
					#e.batch, table.concat(parts, ", "), math.floor(tot / #e.batch)), C.TEXT_WHITE)
				row(s4, "   (la liste des + / − ci-dessus est celle de la dernière détection du lot" .. (e.last and (", " .. tostring(e.last) .. " %") or "") .. ")", C.TEXT_DIM)
			elseif e.kind ~= "detection" then
				row(s4, "📦 Lot de détections : " .. NONE, C.TEXT_DIM)
			end
			local n = type(e.need) == "table" and e.need or nil
			row(s4, n and string.format("📐 Seuils : détection retenue dès %s %%  ·  warning si la moyenne du lot ≥ %s %%  ·  %s strike(s) = 1 warning",
				tostring(n.c or "?"), tostring(n.w or "?"), tostring(n.sp or "?")) or ("📐 Seuils : " .. NONE), n and C.TEXT_GREY or C.TEXT_DIM)
		end

		--  5. Son dossier à ce moment-là
		local s5 = sec("🗂️ Son dossier à ce moment-là", ORANGE)
		if e.kind == "warning" or e.kind == "sanction" then
			row(s5, string.format("⚠️ Warnings : %s / %s", tostring(e.warnings or "?"), tostring(e.max or "?")))
		else
			row(s5, "⚠️ Warnings : " .. tostring(e.warnings or (admin and "—" or "?")))
		end
		row(s5, e.strikes and string.format("🎯 Strikes en cours : %s / %s", tostring(e.strikes),
			tostring(type(e.need) == "table" and e.need.sp or "?")) or "🎯 Strikes en cours : —")
		row(s5, e.kind == "sanction" and "🚫 Résultat : PRIVÉ D'UGC" or (e.kind == "warning" and "⚠️ Résultat : warning ajouté"
			or (e.kind == "detection" and "🔎 Résultat : détection retenue (rapproche d'un warning)" or "👮 Résultat : " .. k[1])),
			k[2])
		return S
	end

	--  Version DANS la page (fiche) : les mêmes rubriques, à plat
	local function eventInline(parent, startOrder, e)
		local o = startOrder
		for _, s in ipairs(eventSections(e)) do
			text(parent, o, s.title, s.color, TS, true) ; o = o + 1
			for _, r in ipairs(s.rows) do text(parent, o, "   " .. r[1], r[2], TS) ; o = o + 1 end
		end
		return o
	end

	--════════════════════════════════════════════════════════════════
	-- 👤 UNE ENTRÉE PAR JOUEUR (le fil regroupe tous ses événements)
	--════════════════════════════════════════════════════════════════
	--  events : liste triée du plus récent au plus ancien. Renvoie la liste
	--  des joueurs, triée par leur événement le plus récent.
	local function groupByPlayer(events)
		local map, order = {}, {}
		for _, e in ipairs(events or {}) do
			local uid = tonumber(e.uid)
			if uid then
				local g = map[uid]
				if not g then
					g = { uid = uid, name = e.name, events = {}, restricted = e.restricted, online = e.online,
						det = 0, warn = 0, sanc = 0, admin = 0, fams = {}, confMax = 0 }
					map[uid] = g
					table.insert(order, g)
				end
				g.name = g.name or e.name
				table.insert(g.events, e)
				if e.kind == "detection" then
					g.det = g.det + 1
					local lbl = TYPE_LABEL[e.type] or tostring(e.type)
					g.fams[lbl] = (g.fams[lbl] or 0) + 1
					g.lastDet = g.lastDet or e
				elseif e.kind == "warning" then g.warn = g.warn + 1 ; g.maxWarn = math.max(g.maxWarn or 0, tonumber(e.warnings) or 0)
				elseif e.kind == "sanction" then g.sanc = g.sanc + 1
				else g.admin = g.admin + 1 end
				g.confMax = math.max(g.confMax, tonumber(e.conf) or 0)
			end
		end
		return order
	end

	local function eventLine(e)
		local k = KIND[e.kind] or { tostring(e.kind or "?") }
		local what = (TYPE_LABEL[e.type] or tostring(e.type or ""))
		if e.kind == "warning" then
			what = string.format("⚠️ Warning %s/%s (%s)", tostring(e.warnings or "?"), tostring(e.max or "?"), what)
		elseif e.kind == "sanction" then
			what = "🚫 PRIVÉ D'UGC (" .. what .. ")"
		elseif e.kind == "manual" or e.kind == "lift" then
			what = tostring(e.details or k[1])
		elseif e.details and e.details ~= "" then
			what = what .. " — " .. e.details
		end
		return string.format("• %s · %s%s", fmtAgo(e.t), what, e.conf and (" (" .. tostring(e.conf) .. " %)") or "")
	end

	--  🔎 TOUTES les infos d'un événement (mêmes infos pour chaque détection / warning)
	local function eventDetailText(e)
		local L = {}
		local k = KIND[e.kind] or { tostring(e.kind or "?") }
		table.insert(L, "🏷️ " .. k[1] .. " · " .. dateOf(e.t) .. (e.server and ("  ·  serveur " .. tostring(e.server)) or "")
			.. (e.shadow and "  ·  🧪 mode sans sanction" or ""))
		if e.type then table.insert(L, "📝 Ce qu'il a fait : " .. (TYPE_LABEL[e.type] or tostring(e.type))) end
		if e.details and e.details ~= "" then table.insert(L, "   " .. tostring(e.details)) end
		if e.kind == "warning" or e.kind == "sanction" then
			table.insert(L, string.format("⚠️ Warnings à ce moment : %s / %s", tostring(e.warnings or "?"), tostring(e.max or "?")))
		elseif e.warnings then
			table.insert(L, "⚠️ Warnings à ce moment : " .. tostring(e.warnings))
		end
		local cx = e.ctx
		if type(cx) == "table" then
			table.insert(L, "📍 Position : " .. tostring(cx.pos or "?"))
			table.insert(L, "🧰 Outil en main : " .. tostring(cx.tool or "aucun"))
			if cx.speed then table.insert(L, string.format("💨 Vitesse : %s studs/s (verticale %s)", cx.speed, tostring(cx.vy or 0))) end
			if cx.walk then table.insert(L, "🚶 Vitesse de marche : " .. cx.walk) end
			table.insert(L, cx.arena and "🥊 En arène PvP" or "🏃 Hors arène")
			if cx.notes then table.insert(L, "ℹ️ " .. cx.notes) end
		end
		if e.conf then
			table.insert(L, string.format("🎯 Certitude : %d %%", tonumber(e.conf) or 0))
			for _, w in ipairs(type(e.why) == "table" and e.why or {}) do table.insert(L, "   " .. tostring(w)) end
		end
		if e.by then table.insert(L, "👮 Par : " .. tostring(e.by)) end
		return table.concat(L, "\n")
	end

	--════════════════════════════════════════════════════════════════
	-- 🪟 FENÊTRE PAR-DESSUS LE PANEL (une seule à la fois)
	--    Partout le même principe : l'entrée reste petite (une ligne de
	--    stats + des boutons), « 🔎 Tout voir » ouvre TOUT ici, sans
	--    quitter l'écran du panel.
	--════════════════════════════════════════════════════════════════
	local detailGui
	local function closeDetail()
		if detailGui then detailGui:Destroy() ; detailGui = nil end
	end
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if not window.Visible then closeDetail() end
	end)

	--  build(sc, redraw) remplit la zone qui défile ; foot = boutons du bas
	local function openOverlay(title, color, build, foot)
		closeDetail()
		local g = Instance.new("ScreenGui")
		g.Name = "AC_Detail" ; g.ResetOnSpawn = false ; g.IgnoreGuiInset = true
		g.DisplayOrder = 1500 ; g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		g.Parent = playerGui
		detailGui = g
		local dim = Instance.new("TextButton")
		dim.Size = UDim2.fromScale(1, 1) ; dim.BackgroundColor3 = BLACK ; dim.BackgroundTransparency = 0.4
		dim.Text = "" ; dim.AutoButtonColor = false ; dim.ZIndex = 1 ; dim.Parent = g
		dim.MouseButton1Click:Connect(closeDetail)

		local panel = Instance.new("Frame")
		panel.AnchorPoint = Vector2.new(0.5, 0.5) ; panel.Position = UDim2.fromScale(0.5, 0.5)
		panel.Size = IS_MOBILE and UDim2.fromScale(0.94, 0.9) or UDim2.fromScale(0.62, 0.86)
		panel.BackgroundColor3 = C.BG_ITEM ; panel.BorderSizePixel = 0 ; panel.ZIndex = 5 ; panel.Parent = g
		corner(panel, 14) ; stroke(panel, color, 2)
		local lim = Instance.new("UISizeConstraint") ; lim.MaxSize = Vector2.new(720, 2000) ; lim.Parent = panel
		local HH = IS_MOBILE and 40 or 48
		local FH = IS_MOBILE and 42 or 50

		local head = Instance.new("TextLabel")
		head.Size = UDim2.new(1, -(HH + 20), 0, HH) ; head.Position = UDim2.new(0, 12, 0, 0)
		head.BackgroundTransparency = 1 ; head.Font = FONT ; head.TextSize = TL ; head.TextColor3 = color
		head.TextXAlignment = Enum.TextXAlignment.Left ; head.TextTruncate = Enum.TextTruncate.AtEnd
		head.Text = title ; head.ZIndex = 12 ; head.Parent = panel
		local xw = Instance.new("Frame")
		xw.Size = UDim2.new(0, HH - 8, 0, HH - 8) ; xw.Position = UDim2.new(1, -(HH - 2), 0, 4)
		xw.BackgroundTransparency = 1 ; xw.ZIndex = 12 ; xw.Parent = panel
		local xb = actionButton(xw, { color = RED_D, strokeColor = RED, text = "✕", textColor = C.TEXT_WHITE,
			textSize = TM, radius = 8, zIndex = 13 })
		xb.MouseButton1Click:Connect(closeDetail)

		local sc = Instance.new("ScrollingFrame")
		sc.Position = UDim2.new(0, 8, 0, HH) ; sc.Size = UDim2.new(1, -16, 1, -(HH + FH + 6))
		sc.BackgroundTransparency = 1 ; sc.BorderSizePixel = 0 ; sc.ScrollBarThickness = 6
		sc.CanvasSize = UDim2.new() ; sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
		sc.ScrollingDirection = Enum.ScrollingDirection.Y ; sc.ZIndex = 10 ; sc.Parent = panel
		local pad = Instance.new("UIPadding") ; pad.PaddingRight = UDim.new(0, 10) ; pad.Parent = sc
		list(sc, 6)
		local redraw
		redraw = function()
			if not sc.Parent then return end
			local y = sc.CanvasPosition.Y
			for _, c in ipairs(sc:GetChildren()) do
				if not (c:IsA("UIListLayout") or c:IsA("UIPadding")) then c:Destroy() end
			end
			build(sc, redraw)
			--  on reste au même endroit après un ▼ / ▲
			task.delay(0.05, function() if sc.Parent then sc.CanvasPosition = Vector2.new(0, y) end end)
		end
		redraw()

		local ff = Instance.new("Frame")
		ff.AnchorPoint = Vector2.new(0, 1) ; ff.Position = UDim2.new(0, 8, 1, -6)
		ff.Size = UDim2.new(1, -16, 0, FH - 6) ; ff.BackgroundTransparency = 1 ; ff.ZIndex = 11 ; ff.Parent = panel
		local items = {}
		for _, it in ipairs(foot or {}) do table.insert(items, it) end
		table.insert(items, { text = "✕ Fermer", color = C.BG_LIGHT, fn = closeDetail })
		buttonRow(ff, 1, items, FH - 6)
		return g, redraw
	end

	--  bouton « sa fiche » (pas si on est déjà sur sa fiche)
	local function ficheItem(uid)
		if uid and not (currentScreen == "anticheat" and ST.tab == "card" and ST.card == uid) then
			return { text = "🔍 Sa fiche", color = CYAN, textColor = BLACK, fn = function() closeDetail() ; openCard(uid) end }
		end
	end
	local function sectionsInto(parent, startOrder, e)
		for i, s in ipairs(eventSections(e)) do
			local b = box(parent, startOrder + i, s.title, s.color)
			for j, r in ipairs(s.rows) do text(b, j + 1, r[1], r[2], TS) end
		end
	end

	--  🔎 UN événement, en entier
	local function openEventDetail(e)
		local k = KIND[e.kind] or { tostring(e.kind or "?"):upper(), C.TEXT_GREY }
		openOverlay("🔎 " .. tostring(e.name or e.uid or "?") .. "  ·  " .. k[1], k[2],
			function(sc) sectionsInto(sc, 0, e) end, { ficheItem(tonumber(e.uid)) })
	end

	--  « Ce que la machine a vu » (ce serveur) → même format qu'un événement du journal
	local function liveToEvent(x, uid, name)
		local fac = {}
		for _, f in ipairs(x.factors or {}) do table.insert(fac, { d = tonumber(f.delta) or 0, l = tostring(f.label) }) end
		return { kind = "detection", uid = uid, name = name, type = x.vType or x.kind, details = x.details,
			conf = x.conf, t = x.t, fac = fac, ctx = x.ctx,
			server = x.counted and "ce serveur" or "ce serveur · ⚪ signal écarté (n'a rien coûté au joueur)" }
	end

	--  Une ligne d'événement + son bouton « 🔎 Détails »
	local function eventRow(parent, order, e, label_)
		local DW = IS_MOBILE and 72 or 92
		local row = frame(parent, order, IS_MOBILE and 24 or 26)
		local lb = Instance.new("TextLabel")
		lb.Size = UDim2.new(1, -(DW + 6), 1, 0)
		lb.BackgroundTransparency = 1 ; lb.Font = Enum.Font.Gotham
		lb.Text = label_ or eventLine(e) ; lb.TextColor3 = (KIND[e.kind] or { "", C.TEXT_GREY })[2]
		lb.TextSize = TS ; lb.TextXAlignment = Enum.TextXAlignment.Left
		lb.TextTruncate = Enum.TextTruncate.AtEnd ; lb.ZIndex = 12 ; lb.Parent = row
		local dc = Instance.new("Frame")
		dc.AnchorPoint = Vector2.new(1, 0) ; dc.Position = UDim2.new(1, 0, 0, 0)
		dc.Size = UDim2.new(0, DW, 1, 0) ; dc.BackgroundTransparency = 1 ; dc.ZIndex = 12 ; dc.Parent = row
		local db = actionButton(dc, { color = C.BG_LIGHT, strokeColor = CYAN,
			text = "🔎 Détails", textColor = C.TEXT_WHITE, textSize = TS, radius = 6, zIndex = 13 })
		db.MouseButton1Click:Connect(function() openEventDetail(e) end)
		return row
	end

	--════════════════════════════════════════════════════════════════
	-- 🗂️ DOSSIER D'UN JOUEUR — le MÊME dans la 🔍 Fiche et dans « 🔎 Tout voir »
	--    L'essentiel d'abord ; chaque carte s'ouvre avec « ▼ Plus d'infos ».
	--════════════════════════════════════════════════════════════════
	--  Une ligne qui ne passe jamais à la ligne (coupée par « … »)
	local function oneLine(parent, order, txt, color, size, bold)
		local l = text(parent, order, txt, color, size, bold)
		l.AutomaticSize = Enum.AutomaticSize.None
		l.Size = UDim2.new(1, 0, 0, (size or TS) + 6)
		l.TextWrapped = false ; l.TextTruncate = Enum.TextTruncate.AtEnd
		return l
	end
	--  Bouton « ▼ / ▲ » discret, sur toute la largeur
	local function toggleBtn(parent, order, isOpen, closedTxt, openTxt, color, fn)
		local c = frame(parent, order, IS_MOBILE and 24 or 28)
		local b = actionButton(c, { color = isOpen and C.BG_LIGHT or C.BG_DARK, strokeColor = color or C.BORDER_SUBTLE,
			text = isOpen and ("▲ " .. openTxt) or ("▼ " .. closedTxt), textColor = C.TEXT_GREY,
			textSize = TS, radius = 7, zIndex = 13 })
		b.MouseButton1Click:Connect(fn)
		return b
	end
	--  Tuiles de chiffres (3 par ligne)
	local function statTiles(parent, order, items)
		local cols = 3
		local h = IS_MOBILE and 40 or 48
		local rows = math.ceil(#items / cols)
		local c = frame(parent, order, rows * h + (rows - 1) * 6)
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / cols, -6, 0, h) ; g.CellPadding = UDim2.new(0, 6, 0, 6)
		g.SortOrder = Enum.SortOrder.LayoutOrder ; g.Parent = c
		for i, it in ipairs(items) do
			local t = Instance.new("Frame")
			t.BackgroundColor3 = C.BG_ITEM ; t.BorderSizePixel = 0 ; t.LayoutOrder = i ; t.ZIndex = 12 ; t.Parent = c
			corner(t, 8) ; stroke(t, it[3] or C.BORDER_SUBTLE, 1)
			local v = Instance.new("TextLabel")
			v.Size = UDim2.new(1, -8, 0.58, 0) ; v.Position = UDim2.new(0, 4, 0, 2)
			v.BackgroundTransparency = 1 ; v.Font = FONT ; v.TextSize = TM ; v.TextColor3 = it[3] or C.TEXT_WHITE
			v.Text = tostring(it[1]) ; v.TextTruncate = Enum.TextTruncate.AtEnd ; v.ZIndex = 13 ; v.Parent = t
			local l = Instance.new("TextLabel")
			l.Size = UDim2.new(1, -8, 0.4, 0) ; l.Position = UDim2.new(0, 4, 0.58, -2)
			l.BackgroundTransparency = 1 ; l.Font = Enum.Font.Gotham ; l.TextSize = TS ; l.TextColor3 = C.TEXT_DIM
			l.Text = tostring(it[2]) ; l.TextTruncate = Enum.TextTruncate.AtEnd ; l.ZIndex = 13 ; l.Parent = t
		end
		return c
	end
	--  Les 2 « + / − » qui pèsent le plus (la base du signal à part)
	local function topFactors(e, n)
		local fs = factorsOf(e)
		local base, rest = nil, {}
		for i, f in ipairs(fs) do
			if i == 1 and tostring(f.l):find("Signal", 1, true) then base = f.d else table.insert(rest, f) end
		end
		table.sort(rest, function(a, b) return math.abs(a.d) > math.abs(b.d) end)
		local out = {}
		if base then table.insert(out, "base " .. base) end
		for i = 1, math.min(n, #rest) do table.insert(out, string.format("%+d %s", rest[i].d, rest[i].l)) end
		return out
	end

	--  🃏 CARTE D'ÉVÉNEMENT : 2-3 lignes, « ▼ Plus d'infos » pour le reste
	local function eventCard(parent, order, e, isOpen, onToggle)
		local k = KIND[e.kind] or { tostring(e.kind or "?"):upper(), C.TEXT_GREY }
		local admin = (e.kind == "manual" or e.kind == "lift")
		local c = box(parent, order, nil, k[2])
		c.BackgroundColor3 = C.BG_ITEM
		local tl = TYPE_LABEL[e.type] or tostring(e.type or "?")
		local what
		if admin then what = (e.kind == "lift") and "✅ SANCTION LEVÉE" or "👮 RESTREINT À LA MAIN"
		elseif e.kind == "warning" then what = string.format("⚠️ WARNING %s/%s · %s", tostring(e.warnings or "?"), tostring(e.max or "?"), tl)
		elseif e.kind == "sanction" then what = "🚫 SANCTION · " .. tl
		else what = "🔎 " .. tl end
		oneLine(c, 1, what .. (e.conf and ("  ·  🎯 " .. tostring(e.conf) .. " %") or "") .. "  ·  " .. fmtAgo(e.t), k[2], TS, true)
		if admin then
			oneLine(c, 2, "👮 " .. tostring(e.by or "?") .. "  ·  " .. tostring(e.details or ""), C.TEXT_GREY, TS)
		else
			local p = {}
			local cx = type(e.ctx) == "table" and e.ctx or nil
			if cx then
				if cx.pos then table.insert(p, "📍 " .. cx.pos) end
				table.insert(p, "🧰 " .. tostring(cx.tool or "aucun"))
				if cx.speed then table.insert(p, "💨 " .. tostring(cx.speed) .. " studs/s") end
				if cx.arena then table.insert(p, "🥊 arène") end
			elseif e.details and e.details ~= "" then
				table.insert(p, "📏 " .. tostring(e.details))
			end
			if e.kind ~= "detection" and type(e.batch) == "table" and #e.batch > 0 then table.insert(p, "📦 lot de " .. #e.batch) end
			if e.shadow then table.insert(p, "🧪 sans sanction") end
			oneLine(c, 2, (#p > 0) and table.concat(p, "  ·  ") or "—", C.TEXT_GREY, TS)
			local tf = topFactors(e, 2)
			if #tf > 0 then oneLine(c, 3, "🎯 " .. table.concat(tf, "  ·  "), C.TEXT_DIM, TS) end
		end
		toggleBtn(c, 4, isOpen, admin and "Plus d'infos" or "Plus d'infos (tous les + / −, seuils, dossier…)", "Moins d'infos", k[2], onToggle)
		if isOpen then eventInline(c, 5, e) end
		return c
	end

	--  d = { uid, name, file, stats, record, events, live, threshold, points }
	--  S = état des ▼ / ▲ ; redraw = redessiner
	local function renderDossier(parent, order, d, S, redraw)
		S.open = S.open or {}
		S.show = S.show or 10
		local fl = type(d.file) == "table" and d.file or {}
		local st = type(d.stats) == "table" and d.stats or (type(fl.stats) == "table" and fl.stats) or {}
		local th = d.threshold or "?"
		local evs = d.events or {}
		local rec = d.record
		local avg = ((st.confCount or 0) > 0) and math.floor(st.confSum / st.confCount) or nil
		local w = tonumber(fl.warnings) or 0
		local wn = tonumber(th)

		--  1. 📊 En bref : 6 tuiles + 2 lignes
		local s = box(parent, order, "📊 En bref", CYAN)
		statTiles(s, 2, {
			{ w .. " / " .. tostring(th), "warnings actifs", (wn and w >= wn) and RED or (w > 0 and ORANGE or GREEN) },
			{ tostring(st.total or "?"), "détections retenues", ORANGE },
			{ tostring(st.detIgnored or "?"), "écartées (doute)", C.TEXT_GREY },
			{ avg and (avg .. " %") or "?", "certitude moyenne", confColor(avg) },
			{ st.confMax and (st.confMax .. " %") or "?", "certitude max", confColor(st.confMax) },
			{ d.points and ugcPow(d.points) or "?", "finançable", GOLD },
		})
		local bt = {}
		for t, c in pairs(st.detByType or {}) do table.insert(bt, (TYPE_LABEL[t] or t) .. " ×" .. c) end
		table.sort(bt)
		oneLine(s, 3, "Par type : " .. ((#bt > 0) and table.concat(bt, "  ·  ") or "—"), C.TEXT_GREY, TS)
		oneLine(s, 4, "🕒 1re détection : " .. (st.firstSeen and fmtAgo(st.firstSeen) or "—") .. "  ·  dernière : "
			.. ((st.lastAt or st.lastSeen) and fmtAgo(st.lastAt or st.lastSeen) or "—"), C.TEXT_DIM, TS)
		oneLine(s, 5, rec and "🚫 PRIVÉ D'UGC (voir ci-dessous)" or "✅ Pas de sanction : il peut acheter des UGC", rec and PURPLE or GREEN, TS, true)

		--  2. 🚫 La sanction (seulement s'il en a une)
		if rec then
			local r = box(parent, order + 1, nil, PURPLE)
			r.BackgroundColor3 = Color3.fromRGB(40, 24, 56)
			oneLine(r, 1, "🚫 PRIVÉ D'UGC  ·  " .. fmtAgo(rec.at) .. "  ·  " .. (rec.auto and "🤖 anti-cheat" or ("👮 " .. tostring(rec.by or "?"))), PURPLE, TS, true)
			local why = tostring(rec.reasonText or rec.details or rec.reason or "?")
			oneLine(r, 2, "📝 " .. (why:match("^[^\n]*") or why), C.TEXT_WHITE, TS)
			oneLine(r, 3, string.format("🎯 %s  ·  🔁 %d achat(s) bloqué(s)  ·  %s", rec.confidence and (rec.confidence .. " %") or "—",
				rec.attempts or 0, rec.noticeShown and "👁️ message vu" or "👁️ message pas encore vu"), C.TEXT_GREY, TS)
			if (rec.leaks or 0) > 0 then oneLine(r, 4, "🚨 " .. rec.leaks .. " UGC reçue(s) malgré la sanction", RED, TS, true) end
			toggleBtn(r, 5, S.reason, "Raison complète", "Masquer la raison", PURPLE, function() S.reason = not S.reason ; redraw() end)
			if S.reason then text(r, 6, why, C.TEXT_GREY, TS) end
		end

		--  3. ⚠️ Warnings actifs (3 visibles)
		local hist = fl.warnHistory or {}
		local wb = box(parent, order + 2, "⚠️ Warnings actifs (" .. #hist .. ")", ORANGE)
		if #hist == 0 then oneLine(wb, 2, "✅ Aucun warning actif.", GREEN, TS) end
		local shown = 0
		for i = #hist, 1, -1 do
			if not S.warnAll and shown >= 3 then break end
			shown = shown + 1
			local h = hist[i]
			oneLine(wb, 1 + shown, string.format("• %s  ·  %s  %s", fmtAgo(h.t), TYPE_LABEL[h.type] or tostring(h.type),
				tostring(h.details or "")), C.TEXT_GREY, TS)
		end
		if #hist > 3 then
			toggleBtn(wb, 100, S.warnAll, "Voir les " .. #hist .. " warnings", "Réduire", ORANGE, function() S.warnAll = not S.warnAll ; redraw() end)
		end

		--  4. 📰 Historique : une carte par événement
		local eb = box(parent, order + 3, "📰 Historique (" .. #evs .. ", tous serveurs)", CYAN)
		if #evs == 0 then oneLine(eb, 2, "Rien dans le journal récent.", C.TEXT_DIM, TS) end
		for i, e in ipairs(evs) do
			if i > S.show then break end
			local key = "e" .. i .. "|" .. tostring(e.t) .. "|" .. tostring(e.kind)
			eventCard(eb, 1 + i, e, S.open[key] == true, function() S.open[key] = not S.open[key] ; redraw() end)
		end
		if #evs > S.show then
			toggleBtn(eb, 1000, false, "Voir " .. math.min(10, #evs - S.show) .. " de plus (" .. (#evs - S.show) .. " restants)", "", CYAN,
				function() S.show = S.show + 10 ; redraw() end)
		end

		--  5. 🎯 Vu sur CE serveur (fermé par défaut)
		local live = type(d.live) == "table" and d.live or nil
		local lr = (live and type(live.recent) == "table") and live.recent or {}
		if #lr > 0 then
			local lb = box(parent, order + 4, nil, ORANGE)
			oneLine(lb, 1, "🎯 Vu sur ce serveur (" .. #lr .. ", signaux écartés compris)", ORANGE, TS, true)
			toggleBtn(lb, 2, S.live, "Afficher", "Masquer", ORANGE, function() S.live = not S.live ; redraw() end)
			if S.live then
				for i, x in ipairs(lr) do
					if i > 10 then break end
					local e = liveToEvent(x, d.uid, d.name)
					local key = "l" .. i .. "|" .. tostring(x.t)
					eventCard(lb, 2 + i, e, S.open[key] == true, function() S.open[key] = not S.open[key] ; redraw() end)
				end
			end
		end
	end

	--  🔎 TOUT le dossier d'un joueur (même fenêtre depuis le Fil, l'Accueil,
	--     Joueurs, Restreints et la Fiche) — même affichage que la 🔍 Fiche
	local PD = {}   -- [uid] = { at, res } : 30 s de cache
	local function openPlayerDetail(uid, name)
		uid = tonumber(uid)
		if not uid then return end
		local S = {}
		local res = (PD[uid] and os.clock() - PD[uid].at < 30) and PD[uid].res or nil
		local function build(sc, redraw)
			if not res then status(sc, 1, "⏳ Chargement de tout son dossier…") return end
			if not res.ok then note(sc, 1, "❌ " .. tostring(res.msg or "Lecture impossible"), RED) return end
			local f2 = DATA.files[uid]
			renderDossier(sc, 1, { uid = uid, name = res.name or name, file = res.file, record = res.record,
				events = res.events, live = res.live, threshold = res.threshold, points = f2 and f2.points }, S, redraw)
		end
		local foot = {}
		local fi = ficheItem(uid)
		if fi then table.insert(foot, fi) end
		local g, redraw = openOverlay("🔎 " .. tostring(name or uid) .. "  ·  tout son dossier", CYAN, build, foot)
		if not res then
			call("lookup", { target = uid, deep = false }, function(r)
				res = r or { ok = false, msg = "Pas de réponse du serveur" }
				if res.ok then PD[uid] = { at = os.clock(), res = res } end
				if detailGui == g then redraw() end
			end)
		end
	end

	--  Rangée de boutons commune à toutes les entrées
	local function entryButtons(parent, order, uid, name, restricted, full)
		local acts = {
			{ text = "🔎 Tout voir", color = GOLD, textColor = BLACK, fn = function() openPlayerDetail(uid, name) end },
			{ text = "🔍 Fiche", color = CYAN, textColor = BLACK, fn = function() openCard(uid) end },
		}
		if full then
			if restricted then
				table.insert(acts, { text = "✅ Lever", color = GREEN, textColor = BLACK, fn = function() askLift(uid, name) end })
			else
				table.insert(acts, { text = "🚫 Restreindre", color = RED, fn = function() askRestrict(uid, name) end })
			end
			table.insert(acts, { text = "🧹 Warnings à 0", color = C.BG_LIGHT, fn = function() askReset(uid, name) end })
		end
		buttonRow(parent, order, acts)
	end

	--  👤 UNE ENTRÉE PAR JOUEUR : en-tête + UNE ligne de stats + boutons
	local function groupEntry(parent, order, g, compact)
		local col = g.restricted and PURPLE or (g.sanc > 0 and PURPLE or (g.warn > 0 and RED or ORANGE))
		local b = box(parent, order, nil, col)
		if g.restricted then b.BackgroundColor3 = Color3.fromRGB(40, 24, 56) end
		local f = DATA.files[g.uid]
		local last = g.events[1]
		playerHead(b, 1, g.uid, g.name or (f and f.name), g.restricted, g.online,
			string.format("%d événement(s)\n%s", #g.events, fmtAgo(last and last.t)), col)
		local base = {}
		if g.det > 0 then table.insert(base, "🔎 " .. g.det .. " détect.") end
		if g.warn > 0 then table.insert(base, "⚠️ " .. g.warn .. " warn.") end
		if g.sanc > 0 then table.insert(base, "🚫 sanctionné") end
		if g.admin > 0 then table.insert(base, "👮 " .. g.admin .. " admin") end
		if g.confMax > 0 then table.insert(base, "🎯 max " .. g.confMax .. " %") end
		local line = text(b, 2, table.concat(base, "  ·  "), C.TEXT_WHITE, TS, true)
		local function fill()
			local fl = DATA.files[g.uid]
			if not fl or not line.Parent then return end
			local th = (DATA.feed and DATA.feed.threshold) or "?"
			line.Text = table.concat(base, "  ·  ") .. string.format("  ·  🗂️ %s/%s actifs  ·  💎 %s",
				tostring(fl.warnings or 0), tostring(th), fl.points and ugcPow(fl.points) or "?")
		end
		fill()
		entryButtons(b, 3, g.uid, g.name, g.restricted, not compact)
		return b, fill
	end

	--════════════════════════════════════════════════════════════════
	-- 🏠 ACCUEIL
	--════════════════════════════════════════════════════════════════
	local function renderHome(body)
		local d = DATA.home
		if not d then
			local st = status(body, 1)
			call("home", {}, function(res)
				if not st.Parent then return end
				if not (res and res.ok) then st.Text = "❌ Lecture impossible. Appuie sur 🔄." return end
				DATA.home = res
				rerender()
			end)
			return
		end
		local s = d.state or {}

		--  🧪 MODE SANS SANCTION / 🟢 SANCTIONS ACTIVES
		local real = not s.shadow
		local b = box(body, 1, real and "🟢 SANCTIONS ACTIVES" or "🧪 MODE SANS SANCTION (activé)",
			real and GREEN or CYAN,
			real and "Les joueurs qui atteignent le nombre de warnings sont vraiment sanctionnés."
				or "L'anti-cheat mesure et note tout, mais PERSONNE n'est sanctionné. Regarde le 📡 Fil et les 👥 Joueurs pendant quelques jours : si tout est normal, active les sanctions.")
		text(b, 2, string.format("Sanction : %s  ·  %s  ·  Un warning s'efface après %s%s",
			s.mode == "ban" and "🔨 Ban" or "🚫 Privation d'UGC",
			s.silent and "🤫 le joueur ne voit rien de ses warnings" or "👁️ le joueur voit ses warnings",
			(tonumber(s.expiry) or 0) > 0 and (s.expiry .. " jours") or "jamais",
			(tonumber(s.countFrom) or 0) > 0 and ("\n🕛 Warnings comptés depuis le " .. dateOf(s.countFrom)) or ""), C.TEXT_GREY, TS)
		button(b, 3, real and "🧪 Activer le mode sans sanction" or "🟢 Activer les sanctions",
			real and CYAN or GREEN, function()
				if real then
					confirmPage({ title = "🧪 Activer le mode sans sanction", color = CYAN,
						confirmText = "🧪 Oui, plus aucune sanction",
						lines = {
							"Plus AUCUNE sanction automatique, sur tous les serveurs, tant que ce mode est activé.",
							"L'anti-cheat continue de tout mesurer : tu vois tout dans le 📡 Fil et les 👥 Joueurs.",
							"Les joueurs déjà restreints restent restreints (lève-les dans 🚫 Restreints si besoin).",
						},
						onConfirm = function()
							call("setvalues", { values = { shadow = true } }, function(res)
								toast(res and res.msg or "Erreur", res and res.ok == true)
								DATA.home = nil ; DATA.schema = nil
								screenAC()
							end)
						end })
				else
					confirmPage({ title = "🟢 Activer les sanctions", color = GREEN,
						confirmText = "🟢 Oui, activer les sanctions",
						lines = {
							"À partir de maintenant, un joueur qui atteint " .. tostring(s.threshold) .. " warning(s) est vraiment privé d'UGC.",
							"S'applique tout de suite sur tous tes serveurs.",
						},
						checkbox = { label = "Ignorer les anciens warnings : ne compter qu'à partir de maintenant", default = true,
							desc = "Coché (conseillé) : tous les warnings reçus avant maintenant ne comptent plus, tout le monde repart de 0. Décoché : les warnings déjà reçus comptent (un joueur proche du seuil peut être sanctionné au prochain)." },
						onConfirm = function(_, ignoreOld)
							call("setvalues", { values = { shadow = false }, countFromNow = ignoreOld == true }, function(res)
								toast(res and res.msg or "Erreur", res and res.ok == true)
								DATA.home = nil ; DATA.schema = nil ; DATA.cand = nil ; DATA.files = {}
								screenAC()
							end)
						end })
				end
			end, IS_MOBILE and 38 or 44, BLACK)

		--  ⭐ LE réglage le plus important, ici, en gros
		local w = box(body, 2, "🚨 Warnings avant la restriction", RED,
			"Combien de warnings un joueur doit recevoir avant d'être privé d'UGC (1 à 1000). Tape le nombre puis appuie sur « Enregistrer ».")
		local cur = tonumber(s.threshold) or 1
		local row = frame(w, 3, IS_MOBILE and 36 or 42)
		local vb = Instance.new("TextBox")
		vb.Size = UDim2.new(0.4, 0, 1, 0)
		vb.BackgroundColor3 = C.BG_ITEM ; vb.BorderSizePixel = 0
		vb.Font = FONT ; vb.Text = tostring(cur) ; vb.TextColor3 = RED
		vb.TextSize = IS_MOBILE and 18 or 22 ; vb.ClearTextOnFocus = false ; vb.ZIndex = 12 ; vb.Parent = row
		corner(vb, 8) ; stroke(vb, RED, 1.5)
		local sv = Instance.new("Frame")
		sv.Size = UDim2.new(0.58, 0, 1, 0) ; sv.Position = UDim2.new(0.42, 0, 0, 0)
		sv.BackgroundTransparency = 1 ; sv.ZIndex = 12 ; sv.Parent = row
		local sb = actionButton(sv, { color = RED, strokeColor = RED_D, text = "💾 Enregistrer",
			textSize = IS_MOBILE and 11 or 14, radius = 8, zIndex = 13 })
		sb.MouseButton1Click:Connect(function()
			local n = tonumber((vb.Text:gsub("[^%d]", "")))
			if not n or n < 1 or n > 1000 then toast("Entre un nombre entre 1 et 1000", false) return end
			if n == cur then toast("C'est déjà " .. cur, true) return end
			confirmPage({ title = "🚨 Warnings avant la restriction : " .. cur .. " → " .. n, color = RED,
				confirmText = "💾 Oui, passer à " .. n,
				lines = {
					string.format("Un joueur sera privé d'UGC à partir de %d warning(s) (au lieu de %d).", n, cur),
					"S'applique tout de suite sur tous tes serveurs.",
					n < cur and "⚠️ Les joueurs qui ont déjà ce nombre de warnings seront sanctionnés à leur PROCHAIN warning."
						or "Les joueurs déjà restreints restent restreints.",
				},
				onConfirm = function()
					call("setvalues", { values = { ["ugc.warn"] = n } }, function(res)
						toast(res and res.msg or "Erreur", res and res.ok == true)
						DATA.home = nil ; DATA.schema = nil
						screenAC()
					end)
				end })
		end)

		--  🧹 Réinitialiser les warnings
		local z = box(body, 3, "🧹 Réinitialiser les warnings", C.BORDER_BRIGHT,
			"D'UN joueur : touche ⋯ en haut à droite de n'importe quelle entrée (Fil, Joueurs, Restreints) → « 🧹 Réinitialiser ses warnings », ou ouvre sa 🔍 Fiche.\nDe TOUT LE MONDE : le bouton ci-dessous.")
		button(z, 3, "👥 Réinitialiser les warnings de TOUT LE MONDE", C.BG_LIGHT, function()
			confirmPage({ title = "🧹 Réinitialiser les warnings de tout le monde", color = ORANGE,
				confirmText = "🧹 Oui, tout le monde repart de 0",
				lines = {
					"Tous les warnings reçus avant maintenant ne comptent plus, pour TOUS les joueurs, sur tous les serveurs.",
					"Le classement des warnings repart de zéro.",
					"Les sanctions déjà posées ne sont PAS levées.",
					"Le 📡 Fil et l'historique des détections sont gardés.",
				},
				onConfirm = function()
					call("setvalues", { countFromNow = true }, function(res)
						toast(res and res.msg or "Erreur", res and res.ok == true)
						DATA.home = nil ; DATA.cand = nil ; DATA.files = {}
						screenAC()
					end)
				end })
		end)

		--  Dernières 24 h
		local st = d.stats or {}
		local c = box(body, 4, "📊 Dernières 24 heures", ORANGE)
		text(c, 2, string.format("🔎 %d détection(s) sur %d joueur(s)\n⚠️ %d warning(s)  ·  🚫 %d sanction(s)\n🗂️ %d joueur(s) restreint(s) au total",
			st.det24 or 0, st.players24 or 0, st.warn24 or 0, st.sanc24 or 0, st.restricted or 0), C.TEXT_WHITE, TM)

		--  Dernières détections
		local r = box(body, 5, "📡 Derniers joueurs détectés", CYAN, "Une ligne par joueur. Touche « Voir tout le fil » pour le détail complet.")
		local groups = groupByPlayer(d.recent)
		if #groups == 0 then text(r, 2, "✅ Rien de récent.", GREEN, TS) end
		for i = 1, math.min(5, #groups) do groupEntry(r, 1 + i, groups[i], true) end
		button(r, 20, "📡 Voir tout le fil →", CYAN, function() ST.tab = "feed" ; screenAC() end, nil, BLACK)

		--  Mode d'emploi
		note(body, 6,
			"📖 COMMENT ÇA MARCHE\n"
				.. "1. L'anti-cheat mesure chaque joueur 4 fois par seconde (vol, téléportation, vitesse).\n"
				.. "2. Chaque détection reçoit une CERTITUDE en %. Les détections trop peu sûres sont ignorées.\n"
				.. "3. Plusieurs détections sûres et rapprochées = 1 WARNING.\n"
				.. "4. Au nombre de warnings réglé ci-dessus → le joueur est PRIVÉ D'UGC (si la certitude du dossier est suffisante).\n"
				.. "5. Chaque warning s'efface tout seul après le délai réglé.\n\n"
				.. "📡 Fil : tout ce qui vient de se passer, expliqué.  👥 Joueurs : les suspects, triables.\n"
				.. "🚫 Restreints : les sanctionnés.  🔍 Fiche : tout sur un joueur.  ⚙️ Réglages : TOUS les réglages.",
			C.TEXT_GREY)
	end

	--════════════════════════════════════════════════════════════════
	-- 📡 FIL RÉCENT
	--════════════════════════════════════════════════════════════════
	local function renderFeed(body)
		local F = ST.feed
		note(body, 1, "UNE entrée par joueur, du plus récent au plus ancien, tous serveurs confondus. Chaque entrée "
			.. "tient en une ligne de stats. « 🔎 Tout voir » ouvre par-dessus le panel TOUT son dossier : "
			.. "chaque détection et chaque warning avec ses + / −, où, avec quoi, et sa sanction.", CYAN)
		chips(body, 2, {
			{ id = "all", label = "Tout" }, { id = "detection", label = "🔎 Détections" },
			{ id = "warning", label = "⚠️ Warnings" }, { id = "sanction", label = "🚫 Sanctions" },
			{ id = "admin", label = "👮 Actions admin" },
		}, F.kind, ORANGE, function(v) F.kind = v ; F.show = 30 ; screenAC() end, 5)
		chips(body, 3, {
			{ id = "all", label = "Tous types" }, { id = "fly", label = "🕊️ Vol" },
			{ id = "tp", label = "🌀 Téléport" }, { id = "speed", label = "💨 Vitesse" },
		}, F.fam, ORANGE, function(v) F.fam = v ; F.show = 30 ; screenAC() end, 4)
		chips(body, 4, {
			{ id = 0, label = "Toute certitude" }, { id = 70, label = "≥ 70 %" }, { id = 85, label = "≥ 85 %" },
		}, F.minConf, ORANGE, function(v) F.minConf = v ; screenAC() end, 3)
		local tg = frame(body, 5, IS_MOBILE and 26 or 30)
		local g = Instance.new("UIGridLayout") ; g.CellSize = UDim2.new(0.5, -4, 1, 0) ; g.CellPadding = UDim2.new(0, 8, 0, 0) ; g.Parent = tg
		toggleChip(tg, 1, "En ligne seulement", F.online, GREEN, function(v) F.online = v ; screenAC() end)
		toggleChip(tg, 2, "Masquer les restreints", F.hideR, PURPLE, function(v) F.hideR = v ; screenAC() end)
		searchBox(body, 6, "🔍 Pseudo ou UserId…", F.search, function(t) F.search = t ; screenAC() end, ORANGE)

		local holder = frame(body, 7) ; list(holder, IS_MOBILE and 6 or 8)
		local d = DATA.feed
		if not d then
			local st = status(holder, 1)
			call("feedlog", { limit = 300 }, function(res)
				if not st.Parent then return end
				if not (res and res.ok) then st.Text = "❌ Lecture impossible. Appuie sur 🔄." return end
				DATA.feed = res
				rerender()
			end)
			return
		end
		local q = (F.search or ""):lower()
		--  On garde les événements qui passent les filtres, puis UNE entrée par joueur.
		local kept = {}
		for _, e in ipairs(d.events or {}) do
			local ok = true
			if F.kind == "admin" then ok = (e.kind == "manual" or e.kind == "lift")
			elseif F.kind ~= "all" then ok = (e.kind == F.kind) end
			if ok and F.fam ~= "all" then ok = typeFamily(e.type) == F.fam end
			if ok and F.minConf > 0 then ok = (tonumber(e.conf) or 0) >= F.minConf end
			if ok and F.online then ok = e.online == true end
			if ok and F.hideR then ok = not e.restricted end
			if ok and #q > 0 then
				ok = tostring(e.name or ""):lower():find(q, 1, true) ~= nil or tostring(e.uid) == q
			end
			if ok then table.insert(kept, e) end
		end
		local groups = groupByPlayer(kept)
		text(holder, 0, string.format("👤 %d joueur(s) · %d événement(s)", #groups, #kept), C.TEXT_DIM, TS)
		if #groups == 0 then text(holder, 1, "✅ Rien ne correspond à ces filtres.", C.TEXT_GREY, TM) end
		local ids, fills = {}, {}
		for i = 1, math.min(#groups, F.show) do
			local g = groups[i]
			local _, fill = groupEntry(holder, i, g, false)
			if fill then fills[#fills + 1] = fill end
			if not DATA.files[g.uid] then ids[#ids + 1] = g.uid end
		end
		if #groups > F.show then
			button(holder, 9999, string.format("⬇️ Afficher plus (%d sur %d joueurs)", F.show, #groups), C.BG_LIGHT, function()
				F.show = F.show + 30 ; screenAC()
			end)
		end
		if #ids > 0 then
			loadFiles(ids, function() for _, fn in ipairs(fills) do pcall(fn) end end)
		end
	end

	--════════════════════════════════════════════════════════════════
	-- 👥 JOUEURS (classement triable)
	--════════════════════════════════════════════════════════════════
	local SORTS = {
		{ id = "last",   label = "🕒 Dernière détection" },
		{ id = "near",   label = "🔥 Proches de la sanction" },
		{ id = "warn",   label = "⚠️ Warnings" },
		{ id = "conf",   label = "🎯 Certitude moy." },
		{ id = "confmax", label = "📈 Certitude max" },
		{ id = "total",  label = "📊 Détections (total)" },
		{ id = "det24",  label = "⚡ Détections 24 h" },
		{ id = "points", label = "💎 Points / UGC" },
		{ id = "risk",   label = "💣 Risque (warn × UGC)" },
		{ id = "noise",  label = "🌫️ Bruit (écartés)" },
		{ id = "new",    label = "🆕 Nouveaux suspects" },
		{ id = "name",   label = "🔤 Nom A → Z" },
	}
	local function sortValue(m, key, th)
		local f = DATA.files[m.userId] or {}
		local w = tonumber(f.warnings) or tonumber(m.warn) or 0
		if key == "last" then return tonumber(f.lastAt) or tonumber(m.lastAt) or 0 end
		if key == "near" then return w / math.max(1, tonumber(th) or 1) end
		if key == "warn" then return w end
		if key == "conf" then return tonumber(f.confAvg) or 0 end
		if key == "confmax" then return tonumber(f.confMax) or 0 end
		if key == "total" then return tonumber(f.total) or tonumber(m.det) or 0 end
		if key == "det24" then return tonumber(m.det24) or 0 end
		if key == "points" then return tonumber(f.points) or -1 end
		if key == "risk" then return w * ((tonumber(f.points) or 0) / UGC_PRICE) end
		if key == "noise" then return tonumber(f.ignored) or 0 end
		if key == "new" then return tonumber(f.firstSeen) or 0 end
		if key == "name" then return tostring(f.name or m.name or m.userId):lower() end
		return 0
	end
	local function famOf(m)
		local f = DATA.files[m.userId] or {}
		local best, bn = f.lastType or m.lastType, -1
		for t, n in pairs(f.detByType or {}) do if (tonumber(n) or 0) > bn then best, bn = t, tonumber(n) end end
		return typeFamily(best)
	end

	local function renderPlayers(body)
		local P = ST.pl
		note(body, 1, "Tous les joueurs qui ont au moins une détection retenue ou un warning. Choisis le tri et les "
			.. "filtres, puis touche une ligne pour ouvrir sa fiche complète. Les joueurs restreints sont marqués 🚫 en violet.", GOLD)
		text(body, 2, "Trier par :", C.TEXT_WHITE, TS, true)
		chips(body, 3, SORTS, P.sort, GOLD, function(v) P.sort = v ; P.desc = (v ~= "name") ; screenAC() end, 3)
		chips(body, 4, {
			{ id = true, label = "⬇️ Du plus grand au plus petit" }, { id = false, label = "⬆️ Du plus petit au plus grand" },
		}, P.desc, GOLD, function(v) P.desc = v ; screenAC() end, 2)
		chips(body, 5, {
			{ id = "all", label = "Tous types" }, { id = "fly", label = "🕊️ Vol" },
			{ id = "tp", label = "🌀 Téléport" }, { id = "speed", label = "💨 Vitesse" },
		}, P.fam, GOLD, function(v) P.fam = v ; screenAC() end, 4)
		chips(body, 6, {
			{ id = "all", label = "Tous" }, { id = "free", label = "Non restreints" }, { id = "restricted", label = "🚫 Restreints" },
		}, P.status, PURPLE, function(v) P.status = v ; screenAC() end, 3)
		toggleChip(body, 7, "En ligne seulement", P.online, GREEN, function(v) P.online = v ; screenAC() end)
		searchBox(body, 8, "🔍 Pseudo ou UserId…", P.search, function(t) P.search = t ; screenAC() end, GOLD)

		local holder = frame(body, 9) ; list(holder, IS_MOBILE and 6 or 8)
		local d = DATA.cand
		if not d then
			local st = status(holder, 1)
			call("candidates", { limit = 150 }, function(res)
				if not st.Parent then return end
				if not (res and res.ok) then st.Text = "❌ Lecture impossible. Appuie sur 🔄." return end
				DATA.cand = res
				--  l'affichage lance ensuite le chargement des détails de TOUS les
				--  joueurs, par paquets, avec un seul nouvel affichage à la fin
				rerender()
			end)
			return
		end
		local th = d.threshold or 1
		local missing, need = 0, {}
		for _, m in ipairs(d.entries or {}) do
			if not DATA.files[m.userId] then missing = missing + 1 ; need[#need + 1] = m.userId end
		end
		if missing > 0 and not DATA.candLoading then
			DATA.candLoading = true
			loadFiles(need, nil, function()
				DATA.candLoading = false
				if ST.tab == "players" then rerender() end
			end)
		end
		if missing > 0 then
			text(holder, 0, string.format("⏳ Détails en cours de chargement (%d restants) — le tri s'affinera tout seul.", missing), C.TEXT_DIM, TS)
		end

		local q = (P.search or ""):lower()
		local rows = {}
		for _, m in ipairs(d.entries or {}) do
			local f = DATA.files[m.userId] or {}
			local restricted = (f.restricted ~= nil) and f.restricted or m.restricted
			local online = Players:GetPlayerByUserId(m.userId) ~= nil
			local ok = true
			if P.status == "free" then ok = not restricted elseif P.status == "restricted" then ok = restricted == true end
			if ok and P.online then ok = online end
			if ok and P.fam ~= "all" then ok = famOf(m) == P.fam end
			if ok and #q > 0 then
				ok = tostring(f.name or m.name or ""):lower():find(q, 1, true) ~= nil or tostring(m.userId) == q
			end
			if ok then table.insert(rows, { m = m, v = sortValue(m, P.sort, th), r = restricted, o = online }) end
		end
		table.sort(rows, function(a, b)
			if a.v == b.v then return a.m.userId < b.m.userId end
			if P.desc then return a.v > b.v else return a.v < b.v end
		end)
		if #rows == 0 then text(holder, 1, "✅ Aucun joueur ne correspond.", C.TEXT_GREY, TM) end

		for i = 1, math.min(#rows, P.show) do
			local x = rows[i]
			local m, f = x.m, DATA.files[x.m.userId] or {}
			local w = tonumber(f.warnings) or tonumber(m.warn) or 0
			local col = x.r and PURPLE or (w >= th and RED or (w > 0 and ORANGE or C.BORDER_SUBTLE))
			local row = box(holder, i, nil, col)
			if x.r then row.BackgroundColor3 = Color3.fromRGB(40, 24, 56) end
			local right
			local key = P.sort
			if key == "last" then right = fmtAgo(sortValue(m, "last", th))
			elseif key == "points" or key == "risk" then right = f.points and (fmtNum(f.points) .. "\n" .. ugcPow(f.points)) or "?"
			elseif key == "conf" or key == "confmax" then right = string.format("%d %%", sortValue(m, key, th))
			elseif key == "name" then right = ""
			elseif key == "new" then right = f.firstSeen and ("depuis\n" .. fmtAgo(f.firstSeen)) or "?"
			elseif key == "near" then right = string.format("%d / %d", w, th)
			else right = tostring(math.floor(sortValue(m, key, th) + 0.5)) end
			playerHead(row, 1, m.userId, f.name or m.name, x.r, x.o, "#" .. i .. "\n" .. right, col)
			text(row, 2, string.format("⚠️ %d/%d warn.  ·  🎯 %s moy. (max %s)  ·  📊 %s détect. (%d sur 24 h)  ·  💎 %s",
				w, th, f.confAvg and (f.confAvg .. " %") or "?", f.confMax and (f.confMax .. " %") or "?",
				tostring(f.total or m.det or "?"), tonumber(m.det24) or 0, f.points and ugcPow(f.points) or "?"), C.TEXT_WHITE, TS, true)
			entryButtons(row, 3, m.userId, f.name or m.name, x.r, true)
		end
		if #rows > P.show then
			button(holder, 9999, string.format("⬇️ Afficher plus (%d sur %d)", P.show, #rows), C.BG_LIGHT, function()
				P.show = P.show + 30 ; screenAC()
			end)
		end
	end

	--════════════════════════════════════════════════════════════════
	-- 🚫 RESTREINTS
	--════════════════════════════════════════════════════════════════
	local function renderRestricted(body)
		local R = ST.rs
		note(body, 1, "Tous les joueurs privés d'UGC, avec la raison exacte. Touche « ✅ Lever » pour rendre l'accès "
			.. "(une page de confirmation s'ouvre).", PURPLE)
		chips(body, 2, {
			{ id = "recent", label = "🕒 Plus récents" }, { id = "old", label = "⌛ Plus anciens" },
			{ id = "auto", label = "🤖 Auto d'abord" }, { id = "manual", label = "👮 Manuels d'abord" },
			{ id = "tries", label = "🔁 Tentatives d'achat" }, { id = "conf", label = "🎯 Certitude" },
		}, R.sort, PURPLE, function(v) R.sort = v ; screenAC() end, 3)
		searchBox(body, 3, "🔍 Pseudo, UserId, admin ou mot de la raison…", R.search, function(t) R.search = t ; screenAC() end, PURPLE)
		local holder = frame(body, 4) ; list(holder, IS_MOBILE and 6 or 8)
		local d = DATA.restricted
		if not d then
			local st = status(holder, 1)
			local fn = ReplicatedStorage:FindFirstChild("AdminGetUGCRestrict")
			if not fn then st.Text = "❌ AntiCheat_UGCRestrict manquant côté serveur." return end
			task.spawn(function()
				local ok, res = pcall(function() return fn:InvokeServer(true, false) end)
				if not st.Parent then return end
				if not (ok and type(res) == "table" and res.ok) then st.Text = "❌ Lecture impossible. Appuie sur 🔄." return end
				DATA.restricted = res.entries or {}
				rerender()
			end)
			return
		end
		local q = (R.search or ""):lower()
		local rows = {}
		for _, r in ipairs(d) do
			local why = tostring(r.reasonText or r.details or r.reason or "")
			local hay = (tostring(r.name or "") .. " " .. tostring(r.userId) .. " " .. tostring(r.by or "") .. " " .. why):lower()
			if #q == 0 or hay:find(q, 1, true) then table.insert(rows, r) end
		end
		table.sort(rows, function(a, b)
			if R.sort == "old" then return (a.at or 0) < (b.at or 0) end
			if R.sort == "auto" and a.auto ~= b.auto then return a.auto == true end
			if R.sort == "manual" and a.auto ~= b.auto then return a.auto ~= true end
			if R.sort == "tries" and (a.attempts or 0) ~= (b.attempts or 0) then return (a.attempts or 0) > (b.attempts or 0) end
			if R.sort == "conf" and (a.confidence or 0) ~= (b.confidence or 0) then return (a.confidence or 0) > (b.confidence or 0) end
			return (a.at or 0) > (b.at or 0)
		end)
		text(holder, 0, string.format("🚫 %d joueur(s) restreint(s)%s", #rows, #q > 0 and " (recherche)" or ""), PURPLE, TM, true)
		for i = 1, math.min(#rows, 60) do
			local r = rows[i]
			local b = box(holder, i, nil, PURPLE)
			b.BackgroundColor3 = Color3.fromRGB(40, 24, 56)
			playerHead(b, 1, r.userId, r.name, true, Players:GetPlayerByUserId(r.userId) ~= nil,
				(r.auto and "🤖 AUTO" or "👮 MANUEL") .. "\n" .. fmtAgo(r.at), PURPLE)
			text(b, 2, string.format("📅 %s  ·  %s  ·  🎯 %s  ·  ⚠️ %d warn.  ·  🔁 %d achat(s) bloqué(s)%s",
				fmtAgo(r.at), r.auto and "🤖 anti-cheat" or ("👮 " .. tostring(r.by or "?")),
				r.confidence and (r.confidence .. " %") or "—", r.warnings or 0, r.attempts or 0,
				(r.leaks or 0) > 0 and ("  ·  🚨 " .. r.leaks .. " fuite(s)") or ""), C.TEXT_WHITE, TS, true)
			entryButtons(b, 3, r.userId, r.name, true, true)
		end
		if #rows > 60 then text(holder, 9999, "… affine la recherche pour voir les autres.", C.TEXT_DIM, TS) end
	end

	--════════════════════════════════════════════════════════════════
	-- 🔍 FICHE JOUEUR
	--════════════════════════════════════════════════════════════════
	local function renderCard(body)
		searchBox(body, 1, "🔍 Pseudo exact ou UserId, puis Entrée…", ST.cardSearch, function(t)
			ST.cardSearch = t
			local v = t:gsub("^%s+", ""):gsub("%s+$", "")
			if #v >= 2 then ST.card = tonumber(v) or v ; ST.cardData = nil ; screenAC() end
		end, CYAN)
		if not ST.card then
			note(body, 2, "Choisis un joueur dans le 📡 Fil, 👥 Joueurs ou 🚫 Restreints, ou cherche-le ici. "
				.. "La fiche montre ses warnings actifs (et quand ils expirent), tout son historique expliqué, "
				.. "sa sanction éventuelle et les actions possibles.", C.TEXT_DIM)
			return
		end
		local d = ST.cardData
		if not d then
			local st = status(body, 2, "⏳ Ouverture de la fiche…")
			if not ST.cardLoading then
				ST.cardLoading = true
				call("lookup", { target = ST.card, deep = true }, function(res)
					ST.cardLoading = false
					ST.cardData = res or { ok = false, msg = "Pas de réponse" }
					if res and res.ok then ST.card = res.userId end
					rerender()
				end)
			end
			return
		end
		if not d.ok then note(body, 2, "❌ " .. tostring(d.msg or "Joueur introuvable"), RED) return end
		local uid = d.userId
		local rec = d.record
		local fl = d.file or {}
		local per = d.persisted or {}
		local th = d.threshold or 1
		local head = box(body, 2, nil, rec and PURPLE or CYAN)
		playerHead(head, 1, uid, d.name, rec ~= nil, d.online, d.isAdmin and "👮 ADMIN" or nil, CYAN)

		ST.cardUI = ST.cardUI or {}
		local f2 = DATA.files[uid]
		renderDossier(body, 3, { uid = uid, name = d.name, file = fl, stats = next(per) and per or nil, record = rec,
			events = d.events, live = d.live, threshold = th, points = f2 and f2.points }, ST.cardUI, function() screenAC() end)

		local acts = {
			{ text = "👤 Profil", color = C.PURPLE, fn = function() openProfileDetail(d.name, function() screenAC() end) end },
		}
		if rec then
			table.insert(acts, { text = "✅ Lever", color = GREEN, textColor = BLACK, fn = function() askLift(uid, d.name) end })
		else
			table.insert(acts, { text = "🚫 Restreindre", color = RED, fn = function() askRestrict(uid, d.name) end })
		end
		table.insert(acts, { text = "🧹 Ses warnings à 0", color = C.BG_LIGHT, fn = function() askReset(uid, d.name) end })
		buttonRow(body, 8, acts, IS_MOBILE and 38 or 44)
	end

	--════════════════════════════════════════════════════════════════
	-- ⚙️ RÉGLAGES (tout, par sections repliables)
	--════════════════════════════════════════════════════════════════
	local function toText(f, v)
		if f.t == "list" or f.t == "numlist" then
			local o = {}
			for _, x in ipairs(type(v) == "table" and v or {}) do table.insert(o, tostring(x)) end
			return table.concat(o, ", ")
		elseif f.t == "map" then
			local o = {}
			for k, x in pairs(type(v) == "table" and v or {}) do table.insert(o, tostring(k) .. "=" .. tostring(x)) end
			table.sort(o)
			return table.concat(o, ", ")
		elseif f.t == "bool" then
			return v and "OUI" or "NON"
		elseif f.t == "choice" then
			for _, o in ipairs(f.options or {}) do if o.v == v then return o.l end end
		end
		return tostring(v)
	end
	local function current(f)
		local S = ST.set
		if S.resets[f.id] then return f.default end
		if S.draft[f.id] ~= nil then return S.draft[f.id] end
		return f.value
	end
	local function setDraft(f, v)
		ST.set.resets[f.id] = nil
		if toText(f, v) == toText(f, f.value) then ST.set.draft[f.id] = nil else ST.set.draft[f.id] = v end
	end
	local function pendingList()
		local out = {}
		for _, sec in ipairs((DATA.schema and DATA.schema.sections) or {}) do
			for _, f in ipairs(sec.fields) do
				if ST.set.draft[f.id] ~= nil or ST.set.resets[f.id] then table.insert(out, f) end
			end
		end
		return out
	end

	local function fieldRow(parent, order, f, presetIsCustom)
		local row = box(parent, order, nil, C.BORDER_SUBTLE)
		row.BackgroundColor3 = C.BG_ITEM
		local v = current(f)
		local changed = ST.set.draft[f.id] ~= nil or ST.set.resets[f.id]
		local differs = toText(f, v) ~= toText(f, f.default)
		local title = (changed and "✏️ " or "") .. tostring(f.label)
		text(row, 1, title, f.danger and RED or (changed and GOLD or C.TEXT_WHITE), TM, true)
		if f.desc then text(row, 2, f.desc, C.TEXT_DIM, TS) end
		if f.sev and not presetIsCustom then
			text(row, 3, "◆ Choisi par la Sévérité tant qu'elle n'est pas « Custom » : ta valeur ne s'applique pas.", ORANGE, TS)
		end

		if f.t == "bool" then
			chips(row, 4, { { id = true, label = "✅ OUI" }, { id = false, label = "⛔ NON" } }, v == true,
			v and GREEN or RED, function(nv) setDraft(f, nv) ; screenAC() end, 2)
		elseif f.t == "choice" then
			chips(row, 4, (function()
				local o = {}
				for _, x in ipairs(f.options or {}) do table.insert(o, { id = x.v, label = x.l }) end
				return o
			end)(), v, CYAN, function(nv) setDraft(f, nv) ; screenAC() end, math.min(4, #(f.options or {})))
		elseif f.t == "number" then
			local c = frame(row, 4, IS_MOBILE and 30 or 34)
			local function stepBtn(x, txt, delta)
				local w = Instance.new("Frame")
				w.Size = UDim2.new(0.2, -4, 1, 0) ; w.Position = UDim2.new(x, 0, 0, 0)
				w.BackgroundTransparency = 1 ; w.ZIndex = 12 ; w.Parent = c
				local b = actionButton(w, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = txt,
					textSize = IS_MOBILE and 14 or 17, radius = 7, zIndex = 13 })
				b.MouseButton1Click:Connect(function()
					local nv = math.clamp((tonumber(v) or 0) + delta, f.min or -1e9, f.max or 1e9)
					nv = math.floor(nv * 100 + 0.5) / 100
					setDraft(f, nv) ; screenAC()
				end)
			end
			stepBtn(0, "−", -(f.step or 1))
			local tb = Instance.new("TextBox")
			tb.Size = UDim2.new(0.56, -4, 1, 0) ; tb.Position = UDim2.new(0.22, 0, 0, 0)
			tb.BackgroundColor3 = C.BG_DARK ; tb.BorderSizePixel = 0 ; tb.Font = FONT
			tb.Text = tostring(v) ; tb.TextColor3 = changed and GOLD or CYAN ; tb.TextSize = TM
			tb.ClearTextOnFocus = false ; tb.ZIndex = 12 ; tb.Parent = c
			corner(tb, 7) ; stroke(tb, CYAN, 1)
			tb.FocusLost:Connect(function()
				local n = tonumber((tb.Text:gsub(",", "."):gsub("[^%d%.%-]", "")))
				if n then
					n = math.clamp(n, f.min or -1e9, f.max or 1e9)
					setDraft(f, n) ; screenAC()
				else
					tb.Text = tostring(v)
				end
			end)
			stepBtn(0.8, "+", f.step or 1)
			text(row, 5, string.format("Limites : %s à %s", tostring(f.min), tostring(f.max)), C.TEXT_DIM, TS)
		else
			local tb = Instance.new("TextBox")
			tb.Size = UDim2.new(1, 0, 0, 0) ; tb.AutomaticSize = Enum.AutomaticSize.Y
			tb.BackgroundColor3 = C.BG_DARK ; tb.BorderSizePixel = 0 ; tb.Font = Enum.Font.Gotham
			tb.Text = (f.t == "text") and tostring(v or "") or toText(f, v)
			tb.TextColor3 = changed and GOLD or C.TEXT_WHITE ; tb.TextSize = TS
			tb.TextWrapped = true ; tb.MultiLine = (f.t == "text") ; tb.ClearTextOnFocus = false
			tb.TextXAlignment = Enum.TextXAlignment.Left ; tb.TextYAlignment = Enum.TextYAlignment.Top
			tb.LayoutOrder = 4 ; tb.ZIndex = 12 ; tb.Parent = row
			corner(tb, 7) ; stroke(tb, CYAN, 1)
			local p = Instance.new("UIPadding") ; p.PaddingLeft = UDim.new(0, 8) ; p.PaddingRight = UDim.new(0, 8)
			p.PaddingTop = UDim.new(0, 6) ; p.PaddingBottom = UDim.new(0, 6) ; p.Parent = tb
			tb.FocusLost:Connect(function()
				local nv = tb.Text
				if f.t == "list" or f.t == "numlist" then
					local o = {}
					for part in string.gmatch(nv, "[^,\n]+") do
						local x = part:gsub("^%s+", ""):gsub("%s+$", "")
						if x ~= "" then table.insert(o, f.t == "numlist" and (tonumber(x) or x) or x) end
					end
					nv = o
				elseif f.t == "map" then
					local o = {}
					for part in string.gmatch(nv, "[^,\n]+") do
						local k, n = part:match("^%s*(.-)%s*=%s*([%d%.]+)%s*$")
						if k and k ~= "" then o[k] = tonumber(n) end
					end
					nv = o
				end
				setDraft(f, nv) ; screenAC()
			end)
			if f.t ~= "text" then text(row, 5, "Sépare les éléments par des virgules.", C.TEXT_DIM, TS) end
		end
		if differs then
			local dTxt = toText(f, f.default)
			if #dTxt > 60 then dTxt = dTxt:sub(1, 60) .. "…" end
			local c = frame(row, 6, IS_MOBILE and 24 or 28)
			local b = actionButton(c, { color = C.BG_DARK, strokeColor = C.BORDER_SUBTLE,
				text = "↺ Revenir à la valeur du fichier (" .. dTxt .. ")", textColor = C.TEXT_GREY,
				textSize = TS, radius = 7, zIndex = 13 })
			b.MouseButton1Click:Connect(function()
				ST.set.draft[f.id] = nil ; ST.set.resets[f.id] = true ; screenAC()
			end)
		end
		return row
	end

	local function askSave()
		local pend = pendingList()
		if #pend == 0 then toast("Aucune modification", true) return end
		local lines = {}
		for _, f in ipairs(pend) do
			local old, new = toText(f, f.value), toText(f, current(f))
			if #old > 40 then old = old:sub(1, 40) .. "…" end
			if #new > 40 then new = new:sub(1, 40) .. "…" end
			table.insert(lines, string.format("%s : %s → %s%s", f.label, old, new, ST.set.resets[f.id] and " (valeur du fichier)" or ""))
		end
		table.insert(lines, "S'applique tout de suite sur TOUS tes serveurs.")
		confirmPage({ title = "💾 Enregistrer " .. #pend .. " réglage(s)", color = GOLD, confirmText = "💾 Oui, enregistrer",
			lines = lines,
			onConfirm = function()
				local values, resets = {}, {}
				for id, v in pairs(ST.set.draft) do values[id] = v end
				for id in pairs(ST.set.resets) do table.insert(resets, id) end
				call("setvalues", { values = values, reset = resets }, function(res)
					toast(res and res.msg or "Erreur", res and res.ok == true)
					if res and res.ok then
						ST.set.draft, ST.set.resets = {}, {}
						DATA.schema = nil ; DATA.home = nil
					end
					screenAC()
				end)
			end })
	end

	local function renderSettings(body)
		local S = ST.set
		local d = DATA.schema
		if not d then
			local st = status(body, 1)
			call("schema", {}, function(res)
				if not st.Parent then return end
				if not (res and res.ok) then st.Text = "❌ Lecture impossible. Appuie sur 🔄." return end
				DATA.schema = res
				rerender()
			end)
			return
		end
		note(body, 1, "📖 TOUS les réglages de l'anti-cheat sont ici, rangés par sections. Touche une section pour "
			.. "l'ouvrir. Tes changements sont en jaune ✏️ et ne s'appliquent qu'après « 💾 Enregistrer » (une page "
			.. "de confirmation récapitule tout).\n\n📄 Ces réglages viennent aussi du fichier ANTICHEAT_CONFIG "
			.. "(VERSION " .. tostring(d.fileVersion) .. ") : ce que tu enregistres ici reste actif tant que tu ne "
			.. "montes pas VERSION dans le fichier.", C.TEXT_GREY)
		local pend = pendingList()
		if #pend > 0 then
			buttonRow(body, 2, {
				{ text = "💾 Enregistrer " .. #pend .. " modif(s)", color = GOLD, textColor = BLACK, fn = askSave },
				{ text = "↩️ Tout annuler", color = C.BG_LIGHT, fn = function()
					S.draft, S.resets = {}, {} ; screenAC()
				end },
			}, IS_MOBILE and 36 or 42)
		end
		text(body, 4, "🧹 Pour réinitialiser des warnings : 🏠 Accueil → « Réinitialiser les warnings », ou ⋯ sur un joueur.", C.TEXT_DIM, TS)
		searchBox(body, 3, "🔍 Chercher un réglage (ex : warning, vol, jetpack)…", S.search, function(t)
			S.search = t ; screenAC()
		end, GOLD)

		local presetCustom = false
		for _, sec in ipairs(d.sections) do
			for _, f in ipairs(sec.fields) do
				if f.adv == "Preset" then presetCustom = (current(f) == "custom") end
			end
		end

		local q = (S.search or ""):lower()
		local order = 10
		for _, sec in ipairs(d.sections) do
			order = order + 1
			local matches = {}
			for _, f in ipairs(sec.fields) do
				if #q == 0 or (tostring(f.label) .. " " .. tostring(f.desc or "")):lower():find(q, 1, true) then
					table.insert(matches, f)
				end
			end
			if #matches > 0 then
				local nChanged = 0
				for _, f in ipairs(sec.fields) do
					if S.draft[f.id] ~= nil or S.resets[f.id] then nChanged = nChanged + 1 end
				end
				local open = (#q > 0) or S.open[sec.id] == true
				local essential = sec.id == "essentiel"
				local hdr = frame(body, order * 2, IS_MOBILE and 38 or 46)
				local hb, hl = actionButton(hdr, { color = essential and RED or C.BG_DARK,
					strokeColor = essential and RED or (nChanged > 0 and GOLD or C.BORDER_BRIGHT),
					text = (open and "▼  " or "▶  ") .. sec.title .. "  (" .. #sec.fields .. ")"
						.. (nChanged > 0 and ("  ✏️" .. nChanged) or ""),
					textColor = C.TEXT_WHITE, textSize = IS_MOBILE and 11 or 14, radius = 9, zIndex = 13 })
				hl.TextXAlignment = Enum.TextXAlignment.Left
				local hp = Instance.new("UIPadding") ; hp.PaddingLeft = UDim.new(0, 12) ; hp.Parent = hl
				hb.MouseButton1Click:Connect(function() S.open[sec.id] = not S.open[sec.id] ; screenAC() end)
				if open then
					local holder = frame(body, order * 2 + 1) ; list(holder, 6)
					if sec.intro then text(holder, 0, sec.intro, C.TEXT_DIM, TS) end
					for i, f in ipairs(matches) do fieldRow(holder, i, f, presetCustom) end
				end
			end
		end
		if #pend > 0 then
			button(body, 9999, "💾 Enregistrer " .. #pend .. " modif(s)", GOLD, askSave, IS_MOBILE and 36 or 42, BLACK)
		end
	end

	--════════════════════════════════════════════════════════════════
	-- 🖥️ L'ÉCRAN
	--════════════════════════════════════════════════════════════════
	screenAC = function()
		currentScreen = "anticheat"
		local body = buildScreen("🛡️ ANTI-CHEAT", true, RED, nil, function()
			--  🔄 relit tout depuis le serveur
			DATA.home, DATA.feed, DATA.cand, DATA.schema, DATA.restricted = nil, nil, nil, nil, nil
			DATA.files = {} ; ST.cardData = nil
			screenAC()
		end)
		acTabBar(body, -3, {
			{ id = "home", label = "🏠 Accueil" }, { id = "feed", label = "📡 Fil récent" },
			{ id = "players", label = "👥 Joueurs" },
		}, ST.tab, RED, function(id) ST.tab = id ; screenAC() end)
		acTabBar(body, -2, {
			{ id = "restricted", label = "🚫 Restreints" }, { id = "card", label = "🔍 Fiche" },
			{ id = "settings", label = "⚙️ Réglages" },
		}, ST.tab, RED, function(id) ST.tab = id ; screenAC() end)
		local ok, err = pcall(function()
			if ST.tab == "feed" then renderFeed(body)
			elseif ST.tab == "players" then renderPlayers(body)
			elseif ST.tab == "restricted" then renderRestricted(body)
			elseif ST.tab == "card" then renderCard(body)
			elseif ST.tab == "settings" then renderSettings(body)
			else renderHome(body) end
		end)
		if not ok then
			warn("[Anti-cheat panel] " .. tostring(err))
			note(body, 1, "❌ Erreur d'affichage : " .. tostring(err), RED)
		end
	end

	--════════════════════════════════════════════════════════════════
	-- 🔌 ACCUEIL DU PANEL : un seul bouton « 🛡️ ANTI-CHEAT »
	--════════════════════════════════════════════════════════════════
	for i = #ACTIONS, 1, -1 do
		local a = ACTIONS[i]
		if a.id == "ugcban" or a.id == "acmodes" then table.remove(ACTIONS, i)
		elseif a.id == "acboards" then a.name = "🛡️ ANTI-CHEAT" end
	end
	screenACBoards = function() screenAC() end
	local previousOpenAction = openAction
	openAction = function(a)
		if a and (a.id == "acboards" or a.id == "ugcban" or a.id == "acmodes") then
			if ST.tab == "card" and not ST.card then ST.tab = "home" end
			screenAC()
			return
		end
		if previousOpenAction then return previousOpenAction(a) end
	end
	print("✅ Bloc 16 chargé — 🛡️ ANTI-CHEAT (écran unique)")
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🗑️ BLOC 17 — FEEDBACK : « Supprimer TOUS les feedbacks » (avec confirmation)
--    Un bouton rouge en bas de l'écran 💬 FEEDBACK (onglet « All feedback »).
--    Il ouvre une page de confirmation :
--      • elle dit exactement ce qui va être effacé ;
--      • case « vider aussi les favoris » (décochée par défaut) ;
--      • il faut TAPER le mot SUPPRIMER, et le bouton ne s'active qu'après 3 s.
--════════════════════════════════════════════════════════════════════════════
;(function()
	local RED   = Color3.fromRGB(235, 60, 65)
	local RED_D = Color3.fromRGB(140, 25, 30)
	local TS    = IS_MOBILE and 10 or 12
	local TM    = IS_MOBILE and 11 or 14

	local function lbl(parent, order, txt, color, size, bold)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0) ; l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1 ; l.Font = bold and FONT or Enum.Font.Gotham
		l.Text = txt ; l.TextColor3 = color or C.TEXT_GREY ; l.TextSize = size or TS
		l.TextWrapped = true ; l.TextXAlignment = Enum.TextXAlignment.Left
		l.LayoutOrder = order ; l.ZIndex = 12 ; l.Parent = parent
		return l
	end
	local function boxIn(parent, order, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0) ; f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_DARK ; f.BorderSizePixel = 0
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		corner(f, 10) ; stroke(f, color, 1.5) ; padding(f, IS_MOBILE and 8 or 10)
		local l = Instance.new("UIListLayout") ; l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder ; l.Parent = f
		return f
	end
	local function btn(parent, order, txt, color, fn, textColor)
		local c = Instance.new("Frame")
		c.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42) ; c.BackgroundTransparency = 1
		c.LayoutOrder = order ; c.ZIndex = 12 ; c.Parent = parent
		local b, l = actionButton(c, { color = color, strokeColor = color, text = txt,
			textColor = textColor or C.TEXT_WHITE, textSize = IS_MOBILE and 11 or 14, radius = 9, zIndex = 13 })
		b.MouseButton1Click:Connect(fn)
		return b, l
	end

	local function confirmClearAll()
		currentScreen = "feedback_clear"
		local back = function() screenFeedback(true) end
		local body = buildScreen("⚠️ CONFIRMATION", true, RED, back)
		local b = boxIn(body, 1, RED)
		lbl(b, 1, "🗑️ Supprimer TOUS les feedbacks", RED, IS_MOBILE and 14 or 17, true)
		lbl(b, 2, "Ce qui va se passer :", C.TEXT_WHITE, TM, true)
		lbl(b, 3, "• TOUS les feedbacks envoyés par les joueurs sont effacés définitivement, sur tous les serveurs.", C.TEXT_GREY, TS)
		lbl(b, 4, "• ⚠️ IRRÉVERSIBLE : impossible de les récupérer ensuite.", RED, TS, true)
		lbl(b, 5, "• Les feedbacks envoyés pendant la suppression sont gardés.", C.TEXT_GREY, TS)
		lbl(b, 6, "• Les quêtes « donner un feedback » des joueurs ne sont pas touchées.", C.TEXT_GREY, TS)

		local alsoFav = false
		local cbWrap = Instance.new("Frame")
		cbWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46) ; cbWrap.BackgroundTransparency = 1
		cbWrap.LayoutOrder = 7 ; cbWrap.ZIndex = 12 ; cbWrap.Parent = b
		local cb, cbl = actionButton(cbWrap, { color = C.BG_ITEM, strokeColor = RED, text = "",
			textColor = C.TEXT_WHITE, textSize = TS, radius = 8, zIndex = 13 })
		cbl.TextWrapped = true
		local function paint() cbl.Text = (alsoFav and "☑️  " or "⬜  ") .. "Vider aussi les ⭐ favoris (" .. #FAV.items .. ")" end
		paint()
		cb.MouseButton1Click:Connect(function() alsoFav = not alsoFav ; paint() end)

		lbl(b, 8, "Pour confirmer, tape SUPPRIMER ci-dessous :", C.TEXT_WHITE, TS, true)
		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40) ; wrap.BackgroundTransparency = 1
		wrap.LayoutOrder = 9 ; wrap.ZIndex = 12 ; wrap.Parent = b
		local box = Instance.new("TextBox")
		box.Size = UDim2.fromScale(1, 1) ; box.BackgroundColor3 = C.BG_ITEM ; box.BorderSizePixel = 0
		box.Font = FONT ; box.PlaceholderText = "SUPPRIMER" ; box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = "" ; box.TextColor3 = RED ; box.TextSize = TM ; box.ClearTextOnFocus = false
		box.ZIndex = 13 ; box.Parent = wrap
		corner(box, 8) ; stroke(box, RED, 1)

		local okBtn, okLbl = btn(body, 2, "⏳ Lis bien… (3)", C.BG_LIGHT, function() end)
		local armed, sent = false, false
		okBtn.MouseButton1Click:Connect(function()
			if not armed or sent then return end
			if box.Text:upper():gsub("%s", "") ~= "SUPPRIMER" then
				toast("Tape SUPPRIMER pour confirmer", false)
				return
			end
			sent = true
			okLbl.Text = "⏳ Suppression en cours…"
			task.spawn(function()
				local fn = ReplicatedStorage:FindFirstChild("AdminFeedbackClearAll")
				local res
				if fn then
					local ok, r = pcall(function() return fn:InvokeServer("SUPPRIMER") end)
					res = ok and r or nil
				end
				local msg = res and res.msg or "❌ Serveur pas à jour (FeedbackSystem_Server)"
				if alsoFav then
					local fav = ReplicatedStorage:FindFirstChild("AdminFavoriteAction")
					if fav then
						pcall(function() fav:InvokeServer("clearall", { confirm = "OUI" }) end)
						FAV.items, FAV.map = {}, {}
						msg = msg .. " · ⭐ favoris vidés"
					end
				end
				toast(msg, res and res.ok == true)
				fbState.entries, fbState.cursor, fbState.hasMore = {}, nil, false
				screenFeedback(true)
			end)
		end)
		task.spawn(function()
			for s = 3, 1, -1 do
				if not okLbl.Parent then return end
				okLbl.Text = "⏳ Lis bien… (" .. s .. ")"
				task.wait(1)
			end
			if okLbl.Parent then
				armed = true
				okBtn.BackgroundColor3 = RED
				okLbl.Text = "🗑️ Oui, supprimer TOUS les feedbacks"
			end
		end)
		btn(body, 3, "↩️ Annuler, ne rien supprimer", C.BG_LIGHT, back)
	end

	--  Le bouton, ajouté en bas de l'écran 💬 FEEDBACK (onglet « All feedback »)
	local original = screenFeedback
	screenFeedback = function(...)
		local r = table.pack(original(...))
		if currentScreen == "feedback" and fbState.tab ~= "fav" then
			local body
			for _, ch in ipairs(window:GetChildren()) do
				if ch:IsA("ScrollingFrame") then body = ch end
			end
			if body then
				local zone = boxIn(body, 100000, RED)
				lbl(zone, 1, "🗑️ ZONE DANGEREUSE", RED, TM, true)
				lbl(zone, 2, "Efface tous les feedbacks d'un coup (une page de confirmation s'ouvre d'abord).", C.TEXT_DIM, TS)
				btn(zone, 3, "🗑️ Supprimer TOUS les feedbacks", RED_D, confirmClearAll)
			end
		end
		return table.unpack(r, 1, r.n)
	end
	print("✅ Bloc 17 chargé — 🗑️ suppression de tous les feedbacks")
end)()


print("✅ ADMIN PANEL CLIENT chargé (Mobile: " .. tostring(IS_MOBILE) .. ")")]]></ProtectedString>
