local GroupId = 684717971

-- Cache gamepass
local gamePassCache = {}
local GAMEPASS_CACHE_DURATION = 300

-- 🌐 OPTIM RÉSEAU — ZÉRO registre local.
--    ⚠️ Ton script est à la limite des 200 locals de Lua. Tout ce qui suit
--       vit donc dans `_G`, comme tu le fais déjà pour _G.suppressPointsAnim.
--       Une table `_G.x = {}` et une `function _G.x.y()` ne consomment
--       AUCUN registre.
_G.ACOptim = {
	--  Statut (groupe + Premium) mis en cache 5 minutes.
	--  Avant, `IsInGroup` était appelé chaque seconde pour chaque joueur,
	--  alors que l'appartenance au groupe ne change pas en cours de partie.
	status     = {},    -- [userId] = { bonus = n, at = os.time() }
	STATUS_TTL = 300,   -- secondes

	--  Lissage de l'attribut `Points` (servira si tu fais l'ÉDIT 5 plus tard).
	attrAt     = {},    -- [userId] = os.clock() de la dernière synchro
	ATTR_SYNC  = 2,     -- secondes entre deux synchros « douces »
	ATTR_DELTA = 250,   -- écart de points qui force une synchro immédiate
}

function _G.ACOptim.getStatusBonus(player)
	local uid = player.UserId
	local c = _G.ACOptim.status[uid]
	if c and (os.time() - c.at) < _G.ACOptim.STATUS_TTL then
		return c.bonus
	end

	local bonus = 0
	local okGroup, inGroup = pcall(function()
		return player:IsInGroup(GroupId)
	end)
	if okGroup and inGroup then bonus = bonus + 0.10 end
	if player.MembershipType == Enum.MembershipType.Premium then
		bonus = bonus + 0.10
	end

	--  On ne met en cache QUE si l'appel groupe a réussi. Sinon on figerait
	--  un faux 0 pendant 5 minutes pour un vrai membre du groupe : il
	--  perdrait son bonus sans raison.
	if okGroup then
		_G.ACOptim.status[uid] = { bonus = bonus, at = os.time() }
	end
	return bonus
end
