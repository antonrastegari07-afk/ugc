--==============================================================================
-- ANIMATEUR CENTRAL
--   Une seule connexion Heartbeat pour tout le jeu. Chaque animation est une
--   fonction pure du temps → pas de tween à annuler, pas de thread qui fuit.
--   Une entrée dont l'objet n'a plus de Parent est retirée automatiquement.
--==============================================================================
local anims   = {}
local animConn = nil

local function registerAnim(obj, state, fn)
	table.insert(anims, { obj = obj, state = state, fn = fn })
	if not animConn then
		animConn = RunService.Heartbeat:Connect(function()
			local t = os.clock()
			for i = #anims, 1, -1 do
				local a = anims[i]
				if not a.obj or not a.obj.Parent then
					table.remove(anims, i)
				else
					a.fn(t, a.state, a.obj)
				end
			end
		end)
	end
end

--==============================================================================
-- LISTE VIP (partagée par tous les leaderboards)
--==============================================================================
local vipList = {}

--==============================================================================
--  ⏱️ ÉPOQUE — qui gagne entre une lecture complète et un delta
--
--     `fetchVip` demande la liste au serveur et attend la réponse. Pendant
--     cette attente, un delta peut arriver et modifier `vipList`. La réponse,
--     elle, décrit l'état d'AVANT : l'écraser avec, c'est ressusciter un VIP
--     qui vient d'être retiré.
--
--     Tant que le serveur renvoyait la liste entière à chaque changement, ça
--     se réparait tout seul quelques secondes plus tard. Avec les deltas, le
--     serveur n'annonce QUE les changements : un joueur écrasé par une
--     réponse périmée ne serait plus jamais mentionné, et l'erreur resterait
--     jusqu'à la fin de la session.
--
--     Ce compteur tranche : si l'époque a bougé pendant la requête, un delta
--     plus récent est passé, et c'est lui qui a raison.
--     (DonationClient rappelle Core.refreshVip toutes les 5 s tant que le
--      panneau des dons est ouvert — la fenêtre de course est permanente.)
--==============================================================================
local vipEpoch = 0

local function fetchVip()
	local f = ReplicatedStorage:FindFirstChild("GetVIPList")
	if not f then return false end
	local mark = vipEpoch
	local ok, res = pcall(function() return f:InvokeServer() end)
	if ok and typeof(res) == "table" then
		--  Un delta est passé pendant la requête → sa version est plus jeune.
		if vipEpoch ~= mark then return true end
		vipList = res
		return true
	end
	return false
end

--  🔁 La première lecture n'est plus « une chance et tant pis ». Elle est la
--     SEULE source de l'état initial : si elle échoue (remote pas encore
--     répliqué, hoquet réseau), plus aucun badge ne s'affiche de toute la
--     session, puisque les deltas ne décrivent que les changements.
task.spawn(function()
	ReplicatedStorage:WaitForChild("GetVIPList", 20)
	for attempt = 1, 5 do
		if fetchVip() then return end
		task.wait(3 * attempt)
	end
	warn("⚠️ [Leaderboard] Liste VIP introuvable après 5 tentatives — "
		.. "les couronnes n'apparaîtront qu'aux prochains changements.")
end)

function Core.refreshVip() Core.registerAnim = registerAnim return fetchVip() end
function Core.isVip(userId) return vipList[tostring(userId)] ~= nil end


-- 🖱️ Ouvre la fiche profil (PlayerProfileHover expose _G.OpenPlayerProfile)
function Core.openProfile(userId, data)
	local info = {}
	for k, v in pairs(knownStats[userId] or {}) do info[k] = v end
	if type(data) == "table" then
		for k, v in pairs(data) do
			if info[k] == nil then info[k] = v end
		end
	end
	info.vip = Core.isVip(userId)
	if type(_G.OpenPlayerProfile) == "function" then
		_G.OpenPlayerProfile(userId, info)
	else
		warn("[Leaderboard] _G.OpenPlayerProfile introuvable → mets à jour PlayerProfileHover")
	end
end

-- Toutes les ListView vivantes, pour les repeindre quand la liste VIP change.
-- (le registre se nettoie tout seul : une vue dont le scroll est détruit sort)
local liveViews = {}

-- 👑 Le serveur diffuse la liste dès qu'un admin ajoute ou retire un VIP.
-- Le badge apparaît/disparaît à la seconde, sans attendre le cycle de refresh.
--==============================================================================
--  📉 PROTOCOLE DELTA  (doit rester en phase avec VIPManager.server.lua)
--
--     Le serveur envoyait la liste VIP COMPLÈTE du jeu à chaque changement.
--     Avec un millier de VIP enregistrés, ça faisait ~17 Ko par envoi et par
--     joueur — et les filets de synchronisation multi-serveurs ont multiplié
--     la fréquence de ces envois. C'était la cause du passage de 5 à 20 KB/s.
--
--     Deux formes possibles maintenant :
--        { d = { ["123"] = true, ["456"] = false } }  → à FUSIONNER
--        { full = { ["123"] = true, … } }             → remplace tout
--
--     `false` dans un delta veut dire « retiré » : on met la clé à nil.
--
--     ⚠️ L'ancienne forme (une table nue de userId → true) est encore acceptée
--        et traitée comme un `full`. Ça évite un écran sans badges si le
--        serveur et le client sont mis à jour à quelques minutes d'écart.
--==============================================================================
task.spawn(function()
	local ev = ReplicatedStorage:WaitForChild("VIPListUpdate", 25)
	if not ev then return end

	--  🔁 Un repaint ne coûte pas rien : il refait chaque ligne de chaque vue
	--     ouverte. Un lot de changements arrivant coup sur coup ne doit
	--     provoquer qu'UN repaint, à la fin.
	local repaintQueued = false
	local function repaint()
		if repaintQueued then return end
		repaintQueued = true
		task.defer(function()
			repaintQueued = false
			for i = #liveViews, 1, -1 do
				local v = liveViews[i]
				if not (v.scroll and v.scroll.Parent) then
					table.remove(liveViews, i)
				elseif v.lastList then
					v:render(v.lastList)
				end
			end
		end)
	end

	ev.OnClientEvent:Connect(function(msg)
		if typeof(msg) ~= "table" then return end

		if typeof(msg.d) == "table" then
			local touched = false
			for key, isVip in pairs(msg.d) do
				local want = (isVip == true) and true or nil
				if vipList[key] ~= want then
					vipList[key] = want
					touched = true
				end
			end
			--  L'époque avance même si rien n'a changé pour NOUS : ce qui
			--  compte, c'est qu'un message plus récent que toute requête en
			--  vol soit arrivé.
			vipEpoch = vipEpoch + 1
			--  Aucun changement réel → aucun repaint. Un delta redondant
			--  (deux serveurs annoncent la même chose) ne coûte rien.
			if touched then repaint() end
			return
		end

		local full = (typeof(msg.full) == "table") and msg.full or msg
		vipList  = full
		vipEpoch = vipEpoch + 1
		repaint()
	end)
end)

--==============================================================================
-- HELPERS
--==============================================================================
local function rankColor(cfg, rank)
	local p = cfg.palette
	if rank <= 3 then
		return (p.rank and p.rank[rank]) or DEFAULT_RANK_COLORS[rank]
	elseif rank <= 10 then return p.purple or Color3.fromRGB(180, 100, 255)
	elseif rank <= 25 then return p.blue   or Color3.fromRGB(80, 160, 255)
	elseif rank <= 50 then return p.green  or Color3.fromRGB(80, 220, 120)
	end
	return p.muted or Color3.fromRGB(140, 140, 150)
end

-- ⚠️ Un UIGradient MULTIPLIE la BackgroundColor3. Avec un fond noir il n'a
-- aucun effet (c'est pourquoi les dégradés top-3 de l'ancien code étaient
-- invisibles). On met donc le fond en blanc et c'est le dégradé qui donne
-- la vraie couleur.
local function bgSequence(cfg, rank, isVip)
	local p = cfg.palette
	if isVip then
		-- A1 : noir à gauche → doré sombre à droite
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(12, 9, 3)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(24, 18, 5)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(78, 57, 12)),
		})
	end
	if rank <= 3 and p.top3A and p.top3B then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, p.top3A),
			ColorSequenceKeypoint.new(1, p.top3B),
		})
	end
	local e = p.entry or Color3.fromRGB(8, 8, 10)
	return ColorSequence.new(e)
end

local function thumbUrl(userId)
	return string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", userId)
end

local function fmtDefault(n) return tostring(n) end

--==============================================================================
-- ANIMATIONS (fonctions du temps)
--==============================================================================

-- B1 — reflet qui balaye le badge VIP
local function shimmerStep(t, s, grad)
	if not s.on then return end
	local sweep = s.sweep or SHIMMER_SWEEP
	local c = (t + s.phase) % SHIMMER_PERIOD
	if c < sweep then
		grad.Offset = Vector2.new(-1 + (c / sweep) * 2, 0)
	else
		grad.Offset = Vector2.new(1, 0)   -- garé hors champ entre deux passages
	end
end

-- B7 / B8 — halo pulsant
local function glowStep(t, s, holder)
	local preset = s.preset
	if not preset then
		if s.lit then
			for _, g in ipairs(s.layers) do g.BackgroundTransparency = 1 end
			s.lit = false
		end
		return
	end
	s.lit = true
	local k = 0.5 + 0.5 * math.sin((t + s.phase) * preset.speed)
	for i, g in ipairs(s.layers) do
		g.BackgroundColor3      = s.color
		g.BackgroundTransparency = preset.base[i] - preset.amp[i] * k
	end
end

-- B9 — sparkles qui montent le long du badge VIP
local function sparkleStep(t, s, holder)
	if not s.on then
		if s.lit then
			for _, p in ipairs(s.parts) do p.BackgroundTransparency = 1 end
			s.lit = false
		end
		return
	end
	s.lit = true
	local n = #s.parts
	for i, p in ipairs(s.parts) do
		local f = ((t * 0.5) + s.phase + (i - 1) / n) % 1
		p.Position               = UDim2.new(s.bx[i], 0, 0.95 - f * 0.8, 0)
		p.BackgroundTransparency = 0.1 + 0.9 * (f ^ 1.5)
	end
end

--==============================================================================
-- CONSTRUCTION D'UNE ENTRY
--   Structure :
--     Entry (holder, transparent, géré par l'UIListLayout)
--       ├─ Glow1..3   (halos, ZIndex 0 → derrière)
--       └─ Body       (tout le visuel, ZIndex 2 → animable en slide)
--   Le holder reste immobile pour le layout, seul le Body bouge (B4).
--==============================================================================
local function buildEntry(cfg, parent, index)
	local H     = cfg.entryHeight
	local avS   = math.floor(H * 0.62)
	local badgeH = math.floor(H * 0.44)
	local badgeW = math.floor(badgeH * 2.1)
	local iconH = math.floor(H * 0.72)
	local iconW = math.floor(iconH * VIP_ICON_RATIO)
	local E     = { cfg = cfg }

	local holder = Instance.new("Frame")
	holder.Name                   = "Entry"
	holder.Size                   = UDim2.new(1, 0, 0, H)
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel        = 0
	holder.ClipsDescendants       = false
	holder.LayoutOrder            = index
	holder.ZIndex                 = 1
	holder.Parent                 = parent
	E.holder = holder

	------------------------------------------------------------------
	-- B8 — halo autour de TOUTE l'entry, réservé au joueur local
	--      3 couches concentriques, aucun asset externe
	------------------------------------------------------------------
	local layers = {}
	for i = 1, 3 do
		local pad = i * 5
		local g = Instance.new("Frame")
		g.Name                   = "Glow" .. i
		g.AnchorPoint            = Vector2.new(0.5, 0.5)
		g.Position               = UDim2.fromScale(0.5, 0.5)
		g.Size                   = UDim2.new(1, pad * 2, 1, pad * 2)
		g.BackgroundColor3       = Color3.new(1, 1, 1)
		g.BackgroundTransparency = 1
		g.BorderSizePixel        = 0
		g.ZIndex                 = 0
		g.Parent                 = holder
		Instance.new("UICorner", g).CornerRadius = UDim.new(0, 8 + pad)
		layers[i] = g
	end
	E.glowState = { layers = layers, preset = nil, color = SELF_BLUE, phase = math.random() * 6, lit = false }
	registerAnim(holder, E.glowState, glowStep)

	------------------------------------------------------------------
	-- BODY
	------------------------------------------------------------------
	local body = Instance.new("Frame")
	body.Name             = "Body"
	body.Size             = UDim2.new(1, 0, 1, 0)
	body.BackgroundColor3 = Color3.new(1, 1, 1)   -- cf. bgSequence()
	body.BorderSizePixel  = 0
	body.ZIndex           = 2
	body.Parent           = holder
	E.body = body
	Instance.new("UICorner", body).CornerRadius = UDim.new(0, 8)

	local bg = Instance.new("UIGradient")
	bg.Name   = "BgGradient"
	bg.Parent = body
	E.bg = bg

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1
	stroke.Parent    = body
	E.stroke = stroke

	-- barre de rang
	local bar = Instance.new("Frame")
	bar.Name            = "RankBar"
	bar.Size            = UDim2.new(0, 4, 1, 0)
	bar.BorderSizePixel = 0
	bar.ZIndex          = 3
	bar.Parent          = body
	Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 8)
	E.bar = bar

	-- #rang
	local rankLbl = Instance.new("TextLabel")
	rankLbl.Name                   = "Rank"
	rankLbl.Size                   = UDim2.new(0.10, 0, 1, 0)
	rankLbl.Position               = UDim2.new(0.005, 0, 0, 0)
	rankLbl.BackgroundTransparency = 1
	rankLbl.TextScaled             = true
	rankLbl.Font                   = Enum.Font.FredokaOne
	rankLbl.TextXAlignment         = Enum.TextXAlignment.Center
	rankLbl.ZIndex                 = 3
	rankLbl.Parent                 = body
	local rankConstraint = Instance.new("UITextSizeConstraint", rankLbl)
	rankConstraint.MinTextSize = 8
	rankConstraint.MaxTextSize = math.floor(H * 0.26)
	E.rankLbl        = rankLbl
	E.rankConstraint = rankConstraint
	E.rankBaseSize   = H * 0.26

	-- avatar
	local avatar = Instance.new("ImageLabel")
	avatar.Name                   = "Avatar"
	avatar.Size                   = UDim2.new(0, avS, 0, avS)
	avatar.Position               = UDim2.new(0.11, 0, 0.5, -avS / 2)
	avatar.BackgroundColor3       = cfg.palette.panel or Color3.fromRGB(30, 30, 35)
	avatar.BorderSizePixel        = 0
	avatar.ZIndex                 = 5
	avatar.Parent                 = body
	Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)
	E.avatar = avatar

	local avStroke = Instance.new("UIStroke")
	avStroke.Thickness    = 2
	avStroke.Transparency = 1
	avStroke.Parent       = avatar
	E.avStroke = avStroke

	-- A3 : dégradé doré sur l'anneau, activé seulement pour les VIP
	local avGrad = Instance.new("UIGradient")
	avGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.0, GOLD_SOFT),
		ColorSequenceKeypoint.new(0.5, GOLD_DEEP),
		ColorSequenceKeypoint.new(1.0, GOLD_SOFT),
	})
	avGrad.Rotation = 45
	avGrad.Enabled  = false
	avGrad.Parent   = avStroke
	E.avGrad = avGrad

	-- A4 : UN SEUL label de nom (fini le doublon + le container inutile)
	local nameLbl = Instance.new("TextLabel")
	nameLbl.Name                   = "PlayerName"
	nameLbl.Position               = UDim2.new(0.24, 0, 0.06, 0)
	nameLbl.Size                   = UDim2.new(0.76, -10, 0.40, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.TextScaled             = true
	nameLbl.Font                   = Enum.Font.FredokaOne
	nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
	nameLbl.TextTruncate           = Enum.TextTruncate.AtEnd
	nameLbl.ZIndex                 = 3
	nameLbl.Parent                 = body
	local nc = Instance.new("UITextSizeConstraint", nameLbl)
	nc.MaxTextSize = math.floor(H * 0.24); nc.MinTextSize = 7
	E.nameLbl = nameLbl
	E.nameFullW = UDim2.new(0.76, -10, 0.40, 0)
	E.nameVipW  = UDim2.new(0.76, -(badgeW + iconW + 30), 0.40, 0)

	-- valeur (icône optionnelle + nombre)
	local valBox = Instance.new("Frame")
	valBox.Name                   = "Value"
	valBox.Position               = UDim2.new(0.24, 0, 0.52, 0)
	valBox.Size                   = UDim2.new(0.60, 0, 0.42, 0)
	valBox.BackgroundTransparency = 1
	valBox.ZIndex                 = 5
	valBox.Parent                 = body
	local vLayout = Instance.new("UIListLayout")
	vLayout.FillDirection     = Enum.FillDirection.Horizontal
	vLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	vLayout.SortOrder         = Enum.SortOrder.LayoutOrder
	vLayout.Padding           = UDim.new(0, 5)
	vLayout.Parent            = valBox

	local valIcon = Instance.new("ImageLabel")
	valIcon.Name                   = "Icon"
	valIcon.LayoutOrder            = 1
	valIcon.Size                   = UDim2.new(0, math.floor(H * 0.32), 0, math.floor(H * 0.32))
	valIcon.BackgroundTransparency = 1
	valIcon.ScaleType              = Enum.ScaleType.Fit
	valIcon.Visible                = false
	valIcon.ZIndex                 = 5
	valIcon.Parent                 = valBox
	if cfg.valueIcon then
		valIcon.Image   = cfg.valueIcon
		valIcon.Visible = true
		if cfg.valueIconColor then valIcon.ImageColor3 = cfg.valueIconColor end
	end
	E.valIcon = valIcon

	local valLbl = Instance.new("TextLabel")
	valLbl.Name                   = "Amount"
	valLbl.LayoutOrder            = 2
	valLbl.AutomaticSize          = Enum.AutomaticSize.X
	valLbl.Size                   = UDim2.new(0, 0, 1, 0)
	valLbl.BackgroundTransparency = 1
	valLbl.TextSize               = cfg.valueTextSize or math.floor(H * 0.30)
	valLbl.Font                   = Enum.Font.FredokaOne
	valLbl.TextXAlignment         = Enum.TextXAlignment.Left
	valLbl.TextColor3             = cfg.valueColor or cfg.palette.accent1 or Color3.new(1, 1, 1)
	valLbl.ZIndex                 = 5
	valLbl.Parent                 = valBox
	E.valLbl = valLbl

	------------------------------------------------------------------
	-- BLOC VIP  (créé une fois, simplement masqué quand non-VIP)
	-- A5 : ancré à DROITE par AnchorPoint → aligné quel que soit le board
	------------------------------------------------------------------
	local vipIcon = Instance.new("ImageLabel")
	vipIcon.Name                   = "VipIcon"
	vipIcon.AnchorPoint            = Vector2.new(1, 0.5)
	vipIcon.Size                   = UDim2.new(0, iconW, 0, iconH)
	vipIcon.Position               = UDim2.new(1, -(badgeW + 18), 0.5, 0)
	vipIcon.BackgroundTransparency = 1
	vipIcon.Image                  = VIP_ICON
	vipIcon.ImageColor3            = Color3.new(1, 1, 1)  -- neutre : couleurs d'origine
	vipIcon.ScaleType              = Enum.ScaleType.Fit
	vipIcon.Visible                = false
	vipIcon.ZIndex                 = 12          -- AU-DESSUS du reflet d'entry (4)
	vipIcon.Parent                 = body
	-- 🔒 verrouille le ratio réel de l'image : plus aucun écrasement.
	local vipRatio = Instance.new("UIAspectRatioConstraint")
	vipRatio.AspectRatio  = VIP_ICON_RATIO
	vipRatio.DominantAxis = Enum.DominantAxis.Height
	vipRatio.Parent       = vipIcon
	E.vipIcon = vipIcon

	-- ❌ AUCUN dégradé sur l'icône : l'image garde ses propres couleurs.

	local badge = Instance.new("TextLabel")
	badge.Name             = "VipBadge"
	badge.AnchorPoint      = Vector2.new(1, 0.5)
	badge.Size             = UDim2.new(0, badgeW, 0, badgeH)
	badge.Position         = UDim2.new(1, -12, 0.5, 0)
	badge.BackgroundColor3 = Color3.new(1, 1, 1)   -- le dégradé fait la couleur
	badge.BorderSizePixel  = 0
	badge.Text             = "VIP"
	badge.TextColor3       = Color3.fromRGB(28, 18, 0)
	badge.TextSize         = math.floor(badgeH * 0.58)
	badge.Font             = Enum.Font.FredokaOne
	badge.TextXAlignment   = Enum.TextXAlignment.Center
	badge.Visible          = false
	badge.ZIndex           = 12         -- AU-DESSUS du reflet d'entry (4)
	badge.Parent           = body
	Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)
	E.badge = badge

	-- 🟡 LA PLAQUE DORÉE : dégradé diagonal fixe, comme dans ton code d'origine
	local plate = Instance.new("UIGradient")
	plate.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 240, 100)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(220, 160, 20)),
		ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 220, 80)),
	})
	plate.Rotation = 45
	plate.Parent   = badge

	-- B1 : le shimmer est un calque SÉPARÉ posé sur la plaque.
	-- (une instance ne peut porter qu'UN seul UIGradient : plaque + reflet
	--  ne pouvaient donc pas cohabiter sur le badge lui-même)
	local badgeShine = Instance.new("Frame")
	badgeShine.Name                   = "Shine"
	badgeShine.Size                   = UDim2.new(1, 0, 1, 0)
	badgeShine.BackgroundColor3       = Color3.fromRGB(255, 252, 235)
	badgeShine.BackgroundTransparency = 0
	badgeShine.BorderSizePixel        = 0
	badgeShine.ZIndex                 = 13
	badgeShine.Parent                 = badge
	Instance.new("UICorner", badgeShine).CornerRadius = UDim.new(1, 0)

	local shim = Instance.new("UIGradient")
	shim.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0.00, 1),
		NumberSequenceKeypoint.new(0.22, 1),
		NumberSequenceKeypoint.new(0.38, 0.88),
		NumberSequenceKeypoint.new(0.50, 0.62),
		NumberSequenceKeypoint.new(0.62, 0.88),
		NumberSequenceKeypoint.new(0.78, 1),
		NumberSequenceKeypoint.new(1.00, 1),
	})
	shim.Rotation = 14
	shim.Offset   = Vector2.new(1, 0)
	shim.Parent   = badgeShine

	-- ⏱️ DEUX états distincts, décalés d'une demi-période : le reflet du badge
	--    et celui de l'entry ne passent JAMAIS en même temps.
	E.shimState  = { on = false, phase = math.random() * SHIMMER_PERIOD,
		sweep = SHIMMER_SWEEP }
	E.badgeShim  = { on = false, sweep = BADGE_SWEEP,
		phase = (E.shimState.phase + BADGE_OFFSET) % SHIMMER_PERIOD }
	registerAnim(shim, E.badgeShim, shimmerStep)

	------------------------------------------------------------------
	-- B1 (étendu) — le même reflet balaye TOUTE l'entry
	--   Un calque quasi invisible posé sur le body : son dégradé est
	--   opaque partout SAUF une bande claire, et c'est cette bande qui
	--   se déplace. ZIndex 4 → passe au-dessus du nom et du score, en
	--   dessous du badge VIP (qui a déjà son propre reflet).
	--   Même table d'état que le badge → les deux reflets sont synchro.
	------------------------------------------------------------------
	local sheen = Instance.new("Frame")
	sheen.Name                   = "Sheen"
	sheen.Size                   = UDim2.new(1, 0, 1, 0)
	sheen.BackgroundColor3       = Color3.fromRGB(255, 246, 214)
	sheen.BackgroundTransparency = 0     -- c'est le dégradé qui gère l'opacité
	sheen.BorderSizePixel        = 0
	sheen.Visible                = false
	sheen.ZIndex                 = 4
	sheen.Parent                 = body
	Instance.new("UICorner", sheen).CornerRadius = UDim.new(0, 8)
	E.sheen = sheen

	local sheenGrad = Instance.new("UIGradient")
	sheenGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0.00, 1),
		NumberSequenceKeypoint.new(0.12, 1),
		NumberSequenceKeypoint.new(0.28, 0.94),
		NumberSequenceKeypoint.new(0.42, 0.86),
		NumberSequenceKeypoint.new(0.50, 0.82),   -- coeur de la bande, large
		NumberSequenceKeypoint.new(0.58, 0.86),
		NumberSequenceKeypoint.new(0.72, 0.94),
		NumberSequenceKeypoint.new(0.88, 1),
		NumberSequenceKeypoint.new(1.00, 1),
	})
	sheenGrad.Rotation = 14              -- légère inclinaison, plus naturel
	sheenGrad.Offset   = Vector2.new(1, 0)
	sheenGrad.Parent   = sheen
	registerAnim(sheenGrad, E.shimState, shimmerStep)

	local badgeStroke = Instance.new("UIStroke")
	badgeStroke.Color        = GOLD_SOFT
	badgeStroke.Thickness    = 1.5
	badgeStroke.Transparency = 0.1
	badgeStroke.Parent       = badge

	-- B9 : sparkles
	local spBox = Instance.new("Frame")
	spBox.Name                   = "Sparkles"
	spBox.AnchorPoint            = Vector2.new(1, 0.5)
	spBox.Size                   = UDim2.new(0, badgeW + iconW + 16, 1, 0)
	spBox.Position               = UDim2.new(1, -8, 0.5, 0)
	spBox.BackgroundTransparency = 1
	spBox.ClipsDescendants       = false
	spBox.Visible                = false
	spBox.ZIndex                 = 15
	spBox.Parent                 = body
	E.spBox = spBox

	local parts, bx = {}, { 0.22, 0.55, 0.82 }
	for i = 1, 3 do
		local p = Instance.new("Frame")
		p.Name                   = "Spark" .. i
		p.AnchorPoint            = Vector2.new(0.5, 1)
		p.Size                   = UDim2.new(0, 3, 0, 3)
		p.BackgroundColor3       = GOLD_SOFT
		p.BackgroundTransparency = 1
		p.BorderSizePixel        = 0
		p.ZIndex                 = 15
		p.Parent                 = spBox
		Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
		parts[i] = p
	end
	E.sparkState = { on = false, parts = parts, bx = bx, phase = math.random(), lit = false }
	registerAnim(spBox, E.sparkState, sparkleStep)

	------------------------------------------------------------------
	-- 🖱️ SURVOL + CLIC → fiche profil
	------------------------------------------------------------------
	if INTERACTIVE then
		local hintH = math.floor(H * 0.26)
		local hint = Instance.new("Frame")
		hint.Name                   = "ProfileHint"
		hint.AnchorPoint            = Vector2.new(0, 0.5)
		hint.AutomaticSize          = Enum.AutomaticSize.X
		hint.Size                   = UDim2.new(0, 0, 0, hintH)
		hint.BackgroundColor3       = Color3.fromRGB(22, 30, 44)
		hint.BackgroundTransparency = 1
		hint.BorderSizePixel        = 0
		hint.Visible                = false
		hint.ZIndex                 = 16
		hint.Parent                 = body
		Instance.new("UICorner", hint).CornerRadius = UDim.new(1, 0)
		local hStroke = Instance.new("UIStroke")
		hStroke.Color        = SELF_BLUE
		hStroke.Transparency = 1
		hStroke.Parent       = hint
		local hPad = Instance.new("UIPadding")
		hPad.PaddingLeft  = UDim.new(0, math.floor(hintH * 0.35))
		hPad.PaddingRight = UDim.new(0, math.floor(hintH * 0.45))
		hPad.Parent       = hint
		local hList = Instance.new("UIListLayout")
		hList.FillDirection     = Enum.FillDirection.Horizontal
		hList.VerticalAlignment = Enum.VerticalAlignment.Center
		hList.SortOrder         = Enum.SortOrder.LayoutOrder
		hList.Padding           = UDim.new(0, math.floor(hintH * 0.2))
		hList.Parent            = hint

		local hIcon = Instance.new("ImageLabel")
		hIcon.LayoutOrder            = 1
		hIcon.Size                   = UDim2.new(0, math.floor(hintH * 0.8), 0, math.floor(hintH * 0.8))
		hIcon.BackgroundTransparency = 1
		hIcon.Image                  = PROFILE_ICON
		hIcon.ScaleType              = Enum.ScaleType.Fit
		hIcon.ImageTransparency      = 1
		hIcon.ZIndex                 = 17
		hIcon.Parent                 = hint

		local hText = Instance.new("TextLabel")
		hText.LayoutOrder            = 2
		hText.AutomaticSize          = Enum.AutomaticSize.X
		hText.Size                   = UDim2.new(0, 0, 1, 0)
		hText.BackgroundTransparency = 1
		hText.Text                   = "View Profile"
		hText.Font                   = Enum.Font.FredokaOne
		hText.TextSize               = math.floor(hintH * 0.62)
		hText.TextColor3             = Color3.new(1, 1, 1)
		hText.TextTransparency       = 1
		hText.ZIndex                 = 17
		hText.Parent                 = hint

		-- Zone de clic invisible, par-dessus tout le reste de l'entry
		local hit = Instance.new("TextButton")
		hit.Name                   = "Hit"
		hit.Size                   = UDim2.new(1, 0, 1, 0)
		hit.BackgroundTransparency = 1
		hit.Text                   = ""
		hit.AutoButtonColor        = false
		hit.Selectable             = false
		hit.ZIndex                 = 30
		hit.Parent                 = body

		-- Collé juste après le nom (largeur RÉELLE du texte), sans mordre
		-- sur le badge VIP à droite.
		local function placeHint()
			local nb   = nameLbl.TextBounds.X
			local x    = nameLbl.AbsolutePosition.X - body.AbsolutePosition.X + nb + math.floor(H * 0.1)
			local y    = nameLbl.AbsolutePosition.Y - body.AbsolutePosition.Y + nameLbl.AbsoluteSize.Y / 2
			local right = E.badge.Visible and (badgeW + iconW + 30) or 12
			local maxX = body.AbsoluteSize.X - right - hint.AbsoluteSize.X
			hint.Position = UDim2.fromOffset(math.max(0, math.min(x, maxX)), y)
		end

		local avBig = math.floor(avS * 1.12)
		function E.setHover(on)
			if E.hovered == on then return end
			E.hovered = on
			if on then
				if hoveredEntry and hoveredEntry ~= E and hoveredEntry.setHover then
					hoveredEntry.setHover(false)
				end
				hoveredEntry = E
			elseif hoveredEntry == E then
				hoveredEntry = nil
			end

			if HOVER_GROW_ENABLED then
				local h = on and math.floor(H * HOVER_GROW) or H
				TweenService:Create(holder, HOVER_INFO, { Size = UDim2.new(1, 0, 0, h) }):Play()
				local a = on and avBig or avS
				TweenService:Create(avatar, HOVER_INFO, {
					Size = UDim2.new(0, a, 0, a), Position = UDim2.new(0.11, 0, 0.5, -a / 2),
				}):Play()
			end

			if on then
				hint.Visible = true
				placeHint()
				task.defer(placeHint)   -- une fois la nouvelle hauteur appliquée
			end
			local tr = on and 0 or 1
			TweenService:Create(hint,    HOVER_INFO, { BackgroundTransparency = on and 0.15 or 1 }):Play()
			TweenService:Create(hStroke, HOVER_INFO, { Transparency = on and 0.35 or 1 }):Play()
			TweenService:Create(hIcon,   HOVER_INFO, { ImageTransparency = tr }):Play()
			local tw = TweenService:Create(hText, HOVER_INFO, { TextTransparency = tr })
			tw:Play()
			if not on then
				tw.Completed:Connect(function()
					if not E.hovered then hint.Visible = false end
				end)
			end
		end

		hit.MouseEnter:Connect(function() E.setHover(true) end)
		hit.MouseLeave:Connect(function() E.setHover(false) end)
		holder.Destroying:Connect(function()
			if hoveredEntry == E then hoveredEntry = nil end
		end)
		nameLbl:GetPropertyChangedSignal("TextBounds"):Connect(function()
			if E.hovered then placeHint() end
		end)

		hit.Activated:Connect(function()
			local uid = E.avatarId
			if uid then Core.openProfile(uid, E.data) end
		end)
	end

	-- 🏆 style moderne : police BuilderSans (comme les Paramètres / CombatHUD).
	--    Fait UNE fois à la création : les entries sont ensuite réutilisées.
	if cfg._modern then
		for _, d in ipairs(holder:GetDescendants()) do
			if d:IsA("TextLabel") then
				d.FontFace = (d == E.rankLbl or d == E.valLbl) and MF.Heavy or MF.Bold
			end
		end
		for _, c in ipairs(body:GetChildren()) do
			if c:IsA("UICorner") then c.CornerRadius = UDim.new(0, 12) end
		end
	end

	return E
end

--==============================================================================
-- APPLIQUER LES DONNÉES À UNE ENTRY (réutilisation → zéro flash au refresh)
--==============================================================================
local function applyEntry(E, rank, data)
	E.data = data
	local cfg    = E.cfg
	local userId = data.userId
	local isVip  = Core.isVip(userId)
	local isSelf = (LocalPlayer and userId == LocalPlayer.UserId)
	local rc     = rankColor(cfg, rank)

	E.holder.LayoutOrder = rank
	E.holder.Name        = "Entry_" .. rank

	E.bg.Color     = bgSequence(cfg, rank, isVip)
	E.bg.Rotation  = isVip and 0 or ((rank <= 3) and 90 or 0)

	E.bar.BackgroundColor3 = isVip and GOLD or rc

	E.rankLbl.Text       = "#" .. rank
	E.rankLbl.TextColor3 = isVip and GOLD or rc
	-- le #1 est le plus gros, puis ça redescend jusqu'à la taille normale
	E.rankConstraint.MaxTextSize =
		math.floor(E.rankBaseSize * (RANK_SIZE[rank] or 1))

	if E.avatarId ~= userId then
		E.avatarId    = userId
		E.avatar.Image = thumbUrl(userId)   -- C : rbxthumb, aucun yield
	end

	-- anneau de l'avatar : doré pour VIP (A3), couleur de rang pour le top 3
	if isVip then
		-- ⚠️ le UIGradient multiplie Color : il faut du blanc dessous
		E.avStroke.Color        = Color3.new(1, 1, 1)
		E.avStroke.Transparency = 0
		E.avStroke.Thickness    = 3
		E.avGrad.Enabled        = true
	elseif rank <= 3 then
		E.avGrad.Enabled        = false
		E.avStroke.Color        = rc
		E.avStroke.Thickness    = 2
		E.avStroke.Transparency = 0
	else
		E.avGrad.Enabled        = false
		E.avStroke.Transparency = 1
	end

	E.nameLbl.Text      = data.name or ("User " .. tostring(userId))
	E.nameLbl.TextColor3 = isVip and GOLD_NAME or (cfg.palette.white or Color3.new(1, 1, 1))
	E.nameLbl.Size      = isVip and E.nameVipW or E.nameFullW

	local raw = data[cfg.valueKey] or 0
	E.valLbl.Text = (cfg.formatValue or fmtDefault)(raw)
	-- 👥 ami HORS du top (onglet FRIENDS) : « -- » à la place du rang, rangé après le top
	if data.noRank then
		E.rankLbl.Text = "--"
		E.holder.LayoutOrder = 100000 + (tonumber(data._ord) or 0)
		if data.pending then E.valLbl.Text = "…" end
	end

	-- contour du body : doré pour les VIP, neutre pour tout le monde d'autre
	if isVip then
		E.stroke.Color        = GOLD
		E.stroke.Thickness    = 2.5
		E.stroke.Transparency = 0
	else
		E.stroke.Color        = cfg.palette.entryStroke or Color3.fromRGB(40, 40, 50)
		E.stroke.Thickness    = 1
		E.stroke.Transparency = 0.5
	end

	-- bloc VIP
	E.vipIcon.Visible   = isVip
	E.badge.Visible     = isVip
	E.sheen.Visible     = isVip
	E.shimState.on      = isVip
	E.badgeShim.on      = isVip
	-- B9 plafonné au top 10 pour ne pas animer 50 entries
	local sparkOn       = isVip and rank <= (cfg.sparkleMaxRank or SPARKLE_MAX_RANK)
	E.spBox.Visible     = sparkOn
	E.sparkState.on     = sparkOn

	-- B8 : halo bleu clair autour de l'entry, uniquement pour toi
	E.glowState.preset = isSelf and SELF_GLOW or nil
	E.glowState.color  = SELF_BLUE
end

--==============================================================================
-- B4 — APPARITION EN CASCADE
--==============================================================================
local INTRO_INFO = TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function playIntro(E, index)
	local body = E.body

	-- ⚠️ applyEntry() a déjà posé les valeurs finales : on les mémorise AVANT
	-- de tout remettre à zéro, sinon la cible du tween serait « invisible ».
	local strokeTarget = E.stroke.Transparency
	local sheenWasOn   = E.sheen.Visible
	E.sheen.Visible    = false            -- pas de reflet pendant le fade-in

	body.Position                = UDim2.new(-0.07, 0, 0, 0)
	body.BackgroundTransparency  = 1
	E.stroke.Transparency        = 1
	E.rankLbl.TextTransparency   = 1
	E.nameLbl.TextTransparency   = 1
	E.valLbl.TextTransparency    = 1
	E.avatar.ImageTransparency   = 1
	E.bar.BackgroundTransparency = 1

	local d = math.min((index - 1) * 0.035, 1.2)

	task.delay(d, function()
		if not body.Parent then return end
		TweenService:Create(body, INTRO_INFO, {
			Position = UDim2.new(0, 0, 0, 0),
			BackgroundTransparency = 0,
		}):Play()
		TweenService:Create(E.stroke,  INTRO_INFO, { Transparency = strokeTarget }):Play()
		TweenService:Create(E.rankLbl, INTRO_INFO, { TextTransparency = 0 }):Play()
		TweenService:Create(E.nameLbl, INTRO_INFO, { TextTransparency = 0 }):Play()
		TweenService:Create(E.valLbl,  INTRO_INFO, { TextTransparency = 0 }):Play()
		TweenService:Create(E.avatar,  INTRO_INFO, { ImageTransparency = 0 }):Play()
		TweenService:Create(E.bar,     INTRO_INFO, { BackgroundTransparency = 0 }):Play()
		task.delay(0.4, function()
			if body.Parent then E.sheen.Visible = sheenWasOn end
		end)
	end)
end

--==============================================================================
-- LIST VIEW  —  réutilise les frames existantes (C : plus de flash au refresh)
--==============================================================================
local ListView = {}
ListView.__index = ListView

function Core.newListView(scroll, cfg)
	cfg = cfg or {}
	cfg.palette     = cfg.palette or {}
	cfg.entryHeight = cfg.entryHeight or 68
	cfg.topSize     = cfg.topSize or 25
	cfg.valueKey    = cfg.valueKey or "value"

	local self = setmetatable({}, ListView)
	self.scroll   = scroll
	self.cfg      = cfg
	self.entries  = {}
	self.msg      = nil
	self.lastList = nil
	table.insert(liveViews, self)   -- pour le rafraîchissement VIP instantané
	return self
end

function ListView:_message(text)
	if not self.msg then
		local l = Instance.new("TextLabel")
		l.Name                   = "Message"
		l.Size                   = UDim2.new(1, 0, 0, 50)
		l.BackgroundTransparency = 1
		l.TextColor3             = self.cfg.palette.muted or Color3.fromRGB(140, 140, 150)
		l.TextScaled             = true
		l.Font                   = Enum.Font.Gotham
		l.LayoutOrder            = 9999
		l.Parent                 = self.scroll
		local c = Instance.new("UITextSizeConstraint", l)
		c.MaxTextSize = 20; c.MinTextSize = 10
		self.msg = l
	end
	self.msg.Text    = text or ""
	self.msg.Visible = (text ~= nil)
end

function ListView:showEmpty(text)
	for i = #self.entries, 1, -1 do
		self.entries[i].holder:Destroy()
		self.entries[i] = nil
	end
	self:_message(text or "No data yet...")
end

function ListView:render(list)
	if not self.scroll or not self.scroll.Parent then return end
	self.lastList = list
	local cfg = self.cfg
	local n   = math.min(#list, cfg.topSize + (tonumber(list.extra) or 0))   -- extra : ta ligne « -- » (FIND ME)

	if n == 0 then
		self:showEmpty(cfg.emptyText)
		return
	end
	self:_message(nil)

	for i = 1, n do
		local E = self.entries[i]
		-- vue filtrée (FRIENDS) : on garde la VRAIE place du joueur dans le classement
		local rank = (self.useDataRank and tonumber(list[i].rank)) or i
		if not E then
			E = buildEntry(cfg, self.scroll, i)
			self.entries[i] = E
			applyEntry(E, rank, list[i])
			playIntro(E, i)              -- B4 : seulement les nouvelles entries
		else
			applyEntry(E, rank, list[i]) -- refresh silencieux, aucun flash
		end
	end

	for i = #self.entries, n + 1, -1 do
		self.entries[i].holder:Destroy()
		self.entries[i] = nil
	end
end

function ListView:destroy()
	for i = #self.entries, 1, -1 do
		self.entries[i].holder:Destroy()
		self.entries[i] = nil
	end
	if self.msg then self.msg:Destroy(); self.msg = nil end
end

--==============================================================================
-- INDICATEUR DE CHARGEMENT
--==============================================================================
local function createLoader(parent, cfg)
	local frame = Instance.new("Frame")
	frame.Name                   = "LoadingIndicator"
	frame.Size                   = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.ZIndex                 = 50
	frame.Parent                 = parent

	local icon = Instance.new("TextLabel")
	icon.AnchorPoint            = Vector2.new(0.5, 0.5)
	icon.Size                   = UDim2.new(0, 60, 0, 60)
	icon.Position               = UDim2.new(0.5, 0, 0.35, 0)
	icon.BackgroundTransparency = 1
	icon.Text                   = cfg.loadingIcon or "★"
	icon.TextColor3             = cfg.palette.accent1 or Color3.new(1, 1, 1)
	icon.TextScaled             = true
	icon.Font                   = Enum.Font.FredokaOne
	icon.ZIndex                 = 51
	icon.Parent                 = frame

	local lbl = Instance.new("TextLabel")
	lbl.AnchorPoint            = Vector2.new(0.5, 0)
	lbl.Size                   = UDim2.new(0.8, 0, 0, 32)
	lbl.Position               = UDim2.new(0.5, 0, 0.55, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text                   = "LOADING..."
	lbl.TextColor3             = cfg.palette.accent2 or cfg.palette.accent1 or Color3.new(1, 1, 1)
	lbl.TextScaled             = true
	lbl.Font                   = Enum.Font.FredokaOne
	lbl.ZIndex                 = 51
	lbl.Parent                 = frame
	local lc = Instance.new("UITextSizeConstraint", lbl)
	lc.MaxTextSize = 24; lc.MinTextSize = 12

	-- animé par la boucle centrale : rien à annuler, rien qui fuit
	registerAnim(frame, { phase = 0 }, function(t, s, f)
		local k = math.sin(t * 3)
		icon.Position       = UDim2.new(0.5, 0, 0.35 - 0.045 * k, 0)
		lbl.TextTransparency = 0.25 + 0.25 * (0.5 + 0.5 * math.sin(t * 2))
	end)

	return frame
end

Core.createLoader = createLoader

--==============================================================================
-- UI D'UN BOARD (SurfaceGui)
--==============================================================================
local function buildBoardUI(cfg, sg)
	for _, c in ipairs(sg:GetChildren()) do c:Destroy() end
	local p = cfg.palette
	local reserve = cfg.bottomReserve or 0

	local main = Instance.new("Frame")
	main.Name             = "MainFrame"
	main.Size             = UDim2.new(1, 0, 1, 0)
	main.BackgroundColor3 = p.bg      -- rendu sombre d'origine (le dégradé multiplie)
	main.BorderSizePixel  = 0
	main.Parent           = sg

	local bgGrad = Instance.new("UIGradient")
	bgGrad.Color    = ColorSequence.new(p.bgA or p.bg, p.bgB or p.bg)
	bgGrad.Rotation = 135
	bgGrad.Parent   = main

	local header = Instance.new("Frame")
	header.Name             = "Header"
	header.Size             = UDim2.new(1, 0, 0.09, 0)
	header.BackgroundColor3 = p.headerMid or p.panel   -- sombre, comme avant
	header.BorderSizePixel  = 0
	header.Parent           = main

	local hGrad = Instance.new("UIGradient")
	hGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.0, p.headerEdge or p.panel),
		ColorSequenceKeypoint.new(0.5, p.headerMid  or p.panel),
		ColorSequenceKeypoint.new(1.0, p.headerEdge or p.panel),
	})
	hGrad.Parent = header

	local hStroke = Instance.new("UIStroke")
	hStroke.Color        = p.accent1
	hStroke.Thickness    = 3
	hStroke.Transparency = 0.2
	hStroke.Parent       = header

	local title = Instance.new("TextLabel")
	title.Size                   = UDim2.new(1, 0, 1, 0)
	title.BackgroundTransparency = 1
	title.Text                   = cfg.title
	title.TextColor3             = p.accent2 or p.accent1
	title.TextScaled             = true
	title.Font                   = Enum.Font.FredokaOne
	title.Parent                 = header
	local tc = Instance.new("UITextSizeConstraint", title)
	tc.MaxTextSize = 46; tc.MinTextSize = 20

	-- 👥 ALL / FRIENDS (à gauche) + 🔍 FIND ME discret (à droite), dans l'en-tête d'avant.
	--    Le titre reste centré : on lui laisse juste la place du milieu.
	local tabs = nil
	if TABS then
		title.AnchorPoint = Vector2.new(0.5, 0)
		title.Position    = UDim2.new(0.5, 0, 0, 0)
		title.Size        = UDim2.new(0.52, 0, 1, 0)
		local accent = p.accent1 or Color3.new(1, 1, 1)
		local dark   = p.panel or Color3.fromRGB(20, 20, 26)

		local seg = Instance.new("Frame")
		seg.Name = "Tabs"
		seg.AnchorPoint = Vector2.new(0, 0.5)
		seg.Position = UDim2.new(0.012, 0, 0.5, 0)
		seg.Size = UDim2.new(0.21, 0, 0.6, 0)
		seg.BackgroundColor3 = dark
		seg.BorderSizePixel = 0
		seg.Parent = header
		Instance.new("UICorner", seg).CornerRadius = UDim.new(1, 0)
		local ss = Instance.new("UIStroke") ; ss.Color = accent ; ss.Thickness = 2 ; ss.Transparency = 0.35 ; ss.Parent = seg
		local function half(text, x)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0.5, -4, 1, -8)
			b.Position = UDim2.new(x, x == 0 and 4 or 0, 0, 4)
			b.BackgroundColor3 = accent
			b.BackgroundTransparency = 1
			b.AutoButtonColor = false
			b.Text = text
			b.Font = Enum.Font.FredokaOne
			b.TextScaled = true
			b.TextColor3 = p.muted or Color3.fromRGB(170, 170, 180)
			b.Parent = seg
			Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
			local c = Instance.new("UITextSizeConstraint", b) ; c.MaxTextSize = 24 ; c.MinTextSize = 8
			local pd = Instance.new("UIPadding", b) ; pd.PaddingTop = UDim.new(0.14, 0) ; pd.PaddingBottom = UDim.new(0.14, 0)
			return b
		end
		local allB = half("ALL", 0)
		local frB  = half("FRIENDS", 0.5)

		-- 🔍 FIND ME : loupe ronde + « FIND ME » écrit en petit dessous (toute la zone est cliquable)
		local find = Instance.new("TextButton")
		find.Name = "FindMe"
		find.AnchorPoint = Vector2.new(1, 0.5)
		find.Position = UDim2.new(0.98, 0, 0.5, 0)
		find.Size = UDim2.new(0.1, 0, 0.96, 0)
		find.BackgroundTransparency = 1
		find.AutoButtonColor = false
		find.Text = ""
		find.Parent = header
		local glass = Instance.new("TextLabel")
		glass.Name = "Loupe"
		glass.AnchorPoint = Vector2.new(0.5, 0)
		glass.Position = UDim2.new(0.5, 0, 0, 0)
		-- 🩹 largeur PLEINE : la contrainte (FitWithinMaxSize) fait un carré QUI TIENT dans cette boîte.
		--    Avec une largeur 0, le carré faisait 0 → seule la légende « FIND ME » restait visible.
		glass.Size = UDim2.new(1, 0, 0.7, 0)
		glass.BackgroundColor3 = dark
		glass.BackgroundTransparency = 0.2
		glass.Text = "🔍"
		glass.TextScaled = true
		glass.TextColor3 = Color3.new(1, 1, 1)
		glass.Parent = find
		local far = Instance.new("UIAspectRatioConstraint", glass)
		far.AspectRatio = 1
		far.AspectType = Enum.AspectType.FitWithinMaxSize
		Instance.new("UICorner", glass).CornerRadius = UDim.new(1, 0)
		local fs = Instance.new("UIStroke") ; fs.Color = accent ; fs.Thickness = 1.5 ; fs.Transparency = 0.5 ; fs.Parent = glass
		local fp = Instance.new("UIPadding", glass) ; fp.PaddingTop = UDim.new(0.12, 0) ; fp.PaddingBottom = UDim.new(0.12, 0)
		local cap = Instance.new("TextLabel")
		cap.Name = "Caption"
		cap.AnchorPoint = Vector2.new(0.5, 1)
		cap.Position = UDim2.new(0.5, 0, 1, 0)
		cap.Size = UDim2.new(1.4, 0, 0.26, 0)   -- un peu plus large que la loupe : le texte reste lisible
		cap.BackgroundTransparency = 1
		cap.Text = "FIND ME"
		cap.Font = Enum.Font.FredokaOne
		cap.TextScaled = true
		cap.TextColor3 = p.muted or Color3.fromRGB(190, 190, 200)
		cap.Parent = find
		local cc = Instance.new("UITextSizeConstraint", cap) ; cc.MaxTextSize = 18 ; cc.MinTextSize = 6
		find.MouseEnter:Connect(function() glass.BackgroundTransparency = 0 end)
		find.MouseLeave:Connect(function() glass.BackgroundTransparency = 0.2 end)

		tabs = {
			all = allB, friends = frB, findMe = find, frL = frB, friendsText = "FRIENDS",
			setSelected = function(which)
				for _, pair in ipairs({ { allB, "all" }, { frB, "friends" } }) do
					local on = pair[2] == which
					pair[1].BackgroundTransparency = on and 0 or 1
					pair[1].TextColor3 = on and Color3.fromRGB(20, 16, 8) or (p.muted or Color3.fromRGB(170, 170, 180))
				end
			end,
		}
		tabs.setSelected("all")
	end

	local divider = Instance.new("Frame")
	divider.Size             = UDim2.new(0.95, 0, 0, 2)
	divider.Position         = UDim2.new(0.025, 0, 0.09, 1)
	divider.BackgroundColor3 = Color3.new(1, 1, 1)
	divider.BorderSizePixel  = 0
	divider.Parent           = main
	local dGrad = Instance.new("UIGradient")
	dGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.0, Color3.new(0, 0, 0)),
		ColorSequenceKeypoint.new(0.2, p.accent1),
		ColorSequenceKeypoint.new(0.5, p.accent2 or p.accent1),
		ColorSequenceKeypoint.new(0.8, p.accent1),
		ColorSequenceKeypoint.new(1.0, Color3.new(0, 0, 0)),
	})
	dGrad.Parent = divider

	local content = Instance.new("Frame")
	content.Name             = "ContentFrame"
	content.Size             = UDim2.new(0.96, 0, 0.835 - reserve, 0)
	content.Position         = UDim2.new(0.02, 0, 0.103, 0)
	content.BackgroundColor3 = p.panel
	content.BorderSizePixel  = 0
	content.ClipsDescendants = true
	content.Parent           = main
	Instance.new("UICorner", content).CornerRadius = UDim.new(0, 12)

	local cStroke = Instance.new("UIStroke")
	cStroke.Color        = p.stroke
	cStroke.Thickness    = 1
	cStroke.Transparency = 0.5
	cStroke.Parent       = content

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name                   = "ScrollingFrame"
	scroll.Size                   = UDim2.new(0.97, 0, 0.97, 0)
	scroll.Position               = UDim2.new(0.015, 0, 0.015, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel        = 0
	scroll.ScrollBarThickness     = 5
	scroll.ScrollBarImageColor3   = p.accent2 or p.accent1
	scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	scroll.ClipsDescendants       = true
	scroll.Parent                 = content

	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding   = UDim.new(0, 8)   -- 8 px : laisse respirer les halos
	list.Parent    = scroll

	local pad = Instance.new("UIPadding")
	pad.PaddingTop    = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft   = UDim.new(0, 16)   -- marge pour le débord des halos
	pad.PaddingRight  = UDim.new(0, 16)
	pad.Parent        = scroll

	local footer = Instance.new("Frame")
	footer.Name             = "Footer"
	footer.Size             = UDim2.new(0.96, 0, 0.057, 0)
	footer.Position         = UDim2.new(0.02, 0, 0.938 - reserve, 0)
	footer.BackgroundColor3 = p.footer or p.panel
	footer.BorderSizePixel  = 0
	footer.Parent           = main
	Instance.new("UICorner", footer).CornerRadius = UDim.new(0, 8)

	local fStroke = Instance.new("UIStroke")
	fStroke.Color        = p.stroke
	fStroke.Thickness    = 1
	fStroke.Transparency = 0.5
	fStroke.Parent       = footer

	local refreshLbl = Instance.new("TextLabel")
	refreshLbl.Name                   = "RefreshLabel"
	refreshLbl.Size                   = UDim2.new(1, 0, 1, 0)
	refreshLbl.BackgroundTransparency = 1
	refreshLbl.Text                   = "Refresh in --:--"
	refreshLbl.TextColor3             = p.muted
	refreshLbl.TextScaled             = true
	refreshLbl.Font                   = Enum.Font.Gotham
	refreshLbl.Parent                 = footer
	local flc = Instance.new("UITextSizeConstraint", refreshLbl)
	flc.MaxTextSize = 16; flc.MinTextSize = 8

	return {
		main       = main,
		header     = header,
		content    = content,
		scroll     = scroll,
		footer     = footer,
		refreshLbl = refreshLbl,
		tabs       = tabs,
	}
end

--==============================================================================
-- 🏆 UI D'UN BOARD — STYLE MODERNE (Paramètres / CombatHUD)
--   Mêmes champs renvoyés que buildBoardUI (main, content, scroll, footer,
--   refreshLbl) : les hooks existants (bouton DONATE…) marchent tels quels.
--   + tabs (ALL / FRIENDS / FIND ME), youRow (ta place), barFill (next update)
--==============================================================================
local function modernButton(parent, text, col, size, pos)
	local depth, radius = 6, 14
	local slot = Instance.new("Frame")
	slot.Size = size
	slot.Position = pos
	slot.BackgroundTransparency = 1
	slot.Parent = parent
	local edge = Instance.new("Frame")
	edge.Size = UDim2.new(1, 0, 1, -depth)
	edge.Position = UDim2.fromOffset(0, depth)
	edge.BackgroundColor3 = col[3]
	edge.BorderSizePixel = 0
	edge.Parent = slot
	Instance.new("UICorner", edge).CornerRadius = UDim.new(0, radius)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 1, -depth)
	btn.BackgroundColor3 = Color3.new(1, 1, 1)
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.ZIndex = 2
	btn.Parent = slot
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, radius)
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(col[1], col[2])
	grad.Parent = btn
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.Font = Enum.Font.FredokaOne
	lbl.TextScaled = true
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.ZIndex = 4
	lbl.Parent = btn
	local tc = Instance.new("UITextSizeConstraint", lbl)
	tc.MaxTextSize = 30 ; tc.MinTextSize = 10
	local lp = Instance.new("UIPadding", lbl)
	lp.PaddingTop, lp.PaddingBottom = UDim.new(0.18, 0), UDim.new(0.18, 0)
	local function press(down) btn.Position = UDim2.fromOffset(0, down and depth or 0) end
	btn.MouseButton1Down:Connect(function() press(true) end)
	btn.MouseButton1Up:Connect(function() press(false) end)
	btn.MouseLeave:Connect(function() press(false) end)
	btn.Activated:Connect(function() task.delay(0.08, function() press(false) end) end)
	local function recolor(c) grad.Color = ColorSequence.new(c[1], c[2]) ; edge.BackgroundColor3 = c[3] end
	return btn, lbl, recolor
end

local function buildBoardUIModern(cfg, sg)
	for _, c in ipairs(sg:GetChildren()) do c:Destroy() end
	local p = cfg.palette
	local r = cfg.bottomReserve or 0
	local accent = p.accent1 or Color3.fromRGB(70, 150, 245)

	local main = Instance.new("Frame")
	main.Name             = "MainFrame"
	main.Size             = UDim2.new(1, 0, 1, 0)
	main.BackgroundColor3 = Color3.new(1, 1, 1)
	main.BorderSizePixel  = 0
	main.Parent           = sg
	local bgGrad = Instance.new("UIGradient")
	bgGrad.Color    = ColorSequence.new(MODERN_PALETTE.bgA, MODERN_PALETTE.bgB)
	bgGrad.Rotation = 90
	bgGrad.Parent   = main

	-- en-tête : titre blanc à gauche (comme « SETTINGS »), trait de couleur du board
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(0.96, 0, 0.075, 0)
	header.Position = UDim2.new(0.02, 0, 0.015, 0)
	header.BackgroundTransparency = 1
	header.Parent = main
	local stripe = Instance.new("Frame")
	stripe.Size = UDim2.new(0, 10, 0.8, 0)
	stripe.Position = UDim2.new(0, 0, 0.1, 0)
	stripe.BackgroundColor3 = accent
	stripe.BorderSizePixel = 0
	stripe.Parent = header
	Instance.new("UICorner", stripe).CornerRadius = UDim.new(1, 0)
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.75, 0, 1, 0)
	title.Position = UDim2.new(0, 26, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = cfg.title or ""
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Parent = header
	local tc = Instance.new("UITextSizeConstraint", title)
	tc.MaxTextSize = 54 ; tc.MinTextSize = 20
	local icon = Instance.new("TextLabel")
	icon.AnchorPoint = Vector2.new(1, 0.5)
	icon.Size = UDim2.new(0.2, 0, 0.9, 0)
	icon.Position = UDim2.new(1, 0, 0.5, 0)
	icon.BackgroundTransparency = 1
	icon.Text = "TOP " .. tostring(cfg.topSize or "")
	icon.FontFace = MF.Heavy
	icon.TextScaled = true
	icon.TextXAlignment = Enum.TextXAlignment.Right
	icon.TextColor3 = accent
	icon.Parent = header
	local ic = Instance.new("UITextSizeConstraint", icon)
	ic.MaxTextSize = 34 ; ic.MinTextSize = 10

	-- onglets
	local tabs = nil
	if STYLE.Tabs then
		local row = Instance.new("Frame")
		row.Name = "Tabs"
		row.Size = UDim2.new(0.96, 0, 0.062, 0)
		row.Position = UDim2.new(0.02, 0, 0.098, 0)
		row.BackgroundTransparency = 1
		row.Parent = main
		local allB, allL, allC = modernButton(row, "ALL", BTN.blue, UDim2.new(0.2, 0, 1, 0), UDim2.new(0, 0, 0, 0))
		local frB, frL, frC = modernButton(row, "FRIENDS", BTN.grey, UDim2.new(0.24, 0, 1, 0), UDim2.new(0.215, 0, 0, 0))
		local meB = modernButton(row, "🔍 FIND ME", BTN.teal, UDim2.new(0.26, 0, 1, 0), UDim2.new(0.74, 0, 0, 0))
		tabs = { all = allB, friends = frB, findMe = meB, allColor = allC, friendsColor = frC, allL = allL, frL = frL }
	end
	local top = STYLE.Tabs and 0.172 or 0.1

	local content = Instance.new("Frame")
	content.Name             = "ContentFrame"
	content.Size             = UDim2.new(0.96, 0, (STYLE.YourRow and 0.835 or 0.9) - top - r, 0)
	content.Position         = UDim2.new(0.02, 0, top, 0)
	content.BackgroundColor3 = MODERN_PALETTE.panel
	content.BackgroundTransparency = 0.1
	content.BorderSizePixel  = 0
	content.ClipsDescendants = true
	content.Parent           = main
	Instance.new("UICorner", content).CornerRadius = UDim.new(0, 16)
	local cStroke = Instance.new("UIStroke")
	cStroke.Color = MODERN_PALETTE.stroke ; cStroke.Thickness = 1.5 ; cStroke.Transparency = 0.4
	cStroke.Parent = content

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name                   = "ScrollingFrame"
	scroll.Size                   = UDim2.new(0.97, 0, 0.97, 0)
	scroll.Position               = UDim2.new(0.015, 0, 0.015, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel        = 0
	scroll.ScrollBarThickness     = 6
	scroll.ScrollBarImageColor3   = accent
	scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	scroll.ClipsDescendants       = true
	scroll.Parent                 = content
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding   = UDim.new(0, 8)
	list.Parent    = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 16), UDim.new(0, 16)
	pad.Parent = scroll

	-- ta ligne
	local youRow, youLbl = nil, nil
	if STYLE.YourRow then
		youRow = Instance.new("Frame")
		youRow.Name = "YouRow"
		youRow.Size = UDim2.new(0.96, 0, 0.06, 0)
		youRow.Position = UDim2.new(0.02, 0, 0.845 - r, 0)
		youRow.BackgroundColor3 = MODERN_PALETTE.entry
		youRow.BorderSizePixel = 0
		youRow.Parent = main
		Instance.new("UICorner", youRow).CornerRadius = UDim.new(0, 12)
		local ys = Instance.new("UIStroke")
		ys.Color = ME_COLOR ; ys.Thickness = 2 ; ys.Transparency = 0.25
		ys.Parent = youRow
		local av = Instance.new("ImageLabel")
		av.Size = UDim2.new(0, 46, 0, 46)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, 12, 0.5, 0)
		av.BackgroundColor3 = MODERN_PALETTE.panel
		av.Image = LocalPlayer and thumbUrl(LocalPlayer.UserId) or ""
		av.Parent = youRow
		Instance.new("UICorner", av).CornerRadius = UDim.new(1, 0)
		youLbl = Instance.new("TextLabel")
		youLbl.Size = UDim2.new(1, -80, 0.8, 0)
		youLbl.Position = UDim2.new(0, 70, 0.1, 0)
		youLbl.BackgroundTransparency = 1
		youLbl.FontFace = MF.Bold
		youLbl.TextScaled = true
		youLbl.RichText = true
		youLbl.TextXAlignment = Enum.TextXAlignment.Left
		youLbl.TextColor3 = MODERN_PALETTE.white
		youLbl.Text = "YOU · loading…"
		youLbl.Parent = youRow
		local yc = Instance.new("UITextSizeConstraint", youLbl)
		yc.MaxTextSize = 28 ; yc.MinTextSize = 10
	end

	-- pied : « NEXT UPDATE » + fine barre
	local footer = Instance.new("Frame")
	footer.Name             = "Footer"
	footer.Size             = UDim2.new(0.96, 0, 0.05, 0)
	footer.Position         = UDim2.new(0.02, 0, 0.92 - r, 0)
	footer.BackgroundTransparency = 1
	footer.Parent           = main
	local refreshLbl = Instance.new("TextLabel")
	refreshLbl.Name = "RefreshLabel"
	refreshLbl.Size = UDim2.new(1, 0, STYLE.UpdateBar and 0.62 or 1, 0)
	refreshLbl.BackgroundTransparency = 1
	refreshLbl.Text = "NEXT UPDATE --:--"
	refreshLbl.TextColor3 = MODERN_PALETTE.muted
	refreshLbl.TextScaled = true
	refreshLbl.FontFace = MF.Bold
	refreshLbl.TextXAlignment = Enum.TextXAlignment.Left
	refreshLbl.Parent = footer
	local flc = Instance.new("UITextSizeConstraint", refreshLbl)
	flc.MaxTextSize = 22 ; flc.MinTextSize = 8
	local barFill = nil
	if STYLE.UpdateBar then
		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, 0, 0.18, 0)
		track.Position = UDim2.new(0, 0, 0.78, 0)
		track.BackgroundColor3 = MODERN_PALETTE.entry
		track.BorderSizePixel = 0
		track.Parent = footer
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
		barFill = Instance.new("Frame")
		barFill.Size = UDim2.new(0, 0, 1, 0)
		barFill.BackgroundColor3 = Color3.new(1, 1, 1)
		barFill.BackgroundTransparency = 0.15
		barFill.BorderSizePixel = 0
		barFill.Parent = track
		Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)
	end

	return {
		main       = main,
		header     = header,
		content    = content,
		scroll     = scroll,
		footer     = footer,
		refreshLbl = refreshLbl,
		tabs       = tabs,
		youRow     = youRow,
		youLbl     = youLbl,
		barFill    = barFill,
	}
end

--==============================================================================
-- 👥 AMIS (lus une fois, gardés en mémoire) — pour l'onglet FRIENDS
--==============================================================================
local friendSet, friendsAt, friendsLoading = nil, -1e9, false
local friendNames = {}   -- [userId] = nom affiché (pour les amis hors du top)
local friendWaiters = {}
local function withFriends(cb)
	if friendSet and os.clock() - friendsAt < (STYLE.FriendsCacheSeconds or 600) then cb() return end
	table.insert(friendWaiters, cb)
	if friendsLoading then return end
	friendsLoading = true
	task.spawn(function()
		local set = {}
		local ok = pcall(function()
			local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
			for _ = 1, 8 do   -- 8 pages max (≈ 400 amis) : largement assez
				for _, f in ipairs(pages:GetCurrentPage()) do
					set[f.Id] = true
					friendNames[f.Id] = f.DisplayName or f.Username
				end
				if pages.IsFinished then break end
				pages:AdvanceToNextPageAsync()
			end
		end)
		if ok then friendSet, friendsAt = set, os.clock()
		elseif not friendSet then friendSet = {} end   -- échec : liste vide (on réessaiera plus tard)
		friendsLoading = false
		local list = friendWaiters
		friendWaiters = {}
		for _, f in ipairs(list) do pcall(f) end
	end)
end

--==============================================================================
-- MOUNT  —  point d'entrée appelé par chaque LocalScript
--==============================================================================
function Core.mount(cfg)
	cfg.palette        = cfg.palette or {}
	cfg.entryHeight    = cfg.entryHeight or 68
	cfg.topSize        = cfg.topSize or 25
	cfg.refreshDelay   = cfg.refreshDelay or 120
	cfg.firstLoadDelay = cfg.firstLoadDelay or 3   -- C : plus de task.wait(80) !
	cfg.emptyText      = cfg.emptyText or "No data yet..."

	-- 🏆 style moderne : fonds neutres (copie : la palette d'origine n'est JAMAIS modifiée,
	--    elle peut servir ailleurs — ex. la fenêtre des dons). Les accents restent ceux du board.
	if MODERN then
		local pal = {}
		for k, v in pairs(cfg.palette) do pal[k] = v end
		for k, v in pairs(MODERN_PALETTE) do pal[k] = v end
		cfg.palette = pal
		cfg._modern = true
	end

	local ctx = {
		cfg          = cfg,
		boards       = {},
		data         = nil,
		stamp        = 0,      -- incrémenté à chaque nouveau jeu de données
		lastRefresh  = 0,
		isRefreshing = false,
	}

	local getFunc = ReplicatedStorage:WaitForChild(cfg.getFunctionName, 20)
	local updEvt  = cfg.updateEventName and ReplicatedStorage:WaitForChild(cfg.updateEventName, 20) or nil

	----------------------------------------------------------------
	-- déduplication + tri
	----------------------------------------------------------------
	local function dedupe(raw)
		local seen, out = {}, {}
		for _, e in ipairs(raw) do
			local k = tostring(e.userId)
			if e.userId and not seen[k] then
				seen[k] = true
				table.insert(out, e)
				local ks = knownStats[e.userId] or {}
				for f, v in pairs(e) do
					if f ~= "rank" then ks[f] = v end
				end
				knownStats[e.userId] = ks
			end
		end
		table.sort(out, function(a, b)
			return (a[cfg.valueKey] or 0) > (b[cfg.valueKey] or 0)
		end)
		for i, e in ipairs(out) do e.rank = i end
		return out
	end

	----------------------------------------------------------------
	-- rendu sur tous les boards
	----------------------------------------------------------------
	-- 🏆 ta ligne (style moderne)
	local function updateYou(b)
		if not (b.youLbl and b.youLbl.Parent) or not ctx.data then return end
		local me = LocalPlayer and LocalPlayer.UserId
		for _, e in ipairs(ctx.data) do
			if e.userId == me then
				b.youLbl.Text = string.format('<font color="#%s">#%d</font>   YOU   ·   %s', ME_COLOR:ToHex(),
					e.rank or 0, (cfg.formatValue or fmtDefault)(e[cfg.valueKey] or 0))
				return
			end
		end
		b.youLbl.Text = string.format('YOU   ·   <font color="#%s">not in the top %d yet — keep going!</font>',
			MODERN_PALETTE.muted:ToHex(), math.min(#ctx.data, cfg.topSize))
	end

	-- 👥 score des amis HORS du top (FriendsBoard_Server), gardé 5 min
	local BOARD_KEY = ({ GetPointsLeaderboard = "Points", GetRebirthLeaderboard = "Rebirths",
		GetStreakLeaderboard = "Streak", GetKillLeaderboard = "Kills", GetLeaderboardData = "Donations" })[cfg.getFunctionName or ""]
	local friendVals, friendValsAt, friendValsBusy = {}, -1e9, false
	local renderBoard
	local function fetchFriendValues(ids)
		if not BOARD_KEY or friendValsBusy or #ids == 0 then return end
		if os.clock() - friendValsAt < 300 then return end
		local fn = ReplicatedStorage:FindFirstChild("GetFriendsBoardValues")
		if not fn then return end
		friendValsBusy = true
		task.spawn(function()
			local res
			for _ = 1, 3 do
				local ok, r = pcall(function() return fn:InvokeServer(BOARD_KEY, ids) end)
				if ok and type(r) == "table" and not r.throttled then res = r break end
				task.wait(3.2)
			end
			friendValsBusy = false
			friendValsAt = os.clock()
			if type(res) == "table" then
				for k, v in pairs(res) do
					local id = tonumber(k)
					if id and type(v) == "number" then friendVals[id] = v end
				end
			end
			for _, bb in ipairs(ctx.boards) do
				if bb.filter == "friends" and bb.scroll and bb.scroll.Parent then renderBoard(bb) end
			end
		end)
	end

	-- 🏆 liste montrée par un board : tout le monde, ou toi + TOUS tes amis
	--    (ceux du top avec leur vraie place, les autres avec « -- » en dessous)
	renderBoard = function(b)
		if not ctx.data then return end
		if b.filter == "friends" then
			local me = LocalPlayer and LocalPlayer.UserId
			local out, inTop = {}, {}
			for _, e in ipairs(ctx.data) do
				if e.userId == me or (friendSet and friendSet[e.userId]) then
					table.insert(out, e)
					inTop[e.userId] = true
				end
			end
			-- amis (et toi) hors du top : affichés quand même, rang « -- »
			local others, missing = {}, {}
			local function addOther(id, name)
				if inTop[id] then return end
				local v = friendVals[id]
				if v == nil then table.insert(missing, id) end
				table.insert(others, { userId = id, name = name, [cfg.valueKey] = v or 0,
					noRank = true, pending = (v == nil) and BOARD_KEY ~= nil })
			end
			if me then addOther(me, LocalPlayer.DisplayName) end
			for id in pairs(friendSet or {}) do addOther(id, friendNames[id] or ("User " .. id)) end
			table.sort(others, function(a, c)
				local va, vc = a[cfg.valueKey] or 0, c[cfg.valueKey] or 0
				if va ~= vc then return va > vc end
				return tostring(a.name) < tostring(c.name)
			end)
			for i, e in ipairs(others) do e._ord = i ; e.rank = 9999 ; table.insert(out, e) end
			if #missing > 0 then
				table.sort(missing)
				local ids = {}
				for i = 1, math.min(#missing, 50) do ids[i] = missing[i] end
				fetchFriendValues(ids)
			end
			if #out == 0 then
				b.view.lastList = nil   -- sinon un repaint VIP réafficherait la liste complète ici
				b.view:showEmpty("None of your friends are in this top yet")
			else
				b.view:render(out)
			end
		else
			-- 🔍 FIND ME alors que tu n'es pas dans le top : ta ligne « -- » sous le dernier
			local me = LocalPlayer and LocalPlayer.UserId
			local inList = false
			if b.meExtra and me then
				for _, e in ipairs(ctx.data) do if e.userId == me then inList = true break end end
			end
			if b.meExtra and me and not inList then
				local out = table.clone(ctx.data)
				local v = friendVals[me]
				table.insert(out, { userId = me, name = LocalPlayer.DisplayName, [cfg.valueKey] = v or 0,
					noRank = true, pending = (v == nil) and BOARD_KEY ~= nil, _ord = 1, rank = 9999 })
				out.extra = 1
				b.view:render(out)
			else
				b.view:render(ctx.data)
			end
		end
		updateYou(b)
	end

	local function pushToBoards()
		for _, b in ipairs(ctx.boards) do
			if b.scroll and b.scroll.Parent then
				if b.loader then b.loader:Destroy(); b.loader = nil end
				if MODERN or TABS then renderBoard(b) else b.view:render(ctx.data) end
			end
		end
	end

	-- 🔍 FIND ME : fait défiler jusqu'à ta ligne et la fait clignoter.
	--    Pas dans le top ? Un message le dit, ta ligne « -- » est ajoutée SOUS le dernier avec ton
	--    score (lu dans le même classement), et on descend jusqu'à elle : tu vois l'écart avec le dernier.
	local FIND_GLOW = { base = {0.45, 0.62, 0.78}, amp = {0.35, 0.25, 0.15}, speed = 7 }
	local myValAt, myValBusy = -1e9, false
	local function fetchMine(done)
		local me = LocalPlayer and LocalPlayer.UserId
		if not BOARD_KEY or not me then return end
		if friendVals[me] ~= nil and os.clock() - myValAt < 60 then return end
		if myValBusy then return end
		local fn = ReplicatedStorage:FindFirstChild("GetFriendsBoardValues")
		if not fn then return end
		myValBusy = true
		task.spawn(function()
			for _ = 1, 2 do
				local ok, r = pcall(function() return fn:InvokeServer(BOARD_KEY, { me }) end)
				if ok and type(r) == "table" and not r.throttled then
					local v = r[tostring(me)]
					if type(v) == "number" then friendVals[me] = v ; myValAt = os.clock() end
					break
				end
				task.wait(3.2)
			end
			myValBusy = false
			done()
		end)
	end
	-- message discret : petite bande sombre arrondie, texte blanc SANS contour, apparaît / s'efface en fondu
	local function toast(b, text)
		local host = b.content or b.main
		if not (host and host.Parent) then return end
		local old = host:FindFirstChild("FindMeToast")
		if old then old:Destroy() end
		local t = Instance.new("Frame")
		t.Name = "FindMeToast"
		t.AnchorPoint = Vector2.new(0.5, 0)
		t.Position = UDim2.new(0.5, 0, 0.015, 0)
		t.Size = UDim2.new(0.72, 0, 0.055, 0)
		t.BackgroundColor3 = Color3.new(0, 0, 0)
		t.BackgroundTransparency = 1
		t.BorderSizePixel = 0
		t.ZIndex = 50
		t.Parent = host
		Instance.new("UICorner", t).CornerRadius = UDim.new(0.3, 0)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(0.5, 0.5)
		l.Size = UDim2.fromScale(0.92, 0.62)
		l.Font = Enum.Font.GothamMedium
		l.TextScaled = true
		l.TextColor3 = Color3.fromRGB(235, 235, 240)
		l.TextTransparency = 1
		l.Text = text
		l.ZIndex = 51
		l.Parent = t
		local c = Instance.new("UITextSizeConstraint", l) ; c.MaxTextSize = 24
		local fade = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(t, fade, { BackgroundTransparency = 0.35 }):Play()
		TweenService:Create(l, fade, { TextTransparency = 0 }):Play()
		task.delay(3, function()
			if not t.Parent then return end
			TweenService:Create(t, fade, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(l, fade, { TextTransparency = 1 }):Play()
			task.delay(0.3, function() if t.Parent then t:Destroy() end end)
		end)
	end
	local function scrollToMe(b)
		local me = LocalPlayer and LocalPlayer.UserId
		for _, E in ipairs(b.view.entries) do
			if E.data and E.data.userId == me and E.holder.Parent then
				local sc = b.scroll
				local y = E.holder.AbsolutePosition.Y - sc.AbsolutePosition.Y + sc.CanvasPosition.Y
				local maxY = math.max(0, sc.AbsoluteCanvasSize.Y - sc.AbsoluteWindowSize.Y)
				local target = math.clamp(y - (sc.AbsoluteWindowSize.Y - E.holder.AbsoluteSize.Y) / 2, 0, maxY)
				TweenService:Create(sc, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{ CanvasPosition = Vector2.new(0, target) }):Play()
				E.glowState.preset, E.glowState.color = FIND_GLOW, ME_COLOR
				task.delay(2.5, function()
					if E.data and E.data.userId == me then
						E.glowState.preset, E.glowState.color = SELF_GLOW, SELF_BLUE
					end
				end)
				return true
			end
		end
		return false
	end
	local function findMe(b)
		if scrollToMe(b) then return end
		if b.filter == "all" and TABS and ctx.data and LocalPlayer then
			toast(b, string.format("Not in the top %d yet · your score is below", math.min(#ctx.data, cfg.topSize)))
			b.meExtra = true
			renderBoard(b)
			fetchMine(function()
				if b.meExtra and b.filter == "all" and b.scroll.Parent then renderBoard(b) end
			end)
			task.spawn(function()
				-- deux images : le temps que la nouvelle ligne soit placée par le UIListLayout
				RunService.Heartbeat:Wait() ; RunService.Heartbeat:Wait()
				if b.scroll.Parent then scrollToMe(b) end
			end)
			return
		end
		-- pas dans la liste : ta ligne en bas clignote (elle dit où tu en es)
		if b.youRow and b.youRow.Parent then
			local base = MODERN_PALETTE.entry
			b.youRow.BackgroundColor3 = Color3.fromRGB(90, 76, 30)
			TweenService:Create(b.youRow, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ BackgroundColor3 = base }):Play()
		end
	end

	local function applyServerData(raw)
		if not raw or #raw == 0 then return end
		fetchVip()
		ctx.data        = dedupe(raw)
		ctx.stamp       = ctx.stamp + 1
		ctx.lastRefresh = os.clock()
		pushToBoards()
	end
	ctx.applyServerData = applyServerData

	----------------------------------------------------------------
	-- UN SEUL fetch pour tous les boards (C : moins de trafic remote)
	----------------------------------------------------------------
	local function refreshAll()
		if ctx.isRefreshing then return end
		ctx.isRefreshing = true
		ctx.lastRefresh  = os.clock()

		task.spawn(function()
			fetchVip()

			local data
			for _ = 1, 5 do
				if getFunc then
					local ok, res = pcall(function() return getFunc:InvokeServer() end)
					if ok and res and #res > 0 then data = res break end
				end
				task.wait(2)
			end

			ctx.isRefreshing = false

			if data then
				ctx.data        = dedupe(data)
				ctx.stamp       = ctx.stamp + 1
				ctx.lastRefresh = os.clock()
				pushToBoards()
			else
				-- pas encore de données côté serveur : nouvel essai dans 5s
				ctx.lastRefresh = os.clock() - cfg.refreshDelay + 5
				for _, b in ipairs(ctx.boards) do
					if b.loader then b.loader:Destroy(); b.loader = nil end
					if not ctx.data then b.view:showEmpty(cfg.emptyText) end
				end
			end
		end)
	end
	ctx.refreshAll = refreshAll

	----------------------------------------------------------------
	-- countdown (un seul thread pour tous les boards)
	----------------------------------------------------------------
	task.spawn(function()
		local BAR_TWEEN = TweenInfo.new(1, Enum.EasingStyle.Linear)
		while true do
			task.wait(1)
			local txt, col
			local rem = math.max(0, math.floor(ctx.lastRefresh + cfg.refreshDelay - os.clock()))
			if ctx.isRefreshing then
				txt = MODERN and "UPDATING…" or "Refreshing..."
				col = cfg.palette.accent2 or cfg.palette.accent1
			else
				if rem == 0 then
					txt = MODERN and "UPDATING SOON…" or "Refreshing soon..."
					col = cfg.palette.accent1
				else
					txt = string.format(MODERN and "NEXT UPDATE  %d:%02d" or "Refresh in %d:%02d", math.floor(rem / 60), rem % 60)
					col = (rem <= 15) and cfg.palette.accent1 or cfg.palette.muted
				end
			end
			local frac = math.clamp(1 - rem / math.max(1, cfg.refreshDelay), 0, 1)
			for _, b in ipairs(ctx.boards) do
				if b.refreshLbl and b.refreshLbl.Parent then
					b.refreshLbl.Text       = txt
					b.refreshLbl.TextColor3 = col
				end
				if b.barFill and b.barFill.Parent then
					if frac < (b.lastFrac or 0) then
						b.barFill.Size = UDim2.new(frac, 0, 1, 0)   -- nouveau cycle : repart à zéro net
					else
						TweenService:Create(b.barFill, BAR_TWEEN, { Size = UDim2.new(frac, 0, 1, 0) }):Play()
					end
					b.lastFrac = frac
				end
			end
		end
	end)

	----------------------------------------------------------------
	-- boucle d'auto-refresh + nettoyage des boards détruits
	-- (C : le bug de fuite mémoire au swap de map)
	----------------------------------------------------------------
	task.spawn(function()
		while true do
			task.wait(1)
			for i = #ctx.boards, 1, -1 do
				local b = ctx.boards[i]
				if not (b.surfaceGui and b.surfaceGui.Parent and b.scroll and b.scroll.Parent
					and b.part and b.part:IsDescendantOf(Workspace)) then
					b.view:destroy()
					-- la copie cliquable vit dans le PlayerGui : on la retire aussi
					if b.surfaceGui and b.surfaceGui ~= b.src then b.surfaceGui:Destroy() end
					table.remove(ctx.boards, i)
				end
			end
			if #ctx.boards > 0 and not ctx.isRefreshing then
				if (os.clock() - ctx.lastRefresh) >= cfg.refreshDelay then
					refreshAll()
				end
			end
		end
	end)

	----------------------------------------------------------------
	-- événement serveur
	----------------------------------------------------------------
	if updEvt then
		updEvt.OnClientEvent:Connect(function(newData)
			applyServerData(newData)
		end)
	end

	----------------------------------------------------------------
	-- détection / init des boards
	----------------------------------------------------------------
	local nameSet = {}
	for _, n in ipairs(cfg.boardNames or {}) do nameSet[n] = true end

	local function isBoard(part)
		return part:IsA("BasePart") and nameSet[part.Name] == true
	end

	local function initBoard(part)
		local src = part:FindFirstChildOfClass("SurfaceGui")
		if not src then return end
		for _, b in ipairs(ctx.boards) do
			if b.part == part then return end
		end

		local sg = src
		if INTERACTIVE then
			-- 🖱️ Une SurfaceGui posée dans le Workspace ne reçoit NI survol NI
			--    clic. On l'affiche donc depuis le PlayerGui, collée au même part
			--    (Adornee), et on éteint l'originale. Même rendu, mais cliquable.
			sg = Instance.new("SurfaceGui")
			sg.Name             = "LB_" .. part.Name
			sg.Face             = src.Face
			sg.SizingMode       = src.SizingMode
			sg.PixelsPerStud    = src.PixelsPerStud
			sg.AlwaysOnTop      = src.AlwaysOnTop
			sg.ZOffset          = src.ZOffset
			sg.MaxDistance      = src.MaxDistance
			sg.ClipsDescendants = src.ClipsDescendants
			sg.ResetOnSpawn     = false
			sg.Adornee          = part
			sg.Parent           = LocalPlayer:WaitForChild("PlayerGui")
			src.Enabled         = false
		end

		sg.CanvasSize      = Vector2.new(1920, 1080)
		sg.LightInfluence  = 0
		sg.Brightness      = 1
		sg.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling

		local ui = (MODERN and buildBoardUIModern or buildBoardUI)(cfg, sg)
		local b = {
			part       = part,
			src        = src,
			surfaceGui = sg,
			main       = ui.main,
			content    = ui.content,
			scroll     = ui.scroll,
			footer     = ui.footer,
			refreshLbl = ui.refreshLbl,
			loader     = nil,
			-- 🏆 style moderne
			filter     = "all",
			youRow     = ui.youRow,
			youLbl     = ui.youLbl,
			barFill    = ui.barFill,
		}
		b.view = Core.newListView(ui.scroll, cfg)
		b.view.useDataRank = MODERN or TABS
		table.insert(ctx.boards, b)

		if ui.tabs then
			local t = ui.tabs
			local function paint()
				if t.setSelected then t.setSelected(b.filter) return end   -- look d'avant
				t.allColor(b.filter == "all" and BTN.blue or BTN.grey)
				t.friendsColor(b.filter == "friends" and BTN.blue or BTN.grey)
			end
			t.all.Activated:Connect(function()
				if b.filter == "all" then return end
				b.filter = "all" ; b.meExtra = nil ; paint()
				b.scroll.CanvasPosition = Vector2.zero
				renderBoard(b)
			end)
			t.friends.Activated:Connect(function()
				if b.filter == "friends" then return end
				b.filter = "friends" ; b.meExtra = nil ; paint()
				b.scroll.CanvasPosition = Vector2.zero
				t.frL.Text = "…"
				withFriends(function()
					t.frL.Text = t.friendsText or "FRIENDS"
					if b.filter == "friends" and b.scroll.Parent then renderBoard(b) end
				end)
			end)
			t.findMe.Activated:Connect(function() findMe(b) end)
		end

		if cfg.onBoardBuilt then
			pcall(cfg.onBoardBuilt, b, ctx)
		end

		if ctx.data then
			if MODERN or TABS then renderBoard(b) else b.view:render(ctx.data) end   -- board ajouté en cours de partie
		else
			b.loader = createLoader(ui.content, cfg)
			task.delay(cfg.firstLoadDelay, function()
				if not b.scroll.Parent then return end
				if not ctx.data then refreshAll() end
			end)
		end
	end
	ctx.initBoard = initBoard

	task.spawn(function()
		task.wait(2)
		for _, d in ipairs(Workspace:GetDescendants()) do
			if isBoard(d) then initBoard(d) end
		end
	end)

	Workspace.DescendantAdded:Connect(function(d)
		if isBoard(d) then
			task.wait(0.3)
			initBoard(d)
		end
	end)

	return ctx
end

return Core]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">LeaderboardStyle</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 🏆 LeaderboardStyle — ModuleScript dans ReplicatedStorage   (NOUVEAU)
--
--  Réglages des leaderboards physiques (Points, Kills, Rebirths, Streak, Dons).
--
--   Style = "classic" → l'apparence d'AVANT (par défaut).
--   Style = "modern"  → look Paramètres / CombatHUD (essai précédent), avec en plus
--                       ta ligne et la barre « next update » en bas (YourRow / UpdateBar).
--
--   Tabs = true  → dans l'en-tête : ALL / FRIENDS à gauche, petite loupe 🔍 (FIND ME)
--                  à droite. FRIENDS montre TOUS tes amis : ceux du top avec leur
--                  place, les autres en dessous avec « -- ».
--   Tabs = false → EXACTEMENT les boards d'avant, sans aucun bouton.
--════════════════════════════════════════════════════════════════════════════
return {
	Style = "classic",     -- "classic" | "modern"
	Tabs  = true,          -- ALL / FRIENDS / 🔍 FIND ME

	-- seulement pour Style = "modern"
	YourRow   = false,
	UpdateBar = false,

	-- 👥 la liste d'amis est lue UNE fois, puis gardée en mémoire ce temps-là (s)
	FriendsCacheSeconds = 600,
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">PopupControlConfig</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 🔔 PopupControlConfig — ModuleScript dans ReplicatedStorage   (NOUVEAU)
--
--  La LISTE des popups automatiques du jeu + leurs réglages PAR DÉFAUT.
--  ⚠️ Les vraies valeurs se changent dans l'ADMIN PANEL ▸ 🔔 POPUPS
--     (sauvegardées et appliquées à tous les serveurs en quelques secondes).
--     Ici, ce ne sont que les valeurs utilisées la toute première fois.
--
--  Les défauts reproduisent EXACTEMENT le comportement d'avant :
--  rien ne change dans le jeu tant que tu ne touches pas aux réglages.
--
--  Lu par : PopupControl_Server (serveur), PopupGate (clients), Admin client.
--════════════════════════════════════════════════════════════════════════════
local M = {}

-- Réglages généraux (s'appliquent aux popups AUTOMATIQUES : minuteurs, carrousel, morts)
M.Global = {
	{ key = "Enabled",       label = "Popups automatiques activés", type = "bool",   default = true,
		help = "Interrupteur général. OFF = aucun popup automatique (les boutons des shops marchent toujours)." },
	{ key = "IdleOnly",      label = "Seulement si le joueur est inactif", type = "bool", default = false,
		help = "ON = un popup automatique attend que le joueur n'ait rien touché pendant X minutes." },
	{ key = "IdleMinutes",   label = "Minutes d'inactivité",       type = "number", default = 5, min = 1, max = 30, step = 1,
		help = "Utilisé seulement si « Seulement si inactif » est ON." },
	{ key = "MinGapSeconds", label = "Pause mini entre 2 popups (s)", type = "number", default = 0, min = 0, max = 1800, step = 30,
		help = "Temps minimum entre deux popups automatiques chez un même joueur. 0 = pas de limite." },
}

-- kind :
--   "timer"    → revient tout seul toutes les X minutes
--   "carousel" → petites offres qui défilent à l'écran
--   "deaths"   → après X morts
--   "action"   → suit une action du joueur (cliquer, toucher un pad…) : pas concerné par
--                « seulement si inactif » ni par la pause mini
--   "favorite" → demande de favori (logique intelligente, voir ask favorite game)
M.Popups = {
	{ id = "vip_offer", label = "👑 Popup VIP", kind = "timer",
		desc = "La fenêtre du VIP s'ouvre toute seule (seulement si le joueur n'a pas le VIP).",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
			{ key = "IntervalMin", label = "Toutes les (min)", type = "number", default = 13, min = 3, max = 120, step = 1 },
		} },
	{ id = "skip_obby_auto", label = "⏭️ Pass Skip Obby (fenêtre Roblox)", kind = "timer",
		desc = "Ouvre directement la fenêtre d'achat Roblox du pass Skip Obby (si pas déjà acheté).",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
			{ key = "IntervalMin", label = "Toutes les (min)", type = "number", default = 20, min = 5, max = 180, step = 5 },
		} },
	{ id = "offers_carousel", label = "🎠 Carrousel d'offres", kind = "carousel",
		desc = "Les petites offres qui défilent sur le côté de l'écran.",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
			{ key = "FirstDelaySec", label = "1re offre après (s)", type = "number", default = 5, min = 0, max = 600, step = 5 },
			{ key = "DisplaySec", label = "Durée d'une offre (s)", type = "number", default = 12, min = 4, max = 60, step = 1 },
		} },
	{ id = "death_offer", label = "💀 Offre après des morts", kind = "deaths",
		desc = "Fenêtre d'achat de points après plusieurs morts (petit pack, puis gros pack).",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
			{ key = "EveryDeaths", label = "Petit pack toutes les (morts)", type = "number", default = 10, min = 3, max = 100, step = 1 },
			{ key = "BigEveryDeaths", label = "Gros pack toutes les (morts)", type = "number", default = 20, min = 3, max = 200, step = 1 },
			{ key = "CountArena", label = "Compter les morts en arène PvP", type = "bool", default = true },
		} },
	{ id = "missing_points", label = "🎽 Points manquants pour une UGC", kind = "action",
		desc = "Le joueur clique sur une UGC sans assez de points → Roblox lui propose le pack de points adapté.",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
		} },
	{ id = "touch_pads", label = "🌀 Pads d'achat sur la map", kind = "action",
		desc = "Toucher un coil / x2 posé sur la map ouvre sa fenêtre d'achat.",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
		} },
	{ id = "event_rsvp", label = "📅 Rappel d'event après un rebirth", kind = "action",
		desc = "Après un rebirth, Roblox propose de s'inscrire au prochain event du jeu.",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
		} },
	{ id = "favorite", label = "⭐ Demande de favori", kind = "favorite",
		desc = "1re demande au checkpoint choisi. Si refus : redemandée plus tard, à un bon moment, de plus en plus espacée.",
		fields = {
			{ key = "Enabled", label = "Activé", type = "bool", default = true },
			{ key = "Checkpoint", label = "1re demande au checkpoint n°", type = "number", default = 4, min = 1, max = 200, step = 1 },
			{ key = "RetryDays", label = "Redemander après (jours)", type = "number", default = 2, min = 1, max = 60, step = 1,
				help = "Délai avant la 2e demande. Il double ensuite à chaque refus (2 j → 4 j → 8 j…)." },
			{ key = "MaxAsks", label = "Nombre max de demandes", type = "number", default = 4, min = 1, max = 20, step = 1 },
			{ key = "MinSessionMinutes", label = "Redemander après (min de jeu)", type = "number", default = 10, min = 1, max = 120, step = 1,
				help = "Une nouvelle demande arrive seulement quand le joueur joue déjà depuis ce temps (joueur « chaud »)." },
		} },
}

M.ById = {}
for _, p in ipairs(M.Popups) do M.ById[p.id] = p end

-- Nom d'attribut sur ReplicatedStorage.PopupControl
function M.Attr(id, key) return (id == "_G" and "G_" or (id .. "__")) .. key end

-- Valide / borne une valeur venant du panel. Retourne nil si refusée.
function M.Sanitize(field, value)
	if field.type == "bool" then
		if type(value) ~= "boolean" then return nil end
		return value
	elseif field.type == "number" then
		value = tonumber(value)
		if not value or value ~= value or value == math.huge or value == -math.huge then return nil end
		local step = field.step or 1
		value = math.floor(value / step + 0.5) * step
		return math.clamp(value, field.min or 0, field.max or 1e6)
	end
	return nil
end

function M.FindField(id, key)
	local list = (id == "_G") and M.Global or (M.ById[id] and M.ById[id].fields)
	if not list then return nil end
	for _, f in ipairs(list) do if f.key == key then return f end end
	return nil
end

return M
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<string name="Name">PopupGate</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 🚦 PopupGate — ModuleScript dans ReplicatedStorage   (NOUVEAU, côté CLIENT)
--
--  Chaque popup automatique lui demande la permission avant de s'afficher :
--    local Gate = require(ReplicatedStorage:WaitForChild("PopupGate"))
--    if Gate.WaitTurn("vip_offer") then ...afficher... ; Gate.Shown("vip_offer") end
--
--  Il applique les réglages de l'admin (ReplicatedStorage.PopupControl) :
--    • popup / interrupteur général activé ?
--    • mode « seulement si le joueur est inactif depuis X min »
--    • pause minimum entre deux popups automatiques
--  et compte l'affichage pour 📊 STATS (une seule fois par 20 s et par popup).
--
--  Perf : un seul module par joueur (require = mis en cache), 3 petites
--  connexions d'entrée qui ne font qu'écrire un nombre, aucune boucle permanente.
--════════════════════════════════════════════════════════════════════════════
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")

local CFG = require(ReplicatedStorage:WaitForChild("PopupControlConfig"))
local folder = ReplicatedStorage:WaitForChild("PopupControl", 30)

local Gate = {}

local lastInput = os.clock()
local lastAutoShown = -1e9
local lastReported = {}

-- 🕒 activité du joueur (clavier, souris, tactile, manette, déplacement)
UserInputService.InputBegan:Connect(function() lastInput = os.clock() end)
UserInputService.InputChanged:Connect(function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
		or t == Enum.UserInputType.MouseWheel or t.Name:find("Gamepad") then
		lastInput = os.clock()
	end
end)
UserInputService.TouchStarted:Connect(function() lastInput = os.clock() end)

function Gate.IdleSeconds() return os.clock() - lastInput end

-- valeur d'un réglage (défaut du module si l'attribut n'est pas encore arrivé)
function Gate.Get(id, key)
	if folder then
		local v = folder:GetAttribute(CFG.Attr(id, key))
		if v ~= nil then return v end
	end
	local f = CFG.FindField(id, key)
	return f and f.default
end

local function isAuto(p) return p.kind == "timer" or p.kind == "carousel" or p.kind == "deaths" end

-- activé ? (n'attend rien)
function Gate.Enabled(id)
	local p = CFG.ById[id]
	if not p or Gate.Get(id, "Enabled") ~= true then return false end
	if isAuto(p) and Gate.Get("_G", "Enabled") ~= true then return false end
	return true
end

-- autorisé MAINTENANT ? (activé + inactivité + pause mini)
function Gate.Allowed(id)
	if not Gate.Enabled(id) then return false end
	local p = CFG.ById[id]
	if not isAuto(p) then return true end
	if Gate.Get("_G", "IdleOnly") == true then
		local need = (tonumber(Gate.Get("_G", "IdleMinutes")) or 5) * 60
		if Gate.IdleSeconds() < need then return false end
	end
	if p.kind ~= "carousel" then   -- le carrousel défile en continu : pas concerné par la pause
		local gap = tonumber(Gate.Get("_G", "MinGapSeconds")) or 0
		if gap > 0 and os.clock() - lastAutoShown < gap then return false end
	end
	return true
end

-- Attend que le popup ait le droit de s'afficher.
-- Renvoie false tout de suite s'il est désactivé (ou s'il le devient pendant l'attente).
function Gate.WaitTurn(id)
	while true do
		if not Gate.Enabled(id) then return false end
		if Gate.Allowed(id) then return true end
		task.wait(2)
	end
end

-- Attente « minuteur » qui suit le réglage en direct : si l'admin change l'intervalle
-- pendant l'attente, on s'adapte sans attendre la fin de l'ancien délai.
function Gate.WaitMinutes(id, key)
	local t0 = os.clock()
	while true do
		local mins = tonumber(Gate.Get(id, key)) or 10
		if os.clock() - t0 >= mins * 60 then return end
		task.wait(5)
	end
end

-- Le popup vient de s'afficher : pause mini + stats
function Gate.Shown(id)
	local p = CFG.ById[id]
	if p and p.kind ~= "carousel" and isAuto(p) then lastAutoShown = os.clock() end
	local now = os.clock()
	if lastReported[id] and now - lastReported[id] < 20 then return end
	lastReported[id] = now
	local ev = ReplicatedStorage:FindFirstChild("EngageTrack")
	if ev and ev:IsA("RemoteEvent") then pcall(function() ev:FireServer("pop", id) end) end
end

return Gate
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX13">
			<Properties>
				<string name="Name">ServerScriptService</string>
			</Properties>
			<Item class="Folder" referent="RBX14">
				<Properties>
					<string name="Name">CombatSystem</string>
				</Properties>
				<Item class="Script" referent="RBX15">
					<Properties>
						<bool name="Disabled">true</bool>
						<string name="Name">CombatServer</string>
						<ProtectedString name="Source"><![CDATA[--[[
	CombatServer  (Script)
	Emplacement : ServerScriptService > CombatSystem > CombatServer

	• Respawn géré (toutes les morts gardent ton temps normal ; mort en arène tuée par un joueur :
	  vue du tueur pendant Death.SpectateTime, ou moins si le joueur appuie sur une touche)
	• Ragdoll à la mort (module Ragdoll)
	• Kills de la MANCHE : classement, killfeed
	• 🔥 Multi-kills : la série continue tant que le joueur ne meurt pas (plus aucun délai)
	• 🏆 Gagnant de la manche (le plus de kills à la fin du compte à rebours de la map) :
	    +1 win (OrderedDataStore, attribut « ArenaWins » sur le joueur), modèle de son perso publié dans
	    ReplicatedStorage/CombatRoundWinner pour l'écran de vote, avec dans la main l'arme avec laquelle
	    il a fait le plus de kills pendant la manche
	• Relais de la vue du tueur vers la victime (images, manifeste de son arme 1re personne, effets)

	🗺️ MANCHES : ton MapManager appelle
	      _G.CombatRoundStart()  au début de chaque compte à rebours  → kills de la manche remis à 0
	      _G.CombatRoundEnd()    à la fin du compte à rebours         → gagnant désigné
	   (filet : si ces appels manquent, un changement de map remet quand même les kills à 0)
	   Les messages « MapStart » des clients ne remettent rien à zéro : le serveur leur renvoie le classement.

	Ne touche à AUCUN de tes scripts : ton arène (tp1v1) reçoit le respawn comme d'habitude.
	Réglages : ReplicatedStorage/WeaponSystem/CombatSettings
]]

local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService   = game:GetService("DataStoreService")
local ServerStorage      = game:GetService("ServerStorage")

local S = require(ReplicatedStorage:WaitForChild("WeaponSystem"):WaitForChild("CombatSettings"))
local Ragdoll = require(script.Parent:WaitForChild("Ragdoll"))
require(script.Parent:WaitForChild("HitValidator"))   -- démarre l'historique des positions dès le lancement

local function on(section)
	local t = S[section]
	return S.Enabled ~= false and type(t) == "table" and t.Enabled ~= false
end

---------------------------------------------------------------------
-- 📡 remotes
---------------------------------------------------------------------
local folder = ReplicatedStorage:FindFirstChild("CombatRemotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "CombatRemotes"
	folder.Parent = ReplicatedStorage
end
local function ensure(name, class)
	local r = folder:FindFirstChild(name)
	if not r then
		r = Instance.new(class)
		r.Name = name
		r.Parent = folder
	end
	return r
end
local CombatEvent   = ensure("CombatEvent", "RemoteEvent")          -- serveur → clients
local CombatRequest = ensure("CombatRequest", "RemoteEvent")        -- clients → serveur
local Stream        = ensure("SpectateStream", "UnreliableRemoteEvent")

---------------------------------------------------------------------
-- 👑 VIP (même logique que ton profil : attribut IsVIP, _G.IsVIP ou gamepass)
---------------------------------------------------------------------
local vipCache = {}
local function isVip(p)
	if p:GetAttribute("IsVIP") == true then return true end
	if type(_G.IsVIP) == "function" then
		local ok, r = pcall(_G.IsVIP, p.UserId)
		if ok and r then return true end
	end
	local c = vipCache[p.UserId]
	if c ~= nil then return c end
	local pass = S.Death and S.Death.Frame and S.Death.Frame.VipPassId
	if not pass then return false end
	local ok, r = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, p.UserId, pass)
	vipCache[p.UserId] = ok and r or false
	return vipCache[p.UserId]
end

---------------------------------------------------------------------
-- ♻️ RESPAWN GÉRÉ
---------------------------------------------------------------------
local manage = S.Enabled ~= false and S.Respawn and S.Respawn.Manage ~= false and Players.CharacterAutoLoads
local normalTime = (S.Respawn and S.Respawn.NormalTime) or Players.RespawnTime
if manage then
	-- on prend la main : Roblox ne relance plus le perso tout seul (sinon double respawn quand on
	-- relance plus tôt). Chaque mort est relancée par nous après le bon délai.
	Players.RespawnTime = 1e6
end

local pending = {}   -- [player] = { char = mortCharacter, at = os.clock(), done = false, spectate = bool }
local loading = {}   -- [player] = true pendant LoadCharacter (le filet de sécurité attend)

local function load(p)
	if loading[p] then return end
	loading[p] = true
	local ok, err = pcall(p.LoadCharacter, p)
	loading[p] = nil
	if not ok then warn("[CombatSystem] respawn de " .. p.Name .. " : " .. tostring(err)) end
end

local function respawn(p)
	local st = pending[p]
	if not st or st.done then return end
	st.done = true
	if p.Parent and p.Character == st.char then
		load(p)
	end
	if pending[p] == st then pending[p] = nil end
end

local function schedule(p, char, delay, spectate)
	if not manage then return end
	local st = { char = char, at = os.clock(), done = false, spectate = spectate }
	pending[p] = st
	task.delay(delay, function()
		if pending[p] == st then respawn(p) end
	end)
end

-- filet de sécurité : un perso mort sans respawn prévu est relancé après le délai normal
if manage then
	task.spawn(function()
		while true do
			task.wait(1)
			for _, p in ipairs(Players:GetPlayers()) do
				local ch = p.Character
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				-- perso détruit sans mourir (tombé dans le vide…) : traité comme une mort
				if loading[p] or pending[p] then
					-- respawn déjà en cours / prévu
				elseif ch and ch.Parent == nil then
					local t = ch:GetAttribute("CombatDeadAt")
					if not t then
						ch:SetAttribute("CombatDeadAt", os.clock())
					elseif os.clock() - t >= normalTime then
						task.spawn(load, p)
					end
				elseif hum and hum.Health <= 0 then
					local t = ch:GetAttribute("CombatDeadAt")
					if not t then
						ch:SetAttribute("CombatDeadAt", os.clock())
					elseif os.clock() - t >= normalTime + 1 then
						task.spawn(load, p)
					end
				end
			end
		end
	end)
end

---------------------------------------------------------------------
-- 🏆 KILLS DE LA MANCHE (sur ce serveur)
---------------------------------------------------------------------
local kills = {}          -- [userId] = kills de la manche en cours
local deaths = {}         -- [userId] = morts en arène pendant la manche
local heads = {}          -- [userId] = kills en headshot pendant la manche
local roundBest = {}      -- [userId] = meilleure série pendant la manche
local reachedAt = {}      -- [userId] = os.clock() du dernier kill (départage les égalités)
local roundWeap = {}      -- [userId] = { [nom du Tool] = kills } pendant la manche
local weapLabel = {}      -- [nom du Tool] = nom affiché de l'arme (AK47, Scar…)
local mapResetAt = 0
local roundId = 0
local roundHooked = false -- true dès que le MapManager appelle les manches

local streak = {}         -- [userId] = kills d'affilée SANS mourir (survit aux manches)
local lastKillAt = {}     -- [userId] = os.clock() (ancien mode à fenêtre, si ResetOnDeath = false)

local function boardPacket()
	local list = {}
	for uid, k in pairs(kills) do
		local p = Players:GetPlayerByUserId(uid)
		if p then table.insert(list, { u = uid, k = k }) end
	end
	return list
end
local function pushBoard() CombatEvent:FireAllClients("Board", boardPacket()) end
local function hudOn() return on("ArenaHUD") or on("Leaderboard") end
local function sendBoard(p)
	if hudOn() and p.Parent then CombatEvent:FireClient(p, "Board", boardPacket()) end
end

local function clearRound()
	mapResetAt = os.clock()
	table.clear(kills)
	table.clear(deaths)
	table.clear(heads)
	table.clear(roundBest)
	table.clear(reachedAt)
	table.clear(roundWeap)
	if hudOn() then pushBoard() end
end

---------------------------------------------------------------------
-- 🏆 WINS (persistants) + GAGNANT DE MANCHE
---------------------------------------------------------------------
local RW = S.RoundWinner or {}
local winsStore = DataStoreService:GetOrderedDataStore(RW.WinsStore or "ArenaWins_v1")
local winsPending = {}    -- [userId] = wins gagnées pas encore écrites

local winnerFolder = ReplicatedStorage:FindFirstChild("CombatRoundWinner")
if not winnerFolder then
	winnerFolder = Instance.new("Folder")
	winnerFolder.Name = "CombatRoundWinner"
	winnerFolder.Parent = ReplicatedStorage
end
if winnerFolder:GetAttribute("Round") == nil then
	winnerFolder:SetAttribute("WinnerId", 0)
	winnerFolder:SetAttribute("Round", 0)
end

local function loadWins(p)
	task.spawn(function()
		for attempt = 1, 3 do
			local ok, v = pcall(function() return winsStore:GetAsync(tostring(p.UserId)) end)
			if ok then
				if p.Parent then
					p:SetAttribute("ArenaWins", (tonumber(v) or 0) + (winsPending[p.UserId] or 0))
				end
				return
			end
			task.wait(2 * attempt)
		end
	end)
end

local function saveWin(uid)
	for attempt = 1, 5 do
		local ok, newV = pcall(function() return winsStore:IncrementAsync(tostring(uid), 1) end)
		if ok then
			winsPending[uid] = math.max(0, (winsPending[uid] or 1) - 1)
			local p = Players:GetPlayerByUserId(uid)
			if p and type(newV) == "number" then
				p:SetAttribute("ArenaWins", newV + (winsPending[uid] or 0))
			end
			if (winsPending[uid] or 0) == 0 then winsPending[uid] = nil end
			return
		end
		task.wait(3 * attempt)
	end
	warn("[CombatSystem] win non enregistrée pour " .. tostring(uid) .. " (DataStore indisponible)")
end

-- arme favorite de la manche (le Tool avec le plus de kills ; égalité = la première atteinte)
local function favouriteTool(uid)
	local best, bestN
	for name, n in pairs(roundWeap[uid] or {}) do
		if not best or n > bestN then best, bestN = name, n end
	end
	return best
end

local function findToolTemplate(toolName, p)
	if type(toolName) ~= "string" or toolName == "" then return nil end
	local t = ServerStorage:FindFirstChild(toolName)
	if t and t:IsA("Tool") then return t end
	for _, holder in ipairs({ p and p.Character, p and p:FindFirstChildOfClass("Backpack") }) do
		local c = holder and holder:FindFirstChild(toolName)
		if c and c:IsA("Tool") then return c end
	end
	local base = toolName:match("^([^_]+)_")   -- skin introuvable : l'arme de base
	t = base and ServerStorage:FindFirstChild(base)
	if t and t:IsA("Tool") then return t end
	return nil
end

-- 🔫 l'arme dans la main droite du modèle (prise Roblox classique : Right Arm → Handle, tool.Grip)
local STRIP = { "LuaSourceContainer", "Sound", "RemoteEvent", "RemoteFunction", "UnreliableRemoteEvent", "BindableEvent",
	"BindableFunction", "ParticleEmitter", "Light", "Beam", "Trail", "BillboardGui", "SurfaceGui", "ProximityPrompt",
	"ValueBase", "JointInstance", "WeldConstraint", "Constraint", "Attachment", "Fire", "Smoke", "Sparkles", "Highlight" }
local function attachWeapon(model, toolName, p)
	local arm = model:FindFirstChild("Right Arm")
	local src = findToolTemplate(toolName, p)
	if not (arm and src) then return end
	local arch = src.Archivable
	src.Archivable = true
	local ok, tool = pcall(function() return src:Clone() end)
	src.Archivable = arch
	if not ok or not tool then return end
	local handle = tool:FindFirstChild("Handle")
	if not (handle and handle:IsA("BasePart")) then tool:Destroy() return end
	local grip = tool.Grip
	for _, d in ipairs(tool:GetDescendants()) do
		for _, cls in ipairs(STRIP) do
			if d:IsA(cls) then pcall(function() d:Destroy() end) break end
		end
	end
	-- chaque pièce soudée au Handle à sa place d'origine (aucune physique dans l'écran de vote)
	local hcf = handle.CFrame
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.Massless = true
			if d ~= handle then
				local w = Instance.new("Weld")
				w.Name = "WinnerHold"; w.Part0 = handle; w.Part1 = d
				w.C0 = hcf:ToObjectSpace(d.CFrame)
				w.Parent = handle
			end
		end
	end
	local weap = Instance.new("Model")
	weap.Name = "WinnerWeapon"
	for _, c in ipairs(tool:GetChildren()) do c.Parent = weap end
	tool:Destroy()
	weap.PrimaryPart = handle
	local g = Instance.new("Weld")
	g.Name = "RightGrip"; g.Part0 = arm; g.Part1 = handle
	g.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	g.C1 = grip
	g.Parent = arm
	weap.Parent = model
end

-- 🧍 POSE DES BRAS DE TON SYSTÈME D'ARMES : la même que WeaponWeld en jeu (épaules coupées,
--    bras soudés au Torso avec les C1 de l'arme → les DEUX mains tiennent l'arme).
--    Les C1 sont lus sur l'arme du joueur (attributs WeldLeftBaseC1 / WeldRightBaseC1 posés par
--    le Script « Weld » de l'arme). Arme de ServerStorage sans attribut : on fait tourner son Script
--    de weld UNE fois, seul (les autres scripts coupés), dans un dossier caché. Résultat mis en cache.
local armCache = {}
local function readArms(t)
	local l, r = t and t:GetAttribute("WeldLeftBaseC1"), t and t:GetAttribute("WeldRightBaseC1")
	if typeof(l) == "CFrame" and typeof(r) == "CFrame" then return { Left = l, Right = r } end
	return nil
end
local function armConfig(toolName, p)
	if type(toolName) ~= "string" then return nil end
	for _, holder in ipairs({ p and p.Character, p and p:FindFirstChildOfClass("Backpack") }) do
		local c = readArms(holder and holder:FindFirstChild(toolName))
		if c then armCache[toolName] = c; return c end
	end
	if armCache[toolName] ~= nil then return armCache[toolName] or nil end
	local src = findToolTemplate(toolName, p)
	local c = readArms(src)
	if not c and src then
		local arch = src.Archivable
		src.Archivable = true
		local okC, probe = pcall(function() return src:Clone() end)
		src.Archivable = arch
		if okC and probe then
			local hasWeld = false
			for _, d in ipairs(probe:GetDescendants()) do
				if d:IsA("BaseScript") then
					if d.ClassName == "Script" and string.find(string.lower(d.Name), "weld", 1, true) then
						hasWeld = true
					else
						d.Enabled = false
					end
				end
			end
			if hasWeld then
				local f = Instance.new("Folder")
				f.Name = "WinnerWeldProbe"
				probe.Parent = f
				f.Parent = game:GetService("ServerScriptService")
				local t0 = os.clock()
				while not c and os.clock() - t0 < 3 do
					task.wait(0.1)
					c = readArms(probe)
				end
				f:Destroy()
			else
				probe:Destroy()
			end
		end
	end
	armCache[toolName] = c or false
	return c
end
local function weldArms(model, cfg)
	local torso = model:FindFirstChild("Torso")
	local la, ra = model:FindFirstChild("Left Arm"), model:FindFirstChild("Right Arm")
	if not (cfg and torso and la and ra) then return end
	for _, n in ipairs({ "Left Shoulder", "Right Shoulder" }) do
		local j = torso:FindFirstChild(n)
		if j then j.Part1 = nil end
	end
	local function w(name, arm, c1)
		local x = Instance.new("Weld")
		x.Name = name; x.Part0 = torso; x.Part1 = arm; x.C1 = c1
		x.Parent = torso
	end
	w("LeftArmWeld", la, cfg.Left)
	w("RightArmWeld", ra, cfg.Right)
end

-- modèle du perso du gagnant (R6) pour l'écran de vote : construit ici, cloné par les clients
local function buildWinnerModel(id, uid, p, toolName)
	local model
	local okD, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(uid) end)
	if okD and desc then
		local okM, m = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
		end)
		if okM then model = m end
	end
	if not model and p and p.Character then
		local ch = p.Character
		local arch = ch.Archivable
		ch.Archivable = true
		local okC, c = pcall(function() return ch:Clone() end)
		ch.Archivable = arch
		if okC then model = c end
	end
	if not model then return end
	if id ~= roundId then model:Destroy() return end   -- une manche plus récente est déjà passée

	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Tool") or d:IsA("ForceField") or d:IsA("Sound")
			or d:IsA("BillboardGui") or d:IsA("Highlight") or d:IsA("ParticleEmitter") or d:IsA("Light")
			or d:IsA("ProximityPrompt") or d:IsA("Constraint") then
			pcall(function() d:Destroy() end)
		elseif d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		if not hum:FindFirstChildOfClass("Animator") then Instance.new("Animator").Parent = hum end
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = true; hrp.Transparency = 1 end
	if RW.HoldWeapon ~= false then
		pcall(weldArms, model, armConfig(toolName, p))   -- avant l'arme : la prise suit le bras soudé
		pcall(attachWeapon, model, toolName, p)
	end
	if id ~= roundId then model:Destroy() return end   -- (le weld a pu attendre jusqu'à 3 s)
	model.Name = "Winner"
	model.Archivable = true
	model:SetAttribute("Round", id)

	local old = winnerFolder:FindFirstChild("Winner")
	if old then old:Destroy() end
	model.Parent = winnerFolder
end

local function pickWinner()
	local best, bestK, bestAt
	local minK = tonumber(RW.MinKills) or 1
	for uid, k in pairs(kills) do
		local p = Players:GetPlayerByUserId(uid)
		if p and k >= minK then
			local at = reachedAt[uid] or 0
			if not best or k > bestK or (k == bestK and at < bestAt) then
				best, bestK, bestAt = p, k, at   -- égalité : celui qui y est arrivé en premier
			end
		end
	end
	return best, bestK
end

-- début d'une manche (début du compte à rebours de la map)
_G.CombatRoundStart = function()
	roundHooked = true
	clearRound()
end
-- compatibilité avec l'ancien patch du MapManager (swapTo)
_G.CombatMapStart = _G.CombatRoundStart

-- fin d'une manche (fin du compte à rebours) : désigne le gagnant
_G.CombatRoundEnd = function()
	roundHooked = true
	if not on("RoundWinner") then return nil end
	roundId += 1
	local id = roundId
	local p, k = pickWinner()
	if not p then
		winnerFolder:SetAttribute("WinnerId", 0)
		winnerFolder:SetAttribute("Round", id)
		local old = winnerFolder:FindFirstChild("Winner")
		if old then old:Destroy() end
		return nil
	end

	local uid = p.UserId
	local wins = (tonumber(p:GetAttribute("ArenaWins")) or 0) + 1
	p:SetAttribute("ArenaWins", wins)
	winsPending[uid] = (winsPending[uid] or 0) + 1
	task.spawn(saveWin, uid)

	local favTool = favouriteTool(uid)
	local info = {
		round = id, userId = uid, name = p.Name, displayName = p.DisplayName,
		kills = k, deaths = deaths[uid] or 0, headshots = heads[uid] or 0,
		best = roundBest[uid] or 0, wins = wins, map = _G.CurrentMap,
		totalKills = tonumber(p:GetAttribute("TotalKills")) or 0,   -- total de kills de son profil
		tool = favTool, weapon = favTool and (weapLabel[favTool] or favTool:match("^([^_]+)_") or favTool) or nil,
	}
	winnerFolder:SetAttribute("WinnerId", uid)
	winnerFolder:SetAttribute("Name", info.name)
	winnerFolder:SetAttribute("DisplayName", info.displayName)
	winnerFolder:SetAttribute("Kills", info.kills)
	winnerFolder:SetAttribute("Deaths", info.deaths)
	winnerFolder:SetAttribute("Headshots", info.headshots)
	winnerFolder:SetAttribute("BestStreak", info.best)
	winnerFolder:SetAttribute("Wins", info.wins)
	winnerFolder:SetAttribute("MapKey", tostring(info.map or ""))
	winnerFolder:SetAttribute("Round", id)   -- en dernier : les clients relisent tout quand il change
	CombatEvent:FireAllClients("RoundWinner", info)
	task.spawn(buildWinnerModel, id, uid, p, favTool)
	print(("🏆 Manche %d : %s gagne avec %d kills (%d wins)"):format(id, p.Name, k, wins))
	return info
end

---------------------------------------------------------------------
-- 🗺️ FILET : changement de map sans les appels de manche du MapManager
---------------------------------------------------------------------
local function mapIdentity()
	if type(_G.GetCurrentMapInfo) == "function" then
		local ok, info = pcall(_G.GetCurrentMapInfo)
		if ok and type(info) == "table" then
			for _, k in ipairs({ "model", "Model", "map", "Map", "instance", "Instance" }) do
				if typeof(info[k]) == "Instance" then return info[k] end
			end
		end
	end
	return _G.CurrentMap
end

task.spawn(function()
	local lastMap = mapIdentity()
	while true do
		task.wait(1)
		local id = mapIdentity()
		if id ~= nil and id ~= lastMap then
			local first = (lastMap == nil)
			lastMap = id
			if not first and not roundHooked and os.clock() - mapResetAt > 5 then clearRound() end
		end
	end
end)

---------------------------------------------------------------------
-- 👁️ VUE DU TUEUR : qui regarde qui
---------------------------------------------------------------------
local watchers = {}        -- [killer] = { [victim] = expire }
local lastManifest = {}     -- [killer] = dernier manifeste (une 2e victime le reçoit tout de suite)
local function stopWatch(killer, victim)
	local w = watchers[killer]
	if not w then return end
	w[victim] = nil
	if next(w) == nil then
		watchers[killer] = nil
		-- ⚡ LAG PVP : le manifeste est GARDÉ (avant : effacé, et le tueur le renvoyait en entier à
		--    chaque kill). Effacé seulement quand le tueur réapparaît ou quitte (nouvelles armes).
		if killer.Parent then CombatEvent:FireClient(killer, "StreamStop") end
	end
end

-- envoie à toutes les victimes qui regardent ce tueur
local function relay(killer, fn)
	local w = watchers[killer]
	if not w then return end
	local now = os.clock()
	for victim, expire in pairs(w) do
		if now > expire or not victim.Parent then
			stopWatch(killer, victim)
		else
			fn(victim)
		end
	end
end

-- limite d'envois par seconde (anti-spam)
local budget = {}
local function allow(killer, kind, max)
	local key = kind .. killer.UserId
	local b = budget[key]
	local now = os.clock()
	if not b or now - b.t >= 1 then b = { t = now, n = 0 }; budget[key] = b end
	b.n += 1
	return b.n <= max
end

-- images de la vue (buffer compact, non fiable, ~30 / s)
Stream.OnServerEvent:Connect(function(killer, packet)
	if not watchers[killer] or typeof(packet) ~= "buffer" or buffer.len(packet) > 900 then return end
	if not allow(killer, "img", 70) then return end
	relay(killer, function(victim) Stream:FireClient(victim, killer, packet) end)
end)

---------------------------------------------------------------------
-- 💀 MORT
---------------------------------------------------------------------
local function killerOf(hum)
	local tag = hum:FindFirstChild("creator")
	local k = tag and tag:IsA("ObjectValue") and tag.Value
	if k and k:IsA("Player") then return k end
	local uid = hum:GetAttribute("CombatLastHitBy")
	local at = hum:GetAttribute("CombatLastAt")
	if uid and at and os.clock() - at < 5 then
		return Players:GetPlayerByUserId(uid)
	end
	return nil
end

local function onDied(p, char, hum)
	if pending[p] and pending[p].char == char then return end
	-- un tueur qui meurt arrête d'envoyer sa vue (échange de kills)
	if watchers[p] then
		for v in pairs(watchers[p]) do stopWatch(p, v) end
	end
	local inArena = p:GetAttribute("InArena") == true
	local killer = killerOf(hum)
	if killer == p then killer = nil end

	-- 🔥 la série de la victime s'arrête à sa mort
	local M = S.MultiKill or {}
	if M.ResetOnDeath ~= false then streak[p.UserId] = nil end
	if inArena then deaths[p.UserId] = (deaths[p.UserId] or 0) + 1 end

	local victimRoot = char:FindFirstChild("HumanoidRootPart")
	local kChar = killer and killer.Character
	local kRoot = kChar and kChar:FindFirstChild("HumanoidRootPart")
	local kHum = kChar and kChar:FindFirstChildOfClass("Humanoid")
	local head = hum:GetAttribute("CombatLastHead") == true
	local weapon = hum:GetAttribute("CombatLastWeapon")
	local toolName = hum:GetAttribute("CombatLastTool")
	if (not weapon) and kChar then
		local t = kChar:FindFirstChildOfClass("Tool")
		if t then weapon = t.Name:match("^([^_]+)_") or t.Name; toolName = t.Name end
	end
	local dist = hum:GetAttribute("CombatLastDist")
	if (not dist) and kRoot and victimRoot then dist = (kRoot.Position - victimRoot.Position).Magnitude end

	-- 🪆 ragdoll
	if on("Ragdoll") and (not S.Ragdoll.OnlyInArena or inArena) then
		local push = Vector3.zero
		if kRoot and victimRoot then
			local dir = victimRoot.Position - kRoot.Position
			dir = Vector3.new(dir.X, 0, dir.Z)
			if dir.Magnitude > 0.01 then
				local R = S.Ragdoll
				push = dir.Unit * (head and (R.HeadshotImpulse or 52) or (R.Impulse or 38)) + Vector3.new(0, R.UpImpulse or 10, 0)
			end
		end
		pcall(Ragdoll.Apply, char, push)
	elseif on("Ragdoll") then
		pcall(Ragdoll.Break, char)   -- pas de ragdoll ici : le corps tombe en morceaux comme avant
	end

	-- 🏆 kills d'arène : classement, killfeed, multi-kill, stats de manche
	if killer and inArena then
		local uid = killer.UserId
		local now = os.clock()
		kills[uid] = (kills[uid] or 0) + 1
		reachedAt[uid] = now
		if head then heads[uid] = (heads[uid] or 0) + 1 end
		local tk = (toolName ~= nil and toolName ~= "") and toolName or weapon
		if tk and tk ~= "" then
			roundWeap[uid] = roundWeap[uid] or {}
			roundWeap[uid][tk] = (roundWeap[uid][tk] or 0) + 1
			weapLabel[tk] = weapon or weapLabel[tk]
		end
		if hudOn() then pushBoard() end
		if on("Killfeed") or on("ArenaHUD") then
			CombatEvent:FireAllClients("Feed", { k = killer.UserId, v = p.UserId, w = weapon or "", h = head, t = toolName or "" })
		end

		-- 🔥 série : tant que le tueur ne meurt pas (ou ancien mode à fenêtre)
		local n = streak[uid] or 0
		if M.ResetOnDeath == false and lastKillAt[uid] and now - lastKillAt[uid] > (M.Window or 4) then n = 0 end
		n += 1
		streak[uid] = n
		lastKillAt[uid] = now
		if n > (roundBest[uid] or 0) then roundBest[uid] = n end
		if on("MultiKill") and n >= 2 then CombatEvent:FireClient(killer, "MultiKill", n) end
	end

	-- 👁️ vue du tueur (+ bande d'infos)
	local spectate = killer ~= nil and killer.Parent ~= nil and on("Death")
		and kHum ~= nil and kHum.Health > 0
		and (not S.Death.OnlyInArena or inArena)
	if spectate then
		local D = S.Death
		local info = {
			killer = killer,
			weapon = weapon or "",
			tool = toolName or "",
			head = head,
			dist = dist and math.floor(dist + 0.5) or nil,
			hp = kHum and math.max(0, math.ceil(kHum.Health)) or nil,
			maxHp = kHum and math.ceil(kHum.MaxHealth) or nil,
			vip = false,
			time = D.SpectateTime or 5,
			body = char,   -- ton corps (ragdoll) : la victime l'affiche pendant la vue du tueur
		}
		info.vip = isVip(killer)
		CombatEvent:FireClient(p, "Spectate", info)
		watchers[killer] = watchers[killer] or {}
		watchers[killer][p] = os.clock() + (D.SpectateTime or 5) + 1
		if lastManifest[killer] then CombatEvent:FireClient(p, "KVM", killer, lastManifest[killer]) end
		CombatEvent:FireClient(killer, "StreamStart", p)
		-- monde chargé autour du tueur (StreamingEnabled) : sa vue est complète
		pcall(function() p.ReplicationFocus = kRoot end)
		schedule(p, char, D.SpectateTime or 5, true)
	else
		schedule(p, char, normalTime, false)
	end
end

local function onCharacter(p, char)
	-- fin d'une vue du tueur : on libère le tueur
	for killer, w in pairs(watchers) do
		if w[p] then stopWatch(killer, p) end
	end
	if pending[p] and pending[p].char ~= char then pending[p] = nil end
	lastManifest[p] = nil   -- nouveau perso = nouvelles armes : son prochain manifeste repart de zéro
	pcall(function() p.ReplicationFocus = nil end)
	if on("Ragdoll") then Ragdoll.Prepare(char) end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
	if not hum then return end
	if on("Ragdoll") then Ragdoll.Prepare(char) end
	hum.Died:Connect(function()
		char:SetAttribute("CombatDeadAt", os.clock())
		onDied(p, char, hum)
	end)
end

local function onPlayer(p)
	p.CharacterAdded:Connect(function(c) onCharacter(p, c) end)
	if p.Character then task.spawn(onCharacter, p, p.Character) end
	loadWins(p)
	-- entrée dans l'arène : top kills ACTUEL de la manche ; sortie : la série s'arrête
	p:GetAttributeChangedSignal("InArena"):Connect(function()
		if p:GetAttribute("InArena") == true then
			task.delay(0.5, function() sendBoard(p) end)
		elseif (S.MultiKill or {}).ResetOnLeaveArena ~= false then
			streak[p.UserId] = nil
		end
	end)
	if hudOn() then task.delay(2, function() sendBoard(p) end) end
end
for _, p in ipairs(Players:GetPlayers()) do onPlayer(p) end
Players.PlayerAdded:Connect(onPlayer)

Players.PlayerRemoving:Connect(function(p)
	pending[p] = nil
	-- (kills / stats de manche GARDÉS : s'il revient pendant la même manche il retrouve son score)
	streak[p.UserId] = nil
	lastKillAt[p.UserId] = nil
	vipCache[p.UserId] = nil
	budget["img" .. p.UserId], budget["kve" .. p.UserId], budget["kvm" .. p.UserId], budget["kvq" .. p.UserId] = nil, nil, nil, nil
	budget["brd" .. p.UserId] = nil
	lastManifest[p] = nil
	watchers[p] = nil
	for killer, w in pairs(watchers) do
		if w[p] then stopWatch(killer, p) end
	end
	if hudOn() then pushBoard() end
end)

---------------------------------------------------------------------
-- 📨 requêtes des clients (vue du tueur, classement, skip)
---------------------------------------------------------------------
CombatRequest.OnServerEvent:Connect(function(p, action, data)
	if action == "KVM" then
		-- manifeste de la vue du tueur : les pièces de son arme 1re personne
		if not watchers[p] or type(data) ~= "table" or type(data.list) ~= "table" or #data.list > 250 then return end
		lastManifest[p] = data   -- gardé même si l'envoi est limité : la victime peut le redemander
		if not allow(p, "kvm", 6) then return end
		relay(p, function(victim) CombatEvent:FireClient(victim, "KVM", p, data) end)
		return
	elseif action == "KVReq" then
		-- la victime n'a pas reçu le manifeste : on lui renvoie le dernier
		local killer = data
		if typeof(killer) ~= "Instance" or not killer:IsA("Player") then return end
		local w = watchers[killer]
		if not w or not w[p] or not lastManifest[killer] then return end
		if not allow(p, "kvq", 3) then return end
		CombatEvent:FireClient(p, "KVM", killer, lastManifest[killer])
		return
	elseif action == "KVE" then
		-- effets du tueur (flash, douilles, hitmarkers, sons…)
		if not watchers[p] or type(data) ~= "table" or #data > 64 then return end
		if not allow(p, "kve", 70) then return end
		relay(p, function(victim) CombatEvent:FireClient(victim, "KVE", p, data) end)
		return
	end
	if action == "MapStart" then
		-- un client ne remet JAMAIS rien à zéro : on lui renvoie juste le classement actuel
		if allow(p, "brd", 2) then sendBoard(p) end
		return
	end
	if action == "Respawn" then
		local st = pending[p]
		if not st or not st.spectate then return end
		if os.clock() - st.at < (S.Death.SkipDelay or 0.4) - 0.1 then return end
		respawn(p)
	end
end)

print(("✅ CombatSystem serveur prêt (respawn géré : %s, temps normal %.1f s)"):format(tostring(manage), normalTime))]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX16">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">10 died = offer 2500 points</string>
					<ProtectedString name="Source"><![CDATA[-- ════════════════════════════════════════════════════════════════════════
-- 💀 OFFRE APRÈS DES MORTS — Script dans ServerScriptService (remplace tout le script)
--
--  Réglages : ADMIN PANEL ▸ 🔔 POPUPS ▸ « 💀 Offre après des morts »
--    • Activé · petit pack toutes les X morts · gros pack toutes les Y morts
--    • compter (ou non) les morts en arène PvP
--  Défauts = comportement d'avant (10 morts → petit pack, 20 morts → gros pack).
--
--  🩹 Corrigé : avant, le script attendait 10 s AVANT d'écouter le personnage :
--     les morts de la toute première vie n'étaient jamais comptées.
--  🔔 Mode « seulement si inactif » : un joueur qui meurt n'est pas inactif,
--     donc pas d'offre de mort dans ce mode.
-- ════════════════════════════════════════════════════════════════════════
local MarketplaceService = require(game.ReplicatedStorage.MarketplaceServiceFX)
local Players = game:GetService("Players")

local PRODUCT_SMALL = 3606598763   -- petit pack (avant : « 5 morts »)
local PRODUCT_BIG   = 3606598188   -- gros pack  (avant : « 10 morts »)
local POPUP_ID = "death_offer"

local playerDeaths = {}

local function setting(key, default)
	local pc = _G.PopupControl
	if pc and pc.Get then
		local v = pc.Get(POPUP_ID, key)
		if v ~= nil then return v end
	end
	return default
end

local function offerAllowed()
	local pc = _G.PopupControl
	if not (pc and pc.IsOn) then return true end            -- système absent : comportement d'avant
	if not pc.IsOn(POPUP_ID) then return false end
	if pc.Get("_G", "IdleOnly") == true then return false end -- il meurt → il n'est pas inactif
	return true
end

local function inArena(player)
	return (_G.PlayersInArena and _G.PlayersInArena[player.UserId]) or player:GetAttribute("InArena") == true
end

local function onDied(player)
	if not player.Parent then return end
	if setting("CountArena", true) ~= true and inArena(player) then return end
	local deaths = (playerDeaths[player.UserId] or 0) + 1
	playerDeaths[player.UserId] = deaths

	local every = math.max(1, math.floor(tonumber(setting("EveryDeaths", 10)) or 10))
	local big   = math.max(1, math.floor(tonumber(setting("BigEveryDeaths", 20)) or 20))
	local productId
	if deaths % big == 0 then
		productId = PRODUCT_BIG
	elseif deaths % every == 0 then
		productId = PRODUCT_SMALL
	end
	if not productId or not offerAllowed() then return end

	task.wait(2)
	if not player.Parent then return end
	local es = _G.EngageStats
	if es and es.PopupShown then pcall(es.PopupShown, player, POPUP_ID) end
	pcall(function() MarketplaceService:PromptProductPurchase(player, productId) end)
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end
	humanoid.Died:Once(function() task.spawn(onDied, player) end)
end

local function onPlayer(player)
	playerDeaths[player.UserId] = 0
	player.CharacterAdded:Connect(function(c) onCharacter(player, c) end)
	if player.Character then task.spawn(onCharacter, player, player.Character) end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end

Players.PlayerRemoving:Connect(function(player)
	playerDeaths[player.UserId] = nil
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX17">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">DAILY TOOLs</string>
					<ProtectedString name="Source"><![CDATA[-- ServerScript SÉCURISÉ à placer dans ServerScriptService
-- VERSION CORRIGÉE v4 (7 JOURS) :
--   • Passage de 5 à 7 jours
--   • Rewards : 1=SpeedCoil, 2=5k pts, 3=Gravity Coil, 4=FusionCoil, 5=5k pts, 6=SpeedCoil, 7=Jetpack
--   • Fix Bug #1 : DataStore failure ne reset plus à day 1
--   • Fix Bug #2 : Outils alignés (day 3 = Gravity Coil, day 4 = FusionCoil)
--   • Fix Bug #3 : Timer 10 min appliqué dès PlayerAdded (plus bypass possible)
--   • Fix Bug #4 : firstJoinAt persisté dans DataStore (timer survit aux rejoins)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
-- ⏳ ATTENDRE QUE LE SCRIPT PRINCIPAL SOIT CHARGÉ
local maxWait = 100
local waited = 0
while (not _G.tempsJoueurs or not _G.SmartAntiCheat) and waited < maxWait do
	task.wait(0.1)
	waited = waited + 1
end
if not _G.tempsJoueurs or not _G.SmartAntiCheat then
	error("❌ ERREUR CRITIQUE: Script principal non chargé!")
end
local SmartAntiCheat = _G.SmartAntiCheat
local AntiExploit = _G.AntiExploit or {
	CheckRemoteCall = function() return true end,
	CheckQuestCooldown = function() return true end,
}
-- DataStore
local DailyRewardsStore = DataStoreService:GetDataStore("DailyRewardsData_v2")
-- ========================================
-- CONFIG (7 jours)
-- ========================================
local REWARDS_CONFIG = {
	{day = 1, toolName = "SpeedCoil",    isPoints = false},
	{day = 2, toolName = nil,            isPoints = true, points = 5000},
	{day = 3, toolName = "Gravity Coil", isPoints = false},
	{day = 4, toolName = "FusionCoil",   isPoints = false},
	{day = 5, toolName = nil,            isPoints = true, points = 5000},
	{day = 6, toolName = "SpeedCoil",    isPoints = false},
	{day = 7, toolName = "Jetpack",      isPoints = false},
}
local TOTAL_DAYS = #REWARDS_CONFIG
local ADMIN_IDS = {11017023724, 8142402169}
local NOTIFICATION_DELAY = 25
local FIRST_JOIN_DELAY = 900 -- 10 minutes
local GroupId = 684717971
local playerTools = {}
local activeNotifications = {}
local dailyClaimCooldowns = {}
local dailyRewardClickCooldown = {}
local playerDataCache = {}
-- 🆕 Timer premier join (sync avec data.firstJoinAt dans DataStore)
local firstJoinTimers = {}
-- ========================================
-- 🛡️ DATASTORE LOAD/SAVE SÉCURISÉ (fix bug #1)
-- ========================================
local function loadPlayerData(player)
	local maxAttempts = 3
	for attempt = 1, maxAttempts do
		local success, data = pcall(function()
			return DailyRewardsStore:GetAsync("Player_" .. player.UserId)
		end)
		if success then
			if data then
				if data.firstJoinAt == nil then data.firstJoinAt = 0 end
				return data, true
			else
				return {
					currentDay    = 1,
					lastClaimDate = "",
					claimedToday  = false,
					firstJoinAt   = 0,
				}, true
			end
		else
			warn(string.format("⚠️ DailyRewards: load tentative %d échouée pour %s : %s",
				attempt, player.Name, tostring(data)))
			if attempt < maxAttempts then task.wait(2) end
		end
	end
	-- Échec total → return nil (BLOQUE toute écriture)
	warn(string.format("❌ DailyRewards: impossible de charger %s, écritures bloquées", player.Name))
	return nil, false
end
local function savePlayerData(player, data)
	if not data then
		warn("⚠️ savePlayerData: data nil, save annulée pour " .. player.Name)
		return false
	end
	local success, err = pcall(function()
		DailyRewardsStore:SetAsync("Player_" .. player.UserId, data)
	end)
	if not success then
		warn("Failed to save data for " .. player.Name .. ": " .. tostring(err))
	end
	return success
end
-- ========================================
-- 🆕 PREMIER JOIN
-- ========================================
local function isFirstEverJoin(data)
	return data.currentDay == 1 and data.lastClaimDate == "" and not data.claimedToday
end
-- 🛡️ DÉFENSIF : si timer pas encore initialisé, on bloque par défaut (fix bug #3)
local function getFirstJoinTimeRemaining(userId)
	local joinTime = firstJoinTimers[userId]
	if not joinTime then
		return FIRST_JOIN_DELAY
	end
	local elapsed = os.time() - joinTime
	local remaining = FIRST_JOIN_DELAY - elapsed
	return math.max(0, remaining)
end
-- ========================================
-- 🛡️ FONCTION SÉCURISÉE POINTS (jours 2 & 5)
-- ========================================
local function giveDailyPoints(player, pointsAmount)
	if not player or not player.Parent then return false end
	local userId = player.UserId
	local rawPoints = pointsAmount or 5000
	-- ✅ FIX FAUX-BAN : plus de CheckQuestCooldown / CheckRemoteCall ici.
	-- La vraie protection anti-farm est data.claimedToday (vérifié dans le handler
	-- AVANT d'arriver ici) : 1 seul claim par jour calendaire, côté serveur/DataStore.
	-- CheckQuestCooldown bannissait sur un simple re-claim (bug UI / save raté) sans
	-- rien protéger de plus. L'anti-spam local 5s ci-dessous reste en place.
	local now = os.time()
	if dailyClaimCooldowns[userId] and (now - dailyClaimCooldowns[userId]) < 5 then
		warn(player.Name .. " spam détecté sur Daily Rewards")
		return false
	end
	dailyClaimCooldowns[userId] = now
	if not _G.tempsJoueurs then warn("❌ tempsJoueurs not initialized!") return false end
	if type(_G.tempsJoueurs[userId]) ~= "table" then
		_G.tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end
	task.spawn(function()
		SmartAntiCheat.ExpectGain(userId, rawPoints, "DailyRewardPoints")
	end)
	_G.tempsJoueurs[userId].future = _G.tempsJoueurs[userId].future + rawPoints
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = _G.tempsJoueurs[userId].base + _G.tempsJoueurs[userId].future
		if _G.applyAllBonuses and _G.calculatePoints then
			pointsStat.Value = _G.applyAllBonuses(_G.calculatePoints(totalPoints), player)
		else
			pointsStat.Value = totalPoints
		end
		player:SetAttribute("Points", pointsStat.Value)
	end
	task.spawn(function() SmartAntiCheat.RecordGain(player, rawPoints, "DailyRewardPoints") end)
	if _G.secureSave then
		task.spawn(function()
			local totalPoints = _G.tempsJoueurs[userId].base + _G.tempsJoueurs[userId].future
			_G.secureSave(userId, totalPoints)
		end)
	end
	local buyGamePassEvent = ReplicatedStorage:FindFirstChild("applepay")
	if buyGamePassEvent then
		pcall(function() buyGamePassEvent:FireClient(player) end)
	end
	print(string.format("✅ DAILY POINTS: %s a reçu %d points (bruts) → %d affichés",
		player.Name, rawPoints, pointsStat and pointsStat.Value or 0))
	return true
end
-- ========================================
-- UTILITAIRES
-- ========================================
local function getTimezoneOffset(player)
	local LocalizationService = game:GetService("LocalizationService")
	local success, result = pcall(function()
		return LocalizationService:GetCountryRegionForPlayerAsync(player)
	end)
	if not success or not result then return 0 end
	if result == "US" or result == "CA" or result == "MX" then return -5 * 3600
	elseif result == "GB" or result == "FR" or result == "DE" or result == "ES" or result == "IT" then return 1 * 3600
	elseif result == "JP" or result == "KR" then return 9 * 3600
	elseif result == "AU" then return 10 * 3600
	elseif result == "BR" then return -3 * 3600
	end
	return 0
end
local function getMidnightTodayForPlayer(player)
	local timezoneOffset = getTimezoneOffset(player)
	local localTime = os.time() + timezoneOffset
	local localDateTable = os.date("!*t", localTime)
	localDateTable.hour, localDateTable.min, localDateTable.sec = 0, 0, 0
	return os.time(localDateTable) - timezoneOffset
end
local function getNextMidnightForPlayer(player)
	return getMidnightTodayForPlayer(player) + 86400
end
local function getCurrentDateForPlayer(player)
	local localTime = os.time() + getTimezoneOffset(player)
	return os.date("!%Y-%m-%d", localTime)
end
local function isAdmin(player)
	if player.UserId == game.CreatorId then return true end
	for _, adminId in ipairs(ADMIN_IDS) do
		if player.UserId == adminId then return true end
	end
	return false
end
local function giveTool(player, toolName)
	local tool = ServerStorage:FindFirstChild(toolName)
	if not tool then warn("Tool not found in ServerStorage: " .. toolName) return false end
	if not playerTools[player.UserId] then playerTools[player.UserId] = {} end
	if table.find(playerTools[player.UserId], toolName) then return true end
	table.insert(playerTools[player.UserId], toolName)
	--  pas de 2e copie s'il l'a déjà (gamepass, en main…)
	local bpD = player:FindFirstChild("Backpack")
	if bpD and not bpD:FindFirstChild(toolName)
		and not (player.Character and player.Character:FindFirstChild(toolName)) then
		local clonedTool = tool:Clone()
		clonedTool.Parent = bpD
	end
	local starterGear = player:FindFirstChild("StarterGear")
	if not starterGear then
		starterGear = Instance.new("Folder")
		starterGear.Name = "StarterGear"
		starterGear.Parent = player
	end
	if not starterGear:FindFirstChild(toolName) then
		local starterTool = tool:Clone()
		starterTool.Parent = starterGear
	end
	return true
end
local function checkAndUpdateNewDay(player, data)
	local currentDate = getCurrentDateForPlayer(player)
	if data.lastClaimDate == "" or data.lastClaimDate ~= currentDate then
		data.claimedToday = false
		return true
	end
	return false
end
local function startNotificationTimer(player, currentDay)
	if activeNotifications[player.UserId] then
		task.cancel(activeNotifications[player.UserId])
		activeNotifications[player.UserId] = nil
	end
	local timerThread = task.delay(NOTIFICATION_DELAY, function()
		if not player or not player.Parent then
			activeNotifications[player.UserId] = nil
			return
		end
		local data, ok = loadPlayerData(player)
		if ok and data and not data.claimedToday then
			local showDailyNotificationEvent = ReplicatedStorage:FindFirstChild("ShowDailyNotificationEvent")
			if showDailyNotificationEvent then
				pcall(function() showDailyNotificationEvent:FireClient(player, currentDay) end)
			end
		end
		activeNotifications[player.UserId] = nil
	end)
	activeNotifications[player.UserId] = timerThread
end
local function cancelNotificationTimer(player)
	if activeNotifications[player.UserId] then
		task.cancel(activeNotifications[player.UserId])
		activeNotifications[player.UserId] = nil
		local cancelDailyNotificationEvent = ReplicatedStorage:FindFirstChild("CancelDailyNotificationEvent")
		if cancelDailyNotificationEvent then
			pcall(function() cancelDailyNotificationEvent:FireClient(player) end)
		end
	end
end
local function resetPlayerData(player)
	local now = os.time()
	local defaultData = {
		currentDay    = 1,
		lastClaimDate = "",
		claimedToday  = false,
		firstJoinAt   = now,  -- 🆕 reset = nouveau premier join
	}
	local success = savePlayerData(player, defaultData)
	if not success then
		warn("Failed to reset data for player: " .. player.Name)
		return false
	end
	cancelNotificationTimer(player)
	firstJoinTimers[player.UserId] = now
	playerDataCache[player.UserId] = {data = defaultData, loadedAt = now}
	local nextMidnight = getNextMidnightForPlayer(player)
	local timeRemaining = nextMidnight - now
	local dataToSend = {
		currentDay = 1, lastClaimDate = "", claimedToday = false,
		timeRemaining = timeRemaining, nextMidnight = nextMidnight, serverTime = now,
		isFirstJoin = true, firstJoinTimeRemaining = FIRST_JOIN_DELAY,
	}
	local getDailyDataEvent = ReplicatedStorage:FindFirstChild("GetDailyDataEvent")
	if getDailyDataEvent then
		getDailyDataEvent:FireClient(player, dataToSend)
	end
	return true
end
local function unlockDay2(player)
	if not isAdmin(player) then return false end
	local data, loadOk = loadPlayerData(player)
	if not loadOk or not data then
		warn("⚠️ unlockDay2: load échoué pour " .. player.Name)
		return false
	end
	data.currentDay = 2
	data.claimedToday = false
	data.lastClaimDate = ""
	if not savePlayerData(player, data) then
		warn("Failed to unlock day 2 for player: " .. player.Name)
		return false
	end
	cancelNotificationTimer(player)
	playerDataCache[player.UserId] = {data = data, loadedAt = os.time()}
	local nextMidnight = getNextMidnightForPlayer(player)
	local dataToSend = {
		currentDay = 2, lastClaimDate = "", claimedToday = false,
		timeRemaining = 0, nextMidnight = nextMidnight, serverTime = os.time(),
	}
	local getDailyDataEvent = ReplicatedStorage:FindFirstChild("GetDailyDataEvent")
	if getDailyDataEvent then getDailyDataEvent:FireClient(player, dataToSend) end
	return true
end
-- ========================================
-- REMOTE EVENTS
-- ========================================
local function getOrCreateRemote(name, className)
	local remote = ReplicatedStorage:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className or "RemoteEvent")
		remote.Name = name
		remote.Parent = ReplicatedStorage
	end
	return remote
end
local giveToolEvent = getOrCreateRemote("GiveToolEvent")
local getDailyDataEvent = getOrCreateRemote("GetDailyDataEvent")
local claimDailyRewardEvent = getOrCreateRemote("ClaimDailyRewardEvent")
local resetDailyDataEvent = getOrCreateRemote("ResetDailyDataEvent")
local showDailyNotificationEvent = getOrCreateRemote("ShowDailyNotificationEvent")
local cancelDailyNotificationEvent = getOrCreateRemote("CancelDailyNotificationEvent")
-- ========================================
-- HANDLER : getDailyDataEvent
-- ========================================
getDailyDataEvent.OnServerEvent:Connect(function(player)
	local now = os.time()
	local cached = playerDataCache[player.UserId]
	local data
	if cached and (now - cached.loadedAt) < 30 then
		data = cached.data
	else
		local loadOk
		data, loadOk = loadPlayerData(player)
		if not loadOk or not data then
			-- 🛡️ Load échoué : on ne touche RIEN, on n'envoie pas non plus pour éviter de tromper le client
			warn("⚠️ getDailyData: load échoué pour " .. player.Name .. ", aucune réponse envoyée")
			return
		end
		playerDataCache[player.UserId] = {data = data, loadedAt = now}
	end
	local isNewDay = checkAndUpdateNewDay(player, data)
	if isNewDay then savePlayerData(player, data) end
	local nextMidnight = getNextMidnightForPlayer(player)
	local timeRemaining = 0
	-- Détection premier join
	local isFirstJoin = isFirstEverJoin(data)
	local firstJoinTimeRemaining = 0
	if isFirstJoin then
		firstJoinTimeRemaining = getFirstJoinTimeRemaining(player.UserId)
		if firstJoinTimeRemaining > 0 then
			local dataToSend = {
				currentDay = data.currentDay, lastClaimDate = data.lastClaimDate,
				claimedToday = false, timeRemaining = 0, nextMidnight = nextMidnight,
				serverTime = os.time(), isFirstJoin = true,
				firstJoinTimeRemaining = firstJoinTimeRemaining,
			}
			getDailyDataEvent:FireClient(player, dataToSend)
			return
		end
	end
	if data.claimedToday then
		timeRemaining = nextMidnight - os.time()
		if timeRemaining < 0 then timeRemaining = 0 end
	else
		-- 🚫 Notification « récompense quotidienne » RETIRÉE (demande : elle ne servait à rien).
		--    Bonus : 1 lecture DataStore de moins par joueur (le minuteur relisait les données).
		--    Pour la remettre : réactiver la ligne ci-dessous ET le LocalScript « daily notification ».
		-- if not isFirstJoin then task.wait(1) startNotificationTimer(player, data.currentDay) end
	end
	local dataToSend = {
		currentDay = data.currentDay, lastClaimDate = data.lastClaimDate,
		claimedToday = data.claimedToday, timeRemaining = timeRemaining,
		nextMidnight = nextMidnight, serverTime = os.time(),
		isFirstJoin = isFirstJoin, firstJoinTimeRemaining = firstJoinTimeRemaining,
	}
	getDailyDataEvent:FireClient(player, dataToSend)
end)
-- ========================================
-- HANDLER : claimDailyRewardEvent
-- ========================================
claimDailyRewardEvent.OnServerEvent:Connect(function(player)

	-- ✅ FIX #7
	if _G.recentReloads and _G.recentReloads[player.UserId] then return end
	if _G.dataLoading and _G.dataLoading[player.UserId] then return end

	local now_click = os.time()
	if dailyRewardClickCooldown[player.UserId] and (now_click - dailyRewardClickCooldown[player.UserId]) < 3 then
		return
	end
	dailyRewardClickCooldown[player.UserId] = now_click
	local data, loadOk = loadPlayerData(player)
	if not loadOk or not data then
		warn("⚠️ claim: load échoué pour " .. player.Name .. ", refus")
		claimDailyRewardEvent:FireClient(player, false, nil)
		return
	end
	checkAndUpdateNewDay(player, data)
	if data.claimedToday then
		warn(player.Name .. " tried to claim but already claimed today")
		claimDailyRewardEvent:FireClient(player, false, nil)
		return
	end
	-- Vérification premier join
	if isFirstEverJoin(data) then
		local remaining = getFirstJoinTimeRemaining(player.UserId)
		if remaining > 0 then
			warn(player.Name .. " tente claim Jour 1 avant fin timer ("
				.. math.ceil(remaining) .. "s restantes)")
			claimDailyRewardEvent:FireClient(player, false, {
				firstJoinBlocked = true,
				firstJoinTimeRemaining = remaining,
			})
			return
		end
	end
	local rewardConfig = nil
	for _, config in ipairs(REWARDS_CONFIG) do
		if config.day == data.currentDay then rewardConfig = config break end
	end
	if not rewardConfig then
		warn("No reward config found for day " .. data.currentDay)
		claimDailyRewardEvent:FireClient(player, false, nil)
		return
	end
	local success = false
	if rewardConfig.isPoints then
		success = giveDailyPoints(player, rewardConfig.points)
	else
		success = giveTool(player, rewardConfig.toolName)
	end
	if success then
		cancelNotificationTimer(player)
		data.claimedToday = true
		data.lastClaimDate = getCurrentDateForPlayer(player)
		data.currentDay = data.currentDay + 1
		if data.currentDay > TOTAL_DAYS then data.currentDay = 1 end
		if not savePlayerData(player, data) then
			-- Save échoué : on ne crash pas, mais log
			warn("⚠️ Save échoué après claim pour " .. player.Name)
		end
		playerDataCache[player.UserId] = {data = data, loadedAt = os.time()}
		local nextMidnight = getNextMidnightForPlayer(player)
		local dataToSend = {
			currentDay = data.currentDay, lastClaimDate = data.lastClaimDate,
			claimedToday = data.claimedToday, timeRemaining = nextMidnight - os.time(),
			nextMidnight = nextMidnight, serverTime = os.time(),
		}
		claimDailyRewardEvent:FireClient(player, true, dataToSend)
	else
		claimDailyRewardEvent:FireClient(player, false, nil)
	end
end)
-- 🔒 FAILLE FERMÉE : un client pouvait demander N'IMPORTE QUEL outil de ServerStorage par son nom.
--    Aucun script n'utilise ce signal (la récompense Daily est donnée par le serveur au claim).
giveToolEvent.OnServerEvent:Connect(function(player, toolName)
	warn(("🚫 GiveToolEvent refusé pour %s (%s)"):format(player.Name, tostring(toolName)))
end)
resetDailyDataEvent.OnServerEvent:Connect(function(player)
	if isAdmin(player) then resetPlayerData(player)
	else warn(player.Name .. " tried to reset daily data without permission!") end
end)
-- ========================================
-- 🆕 PLAYER ADDED (fix bug #3 + #4)
-- ========================================
Players.PlayerAdded:Connect(function(player)
	-- 🛡️ TIMER DÉFENSIF IMMÉDIAT (fix bug #3 : plus de bypass possible)
	-- Sera corrigé après le load avec la vraie valeur persistée
	firstJoinTimers[player.UserId] = os.time()
	task.spawn(function()
		local data, loadOk = loadPlayerData(player)
		if not loadOk or not data then
			warn("⚠️ PlayerAdded load échoué pour " .. player.Name .. ", timer défensif maintenu")
			return
		end
		if isFirstEverJoin(data) then
			-- 🆕 Persistance firstJoinAt (fix bug #4)
			if (data.firstJoinAt or 0) == 0 then
				data.firstJoinAt = os.time()
				savePlayerData(player, data)
				print(string.format("🆕 PREMIER JOIN ABSOLU pour %s → Timer 10 min démarré", player.Name))
			else
				print(string.format("🆕 REJOIN durant timer 10 min pour %s (%d s déjà écoulées)",
					player.Name, os.time() - data.firstJoinAt))
			end
			-- Synchroniser le cache mémoire avec la vraie valeur persistée
			firstJoinTimers[player.UserId] = data.firstJoinAt
			-- Notif quand le timer est écoulé
			local remaining = getFirstJoinTimeRemaining(player.UserId)
			if remaining > 0 then
				task.delay(remaining, function()
					if not player or not player.Parent then return end
					local currentData, ok = loadPlayerData(player)
					if not ok or not currentData then return end
					if not currentData.claimedToday and currentData.currentDay == 1 and currentData.lastClaimDate == "" then
						local showDailyNotif = ReplicatedStorage:FindFirstChild("ShowDailyNotificationEvent")
						if showDailyNotif then
							pcall(function() showDailyNotif:FireClient(player, 1) end)
						end
						print(string.format("🔔 Timer 10 min écoulé pour %s → Notif Jour 1", player.Name))
					end
				end)
			end
		else
			-- Pas un premier join → annuler le timer défensif
			firstJoinTimers[player.UserId] = nil
		end
	end)
	-- Commandes chat
	player.Chatted:Connect(function(message)
		local lowerMsg = message:lower()
		if lowerMsg == "/resetdaily" then
			if isAdmin(player) then
				resetPlayerData(player)
				local hint = Instance.new("Hint")
				hint.Text = "Daily rewards data has been reset!"
				hint.Parent = workspace
				task.delay(3, function() hint:Destroy() end)
			end
		elseif lowerMsg == "/unlockday2" then
			if unlockDay2(player) then
				local hint = Instance.new("Hint")
				hint.Text = "✅ Jour 2 débloqué!"
				hint.Parent = workspace
				task.delay(3, function() hint:Destroy() end)
			end
		end
	end)
end)
-- ========================================
-- CLEANUP
-- ========================================
Players.PlayerRemoving:Connect(function(player)
	cancelNotificationTimer(player)
	playerDataCache[player.UserId] = nil
	local starterGear = player:FindFirstChild("StarterGear")
	if starterGear then starterGear:ClearAllChildren() end
	playerTools[player.UserId] = nil
	dailyClaimCooldowns[player.UserId] = nil
	firstJoinTimers[player.UserId] = nil
end)
print("✅ DailyRewards SERVEUR v4 chargé (7 jours, fixes #1-4 appliqués)")
-- Commandes admin: /resetdaily, /unlockday2]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX18">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">FriendsBoard_Server</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 👥 FriendsBoard_Server — Script dans ServerScriptService   (NOUVEAU)
--
--  Onglet FRIENDS des leaderboards : donne le score des amis qui ne sont PAS
--  dans le top 100 (ils s'affichent avec « -- » à la place de leur rang).
--
--  Lecture seule, dans les MÊMES classements que les boards (OrderedDataStore,
--  clé = UserId). Garde-fous :
--   • 🔒 SEULEMENT tes VRAIS amis (liste demandée à Roblox par le serveur, gardée
--     10 min) + toi : un tricheur ne peut pas faire lire des milliers de joueurs
--     au hasard pour épuiser le budget DataStore du serveur ;
--   • 50 amis max par demande, 1 demande / 3 s par joueur, et 300 lectures
--     au maximum par joueur toutes les 10 min ;
--   • cache serveur de 5 min PARTAGÉ (les amis communs ne sont lus qu'une fois) ;
--   • si le budget de lectures DataStore est bas, on s'arrête (le client affiche « -- »).
--════════════════════════════════════════════════════════════════════════════
local Players           = game:GetService("Players")
local DataStoreService  = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local STORES = {   -- même nom que dans « Leaderboards unifed » et « new donation board server »
	Points    = "GlobalLeaderboard_Points_v3",
	Rebirths  = "GlobalLeaderboard_Rebirths_v1",
	Streak    = "GlobalLeaderboard_Streak_v1",
	Kills     = "GlobalLeaderboard_Kills_v1",
	Donations = "TopDonatorsLeaderboard",
}
local MAX_IDS      = 50
local CACHE_TTL    = 300
local COOLDOWN     = 3
local MIN_BUDGET   = 25   -- on laisse toujours ce nombre de lectures aux autres scripts
local FRIENDS_TTL  = 600  -- liste d'amis gardée 10 min
local QUOTA, QUOTA_WINDOW = 300, 600   -- lectures DataStore max par joueur / fenêtre (s)

local stores, cache = {}, {}
for k, name in pairs(STORES) do
	stores[k] = DataStoreService:GetOrderedDataStore(name)
	cache[k] = {}
end
local lastCall = {}
local friendsOf = {}   -- [userId] = { set = { [id] = true }, at = os.clock() }
local quota = {}       -- [userId] = { n = lectures, t0 = début de fenêtre }

-- 👥 vrais amis du joueur, demandés à Roblox par le SERVEUR (jamais la liste du client)
local function friendSet(player)
	local uid = player.UserId
	local c = friendsOf[uid]
	if c and os.clock() - c.at < FRIENDS_TTL then return c.set end
	local set = { [uid] = true }
	local ok = pcall(function()
		local pages = Players:GetFriendsAsync(uid)
		for _ = 1, 10 do   -- 10 pages max (Roblox : 200 amis au maximum)
			for _, f in ipairs(pages:GetCurrentPage()) do set[f.Id] = true end
			if pages.IsFinished then break end
			pages:AdvanceToNextPageAsync()
		end
	end)
	if ok then friendsOf[uid] = { set = set, at = os.clock() }
	elseif c then return c.set end   -- Roblox injoignable : on garde l'ancienne liste
	return set
end

local remote = ReplicatedStorage:FindFirstChild("GetFriendsBoardValues")
if not remote then
	remote = Instance.new("RemoteFunction")
	remote.Name = "GetFriendsBoardValues"
	remote.Parent = ReplicatedStorage
end

local function budget()
	local ok, b = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync)
	end)
	return ok and b or 0
end

remote.OnServerInvoke = function(player, board, ids)
	if type(board) ~= "string" or not stores[board] or type(ids) ~= "table" then return {} end
	local now = os.clock()
	if lastCall[player.UserId] and now - lastCall[player.UserId] < COOLDOWN then return { throttled = true } end
	lastCall[player.UserId] = now

	local friends = friendSet(player)
	local out, need, seen = {}, {}, {}
	for i = 1, math.min(#ids, MAX_IDS) do
		local id = tonumber(ids[i])
		if id and id > 0 and id == math.floor(id) and not seen[id] and friends[id] then
			seen[id] = true
			local c = cache[board][id]
			if c and now - c.at < CACHE_TTL then out[tostring(id)] = c.v
			else table.insert(need, id) end
		end
	end
	local store = stores[board]
	local q = quota[player.UserId]
	if not q or os.clock() - q.t0 > QUOTA_WINDOW then q = { n = 0, t0 = os.clock() } ; quota[player.UserId] = q end
	for _, id in ipairs(need) do
		if budget() < MIN_BUDGET or q.n >= QUOTA then break end
		q.n += 1
		local ok, v = pcall(function() return store:GetAsync(tostring(id)) end)
		if ok then
			v = tonumber(v) or 0
			cache[board][id] = { v = v, at = os.clock() }
			out[tostring(id)] = v
		end
	end
	return out
end

Players.PlayerRemoving:Connect(function(p)
	lastCall[p.UserId], friendsOf[p.UserId], quota[p.UserId] = nil, nil, nil
end)

-- ménage du cache (les entrées expirées ne servent plus)
task.spawn(function()
	while true do
		task.wait(600)
		local now = os.clock()
		for _, t in pairs(cache) do
			for id, c in pairs(t) do if now - c.at > CACHE_TTL then t[id] = nil end end
		end
	end
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX19">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">PLAYER UGC STATS</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 📈 PLAYER UGC STATS — Script dans ServerScriptService   (NOUVEAU)
--
--  Répond aux questions :
--   • Combien de joueurs n'ont AUCUNE UGC ? Combien en ont 1, 2, 3… ?
--   • Pareil, séparé par type de joueur : sans pass · 👑 VIP · ⚡ boost permanent
--     (x2 / x5 / x10) · VIP + boost. Et combien ont VIP + x2.
--   • En moyenne, combien de TEMPS DE JEU pour avoir une UGC (1re, 2e, 3e…) ?
--   • Combien d'UGC ont les joueurs qui ont ARRÊTÉ de jouer (pas revenus depuis X jours) ?
--   • Dernière connexion de n'importe quel joueur (pour les entrées du panel).
--
--  Comment ça compte (aucune liste de joueurs à parcourir à chaque lecture) :
--   chaque joueur est rangé dans UNE case : (jour de sa dernière visite, type, nb d'UGC).
--   Quand il revient, il change de case ; quand il obtient une UGC, il change de case.
--   Le panel additionne les cases : « tous les joueurs », « ceux partis depuis 7 j »…
--
--  📥 RATTRAPAGE : au premier lancement, un seul serveur à la fois parcourt
--     les joueurs déjà connus (ceux vus par le script STATS) et les range dans
--     les cases, doucement (1 joueur / 1,5 s), sans gêner le jeu. Ça peut prendre
--     quelques heures ; le panel affiche l'avancement.
--
--  Écritures : regroupées toutes les 60 s (8 clés partagées, additions, jamais
--  d'écrasement). 1 lecture + 1 écriture par joueur et par session.
--  🧪 STUDIO : lecture seule (rien n'est compté ni écrit).
--════════════════════════════════════════════════════════════════════════════

local Players    = game:GetService("Players")
local RS         = game:GetService("ReplicatedStorage")
local DSS        = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local MPS        = game:GetService("MarketplaceService")

local Cat = require(RS:WaitForChild("ProductCatalog"))   -- jours à l'heure de Montréal

local ADMIN = {
	[3203521470] = true, [11017023724] = true, [8456613930] = true,
	[8142402169] = true, [10420404767] = true,
}

local READ_ONLY   = RunService:IsStudio()
local FLUSH_EVERY = 60
local SHARDS      = 8          -- ⚠️ ne jamais changer après l'installation
local MAX_U       = 10         -- 10 = « 10 UGC ou plus »
local MAX_ORD     = 5          -- temps pour la 1re, 2e… 5e UGC (5 = « 5e et + »)

local USERS   = DSS:GetDataStore("PlayerUgcStats_Users_v1")
local AGG     = DSS:GetDataStore("PlayerUgcStats_Agg_v1")
local ENGAGE  = DSS:GetDataStore("EngageUsers_v1")        -- LU seulement (script STATS)
local UGC_PLR = DSS:GetDataStore("UGCRedeemsPlayer_v1")   -- LU seulement (UGC REDEEM LOG)

-- mêmes IDs que PUBLIC_PROFILE / time
local VIP_PASS = 1891589121
local BOOST_PASSES = { [2] = 1891007119, [5] = 1893682680, [10] = 1891475116 }
local BIT = { vip = 1, [2] = 2, [5] = 4, [10] = 8 }

local JOB = (game.JobId ~= "" and game.JobId) or "studio"
local function shardOf(s)
	local h = 0
	for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 2147483647 end
	return h % SHARDS + 1
end
local MY_SHARD = shardOf(JOB)

local function today() return Cat.DayKey(os.time()) end
local function clampU(u) return math.clamp(math.floor(tonumber(u) or 0), 0, MAX_U) end

--════════════════════════════════════════════════════════════
-- 🧮 DELTAS EN MÉMOIRE (écrits toutes les 60 s)
--════════════════════════════════════════════════════════════
local pend = { last = {}, ttu = {} }

local function move(dk, f, u, n)
	if READ_ONLY or type(dk) ~= "string" or #dk ~= 8 then return end
	local cell = tostring(math.floor(tonumber(f) or 0)) .. "|" .. tostring(clampU(u))
	local d = pend.last[dk]
	if not d then d = {} ; pend.last[dk] = d end
	d[cell] = (d[cell] or 0) + n
	if d[cell] == 0 then d[cell] = nil end
end

local function sample(f, ord, pt, days)
	if READ_ONLY then return end
	local k = tostring(f) .. "|" .. tostring(math.clamp(ord, 1, MAX_ORD))
	local s = pend.ttu[k]
	if not s then s = { 0, 0, 0, 0 } ; pend.ttu[k] = s end
	s[1] += 1 ; s[2] += math.max(0, math.floor(pt))
	if days then s[3] += 1 ; s[4] += math.max(0, days) end
end

local function flush()
	if READ_ONLY then return end
	if next(pend.last) == nil and next(pend.ttu) == nil then return end
	local batch = pend
	pend = { last = {}, ttu = {} }
	local ok = pcall(function()
		AGG:UpdateAsync("s" .. MY_SHARD, function(old)
			old = type(old) == "table" and old or {}
			old.last = type(old.last) == "table" and old.last or {}
			old.ttu = type(old.ttu) == "table" and old.ttu or {}
			for dk, cells in pairs(batch.last) do
				local d = type(old.last[dk]) == "table" and old.last[dk] or {}
				for c, n in pairs(cells) do
					local v = (tonumber(d[c]) or 0) + n
					d[c] = (v ~= 0) and v or nil
				end
				old.last[dk] = next(d) and d or nil
			end
			for k, s in pairs(batch.ttu) do
				local o = type(old.ttu[k]) == "table" and old.ttu[k] or { 0, 0, 0, 0 }
				for i = 1, 4 do o[i] = (tonumber(o[i]) or 0) + s[i] end
				old.ttu[k] = o
			end
			return old
		end)
	end)
	if not ok then   -- on garde tout pour le prochain essai
		for dk, cells in pairs(batch.last) do
			for c, n in pairs(cells) do
				local d = pend.last[dk] or {}
				pend.last[dk] = d
				d[c] = (d[c] or 0) + n
			end
		end
		for k, s in pairs(batch.ttu) do
			local o = pend.ttu[k] or { 0, 0, 0, 0 }
			for i = 1, 4 do o[i] += s[i] end
			pend.ttu[k] = o
		end
	end
end
task.spawn(function() while true do task.wait(FLUSH_EVERY) flush() end end)

--════════════════════════════════════════════════════════════
-- 🏷️ TYPE DU JOUEUR (VIP / boosts permanents, achetés OU offerts)
--════════════════════════════════════════════════════════════
local function ownsPass(uid, id)
	for attempt = 1, 2 do
		local ok, r = pcall(function() return MPS:UserOwnsGamePassAsync(uid, id) end)
		if ok then return r == true end
		task.wait(1 * attempt)
	end
	return false
end

-- joueur en ligne : l'attribut publié par PUBLIC_PROFILE ("vip,2,5,10")
local function flagsFromAttr(p)
	local a = p:GetAttribute("ProfileBadges")
	if type(a) ~= "string" then return nil end
	local f = 0
	for w in string.gmatch(a, "[^,]+") do
		local b = BIT[w] or BIT[tonumber(w) or -1]
		if b then f = bit32.bor(f, b) end
	end
	return f
end

-- n'importe quel joueur (même hors ligne)
local function flagsOffline(uid)
	local f = 0
	local vip = false
	if _G.IsVIP then
		local ok, v = pcall(_G.IsVIP, uid)
		vip = ok and v == true
	end
	if not vip then vip = ownsPass(uid, VIP_PASS) end
	if vip then f = bit32.bor(f, BIT.vip) end
	local gifted = {}
	if _G.PermBoosts and _G.PermBoosts.peek then
		local ok, l = pcall(_G.PermBoosts.peek, uid)
		if ok and type(l) == "table" then for _, m in ipairs(l) do gifted[tonumber(m) or -1] = true end end
	end
	for m, id in pairs(BOOST_PASSES) do
		if gifted[m] or ownsPass(uid, id) then f = bit32.bor(f, BIT[m]) end
	end
	return f
end

--════════════════════════════════════════════════════════════
-- 👥 SESSIONS
--════════════════════════════════════════════════════════════
local sess = {}   -- [uid] = { lsd, f, u, pu, tu, fj, fpt }

local function playtime(uid)
	if _G.getCurrentPlaytime then
		local ok, v = pcall(_G.getCurrentPlaytime, uid)
		if ok and tonumber(v) then return tonumber(v) end
	end
	local p = Players:GetPlayerByUserId(uid)
	return tonumber(p and p:GetAttribute("PlaytimeSeconds")) or 0
end

local function ugcCount(uid)
	if _G.UGCRedeem_GetPlayer then
		for _ = 1, 3 do
			local ok, rec = pcall(_G.UGCRedeem_GetPlayer, uid, true)
			if ok and type(rec) == "table" then return clampU(rec.c) end
			task.wait(2)
		end
		return nil
	end
	local ok, rec = pcall(function() return UGC_PLR:GetAsync("u_" .. uid) end)
	if not ok then return nil end
	return clampU(type(rec) == "table" and rec.c or 0)
end

local function onJoin(p)
	local uid = p.UserId
	-- on attend que le jeu ait chargé ses données (temps de jeu)
	local t0 = os.clock()
	while p.Parent and p:GetAttribute("PlaytimeSeconds") == nil and os.clock() - t0 < 40 do task.wait(1) end
	if not p.Parent then return end
	local u = ugcCount(uid)
	if u == nil then return end   -- lecture ratée : on ne compte pas ce joueur (aucune donnée fausse)
	-- le type : attribut de PUBLIC_PROFILE (posé ~6 s après l'arrivée), sinon calculé
	local f
	local t1 = os.clock()
	while p.Parent and os.clock() - t1 < 12 do
		f = flagsFromAttr(p)
		if f then break end
		task.wait(1)
	end
	if not p.Parent then return end
	f = f or flagsOffline(uid)
	local now, dk, pt = os.time(), today(), playtime(uid)
	local prev, cur
	local ok = pcall(function()
		if READ_ONLY then
			prev = USERS:GetAsync("u_" .. uid)
			return
		end
		USERS:UpdateAsync("u_" .. uid, function(old)
			old = type(old) == "table" and old or nil
			prev = old
			cur = {
				fj = old and old.fj or now, fpt = old and old.fpt or pt,
				ls = now, lsd = dk, f = f, u = u,
				pu = old and old.pu or nil, tu = old and old.tu or nil,
				n = ((old and tonumber(old.n)) or 0) + 1,
				-- 🩹 bf (« rangé par le rattrapage, on ne connaît que le jour ») est retiré dès qu'on a une
				--    vraie heure : avant, il restait collé pour toujours et l'admin affichait une DATE.
				bf = nil,
			}
			return cur
		end)
	end)
	if not ok then return end
	if not READ_ONLY then
		if prev and type(prev.lsd) == "string" then move(prev.lsd, prev.f, prev.u, -1) end
		move(dk, f, u, 1)
	end
	if not p.Parent then return end   -- parti pendant la lecture : déjà rangé au bon jour, rien à suivre
	sess[uid] = {
		lsd = dk, f = f, u = u,
		pu = prev and prev.pu or nil, tu = prev and prev.tu or nil,
		fj = (prev and prev.fj) or now, fpt = (prev and prev.fpt) or pt,
	}
	-- type qui change en cours de partie (achat du VIP, boost offert…)
	p:GetAttributeChangedSignal("ProfileBadges"):Connect(function()
		local s = sess[uid]
		local nf = flagsFromAttr(p)
		if not s or not nf or nf == s.f then return end
		move(s.lsd, s.f, s.u, -1) ; move(s.lsd, nf, s.u, 1)
		s.f = nf
	end)
end

-- nombre d'écritures de départ encore en cours (attendues à la fermeture du serveur)
local leavePending = 0
local function onLeave(p)
	local uid = p.UserId
	local s = sess[uid]
	sess[uid] = nil
	if not s or READ_ONLY then return end
	local dk, now = today(), os.time()
	if dk ~= s.lsd then   -- session à cheval sur deux jours : rangé au jour du départ
		move(s.lsd, s.f, s.u, -1) ; move(dk, s.f, s.u, 1)
	end
	local pt = playtime(uid)
	leavePending += 1
	task.spawn(function()
		pcall(function()
			USERS:UpdateAsync("u_" .. uid, function(old)
				old = type(old) == "table" and old or {}
				old.ls, old.lsd, old.f, old.u, old.pt = now, dk, s.f, s.u, math.floor(pt)
				old.pu, old.tu = s.pu, s.tu
				old.fj = old.fj or s.fj ; old.fpt = old.fpt or s.fpt
				old.bf = nil   -- 🩹 heure de départ exacte connue → plus une estimation
				return old
			end)
		end)
		leavePending -= 1
	end)
end

Players.PlayerAdded:Connect(function(p) task.spawn(onJoin, p) end)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onJoin, p) end
Players.PlayerRemoving:Connect(onLeave)
game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do pcall(onLeave, p) end
	-- 🩹 avant : 1 s fixe, les heures de départ pouvaient être coupées par la fermeture
	local t0 = os.clock()
	repeat task.wait(0.25) until leavePending <= 0 or os.clock() - t0 > 8
	flush()
end)

--════════════════════════════════════════════════════════════
-- 🎽 UNE UGC OBTENUE (appelé par le UGC REDEEM LOG)
--════════════════════════════════════════════════════════════
local API = {}
_G.PlayerUgcStats = API

function API.OnRedeem(userId)
	userId = tonumber(userId)
	local s = userId and sess[userId]
	if not s then return end   -- hors ligne : corrigé tout seul à sa prochaine connexion
	local nu = clampU(s.u + 1)
	if nu ~= s.u then move(s.lsd, s.f, s.u, -1) ; move(s.lsd, s.f, nu, 1) end
	local ord = s.u + 1
	s.u = nu
	local pt, now = playtime(userId), os.time()
	-- temps de jeu depuis l'UGC précédente (la 1re : depuis le début)
	local base = (ord == 1) and 0 or s.pu
	if base and pt >= base then
		local days
		if ord == 1 then
			-- jours réels seulement pour un joueur suivi depuis son arrivée
			if (tonumber(s.fpt) or 1e9) < 300 then days = (now - (s.fj or now)) / 86400 end
		elseif s.tu then
			days = (now - s.tu) / 86400
		end
		sample(s.f, ord, pt - base, days)
	end
	s.pu, s.tu = math.floor(pt), now
	if READ_ONLY then return end
	task.spawn(function()
		pcall(function()
			USERS:UpdateAsync("u_" .. userId, function(old)
				old = type(old) == "table" and old or {}
				old.u, old.pu, old.tu = s.u, s.pu, s.tu
				return old
			end)
		end)
	end)
end

--════════════════════════════════════════════════════════════
-- 📥 RATTRAPAGE DES JOUEURS DÉJÀ CONNUS (un seul serveur à la fois)
--════════════════════════════════════════════════════════════
local BF = { running = false }
-- on ne prend que le budget LIBRE : les sauvegardes des joueurs passent toujours avant
local function budget()
	local ok, b = pcall(function()
		return math.min(DSS:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync),
			DSS:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync))
	end)
	return ok and b or 0
end

local function takeLock(cursor, addN, finished)
	local got, state = false, nil
	pcall(function()
		AGG:UpdateAsync("bf", function(old)
			old = type(old) == "table" and old or { n = 0 }
			if old.done then state = old ; got = false ; return nil end
			local now = os.time()
			if old.owner and old.owner ~= JOB and (tonumber(old.exp) or 0) > now then
				state = old ; got = false ; return nil
			end
			old.owner, old.exp = JOB, now + 180
			if cursor ~= nil then old.cursor = cursor end
			old.n = (tonumber(old.n) or 0) + (addN or 0)
			if finished then old.done, old.owner, old.cursor = true, nil, nil end
			state, got = old, true
			return old
		end)
	end)
	return got, state
end

local function backfillOne(key)
	local uid = tonumber(key)
	if not uid or uid <= 0 then return false end
	if Players:GetPlayerByUserId(uid) then return false end   -- en ligne : compté par onJoin
	local okE, eng = pcall(function() return ENGAGE:GetAsync(key) end)
	if not okE or type(eng) ~= "table" or type(eng.players_u) ~= "string" then return false end
	local lsd = eng.players_u
	local okU, rec = pcall(function() return UGC_PLR:GetAsync("u_" .. uid) end)
	if not okU then return false end
	local u = clampU(type(rec) == "table" and rec.c or 0)
	local f = flagsOffline(uid)
	local created = false
	pcall(function()
		USERS:UpdateAsync("u_" .. uid, function(old)
			if old ~= nil then created = false ; return nil end   -- déjà rangé : on n'y touche pas
			created = true
			return { ls = Cat.DayNoon(lsd), lsd = lsd, f = f, u = u, bf = 1,
				fj = (type(eng.fj) == "string") and Cat.DayNoon(eng.fj) or nil }
		end)
	end)
	if created then move(lsd, f, u, 1) end
	return created
end

local function runBackfill()
	if READ_ONLY or BF.running then return end
	BF.running = true
	local got, st = takeLock(nil, 0, false)
	if not got then BF.running = false ; return end
	local cursor = st and st.cursor
	while true do
		local okP, pages = pcall(function() return ENGAGE:ListKeysAsync(nil, 50, cursor) end)
		if not okP or not pages then break end
		local okC, page = pcall(function() return pages:GetCurrentPage() end)
		if not okC then break end
		local added = 0
		for _, k in ipairs(page) do
			while budget() < 20 do task.wait(2) end
			if backfillOne(k.KeyName) then added += 1 end
			task.wait(1.5)
		end
		if pages.IsFinished then
			takeLock(nil, added, true)
			print("📈 [PlayerUgcStats] Rattrapage terminé")
			break
		end
		local okA = pcall(function() pages:AdvanceToNextPageAsync() end)
		if not okA then break end
		local nc = pages.Cursor
		if type(nc) ~= "string" or nc == "" or nc == cursor then break end
		cursor = nc
		local still = takeLock(cursor, added, false)
		if not still then break end
	end
	BF.running = false
end
task.spawn(function()
	task.wait(90)                         -- laisse démarrer le serveur
	while true do
		pcall(runBackfill)
		task.wait(600)                    -- un autre serveur a la main ou c'est fini : on revérifie plus tard
	end
end)

--════════════════════════════════════════════════════════════
-- 📊 LECTURE POUR L'ADMIN PANEL
--════════════════════════════════════════════════════════════
local function mk(name)
	local r = RS:FindFirstChild(name)
	if not r then r = Instance.new("RemoteFunction") ; r.Name = name ; r.Parent = RS end
	return r
end
local getStats = mk("AdminPlayerStats_Get")
local getLast  = mk("AdminLastSeen_Get")

local cache = { at = -1e9, data = nil }
local busy = {}
getStats.OnServerInvoke = function(player, fresh)
	if not ADMIN[player.UserId] then return { ok = false, err = "non admin" } end
	if busy[player.UserId] then return { ok = false, err = "déjà en cours" } end
	if cache.data and os.clock() - cache.at < ((fresh == true) and 10 or 60) then return cache.data end
	busy[player.UserId] = true
	local ok, res = pcall(function()
		local last, ttu = {}, {}
		local function addLast(src, sign)
			for dk, cells in pairs(type(src) == "table" and src or {}) do
				if type(cells) == "table" then
					local d = last[dk] or {}
					last[dk] = d
					for c, n in pairs(cells) do d[c] = (d[c] or 0) + (tonumber(n) or 0) * sign end
				end
			end
		end
		for i = 1, SHARDS do
			local okS, s = pcall(function() return AGG:GetAsync("s" .. i) end)
			if okS and type(s) == "table" then
				addLast(s.last, 1)
				for k, v in pairs(type(s.ttu) == "table" and s.ttu or {}) do
					local o = ttu[k] or { 0, 0, 0, 0 }
					for j = 1, 4 do o[j] += tonumber(v[j]) or 0 end
					ttu[k] = o
				end
			end
		end
		addLast(pend.last, 1)   -- ce serveur, pas encore écrit
		for k, s in pairs(pend.ttu) do
			local o = ttu[k] or { 0, 0, 0, 0 }
			for j = 1, 4 do o[j] += s[j] end
			ttu[k] = o
		end
		local okB, bf = pcall(function() return AGG:GetAsync("bf") end)
		bf = okB and type(bf) == "table" and bf or {}
		return { ok = true, last = last, ttu = ttu, today = today(), studio = READ_ONLY,
			bf = { done = bf.done == true, n = tonumber(bf.n) or 0, running = bf.owner ~= nil } }
	end)
	busy[player.UserId] = nil
	if not ok then return { ok = false, err = tostring(res) } end
	cache.data, cache.at = res, os.clock()
	return res
end

-- 🕒 Dernière connexion : { [userId] = { t = horodatage } | { d = "AAAAMMJJ" } | { on = true } }
local lastCache = {}
getLast.OnServerInvoke = function(player, ids)
	if not ADMIN[player.UserId] or type(ids) ~= "table" then return {} end
	local out, need = {}, {}
	for i = 1, math.min(#ids, 60) do
		local id = tonumber(ids[i])
		if id and id > 0 and out[tostring(id)] == nil then
			if Players:GetPlayerByUserId(id) then
				out[tostring(id)] = { on = true }
			else
				local c = lastCache[id]
				if c and os.clock() - c.at < 300 then out[tostring(id)] = c.v
				else table.insert(need, id) end
			end
		end
	end
	local idx, left = 0, #need
	local function worker()
		while true do
			idx += 1
			local id = need[idx]
			if not id then return end
			local v
			local okU, u = pcall(function() return USERS:GetAsync("u_" .. id) end)
			if okU and type(u) == "table" and tonumber(u.ls) and not u.bf then
				v = { t = tonumber(u.ls) }
			elseif okU and type(u) == "table" and type(u.lsd) == "string" then
				v = { d = u.lsd }   -- rangé par le rattrapage : on ne connaît que le jour
			else
				local okE, e = pcall(function() return ENGAGE:GetAsync(tostring(id)) end)
				if okE and type(e) == "table" and type(e.players_u) == "string" then v = { d = e.players_u }
				elseif okU and okE then v = { none = true } end
			end
			if v then
				lastCache[id] = { v = v, at = os.clock() }
				out[tostring(id)] = v
			end
			left -= 1
		end
	end
	for _ = 1, math.min(6, #need) do task.spawn(worker) end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 12 do task.wait(0.05) end
	return out
end
task.spawn(function()
	while true do
		task.wait(600)
		for id, c in pairs(lastCache) do if os.clock() - c.at > 600 then lastCache[id] = nil end end
	end
end)

print("✅ PLAYER UGC STATS chargé" .. (READ_ONLY and " (🧪 Studio : lecture seule)" or ""))]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX20">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">PopupControl_Server</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 🔔 PopupControl_Server — Script dans ServerScriptService   (NOUVEAU)
--
--  Garde les réglages des popups automatiques (admin panel ▸ 🔔 POPUPS) :
--   • lus au démarrage depuis le DataStore « PopupControl_v1 » (1 lecture / serveur) ;
--   • publiés en ATTRIBUTS sur ReplicatedStorage.PopupControl : Roblox les
--     réplique tout seul à tous les joueurs (aucun remote, aucune boucle) ;
--   • modifiés par un admin → écrits (1 UpdateAsync) puis envoyés aux autres
--     serveurs par MessagingService.
--
--  🔐 Sécurité : seul un admin peut écrire, chaque valeur est vérifiée et
--     bornée (PopupControlConfig.Sanitize), 1 modification / 0,25 s max.
--  API serveur : _G.PopupControl.Get(id, key) · _G.PopupControl.IsOn(id)
--════════════════════════════════════════════════════════════════════════════
local Players          = game:GetService("Players")
local RS               = game:GetService("ReplicatedStorage")
local DSS              = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local RunService       = game:GetService("RunService")

local CFG = require(RS:WaitForChild("PopupControlConfig"))

local IS_STUDIO = RunService:IsStudio()
local STORE     = DSS:GetDataStore("PopupControl_v1")
local KEY       = "cfg"
local TOPIC     = "PopupControl_v1"

local ADMIN = {
	[3203521470] = true, [11017023724] = true, [8456613930] = true,
	[8142402169] = true, [10420404767] = true,
}
local function isAdmin(uid)
	if ADMIN[uid] then return true end
	local list = _G.AC_ADMIN_IDS
	if type(list) == "table" then
		for _, id in ipairs(list) do if id == uid then return true end end
	end
	return false
end

-- 📦 dossier répliqué (les clients lisent ses attributs)
local folder = RS:FindFirstChild("PopupControl")
if not folder then
	folder = Instance.new("Configuration")
	folder.Name = "PopupControl"
	folder.Parent = RS
end

-- valeurs actuelles : values[id][key]
local values = {}
local function eachField(fn)
	for _, f in ipairs(CFG.Global) do fn("_G", f) end
	for _, p in ipairs(CFG.Popups) do
		for _, f in ipairs(p.fields) do fn(p.id, f) end
	end
end
eachField(function(id, f)
	values[id] = values[id] or {}
	values[id][f.key] = f.default
end)

local function publishAll()
	eachField(function(id, f)
		local v = values[id][f.key]
		if folder:GetAttribute(CFG.Attr(id, f.key)) ~= v then
			folder:SetAttribute(CFG.Attr(id, f.key), v)
		end
	end)
end

-- applique une table sauvegardée { [id] = { [key] = v } } (valeurs re-vérifiées)
local function applyStored(stored)
	if type(stored) ~= "table" then return end
	eachField(function(id, f)
		local t = stored[id]
		if type(t) == "table" and t[f.key] ~= nil then
			local v = CFG.Sanitize(f, t[f.key])
			if v ~= nil then values[id][f.key] = v end
		end
	end)
	publishAll()
end

publishAll()   -- défauts tout de suite (les clients ne restent jamais sans valeur)

local loaded = false
task.spawn(function()
	for attempt = 1, 5 do
		local ok, data = pcall(function() return STORE:GetAsync(KEY) end)
		if ok then
			applyStored(data)
			loaded = true
			folder:SetAttribute("Loaded", true)
			return
		end
		task.wait(2 * attempt)
	end
	warn("🔔 [PopupControl] Réglages non lus : valeurs par défaut utilisées (réessai à la prochaine modification)")
end)

-- 🌍 autres serveurs : quand un admin change un réglage, on relit la valeur envoyée
task.spawn(function()
	if IS_STUDIO then return end
	for attempt = 1, 10 do
		local ok = pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(msg)
				local d = type(msg) == "table" and msg.Data
				if type(d) ~= "table" or d.j == game.JobId then return end
				-- message minuscule (limite MessagingService 1 Ko) : on relit la sauvegarde
				task.delay(math.random() * 3, function()   -- étalé : pas tous les serveurs à la même seconde
					local ok, data = pcall(function() return STORE:GetAsync(KEY) end)
					if ok then applyStored(data) end
				end)
			end)
		end)
		if ok then return end
		task.wait(math.min(60, 5 * attempt))
	end
end)

--════════════════════════════════════════════════════════════
-- 🔌 API serveur
--════════════════════════════════════════════════════════════
local API = {}
function API.Get(id, key)
	local t = values[id]
	return t and t[key]
end
-- popup activé (interrupteur général compris pour les popups automatiques)
function API.IsOn(id)
	local p = CFG.ById[id]
	if not p or values[id].Enabled ~= true then return false end
	if p.kind ~= "action" and p.kind ~= "favorite" and values._G.Enabled ~= true then return false end
	return true
end
_G.PopupControl = API

--════════════════════════════════════════════════════════════
-- 🛠️ ADMIN PANEL
--════════════════════════════════════════════════════════════
local remote = RS:FindFirstChild("PopupControl_Admin")
if not remote then
	remote = Instance.new("RemoteFunction")
	remote.Name = "PopupControl_Admin"
	remote.Parent = RS
end

local lastCall = {}
local saveQueued = false
local function queueSave()
	if saveQueued or IS_STUDIO then return end
	saveQueued = true
	task.delay(2, function()   -- regroupe plusieurs clics en UNE écriture
		saveQueued = false
		local snapshot = table.clone(values)
		for id, t in pairs(snapshot) do snapshot[id] = table.clone(t) end
		local ok = false
		for attempt = 1, 3 do
			ok = pcall(function()
				STORE:UpdateAsync(KEY, function() return snapshot end)
			end)
			if ok then break end
			task.wait(attempt)
		end
		if not ok then warn("🔔 [PopupControl] Sauvegarde échouée") return end
		pcall(function() MessagingService:PublishAsync(TOPIC, { j = game.JobId }) end)
	end)
end

remote.OnServerInvoke = function(player, action, id, key, value)
	if not isAdmin(player.UserId) then return { ok = false, err = "non admin" } end
	local now = os.clock()
	if lastCall[player.UserId] and now - lastCall[player.UserId] < 0.25 then
		return { ok = false, err = "trop rapide" }
	end
	lastCall[player.UserId] = now

	if action == "get" then
		return { ok = true, values = values, loaded = loaded, studio = IS_STUDIO }
	elseif action == "set" then
		if type(id) ~= "string" or type(key) ~= "string" then return { ok = false, err = "requête invalide" } end
		local f = CFG.FindField(id, key)
		if not f then return { ok = false, err = "réglage inconnu" } end
		local v = CFG.Sanitize(f, value)
		if v == nil then return { ok = false, err = "valeur refusée" } end
		values[id][key] = v
		publishAll()
		queueSave()
		print(string.format("🔔 [PopupControl] %s : %s.%s = %s", player.Name, id, key, tostring(v)))
		return { ok = true, value = v }
	elseif action == "reset" then
		eachField(function(pid, f) values[pid][f.key] = f.default end)
		publishAll()
		queueSave()
		return { ok = true, values = values }
	end
	return { ok = false, err = "action inconnue" }
end

Players.PlayerRemoving:Connect(function(p) lastCall[p.UserId] = nil end)

print("✅ PopupControl chargé")
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX21">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">Presence_Server</string>
					<ProtectedString name="Source"><![CDATA[--════════════════════════════════════════════════════════════════════════════
-- 🟢 Presence_Server — Script dans ServerScriptService   (NOUVEAU)
--
--  Sert la fiche profil (visible par tout le monde) : 🟢 Online / ⚫ Offline,
--  même si le joueur est sur un AUTRE serveur.
--
--  Comment : chaque serveur note ses joueurs en ligne dans une MemoryStore
--  (pas un DataStore : rien n'est sauvegardé à vie). Une écriture par joueur
--  et par minute, avec une expiration de 150 s : un joueur qui part ou un
--  serveur qui plante disparaît tout seul.
--  Lecture : 1 appel / 1,5 s par joueur (protège le quota MemoryStore du jeu),
--  résultat gardé 15 s. Un vrai joueur ouvre une fiche à la fois : il ne voit rien.
--════════════════════════════════════════════════════════════════════════════
local Players            = game:GetService("Players")
local MemoryStoreService = game:GetService("MemoryStoreService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local RunService         = game:GetService("RunService")

local map = MemoryStoreService:GetSortedMap("OnlinePresence_v1")
local TTL, REFRESH = 150, 60
local IS_STUDIO = RunService:IsStudio()

local function mark(p)
	if IS_STUDIO then return end
	pcall(function() map:SetAsync(tostring(p.UserId), 1, TTL) end)
end

Players.PlayerAdded:Connect(mark)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(mark, p) end
Players.PlayerRemoving:Connect(function(p)
	if IS_STUDIO then return end
	task.spawn(function() pcall(function() map:RemoveAsync(tostring(p.UserId)) end) end)
end)
-- rafraîchissement, étalé sur la minute (pas tout le monde à la même seconde)
task.spawn(function()
	while true do
		task.wait(REFRESH)
		local list = Players:GetPlayers()
		local gap = #list > 0 and math.min(1, (REFRESH * 0.8) / #list) or 1
		for _, p in ipairs(list) do
			if p.Parent then mark(p) end
			task.wait(gap)
		end
	end
end)

local remote = ReplicatedStorage:FindFirstChild("GetPlayerPresence")
if not remote then
	remote = Instance.new("RemoteFunction")
	remote.Name = "GetPlayerPresence"
	remote.Parent = ReplicatedStorage
end
local cache, last = {}, {}
remote.OnServerInvoke = function(player, userId)
	userId = tonumber(userId)
	if not userId or userId <= 0 or userId ~= math.floor(userId) then return nil end
	if Players:GetPlayerByUserId(userId) then return "here" end
	local now = os.clock()
	local c = cache[userId]
	if c and now - c.at < 15 then return c.v end
	if last[player.UserId] and now - last[player.UserId] < 1.5 then return nil end   -- quota MemoryStore protégé
	last[player.UserId] = now
	local ok, v = pcall(function() return map:GetAsync(tostring(userId)) end)
	if not ok then return nil end
	local res = (v ~= nil) and "online" or "offline"
	cache[userId] = { v = res, at = now }
	return res
end
Players.PlayerRemoving:Connect(function(p) last[p.UserId] = nil end)
task.spawn(function()
	while true do
		task.wait(120)
		local now = os.clock()
		for id, c in pairs(cache) do if now - c.at > 30 then cache[id] = nil end end
	end
end)
]]></ProtectedString>
				</Properties>
