-- ========================================
local questCooldownStore = DataStoreService:GetDataStore("QuestCooldowns_v2")
local warningsStore = DataStoreService:GetDataStore("PlayerWarnings_v2")
local smartAntiCheatStore = DataStoreService:GetDataStore("SmartAntiCheatData_v2")



-- ✅ Merge-max : un timestamp de claim ne peut jamais RECULER
local function mergeQuestHistory(userId, incoming)
	if type(incoming) ~= "table" then return end
	AntiExploit.questHistory[userId] = AntiExploit.questHistory[userId] or {}
	local h = AntiExploit.questHistory[userId]
	for qName, ts in pairs(incoming) do
		if type(ts) == "number" and (not h[qName] or ts > h[qName]) then
			h[qName] = ts
		end
	end
end

-- ========================================
-- 📊 FONCTIONS DE SAUVEGARDE/CHARGEMENT COOLDOWNS
-- ========================================


local function loadAllQuestCooldowns(userId)
	if questCooldownsLoaded[userId] == "fetched" then return end
	-- ("true" venant d'un snapshot/unifié ne suffit PAS : on lit quand
	--  même le store dédié, qui est la source la plus fraîche des claims)

	local key = "AllQuestCooldowns_" .. userId

	-- ✅ FIX MIGRATION : Retry 3x
	local success, data
	for attempt = 1, 3 do
		success, data = pcall(function()
			return questCooldownStore:GetAsync(key)
		end)
		if success then break end
		warn(string.format("⚠️ questCooldownStore tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.6 * attempt)
	end

	if not success then
		-- ❌ DataStore down après retries : NE PAS marquer comme loaded (sinon perte des cooldowns)
		warn(string.format("🚨 CRITIQUE: questCooldownStore inaccessible pour %d — saves bloqués jusqu'à recovery", userId))
		task.spawn(function()
			task.wait(30)
			if Players:GetPlayerByUserId(userId) then loadAllQuestCooldowns(userId) end
		end)
		return
	end

	if not AntiExploit.questHistory[userId] then
		AntiExploit.questHistory[userId] = {}
	end

	if data and type(data) == "table" then
		local now = os.time()
		local h = AntiExploit.questHistory[userId]
		for questName, lastClaim in pairs(data) do
			if type(lastClaim) == "number"
				and (now - lastClaim) < AntiExploit.CONFIG.QUEST_MIN_COOLDOWN
				and (not h[questName] or lastClaim > h[questName]) then  -- ✅ merge-max
				h[questName] = lastClaim
				local timeLeft = AntiExploit.CONFIG.QUEST_MIN_COOLDOWN - (now - lastClaim)
				print(string.format("🔒 Cooldown restauré: %s → %.1fh restantes",
					questName, timeLeft / 3600))
			end
		end
	end
	questCooldownsLoaded[userId] = "fetched"  -- ✅ store dédié bien lu
	print(string.format("✅ Cooldowns chargés pour UserID %d", userId))
end

local function saveQuestCooldown(userId, questName, timestamp)
	task.spawn(function()
		local key = "AllQuestCooldowns_" .. userId
		local saveOk, saveErr = pcall(function()
			questCooldownStore:UpdateAsync(key, function(existing)
				local toSave = (type(existing) == "table") and existing or {}
				toSave[questName] = math.max(toSave[questName] or 0, timestamp)  -- merge-max
				local now = os.time()
				for qName, ts in pairs(toSave) do
					if type(ts) ~= "number" or (now - ts) >= AntiExploit.CONFIG.QUEST_MIN_COOLDOWN then
						toSave[qName] = nil
					end
				end
				return toSave
			end)
		end)
		if saveOk then
			print(string.format("✅ Cooldown sauvegardé: %s pour UserID %d", questName, userId))
		else
			warn(string.format("❌ Erreur save cooldown %s: %s", questName, tostring(saveErr)))
		end
	end)
end


-- ========================================
-- ⚠️ FONCTIONS DE SAUVEGARDE/CHARGEMENT AVERTISSEMENTS (CORRIGÉES)
-- ========================================

-- ✅ Sauvegarder les avertissements d'un joueur
local function saveWarnings(userId)
	task.spawn(function()
		local key = "warnings_" .. userId

		local warningData = {
			infractions = AntiExploit.infractions[userId] or 0,
			lastInfraction = os.time(),
			history = {}
		}

		-- ✅ NOUVEAU : Sauvegarder l'historique des violations AntiExploit
		if AntiExploit.questHistory[userId] then
			for questName, timestamp in pairs(AntiExploit.questHistory[userId]) do
				table.insert(warningData.history, {
					type = "QUEST_COOLDOWN_BYPASS",
					quest = questName,
					timestamp = timestamp
				})
			end
		end

		-- ✅ NOUVEAU : Sauvegarder le détail SmartAntiCheat
		local smartData = SmartAntiCheat.playerData[userId]
		if smartData and smartData.infractions then
			warningData.smartAntiCheat = {
				suspiciousCount = smartData.infractions.suspiciousCount or 0,
				dangerousCount = smartData.infractions.dangerousCount or 0,
				totalInfractions = smartData.infractions.totalInfractions or 0,
				burstCount = smartData.infractions.burstCount or 0,
				lastInfractionTime = smartData.infractions.lastInfractionTime or 0
			}
		end

		-- ✅ NOUVEAU : Sauvegarder l'historique des violations depuis AntiExploit.playerTracking
		if AntiExploit.playerTracking[userId] then
			warningData.lastViolationType = AntiExploit.playerTracking[userId].lastViolationType
			warningData.lastViolationDetails = AntiExploit.playerTracking[userId].lastViolationDetails
		end

		local success, err = pcall(function()
			warningsStore:SetAsync(key, warningData)
		end)

		if success then
			print(string.format("✅ Avertissements sauvegardés pour UserID %d", userId))
		else
			warn(string.format("❌ Erreur sauvegarde avertissements %d: %s", userId, tostring(err)))
		end
	end)
end

-- ✅ Charger les avertissements d'un joueur
local function loadWarnings(userId)
	local key = "warnings_" .. userId

	-- ✅ FIX MIGRATION : Retry 3x
	local success, data
	for attempt = 1, 3 do
		success, data = pcall(function()
			return warningsStore:GetAsync(key)
		end)
		if success then break end
		warn(string.format("⚠️ warningsStore tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.5 * attempt)
	end

	-- ✅ Si toutes les tentatives ont échoué : NE PAS reset infractions à 0
	-- Laisser secureLoad les charger depuis unified (qui est la source de vérité post-migration)
	if not success then
		warn(string.format("⚠️ loadWarnings impossible pour %d, fallback unified via secureLoad", userId))
		return false
	end

	if data then
		-- Restaurer les infractions AntiExploit
		AntiExploit.infractions[userId] = data.infractions or 0

		-- Initialiser SmartAntiCheat si nécessaire
		if not SmartAntiCheat.playerData[userId] then
			SmartAntiCheat.InitPlayer(userId)
		end

		-- Restaurer SmartAntiCheat
		if data.smartAntiCheat then
			local smartData = SmartAntiCheat.playerData[userId]
			if smartData then
				smartData.infractions = {
					suspiciousCount = data.smartAntiCheat.suspiciousCount or 0,
					dangerousCount = data.smartAntiCheat.dangerousCount or 0,
					totalInfractions = data.smartAntiCheat.totalInfractions or 0,
					burstCount = data.smartAntiCheat.burstCount or 0,
					lastInfractionTime = data.smartAntiCheat.lastInfractionTime or 0
				}
			end
		end

		print(string.format("✅ Avertissements restaurés pour UserID %d (%d infractions AntiExploit)", 
			userId, 
			data.infractions
			))

		-- Afficher le détail SmartAntiCheat
		if data.smartAntiCheat then
			print(string.format("   - SmartAntiCheat: %d suspects, %d dangereux, %d total", 
				data.smartAntiCheat.suspiciousCount or 0,
				data.smartAntiCheat.dangerousCount or 0,
				data.smartAntiCheat.totalInfractions or 0
				))
		end

		return true
	else
		print(string.format("ℹ️ Aucun avertissement à restaurer pour UserID %d", userId))
		AntiExploit.infractions[userId] = 0
		return false
	end
end


-- ========================================
-- 🔄 SAUVEGARDE AUTO DES AVERTISSEMENTS (Toutes les 2 minutes)
-- ========================================
task.spawn(function()
	while true do
		task.wait(300) -- 2 minutes

		local playersWithWarnings = 0

		for _, player in ipairs(Players:GetPlayers()) do
			if player and player.Parent then
				local userId = player.UserId

				-- Vérifier AntiExploit
				local antiExploitInfractions = AntiExploit.infractions[userId] or 0

				-- Vérifier SmartAntiCheat
				local smartInfractions = 0
				local smartData = SmartAntiCheat.playerData[userId]
				if smartData and smartData.infractions then
					smartInfractions = smartData.infractions.totalInfractions or 0
				end

				-- Sauvegarder si le joueur a des avertissements
				if antiExploitInfractions > 0 or smartInfractions > 0 then
					saveWarnings(userId)
					playersWithWarnings = playersWithWarnings + 1
					task.wait(0.3)
				end
			end
		end

		if playersWithWarnings > 0 then
			print(string.format("✅ Avertissements sauvegardés pour %d joueurs", playersWithWarnings))
		end
	end
end)

