-- Fonction pour réinitialiser les avertissements d'un joueur
_G.ResetWarnings = function(userId)
	AntiExploit.infractions[userId] = 0

	local smartData = SmartAntiCheat.playerData[userId]
	if smartData then
		smartData.infractions = {
			suspiciousCount = 0,
			dangerousCount = 0,
			totalInfractions = 0,
			burstCount = 0,
			lastInfractionTime = 0
		}
	end

	saveWarnings(userId)
	print(string.format("✅ Avertissements réinitialisés pour UserID %d", userId))
end

_G.ResetCooldowns = function(userId)
	AntiExploit.questHistory[userId] = {}
	-- Effacer dans le DataStore
	task.spawn(function()
		pcall(function()
			questCooldownStore:SetAsync("AllQuestCooldowns_" .. userId, {})
		end)
	end)
	questCooldownsLoaded[userId] = nil  -- Forcer rechargement
	print(string.format("✅ Cooldowns réinitialisés pour UserID %d", userId))
end

