				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">new donation board server</string>
					<ProtectedString name="Source"><![CDATA[--[[
	TopDonatorsServer.lua  —  v3
	============================================================================
	Uniquement les correctifs SERVEUR pertinents. Aucune donnée d'affichage
	supplémentaire, aucun nouveau remote : ton UI actuelle et ton ProcessReceipt
	fonctionnent sans la moindre modification.

	🔴 CE QUI EST CORRIGÉ vs ta version

	1. flushProfiles() perdait des profils
	   `profileDirty = {}` était exécuté AVANT l'UpdateAsync. Si l'écriture
	   échouait (throttle, coupure), les noms/compteurs étaient perdus pour de
	   bon et le classement réaffichait "Joueur #123456".
	   → La file est restaurée en cas d'échec et retentée au flush suivant.

	2. Le blob profil grandissait à l'infini
	   Chaque donateur historique restait dans la clé `profiles`. Au-delà de
	   ~4 MB par clé, l'UpdateAsync échoue et le blob cesse silencieusement de
	   se mettre à jour.
	   → Élagage au top 50 + joueurs en ligne, avec un garde-fou : on n'élague
	     JAMAIS si le scan global a échoué (sinon le blob serait vidé).

	3. leaderboardStore:SetAsync n'était pas retryé
	   L'UpdateAsync du total avait 5 tentatives, mais l'écriture dans
	   l'OrderedDataStore aucune. En cas d'échec, le total était correct en
	   base mais le joueur DISPARAISSAIT du classement jusqu'à son prochain
	   achat. Et un OrderedDataStore n'accepte QUE des entiers.
	   → setOrdered() : 3 tentatives + backoff + math.floor.

	4. resetAllDonations() faisait ~4 requêtes DataStore par joueur
	   dont un UpdateAsync COMPLET du blob à chaque itération (50 joueurs =
	   50 réécritures de la même clé).
	   → Suppression en lot : 1 seul UpdateAsync du blob à la fin.

	5. INITIAL_DELAY = 8 s pour rien
	   Le budget DataStore est plein au démarrage du serveur.
	   → 2 s.

	⚡ OPTIMISATION INVISIBLE
	   UpdateLeaderboard transporte maintenant la liste dans son payload.
	   Un client qui l'utilise évite un InvokeServer ; un client qui l'ignore
	   (le tien aujourd'hui) fonctionne exactement pareil. 100 % rétro-compatible.

	INTERFACE STRICTEMENT IDENTIQUE :
	  _G.RecordDonation(userId, playerName, amount, productId)
	  GetLeaderboardData, UpdateLeaderboard, DonationSuccess, ChatNotifDonation,
	  ResetDonations, ResetPlayerDonations, AddDonationManually
--]]

local Players            = game:GetService("Players")
local DataStoreService   = game:GetService("DataStoreService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local RunService         = game:GetService("RunService")
local SoundService       = game:GetService("SoundService")
local RT                 = Enum.DataStoreRequestType

-- ========================================================================
-- CONFIG
-- ========================================================================
local TOP_COUNT                 = 50
local INITIAL_DELAY             = 2     -- ✅ était 8
local GLOBAL_REFRESH_INTERVAL   = 600
local AUTO_SAVE_INTERVAL        = 900
local SAVE_THROTTLE             = 0.3
local UPDATE_BROADCAST_DEBOUNCE = 2
local ADMIN_USER_ID             = 11017023724
local PROFILE_STORE_NAME        = "DonationProfiles_v1"
local PROFILE_BLOB_KEY          = "profiles"

local IS_STUDIO = RunService:IsStudio()

-- ========================================================================
-- DATASTORES
-- ========================================================================
local donationStore    = DataStoreService:GetDataStore("TopDonatorsV1")
local leaderboardStore = DataStoreService:GetOrderedDataStore("TopDonatorsLeaderboard")
local profileStore     = DataStoreService:GetDataStore(PROFILE_STORE_NAME)

local function playerKey(userId) return "Donation_" .. userId end

-- ========================================================================
-- REMOTES (noms identiques, aucun ajout)
-- ========================================================================
local function getOrCreate(name, class)
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r then
		r = Instance.new(class or "RemoteEvent")
		r.Name = name
		r.Parent = ReplicatedStorage
	end
	return r
end

local getLeaderboardData     = getOrCreate("GetLeaderboardData", "RemoteFunction")
local updateLeaderboardEvent = getOrCreate("UpdateLeaderboard")
local donationSuccessEvent   = getOrCreate("DonationSuccess")
local chatNotifDonationEvent = getOrCreate("ChatNotifDonation")
local resetDonationsEvent    = getOrCreate("ResetDonations")
local resetPlayerEvent       = getOrCreate("ResetPlayerDonations")
local addDonationEvent       = getOrCreate("AddDonationManually")

-- ========================================================================
-- ÉTAT MÉMOIRE
-- ========================================================================
local playerDonations   = {}   -- [userId] = {total,count,name}
local lastSavedTotal    = {}   -- [userId] = total
local profileCache      = {}   -- [userId] = {name,count}
local profileDirty      = {}   -- [userId] = true
local globalSnapshot    = {}   -- {userId,total} du dernier GetSortedAsync
local cachedTop         = {}   -- liste renvoyée au client
local globalDataLoaded  = false
local systemReady       = false
local lastGlobalRefresh = 0
local lastBroadcast     = 0

local function isAdmin(player) return player.UserId == ADMIN_USER_ID end
local function markDirty(userId) profileDirty[userId] = true end

local function budgetOK(reqType)
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(reqType)
	end)
	return (not ok) or (budget == nil) or (budget > 0)
end

-- ========================================================================
-- ✅ CORRECTIF 3 : écriture OrderedDataStore fiabilisée
-- ========================================================================
local function setOrdered(userId, total)
	local value = math.floor(tonumber(total) or 0)   -- ⚠️ entiers uniquement
	if value <= 0 then
		pcall(function() leaderboardStore:RemoveAsync(tostring(userId)) end)
		return true
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			leaderboardStore:SetAsync(tostring(userId), value)
		end)
		if ok then return true end
		warn(string.format("⚠️ SetAsync ordered %d/3 (userId %s) : %s",
			attempt, tostring(userId), tostring(err)))
		task.wait(0.5 * attempt)
	end
	warn("❌ Classement global non mis à jour pour userId " .. tostring(userId))
	return false
end

-- ========================================================================
-- NOTIFS
-- ========================================================================
local function formatNumberForChat(num)
	local formatted = tostring(num)
	while true do
		local k
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then break end
	end
	return formatted
end

local function sendDonationChatNotification(player, amount)
	if not player then return end

	-- 📢 Délégué au hub de notifs : il choisit tout seul
	--    SERVER (< seuil) ou GLOBAL cross-server (>= seuil)
	if _G.NotifyDonation then
		pcall(function() _G.NotifyDonation(player.Name, amount) end)
		return
	end

	-- Fallback si ChatNotifServer n'est pas encore chargé
	local message = string.format("[DONATION] %s donated %s R$! 💚",
		player.Name, formatNumberForChat(amount))
	for _, plr in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			pcall(function() chatNotifDonationEvent:FireClient(plr, message) end)
		end)
	end
end

-- ⚡ payload joint (rétro-compatible : ton client actuel ignore l'argument)
local function broadcastUpdate(force)
	local now = tick()
	if not force and (now - lastBroadcast) < UPDATE_BROADCAST_DEBOUNCE then return end
	lastBroadcast = now
	pcall(function()
		updateLeaderboardEvent:FireAllClients({ top = cachedTop })
	end)
end

-- ========================================================================
-- 🎉 EFFETS GLOBAUX (inchangés)
-- ========================================================================
local PARTICLE_PART_NAMES = {"DonationEffect", "DonationEffect2"}
local PARTICLE_DURATION   = 7
local FADE_DURATION       = 1
local FADE_STEPS          = 20
local MAX_SOUND_DISTANCE  = 300
local particleParts       = {}
local donationSoundTemplate = nil
local effectsReady        = false

local function initializeDonationEffects()
	donationSoundTemplate = SoundService:FindFirstChild("Donation")
	if not donationSoundTemplate then
		warn("⚠️ Son 'Donation' introuvable dans SoundService!")
	end
	for _, partName in ipairs(PARTICLE_PART_NAMES) do
		local part = workspace:FindFirstChild(partName)
		if part then
			part.Transparency = 1
			local emitters = {}
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("ParticleEmitter") then
					child.Enabled = false
					table.insert(emitters, {emitter = child, originalRate = child.Rate})
				end
			end
			table.insert(particleParts, {part = part, emitters = emitters})
		else
			warn("⚠️ Part '" .. partName .. "' introuvable dans Workspace!")
		end
	end
	effectsReady = true
	print("✅ Effets de donation initialisés!")
end

local lastEffectAt = -1e9
local EFFECT_MIN_GAP = 3   -- s : une rafale de dons ne relance pas l'effet 10 fois de suite
local function playGlobalDonationEffects()
	if not effectsReady then return end
	local nowFx = os.clock()
	if nowFx - lastEffectAt < EFFECT_MIN_GAP then return end
	lastEffectAt = nowFx
	if donationSoundTemplate and #particleParts > 0 then
		for _, partData in ipairs(particleParts) do
			task.spawn(function()
				local sound = donationSoundTemplate:Clone()
				sound.Parent = partData.part
				sound.RollOffMode = Enum.RollOffMode.Linear
				sound.RollOffMaxDistance = MAX_SOUND_DISTANCE
				sound.RollOffMinDistance = 10
				sound.EmitterSize = 10
				local originalVolume = sound.Volume
				sound:Play()
				task.delay(PARTICLE_DURATION - FADE_DURATION, function()
					local fadeDelay = FADE_DURATION / FADE_STEPS
					for i = 1, FADE_STEPS do
						if sound and sound.Parent then
							sound.Volume = originalVolume * (1 - (i / FADE_STEPS))
							task.wait(fadeDelay)
						end
					end
					if sound and sound.Parent then sound:Stop() end
				end)
				task.delay(PARTICLE_DURATION + 2, function()
					if sound and sound.Parent then sound:Destroy() end
				end)
			end)
		end
	end
	if #particleParts > 0 then
		task.spawn(function()
			for _, partData in ipairs(particleParts) do
				for _, e in ipairs(partData.emitters) do e.emitter.Enabled = true end
			end
			task.delay(PARTICLE_DURATION - FADE_DURATION, function()
				local fadeDelay = FADE_DURATION / FADE_STEPS
				for i = 1, FADE_STEPS do
					for _, partData in ipairs(particleParts) do
						for _, e in ipairs(partData.emitters) do
							e.emitter.Rate = e.originalRate * (1 - (i / FADE_STEPS))
						end
					end
					task.wait(fadeDelay)
				end
				for _, partData in ipairs(particleParts) do
					for _, e in ipairs(partData.emitters) do
						e.emitter.Enabled = false
						e.emitter.Rate = e.originalRate
					end
				end
			end)
		end)
	end
end

task.spawn(function()
	task.wait(5)
	initializeDonationEffects()
end)

-- ========================================================================
-- PROFIL BLOB
-- ========================================================================
local function loadProfileBlob()
	local ok, stored = pcall(function() return profileStore:GetAsync(PROFILE_BLOB_KEY) end)
	if ok and type(stored) == "table" then
		for k, v in pairs(stored) do
			local id = tonumber(k)
			if id and type(v) == "table" then
				profileCache[id] = profileCache[id] or v
			end
		end
	end
end

-- ✅ CORRECTIF 1 (perte de profils) + CORRECTIF 2 (croissance infinie)
local function flushProfiles()
	if next(profileDirty) == nil then return end
	if not budgetOK(RT.UpdateAsync) then return end

	local batch, queued = {}, {}
	for id in pairs(profileDirty) do
		if profileCache[id] then
			batch[tostring(id)] = profileCache[id]
			table.insert(queued, id)
		end
	end
	if next(batch) == nil then profileDirty = {}; return end
	profileDirty = {}

	-- Qui survit à l'élagage : le top affiché + les joueurs en ligne
	-- + tout ce qu'on est en train d'écrire.
	local keep = {}
	for _, e in ipairs(globalSnapshot) do keep[tostring(e.userId)] = true end
	for _, p in ipairs(Players:GetPlayers()) do keep[tostring(p.UserId)] = true end
	for k in pairs(batch) do keep[k] = true end

	-- 🛡️ Garde-fou indispensable : si le GetSortedAsync a échoué,
	-- globalSnapshot est vide → élaguer VIDERAIT le blob entier.
	local canPrune = (#globalSnapshot >= TOP_COUNT)

	local ok, err = pcall(function()
		profileStore:UpdateAsync(PROFILE_BLOB_KEY, function(old)
			old = (type(old) == "table") and old or {}
			for k, v in pairs(batch) do old[k] = v end
			if canPrune then
				for k in pairs(old) do
					if not keep[k] then old[k] = nil end
				end
			end
			return old
		end)
	end)

	if not ok then
		-- ✅ RESTAURATION : rien n'est perdu, retenté au prochain flush
		for _, id in ipairs(queued) do profileDirty[id] = true end
		warn("⚠️ flushProfiles échoué (" .. tostring(err) .. ") — "
			.. #queued .. " profils remis en file d'attente")
	end
end

-- ✅ CORRECTIF 4 : suppression en LOT (1 requête au lieu de N)
local function removeProfilesFromBlob(ids)
	if type(ids) ~= "table" or #ids == 0 then return end
	pcall(function()
		profileStore:UpdateAsync(PROFILE_BLOB_KEY, function(old)
			if type(old) ~= "table" then return old end
			for _, id in ipairs(ids) do old[tostring(id)] = nil end
			return old
		end)
	end)
end

local function resolveProfile(userId)
	local prof = profileCache[userId]
	if prof and prof.name then return prof end

	local online = Players:GetPlayerByUserId(userId)
	if online then
		prof = { name = online.Name, count = (prof and prof.count) or 0 }
		profileCache[userId] = prof; markDirty(userId)
		return prof
	end

	local ok, data = pcall(function() return donationStore:GetAsync(playerKey(userId)) end)
	if ok and type(data) == "table" and data.name then
		prof = { name = data.name, count = data.count or 0 }
		profileCache[userId] = prof; markDirty(userId)
		return prof
	end

	local ok2, uname = pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
	prof = { name = (ok2 and uname) or ("Joueur #" .. userId), count = 0 }
	profileCache[userId] = prof; markDirty(userId)
	return prof
end

-- ========================================================================
-- CONSTRUIRE LE TOP
-- ========================================================================
local function buildCachedTop()
	local merged, seen = {}, {}

	for _, p in ipairs(Players:GetPlayers()) do
		local d = playerDonations[p.UserId]
		if d and d.total > 0 and not seen[p.UserId] then
			seen[p.UserId] = true
			table.insert(merged, {
				userId = p.UserId, total = d.total, count = d.count, name = p.Name,
			})
		end
	end

	for _, e in ipairs(globalSnapshot) do
		if e.total and e.total > 0 and not seen[e.userId] then
			seen[e.userId] = true
			local prof = profileCache[e.userId]
			table.insert(merged, {
				userId = e.userId,
				total  = e.total,
				count  = (prof and prof.count) or 0,
				name   = (prof and prof.name) or ("Joueur #" .. e.userId),
			})
		end
	end

	table.sort(merged, function(a, b) return a.total > b.total end)

	local result = {}
	for i = 1, math.min(TOP_COUNT, #merged) do result[i] = merged[i] end
	cachedTop = result
end

-- ========================================================================
-- REFRESH GLOBAL (1 GetSortedAsync + 1 blob)
-- ========================================================================
local function loadAllGlobalDonators(isStartup)
	local now = os.time()
	if globalDataLoaded and lastGlobalRefresh > 0
		and (now - lastGlobalRefresh) < GLOBAL_REFRESH_INTERVAL then
		return
	end
	if not budgetOK(RT.GetSortedAsync) then return end

	local ok, pages = pcall(function()
		return leaderboardStore:GetSortedAsync(false, TOP_COUNT)
	end)
	if not ok or not pages then
		warn("⚠️ Impossible de charger le top global")
		globalDataLoaded = true; lastGlobalRefresh = now
		return
	end

	local entries = pages:GetCurrentPage()
	loadProfileBlob()

	globalSnapshot = {}
	local unknown = {}
	for _, entry in ipairs(entries) do
		local userId = tonumber(entry.key)
		local total  = entry.value
		if userId and total and total > 0 then
			table.insert(globalSnapshot, { userId = userId, total = total })
			if not (profileCache[userId] and profileCache[userId].name) then
				table.insert(unknown, userId)
			end
		end
	end

	for _, userId in ipairs(unknown) do
		if not budgetOK(RT.GetAsync) then break end
		resolveProfile(userId)
		task.wait(isStartup and 0.15 or 0.25)
	end

	flushProfiles()
	buildCachedTop()
	globalDataLoaded  = true
	lastGlobalRefresh = now
end

-- ========================================================================
-- CHARGER UN JOUEUR
-- ========================================================================
local function loadPlayerData(userId, playerName)
	local ok, data = pcall(function() return donationStore:GetAsync(playerKey(userId)) end)
	if ok and type(data) == "table" then
		playerDonations[userId] = {
			total = data.total or 0,
			count = data.count or 0,
			name  = playerName or data.name,
		}
	else
		playerDonations[userId] = { total = 0, count = 0, name = playerName }
	end
	lastSavedTotal[userId] = playerDonations[userId].total
	profileCache[userId] = {
		name  = playerDonations[userId].name,
		count = playerDonations[userId].count,
	}
	markDirty(userId)
end

-- ========================================================================
-- DELTA ATOMIQUE
-- ========================================================================
local function applyDonationDelta(userId, playerName, amount)
	local newTotal, newCount
	local saved = false

	for attempt = 1, 5 do
		local ok = pcall(function()
			donationStore:UpdateAsync(playerKey(userId), function(old)
				old = (type(old) == "table") and old or { total = 0, count = 0 }
				old.total     = (old.total or 0) + amount
				old.count     = (old.count or 0) + 1
				old.name      = playerName
				old.timestamp = os.time()
				newTotal = old.total
				newCount = old.count
				return old
			end)
		end)
		if ok and newTotal then
			saved = true
			break
		end
		warn(string.format("⚠️ Tentative %d/5 UpdateAsync échouée pour %s",
			attempt, tostring(playerName)))
		task.wait(1)
	end

	if not saved then
		warn(string.format("❌ ÉCHEC CRITIQUE : donation de %s non sauvegardée!",
			tostring(playerName)))
		return nil
	end

	playerDonations[userId] = { total = newTotal, count = newCount, name = playerName }
	lastSavedTotal[userId]  = newTotal
	profileCache[userId]    = { name = playerName, count = newCount }
	markDirty(userId)

	setOrdered(userId, newTotal)   -- ✅ retryé

	-- maintien du snapshot local (évite d'attendre le prochain scan global)
	local found = false
	for _, e in ipairs(globalSnapshot) do
		if e.userId == userId then e.total = newTotal; found = true; break end
	end
	if not found then
		table.insert(globalSnapshot, { userId = userId, total = newTotal })
	end
	table.sort(globalSnapshot, function(a, b) return a.total > b.total end)
	while #globalSnapshot > TOP_COUNT do table.remove(globalSnapshot) end

	buildCachedTop()
	return newTotal
end

-- ========================================================================
-- 🌍 CROSS-SERVER : effet + son + board mis à jour sur TOUS les serveurs
--   Le serveur qui reçoit le don publie un petit message ; les autres jouent
--   l'effet du board et mettent leur classement à jour tout de suite
--   (avant : effet uniquement sur le serveur du don, board des autres serveurs
--   mis à jour seulement toutes les 10 min).
--   Coût : 1 PublishAsync par don (rare), aucune requête DataStore en plus.
-- ========================================================================
local MessagingService = game:GetService("MessagingService")
local XS_TOPIC = "DonationBoardFX_v1"
local XS_JOB   = game.JobId

local function publishDonationXS(userId, name, amount, total, count)
	if IS_STUDIO then return end
	task.spawn(function()
		local msg = { u = userId, n = tostring(name or ""):sub(1, 40), a = amount,
			t = total, c = count, j = XS_JOB }
		for attempt = 1, 3 do
			local ok = pcall(function() MessagingService:PublishAsync(XS_TOPIC, msg) end)
			if ok then return end
			task.wait(attempt)
		end
		warn("⚠️ Donation : effet cross-server non publié")
	end)
end

local function onDonationXS(message)
	local d = type(message) == "table" and message.Data
	if type(d) ~= "table" or d.j == XS_JOB then return end   -- notre propre écho : déjà joué
	local userId, total = tonumber(d.u), tonumber(d.t)
	if not userId or userId <= 0 or not total or total <= 0 or total ~= total then return end
	total = math.floor(total)
	local count = math.max(0, math.floor(tonumber(d.c) or 0))
	local name = (type(d.n) == "string" and d.n ~= "") and d.n or nil

	-- classement : on ne fait que MONTER (un message en retard ne fait jamais reculer un total)
	local found = false
	for _, e in ipairs(globalSnapshot) do
		if e.userId == userId then
			found = true
			if total > (e.total or 0) then e.total = total end
			break
		end
	end
	if not found then table.insert(globalSnapshot, { userId = userId, total = total }) end
	table.sort(globalSnapshot, function(x, y) return x.total > y.total end)
	while #globalSnapshot > TOP_COUNT do table.remove(globalSnapshot) end
	if name then
		local prof = profileCache[userId]
		profileCache[userId] = { name = name, count = math.max(count, (prof and prof.count) or 0) }
	end
	if systemReady then
		buildCachedTop()
		broadcastUpdate(true)
	end
	playGlobalDonationEffects()
end

task.spawn(function()
	if IS_STUDIO then return end
	for attempt = 1, 10 do
		local ok, err = pcall(function() MessagingService:SubscribeAsync(XS_TOPIC, onDonationXS) end)
		if ok then return end
		warn("⚠️ Donation cross-server : abonnement échoué (" .. tostring(err) .. "), nouvel essai")
		task.wait(math.min(60, 5 * attempt))
	end
end)

-- ========================================================================
-- ENREGISTRER UNE DONATION (appelée par ton ProcessReceipt externe)
-- ========================================================================
local function recordDonation(userId, playerName, amount, productId)
	if type(amount) ~= "number" or amount <= 0 then
		warn("❌ Montant invalide:", amount)
		return false
	end

	local newTotal = applyDonationDelta(userId, playerName, amount)
	if not newTotal then return false end

	print(string.format("✅ DONATION: %s (+%d R$) → total %d", playerName, amount, newTotal))
	local pd = playerDonations[userId]
	publishDonationXS(userId, playerName, amount, newTotal, pd and pd.count or 0)

	task.spawn(function()
		local player = Players:GetPlayerByUserId(userId)
		if player then
			pcall(function() donationSuccessEvent:FireClient(player, amount) end)
			sendDonationChatNotification(player, amount)
		end
		playGlobalDonationEffects()
	end)

	broadcastUpdate(false)
	return true
end

_G.RecordDonation = recordDonation

-- ========================================================================
-- DONATION MANUELLE (admin)
-- ========================================================================
local function addManualDonation(targetUserId, amount, targetName)
	if type(amount) ~= "number" or amount <= 0 then
		return false, "Montant invalide"
	end

	local newTotal = applyDonationDelta(targetUserId, targetName, amount)
	if not newTotal then return false, "Échec de sauvegarde" end

	print(string.format("✅ DONATION MANUELLE: %s (+%d R$) → total %d",
		targetName, amount, newTotal))
	local pdm = playerDonations[targetUserId]
	publishDonationXS(targetUserId, targetName, amount, newTotal, pdm and pdm.count or 0)
	task.spawn(function() playGlobalDonationEffects() end)

	local player = Players:GetPlayerByUserId(targetUserId)
	if player then
		task.spawn(function()
			pcall(function() donationSuccessEvent:FireClient(player, amount) end)
			sendDonationChatNotification(player, amount)
		end)
	end

	broadcastUpdate(true)
	return true, string.format("Donation de %d R$ ajoutée avec succès!", amount)
end

-- ========================================================================
-- RESET D'UN JOUEUR
--   deferBlob = true → le lot s'occupera du blob (utilisé par resetAll)
-- ========================================================================
local function resetPlayerDonations(targetUserId, targetName, deferBlob)
	local resetData = { total = 0, count = 0, name = targetName, timestamp = os.time() }

	playerDonations[targetUserId] = { total = 0, count = 0, name = targetName }
	lastSavedTotal[targetUserId]  = 0

	pcall(function() donationStore:SetAsync(playerKey(targetUserId), resetData) end)
	task.wait(SAVE_THROTTLE)
	pcall(function() leaderboardStore:RemoveAsync(tostring(targetUserId)) end)

	profileCache[targetUserId] = nil
	profileDirty[targetUserId] = nil
	if not deferBlob then
		removeProfilesFromBlob({ targetUserId })
	end

	for i = #globalSnapshot, 1, -1 do
		if globalSnapshot[i].userId == targetUserId then table.remove(globalSnapshot, i) end
	end

	if not deferBlob then
		buildCachedTop()
		broadcastUpdate(true)
	end
	return true
end

-- ========================================================================
-- ✅ CORRECTIF 4 : RESET COMPLET — 1 seul UpdateAsync du blob
-- ========================================================================
local function resetAllDonations()
	local ids, seen = {}, {}

	local ok, pages = pcall(function()
		return leaderboardStore:GetSortedAsync(false, TOP_COUNT)
	end)
	if ok and pages then
		for _, entry in ipairs(pages:GetCurrentPage()) do
			local id = tonumber(entry.key)
			if id and not seen[id] then seen[id] = true; table.insert(ids, id) end
		end
	end
	for id in pairs(playerDonations) do
		if not seen[id] then seen[id] = true; table.insert(ids, id) end
	end

	local count = 0
	for i, id in ipairs(ids) do
		local name = (playerDonations[id] and playerDonations[id].name) or ("Joueur #" .. id)
		resetPlayerDonations(id, name, true)   -- ⬅️ blob différé
		count = count + 1
		if i % 5 == 0 then task.wait(0.5) end
	end

	removeProfilesFromBlob(ids)   -- ✅ une seule requête pour tout le monde

	globalSnapshot    = {}
	cachedTop         = {}
	globalDataLoaded  = false
	lastGlobalRefresh = 0

	broadcastUpdate(true)
	print(string.format("🗑️ Reset complet : %d donateurs effacés", count))
	return count
end

-- ========================================================================
-- SUPPRIMER LE DONATEUR À UN RANG
-- ========================================================================
local function deleteDonatorAtRank(targetRank)
	targetRank = tonumber(targetRank)
	if not targetRank or targetRank < 1 or targetRank > TOP_COUNT then
		return false, "Rang invalide (1-" .. TOP_COUNT .. ")"
	end
	local target = cachedTop[targetRank]
	if not target then return false, "Aucun donateur à la place " .. targetRank end

	resetPlayerDonations(target.userId, target.name)
	print(string.format("🗑️ Place #%d supprimée : %s (userId %d)",
		targetRank, target.name, target.userId))
	return true, string.format("Place #%d (%s) supprimée!", targetRank, target.name)
end

-- ========================================================================
-- SAUVEGARDE (dirty-tracking)
-- ========================================================================
local function savePlayerIfDirty(userId)
	local d = playerDonations[userId]
	if not d then return end
	if lastSavedTotal[userId] == d.total then return end

	pcall(function()
		donationStore:SetAsync(playerKey(userId), {
			total = d.total, count = d.count, name = d.name, timestamp = os.time(),
		})
	end)
	setOrdered(userId, d.total)
	lastSavedTotal[userId] = d.total
end

-- ========================================================================
-- EVENTS ADMIN
-- ========================================================================
resetDonationsEvent.OnServerEvent:Connect(function(player)
	if not isAdmin(player) then player:Kick("Action non autorisée"); return end
	local n = resetAllDonations()
	pcall(function() resetDonationsEvent:FireClient(player, true, n) end)
end)

resetPlayerEvent.OnServerEvent:Connect(function(player, targetUserId)
	if not isAdmin(player) then player:Kick("Action non autorisée"); return end
	targetUserId = tonumber(targetUserId)
	if not targetUserId then
		pcall(function() resetPlayerEvent:FireClient(player, false, "UserId invalide") end)
		return
	end
	local targetName = "Joueur #" .. targetUserId
	local tp = Players:GetPlayerByUserId(targetUserId)
	if tp then targetName = tp.Name
	elseif playerDonations[targetUserId] then targetName = playerDonations[targetUserId].name end

	local ok = resetPlayerDonations(targetUserId, targetName)
	pcall(function() resetPlayerEvent:FireClient(player, ok, targetName) end)
end)

addDonationEvent.OnServerEvent:Connect(function(player, targetUserId, amount)
	if not isAdmin(player) then player:Kick("Action non autorisée"); return end
	targetUserId = tonumber(targetUserId); amount = tonumber(amount)
	if not targetUserId then
		pcall(function() addDonationEvent:FireClient(player, false, "UserId invalide") end); return
	end
	if not amount or amount <= 0 then
		pcall(function() addDonationEvent:FireClient(player, false, "Montant invalide") end); return
	end

	local targetName = "Joueur #" .. targetUserId
	local tp = Players:GetPlayerByUserId(targetUserId)
	if tp then targetName = tp.Name
	elseif playerDonations[targetUserId] then targetName = playerDonations[targetUserId].name
	else
		local ok, res = pcall(function() return Players:GetNameFromUserIdAsync(targetUserId) end)
		if ok and res then targetName = res end
	end

	local ok, msg = addManualDonation(targetUserId, amount, targetName)
	pcall(function() addDonationEvent:FireClient(player, ok, msg) end)
end)

-- ========================================================================
-- JOUEUR REJOINT
-- ========================================================================
Players.PlayerAdded:Connect(function(player)
	task.spawn(function()
		while not systemReady do task.wait(0.5) end
		task.wait(math.random(1, 2))
		loadPlayerData(player.UserId, player.Name)
		buildCachedTop()
		broadcastUpdate(false)
	end)

	if player.UserId == ADMIN_USER_ID then
		player.Chatted:Connect(function(message)
			local lower = string.lower(message)
			if lower == "/resetdonations" then
				resetAllDonations()
				task.wait(1)
				globalDataLoaded = false; lastGlobalRefresh = 0
				loadAllGlobalDonators(false)
			elseif string.sub(lower, 1, 12) == "/resetplayer" then
				local id = tonumber(string.sub(message, 14))
				if id then
					local name = "Joueur #" .. id
					local tp = Players:GetPlayerByUserId(id)
					if tp then name = tp.Name elseif playerDonations[id] then name = playerDonations[id].name end
					resetPlayerDonations(id, name)
				end
			elseif string.sub(lower, 1, 12) == "/deleteplace" then
				local rank = tonumber(string.sub(message, 14))
				if rank then
					local ok, msg = deleteDonatorAtRank(rank)
					print((ok and "✅ " or "❌ ") .. tostring(msg))
				else
					warn("❌ Format: /deleteplace [rang]")
				end
			elseif string.sub(lower, 1, 12) == "/adddonation" then
				local args = string.split(message, " ")
				if #args == 3 then
					local id = tonumber(args[2]); local amt = tonumber(args[3])
					if id and amt and amt > 0 then
						local name = "Joueur #" .. id
						local tp = Players:GetPlayerByUserId(id)
						if tp then name = tp.Name
						elseif playerDonations[id] then name = playerDonations[id].name
						else
							local ok, res = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
							if ok and res then name = res end
						end
						local ok, msg = addManualDonation(id, amt, name)
						print((ok and "✅ " or "❌ ") .. tostring(msg))
					else
						warn("❌ Format: /adddonation UserId Amount")
					end
				else
					warn("❌ Format: /adddonation UserId Amount")
				end
			end
		end)
	end
end)

-- ========================================================================
-- JOUEUR QUITTE
-- ========================================================================
Players.PlayerRemoving:Connect(function(player)
	task.spawn(function()
		savePlayerIfDirty(player.UserId)
		flushProfiles()
		playerDonations[player.UserId] = nil
		lastSavedTotal[player.UserId]  = nil
	end)
end)

-- ========================================================================
-- INIT
-- ========================================================================
if IS_STUDIO then warn("🧪 MODE STUDIO") end

task.spawn(function()
	task.wait(INITIAL_DELAY)          -- ✅ 2 s
	loadAllGlobalDonators(true)

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function() loadPlayerData(player.UserId, player.Name) end)
		task.wait(0.1)
	end

	task.wait(1)
	buildCachedTop()
	systemReady = true
	broadcastUpdate(true)
	print("✅ Système de donations initialisé!")
end)

-- ========================================================================
-- REFRESH GLOBAL PÉRIODIQUE
-- ========================================================================
task.spawn(function()
	while true do
		task.wait(GLOBAL_REFRESH_INTERVAL)
		if #Players:GetPlayers() > 0 then
			globalDataLoaded = false
			loadAllGlobalDonators(false)
			broadcastUpdate(true)
		end
	end
end)

-- ========================================================================
-- AUTO-SAVE
-- ========================================================================
task.spawn(function()
	while true do
		task.wait(AUTO_SAVE_INTERVAL)
		for _, player in ipairs(Players:GetPlayers()) do
			savePlayerIfDirty(player.UserId)
			task.wait(SAVE_THROTTLE)
		end
		flushProfiles()
	end
end)

-- ========================================================================
-- FERMETURE
-- ========================================================================
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		savePlayerIfDirty(player.UserId)
	end
	flushProfiles()
	task.wait(2)
end)

-- ========================================================================
-- BRIDGE UI (forme de données identique : {userId,total,count,name})
-- ========================================================================
getLeaderboardData.OnServerInvoke = function()
	if not globalDataLoaded or not systemReady then return {} end
	return cachedTop
end

print("✅ TopDonators Server v3 chargé — UI/ProcessReceipt inchangés")]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX29">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">notif chat </string>
					<ProtectedString name="Source"><![CDATA[-- ========================================
-- CHAT NOTIF SERVER
-- Script (serveur) → ServerScriptService
-- ========================================
-- Gère les notifications dans le chat pour :
--   ✅ Les achats normaux de Developer Products (_G.NotifyPurchase)
--   ✅ Les gifts de POINTS entre joueurs          (_G.NotifyGift)
--   ✅ Les gifts d'OBJETS entre joueurs           (_G.NotifyGiftItem)  ⟵ NOUVEAU
--   ✅ Les UGC récupérés                          (_G.NotifyUGC)
--   ✅ Les donations                              (_G.NotifyDonation)
--
-- Communication cross-server via MessagingService pour les gros montants.
--
-- ⟦ v3 : ANNONCES FIABLES ⟧
--   • Une annonce globale s'affiche TOUT DE SUITE sur le serveur d'origine,
--     sans attendre le retour de MessagingService (avant : si ce retour se
--     perdait, même les joueurs du serveur ne voyaient rien — c'était le cas
--     des UGC, qui passaient UNIQUEMENT par MessagingService). Le retour
--     (écho) est ensuite ignoré : jamais affiché deux fois.
--   • PublishAsync réessaie 3 fois ; SubscribeAsync réessaie jusqu'à réussir
--     (avant : un échec au démarrage = ce serveur ne recevait plus AUCUNE
--     annonce globale jusqu'à sa fermeture).
--   • _G.NotifyUGC est appelé par le UGC REDEEM LOG pour TOUS les redeems
--     confirmés (achat direct, vérifié, tardif, au retour…), avec un
--     anti-doublon de 5 min par joueur + UGC.
--
-- ⟦ CE QUI A CHANGÉ ⟧
--   • Ajout de _G.NotifyGiftItem : VIP, boosts, armes et spins sont enfin
--     annoncés dans le chat. Ils passent par le MÊME topic que les gifts de
--     points (GlobalGiftNotif) — pas de second canal à maintenir, pas de
--     second abonnement, et les deux types d'annonces se ressemblent.
--   • Nettoyage : sendDonationToPlayers était défini deux fois à l'identique,
--     et le print final était dupliqué.
-- ========================================

local Players          = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MessagingService = game:GetService("MessagingService")

-- ========================================
-- CONFIG: ACHATS DEV PRODUCTS
-- ========================================
local PRODUCTS = {
	[3606598188] = { name = "1,000 Points",     points = 1000,    price = 2,   global = false },
	[3606598763] = { name = "2,500 Points",     points = 2500,    price = 4,   global = false },
	[3606598849] = { name = "100,000 Points",   points = 100000,  price = 29,  global = false },
	[3606598712] = { name = "500,000 Points",   points = 500000,  price = 149, global = true  },
	[3606598746] = { name = "2,000,000 Points", points = 2000000, price = 499, global = true  },
}

-- Seuil au-dessus duquel un gift de POINTS est annoncé en GLOBAL (cross-server)
local GIFT_GLOBAL_THRESHOLD = 500000

-- Seuil au-dessus duquel une donation est annoncée en GLOBAL (cross-server)
local DONATION_GLOBAL_THRESHOLD = 10   -- 🔧 en Robux

-- ========================================
-- REMOTE EVENT
-- ========================================
local chatNotifEvent = ReplicatedStorage:FindFirstChild("ChatNotifPurchase")
if not chatNotifEvent then
	chatNotifEvent = Instance.new("RemoteEvent")
	chatNotifEvent.Name = "ChatNotifPurchase"
	chatNotifEvent.Parent = ReplicatedStorage
end

-- Remote des donations (déjà écouté par ton LocalScript donation)
local chatNotifDonationEvent = ReplicatedStorage:FindFirstChild("ChatNotifDonation")
if not chatNotifDonationEvent then
	chatNotifDonationEvent = Instance.new("RemoteEvent")
	chatNotifDonationEvent.Name = "ChatNotifDonation"
	chatNotifDonationEvent.Parent = ReplicatedStorage
end

-- SÉCURITÉ : on ne connecte JAMAIS OnServerEvent (le client est lecture seule)

-- ========================================
-- HELPERS
-- ========================================
local function formatNumber(num)
	local formatted = tostring(num)
	while true do
		local newFormatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		formatted = newFormatted
		if k == 0 then break end
	end
	return formatted
end

--  Nettoie un morceau de texte avant de l'envoyer dans le chat.
--
--  Les libellés viennent de GIFT_CONFIG côté serveur et les pseudos de
--  Roblox : rien de tout ça n'est écrit par un joueur. Ce nettoyage n'est
--  donc pas une protection contre un exploit, c'est un garde-fou contre une
--  faute de frappe dans la config — un retour à la ligne ou un libellé de
--  200 caractères casserait l'affichage du chat pour tout le monde.
local function cleanText(s, maxLen, fallback)
	if type(s) ~= "string" then return fallback end
	s = s:gsub("[%c]", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
	if #s == 0 then return fallback end
	if #s > (maxLen or 48) then s = s:sub(1, maxLen or 48) end
	return s
end

local function sendMessageToPlayers(message, isGlobal)
	local prefix = isGlobal and "[GLOBAL]" or "[SERVER]"
	local fullMessage = prefix .. " " .. message

	for _, plr in ipairs(Players:GetPlayers()) do
		pcall(function()
			chatNotifEvent:FireClient(plr, fullMessage)
		end)
	end
end

-- Donations : le message arrive DÉJÀ complet, aucun préfixe ajouté
local function sendDonationToPlayers(fullMessage)
	for _, plr in ipairs(Players:GetPlayers()) do
		pcall(function()
			chatNotifDonationEvent:FireClient(plr, fullMessage)
		end)
	end
end

-- Envoi brut sur le chat "purchase" (pour les UGC, préfixe déjà inclus)
local function sendRawToPlayers(fullMessage)
	for _, plr in ipairs(Players:GetPlayers()) do
		pcall(function()
			chatNotifEvent:FireClient(plr, fullMessage)
		end)
	end
end

-- ========================================
-- GLOBAL FIABLE : affichage local immédiat + publication avec réessais
-- ========================================
local sentHere = {} -- [topic .. "|" .. message] = os.clock() : annonces déjà affichées ICI

local function isOwnEcho(topic, message)
	local k = topic .. "|" .. message
	local t = sentHere[k]
	if t and os.clock() - t < 120 then
		sentHere[k] = nil
		return true
	end
	return false
end

-- deliverLocal = la fonction qui affiche sur CE serveur (même rendu que l'écho)
local function publishGlobal(topic, message, deliverLocal)
	sentHere[topic .. "|" .. message] = os.clock()
	deliverLocal(message)
	task.spawn(function()
		for attempt = 1, 3 do
			local ok, err = pcall(function()
				MessagingService:PublishAsync(topic, message)
			end)
			if ok then return end
			warn(string.format("[ChatNotif] PublishAsync %s échoué (%d/3) : %s", topic, attempt, tostring(err)))
			task.wait(2 * attempt)
		end
	end)
end

-- Ménage des échos jamais revenus
task.spawn(function()
	while true do
		task.wait(60)
		local now = os.clock()
		for k, t in pairs(sentHere) do
			if now - t > 120 then sentHere[k] = nil end
		end
	end
end)

-- ========================================
-- ABONNEMENTS CROSS-SERVER (réessaie jusqu'à réussir)
-- ========================================
local function subscribe(topic, handler)
	task.spawn(function()
		local attempt = 0
		while true do
			attempt += 1
			local ok, err = pcall(function()
				MessagingService:SubscribeAsync(topic, function(data)
					local msg = data and data.Data
					if type(msg) ~= "string" or isOwnEcho(topic, msg) then return end
					handler(msg)
				end)
			end)
			if ok then return end
			warn(string.format("[ChatNotif] SubscribeAsync %s échoué (essai %d) : %s", topic, attempt, tostring(err)))
			task.wait(math.min(60, 5 * attempt))
		end
	end)
end

local function sendGlobalToPlayers(message) sendMessageToPlayers(message, true) end

subscribe("GlobalPurchaseNotif", sendGlobalToPlayers)   -- achats globaux
subscribe("GlobalGiftNotif", sendGlobalToPlayers)       -- gifts globaux (points ET objets)
subscribe("GlobalUGCNotif", sendRawToPlayers)           -- UGC récupérés (toujours global)
subscribe("GlobalDonationNotif", sendDonationToPlayers) -- donations globales

-- ========================================
-- API : ACHAT
-- ========================================
_G.NotifyPurchase = function(userId, productName, points)
	local player = Players:GetPlayerByUserId(userId)
	if not player then return end

	local productData
	for _, data in pairs(PRODUCTS) do
		if data.name == productName then
			productData = data
			break
		end
	end
	if not productData then return end

	local pointsFmt = formatNumber(points)

	-- 🆕 plus de prix en Robux dans l'annonce (jeu free-to-play : on montre le gain, pas le prix)
	local message = string.format(
		"%s bought %s Points!",
		player.Name,
		pointsFmt
	)

	if productData.global then
		publishGlobal("GlobalPurchaseNotif", message, sendGlobalToPlayers)
	else
		sendMessageToPlayers(message, false)
	end
end

-- ========================================
-- API : GIFT DE POINTS
-- ========================================
_G.NotifyGift = function(senderId, senderName, receiverId, receiverName, points)
	if type(points) ~= "number" or points <= 0 then return end

	senderName   = cleanText(senderName,   30, "Someone")
	receiverName = cleanText(receiverName, 30, "Someone")

	local pointsFmt = formatNumber(points)

	local message = string.format(
		"%s gifted %s Points to %s!",
		senderName,
		pointsFmt,
		receiverName
	)

	if points >= GIFT_GLOBAL_THRESHOLD then
		-- GLOBAL : tous les serveurs (affiché ici tout de suite, l'écho est ignoré)
		publishGlobal("GlobalGiftNotif", message, sendGlobalToPlayers)
	else
		-- SERVER : seulement ce serveur
		sendMessageToPlayers(message, false)
	end
end

-- ========================================
-- API : GIFT D'OBJET  (VIP, boosts, armes, spins)   ⟵ NOUVEAU
-- ========================================
--  Appelée par GiftingServer avec :
--     senderId, senderName, receiverId, receiverName, label, isGlobal
--
--  `label` est le nom lisible de ce qui a été offert, tel que le calcule
--  GIFT_CONFIG : « x10 Forever », « AK47 », « 3 Spins », « VIP »,
--  « x25 — 30 min »…
--
--  `isGlobal` n'est PAS décidé ici : GiftingServer le déduit du champ
--  `announce` de l'item (VIP et boosts permanents = "global", le reste =
--  "server"). Ce script se contente d'obéir. Si tu veux changer quel cadeau
--  est crié sur tous les serveurs, c'est dans GIFT_CONFIG que ça se règle,
--  à un seul endroit.
--
--  ⚠️ Fail-safe volontaire : un `isGlobal` absent ou bizarre est traité
--     comme "serveur uniquement". Une annonce ratée est un détail ; une
--     annonce globale envoyée par erreur spamme tous les serveurs du jeu.
-- ========================================
_G.NotifyGiftItem = function(senderId, senderName, receiverId, receiverName, label, isGlobal)
	label = cleanText(label, 48, nil)
	if not label then return end   -- rien à annoncer : on se tait

	senderName   = cleanText(senderName,   30, "Someone")
	receiverName = cleanText(receiverName, 30, "Someone")

	-- Auto-gift : on n'annonce pas « X gifted VIP to X », ça n'a aucun sens
	-- pour ceux qui lisent le chat.
	if senderId and receiverId and senderId == receiverId then return end

	local message = string.format(
		"%s gifted %s to %s!",
		senderName,
		label,
		receiverName
	)

	if isGlobal == true then
		publishGlobal("GlobalGiftNotif", message, sendGlobalToPlayers)
	else
		sendMessageToPlayers(message, false)
	end
end

-- ========================================
-- API : UGC RÉCUPÉRÉ (toujours GLOBAL)
-- ========================================
local ugcAnnounced = {} -- [userId|nom] = os.time() : anti-doublon (log + achat direct)
_G.NotifyUGC = function(userId, playerName, ugcName, price)
	ugcName = cleanText(ugcName, 48, "a UGC")
	local key = tostring(userId) .. "|" .. ugcName:lower()
	local now = os.time()
	if ugcAnnounced[key] and now - ugcAnnounced[key] < 300 then return end
	ugcAnnounced[key] = now

	local name = cleanText(playerName, 30, "Someone")
	local plr = Players:GetPlayerByUserId(tonumber(userId) or 0)
	if plr then name = plr.Name end

	local message = string.format(
		"[UGC REDEEM] %s redeemed %s!",
		name,
		ugcName
	)

	publishGlobal("GlobalUGCNotif", message, sendRawToPlayers)
end

-- ========================================
-- API : DONATION
-- ========================================
_G.NotifyDonation = function(playerName, amount)
	amount = math.floor(tonumber(amount) or 0)
	if amount <= 0 then return end

	local name = playerName or "Someone"

	if amount >= DONATION_GLOBAL_THRESHOLD then
		-- GLOBAL : tous les serveurs (affiché ici tout de suite, l'écho est ignoré)
		local message = string.format("[GLOBAL DONATION] %s donated %s R$! 💚",
			name, formatNumber(amount))
		publishGlobal("GlobalDonationNotif", message, sendDonationToPlayers)
	else
		-- SERVER : seulement ce serveur
		local message = string.format("[SERVER DONATION] %s donated %s R$! 💚",
			name, formatNumber(amount))
		sendDonationToPlayers(message)
	end
end

print("✅ CHAT NOTIF SERVER chargé (purchases + gifts points + gifts objets + UGC + donations)")]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX30">
				<Properties>
					<bool name="Disabled">true</bool>
					<string name="Name">server referal friend invite</string>
					<ProtectedString name="Source"><![CDATA[-- ========================================
-- 🎁 REFERRAL SYSTEM — version corrigee
-- À placer dans ServerScriptService (remplace l'ancien script)
-- ========================================
--[[
CORRECTIONS APPORTEES :
  1. Anti-alt : le parrain n'est credite que si le filleul a un compte
     de MIN_ACCOUNT_AGE jours ou plus (le filleul, lui, touche toujours).
  2. UpdateAsync atomique partout (claim / compteur / pending) :
     plus de lost update, plus de double-claim, cap de 10 non contournable.
  3. Le claim est reserve AVANT paiement, mais si le paiement echoue
     (joueur parti, data pas chargee), les points partent dans la file
     "pending" -> livres au prochain login. Rien n'est perdu.
  4. Les joueurs deja connectes au demarrage du script sont traites
     (avant : ils etaient ignores a cause du repeat/until).
  5. giveReferralPoints abandonne proprement si le chargement principal
     n'est pas fini -> plus de points ecrases par le loader.
  6. ReferralReceivedEvent n'est envoye que si le filleul va vraiment
     recevoir quelque chose.
  7. Cache du compteur avec TTL + purge (plus de fuite memoire ni de
     valeur perimee entre serveurs).
  8. Debounce sur PromptInvite (anti spam FireServer).
]]

local Players           = game:GetService("Players")
local DataStoreService  = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ========================================
-- CONFIG
-- ========================================
local REFERRAL_REWARD      = 3000
local REFERRAL_MAX_INVITES = 10

-- 🛡️ ANTI-ALT : age minimum du compte du FILLEUL (en jours) pour que
-- le PARRAIN soit credite. Le filleul touche sa recompense dans tous les cas.
-- Mets 0 pour desactiver.
local MIN_ACCOUNT_AGE = 7

-- 🆕 VRAI NOUVEAU JOUEUR OBLIGATOIRE (personne n'est payé sinon)
--   Avant : n'importe quel joueur qui n'avait JAMAIS été « filleul » comptait, même
--   avec 100 h de jeu. Deux amis pouvaient s'inviter l'un l'autre à des jours
--   différents (A invite B, puis B invite A) : 12 000 pts pour les mêmes amis.
--   Maintenant le filleul doit arriver pour la PREMIÈRE fois dans le jeu :
--     • moins de NEW_MAX_PLAYTIME s de jeu enregistrées AVANT cette session
--     • et (si connue) 1re arrivée il y a moins de NEW_MAX_FIRSTJOIN_AGE s
local NEW_MAX_PLAYTIME      = 600    -- 10 min
local NEW_MAX_FIRSTJOIN_AGE = 1800   -- 30 min

local MAX_PENDING          = 999999999
local COUNT_CACHE_TTL      = 60    -- s
local LOAD_WAIT_TIMEOUT    = 15    -- s d'attente max du chargement principal
local PROMPT_INVITE_COOLDOWN = 2   -- s, anti spam client

-- ========================================
-- ATTENTE DU SCRIPT PRINCIPAL
-- ========================================
repeat task.wait(0.1) until _G.tempsJoueurs
	and _G.SmartAntiCheat
	and _G.AntiExploit
	and _G.secureSave
	and _G.applyAllBonuses
	and _G.calculatePoints
	and _G.buyGamePassEvent

print("✅ ReferralSystem: Script principal détecté, démarrage...")

local SmartAntiCheat   = _G.SmartAntiCheat
local AntiExploit      = _G.AntiExploit
local secureSave       = _G.secureSave
local applyAllBonuses  = _G.applyAllBonuses
local calculatePoints  = _G.calculatePoints
local buyGamePassEvent = _G.buyGamePassEvent
-- ⚠️ tempsJoueurs / dataLoading sont lus via _G a chaque usage :
--    si le script principal les reassigne, on ne garde pas une ref morte.

-- ========================================
-- DATASTORES
-- ========================================
local referralClaimedStore = DataStoreService:GetDataStore("ReferralClaimed_v2")
local referralPendingStore = DataStoreService:GetDataStore("ReferralPending_v2")
local referralCountStore   = DataStoreService:GetDataStore("ReferralInviteCount_v1")

-- ========================================
-- REMOTE EVENTS
-- ========================================
local function getOrCreateRemote(name, className)
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r then
		r = Instance.new(className or "RemoteEvent")
		r.Name   = name
		r.Parent = ReplicatedStorage
	end
	return r
end

local referralRewardEvent   = getOrCreateRemote("ReferralRewardNotify")
local referralReceivedEvent = getOrCreateRemote("ReferralReceivedEvent")
local promptInviteEvent     = getOrCreateRemote("PromptInvite")

-- ========================================
-- HELPER : UpdateAsync avec retries
-- ========================================
local function safeUpdate(store, key, transform, label)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, transform)
		end)
		if ok then return true end
		warn(string.format("⚠️ [REFERRAL] %s UpdateAsync %d/3 : %s",
			label or key, attempt, tostring(err)))
		task.wait(attempt)
	end
	return false
end

-- ========================================
-- CACHE COMPTEUR D'INVITES (avec TTL)
-- ========================================
local referralInviteCountCache = {}  -- [userId] = {value = n, at = os.time()}

local function setCountCache(userId, value)
	referralInviteCountCache[userId] = { value = value, at = os.time() }
end

local function getReferralCount(referrerId)
	local c = referralInviteCountCache[referrerId]
	if c and (os.time() - c.at) < COUNT_CACHE_TTL then
		return c.value
	end
	local ok, val = pcall(function()
		return referralCountStore:GetAsync("count_" .. referrerId)
	end)
	local count = (ok and type(val) == "number") and val or 0
	setCountCache(referrerId, count)
	return count
end

-- Purge periodique du cache
task.spawn(function()
	while true do
		task.wait(300)
		local now = os.time()
		for id, c in pairs(referralInviteCountCache) do
			if (now - c.at) > COUNT_CACHE_TTL * 5 then
				referralInviteCountCache[id] = nil
			end
		end
	end
end)

-- ========================================
-- ⚛️ CONSOMMER UNE INVITE (atomique, respecte le cap)
-- retourne : granted(boolean), count(number), capped(boolean), dsFailed(boolean)
-- ========================================
local function tryConsumeInvite(referrerId)
	local newCount, capped = 0, false

	local ok = safeUpdate(referralCountStore, "count_" .. referrerId, function(old)
		local c = (type(old) == "number") and old or 0
		if c >= REFERRAL_MAX_INVITES then
			capped   = true
			newCount = c
			return nil   -- annule l'ecriture
		end
		newCount = c + 1
		capped   = false
		return newCount
	end, "count_" .. referrerId)

	if not ok then
		return false, 0, false, true
	end

	setCountCache(referrerId, newCount)
	return (not capped), newCount, capped, false
end

-- ========================================
-- ⚛️ RESERVER LA RECOMPENSE DU FILLEUL (atomique, anti double-claim)
-- retourne : reserved(boolean), dsFailed(boolean)
-- ========================================
local function tryReserveInviteeClaim(userId)
	local reserved = false

	local ok = safeUpdate(referralClaimedStore, "invitee_" .. userId, function(old)
		-- compat ancien format (booleen true)
		local alreadyClaimed = (old == true)
			or (type(old) == "table" and old.claimed == true)
		if alreadyClaimed then
			reserved = false
			return nil   -- annule l'ecriture
		end
		reserved = true
		return { claimed = true, at = os.time() }
	end, "invitee_" .. userId)

	if not ok then return false, true end
	return reserved, false
end

-- ========================================
-- ⚛️ FILE D'ATTENTE HORS-LIGNE (atomique)
-- ========================================
local function queueReferralOffline(userId, amount)
	if amount <= 0 then return end
	local total = 0
	local ok = safeUpdate(referralPendingStore, "pending_" .. userId, function(old)
		local cur = (type(old) == "number") and old or 0
		total = math.min(cur + amount, MAX_PENDING)
		return total
	end, "pending_" .. userId)

	if ok then
		print(string.format("💾 Referral offline: UserID %d → +%d pts stockés (total: %d)",
			userId, amount, total))
	else
		warn(string.format("❌ [REFERRAL] Impossible de stocker %d pts pour UserID %d",
			amount, userId))
	end
end

-- ========================================
-- DONNER DES POINTS
-- retourne true si les points ont bien ete credites
-- ========================================
local function giveReferralPoints(player, amount, source)
	if not player or not player.Parent then return false end
	local userId = player.UserId

	-- Attendre la fin du chargement principal
	local waited = 0
	while _G.dataLoading and _G.dataLoading[userId] and waited < LOAD_WAIT_TIMEOUT * 10 do
		task.wait(0.1)
		waited += 1
	end

	-- ⚠️ Timeout : on N'ECRIT PAS (le loader ecraserait les points ensuite)
	if _G.dataLoading and _G.dataLoading[userId] then
		warn(string.format("⚠️ [REFERRAL] Chargement toujours en cours pour %s → mise en attente",
			player.Name))
		return false
	end

	if not player.Parent then return false end

	local tempsJoueurs = _G.tempsJoueurs
	if not tempsJoueurs then return false end

	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = { base = 0, future = 0, lastSaved = 0 }
	end

	SmartAntiCheat.ExpectGain(userId, amount, source)
	tempsJoueurs[userId].future = tempsJoueurs[userId].future + amount

	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat  = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value  = applyAllBonuses(calculatePoints(totalPoints), player)
		player:SetAttribute("Points", pointsStat.Value)
	end

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, amount, source)
		local tj = _G.tempsJoueurs
		if tj and tj[userId] then
			secureSave(userId, tj[userId].base + tj[userId].future)
		end
	end)

	AntiExploit.questHistory[userId] = AntiExploit.questHistory[userId] or {}

	pcall(function()
		referralRewardEvent:FireClient(player, amount, source)
		buyGamePassEvent:FireClient(player)
	end)

	if _G.EngageStats then pcall(_G.EngageStats.Referral, userId, amount, source) end
	print(string.format("🎁 REFERRAL: %s → +%d pts (%s)", player.Name, amount, source))
	return true
end

-- Paie si possible, sinon met en file d'attente. Ne perd jamais les points.
local function payOrQueue(userId, amount, source)
	local player = Players:GetPlayerByUserId(userId)
	if player and player.Parent then
		if giveReferralPoints(player, amount, source) then
			return true
		end
	end
	queueReferralOffline(userId, amount)
	return false
end

-- ========================================
-- DISTRIBUER LES POINTS EN ATTENTE AU LOGIN (atomique)
-- ========================================
local function claimPendingReferral(player)
	local userId = player.UserId
	local key    = "pending_" .. userId

	local waited = 0
	while _G.dataLoading and _G.dataLoading[userId] and waited < LOAD_WAIT_TIMEOUT * 10 do
		task.wait(0.1)
		waited += 1
	end
	task.wait(0.5)
	if not player.Parent then return end

	-- Prend le montant ET remet a 0 en une seule operation atomique
	local taken = 0
	local ok = safeUpdate(referralPendingStore, key, function(old)
		local cur = (type(old) == "number") and old or 0
		if cur <= 0 then
			taken = 0
			return nil   -- rien a faire, pas d'ecriture
		end
		taken = cur
		return 0
	end, key)

	if not ok or taken <= 0 then return end

	if giveReferralPoints(player, taken, "Referral_Pending") then
		print(string.format("🎁 Points referral en attente livrés à %s: +%d pts",
			player.Name, taken))
	else
		-- Paiement impossible -> on remet dans la file, rien n'est perdu
		queueReferralOffline(userId, taken)
	end
end

-- ========================================
-- 🆕 LE FILLEUL EST-IL UN VRAI NOUVEAU JOUEUR ?
-- true = nouveau · false = a déjà joué · nil = impossible à savoir (on ne paie pas)
-- ========================================
local ServerScriptService = game:GetService("ServerScriptService")
local function isGenuinelyNew(player)
	-- temps de jeu enregistré AVANT cette session (posé par le script principal au chargement)
	local pt
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < 20 do
		pt = player:GetAttribute("PlaytimeSeconds")
		if pt ~= nil then break end
		task.wait(0.5)
	end
	if type(pt) ~= "number" then return nil end
	if pt > NEW_MAX_PLAYTIME then return false end
	-- 2e signal : date de 1re arrivée (sécurité supplémentaire), si elle est connue
	local okB, bridge = pcall(function()
		return require(ServerScriptService:FindFirstChild("CapFirstJoinBridge"))
	end)
	if okB and type(bridge) == "table" and type(bridge.get) == "function" then
		local fj
		local t1 = os.clock()
		while player.Parent and os.clock() - t1 < 15 do
			fj = bridge.get(player.UserId)
			if fj then break end
			task.wait(0.5)
		end
		if type(fj) == "number" and os.time() - fj > NEW_MAX_FIRSTJOIN_AGE then return false end
	end
	return true
end

-- ========================================
-- TRAITER LE REFERRAL AU JOIN
-- ========================================
local function handleReferral(player)
	local userId = player.UserId

	local joinData
	local ok = pcall(function() joinData = player:GetJoinData() end)
	if not ok or not joinData then return end

	local referrerId = joinData.ReferredByPlayerId
	if not referrerId or referrerId == 0 or referrerId == userId then return end

	print(string.format("🔗 Referral: %s (ID:%d, compte %d j) invité par UserID %d",
		player.Name, userId, player.AccountAge, referrerId))

	-- ── 0. Seulement pour un joueur qui découvre le jeu ─────────────
	local isNew = isGenuinelyNew(player)
	if isNew ~= true then
		print(string.format("⛔ Referral ignoré : %s %s → personne n'est payé", player.Name,
			isNew == false and "a déjà joué au jeu" or "(données non chargées)"))
		if isNew == false then
			local referrerPlayer = Players:GetPlayerByUserId(referrerId)
			if referrerPlayer and referrerPlayer.Parent then
				pcall(function() referralRewardEvent:FireClient(referrerPlayer, 0, "Referral_NotNew") end)
			end
		end
		return
	end

	-- ── 1. Recompense du filleul (reservation atomique) ──────────────
	local reserved, dsFailed = tryReserveInviteeClaim(userId)

	if dsFailed then
		warn(string.format("⚠️ [REFERRAL] DataStore indisponible pour %s, réessai au prochain join",
			player.Name))
		return
	end

	if reserved then
		pcall(function()
			referralReceivedEvent:FireClient(player, referrerId)
		end)
		-- payOrQueue : si le joueur part ou que sa data n'est pas prête,
		-- les points sont stockés et livrés au prochain login.
		payOrQueue(userId, REFERRAL_REWARD, "Referral_Invitee")
	else
		print(string.format("ℹ️ %s a déjà sa récompense referral", player.Name))
	end

	-- ── 2. Recompense du parrain ─────────────────────────────────────
	if AntiExploit.bannedPlayers[referrerId] then
		warn(string.format("🚫 Referrer banni ignoré: %d", referrerId))
		return
	end

	-- 🛡️ ANTI-ALT : compte du filleul trop récent
	if MIN_ACCOUNT_AGE > 0 and player.AccountAge < MIN_ACCOUNT_AGE then
		warn(string.format("🛡️ Anti-alt: compte de %s trop récent (%d j < %d j) → parrain %d non crédité",
			player.Name, player.AccountAge, MIN_ACCOUNT_AGE, referrerId))
		local referrerPlayer = Players:GetPlayerByUserId(referrerId)
		if referrerPlayer and referrerPlayer.Parent then
			pcall(function()
				referralRewardEvent:FireClient(referrerPlayer, 0, "Referral_TooNew")
			end)
		end
		return
	end

	-- Le filleul n'a jamais compté pour personne ? (evite qu'un meme
	-- filleul credite plusieurs parrains via plusieurs liens)
	if not reserved then
		print(string.format("ℹ️ %s a déjà été compté comme filleul → parrain non crédité",
			player.Name))
		return
	end

	-- Incremente le compteur du parrain de facon atomique (cap respecte)
	local granted, newCount, capped, countFailed = tryConsumeInvite(referrerId)

	if countFailed then
		warn(string.format("⚠️ [REFERRAL] Compteur indisponible pour UserID %d → parrain non crédité",
			referrerId))
		return
	end

	if capped or not granted then
		print(string.format("⛔ Limite atteinte pour UserID %d (%d/%d), parrain non récompensé",
			referrerId, newCount, REFERRAL_MAX_INVITES))
		local referrerPlayer = Players:GetPlayerByUserId(referrerId)
		if referrerPlayer and referrerPlayer.Parent then
			pcall(function()
				referralRewardEvent:FireClient(referrerPlayer, 0, "Referral_CapReached")
			end)
		end
		return
	end

	print(string.format("✅ Parrain UserID %d → invite #%d/%d",
		referrerId, newCount, REFERRAL_MAX_INVITES))

	payOrQueue(referrerId, REFERRAL_REWARD, "Referral_Inviter")
end

-- ========================================
-- HOOK JOUEURS (+ ceux deja connectes)
-- ========================================
local handledPlayers = {}

local function onPlayerAdded(player)
	local userId = player.UserId
	if handledPlayers[userId] then return end
	handledPlayers[userId] = true

	task.spawn(function()
		local waited = 0
		while _G.dataLoading and _G.dataLoading[userId] and waited < 200 do
			task.wait(0.1)
			waited += 1
		end
		task.wait(0.5)
		if not player.Parent then return end

		task.spawn(function()
			local ok, err = pcall(claimPendingReferral, player)
			if not ok then warn("[REFERRAL] claimPending: " .. tostring(err)) end
		end)

		local ok, err = pcall(handleReferral, player)
		if not ok then warn("[REFERRAL] handleReferral: " .. tostring(err)) end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)

-- ⚠️ Les joueurs arrivés PENDANT le repeat/until d'attente du script
-- principal étaient ignorés dans l'ancienne version.
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	handledPlayers[player.UserId] = nil
end)

-- ========================================
-- PROMPT INVITE (avec debounce anti-spam)
-- ========================================
local lastPromptInvite = {}

promptInviteEvent.OnServerEvent:Connect(function(player)
	local now  = os.clock()
	local last = lastPromptInvite[player.UserId]
	if last and (now - last) < PROMPT_INVITE_COOLDOWN then return end
	lastPromptInvite[player.UserId] = now
	print(string.format("📨 %s a ouvert le prompt d'invitation", player.Name))
end)

Players.PlayerRemoving:Connect(function(player)
	lastPromptInvite[player.UserId] = nil
end)

