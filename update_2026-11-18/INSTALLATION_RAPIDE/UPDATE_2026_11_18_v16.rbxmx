-- 🔒 SESSION LOCK STORE
local SESSION_LOCK_STORE = DataStoreService:GetDataStore("SessionLocks_v1")
local SESSION_LOCK_DURATION = 500

local function acquireSessionLock(userId, points, questSnapshot)
	local lockData = {
		points = points,
		timestamp = os.time(),
		expiresAt = os.time() + SESSION_LOCK_DURATION,
		questSnapshot = questSnapshot
	}
	local ok, err = pcall(function()
		SESSION_LOCK_STORE:SetAsync("lock_" .. userId, lockData)
	end)
	if ok then
		print(string.format("🔒 SessionLock posé: %d → %d pts", userId, points))
		return true
	else
		warn(string.format("❌ SessionLock échoué pour %d: %s", userId, tostring(err)))
		return false
	end
end

local function readSessionLock(userId)
	local ok, data = pcall(function()
		return SESSION_LOCK_STORE:GetAsync("lock_" .. userId)
	end)
	if not ok or not data then return nil end
	if os.time() > data.expiresAt then
		print(string.format("⚠️ SessionLock expiré pour %d", userId))
		return nil
	end
	return data
end

local function releaseSessionLock(userId)
	task.spawn(function()
		pcall(function()
			SESSION_LOCK_STORE:RemoveAsync("lock_" .. userId)
		end)
		print(string.format("🔓 SessionLock libéré: %d", userId))
	end)
end

