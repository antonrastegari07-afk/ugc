-- ⏱️ PLAYTIME TRACKING
local playerPlaytime = {}       -- [userId] = secondes lifetime
local playerSessionStart = {}   -- [userId] = os.time() début session

local function getCurrentPlaytime(userId)
	local lifetime = playerPlaytime[userId] or 0
	local sessionStart = playerSessionStart[userId]
	if sessionStart then
		return lifetime + (os.time() - sessionStart)
	end
	return lifetime
end
_G.getCurrentPlaytime = getCurrentPlaytime

-- ⏱️ FIX PLAYTIME QUI S'EFFACE
--    Le playtime ne peut JAMAIS reculer : si la base en contient plus que la
--    mémoire (chargement depuis un lock incomplet, rejoin rapide, etc.), on
--    remonte la mémoire au lieu d'écraser la base.
--    ⚠️ Dans _G, pas en local : limite des 200 registres du script.
_G.PlaytimeRepair = function(userId, storedSeconds)
	if not Players:GetPlayerByUserId(userId) then return end
	local current = getCurrentPlaytime(userId)
	if type(storedSeconds) ~= "number" or storedSeconds <= current then return end
	local start = playerSessionStart[userId]
	playerPlaytime[userId] = storedSeconds - (start and (os.time() - start) or 0)
	local p = Players:GetPlayerByUserId(userId)
	if p then p:SetAttribute("PlaytimeSeconds", storedSeconds) end
	warn(string.format("⏱️ Playtime réparé pour %d : %d s en mémoire → %d s (valeur en base)",
		userId, current, storedSeconds))
end


-- ========================================
-- 🆕 SYSTÈME DE DÉTECTION DU CHECKPOINT ACTUEL
-- ========================================

local playerCurrentCheckpoint = {} 

local function getOrCreateCheckpointUID(part, rebirthCount)
	rebirthCount = rebirthCount or 0

	local uid = part:GetAttribute("CheckpointUID")
	if not uid then
		local pos = part.Position
		uid = string.format("%s_%d_%d_%d", 
			part.Name,
			math.floor(pos.X),
			math.floor(pos.Y),
			math.floor(pos.Z)
		)
		part:SetAttribute("CheckpointUID", uid)
	end

	return string.format("%s_R%d", uid, rebirthCount)
end
-- Track le checkpoint le plus haut atteint
local checkpointPositions = {} -- Cache des positions de tous les checkpoints

-- Fonction pour obtenir tous les checkpoints triés par position Y
local function getAllCheckpointsSorted()
	if #checkpointPositions > 0 then
		return checkpointPositions
	end

	local checkpoints = {}
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and part.Name == "PointLevel" then
			table.insert(checkpoints, {
				part = part,
				position = part.Position,
				yPos = part.Position.Y
			})
		end
	end

	-- Trier par hauteur (Y)
	table.sort(checkpoints, function(a, b)
		return a.yPos < b.yPos
	end)

	checkpointPositions = checkpoints
	print(string.format("📍 %d checkpoints détectés et triés", #checkpoints))

	return checkpoints
end

-- Fonction pour détecter le checkpoint actuel du joueur
local function detectPlayerCheckpoint(player)
	local character = player.Character
	if not character then return nil end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return nil end

	local playerPos = humanoidRootPart.Position
	local allCheckpoints = getAllCheckpointsSorted()

	-- Trouver le checkpoint le plus proche en dessous du joueur
	local closestCheckpoint = nil
	local closestDistance = math.huge

	for _, cpData in ipairs(allCheckpoints) do
		-- Ne considérer que les checkpoints en dessous ou au même niveau
		if cpData.yPos <= playerPos.Y + 10 then
			local distance = (cpData.position - playerPos).Magnitude
			if distance < closestDistance then
				closestDistance = distance
				closestCheckpoint = cpData
			end
		end
	end

	return closestCheckpoint
end

-- Fonction pour marquer tous les checkpoints inférieurs comme récoltés
local function markLowerCheckpointsAsCollected(player, currentCheckpoint)
	if not currentCheckpoint then return 0 end
	if not currentCheckpoint.yPos or type(currentCheckpoint.yPos) ~= "number" then
		warn(string.format("⚠️ markLowerCheckpoints: yPos invalide pour %s", player.Name))
		return 0
	end

	local userId = player.UserId
	local allCheckpoints = getAllCheckpointsSorted()
	local markedCount = 0
	local rebirthCount = playerRebirthCount[userId] or 0

	print(string.format("🔒 Marquage checkpoints pour %s (Rebirth: %d, Y=%.1f)", 
		player.Name, rebirthCount, currentCheckpoint.yPos))

	local dataFolder = player:FindFirstChild("CheckpointData")
	if not dataFolder then
		dataFolder = Instance.new("Folder")
		dataFolder.Name = "CheckpointData"
		dataFolder.Parent = player
	end

	-- Marquer les checkpoints en dessous dans le folder (pour bloquer le farming)
	for _, cpData in ipairs(allCheckpoints) do
		if cpData.yPos <= currentCheckpoint.yPos + 2 then
			local part = cpData.part
			local checkpointUID = getOrCreateCheckpointUID(part, rebirthCount)
			local countKey = "checkpoint_" .. tostring(checkpointUID)

			if not dataFolder:FindFirstChild(countKey) then
				local marker = Instance.new("BoolValue")
				marker.Name = countKey
				marker.Value = true
				marker.Parent = dataFolder
				markedCount = markedCount + 1
			end
		end
	end

	print(string.format("✅ %d nouveaux checkpoints marqués dans le folder pour %s", markedCount, player.Name))

	-- ✅ CRUCIAL : NE PAS toucher playerCheckpoints[userId] ici
	-- La valeur chargée depuis le DataStore est la source de vérité
	-- Le folder sert uniquement à bloquer le re-farming, pas à compter
	-- playerCheckpoints[userId] a déjà été chargé par loadCheckpointQuestData

	print(string.format("📊 playerCheckpoints[%d] conservé depuis DataStore: %d", 
		userId, playerCheckpoints[userId] or 0))

	return markedCount
end

local function rebuildCheckpointFolder(player)
	local userId = player.UserId
	local touched = playerTouchedCheckpoints[userId]
	if not touched then return end

	-- Ne reconstruire que si playerCheckpoints < 100 pour ne pas bloquer les touches restantes
	local currentCount = playerCheckpoints[userId] or 0
	local requiredCount = 90
	if currentCount >= requiredCount then
		return
	end

	local dataFolder = player:FindFirstChild("CheckpointData")
	if not dataFolder then
		dataFolder = Instance.new("Folder")
		dataFolder.Name = "CheckpointData"
		dataFolder.Parent = player
	end

	-- Vider le folder d'abord pour repartir proprement
	dataFolder:ClearAllChildren()

	local count = 0
	for uid, _ in pairs(touched) do
		local countKey = "checkpoint_" .. tostring(uid)
		local marker = Instance.new("BoolValue")
		marker.Name = countKey
		marker.Value = true
		marker.Parent = dataFolder
		count = count + 1
	end

end

-- Fonction de validation (utilisée par SmartAntiCheat)
-- ✅ FIX : Au lieu de RESET À 0 (perte totale) sur valeurs hors range, on clamp.
-- JAMAIS de reset à 0 silencieux pour des points élevés.
local function validatePoints(points)
	if type(points) ~= "number" then 
		warn(string.format("⚠️ validatePoints: type invalide (%s), retour 0", type(points)))
		return 0 
	end
	if points ~= points then  -- NaN check
		warn("⚠️ validatePoints: NaN détecté, retour 0")
		return 0
	end
	if points < 0 then 
		warn(string.format("⚠️ validatePoints: négatif (%d), retour 0", points))
		return 0 
	end
	-- Limite augmentée à 1000 milliards. Lua/Roblox supporte sans souci jusqu'à 2^53.
	-- Clamp au max au lieu de reset à 0 si dépassement (anormal mais préserve les points).
	if points > 1000000000000 then 
		warn(string.format("⚠️ validatePoints: %d > 1T, clamping (anormal!)", points))
		return 1000000000000 
	end
	return points
end

-- =====================================
-- 🧠 SYSTÈME ANTI-CHEAT INTELLIGENT OPTIMISÉ
-- ========================================

local SmartAntiCheat = {
	CONFIG = {
		-- ✅ OPTIMISÉ: Analyse moins fréquente
		ANALYSIS_INTERVAL = 60,
		BATCH_SIZE = 5,
		BATCH_DELAY = 0.2,

		MAX_HISTORY_SIZE = 10,
		SAMPLE_WINDOW = 60,

		SUSPICIOUS_THRESHOLD = 2.0,
		DANGEROUS_THRESHOLD = 3.5,
		INSTANT_BAN_THRESHOLD = 5.0,

		GRACE_PERIOD = 60,
		BURST_TOLERANCE = 2,
		QUEST_SPIKE_TOLERANCE = 60000,
		DEVPRODUCT_TOLERANCE = 2200000,

		MIN_CHECK_INTERVAL = 45,
		ALERT_COOLDOWN = 60,

		WARN_THRESHOLD = 2,
		KICK_THRESHOLD = 2.5,
		BAN_THRESHOLD = 3.5,

		MIN_LOG_UNVALIDATED_GAIN = 1000,  -- Montant minimum pour logger les gains non validés
	},

	playerData = {},
	globalStats = {
		totalAnalyses = 0,
		totalWarnings = 0,
		totalKicks = 0,
		totalBans = 0,
		lastCleanup = os.time(),
	},

	calculationCache = {},
	cacheExpiry = {},
}

function SmartAntiCheat.InitPlayer(userId)
	-- ✅ CORRECTION: Toujours réinitialiser pointsHistory si corrompu
	if SmartAntiCheat.playerData[userId] then
		local data = SmartAntiCheat.playerData[userId]
		if not data.pointsHistory or type(data.pointsHistory) ~= "table" then
			warn(string.format("⚠️ pointsHistory corrompu pour %d, réinitialisation", userId))
			data.pointsHistory = {}
		end
		return
	end

	SmartAntiCheat.playerData[userId] = {
		userId = userId,
		sessionStart = os.time(),
		lastAnalysis = 0,
		lastAlert = 0,

		-- ✅ NOUVEAU : flag de calibration pour nouveaux joueurs
		firstAnalysisDone = false,

		pointsHistory = {},

		lastKnownPoints = 0,
		lastCheckTime = os.time(),

		dataLoaded = false,
		initialPoints = 0,

		profile = {
			hasGamepass = false,
			gamepassMultiplier = 1,
			hasPremium = false,
			inGroup = false,
			friendCount = 0,
			lastProfileUpdate = 0,
		},

		infractions = {
			suspiciousCount = 0,
			dangerousCount = 0,
			totalInfractions = 0,
			burstCount = 0,
			lastInfractionTime = 0,
		},

		inGracePeriod = true,

		-- ✅ NOUVEAU : Fenêtre de validation simple
		validationWindow = {
			expectedGains = {},  -- Liste des gains attendus
			lastCleanup = os.time()
		}
	}
end

function SmartAntiCheat.ValidateGainInWindow(userId, pointsGained)
	local data = SmartAntiCheat.playerData[userId]
	if not data then return false end

	local now = os.time()
	local window = data.validationWindow

	if not window or not window.expectedGains then
		return false
	end

	-- ✅ LOG seulement si > seuil
	if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
		print(string.format("🔎 Validation: %d pts | %d gains en attente", 
			pointsGained, #window.expectedGains))
	end

	-- ✅ NOUVELLE LOGIQUE : Essayer de valider avec la SOMME des gains

	-- Essai 1: Chercher UN gain qui correspond
	for i, gain in ipairs(window.expectedGains) do
		local timeDiff = math.abs(now - gain.timestamp)
		local pointsDiff = math.abs(pointsGained - gain.points)

		local tolerance = gain.points < 500 and 0.50 or 0.30
		if pointsDiff <= (gain.points * tolerance) then
			table.remove(window.expectedGains, i)

			-- ✅ LOG seulement si > seuil
			if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
				print(string.format("✅ Gain validé (unique): %d pts (attendu: %d, écart: %ds)", 
					pointsGained, gain.points, timeDiff))
			end
			return true
		end
	end

	-- ✅ Essai 2: Essayer d'additionner plusieurs gains
	if #window.expectedGains > 1 then
		-- Calculer la somme de TOUS les gains dans la fenêtre
		local totalExpected = 0
		local gainsToRemove = {}

		for i, gain in ipairs(window.expectedGains) do
			totalExpected = totalExpected + gain.points
			table.insert(gainsToRemove, i)
		end

		local pointsDiff = math.abs(pointsGained - totalExpected)

		-- ✅ Si la somme correspond (±30%)
		if pointsDiff <= (totalExpected * 0.30) then
			-- ✅ LOG seulement si > seuil
			if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
				print(string.format("✅ Gains CUMULÉS validés: %d pts ≈ %d pts attendus (%d gains)", 
					pointsGained, totalExpected, #gainsToRemove))
			end

			-- Supprimer TOUS les gains utilisés
			for i = #gainsToRemove, 1, -1 do
				table.remove(window.expectedGains, gainsToRemove[i])
			end

			return true
		end

		-- ✅ Essai 3: Essayer des combinaisons partielles (2 gains, 3 gains, etc.)
		for numGains = 2, #window.expectedGains - 1 do
			local sum = 0
			local indices = {}

			for i = 1, numGains do
				sum = sum + window.expectedGains[i].points
				table.insert(indices, i)
			end

			local diff = math.abs(pointsGained - sum)

			if diff <= (sum * 0.30) then
				-- ✅ LOG seulement si > seuil
				if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN then
					print(string.format("✅ Gains PARTIELS validés: %d pts ≈ %d pts attendus (%d/%d gains)", 
						pointsGained, sum, numGains, #window.expectedGains))
				end

				-- Supprimer les gains utilisés
				for i = #indices, 1, -1 do
					table.remove(window.expectedGains, indices[i])
				end

				return true
			end
		end
	end

	-- ✅ Aucune combinaison ne fonctionne
	-- ✅ LOG DÉTAILLÉ seulement si > seuil
	if pointsGained >= SmartAntiCheat.CONFIG.MIN_LOG_UNVALIDATED_GAIN and #window.expectedGains > 0 then
		print(string.format("⚠️ Gain NON validé: %d pts | Gains attendus:", pointsGained))

		local totalInWindow = 0
		for i, gain in ipairs(window.expectedGains) do
			local age = now - gain.timestamp
			totalInWindow = totalInWindow + gain.points
			print(string.format("   %d. %d pts | %s | il y a %ds", 
				i, gain.points, gain.source, age))
		end

		print(string.format("   TOTAL fenêtre: %d pts (écart: %d)", totalInWindow, pointsGained - totalInWindow))
	end

	return false
end

-- ✅ NOUVEAU : Enregistrer un gain attendu
function SmartAntiCheat.ExpectGain(userId, points, source)
	local data = SmartAntiCheat.playerData[userId]
	if not data then
		SmartAntiCheat.InitPlayer(userId)
		data = SmartAntiCheat.playerData[userId]
	end

	if not data.validationWindow then
		data.validationWindow = {
			expectedGains = {},
			lastCleanup = os.time()
		}
	end

	table.insert(data.validationWindow.expectedGains, {
		timestamp = os.time(),
		points = points,
		source = source or "unknown"
	})

	print(string.format("🔔 Gain attendu: %d pts | Source: %s | UserID: %d", 
		points, source, userId))
end

function SmartAntiCheat.UpdatePlayerProfile(player)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local data = SmartAntiCheat.playerData[userId]
	if not data then return end

	local now = os.time()

	if now - data.profile.lastProfileUpdate < 120 then
		return
	end

	-- ✅ CORRECTION: Utilise le cache GamePass
	local multiplier = 1
	if gamePassCache[userId] and (now - gamePassCache[userId].lastCheck) < GAMEPASS_CACHE_DURATION then
		multiplier = gamePassCache[userId].multiplier
	end

	data.profile.gamepassMultiplier = multiplier
	data.profile.hasGamepass = multiplier > 1
	data.profile.hasPremium = player.MembershipType == Enum.MembershipType.Premium
	data.profile.inGroup = player:IsInGroup(GroupId)

	-- ✅ CORRECTION: Utilise directement le cache ami
	if not lastFriendCheck[userId] or (now - lastFriendCheck[userId]) >= FRIEND_CACHE_DURATION then
		-- Fallback sur l'attribut si le cache est vide
		friendCountCache[userId] = friendCountCache[userId] or player:GetAttribute("FriendCount") or 0
		lastFriendCheck[userId] = now
		print(string.format("🔄 UpdateProfile: Cache ami expiré pour %s, forcé à %d amis", 
			player.Name, 
			friendCountCache[userId] or 0))
	end

	data.profile.friendCount = friendCountCache[userId] or 0
	data.profile.lastProfileUpdate = now
end


function SmartAntiCheat.CalculateMaxGain(player, timeWindow)
	if not player or not player.Parent then return 0 end

	local userId = player.UserId
	local now = os.time()

	-- ✅ Cache 30s (au lieu de 20s)
	local cacheKey = userId .. "_" .. timeWindow
	local cached = SmartAntiCheat.calculationCache[cacheKey]
	local cacheExpiry = SmartAntiCheat.cacheExpiry[cacheKey]

	if cached and cacheExpiry and now < cacheExpiry then
		return cached
	end

	local data = SmartAntiCheat.playerData[userId]
	if not data then return 0 end

	-- ✅ Update profile seulement si nécessaire (200s au lieu de 120s)
	if not data.profile or (now - (data.profile.lastProfileUpdate or 0)) > 200 then
		SmartAntiCheat.UpdatePlayerProfile(player)
	end

	local profile = data.profile

	-- ✅ CORRECTION: Utilise directement le cache ami
	if not lastFriendCheck[userId] or (now - lastFriendCheck[userId]) >= FRIEND_CACHE_DURATION then
		local freshCount = friendCountCache[userId] or player:GetAttribute("FriendCount") or 0
		friendCountCache[userId] = freshCount
		lastFriendCheck[userId] = now
		profile.friendCount = freshCount
		profile.lastProfileUpdate = now
	end

	local maxGain = 0

	-- ✅ CORRECTION 1: basePerSec = 1 (au lieu de 3)
	local basePerSec = 1  -- ✅ CORRIGÉ
	local friendMult = 1   -- 🚫 amis : aucun boost
	local passiveGain = basePerSec * friendMult * timeWindow

	local totalMult = profile.gamepassMultiplier
	if profile.inGroup then totalMult = totalMult * 1.1 end
	if profile.hasPremium then totalMult = totalMult * 1.15 end

	-- ✨ Boosts temporaires (additif comme la boucle passive)
	local boostSum = (_G.TempBoosts and _G.TempBoosts.getMultiplier(userId)) or 0
	if boostSum > 0 then
		totalMult = (totalMult == 1 and 0 or totalMult) + boostSum
		if totalMult < 1 then totalMult = 1 end
	end

	maxGain = passiveGain * totalMult

	local maxPointLevels = math.ceil(timeWindow / 1800)
	local maxKills = math.ceil(timeWindow / 10)

	-- ✅ CORRECTION 2: Checkpoints/Kills NE SONT PAS multipliés par GamePass
	maxGain = maxGain + (maxPointLevels * 100) + (maxKills * 100)  -- ✅ CORRIGÉ

	-- ✅ BUFFER CONSERVÉ (non modifié comme demandé)
	maxGain = maxGain * 2
	maxGain = maxGain + 1000
	maxGain = math.floor(maxGain)

	-- ✅ Cache 30s (au lieu de 20s)
	SmartAntiCheat.calculationCache[cacheKey] = maxGain
	SmartAntiCheat.cacheExpiry[cacheKey] = now + 30

	return maxGain
end


function SmartAntiCheat.RecordGain(player, pointsGained, source)
	if not player or not player.Parent then return end
	if pointsGained <= 0 then return end

	local userId = player.UserId
	if isDeveloper(userId) then return end

	print(string.format("📝 RecordGain: %s | +%d | Source: %s", 
		player.Name, 
		pointsGained, 
		source or "unknown"
		))

	local data = SmartAntiCheat.playerData[userId]
	if not data then
		SmartAntiCheat.InitPlayer(userId)
		data = SmartAntiCheat.playerData[userId]
	end

	if not data.pointsHistory or type(data.pointsHistory) ~= "table" then
		data.pointsHistory = {}
	end

	local now = os.time()

	-- ✅ Insertion dans history
	table.insert(data.pointsHistory, {
		timestamp = now,
		points = pointsGained,
		source = source or "unknown",
	})

	if #data.pointsHistory > SmartAntiCheat.CONFIG.MAX_HISTORY_SIZE then
		table.remove(data.pointsHistory, 1)
	end

	-- ✅ NOUVEAU : Pas de whitelist, juste enregistrer
	-- L'analyse validera automatiquement via la fenêtre temporelle
end



function SmartAntiCheat.AnalyzeRecentHistory(userId, timeWindow)
	local data = SmartAntiCheat.playerData[userId]
	if not data then 
		return {total = 0, sources = {}, hasSuspicious = false, hasDevProduct = false, hasQuest = false, devProductPoints = 0, questPoints = 0}
	end

	if not data.pointsHistory or type(data.pointsHistory) ~= "table" then
		warn(string.format("⚠️ pointsHistory invalide dans AnalyzeRecentHistory pour %d", userId))
		data.pointsHistory = {}
		return {total = 0, sources = {}, hasSuspicious = false, hasDevProduct = false, hasQuest = false, devProductPoints = 0, questPoints = 0}
	end

	local now = os.time()
	local cutoff = now - timeWindow

	local result = {
		total = 0,
		sources = {},
		hasSuspicious = false,
		hasDevProduct = false,
		hasQuest = false,
		devProductPoints = 0,
		questPoints = 0,
	}

	-- ✅ OPTIMISATION RADICALE: Itération directe SANS copie
	local historySize = #data.pointsHistory
	local checkLimit = math.min(10, historySize) -- ✅ Limiter à 10 événements max

	for i = historySize, math.max(1, historySize - checkLimit + 1), -1 do
		local event = data.pointsHistory[i]

		if not event or type(event) ~= "table" then
			continue
		end

		if not event.timestamp or type(event.timestamp) ~= "number" then
			continue
		end

		if event.timestamp < cutoff then
			break -- ✅ CRITIQUE: Arrêter dès qu'on dépasse la fenêtre
		end

		local points = event.points or 0
		if type(points) == "number" and points > 0 then
			result.total = result.total + points
		end

		local source = event.source or "unknown"
		result.sources[source] = (result.sources[source] or 0) + 1

		if source:match("DevProduct") then
			result.hasDevProduct = true
			result.devProductPoints = result.devProductPoints + points
		end

		if source:match("Quest") or source:match("Rebirth") then
			result.hasQuest = true
			result.questPoints = result.questPoints + points
		end
	end

	return result
end



print("✅ ANTI-CHEAT INTELLIGENT - PARTIE 1/2 CHARGÉE")


-- 🛡️ QUELLE SANCTION ? (FIX FAUX-BAN sans ouvrir de trou pour les exploits)
--  • shadow (mode test du panel)       → rien, juste noté
--  • mode « privation d'UGC »          → PRIVATION D'UGC (avant : SmartAntiCheat bannissait en
--                                        ignorant le mode)
--  • mode « ban », joueur < 3 jours     → PRIVATION D'UGC au lieu du ban : un nouveau joueur a un
--    (ou ancienneté inconnue)            « maximum » minuscule, un gros gain légitime peut le dépasser.
--                                        La privation est réversible par un admin ET empêche quand
--                                        même un exploiteur d'encaisser des UGC.
--  • mode « ban », joueur ≥ 3 jours     → ban comme avant
--  Dans tous les cas : 2 analyses SÉPARÉES au-dessus du seuil (plus jamais une seule), et tous les
--  gains crédités par le serveur (RecordGain) sont déduits avant le calcul.
-- (tout est rangé dans SmartAntiCheat : ce script est à la limite Luau de 200 variables locales)
SmartAntiCheat.NEW_PLAYER_DAYS = 3
SmartAntiCheat.BAN_STRIKES     = 2
SmartAntiCheat.restrictAsked   = {}
pcall(function()
	SmartAntiCheat.firstJoinBridge = require(game:GetService("ServerScriptService"):WaitForChild("CapFirstJoinBridge", 5))
end)
-- renvoie "none" | "restrict" | "ban", raison
function SmartAntiCheat.SanctionAllowed(userId)
	local AC = _G.ACConfig
	if AC then
		local okP, punish = pcall(function() return AC.ShouldPunish == nil or AC.ShouldPunish() end)
		if okP and punish == false then return "none", "shadow" end
		local okM, mode = pcall(function() return AC.Mode and AC.Mode() end)
		if okM and mode ~= nil and mode ~= "ban" then return "restrict", "mode " .. tostring(mode) end
	end
	local fj = SmartAntiCheat.firstJoinBridge and SmartAntiCheat.firstJoinBridge.get(userId)
	if type(fj) ~= "number" or fj <= 0 then return "restrict", "ancienneté inconnue" end
	if os.time() - fj < SmartAntiCheat.NEW_PLAYER_DAYS * 86400 then return "restrict", "nouveau joueur" end
	return "ban"
end
function SmartAntiCheat.Restrict(player, details)
	local userId = player.UserId
	if SmartAntiCheat.restrictAsked[userId] then return end
	local UR = _G.UGCRestrict
	if not (UR and UR.Add) then return end
	SmartAntiCheat.restrictAsked[userId] = true   -- une seule demande par session (Add refuse les doublons)
	task.spawn(function()
		local ok, res, msg = pcall(UR.Add, userId, {
			by = "SmartAntiCheat", auto = true, reason = "anticheat_points",
			details = details, name = player.Name,
		})
		warn(string.format("🚫 SmartAntiCheat : privation d'UGC pour %s → %s %s",
			player.Name, tostring(ok and res), tostring(msg or "")))
	end)
end

function SmartAntiCheat.AnalyzePlayer(player)
	local success, err = pcall(function()
		if not player or not player.Parent then return end

		local userId = player.UserId
		if isDeveloper(userId) then return end

		-- ✅ NOUVEAU : Log de début d'analyse
		print(string.format("🔄 ANALYSE AUTO démarrée pour %s (UserID: %d)", 
			player.Name, userId))

		local data = SmartAntiCheat.playerData[userId]
		if not data then
			SmartAntiCheat.InitPlayer(userId)
			return
		end

		-- ✅ NOUVEAU: Vérifier que les données sont chargées
		if not data.dataLoaded then
			local maxWait = 100
			local waited = 0
			while not data.dataLoaded and waited < maxWait do
				task.wait(0.1)
				waited = waited + 1
			end

			if not data.dataLoaded then
				warn("⚠️ Données pas encore chargées pour " .. player.Name .. ", analyse reportée")
				return
			end
		end

		if not data.pointsHistory or type(data.pointsHistory) ~= "table" then
			data.pointsHistory = {}
			return
		end

		local now = os.time()

		if now - data.lastAnalysis < 45 then
			return
		end

		-- Période de grâce
		if data.inGracePeriod then
			if now - data.sessionStart >= SmartAntiCheat.CONFIG.GRACE_PERIOD then
				data.inGracePeriod = false
				print(string.format("⏰ Période de grâce terminée pour %s", player.Name))
			else
				return
			end
		end

		local leaderstats = player:FindFirstChild("leaderstats")
		if not leaderstats then return end

		local pointsStat = leaderstats:FindFirstChild("Points")
		if not pointsStat then return end

		local currentPoints = validatePoints(pointsStat.Value)
		local timeElapsed = now - data.lastCheckTime

		if timeElapsed < 40 then
			return
		end

		local pointsGained = currentPoints - data.lastKnownPoints

		-- ✅ CORRECTION CRITIQUE : Forcer mise à jour du profil si nécessaire
		local now = os.time()
		if not data.profile or not data.profile.gamepassMultiplier or data.profile.gamepassMultiplier == 1 then
			SmartAntiCheat.UpdatePlayerProfile(player)
		end

		-- ✅ NOUVEAU : Calculer les points passifs gagnés pendant cette période
		local profile = data.profile or {}
		local basePerSec = 1
		local friendMult = 1   -- 🚫 amis : aucun boost (aligné avec la boucle passive)

		-- ✅ CORRECTION : Récupérer le GamePass directement si le profil est vide
		local gamePassMult = profile.gamepassMultiplier or 1
		if gamePassMult == 1 then
			-- Fallback : récupérer du cache GamePass directement
			if gamePassCache[userId] and gamePassCache[userId].multiplier then
				gamePassMult = gamePassCache[userId].multiplier
				print(string.format("⚠️ GamePass récupéré du cache: x%d pour %s", gamePassMult, player.Name))
			else
				-- Forcer le recalcul
				gamePassMult = getHighestGamePassMultiplier(player)
				print(string.format("⚠️ GamePass recalculé: x%d pour %s", gamePassMult, player.Name))
			end

			-- Mettre à jour le profil pour la prochaine fois
			if profile then
				profile.gamepassMultiplier = gamePassMult
			end
		end

		-- ✅ Appliquer les bonus de groupe et premium
		local totalPassiveMult = gamePassMult
		if profile.inGroup or player:IsInGroup(GroupId) then 
			totalPassiveMult = totalPassiveMult * 1.1 
		end
		if profile.hasPremium or player.MembershipType == Enum.MembershipType.Premium then 
			totalPassiveMult = totalPassiveMult * 1.15 
		end

		-- ✨ Boosts temporaires (additif comme la boucle passive)
		local boostSum = (_G.TempBoosts and _G.TempBoosts.getMultiplier(userId)) or 0
		if boostSum > 0 then
			totalPassiveMult = (totalPassiveMult == 1 and 0 or totalPassiveMult) + boostSum
			if totalPassiveMult < 1 then totalPassiveMult = 1 end
		end

		local passiveGain = basePerSec * friendMult * totalPassiveMult * timeElapsed
		passiveGain = math.floor(passiveGain)

		-- ✅ Soustraire les points passifs du gain total
		local activeGain = pointsGained - passiveGain

		-- ✅ LOG: Début d'analyse avec détails passifs
		local analyseType = data.lastAnalysis == 0 and "PREMIÈRE" or "AUTO"
		print(string.format("🔍 ANALYSE %s: %s | Points: %d→%d (+%d) | Temps: %ds", 
			analyseType,
			player.Name, 
			data.lastKnownPoints, 
			currentPoints, 
			pointsGained,
			timeElapsed
			))
		print(string.format("   💤 Passif estimé: %d pts (%.2f/s × %ds) | GamePass: x%d", 
			passiveGain,
			basePerSec * friendMult * totalPassiveMult,
			timeElapsed,
			gamePassMult
			))
		print(string.format("   ⚡ Gain actif: %d pts (= %d total - %d passif)", 
			activeGain,
			pointsGained,
			passiveGain
			))

		-- ✅ NOUVEAU : Premier scan = calibration baseline TOUJOURS (peu importe le montant)
		-- Évite que le 2e scan voie un faux "gros gain" sur un nouveau joueur
		if not data.firstAnalysisDone then
			data.firstAnalysisDone = true
			data.lastKnownPoints = currentPoints
			data.lastCheckTime = now
			data.lastAnalysis = now
			print(string.format("ℹ️ Calibration baseline pour %s: %d pts (premier scan ignoré)", 
				player.Name, currentPoints))
			return
		end

		-- ✅ NOUVEAU : Grace period étendue — pas de ratio check pendant les 90 premières secondes
		-- Protège les nouveaux joueurs qui achètent un DevProduct ou claim une quête tôt
		local sessionAge = now - data.sessionStart
		if sessionAge < 90 then
			print(string.format("⏰ Session jeune (%ds), ratio check skip pour %s", 
				sessionAge, player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		-- Ancien fallback conservé pour les rares cas où firstAnalysisDone serait perdu
		if data.lastKnownPoints == 0 and currentPoints > 1000 then
			warn(string.format("ℹ️ Fallback premier scan pour %s: %d points", 
				player.Name, 
				currentPoints))

			data.lastKnownPoints = currentPoints
			data.lastCheckTime = now
			data.lastAnalysis = now
			return
		end

		if pointsGained < 0 then
			print(string.format("⬇️ Points négatifs pour %s (achat UGC?), ignoré", player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		if pointsGained < 30 then
			print(string.format("✅ Gain faible (%d pts) pour %s, ignoré", pointsGained, player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		-- ✅ CORRECTIF BOX : Soustraire les points légitimes de boxes du calcul
		local boxPoints = 0
		if data.pointsHistory then
			for _, event in ipairs(data.pointsHistory) do
				-- 🛡️ FIX FAUX-BAN : TOUS les gains crédités par le serveur (RecordGain : codes, quêtes,
				--    cadeaux, packs, boxes…) sont légitimes, pas seulement les boxes.
				-- ⚠️ JAMAIS les gains « PassiveSuspect » (passif anormal = possible exploit) ni
				--    d'origine inconnue : les déduire rendrait l'anti-cheat aveugle à ces gains.
				if (os.time() - (event.timestamp or 0)) <= timeElapsed
					and event.source ~= "PassiveSuspect" and event.source ~= "Passive"
					and event.source ~= "unknown" and event.source ~= nil then
					boxPoints = boxPoints + (event.points or 0)
				end
			end
		end
		if boxPoints > 0 then
			print(string.format("📦 Gains enregistrés soustraits du calcul: %d pts pour %s", boxPoints, player.Name))
			activeGain = math.max(0, activeGain - boxPoints)
			passiveGain = passiveGain  -- inchangé
		end

		-- ✅ NOUVEAU : Validation par fenêtre temporelle (sur le gain ACTIF)
		print(string.format("🔎 Vérification fenêtre pour %s | Gain actif: %d pts", player.Name, activeGain))

		local isValidated = SmartAntiCheat.ValidateGainInWindow(userId, activeGain)

		if isValidated then
			data.infractions.burstCount = 0
			data.infractions.suspiciousCount = math.max(0, data.infractions.suspiciousCount - 1)

			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now

			print(string.format("✅ VALIDÉ (fenêtre): %s | +%d pts | Infractions: %d", 
				player.Name, pointsGained, data.infractions.totalInfractions))

			-- ✅ NOUVEAU : Nettoyer les gains TRÈS anciens (>5 minutes) après validation réussie
			if data.validationWindow and data.validationWindow.expectedGains then
				local cutoff = now - 300 -- 5 minutes
				local newExpected = {}
				local cleaned = 0

				for _, gain in ipairs(data.validationWindow.expectedGains) do
					if gain.timestamp >= cutoff then
						table.insert(newExpected, gain)
					else
						cleaned = cleaned + 1
					end
				end

				if cleaned > 0 then
					data.validationWindow.expectedGains = newExpected
					print(string.format("🧹 Nettoyage post-validation: %d gains anciens supprimés", cleaned))
				end
			end

			return
		end

		-- ✅ LOG: Pas validé par fenêtre
		if activeGain < 500 and #SmartAntiCheat.playerData[userId].validationWindow.expectedGains == 0 then
			print(string.format("✅ Gain faible non-validé ignoré (%d pts, fenêtre vide) pour %s", activeGain, player.Name))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end
		print(string.format("⚠️ PAS VALIDÉ par fenêtre pour %s, calcul ratio...", player.Name))

		-- ✅ ANALYSE NORMALE (sur le gain ACTIF, sans les passifs)
		local maxGain = SmartAntiCheat.CalculateMaxGain(player, timeElapsed)

		-- ✅ IMPORTANT : Soustraire AUSSI les passifs du maxGain pour comparer correctement
		local maxActiveGain = maxGain - passiveGain

		local ratio = maxActiveGain > 0 and (activeGain / maxActiveGain) or 0

		-- ✅ LOG: Ratio calculé
		print(string.format("📊 RATIO: %s | +%d/%d (%.2fx) | Passif: %d pts", 
			player.Name, activeGain, maxActiveGain, ratio, passiveGain))

		if ratio > 1.2 then
			local friendCount = friendCountCache[userId] or 0
			local friendMult = 1 + (math.min(friendCount, 3) * 0.10)

			print(string.format(
				"📊 DÉTAILS: %s | +%d/%d (%.1fx) | %ds | Amis:%d (x%.1f)",
				player.Name,
				pointsGained,
				maxGain,
				ratio,
				timeElapsed,
				friendCount,
				friendMult
				))
		end

		local SUSPICIOUS = 1.5
		local DANGEROUS = 2.5
		local BAN = 5

		-- NIVEAU 1: SUSPECT
		if ratio >= SUSPICIOUS then
			data.infractions.suspiciousCount = data.infractions.suspiciousCount + 1
			data.infractions.burstCount = data.infractions.burstCount + 1
			data.infractions.totalInfractions = data.infractions.totalInfractions + 1
			data.infractions.lastInfractionTime = now

			warn(string.format(
				"⚠️ SUSPECT: %s | %d/%d (%.1fx) | Inf:%d/%d | Bursts:%d",
				player.Name,
				pointsGained,
				maxGain,
				ratio,
				data.infractions.totalInfractions,
				3,
				data.infractions.burstCount
				))
		end

		-- 🛡️ quelle sanction ? (mode du panel, ancienneté)
		local decision, why = SmartAntiCheat.SanctionAllowed(userId)
		if decision ~= "ban" and ratio >= DANGEROUS then
			if _G.UGCRestrict and _G.UGCRestrict.NoteDetection then
				pcall(_G.UGCRestrict.NoteDetection, userId)
			end
			if ratio >= BAN then
				data.infractions.banStrikes = (data.infractions.banStrikes or 0) + 1
				if decision == "restrict" and data.infractions.banStrikes >= SmartAntiCheat.BAN_STRIKES then
					SmartAntiCheat.Restrict(player, string.format("%d/%d (%.1fx) en %ds · %s",
						pointsGained, maxGain, ratio, timeElapsed, why or "?"))
				end
			end
			warn(string.format("🛡️ SmartAntiCheat : %s pour %s (%s) | %.1fx | %d/%d",
				decision, player.Name, why or "?", ratio,
				data.infractions.banStrikes or 0, SmartAntiCheat.BAN_STRIKES))
			data.lastCheckTime = now
			data.lastKnownPoints = currentPoints
			data.lastAnalysis = now
			return
		end

		-- NIVEAU 2: DANGEREUX (kick après 2 bursts)
		if ratio >= DANGEROUS and data.infractions.burstCount > 1 and ratio < BAN then
			SmartAntiCheat.globalStats.totalKicks = SmartAntiCheat.globalStats.totalKicks + 1

			warn(string.format(
				"🚨 KICK: %s | Ratio: %.1fx | Bursts: %d",
				player.Name, ratio, data.infractions.burstCount
				))

			if player.Parent then
				player:Kick(string.format(
					"⚠️ WARNING\n\n" ..
						"Active gain: %d pts (total: %d - passive: %d)\n" ..
						"Max allowed: %d pts in %ds\n" ..
						"Ratio: %.1fx\n\n" ..
						"Reconnect if legitimate.\n" ..
						"Repeated infractions = BAN.",
					activeGain,
					pointsGained,
					passiveGain,
					maxActiveGain,
					timeElapsed,
					ratio
					))
			end

			return
		end

		-- NIVEAU 3: BAN — seulement après SMART_BAN_STRIKES analyses séparées au-dessus du seuil
		if ratio >= BAN then
			data.infractions.banStrikes = (data.infractions.banStrikes or 0) + 1
			if data.infractions.banStrikes < SmartAntiCheat.BAN_STRIKES then
				warn(string.format("⚠️ %s : %.1fx (%d/%d avant ban) — on attend une 2e analyse",
					player.Name, ratio, data.infractions.banStrikes, SmartAntiCheat.BAN_STRIKES))
				data.lastCheckTime = now
				data.lastKnownPoints = currentPoints
				data.lastAnalysis = now
				return
			end
		end
		if ratio >= BAN then
			SmartAntiCheat.globalStats.totalBans = SmartAntiCheat.globalStats.totalBans + 1

			AntiExploit.bannedPlayers[userId] = true

			if _G.BanManager then
				pcall(function()
					_G.BanManager.Log({
						userId = userId, reason = "anticheat",
						details = string.format("%d/%d (%.1fx) en %ds",
							pointsGained, maxGain, ratio, timeElapsed),
						action = "ban", name = player.Name, by = "SmartAntiCheat",
					})
				end)
			end

			warn(string.format(
				"🚫 BAN PERMANENT: %s | Ratio: %.1fx | Total infractions: %d",
				player.Name, ratio, data.infractions.totalInfractions
				))

			task.spawn(function()
				-- Ligne ~ligne 130 de ton script
				local banStore = DataStoreService:GetDataStore("BannedPlayers")
				pcall(function()
					banStore:SetAsync(tostring(userId), {
						reason = "SMART_ANTICHEAT",
						details = string.format("%d/%d (%.1fx)", pointsGained, maxGain, ratio),
						timestamp = os.time(),
						playerName = player.Name,
					})
				end)
			end)

			if player.Parent then
				player:Kick(string.format(
					"🚫 PERMANENT BAN\n\n" ..
						"Exploitation detected.\n" ..
						"Gain: %d/%d (%.1fx)\n" ..
						"UserID: %d",
					pointsGained,
					maxGain,
					ratio,
					userId
					))
			end

			return
		end

		-- Réduction progressive
		if ratio < SUSPICIOUS then
			data.infractions.banStrikes = 0
			data.infractions.burstCount = math.max(0, data.infractions.burstCount - 1)
			if data.infractions.suspiciousCount > 0 then
				data.infractions.suspiciousCount = data.infractions.suspiciousCount - 1
			end

			print(string.format("✅ Ratio OK (%.2fx) pour %s, réduction infractions", ratio, player.Name))
		end

		data.lastCheckTime = now
		data.lastKnownPoints = currentPoints
		data.lastAnalysis = now

		SmartAntiCheat.globalStats.totalAnalyses = SmartAntiCheat.globalStats.totalAnalyses + 1
	end)

	if not success then
		warn("❌ Erreur AnalyzePlayer:", tostring(err))
		if player and player.Parent then
			local data = SmartAntiCheat.playerData[player.UserId]
			if data then data.pointsHistory = {} end
		end
	end
end


task.spawn(function()
	print("🔄 Boucle d'analyse anti-cheat démarrée (intervalle: 45s)")

	local cycleCount = 0
	while true do
		task.wait(45)

		cycleCount = cycleCount + 1
		local allPlayers = Players:GetPlayers()
		local playerCount = #allPlayers

		if playerCount == 0 then
			continue
		end

		print(string.format("📊 Cycle #%d | %d joueur(s) en ligne | Analyse en cours...", 
			cycleCount, playerCount))

		-- ✅ CORRECTION : Analyser TOUS les joueurs, pas juste 1 sur 3
		for i = 1, playerCount do
			local player = allPlayers[i]
			if player and player.Parent then
				task.spawn(function()
					local success, err = pcall(function()
						SmartAntiCheat.AnalyzePlayer(player)
					end)
					if not success then
						warn("❌ Erreur analyse anti-cheat:", err)
					end
				end)
			end

			-- ✅ Délai entre chaque joueur (0.5s au lieu de 2s)
			if i < playerCount then
				task.wait(0.5)
			end
		end
	end
end)

