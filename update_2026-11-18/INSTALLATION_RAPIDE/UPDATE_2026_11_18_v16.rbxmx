give10KRebirthEvent.OnServerEvent:Connect(function(player)
	local userId = player.UserId
	-- Attendre que rebirthCount soit chargé (évite un faux positif pendant le load)
	local waited = 0
	while playerRebirthCount[userId] == nil and waited < 50 do
		task.wait(0.1)
		waited = waited + 1
	end
	local rebirthCount = playerRebirthCount[userId] or 0
	if rebirthCount == 0 then
		-- ✅ FIX FAUX-BAN : refus silencieux (le return bloque déjà la récompense).
		warn(string.format("ℹ️ %s tente Quest10KRebirth sans rebirth — refusé (aucune sanction)", player.Name))
		pcall(function() waitTmrEvent:FireClient(player) end)
		return
	end
	giveQuestReward(player, "Quest10KRebirth", 20000, function()
		if _G.RebirthQuestState then
			local loaded, blocked = _G.RebirthQuestState(userId)
			if not loaded then
				warn(string.format("⏸️ %s : état quête rebirth incertain (DataStore), récompense reportée", player.Name))
				pcall(function() waitTmrEvent:FireClient(player) end)
				return false
			end
			if blocked then
				warn(string.format("🚫 %s : quête rebirth déjà réclamée, récompense refusée", player.Name))
				return false
			end
		end
		return true
	end)
end)

