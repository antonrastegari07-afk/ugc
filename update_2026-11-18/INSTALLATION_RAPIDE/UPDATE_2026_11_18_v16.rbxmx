	-- Tu peux ajouter d'autres UserIDs ici
}

-- Fonction pour vérifier si un joueur est développeur
local function isDeveloper(userId)
	if not DEV_MODE then return false end
	for _, devId in ipairs(DEV_USER_IDS) do
		if devId == userId then
			return true
		end
	end
	return false
end


-- ========================================
