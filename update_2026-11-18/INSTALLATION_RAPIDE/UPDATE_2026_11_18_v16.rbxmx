local function saveCheckpointQuestData(userId, immediate)
	-- ✅ FIX ANTI-WIPE : ne JAMAIS écrire si la protection n'est pas chargée
	-- (sinon on persiste earnedPointLevels = {} et le joueur peut tout re-farmer)
	if playerEarnedPointLevels[userId] == nil or playerCheckpoints[userId] == nil then
		warn(string.format("🛡️ saveCheckpointQuestData bloqué pour %d : données pas chargées", userId))
		return false
	end
	local key = "CheckpointQuest_" .. userId
	local data = {
		checkpoints       = playerCheckpoints[userId] or 0,
		cooldownEnd       = checkpointQuestCooldowns[userId] or 0,
		touchedUIDs       = playerTouchedCheckpoints[userId] or {},
		earnedPointLevels = playerEarnedPointLevels[userId] or {}
	}

	if immediate then
		local ok, err = pcall(function()
			checkpointQuestStore:SetAsync(key, data)
		end)
		if not ok then
			warn(string.format("❌ saveCheckpointQuestData échoué: %s", tostring(err)))
		end
		return ok
	else
		task.spawn(function()
			pcall(function()
				checkpointQuestStore:SetAsync(key, data)
			end)
		end)
	end
end

local function markCheckpointDirty(userId)
	dirtyCheckpointData[userId] = true
end

local function loadCheckpointQuestData(userId)
	-- ✅ Si reload prévu, attendre que le snapshot soit restauré depuis le SessionLock
	if recentReloads[userId] then
		local waited = 0
		while playerCheckpoints[userId] == nil and waited < 100 do
			task.wait(0.1)
			waited = waited + 1
		end
	end

	if playerCheckpoints[userId] ~= nil then
		-- 🛡️ FIX FARM : cas suspect = l'unifié dit "réclamable" (checkpoints>=requis ET cooldown=0).
		-- Ça peut être un unifié périmé (save du claim échoué). On croise avec le store dédié
		-- (écrit immédiatement à chaque claim) qui aurait le cooldown 24h → bloque le re-farm.
		-- Lecture UNIQUEMENT dans cet état précis → aucun read supplémentaire au join normal.
		if not recentReloads[userId]
			and (checkpointQuestCooldowns[userId] or 0) == 0
			and (playerCheckpoints[userId] or 0) >= CHECKPOINT_QUEST_REQUIRED then
			local okX, dataX = pcall(function()
				return checkpointQuestStore:GetAsync("CheckpointQuest_" .. userId)
			end)
			if okX and type(dataX) == "table" and (tonumber(dataX.cooldownEnd) or 0) > os.time() then
				checkpointQuestCooldowns[userId] = tonumber(dataX.cooldownEnd) or 0
				playerCheckpoints[userId]        = tonumber(dataX.checkpoints) or 0
				playerTouchedCheckpoints[userId] = (type(dataX.touchedUIDs) == "table") and dataX.touchedUIDs or {}
				warn(string.format("🛡️ CheckpointQuest: unifié périmé détecté pour %d, cooldown restauré depuis le store dédié (anti-farm)", userId))
			end
		end
		print(string.format("ℹ️ Checkpoint quest déjà restaurée pour %d (%d checkpoints), skip",
			userId, playerCheckpoints[userId]))
		return
	end

	-- ✅ FIX SUPPLÉMENTAIRE : Si recentReloads est actif mais playerCheckpoints est encore nil
	-- après l'attente, lire directement le SessionLock AVANT le DataStore
	if recentReloads[userId] then
		warn(string.format("⚠️ loadCheckpointQuestData: SessionLock pas encore lu pour %d, lecture directe", userId))
		local lockData = readSessionLock(userId)
		if lockData and lockData.questSnapshot then
			local snap = lockData.questSnapshot
			playerCheckpoints[userId]        = snap.checkpoints or 0
			checkpointQuestCooldowns[userId] = snap.cooldownEnd or 0
			playerTouchedCheckpoints[userId] = snap.touchedUIDs or {}
			playerEarnedPointLevels[userId]  = snap.earnedPointLevels or {}  -- ✅ FIX ANTI-WIPE
			print(string.format("✅ Checkpoints restaurés depuis SessionLock direct: %d checkpoints", 
				snap.checkpoints or 0))
			return
		end
	end

	local key = "CheckpointQuest_" .. userId
	local success, data = pcall(function()
		return checkpointQuestStore:GetAsync(key)
	end)

	print(string.format("🔍 LOAD CheckpointQuest: success=%s, data=%s",
		tostring(success),
		data and ("checkpoints=" .. tostring(data.checkpoints) ..
			" cooldown=" .. tostring(data.cooldownEnd)) or "NIL"
		))

	-- ✅ FIX MIGRATION : Retry 3x au lieu de 1
	if not success then
		for attempt = 2, 3 do
			task.wait(0.6 * attempt)
			success, data = pcall(function()
				return checkpointQuestStore:GetAsync(key)
			end)
			if success then break end
			warn(string.format("⚠️ loadCheckpointQuestData tentative %d/3 échouée pour %d", attempt, userId))
		end
	end

	if success and data then
		playerCheckpoints[userId]        = data.checkpoints or 0
		checkpointQuestCooldowns[userId] = data.cooldownEnd or 0
		playerTouchedCheckpoints[userId] = data.touchedUIDs or {}
		playerEarnedPointLevels[userId]  = data.earnedPointLevels or {}
	elseif success and data == nil then
		-- Vrai nouveau joueur, init propre
		playerCheckpoints[userId]        = 0
		checkpointQuestCooldowns[userId] = 0
		playerTouchedCheckpoints[userId] = {}
		playerEarnedPointLevels[userId]  = {}
	else
		-- ❌ DataStore down : NE PAS setter à 0 (sinon écrase en unified)
		-- Laisser nil → isAllSecondaryLoaded bloquera secureSave
		warn(string.format("🚨 CRITIQUE: loadCheckpointQuestData failed après 3 retries pour %d — valeurs laissées nil (saves bloqués)", userId))
		return
	end

	-- FIX : condition corrigée (playerCheckpoints vaut déjà 0 après claim, l'ancienne condition ne déclenchait jamais)
	local now = os.time()
	local cdEnd = checkpointQuestCooldowns[userId] or 0
	if cdEnd > 0 and now >= cdEnd then
		print(string.format("🔄 CheckpointQuest: cooldown expiré hors session, reset quête pour UserID %d", userId))
		playerCheckpoints[userId]        = 0
		checkpointQuestCooldowns[userId] = 0
		playerTouchedCheckpoints[userId] = {}
		-- NE PAS effacer playerEarnedPointLevels : pas de rebirth = pas de reset PointLevel
		saveCheckpointQuestData(userId, true)
	end
end



-- ========================================
-- Rate limit pour notifyReloadEvent (anti-spam)
-- ========================================
_G.lastNotifyReload = _G.lastNotifyReload or {}

-- 💤 TÉLÉPORTATION DU RECHARGEMENT AFK, faite par le SERVEUR (plusieurs essais).
--    Si tout échoue, ses données sont déjà sauvegardées → on le déconnecte proprement.
--    (fonction dans _G : ce script a déjà ~200 variables locales, la limite de Luau)
_G.TeleportForAfkReload = function(player)
	local opts = Instance.new("TeleportOptions")
	if _G.SessionToolCarrySave then pcall(_G.SessionToolCarrySave, player) end
	for attempt = 1, 5 do
		if not player.Parent then return end
		local ok, err = pcall(function()
			game:GetService("TeleportService"):TeleportAsync(game.PlaceId, { player }, opts)
		end)
		if ok then
			local t0 = os.clock()
			while player.Parent and os.clock() - t0 < 20 do task.wait(0.5) end
			if not player.Parent then return end
			warn(string.format("⚠️ Reload AFK : %s toujours là après la téléportation (essai %d)", player.Name, attempt))
		else
			warn(string.format("⚠️ Reload AFK : téléportation de %s échouée (essai %d) : %s", player.Name, attempt, tostring(err)))
		end
		task.wait(2 * attempt)
	end
	if player.Parent then
		player:Kick("We saved your progress. Please rejoin to keep playing!")
	end
end

notifyReloadEvent.OnServerEvent:Connect(function(player, reason)
	local userId = player.UserId
	local now = os.time()

	-- 🧪 Studio : la téléportation n'existe pas → on ne vide jamais la mémoire pour rien
	if RunService:IsStudio() then
		pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
		return
	end

	-- 🔒 Bloquer reload si achat UGC en cours (anti-exploit timing)
	for key, pending in pairs(pendingUGCPurchases) do
		if key:sub(1, #tostring(userId) + 1) == (userId .. "_") then
			if (now - pending.timestamp) < 300 then
				warn(string.format("🚫 Reload refusé pour %s : achat UGC en cours (%s)",
					player.Name, pending.name))
				pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
				return
			end
		end
	end
	-- 🔐 Et refuser tant qu'une créance UGC est ouverte en DataStore
	if _G.UGCEscrow and _G.UGCEscrow.HasOpen(userId) then
		warn(string.format("🚫 Reload refusé pour %s : créance UGC ouverte", player.Name))
		pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
		return
	end

	-- ✅ Rate limit : max 1 reload / 60s par joueur
	local lastCall = _G.lastNotifyReload[userId]
	if lastCall and (now - lastCall) < 60 then
		warn(string.format("🚫 notifyReload spam bloqué pour %s (%.1fs depuis dernier appel)",
			player.Name, now - lastCall))
		pcall(function() reloadConfirmedEvent:FireClient(player, false) end)

		-- Si abus répété (>3 tentatives en <60s), tracker comme suspect
		local abuseKey = "abuse_" .. userId
		_G.lastNotifyReload[abuseKey] = (_G.lastNotifyReload[abuseKey] or 0) + 1
		if _G.lastNotifyReload[abuseKey] >= 3 then
			AntiExploit.HandleSuspiciousActivity(player, "RELOAD_SPAM",
				string.format("notifyReloadEvent spammé %d fois en <60s", _G.lastNotifyReload[abuseKey]))
			_G.lastNotifyReload[abuseKey] = 0
		end
		return
	end

	-- Reset le compteur d'abus si dernier appel > 60s
	_G.lastNotifyReload["abuse_" .. userId] = 0
	_G.lastNotifyReload[userId] = now

	print(string.format("🔔 RELOAD DEMANDÉ par %s (raison: %s)", player.Name, reason or "unknown"))



	-- FIX : bloquer si les données ne sont pas encore chargées (évite snapshot vide)
	if dataLoading[userId] then
		warn(string.format("🚫 notifyReload bloqué pour %s (chargement en cours)", player.Name))
		pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
		return
	end
	if playerEarnedPointLevels[userId] == nil then
		warn(string.format("🚫 notifyReload bloqué pour %s (earnedPointLevels pas chargé)", player.Name))
		pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
		return
	end
	-- 🛡️ FIX PERTE DE DONNÉES : bloquer le reload tant que TOUS les loaders secondaires
	-- ne sont pas finis. Sinon le snapshot capture des défauts (allowedRebirth=false,
	-- killCount=0, checkpoints=0, rebirthCount=0…) qui ÉCRASENT les vraies données au rejoin.
	if not isAllSecondaryLoaded(userId) then
		warn(string.format("🚫 notifyReload bloqué pour %s (loaders secondaires pas finis)", player.Name))
		pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
		return
	end

	-- ═══════════════════════════════════
	-- ÉTAPE 1 : SAUVEGARDER LES POINTS
	-- ═══════════════════════════════════
	local data = tempsJoueurs[userId]
	local totalPoints = 0

	if data and type(data) == "table" then
		totalPoints = data.base + data.future
		-- ✅ FIX : Limite alignée avec validatePoints + BindToClose (1T)
		if totalPoints < 0 or totalPoints > 1000000000000 then
			warn(string.format("⚠️ Points invalides: %d pour %s", totalPoints, player.Name))
			pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
			return
		end
	end

	-- ✨ Bloquer toute opération sensible MAINTENANT : toutes les vérifications ci-dessus
	--    sont passées. (Avant, un refus laissait ce blocage pour toujours → plus de sauvegarde.)
	recentReloads[userId] = now

	-- Attendre que pendingSaves soit libre
	local waited = 0
	while pendingSaves[userId] and waited < 30 do
		task.wait(0.1)
		waited = waited + 1
	end
	pendingSaves[userId] = nil

	-- ✅ OPTIMISATION : écriture legacy tempsStore SUPPRIMÉE. Post-migration ce store
	-- n'est plus JAMAIS relu au reload (SessionLock + unified couvrent tout).
	-- La persistance = save unifié (étape 2.5) + SessionLock (étape 4).
	-- Le garde-fou "aucun filet" est déplacé à l'étape 2.5 ci-dessous.
	if data then data.lastSaved = totalPoints end

	-- ═══════════════════════════════════
	-- ÉTAPE 1.5 : SNAPSHOT + SAUVEGARDE SYNCHRONE DES WARNINGS
	-- (avant tout le reste, pendant que les données sont encore en mémoire)
	-- ═══════════════════════════════════
	local warningSnapshot = {
		infractions = AntiExploit.infractions[userId] or 0,
		lastInfraction = os.time(),
		history = {},
		lastViolationType = nil,
		lastViolationDetails = nil,
	}

	if AntiExploit.questHistory[userId] then
		for questName, timestamp in pairs(AntiExploit.questHistory[userId]) do
			table.insert(warningSnapshot.history, {
				type = "QUEST_COOLDOWN_BYPASS",
				quest = questName,
				timestamp = timestamp
			})
		end
	end

	local smartDataSnap = SmartAntiCheat.playerData[userId]
	if smartDataSnap and smartDataSnap.infractions then
		warningSnapshot.smartAntiCheat = {
			suspiciousCount = smartDataSnap.infractions.suspiciousCount or 0,
			dangerousCount = smartDataSnap.infractions.dangerousCount or 0,
			totalInfractions = smartDataSnap.infractions.totalInfractions or 0,
			burstCount = smartDataSnap.infractions.burstCount or 0,
			lastInfractionTime = smartDataSnap.infractions.lastInfractionTime or 0,
		}
	end

	if AntiExploit.playerTracking[userId] then
		warningSnapshot.lastViolationType = AntiExploit.playerTracking[userId].lastViolationType
		warningSnapshot.lastViolationDetails = AntiExploit.playerTracking[userId].lastViolationDetails
	end

	local warnOk, warnErr = pcall(function()
		warningsStore:SetAsync("warnings_" .. userId, warningSnapshot)
	end)
	if warnOk then
		print(string.format("✅ Warnings sauvegardés (snapshot) avant reload: %d AE | %d SAC",
			warningSnapshot.infractions,
			warningSnapshot.smartAntiCheat and warningSnapshot.smartAntiCheat.totalInfractions or 0))
		if warningSnapshot.infractions > 0 or
			(warningSnapshot.smartAntiCheat and warningSnapshot.smartAntiCheat.totalInfractions > 0) then
			-- Protection : addToWarningsRegistry peut ne pas encore exister
			if type(addToWarningsRegistry) == "function" then
				addToWarningsRegistry(userId)
			end
		end
	else
		warn(string.format("❌ Erreur snapshot warnings: %s", tostring(warnErr)))
	end

	-- ═══════════════════════════════════
	-- ÉTAPE 2 : SAUVEGARDES SECONDAIRES EN PARALLÈLE
	-- ═══════════════════════════════════
	local pending = 0

	local function runSave(fn)
		pending = pending + 1
		task.spawn(function()
			pcall(fn)
			pending = pending - 1
		end)
	end

	-- ✅ SUPPRIMÉ : Écritures backup (saturent inutilement le DataStore)
	-- Le SessionLock posé plus bas sert de filet de sécurité fiable

	-- Checkpoints quest (synchrone AVANT cleanup)
	local cpSaved = false
	for attempt = 1, 3 do
		if saveCheckpointQuestData(userId, true) then
			cpSaved = true
			print(string.format("✅ Checkpoint quest sauvegardé (tentative %d)", attempt))
			break
		end
		warn(string.format("⚠️ Tentative %d échouée, retry...", attempt))
		task.wait(0.5)
	end

	-- ✅ OPTIMISATION : Écritures legacy retirées (kills, questCooldowns, warnings, rebirth count/rights)
	-- Raison : au reconnect d'un reload, isPlannedReload=true → lecture directe du SessionLock.
	-- Tous les loaders legacy sont skippés (valeurs déjà dans le snapshot). Ces stores ne sont
	-- donc JAMAIS relus pendant un reload. Le SessionLock (étape 4) + l'écriture unified (étape 2.5)
	-- contiennent déjà TOUTES ces données. On économise 5 écritures DataStore par reload.
	-- Les warnings sont déjà sauvegardés en synchrone à l'étape 1.5 ci-dessus.

	-- Attendre max 5s que tout soit fini
	waited = 0
	while pending > 0 and waited < 50 do
		task.wait(0.1)
		waited = waited + 1
	end

	if pending > 0 then
		warn(string.format("⚠️ %d sauvegarde(s) pas encore terminée(s) pour %s, on continue quand même", 
			pending, player.Name))
	else
		print(string.format("✅ Toutes sauvegardes terminées pour %s", player.Name))
	end

	local questSnapshot = {
		checkpoints       = playerCheckpoints[userId] or 0,
		cooldownEnd       = checkpointQuestCooldowns[userId] or 0,
		touchedUIDs       = playerTouchedCheckpoints[userId] or {},
		earnedPointLevels = playerEarnedPointLevels[userId] or {},
		killCount         = playerKillCount[userId] or 0,
		killCooldown = playerKillCooldown[userId] or 0,
		killQuestCooldowns = killQuestCooldowns[userId] or 0,
		killQuestProgress = killQuestProgress[userId] or 0,
		-- ✅ FIX ANTI-RE-REDEEM : critique pour empêcher re-claim après reload
		redeemedCodes = playerRedeemedCodes[userId] or {},
		-- ⚙️ Paramètres joueur
		settings = Settings.data[userId] or Settings.default(),
		-- ⏱️ Playtime lifetime
		playtimeSeconds = getCurrentPlaytime(userId),
		-- ✅ FIX FIABILITÉ : restaurer aussi rebirths, allowedRebirth, et cooldowns quêtes au reload
		rebirthCount = playerRebirthCount[userId] or 0,
		allowedRebirth = allowedRebirth[userId] == true,
		questHistory = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},
		-- ✅ WARNINGS SNAPSHOT
		antiExploitInfractions = AntiExploit.infractions[userId] or 0,
		smartAntiCheatInfractions = (SmartAntiCheat.playerData[userId] and SmartAntiCheat.playerData[userId].infractions) and {
			suspiciousCount   = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
			dangerousCount    = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
			totalInfractions  = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
			burstCount        = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
			lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
		} or nil,
	}
	print(string.format("📸 Quest snapshot: %d checkpoints | %d/%d kills",
		questSnapshot.checkpoints, questSnapshot.killCount, MAX_KILLS))

	if type(_G.enrichQuestSnapshotWithP2) == "function" then
		questSnapshot = _G.enrichQuestSnapshotWithP2(userId, questSnapshot)
	end
	-- ✨ Boosts temporaires
	if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
		questSnapshot = _G.enrichQuestSnapshotWithBoosts(userId, questSnapshot)
	end

	-- ═══════════════════════════════════
	-- ÉTAPE 2.5 : ✅ FIX 11 — ÉCRIRE À UNIFIED POUR LE GARDER EN SYNC
	-- Sans ça, notifyReload n'écrit que legacy + SessionLock.
	-- Si le téléport prend >30s, SessionLock shortcut ne fire plus → secureLoad
	-- lit unified STALE → joueur perd la progression de la session.
	-- skipReloadCheck=true bypasse le check recentReloads (qu'on a posé nous-mêmes).
	-- ═══════════════════════════════════
	local unifiedSaveOk = secureSave(userId, totalPoints, 0, true)
	if unifiedSaveOk then
		print(string.format("✅ Save unifié pendant reload OK pour %s (%d pts)", player.Name, totalPoints))
	else
		warn(string.format("⚠️ Save unifié pendant reload échoué pour %s — test du SessionLock", player.Name))
		-- 🛡️ Save unifié KO → tester le SessionLock MAINTENANT (AVANT le cleanup mémoire).
		-- Si lui aussi est KO, il n'y a AUCUN filet → refuser le reload (la session continue).
		if not acquireSessionLock(userId, totalPoints, questSnapshot) then
			warn(string.format("🚫 Reload REFUSÉ pour %s : unified + SessionLock inaccessibles (DataStore down)", player.Name))
			recentReloads[userId] = nil
			pcall(function() reloadConfirmedEvent:FireClient(player, false) end)
			return
		end
		-- Lock posé avec succès : on continue le reload normalement
	end

	-- ═══════════════════════════════════
	-- ÉTAPE 3 : CLEANUP COMPLET DE LA MÉMOIRE
	-- ═══════════════════════════════════
	playerCurrentCheckpoint[userId] = nil
	friendCountCache[userId] = nil
	lastFriendCheck[userId] = nil
	friendsCache[userId] = nil
	tempsJoueurs[userId] = nil
	tempsJoueurs[userId .. "_pause"] = nil
	playerKillCount[userId] = nil
	playerKillCooldown[userId] = nil
	killQuestCooldowns[userId] = nil
	killQuestProgress[userId] = nil
	flushTotalKills(userId)
	totalKillsDirty[userId] = nil
	playerTotalKills[userId] = nil
	playerRebirthCount[userId] = nil
	allowedRebirth[userId] = nil
	playerCheckpoints[userId] = nil
	checkpointQuestCooldowns[userId] = nil
	playerTouchedCheckpoints[userId] = nil
	playerEarnedPointLevels[userId] = nil
	playerRedeemedCodes[userId] = nil
	Settings.data[userId] = nil
	Settings.rate[userId] = nil
	gamePassCache[userId] = nil
	_G.ACOptim.status[userId] = nil
	_G.ACOptim.attrAt[userId] = nil
	uiUpdateQueue[userId] = nil
	lastUIUpdate[userId] = nil
	pointLevelGlobalDebounce[userId] = nil
	AntiExploit.playerTracking[userId] = nil
	AntiExploit.infractions[userId] = nil
	AntiExploit.questHistory[userId] = nil
	SmartAntiCheat.playerData[userId] = nil
	questCooldownsLoaded[userId] = nil
	pendingSaves[userId] = nil
	plannedReloads[userId] = nil
	activeConnections[userId] = nil
	disconnectProtection[userId] = nil
	rebirthTriggerCooldown[userId] = nil
	playerPlaytime[userId] = nil
	playerSessionStart[userId] = nil

	local userIdStr = tostring(userId)
	for key in pairs(lastPointLevelTouch) do
		if type(key) == "string" and key:match("^" .. userIdStr .. "_") then
			lastPointLevelTouch[key] = nil
		end
	end
	for key in pairs(checkpointTouchCooldown) do
		if type(key) == "string" and key:match("^" .. userIdStr .. "_") then
			checkpointTouchCooldown[key] = nil
		end
	end
	for key in pairs(checkpointRecountTimers) do
		if type(key) == "string" and key:match("^" .. userIdStr .. "_") then
			checkpointRecountTimers[key] = nil
		end
	end
	for _, friendList in pairs(friendsCache) do
		if type(friendList) == "table" and friendList[userId] then
			friendList[userId] = nil
		end
	end

	print(string.format("🧹 Cleanup mémoire complet pour %s", player.Name))

	-- ═══════════════════════════════════
	-- ÉTAPE 4 : POSER LE SESSION LOCK + MARQUER RELOAD
	-- ═══════════════════════════════════
	acquireSessionLock(userId, totalPoints, questSnapshot)
	recentReloads[userId] = now

	-- ✅ FIX : Notifier LossGuard pour qu'il ignore les saves pendant ce reload
	if LossGuard.markReloading then
		LossGuard.markReloading(userId)
	end

	print(string.format("🔒 SessionLock posé (%d pts) + recentReloads marqué pour %s", 
		totalPoints, player.Name))

	-- ═══════════════════════════════════
	-- ÉTAPE 5 : CONFIRMER AU CLIENT → IL PEUT TÉLÉPORTER
	-- ═══════════════════════════════════
	-- 💤 Position exacte pour le retour (fallback = checkpoint)
	if _G.SaveReloadPosition then
		pcall(_G.SaveReloadPosition, player)
	end

	pcall(function()
		reloadConfirmedEvent:FireClient(player, true)
	end)

	print(string.format("✅ ACK envoyé à %s → téléportation par le serveur", player.Name))
	task.spawn(_G.TeleportForAfkReload, player)

	-- Nettoyage recentReloads après 60s (sécurité)
	task.delay(120, function()
		if recentReloads[userId] == now then
			recentReloads[userId] = nil
		end
	end)
end)
-- ========================================
-- GAMEPASS CONFIGURATION
-- ========================================
local testPasses = {
	[1891007119] = false,
}

local gamePassMultipliers = {
	[1891007119] = 2,
	[1891589121] = 2,
	[1893682680] = 5,
	[1891475116] = 10
}

local EXCLUDED_PASSES = {
	[1893682680] = true,
	[1891475116] = true,
}

-- ========================================
-- DATASTORE QUEUE OPTIMISÉE
-- ========================================
local datastoreQueue = {}
local isProcessingQueue = false
local MAX_QUEUE_SIZE = 100

local function queueDatastoreOperation(operation)
	if #datastoreQueue >= MAX_QUEUE_SIZE then
		warn("⚠️ Queue DataStore pleine, opération ignorée")
		return
	end

	table.insert(datastoreQueue, operation)

	if not isProcessingQueue then
		isProcessingQueue = true
		task.spawn(function()
			while #datastoreQueue > 0 do
				local op = table.remove(datastoreQueue, 1)

				if op and type(op) == "function" then
					local success, err = pcall(op)
					if not success then
						warn("❌ Erreur DataStore Queue:", err)
					end
				end

				task.wait(DATASTORE_QUEUE_DELAY)
			end
			isProcessingQueue = false
		end)
	end
end

-- ========================================
-- FONCTIONS DE SÉCURITÉ DATASTORE
-- ========================================
function secureSave(userId, data, retryCount, skipReloadCheck)
	retryCount = retryCount or 0

	local playerData = tempsJoueurs[userId]
	if type(playerData) == "table" and playerData.loading then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	-- ✅ FIX 11 : skipReloadCheck=true permet à notifyReloadEvent d'écrire à unified
	-- pendant un reload (sinon le check recentReloads bloquerait l'écriture
	-- et unified resterait stale, causant perte de données si reload >30s)
	if not skipReloadCheck and recentReloads[userId] then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	if dataLoading[userId] then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	local protection = disconnectProtection[userId]
	if protection and os.time() < protection.blockUntil then
		local currentSession = activeConnections[userId]
		if currentSession and currentSession.player and currentSession.player.Parent then
			_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
			return false
		end
	end

	if retryCount >= MAX_SAVE_RETRIES then
		_G.PlayerDataStats.saveFail = _G.PlayerDataStats.saveFail + 1
		warn("❌ ÉCHEC secureSave: " .. userId .. " après " .. MAX_SAVE_RETRIES .. " tentatives")
		return false
	end

	data = validatePoints(data)

	-- ✅ FIX MIGRATION : check 100% mémoire (pas de GetAsync)
	-- On vérifie que TOUS les chargeurs critiques ont fini avant d'écrire,
	-- sinon on écrirait des 0/{} qui écraseraient la vraie data au prochain load.
	if not isAllSecondaryLoaded(userId) then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		warn(string.format(
			"🛡️ secureSave reporté pour %d : loaders pas finis (cp=%s, kills=%s, qcd=%s, rr=%s)",
			userId,
			tostring(playerCheckpoints[userId] ~= nil),
			tostring(playerKillCount[userId] ~= nil),
			tostring(questCooldownsLoaded[userId] ~= nil),
			tostring(allowedRebirth[userId] ~= nil)
			))
		return false
	end

	-- ✅ Plus de probe DataStore : isAllSecondaryLoaded (vérifié plus haut) garantit
	-- que les valeurs en mémoire sont définitives. Si une valeur est encore nil ici,
	-- c'est un vrai nouveau joueur (ou une table vide légitime) → default OK.
	local function getExistingFallback(memValue, fieldName, default)
		if memValue ~= nil then return memValue end
		return default
	end

	-- Anti-perte
	if retryCount == 0 and not LossGuard.validateSave(userId, data, "secureSave") then
		_G.PlayerDataStats.saveSkipped = _G.PlayerDataStats.saveSkipped + 1
		return false
	end

	if pendingSaves[userId] then return false end
	pendingSaves[userId] = true

	-- ✅ Construire le payload unifié avec protection contre les nil en mémoire
	local payload = {
		version       = 1,
		migrated      = true,  -- ✅ FLAG : marque le joueur comme post-migration PlayerData_v1
		points        = data,
		rebirthCount  = getExistingFallback(playerRebirthCount[userId], "rebirthCount", 0),
		rebirthRight  = getExistingFallback(allowedRebirth[userId], "rebirthRight", false) == true,
		lastSavedAt   = os.time(),

		-- Checkpoint quest
		checkpoints           = getExistingFallback(playerCheckpoints[userId], "checkpoints", 0),
		checkpointCooldownEnd = getExistingFallback(checkpointQuestCooldowns[userId], "checkpointCooldownEnd", 0),
		touchedCheckpoints    = getExistingFallback(playerTouchedCheckpoints[userId], "touchedCheckpoints", {}),
		earnedPointLevels     = getExistingFallback(playerEarnedPointLevels[userId], "earnedPointLevels", {}),

		-- Kills
		killCount         = getExistingFallback(playerKillCount[userId], "killCount", 0),
		killCooldown      = getExistingFallback(playerKillCooldown[userId], "killCooldown", 0),
		killQuestProgress = getExistingFallback(killQuestProgress[userId], "killQuestProgress", 0),
		killQuestCooldown = getExistingFallback(killQuestCooldowns[userId], "killQuestCooldown", 0),

		-- Quest cooldowns
		questCooldowns = getExistingFallback(
			(AntiExploit.questHistory and AntiExploit.questHistory[userId]),
			"questCooldowns", {}
		),

		-- Codes redeem
		redeemedCodes = getExistingFallback(playerRedeemedCodes[userId], "redeemedCodes", {}),

		-- ⚙️ Paramètres joueur
		settings = getExistingFallback(Settings.data[userId], "settings", Settings.default()),

		-- Playtime lifetime
		playtimeSeconds = getCurrentPlaytime(userId),

		-- Anti-cheat
		warningInfractions = getExistingFallback(
			(AntiExploit.infractions and AntiExploit.infractions[userId]),
			"warningInfractions", 0
		),
		smartAntiCheatInfractions = (
			SmartAntiCheat.playerData
				and SmartAntiCheat.playerData[userId]
				and SmartAntiCheat.playerData[userId].infractions
		) and {
			suspiciousCount    = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
			dangerousCount     = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
			totalInfractions   = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
			burstCount         = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
			lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
		} or nil,
	}

	-- 🛡️ FIX : persister aussi P2 (totalSpent) et boosts dans le store UNIFIÉ.
	-- Sinon ces données ne vivent QUE dans le SessionLock (lu seulement si reconnexion <30s
	-- ou reload). Une reconnexion normale >30s lit l'unifié → P2/boosts perdus.
	if type(_G.enrichQuestSnapshotWithP2) == "function" then
		payload = _G.enrichQuestSnapshotWithP2(userId, payload)
	end
	if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
		payload = _G.enrichQuestSnapshotWithBoosts(userId, payload)
	end
	-- ⏱️ UpdateAsync au lieu de SetAsync : on garde le MAX entre le playtime
	--    déjà en base et celui qu'on écrit. Un playtime à 0 en mémoire ne peut
	--    plus effacer celui du joueur.
	local keptPlaytime = nil
	local success, err = pcall(function()
		PLAYER_DATA_STORE:UpdateAsync("p_" .. userId, function(old)
			keptPlaytime = nil
			local oldPt = (type(old) == "table" and tonumber(old.playtimeSeconds)) or 0
			if oldPt > (tonumber(payload.playtimeSeconds) or 0) then
				payload.playtimeSeconds = oldPt
				keptPlaytime = oldPt
			end
			return payload
		end)
	end)
	pendingSaves[userId] = nil
	if success and keptPlaytime then _G.PlaytimeRepair(userId, keptPlaytime) end


	if success then
		_G.PlayerDataStats.saveSuccess = _G.PlayerDataStats.saveSuccess + 1
		print("✅ SAVE UNIFIÉ: UserID " .. userId .. " | " .. data .. " pts | "
			.. (payload.rebirthCount) .. " rebirths")

		LossGuard.setLastSaved(userId, data)

		-- Update SessionLock (filet sécurité reconnect rapide)
		-- ✅ FIX RACE : Si reload en cours (skipReloadCheck=true), NE PAS écraser le SessionLock
		-- complet (avec questSnapshot) que notifyReloadEvent posera via acquireSessionLock.
		-- Pour les saves normaux : on écrit un lock minimal (recentReloads bloque déjà
		-- toute concurrence avec une période de reload).
		if not skipReloadCheck then
			local capturedCodes = playerRedeemedCodes[userId] or {}
			local capturedPlaytime = getCurrentPlaytime(userId)
			local capturedSettings = Settings.data[userId] or Settings.default()
			-- ✅ FIX RE-FARM : capturer AUSSI l'état quêtes/PointLevels dans le lock.
			-- Sans questSnapshot, un quit+rejoin <30s prend le raccourci SessionLock,
			-- playerCheckpoints reste nil → loadCheckpointQuestData relit un
			-- checkpointQuestStore stale → playerEarnedPointLevels perd les derniers
			-- checkpoints → re-farm des 100 pts.
			-- NOTE : isAllSecondaryLoaded a déjà été vérifié plus haut dans secureSave,
			-- donc ces tables sont garanties chargées (pas de risque d'écrire des {}).
			local capturedSnapshot = {
				checkpoints        = playerCheckpoints[userId] or 0,
				cooldownEnd        = checkpointQuestCooldowns[userId] or 0,
				touchedUIDs        = playerTouchedCheckpoints[userId] or {},
				earnedPointLevels  = playerEarnedPointLevels[userId] or {},
				killCount          = playerKillCount[userId] or 0,
				killCooldown       = playerKillCooldown[userId] or 0,
				killQuestCooldowns = killQuestCooldowns[userId] or 0,
				killQuestProgress  = killQuestProgress[userId] or 0,
				redeemedCodes      = capturedCodes,
				settings           = capturedSettings,
				playtimeSeconds    = capturedPlaytime,
				rebirthCount       = playerRebirthCount[userId] or 0,
				allowedRebirth     = allowedRebirth[userId] == true,
				questHistory       = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},
				antiExploitInfractions = AntiExploit.infractions[userId] or 0,
				-- 🛡️ FIX : inclure aussi SmartAntiCheat (sinon reset à 0 en reconnexion rapide <30s)
				smartAntiCheatInfractions = (
					SmartAntiCheat.playerData[userId]
						and SmartAntiCheat.playerData[userId].infractions
				) and {
					suspiciousCount    = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
					dangerousCount     = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
					totalInfractions   = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
					burstCount         = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
					lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
				} or nil,
			}
			-- Enrichir comme le fait BindToClose (P2 / boosts) si les hooks existent
			if type(_G.enrichQuestSnapshotWithP2) == "function" then
				capturedSnapshot = _G.enrichQuestSnapshotWithP2(userId, capturedSnapshot)
			end
			if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
				capturedSnapshot = _G.enrichQuestSnapshotWithBoosts(userId, capturedSnapshot)
			end
			task.spawn(function()
				pcall(function()
					SESSION_LOCK_STORE:SetAsync("lock_" .. userId, {
						points = data,
						timestamp = os.time(),
						expiresAt = os.time() + SESSION_LOCK_DURATION,
						redeemedCodes = capturedCodes,
						playtimeSeconds = capturedPlaytime,
						settings = capturedSettings,
						questSnapshot = capturedSnapshot,  -- ✅ FIX RE-FARM
					})
				end)
			end)
		end

		return true
	else
		warn("⚠️ Save échoué " .. userId .. " (tentative " .. (retryCount + 1) .. "): " .. tostring(err))
		task.wait(1)
		-- ✅ FIX 11 : propager skipReloadCheck dans le retry pour rester cohérent
		return secureSave(userId, data, retryCount + 1, skipReloadCheck)
	end
end

local function secureLoad(userId)
	local newKey = "p_" .. userId
	local oldKey = "temps_" .. userId

	print("🔍 CHARGEMENT pour UserID:", userId)

	-- 1. SessionLock check (reconnect rapide, inchangé)
	local lockOk, lockData = pcall(function()
		return SESSION_LOCK_STORE:GetAsync("lock_" .. userId)
	end)

	if lockOk and lockData and lockData.points then
		local lockAge = os.time() - (lockData.timestamp or 0)
		if lockAge < 30 and lockData.points > 0 then
			-- ✅ FIX ANTI-RE-REDEEM : si le lock ne contient PAS redeemedCodes (vieux format),
			-- on REFUSE le shortcut et on fall through vers PlayerData_v1.
			-- Sinon, un joueur pourrait quitter et revenir pour re-claim un code.
			local lockHasCodes = type(lockData.redeemedCodes) == "table"
				or (lockData.questSnapshot and type(lockData.questSnapshot.redeemedCodes) == "table")

			if not lockHasCodes then
				warn(string.format("⚠️ SessionLock sans redeemedCodes pour %d → fallback PlayerData_v1 (anti re-redeem)", userId))
			else
				print(string.format("🔒 SessionLock récent (%ds) → %d pts pour %d",
					lockAge, lockData.points, userId))

				-- ✅ Restaurer redeemedCodes (top-level prioritaire, sinon depuis questSnapshot)
				if type(lockData.redeemedCodes) == "table" then
					playerRedeemedCodes[userId] = lockData.redeemedCodes
				else
					playerRedeemedCodes[userId] = lockData.questSnapshot.redeemedCodes
				end

				-- ⚙️ Restaurer paramètres (top-level prioritaire, sinon questSnapshot)
				if type(lockData.settings) == "table" then
					Settings.data[userId] = lockData.settings
				elseif lockData.questSnapshot and type(lockData.questSnapshot.settings) == "table" then
					Settings.data[userId] = lockData.questSnapshot.settings
				end

				if lockData.questSnapshot then
					local snap = lockData.questSnapshot
					playerCheckpoints[userId]        = snap.checkpoints or 0
					checkpointQuestCooldowns[userId] = snap.cooldownEnd or 0
					playerTouchedCheckpoints[userId] = snap.touchedUIDs or {}
					playerEarnedPointLevels[userId]  = snap.earnedPointLevels or {}
					playerKillCount[userId]          = snap.killCount or 0
					playerKillCooldown[userId]       = snap.killCooldown or 0
					killQuestCooldowns[userId]       = snap.killQuestCooldowns or 0
					killQuestProgress[userId]        = snap.killQuestProgress or 0

					-- ✅ FIX : Reset cooldowns expirés depuis SessionLock aussi
					local nowSL = os.time()
					if playerKillCooldown[userId] > 0 and nowSL >= playerKillCooldown[userId] then
						playerKillCount[userId]    = 0
						playerKillCooldown[userId] = 0
						print(string.format("✅ Cooldown 100-kills expiré au load SessionLock pour %d", userId))
					end
					if (checkpointQuestCooldowns[userId] or 0) > 0 and nowSL >= checkpointQuestCooldowns[userId] then
						playerCheckpoints[userId]        = 0
						checkpointQuestCooldowns[userId] = 0
						playerTouchedCheckpoints[userId] = {}
						print(string.format("✅ CheckpointQuest cooldown 24h expiré au load SessionLock pour %d", userId))
					end

					-- ✅ FIX FIABILITÉ : restaurer aussi rebirths, allowedRebirth, et cooldowns quêtes
					if type(snap.rebirthCount) == "number" then
						playerRebirthCount[userId] = snap.rebirthCount
					end
					if snap.allowedRebirth ~= nil then
						allowedRebirth[userId] = snap.allowedRebirth == true
					end
					if type(snap.questHistory) == "table" then
						mergeQuestHistory(userId, snap.questHistory)          -- ✅ merge, pas écrase
						questCooldownsLoaded[userId] = questCooldownsLoaded[userId] or true
					end

					if snap.antiExploitInfractions and snap.antiExploitInfractions > 0 then
						AntiExploit.infractions[userId] = snap.antiExploitInfractions
					end
					if snap.smartAntiCheatInfractions then
						if not SmartAntiCheat.playerData[userId] then
							SmartAntiCheat.InitPlayer(userId)
						end
						local sd = SmartAntiCheat.playerData[userId]
						if sd then
							sd.infractions = {
								suspiciousCount    = snap.smartAntiCheatInfractions.suspiciousCount or 0,
								dangerousCount     = snap.smartAntiCheatInfractions.dangerousCount or 0,
								totalInfractions   = snap.smartAntiCheatInfractions.totalInfractions or 0,
								burstCount         = snap.smartAntiCheatInfractions.burstCount or 0,
								lastInfractionTime = snap.smartAntiCheatInfractions.lastInfractionTime or 0,
							}
						end
					end
				end

				-- ⏱️ Restaurer playtime (priorité : top-level → questSnapshot → fallback unifié)
				local lockedPlaytime = nil
				if type(lockData.playtimeSeconds) == "number" then
					lockedPlaytime = lockData.playtimeSeconds
				elseif lockData.questSnapshot and type(lockData.questSnapshot.playtimeSeconds) == "number" then
					lockedPlaytime = lockData.questSnapshot.playtimeSeconds
				end

				if lockedPlaytime then
					playerPlaytime[userId] = lockedPlaytime
					print(string.format("⏱️ Playtime restauré depuis SessionLock: %d sec pour %d", lockedPlaytime, userId))
				else
					-- ⚠️ Vieux SessionLock sans playtime → fallback unifié pour ne rien perdre
					local pOk, pData = pcall(function()
						return PLAYER_DATA_STORE:GetAsync(newKey)
					end)
					if pOk and type(pData) == "table" and type(pData.playtimeSeconds) == "number" then
						playerPlaytime[userId] = pData.playtimeSeconds
						print(string.format("⏱️ Playtime fallback unifié (SessionLock incomplet): %d sec pour %d", pData.playtimeSeconds, userId))
					else
						playerPlaytime[userId] = 0
						warn(string.format("⚠️ Playtime introuvable pour %d (SessionLock + unifié vides)", userId))
					end
				end

				task.spawn(function()
					pcall(function()
						SESSION_LOCK_STORE:RemoveAsync("lock_" .. userId)
					end)
				end)
				return validatePoints(lockData.points)
			end
		end
	end

	-- 2. ✅ Essai du store unifié avec 3 tentatives
	local unifiedOk, unifiedData
	for attempt = 1, 3 do
		unifiedOk, unifiedData = pcall(function()
			return PLAYER_DATA_STORE:GetAsync(newKey)
		end)
		if unifiedOk then break end
		warn(string.format("⚠️ PLAYER_DATA_STORE tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.8 * attempt)
	end

	-- 2b. 🚨 FIX CRITIQUE : Si lecture unified ÉCHOUÉE (réseau/timeout) → kick préventif
	-- Ne JAMAIS fall back vers legacy post-migration, ça écrase la vraie data avec du stale
	if not unifiedOk then
		_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
		warn(string.format(
			"🚨 CRITIQUE: PLAYER_DATA_STORE inaccessible pour %d (3 tentatives) → kick préventif",
			userId
			))
		return nil
	end

	-- 2c. 🚨 FIX CRITIQUE : Joueur marqué migrated=true mais payload corrompu → kick
	-- Détecte le cas où Roblox renvoie un payload partiel/cassé pour un joueur déjà migré
	if type(unifiedData) == "table" and unifiedData.migrated == true
		and type(unifiedData.points) ~= "number" then
		_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
		warn(string.format(
			"🚨 CRITIQUE: Joueur %d a flag migrated=true mais payload corrompu → kick préventif",
			userId
			))
		return nil
	end

	-- 2d. Unified hit : utiliser la data unifiée
	if type(unifiedData) == "table" and type(unifiedData.points) == "number" then
		_G.PlayerDataStats.loadSuccessUnified = _G.PlayerDataStats.loadSuccessUnified + 1

		-- Restaurer TOUTES les données en mémoire (1 seule lecture pour tout)
		playerRebirthCount[userId]       = unifiedData.rebirthCount or 0
		allowedRebirth[userId]           = unifiedData.rebirthRight == true

		playerCheckpoints[userId]        = unifiedData.checkpoints or 0
		checkpointQuestCooldowns[userId] = unifiedData.checkpointCooldownEnd or 0
		playerTouchedCheckpoints[userId] = unifiedData.touchedCheckpoints or {}
		playerEarnedPointLevels[userId]  = unifiedData.earnedPointLevels or {}

		playerKillCount[userId]          = unifiedData.killCount or 0
		playerKillCooldown[userId]       = unifiedData.killCooldown or 0
		killQuestProgress[userId]        = unifiedData.killQuestProgress or 0
		-- 🛡️ FIX FARM : merge-max (jamais reculer). Le store kq_ est écrit immédiatement à
		-- chaque claim ; si l'unifié est en retard, écraser downgraderait le cooldown 24h
		-- de la KillQuest → re-claim = farm 10 000 pts.
		killQuestCooldowns[userId]       = math.max(killQuestCooldowns[userId] or 0, unifiedData.killQuestCooldown or 0)

		-- ✅ FIX MIGRATION : Reset cooldown 100-kills si expiré offline
		local nowLoad = os.time()
		if playerKillCooldown[userId] > 0 and nowLoad >= playerKillCooldown[userId] then
			playerKillCount[userId]    = 0
			playerKillCooldown[userId] = 0
			print(string.format("✅ Cooldown 100-kills expiré au load unified pour %d", userId))
		end

		-- ✅ FIX MIGRATION : Reset checkpoint quest si cooldown 24h expiré offline
		if (checkpointQuestCooldowns[userId] or 0) > 0 and nowLoad >= checkpointQuestCooldowns[userId] then
			playerCheckpoints[userId]        = 0
			checkpointQuestCooldowns[userId] = 0
			playerTouchedCheckpoints[userId] = {}
			-- NE PAS reset playerEarnedPointLevels (reset uniquement au rebirth)
			print(string.format("✅ CheckpointQuest cooldown 24h expiré au load unified pour %d", userId))
		end

		-- ✅ FIX : MERGE au lieu d'écraser. loadAllQuestCooldowns (store dédié, écrit
		-- immédiatement à chaque claim) tourne en parallèle : si unified est stale
		-- (dernier save raté après un claim), écraser effacerait un cooldown plus frais
		-- → re-claim possible d'une quête 8h/24h.
		mergeQuestHistory(userId, unifiedData.questCooldowns)
		questCooldownsLoaded[userId] = questCooldownsLoaded[userId] or true
		-- (ne pas rétrograder "fetched" → true)

		if type(unifiedData.redeemedCodes) == "table" then
			playerRedeemedCodes[userId] = unifiedData.redeemedCodes
		else
			playerRedeemedCodes[userId] = {}
		end

		-- Restaurer playtime lifetime
		playerPlaytime[userId] = unifiedData.playtimeSeconds or 0

		-- ⚙️ Restaurer paramètres joueur
		if type(unifiedData.settings) == "table" then
			Settings.data[userId] = unifiedData.settings
		else
			Settings.data[userId] = Settings.default()
		end

		if type(unifiedData.warningInfractions) == "number" then
			AntiExploit.infractions[userId] = unifiedData.warningInfractions
		end

		if type(unifiedData.smartAntiCheatInfractions) == "table" then
			if not SmartAntiCheat.playerData[userId] then
				SmartAntiCheat.InitPlayer(userId)
			end
			local sd = SmartAntiCheat.playerData[userId]
			if sd then
				sd.infractions = {
					suspiciousCount    = unifiedData.smartAntiCheatInfractions.suspiciousCount or 0,
					dangerousCount     = unifiedData.smartAntiCheatInfractions.dangerousCount or 0,
					totalInfractions   = unifiedData.smartAntiCheatInfractions.totalInfractions or 0,
					burstCount         = unifiedData.smartAntiCheatInfractions.burstCount or 0,
					lastInfractionTime = unifiedData.smartAntiCheatInfractions.lastInfractionTime or 0,
				}
			end
		end

		local pts = validatePoints(unifiedData.points)
		print(string.format("✅ UNIFIÉ: %d pts | %d rebirths | %d checkpoints | %d kills",
			pts, unifiedData.rebirthCount or 0, unifiedData.checkpoints or 0, unifiedData.killCount or 0))
		return pts
	end

	-- 3. ✅ MIGRATION : pas trouvé dans unifié, lire ancien store (points + rebirths uniquement)
	print("📦 Pas dans unifié, migration depuis ancien store pour " .. userId)

	-- Points depuis l'ancien tempsStore
	local oldSuccess, oldData
	for attempt = 1, 2 do
		oldSuccess, oldData = pcall(function()
			return tempsStore:GetAsync(oldKey)
		end)
		if oldSuccess then break end
		task.wait(0.6 * attempt)
	end

	-- ✅ FIX RACE : Rebirths depuis l'ancien rebirthCountStore (SYNCHRONE avec retry)
	-- Avant: task.spawn → secureSave pouvait écrire rebirthCount=0 avant la fin du load
	local rebirthLoaded = false
	for attempt = 1, 3 do
		local okR, rebirthData = pcall(function()
			return rebirthCountStore:GetAsync("rebirth_" .. userId)
		end)
		if okR then
			if type(rebirthData) == "number" and rebirthData > 0 then
				playerRebirthCount[userId] = rebirthData
				print("📦 Rebirths legacy chargés: " .. rebirthData .. " pour " .. userId)
			else
				playerRebirthCount[userId] = 0
			end
			rebirthLoaded = true
			break
		end
		warn(string.format("⚠️ rebirthCountStore tentative %d/3 échouée pour %d", attempt, userId))
		task.wait(0.5 * attempt)
	end

	if not rebirthLoaded then
		-- DataStore down : NE PAS setter à 0, signaler échec critique
		warn(string.format("🚨 CRITIQUE: rebirthCountStore inaccessible pour %d → load avorté", userId))
		_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
		return nil  -- Provoque kick préventif dans PlayerAdded (déjà géré)
	end

	if oldSuccess and oldData and type(oldData) == "number" and oldData > 0 then
		_G.PlayerDataStats.loadFromLegacy = _G.PlayerDataStats.loadFromLegacy + 1
		local pts = validatePoints(oldData)
		-- ✅ FIX MIGRATION : Init playerRedeemedCodes (pas de store legacy pour ça)
		if playerRedeemedCodes[userId] == nil then
			playerRedeemedCodes[userId] = {}
		end
		print("✅ POINTS LEGACY: " .. pts .. " pour " .. userId .. " (sera migré au prochain save)")
		return pts
	end

	-- 4. Backup stores (filet de sécurité existant, séquentiel)
	if oldSuccess then
		-- Le main a répondu nil → tenter les backups
		local maxBackupValue = 0
		for i, backupStore in ipairs(backupStores) do
			local backupOk, backupData = pcall(function()
				return backupStore:GetAsync(oldKey)
			end)
			if backupOk and backupData and type(backupData) == "number" and backupData > 0 then
				maxBackupValue = validatePoints(backupData)
				print("📦 BACKUP " .. i .. " utilisé: " .. maxBackupValue)
				break
			end
			task.wait(0.4)
		end

		if maxBackupValue > 0 then
			_G.PlayerDataStats.loadFromLegacy = _G.PlayerDataStats.loadFromLegacy + 1
			if playerRedeemedCodes[userId] == nil then
				playerRedeemedCodes[userId] = {}
			end
			return maxBackupValue
		end

		-- Vraiment nouveau joueur
		_G.PlayerDataStats.loadNewPlayer = _G.PlayerDataStats.loadNewPlayer + 1
		if playerRedeemedCodes[userId] == nil then
			playerRedeemedCodes[userId] = {}
		end
		print("ℹ️ NOUVEAU JOUEUR: " .. userId)
		return 0
	end

	-- 5. Échec total des reads (kick préventif)
	_G.PlayerDataStats.loadFail = _G.PlayerDataStats.loadFail + 1
	warn("🚨 ÉCHEC TOTAL secureLoad pour " .. userId .. " → nil (kick préventif)")
	return nil
end

-- ========================================
-- FONCTIONS BONUS
-- ========================================
function calculatePoints(totalSeconds)
	return totalSeconds
end

function applyGroupBonus(points, player)
	if player and player:IsInGroup(GroupId) then
		return points * 1.1  -- ✅ Pas d'arrondissement
	end
	return points
end

local function applyPremiumBonus(points, player)
	if player.MembershipType == Enum.MembershipType.Premium then
		return points * 1.15  -- ✅ Pas d'arrondissement
	end
	return points
end

function applyAllBonuses(points, player)
	return points
end

_G.tempsJoueurs = tempsJoueurs
_G.allowedRebirth = allowedRebirth
_G.calculatePoints = calculatePoints
_G.applyAllBonuses = applyAllBonuses
_G.secureSave = secureSave
_G.buyGamePassEvent = buyGamePassEvent
_G.dataLoading = dataLoading
_G.recentReloads = recentReloads  -- ✨ pour TempBoosts
-- ========================================
-- SYSTÈME D'AMIS ULTRA-OPTIMISÉ V2 - REFRESH CIBLÉ
-- Performance : 10× plus rapide que le refresh global
-- Scalable jusqu'à 100+ joueurs
-- ========================================

-- ========================================
-- VARIABLES DE CACHE (déjà définies plus haut)
-- ========================================
-- local friendCountCache = {}
-- local friendsCache = {}
-- local lastFriendCheck = {}
-- local FRIEND_CACHE_DURATION = 600

-- ========================================
-- 🆕 SYSTÈME DE DIRTY FLAGS
-- ========================================
local dirtyPlayers = {} -- Joueurs qui doivent recompter
local dirtyProcessing = false

-- Marquer un joueur comme nécessitant un recompte
local function markAsDirty(userId, reason)
	if not dirtyPlayers[userId] then
		dirtyPlayers[userId] = {
			markedAt = os.time(),
			reason = reason or "unknown",
			processed = false
		}
		print(string.format("🏴 Dirty flag: UserID %d (%s)", userId, reason))
	end
end

-- Nettoyer les flags anciens (>5 minutes)
local function cleanupDirtyFlags()
	local now = os.time()
	for userId, data in pairs(dirtyPlayers) do
		if data.processed or (now - data.markedAt) > 300 then
			dirtyPlayers[userId] = nil
		end
	end
end

-- ========================================
-- FONCTIONS DE BASE (optimisées)
-- ========================================

local function isFriendCached(player, otherPlayer)
	if not player or not otherPlayer then return false end

	local userId = player.UserId
	local otherId = otherPlayer.UserId

	-- Vérifier cache
	if friendsCache[userId] and friendsCache[userId][otherId] ~= nil then
		return friendsCache[userId][otherId]
	end

	-- Initialiser cache
	if not friendsCache[userId] then
		friendsCache[userId] = {}
	end

	-- Vérifier avec API
	local success, isFriend = pcall(function()
		return player:IsFriendsWith(otherId)
	end)

	if success then
		friendsCache[userId][otherId] = isFriend
		return isFriend
	end

	return false
end

-- ✅ OPTIMISÉ : Recompte avec cache intelligent
local function countFriendsInGame(player, forceRecount)
	if not player or not player.Parent then return 0 end

	local userId = player.UserId
	local now = os.time()

	-- ✅ Respecter le cache SI pas forcé
	if not forceRecount and friendCountCache[userId] and lastFriendCheck[userId] then
		if (now - lastFriendCheck[userId]) < FRIEND_CACHE_DURATION then
			return friendCountCache[userId]
		end
	end

	local friendCount = 0
	local allPlayers = Players:GetPlayers()

	for _, otherPlayer in ipairs(allPlayers) do
		if otherPlayer ~= player and otherPlayer.Parent then
			if isFriendCached(player, otherPlayer) then
				friendCount = friendCount + 1
			end
		end
	end

	friendCountCache[userId] = friendCount
	lastFriendCheck[userId] = now

	return friendCount
end

local function getFriendMultiplier(player)
	return 1   -- 🚫 les amis ne donnent AUCUN boost de points
end
_G.getFriendMultiplier = getFriendMultiplier

local function updateFriendUI(player)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local friendCount = friendCountCache[userId] or 0
	local multiplier = getFriendMultiplier(player)

	player:SetAttribute("FriendCount", friendCount)

	pcall(function()
		updateFriendEvent:FireClient(player, friendCount, multiplier)
	end)
end

-- ✅ FONCTION DE COMPATIBILITÉ
local function refreshAllFriendsBatched()
	print("🔄 Refresh global demandé, marquage de tous les joueurs...")

	local allPlayers = Players:GetPlayers()
	local markedCount = 0

	for _, player in ipairs(allPlayers) do
		if player and player.Parent then
			markAsDirty(player.UserId, "manual_refresh_all")
			markedCount = markedCount + 1
		end
	end

	print(string.format("✅ %d joueurs marqués dirty, le worker les traitera", markedCount))
end

-- ========================================
-- 🆕 SCAN RAPIDE : Trouver les amis d'un joueur
-- ========================================
local function scanPlayerFriends(player)
	if not player or not player.Parent then return {} end

	local userId = player.UserId
	local friendIds = {}
	local allPlayers = Players:GetPlayers()

	print(string.format("🔍 Scan amis pour %s...", player.Name))

	for _, otherPlayer in ipairs(allPlayers) do
		if otherPlayer ~= player and otherPlayer.Parent then
			if isFriendCached(player, otherPlayer) then
				table.insert(friendIds, otherPlayer.UserId)
			end
		end
	end

	print(string.format("✅ Scan terminé: %d amis trouvés", #friendIds))
	return friendIds
end

-- ========================================
-- 🆕 RECOMPTE CIBLÉ : Traiter un seul joueur
-- ========================================
local function processPlayerFriends(userId)
	local player = Players:GetPlayerByUserId(userId)
	if not player or not player.Parent then
		dirtyPlayers[userId] = nil
		return
	end

	print(string.format("⚙️ Traitement: %s (UserID %d)", player.Name, userId))

	-- ✅ FORCER le recompte (ignorer cache)
	local friendCount = countFriendsInGame(player, true)

	-- Mettre à jour UI
	player:SetAttribute("FriendCount", friendCount)
	updateFriendUI(player)

	-- Mettre à jour SmartAntiCheat
	local smartData = SmartAntiCheat.playerData[userId]
	if smartData and smartData.profile then
		smartData.profile.friendCount = friendCount
		smartData.profile.lastProfileUpdate = os.time()
	end

	-- Marquer comme traité
	if dirtyPlayers[userId] then
		dirtyPlayers[userId].processed = true
	end

	print(string.format("✅ Traité: %s → %d amis (x%.2f)", 
		player.Name, friendCount, getFriendMultiplier(player)))
end

-- ========================================
-- 🆕 WORKER : Traite les joueurs "dirty" progressivement
-- ========================================
task.spawn(function()
	print("🔄 Worker dirty flags démarré")

	while true do
		task.wait(0.5) -- Traiter 1 joueur toutes les 0.5s

		-- Nettoyer les anciens flags
		cleanupDirtyFlags()

		-- Trouver le prochain joueur à traiter
		local nextUserId = nil
		for userId, data in pairs(dirtyPlayers) do
			if not data.processed then
				nextUserId = userId
				break
			end
		end

		-- Traiter si trouvé
		if nextUserId then
			task.spawn(function()
				processPlayerFriends(nextUserId)
			end)
		end
	end
end)

-- ========================================
-- 🆕 EVENT : NOUVEAU JOUEUR REJOINT
-- ========================================
Players.PlayerAdded:Connect(function(newPlayer)
	task.spawn(function()
		task.wait(3) -- Attendre chargement

		if not newPlayer or not newPlayer.Parent then return end

		print(string.format("➕ %s a rejoint", newPlayer.Name))

		-- ✅ PHASE 1 : Scanner les amis du nouveau joueur
		local friendIds = scanPlayerFriends(newPlayer)

		-- ✅ Initialiser son cache
		local friendCount = #friendIds
		friendCountCache[newPlayer.UserId] = friendCount
		lastFriendCheck[newPlayer.UserId] = os.time()
		newPlayer:SetAttribute("FriendCount", friendCount)
		updateFriendUI(newPlayer)

		-- ✅ PHASE 2 : Marquer SEULEMENT ses amis comme dirty
		for _, friendId in ipairs(friendIds) do
			markAsDirty(friendId, "friend_joined")
		end

		print(string.format("✅ %s initialisé (%d amis, %d dirty)", 
			newPlayer.Name, friendCount, #friendIds))
	end)
end)

-- ========================================
-- 🆕 EVENT : JOUEUR QUITTE
-- ========================================
Players.PlayerRemoving:Connect(function(leavingPlayer)
	task.spawn(function()
		local userId = leavingPlayer.UserId

		print(string.format("➖ %s quitte (handler friends)", leavingPlayer.Name))

		-- ✅ FIX RACE : NE PAS clear playerRebirthCount/dataLoading/killQuestCooldowns ici
		-- (le PlayerRemoving principal a besoin de ces valeurs pour secureSave)
		-- Le cleanup mémoire est fait dans le handler principal

		-- ✅ RÉCUPÉRER la liste de ses amis depuis le CACHE (avant cleanup)
		local friendIds = {}
		if friendsCache[userId] then
			for otherId, isFriend in pairs(friendsCache[userId]) do
				if isFriend then
					table.insert(friendIds, otherId)
				end
			end
		end

		-- ✅ Attendre que le handler principal ait fini sa save (3s suffit)
		task.wait(3)

		-- ✅ Cleanup uniquement les caches friends (le reste est dans le handler principal)
		friendCountCache[userId] = nil
		lastFriendCheck[userId] = nil
		friendsCache[userId] = nil
		dirtyPlayers[userId] = nil
		rebirthAuthorized[userId] = nil  -- spécifique au système rebirth/friends

		-- ✅ Nettoyer les références dans les autres caches
		for otherUserId, cache in pairs(friendsCache) do
			if cache[userId] then
				cache[userId] = nil
			end
		end

		-- ✅ Marquer SEULEMENT ses amis comme dirty
		for _, friendId in ipairs(friendIds) do
			local friendPlayer = Players:GetPlayerByUserId(friendId)
			if friendPlayer and friendPlayer.Parent then
				markAsDirty(friendId, "friend_left")
			end
		end

		print(string.format("✅ %s cleanup friends terminé (%d amis marqués dirty)", 
			leavingPlayer.Name, #friendIds))
	end)
end)

-- ========================================
-- 🆕 REFRESH GLOBAL LÉGER (fallback de sécurité)
-- ========================================
task.spawn(function()
	while true do
		task.wait(600) -- 10 minutes au lieu de 5

		local playerCount = #Players:GetPlayers()

		-- ✅ OPTIMISATION : Désactiver si >30 joueurs (trop coûteux)
		if playerCount <= 1 or playerCount > 30 then
			continue
		end

		print(string.format("⏰ Refresh de sécurité (%d joueurs)", playerCount))

		-- ✅ Marquer tout le monde comme dirty (le worker les traitera)
		for _, player in ipairs(Players:GetPlayers()) do
			markAsDirty(player.UserId, "scheduled_refresh")
		end
	end
end)

-- ========================================
-- 🆕 COMMANDES DEBUG AMÉLIORÉES
-- ========================================



-- ========================================
-- GAMEPASS FUNCTIONS (OPTIMISÉ)
-- ========================================
function getHighestGamePassMultiplier(player)  -- ✅ sans "local" : remplit la forward decl
	local userId = player.UserId
	local now = os.time()

	if gamePassCache[userId] and (now - gamePassCache[userId].lastCheck) < GAMEPASS_CACHE_DURATION then
		return gamePassCache[userId].multiplier
	end

	-- ✅ MODIFICATION: Addition de tous les GamePass au lieu de prendre le plus haut
	local totalMultiplier = 0
	local ownedPasses = {} -- Pour debug

	for passId, multiplier in pairs(gamePassMultipliers) do
		local hasPass = false

		if TEST_MODE and testPasses[passId] then
			hasPass = true
		else
			local success, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
			end)
			if success and owns then
				hasPass = true
			end
		end

		if hasPass then
			totalMultiplier = totalMultiplier + multiplier
			table.insert(ownedPasses, passId)
		end
	end

	-- 👑 VIP offert par un admin : même bonus que le gamepass VIP, sans le
	--    posséder. Disparaît automatiquement si l'admin retire le VIP.
	if _G.IsVIP and _G.IsVIP(userId) and not table.find(ownedPasses, 1891589121) then
		totalMultiplier = totalMultiplier + (gamePassMultipliers[1891589121] or 2)
		table.insert(ownedPasses, 1891589121)
	end

	-- ✨ BOOSTS PERMANENTS offerts (x2 / x5 / x10). Ils se comportent
	--    exactement comme un gamepass : additifs, permanents, et lus au
	--    MÊME endroit par AbsoluteCapProtection → zéro faux ban.
	local permBoost = (_G.PermBoosts and _G.PermBoosts.getMultiplier(userId)) or 0
	if permBoost > 0 then
		totalMultiplier = totalMultiplier + permBoost
		table.insert(ownedPasses, "perm+" .. permBoost)
	end

	-- Si aucun GamePass, retourner 1 (pas de bonus)
	if totalMultiplier == 0 then
		totalMultiplier = 1
	end

	gamePassCache[userId] = {
		multiplier = totalMultiplier,
		lastCheck = now,
		ownedPasses = ownedPasses -- ✅ Ajouté pour debug
	}

	-- ✅ LOG pour debug
	if #ownedPasses > 0 then
		print(string.format("🎫 GamePass pour %s: %d total (Passes: %s)", 
			player.Name, 
			totalMultiplier,
			table.concat(ownedPasses, ", ")
			))
	end

	return totalMultiplier
end

-- ========================================
-- FONCTION PRINCIPALE D'AJOUT DE POINTS
-- ========================================
local function addFuturePoints(player, basePoints)
	if not player or not player.Parent then return end
	local userId = player.UserId

	if type(tempsJoueurs[userId]) ~= "table" then
		-- ✅ FIX BUG RELOAD : Si reload AFK en cours, NE PAS recréer tempsJoueurs
		-- (sinon LossGuard détecte une fausse perte brutale dans PlayerRemoving)
		if recentReloads[userId] then
			return  -- Skip silencieusement, normal pendant reload AFK
		end

		-- ✅ FIX BUG RELOAD : Si pas de session active enregistrée, NE PAS recréer
		-- (sinon on recrée pour des sessions qui sont en train de quitter)
		local activeSession = activeConnections[userId]
		if not activeSession or activeSession.player ~= player then
			return  -- Skip silencieusement
		end

		-- Cas restant : bug multi-appareil → restaurer depuis attribut
		local oldPoints = 0
		local loadedBase = player:GetAttribute("LoadedBasePoints")
		local loadedAt = player:GetAttribute("LoadedAt")
		if loadedBase and loadedAt and (os.time() - loadedAt) < 30 then
			warn(string.format("🛡️ RESTAURATION ANTI-MULTIAPPAREIL pour %s : base restaurée à %d", 
				player.Name, loadedBase))
			oldPoints = loadedBase
		end

		tempsJoueurs[userId] = {base = oldPoints, future = 0, lastSaved = os.time()}
	end

	local data = tempsJoueurs[userId]

	-- ✅ Pas de multiplication ! Les points arrivent déjà calculés
	local pointsToAdd = basePoints

	data.future = data.future + pointsToAdd

	-- Hook AbsoluteCap
	if _G.AbsoluteCapHooks then
		_G.AbsoluteCapHooks.onGain(player, pointsToAdd, source)
	end

	-- ✅ Mise à jour directe du leaderstat (plus de queue)
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = data.base + data.future
		if type(totalPoints) == "number" and totalPoints == totalPoints then
			local finalValue = applyAllBonuses(calculatePoints(totalPoints), player)
			if type(finalValue) == "number" and finalValue == finalValue then
				pointsStat.Value = finalValue
				player:SetAttribute("Points", pointsStat.Value)
			end
		end
	end

	return pointsToAdd
end


-- ========================================
-- FONCTIONS QUÊTE CHECKPOINTS
-- ========================================


local function canClaimCheckpointQuest(userId)
	local now = os.time()
	local cooldownEnd = checkpointQuestCooldowns[userId] or 0
	local checkpoints = playerCheckpoints[userId] or 0
	return checkpoints >= CHECKPOINT_QUEST_REQUIRED and now >= cooldownEnd
end

local function updateCheckpointQuestUI(player, forceUpdate)
	if not player or not player.Parent then return end
	local userId = player.UserId
	local checkpoints = playerCheckpoints[userId] or 0
	local canClaim = canClaimCheckpointQuest(userId)
	local cooldownEnd = checkpointQuestCooldowns[userId] or 0

	local now = tick()
	if not forceUpdate and not canClaim then
		if lastUIUpdate[userId] and (now - lastUIUpdate[userId]) < 1 then
			return
		end
	end
	lastUIUpdate[userId] = now

	pcall(function()
		checkpointQuestUpdateEvent:FireClient(player, checkpoints, canClaim, cooldownEnd)
	end)
end

-- ✅ SÉCURITÉ CHECKPOINT AMÉLIORÉE
local function addCheckpointToQuest(player, checkpointPart)
	if not player or not player.Parent then return end

	local userId = player.UserId

	-- ✅ Bloquer si les données ne sont pas encore chargées depuis le DataStore
	if playerTouchedCheckpoints[userId] == nil then
		return
	end

	if not playerCheckpoints[userId] then
		playerCheckpoints[userId] = 0
	end

	local rebirthCount = playerRebirthCount[userId] or 0
	local checkpointUID = getOrCreateCheckpointUID(checkpointPart, rebirthCount)

	-- Anti-spam touch (2 secondes)
	local touchKey = tostring(userId) .. "_touch_" .. tostring(checkpointUID)
	local now = os.time()
	if checkpointTouchCooldown[touchKey] and now - checkpointTouchCooldown[touchKey] < 2 then
		return
	end
	checkpointTouchCooldown[touchKey] = now

	-- Déjà touché dans ce cycle rebirth ?
	if playerTouchedCheckpoints[userId][checkpointUID] then
		return
	end

	-- ✅ N'incrémenter la progression quest QUE si le cooldown 24h est terminé
	local now = os.time()
	local cooldownEnd = checkpointQuestCooldowns[userId] or 0
	if now < cooldownEnd then
		print(string.format("⏸️ CheckpointQuest en cooldown 24h — progression non incrémentée pour %s (%.1fh restantes)",
			player.Name, (cooldownEnd - now) / 3600))
		-- On marque quand même le checkpoint comme touché pour que awardPointLevel bloque le re-farming des points passifs
		playerTouchedCheckpoints[userId][checkpointUID] = true
		return
	end

	-- Ne pas dépasser 90
	if playerCheckpoints[userId] >= CHECKPOINT_QUEST_REQUIRED then
		return
	end

	-- Marquer comme touché et incrémenter
	playerTouchedCheckpoints[userId][checkpointUID] = true
	playerCheckpoints[userId] = playerCheckpoints[userId] + 1

	print(string.format("✅ Checkpoint +1 pour %s → %d/%d (UID: %s)", 
		player.Name, playerCheckpoints[userId], CHECKPOINT_QUEST_REQUIRED, checkpointUID))

	markCheckpointDirty(userId)
	local isComplete = playerCheckpoints[userId] >= CHECKPOINT_QUEST_REQUIRED
	updateCheckpointQuestUI(player, isComplete)
end


checkpointQuestClaimEvent.OnServerEvent:Connect(function(player)
	if not player or not player.Parent then return end

	if not AntiExploit.CheckRemoteCall(player, "CheckpointQuestClaim") then
		return
	end

	local userId = player.UserId
	local now = os.time()

	if dataLoading[userId] then return end -- 🛡️ points pas encore chargés : rien ne doit changer (sinon perdu au chargement)

	-- Vérifier cooldown depuis RAM (chargé depuis DataStore au join)
	local lastClaim = AntiExploit.questHistory[userId] and
		AntiExploit.questHistory[userId]["CheckpointQuest"]

	if lastClaim and (now - lastClaim) < CHECKPOINT_QUEST_COOLDOWN then
		-- ✅ FIX FAUX-BAN : claim bloqué = 0 point => déjà sûr, aucune infraction.
		AntiExploit.NoteBlockedClaim(player, "CheckpointQuest")
		updateCheckpointQuestUI(player, true)
		return
	end

	if not canClaimCheckpointQuest(userId) then
		-- Claim refusé = 0 point versé, donc aucune raison de sanctionner.
		-- Ça arrive légitimement quand les données ne sont pas encore chargées
		-- ou quand l'interface a un train de retard.
		AntiExploit.NoteBlockedClaim(player, "CheckpointQuest")
		updateCheckpointQuestUI(player, true)
		return
	end

	-- Enregistrer cooldown en RAM immédiatement
	if not AntiExploit.questHistory[userId] then
		AntiExploit.questHistory[userId] = {}
	end
	AntiExploit.questHistory[userId]["CheckpointQuest"] = now

	-- Sauvegarder en DataStore en arrière-plan
	saveQuestCooldown(userId, "CheckpointQuest", now)

	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end
	SmartAntiCheat.ExpectGain(userId, CHECKPOINT_QUEST_REWARD, "QuestCheckpoint")

	tempsJoueurs[userId].future = tempsJoueurs[userId].future + CHECKPOINT_QUEST_REWARD

	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value = applyAllBonuses(calculatePoints(totalPoints), player)
		player:SetAttribute("Points", pointsStat.Value)


		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = pointsStat.Value
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end
	end

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, CHECKPOINT_QUEST_REWARD, "QuestCheckpoint")
	end)

	-- ✅ Reset la progression quest + cooldown 24h
	playerCheckpoints[userId] = 0
	checkpointQuestCooldowns[userId] = os.time() + CHECKPOINT_QUEST_COOLDOWN

	-- ⚠️ IMPORTANT : On NE reset PAS playerTouchedCheckpoints ni le folder
	-- Pendant le cooldown 24h, le joueur continue à toucher les mêmes checkpoints
	-- pour gagner les points passifs de PointLevel (100pts/checkpoint), mais
	-- la progression de la quest ne bouge pas (bloquée par le check cooldown).
	-- À la fin des 24h, on voudra qu'il recommence à 0/90, donc on reset à ce moment-là.

	-- ✅ Programmer le reset de la progression quand le cooldown 24h expire
	task.delay(CHECKPOINT_QUEST_COOLDOWN, function()
		local pl = Players:GetPlayerByUserId(userId)
		if not pl or not pl.Parent then return end

		-- Vérifier que le cooldown a vraiment expiré (anti race-condition)
		if checkpointQuestCooldowns[userId] and checkpointQuestCooldowns[userId] > os.time() then
			return
		end

		-- Reset la progression de la quête (playerEarnedPointLevels NON effacé : pas de rebirth)
		playerCheckpoints[userId]        = 0
		playerTouchedCheckpoints[userId] = {}
		-- NE PAS effacer playerEarnedPointLevels ici

		local dataFolder = pl:FindFirstChild("CheckpointData")
		if dataFolder then
			dataFolder:ClearAllChildren()
		end

		saveCheckpointQuestData(userId, true)
		updateCheckpointQuestUI(pl, true)

		print(string.format("🔄 CheckpointQuest cooldown 24h expiré → reset progression pour %s", pl.Name))
	end)

	saveCheckpointQuestData(userId, true)
	task.spawn(function()
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		secureSave(userId, totalPoints)
	end)

	-- ✅ FIX: forcer l'update UI (bypass debounce) pour que le client voie le cooldown
	lastUIUpdate[userId] = nil
	updateCheckpointQuestUI(player, true)

	pcall(function()
		buyGamePassEvent:FireClient(player)
	end)

	print(string.format("✅ CHECKPOINT QUEST: %s a complété la quête (%d points)", player.Name, CHECKPOINT_QUEST_REWARD))
end)



resetCheckpointQuestEvent.OnServerEvent:Connect(function(player)
	-- Ce remote ne devrait jamais être appelé par un client normal
	AntiExploit.HandleSuspiciousActivity(player, "CHECKPOINT_RESET_EXPLOIT", "Tentative de reset checkpoint quest via remote direct")
end)




-- ========================================
-- SAUVEGARDE AUTOMATIQUE ÉTALÉE
-- ========================================
-- ✅ OPTIMISÉ: Autosave toutes les 120 secondes au lieu de 60
task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)  -- Garder 120s

		local saveQueue = {}
		for _, player in ipairs(Players:GetPlayers()) do
			-- ✅ Skip si reload en cours
			if recentReloads[player.UserId] then
				print(string.format("⏭️ Autosave skip pour %s (reload en cours)", player.Name))
				continue
			end

			-- ✅ PATCH : Skip si données pas encore chargées
			if dataLoading[player.UserId] then
				print(string.format("⏭️ Autosave skip pour %s (chargement en cours)", player.Name))
				continue
			end

			local data = tempsJoueurs[player.UserId]
			if data and type(data) == "table" and not data.loading then
				local totalPoints = data.base + data.future

				-- ✅ OPTIMISATION: Sauvegarder seulement si changement > 100 points
				if math.abs(totalPoints - data.lastSaved) > 100 then
					table.insert(saveQueue, {userId = player.UserId, points = totalPoints, data = data})
				end
			end
		end

		local playerCount = #saveQueue
		if playerCount > 0 then
			print(string.format("💾 Autosave: %d joueurs", playerCount))

			-- ✅ CRITIQUE: SAUVEGARDES SÉQUENTIELLES avec délai
			for i, saveData in ipairs(saveQueue) do
				local success = secureSave(saveData.userId, saveData.points)
				if success then
					saveData.data.lastSaved = saveData.points
				end

				-- ✅ Délai de 0.3s entre chaque sauvegarde
				if i < playerCount then
					task.wait(1)
				end
			end

		end
	end
end)

-- Worker qui sauvegarde les checkpoints modifiés (évite de saturer le DataStore)
task.spawn(function()
	while true do
		task.wait(CHECKPOINT_SAVE_INTERVAL)

		local toSave = {}
		for userId, _ in pairs(dirtyCheckpointData) do
			table.insert(toSave, userId)
		end

		for _, userId in ipairs(toSave) do
			local player = Players:GetPlayerByUserId(userId)
			if player and player.Parent and not dataLoading[userId] and not recentReloads[userId] then
				saveCheckpointQuestData(userId, false)
				dirtyCheckpointData[userId] = nil
				task.wait(0.5)
			else
				dirtyCheckpointData[userId] = nil
			end
		end
	end
end)

-- DataStore pour les cooldowns de kill
local killCooldownStore = DataStoreService:GetDataStore("KillCooldowns_v2")

-- ✅ Throttle écriture totalKillStore (anti-throttling OrderedDataStore quand grind en cooldown)
local lastTotalKillStoreSave = {}  -- [userId] = os.time() du dernier SetAsync

-- ✅ Throttle save de la progression quest pendant le grind en cooldown points
local lastKillQuestSave = {}  -- [userId] = os.time() du dernier saveKillData quest

-- Remote Event pour UI
local killCountUpdateEvent = getOrCreateRemote("KillCountUpdate")

local killQuestClaimEvent = getOrCreateRemote("KillQuestClaim")

-- ✅ NOUVEAU : remote pour que le client puisse demander son état au load
local requestKillDataEvent = getOrCreateRemote("RequestKillData")

local KILL_QUEST_REQUIRED = 30
local KILL_QUEST_REWARD   = 5000
local KILL_QUEST_COOLDOWN_STORE = DataStoreService:GetDataStore("KillQuestClaimed_v2")
local KILL_QUEST_CLAIM_TOLERANCE = 10

local function updateKillUI(player)
	if not player or not player.Parent then return end
	local userId = player.UserId
	local killCount   = playerKillCount[userId] or 0         -- pour limite 100 kills (cooldown 9h)
	local questKills  = killQuestProgress[userId] or 0       -- pour progression quest
	local now = os.time()
	local maxKills = _G.VIPKills.get(userId)

	-- 👑 lève un cooldown posé pour une limite plus basse (passage VIP)
	if _G.VIPKills.syncCooldown then
		pcall(function() _G.VIPKills.syncCooldown(userId) end)
	end

	-- ⚠️ relire APRÈS syncCooldown : elle a pu remettre le compteur à zéro
	killCount           = playerKillCount[userId] or 0
	local cooldownEnd   = playerKillCooldown[userId] or 0
	local canKill       = (killCount < maxKills) and (now >= cooldownEnd)
	local timeRemaining = math.max(0, cooldownEnd - now)

	-- ✅ Cooldown 24h de la quest (indépendant du cooldown 100 kills)
	local questCooldownEnd = killQuestCooldowns[userId] or 0
	local questOnCooldown = now < questCooldownEnd
	local questCanClaim   = (questKills >= KILL_QUEST_REQUIRED) and (not questOnCooldown)

	-- 👑 attributs lus par la frame Daily_Rewarded_kills côté client
	player:SetAttribute("MaxKills", maxKills)
	player:SetAttribute("KillsUsed", killCount)
	player:SetAttribute("KillCooldownLeft", timeRemaining)   -- 🆕 secondes restantes
	pcall(function()
		killCountUpdateEvent:FireClient(player, questKills, maxKills, canKill, timeRemaining, questCanClaim, questOnCooldown, questCooldownEnd, killCount, maxKills)
	end)
end



requestKillDataEvent.OnServerEvent:Connect(function(player)
	if not player or not player.Parent then return end
	local userId = player.UserId

	-- Anti-spam (1 req / 2s max)
	if not AntiExploit.CheckRemoteCall(player, "RequestKillData") then return end

	-- Si les données sont prêtes, envoyer l'état
	if playerKillCount[userId] ~= nil then
		updateKillUI(player)
	else
		-- Sinon, attendre jusqu'à 5s que le chargement se termine
		task.spawn(function()
			local waited = 0
			while playerKillCount[userId] == nil and waited < 50 do
				task.wait(0.1)
				waited = waited + 1
			end
			if player and player.Parent and playerKillCount[userId] ~= nil then
				updateKillUI(player)
			end
		end)
	end
end)



-- ✅ Charger les données de kill d'un joueur
local function loadKillData(userId)

	killQuestCooldowns[userId] = killQuestCooldowns[userId]  -- laissé tel quel, sera chargé ensuite

	-- ✅ Si reload prévu, attendre que le snapshot soit restauré
	if recentReloads[userId] then
		local waited = 0
		while playerKillCount[userId] == nil and waited < 30 do
			task.wait(0.1)
			waited = waited + 1
		end
	end

	if playerKillCount[userId] ~= nil then
		print(string.format("ℹ️ Kill data déjà restaurée depuis SessionLock pour %d (%d/%d kills), skip",
			userId, playerKillCount[userId], MAX_KILLS))
		-- Charger le flag claim si pas encore chargé
		-- Charger le cooldown 24h si pas encore chargé
		-- ✅ FIX : TOUJOURS lire le store dédié et prendre le MAX avec le
		-- snapshot (un cooldown de claim ne peut jamais reculer)
		do
			local okQ, claimedData = pcall(function()
				return KILL_QUEST_COOLDOWN_STORE:GetAsync("kq_" .. userId)
			end)
			local fromStore = (okQ and type(claimedData) == "number") and claimedData or 0
			killQuestCooldowns[userId] = math.max(killQuestCooldowns[userId] or 0, fromStore)
			print(string.format("📊 KillQuest cooldown (max snapshot/store): fin dans %ds",
				math.max(0, killQuestCooldowns[userId] - os.time())))
		end
		-- 🛡️ FIX 2 : cross-check du cooldown 9h (100 kills) depuis le store dédié.
		-- Ferme la fenêtre stale-unifié : si le secureSave posant le cooldown 9h a échoué
		-- pile au 100e kill, l'unifié montre cooldown=0 → le joueur pourrait re-kill (farm).
		-- On adopte le cooldown du store dédié UNIQUEMENT s'il est encore actif (> now),
		-- donc jamais de faux-blocage d'un joueur légitime.
		do
			local okK, kData = pcall(function()
				return killCooldownStore:GetAsync("kills_" .. userId)
			end)
			if okK and type(kData) == "table" then
				local storeCd = tonumber(kData.cooldownEnd) or 0
				if storeCd > os.time() and storeCd > (playerKillCooldown[userId] or 0) then
					playerKillCooldown[userId] = storeCd
					playerKillCount[userId]    = math.max(playerKillCount[userId] or 0, tonumber(kData.killCount) or 0)
					warn(string.format("🛡️ Cooldown 9h corrigé depuis store dédié pour %d (unifié périmé, anti-farm)", userId))
				end
			end
		end
	else
		local key = "kills_" .. userId

		-- ✅ Retry 2x (suffisant, le failsafe gère les cas extrêmes)
		local loaded = false
		local data = nil
		for attempt = 1, 2 do
			local success, result = pcall(function()
				return killCooldownStore:GetAsync(key)
			end)
			if success then
				data = result
				loaded = true
				break
			end
			warn(string.format("⚠️ loadKillData tentative %d/2 échouée pour UserID %d", attempt, userId))
			task.wait(0.6)
		end

		if not loaded then
			-- ❌ DataStore down : NE PAS setter à 0 (sinon écrase en unified)
			-- Laisser nil → isAllSecondaryLoaded bloque secureSave + giveKillPoints skip aussi
			warn(string.format("🚨 CRITIQUE: loadKillData a échoué après retries pour UserID %d — valeurs laissées nil (saves + kills bloqués)", userId))
			-- Réessayer en arrière-plan dans 30s
			task.spawn(function()
				task.wait(30)
				if Players:GetPlayerByUserId(userId) then
					loadKillData(userId)
					local pl = Players:GetPlayerByUserId(userId)
					if pl then updateKillUI(pl) end
				end
			end)
			return
		end

		if data then
			playerKillCount[userId]    = data.killCount or 0
			playerKillCooldown[userId] = data.cooldownEnd or 0
			killQuestProgress[userId]  = data.questProgress or 0

			-- Charger le flag claim (avec retry léger aussi)
			local claimedData
			for attempt = 1, 2 do
				local okQ, result = pcall(function()
					return KILL_QUEST_COOLDOWN_STORE:GetAsync("kq_" .. userId)
				end)
				if okQ then
					claimedData = result
					break
				end
				task.wait(0.5)
			end

			if claimedData ~= nil then
				if type(claimedData) == "number" then
					killQuestCooldowns[userId] = claimedData
				else
					-- Migration ancien format boolean → repart propre
					killQuestCooldowns[userId] = 0
				end
			else
				killQuestCooldowns[userId] = 0
			end

			local now = os.time()
			-- Si cooldown 9h expiré → reset kills (cooldown 24h de la quest est indépendant)
			if playerKillCooldown[userId] > 0 and now >= playerKillCooldown[userId] then
				playerKillCount[userId]   = 0
				playerKillCooldown[userId] = 0
				print(string.format("✅ Cooldown 100-kills terminé pour UserID %d, compteur reset", userId))
			end

		else
			-- Pas de data = vrai nouveau joueur
			playerKillCount[userId]    = 0
			playerKillCooldown[userId] = 0
			killQuestCooldowns[userId] = 0
			killQuestProgress[userId]  = 0
			print(string.format("ℹ️ Nouveau joueur kill data: UserID %d", userId))
		end
	end

	-- ✅ NOUVEAU : Charger le total lifetime des kills
	-- 🛡️ Lecture ratée → on laisse nil : les kills ne s'ajoutent pas et RIEN n'est écrit,
	--    puis on relit toutes les 30 s. Avant : 0 → le 1er kill écrivait 1 par-dessus le vrai total.
	local function loadTotalKills()
		local okTotal, storedTotal
		for attempt = 1, 3 do
			okTotal, storedTotal = pcall(function()
				return totalKillStore:GetAsync(tostring(userId))
			end)
			if okTotal then break end
			task.wait(0.6 * attempt)
		end
		if not okTotal then
			warn(string.format("🚨 Total kills illisible pour %d — compteur en pause, relecture dans 30 s", userId))
			task.delay(30, function()
				if Players:GetPlayerByUserId(userId) and playerTotalKills[userId] == nil then loadTotalKills() end
			end)
			return
		end
		playerTotalKills[userId] = tonumber(storedTotal) or 0

		local player = Players:GetPlayerByUserId(userId)
		if player then
			player:SetAttribute("TotalKills", playerTotalKills[userId])
		end

		print(string.format("📊 Total kills chargé: UserID %d → %d kills lifetime", userId, playerTotalKills[userId]))
	end
	loadTotalKills()
end
-- ✅ Sauvegarder les données de kill d'un joueur
local function saveKillData(userId)
	task.spawn(function()
		local key = "kills_" .. userId

		local data = {
			killCount = playerKillCount[userId] or 0,
			cooldownEnd = playerKillCooldown[userId] or 0,
			questProgress = killQuestProgress[userId] or 0,
			lastUpdate = os.time()
		}

		local success, err = pcall(function()
			killCooldownStore:SetAsync(key, data)
		end)

		if success then
			print(string.format("💾 Kill data sauvegardée: UserID %d → %d/%d kills | %d/%d quest",
				userId, data.killCount, _G.VIPKills.get(userId), data.questProgress, KILL_QUEST_REQUIRED))
		else
			warn(string.format("❌ Erreur sauvegarde kill data %d: %s", userId, tostring(err)))
		end
	end)
end

-- ========================================
-- 👑 RÉCONCILIATION DU COOLDOWN AVEC LA LIMITE
--
-- Le cooldown 24h est posé quand le compteur atteint la limite EN VIGUEUR À
-- CE MOMENT-LÀ. S'il a été posé à 100 puis que le joueur devient VIP (limite
-- 150), le cooldown n'a plus aucune raison d'exister : il lui reste 50 kills.
--
-- 🔒 Pourquoi c'est sûr :
--   • on ne lève JAMAIS un cooldown tant que killCount >= limite actuelle ;
--   • le joueur ne peut pas faire BAISSER son killCount (serveur uniquement) ;
--   • il ne peut pas faire MONTER sa limite sans que le VIPManager le déclare
--     VIP (gamepass acheté, VIP offert ou cadeau) — décision 100 % serveur ;
--   • perdre le VIP fait redescendre la limite : 130 kills >= 100 → le
--     cooldown est conservé, aucun kill offert.
--   • saveKillData écrit AUSSI le store dédié, sinon le cross-check anti-farm
--     de loadKillData ré-imposerait le vieux cooldown au prochain join.
-- ========================================
function _G.VIPKills.syncCooldown(userId)
	if playerKillCount[userId] == nil or playerKillCooldown[userId] == nil then
		return false   -- données pas chargées : on ne touche à rien
	end

	local now = os.time()
	local cd  = playerKillCooldown[userId] or 0
	local max = _G.VIPKills.get(userId)

	if cd <= 0 then return false end

	-- CAS 1 — le cooldown est ARRIVÉ À TERME : nouveau cycle quotidien.
	-- Sans ça, le compteur reste collé à la limite et le check suivant
	-- repose immédiatement un cooldown de 24 h → le joueur ne peut plus
	-- jamais kill. Le reset n'existait qu'au join et dans un task.delay
	-- qui ne survit pas à une déconnexion ou à un restart de serveur.
	if now >= cd then
		playerKillCount[userId]    = 0
		playerKillCooldown[userId] = 0
		saveKillData(userId)
		print(string.format("🔄 Cycle kills réinitialisé pour %d (cooldown terminé) → 0/%d",
			userId, max))
		return true
	end

	-- CAS 2 — cooldown encore actif MAIS la limite a monté (passage VIP) et
	-- le joueur est repassé SOUS sa limite : le cooldown n'a plus lieu d'être.
	-- 🔒 jamais levé tant que killCount >= limite, et le joueur ne peut ni
	--    baisser son compteur ni monter sa limite sans le VIP (100 % serveur).
	if playerKillCount[userId] < max then
		playerKillCooldown[userId] = 0
		saveKillData(userId)
		print(string.format("👑 Cooldown kills levé pour %d : limite montée à %d (compteur %d)",
			userId, max, playerKillCount[userId]))
		return true
	end

	return false
end

-- ✅ Fonction principale: donner des points pour un kill
local function giveKillPoints(player, points)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local now = os.time()

	-- Vérifier si les données sont chargées
	if playerKillCount[userId] == nil then
		warn(string.format("⚠️ Kill data pas encore chargée pour %s, skip", player.Name))
		return
	end
	if dataLoading[userId] then return end -- 🛡️ points pas encore chargés : rien ne doit changer (sinon perdu au chargement)


	-- ✅ TOTAL LIFETIME : incrémenté AVANT les checks cooldown/limite
	-- → le leaderboard continue de monter même quand le joueur a fini ses 100 kills.
	-- (Les POINTS et la progression quest restent bloqués par le cooldown plus bas.)
	-- Garde sur ~= nil pour ne pas écraser le total pendant le chargement.
	if playerTotalKills[userId] ~= nil then
		playerTotalKills[userId] = playerTotalKills[userId] + 1
		player:SetAttribute("TotalKills", playerTotalKills[userId])
		totalKillsDirty[userId] = true                     -- ✅ FIX FLUSH
		local lastSave = lastTotalKillStoreSave[userId] or 0
		if now - lastSave >= 10 then
			lastTotalKillStoreSave[userId] = now
			totalKillsDirty[userId] = nil                  -- ✅ écrit juste après
			local snap = playerTotalKills[userId]
			task.spawn(function()
				pcall(function()
					totalKillStore:SetAsync(tostring(userId), snap)
				end)
			end)
		end
	end

	-- ✅ PROGRESSION QUEST (25 kills) : avance AVANT les checks cap/cooldown de points
	-- → le joueur peut finir et claim sa quest même après ses 100 kills/jour.
	-- Toujours gardée par le cooldown 24h propre à la quest (inchangé).
	if killQuestProgress[userId] ~= nil then
		local qCooldownEnd = killQuestCooldowns[userId] or 0
		if now >= qCooldownEnd and (killQuestProgress[userId] or 0) < KILL_QUEST_REQUIRED then
			killQuestProgress[userId] = (killQuestProgress[userId] or 0) + 1

			-- Persistance throttlée (la progression va aussi dans le payload unifié).
			-- Save immédiat à l'atteinte de l'objectif pour fiabiliser l'état "claimable".
			local reachedGoal = killQuestProgress[userId] >= KILL_QUEST_REQUIRED
			local lastSave = lastKillQuestSave[userId] or 0
			if reachedGoal or (now - lastSave) >= 8 then
				lastKillQuestSave[userId] = now
				saveKillData(userId)
			end
		end
	end

	-- 👑 le cooldown ne vaut que pour la limite avec laquelle il a été posé
	_G.VIPKills.syncCooldown(userId)

	-- Vérifier cooldown
	if playerKillCooldown[userId] and now < playerKillCooldown[userId] then
		local timeLeft = playerKillCooldown[userId] - now
		print(string.format("⏰ %s est en cooldown kill (%.1fh restantes)", 
			player.Name, timeLeft / 3600))
		updateKillUI(player)
		return
	end


	-- Vérifier limite de kills (100 normal / 150 VIP)
	if playerKillCount[userId] >= _G.VIPKills.get(userId) then
		-- Activer le cooldown
		playerKillCooldown[userId] = now + KILL_COOLDOWN
		saveKillData(userId)
		updateKillUI(player)

		print(string.format("🚫 %s a atteint la limite de %d kills, cooldown de 9h activé", 
			player.Name, MAX_KILLS))
		return
	end

	-- ✅ KILL VALIDE - Donner les points
	local finalPoints = points

	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, finalPoints, "Kill")

	tempsJoueurs[userId].future = tempsJoueurs[userId].future + finalPoints

	-- ✅ Toujours incrémenter le compteur de session (pour limite 100 kills → cooldown 9h)
	playerKillCount[userId] = playerKillCount[userId] + 1

	-- ✅ Progression quest déjà incrémentée en haut de giveKillPoints
	-- (avant les checks cap/cooldown) → pas de double comptage ici.

	-- ✅ Total lifetime déjà incrémenté en haut de giveKillPoints (avant les checks cooldown)
	-- → ne plus l'incrémenter ici pour éviter le double comptage.

	-- Sauvegarder la session (cooldown)
	saveKillData(userId)

	-- Enregistrement anti-cheat
	SmartAntiCheat.RecordGain(player, finalPoints, "Kill")

	-- Mettre à jour l'UI
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value = applyAllBonuses(calculatePoints(totalPoints), player)
		player:SetAttribute("Points", pointsStat.Value)

		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = pointsStat.Value
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end
	end

	task.spawn(function()
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		secureSave(userId, totalPoints)
	end)

	pcall(function()
		bonusEvent:FireClient(player)
	end)

	updateKillUI(player)

	print(string.format("✅ KILL: %s → +%d pts (%d/%d kills session | %d kills total)", 
		player.Name, finalPoints, playerKillCount[userId], MAX_KILLS, playerTotalKills[userId] or 0))

	-- Si on atteint la limite, activer le cooldown
	if playerKillCount[userId] >= _G.VIPKills.get(userId) then
		playerKillCooldown[userId] = now + KILL_COOLDOWN
		saveKillData(userId)

		-- ✅ NOUVEAU : planifier le reset du flag claim quand le cooldown 9h expire
		-- (Sera aussi reset au join via loadKillData si le joueur revient après)
		task.delay(KILL_COOLDOWN, function()
			if playerKillCount[userId] then
				playerKillCount[userId]   = 0
				playerKillCooldown[userId] = 0
				saveKillData(userId)
				local pl = Players:GetPlayerByUserId(userId)
				if pl and pl.Parent then
					updateKillUI(pl)
					print(string.format("🔄 Cycle 100-kills reset automatique pour %s", pl.Name))
				end
			end
		end)

		updateKillUI(player)

		print(string.format("🚫 %s a atteint la limite de %d kills, cooldown de 9h activé", 
			player.Name, MAX_KILLS))
	end
end

local function monitorCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end

	humanoid.Died:Connect(function()
		local tag = humanoid:FindFirstChild("creator")
		if not (tag and tag.Value and tag.Value:IsA("Player")) then return end

		local killer = tag.Value
		local victim = Players:GetPlayerFromCharacter(character)

		-- 🛡️ Un joueur ne se paie pas ses propres morts.
		if victim and killer.UserId == victim.UserId then
			warn(string.format("🚫 [KILL] Auto-kill ignoré pour %s", killer.Name))
			return
		end

		giveKillPoints(killer, KILL_POINTS)
	end)
end

-- ========================================
-- POINT LEVELS AVEC DEBOUNCE GLOBAL
-- ========================================

local function awardPointLevel(player, part)
	if not player or not player.Parent then return end
	local userId = player.UserId

	-- Bloquer si les données ne sont pas encore chargées
	if playerEarnedPointLevels[userId] == nil or dataLoading[userId] then return end -- 🛡️ points pas encore chargés : rien ne doit changer (sinon perdu au chargement)

	local rebirthCount = playerRebirthCount[userId] or 0
	local partUID = getOrCreateCheckpointUID(part, rebirthCount)
	local now = os.time()

	-- Anti-spam global 0.5s par joueur
	if pointLevelGlobalDebounce[userId] and now - pointLevelGlobalDebounce[userId] < 0.5 then
		return
	end
	pointLevelGlobalDebounce[userId] = now

	-- Cooldown 20 min par checkpoint (mémoire volatile)
	local key = tostring(userId) .. "_" .. tostring(partUID)
	if lastPointLevelTouch[key] and now - lastPointLevelTouch[key] < POINT_LEVEL_COOLDOWN then
		return
	end

	-- Défense 1 : playerEarnedPointLevels (persistant, reset UNIQUEMENT sur rebirth)
	if playerEarnedPointLevels[userId][partUID] then
		local df = player:FindFirstChild("CheckpointData")
		if df then
			local ck = "checkpoint_" .. tostring(partUID)
			if not df:FindFirstChild(ck) then
				local m = Instance.new("BoolValue")
				m.Name = ck ; m.Value = true ; m.Parent = df
			end
		end
		return
	end

	-- Défense 2 : CheckpointData folder (protection intra-session)
	local dataFolder = player:FindFirstChild("CheckpointData")
	if dataFolder then
		local countKey = "checkpoint_" .. tostring(partUID)
		if dataFolder:FindFirstChild(countKey) then
			playerEarnedPointLevels[userId][partUID] = true  -- resync persistant
			markCheckpointDirty(userId)
			return
		end
	end

	-- Premier touch valide dans ce cycle rebirth
	lastPointLevelTouch[key] = now

	-- Marquer le folder immédiatement (défense intra-session)
	if not dataFolder then
		dataFolder = Instance.new("Folder")
		dataFolder.Name = "CheckpointData" ; dataFolder.Parent = player
	end
	local countKey = "checkpoint_" .. tostring(partUID)
	if not dataFolder:FindFirstChild(countKey) then
		local marker = Instance.new("BoolValue")
		marker.Name = countKey ; marker.Value = true ; marker.Parent = dataFolder
	end

	-- Marquer dans la table persistante (survit aux reloads et resets 24h)
	playerEarnedPointLevels[userId][partUID] = true

	-- 🏃 NoDeathRun : on ne prévient la quête QUE ici, c'est-à-dire seulement
	-- quand les 100 pts sont réellement accordés. Un checkpoint déjà encaissé
	-- sort plus haut par un return → il ne compte pas pour la quête.
	if _G.NoDeathQuest_OnPointLevel then
		_G.NoDeathQuest_OnPointLevel(player, partUID)
	end

	-- Donner les points
	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, POINT_LEVEL_AMOUNT, "PointLevel")
	tempsJoueurs[userId].future = tempsJoueurs[userId].future + POINT_LEVEL_AMOUNT

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, POINT_LEVEL_AMOUNT, "PointLevel")
	end)

	-- Sauvegarder earnedPointLevels en DataStore (debounced)
	markCheckpointDirty(userId)

	-- ✅ Mise à jour directe du leaderstat (plus de queue)
	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local totalPoints = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		if type(totalPoints) == "number" and totalPoints == totalPoints then
			local finalValue = applyAllBonuses(calculatePoints(totalPoints), player)
			if type(finalValue) == "number" and finalValue == finalValue then
				pointsStat.Value = finalValue
				player:SetAttribute("Points", pointsStat.Value)
			end
		end
	end

	pcall(function() bonusEvent:FireClient(player) end)
end


local function connectPointLevel(part)
	if connectedPointLevels[part] then return end
	connectedPointLevels[part] = true

	if not part:GetAttribute("CheckpointUID") then
		local pos = part.Position
		local uid = string.format("%s_%d_%d_%d", 
			part.Name,
			math.floor(pos.X),
			math.floor(pos.Y),
			math.floor(pos.Z)
		)
		part:SetAttribute("CheckpointUID", uid)
	end

	part.Touched:Connect(function(hit)
		local pl = Players:GetPlayerFromCharacter(hit.Parent)
		if pl then
			awardPointLevel(pl, part)
			addCheckpointToQuest(pl, part)
		end
	end)
end

-- ========================================
-- ✅ COMPTAGE PASSIF — pcall par joueur + skip strict pendant reload
-- ========================================
task.spawn(function()
	while true do
		task.wait(1)
		local allPlayers = Players:GetPlayers()
		for _, player in ipairs(allPlayers) do
			pcall(function()
				if not (player and player.Parent) then return end
				local userId = player.UserId

				-- ✅ FIX BUG RELOAD : Skip immédiat si reload AFK en cours
				if recentReloads[userId] then return end

				-- ✅ Multi-appareil : EXIGER une session active pour ce player
				local activeSession = activeConnections[userId]
				if not activeSession or activeSession.player ~= player then
					return  -- Pas de session OU pas la bonne session
				end

				if dataLoading[userId] then return end

				-- ✅ FIX BUG RELOAD : Skip si tempsJoueurs n'existe pas
				-- (au lieu de le recréer par erreur)
				local playerData = tempsJoueurs[userId]
				if not playerData or type(playerData) ~= "table" then return end

				if not tempsJoueurs[userId .. "_pause"] and not playerData.loading then
					local basePoints = 1
					local friendBonus = 0   -- 🚫 amis : aucun boost
					local gamePassMult = getHighestGamePassMultiplier(player)
					local boostSum = (_G.TempBoosts and _G.TempBoosts.getMultiplier(userId)) or 0

					-- ✅ FIX BOOST : le boost REMPLACE le "1" de base au lieu de s'y additionner.
					--   x5 seul   → 5 pts/s   (avant : 1 + 5  = 6)
					--   x5 + x10  → 15 pts/s  (avant : 1 + 15 = 16)
					-- On ne retire le "1" de base QUE s'il n'y a pas de gamepass
					-- (gamePassMult contient déjà ce 1). Gamepass + amis s'ajoutent au boost.
					-- ⚠️ Logique IDENTIQUE à SmartAntiCheat.CalculateMaxGain/AnalyzePlayer → 0 faux ban.
					-- 🆕 Bonus de statut : +10% si dans le groupe, +10% si Premium (additif)
					local statusBonus = _G.ACOptim.getStatusBonus(player)
					local totalMult
					if boostSum > 0 then
						local gpPart = (gamePassMult == 1) and 0 or gamePassMult
						totalMult = gpPart + friendBonus + boostSum + statusBonus
					else
						totalMult = gamePassMult + friendBonus + statusBonus
					end
					if totalMult < 1 then totalMult = 1 end

					local finalPoints = basePoints * totalMult
					-- ✅ Expose le vrai multiplicateur au billboard
					-- 🌐 OPTIM RÉSEAU : cet attribut est répliqué à TOUS les
					--    clients du serveur. Il ne change que si un boost, un
					--    gamepass, le VIP ou le statut change — donc l'écrire
					--    chaque seconde envoyait un paquet pour rien.
					--    ⚠️ Zéro différence fonctionnelle : le billboard lit
					--       l'attribut, et l'attribut garde la même valeur.
					if player:GetAttribute("PointsMultiplier") ~= finalPoints then
						player:SetAttribute("PointsMultiplier", finalPoints)
					end
					addFuturePoints(player, finalPoints)
					if _G.EconStats then _G.EconStats.AddPassive(userId, finalPoints, gamePassMult, boostSum, statusBonus) end
				end
			end)
		end
	end
end)

-- ========================================
-- JOUEUR REJOINT - CHARGEMENT ÉTALÉ
-- ========================================
Players.PlayerAdded:Connect(function(player)
	print("🎮 JOUEUR REJOINT:", player.Name, "UserID:", player.UserId)

	local userId = player.UserId
	local now = os.time()

	-- ✅ FIX 12 : Étendre la fenêtre à 120s (aligné avec recentReloads cleanup et isPlannedReloadEarly)
	-- Couvre les téléports lents (jusqu'à 2 min) sans classer un reload légitime comme join normal
	-- (sinon : reload >30s → isPlannedReload=false → secureLoad lit unified, ce qui marche
	--  grâce à FIX 11, mais FIX 12 garde le path reload propre = utilise le SessionLock directement)
	local isPlannedReload = false
	if recentReloads[userId] and (now - recentReloads[userId]) < 120 then
		isPlannedReload = true
		-- Ne pas nettoyer recentReloads ici, PlayerRemoving peut en avoir besoin
		print(string.format("✅ RELOAD PROPRE détecté pour %s (%ds, fenêtre 120s)", 
			player.Name, now - recentReloads[userId]))
	end

	-- ✅ Si c'est un reload prévu, NE PAS bloquer la sauvegarde
	if not isPlannedReload then
		disconnectProtection[userId] = {
			blockUntil = now + 10,
			newSessionId = HttpService:GenerateGUID(false)
		}
		print(string.format("🛡️ Protection multi-appareil ACTIVÉE pour %s", player.Name))
	else
		print(string.format("⚠️ Protection multi-appareil DÉSACTIVÉE pour %s (reload prévu)", player.Name))
	end

	activeConnections[userId] = {
		player = player,
		sessionId = HttpService:GenerateGUID(false),
		joinTime = now,
		isPlannedReload = isPlannedReload
	}

	-- ✅ NOUVEAU : Lire le SessionLock pour détecter une reconnexion rapide
	-- Si un lock récent existe (< 15s), c'est une reconnexion multi-appareil
	task.spawn(function()
		if not isPlannedReload then
			local lockData = readSessionLock(userId)
			if lockData and (os.time() - (lockData.timestamp or 0)) < 15 then
				-- Lock très récent = l'autre appareil vient juste de quitter
				-- On va utiliser ses points directement
				print(string.format("🔄 SessionLock récent détecté pour %s (%ds) → utilisation des points du lock", 
					player.Name, os.time() - lockData.timestamp))
				-- Le secureLoad normal prendra la valeur du DataStore qui est correcte
				-- Le lock sera lu dans la section de chargement des points
			end
		end
	end)

	if not AntiExploit.CheckBanOnJoin(player) then
		disconnectProtection[userId] = nil
		activeConnections[userId] = nil
		return
	end

	AntiExploit.InitPlayer(player.UserId)
	SmartAntiCheat.InitPlayer(player.UserId)

	task.spawn(function()
		-- ✅ ÉTAPE 1: ATTENDRE que le leaderstats existe
		local maxWait = 50
		local waited = 0
		while not player:FindFirstChild("leaderstats") and waited < maxWait do
			task.wait(0.1)
			waited = waited + 1
		end

		if not player or not player.Parent then return end

		local leaderstats = player:FindFirstChild("leaderstats")
		if not leaderstats then
			warn("❌ Leaderstats introuvable pour", player.Name)
			return
		end

		-- ✅ ÉTAPE 2: ATTENDRE que Stage soit créé par le script checkpoint
		-- Le script checkpoint attend 5 secondes max, donc on attend 6 secondes max
		waited = 0
		maxWait = 60 -- 6 secondes
		while not leaderstats:FindFirstChild("Stage") and waited < maxWait do
			task.wait(0.1)
			waited = waited + 1
		end

		-- Vérifier que le joueur est toujours là
		if not player or not player.Parent then return end

		-- ✅ NOUVEAU : Attendre que secureLoad ait fini (il peut déjà avoir setté playerRebirthCount)
		-- 🛡️ sans limite de 10 s : si le chargement prend plus longtemps (nouveaux essais après
		--    une panne DataStore), on attend le VRAI nombre de rebirths au lieu d'afficher 0.
		local waited = 0
		while dataLoading[userId] and player.Parent do
			task.wait(0.1)
			waited = waited + 1
		end
		if not player.Parent then return end

		local rebirthCount = 0

		-- Si secureLoad a déjà chargé le rebirth count depuis le store unifié, on prend ça
		if type(playerRebirthCount[userId]) == "number" then
			rebirthCount = playerRebirthCount[userId]
			print(string.format("✅ Rebirth depuis unifié/legacy: %s → %d", player.Name, rebirthCount))
		else
			-- Fallback : lire l'ancien store (cas où secureLoad n'a rien trouvé)
			local success, count = pcall(function()
				return rebirthCountStore:GetAsync("rebirth_" .. userId)
			end)

			if success and count then
				rebirthCount = count
				playerRebirthCount[userId] = count
				print(string.format("🔄 Rebirth count legacy: %s → %d", player.Name, count))
			else
				playerRebirthCount[userId] = 0
				print(string.format("ℹ️ Nouveau joueur rebirth: %s → 0", player.Name))
			end
		end

		-- ✅ ÉTAPE 4: CRÉER Rebirths APRÈS Stage
		local rebirthStat = Instance.new("IntValue")
		rebirthStat.Name = "Rebirths"
		rebirthStat.Value = rebirthCount
		rebirthStat.Parent = leaderstats

		player:SetAttribute("RebirthCount", rebirthCount)

		print(string.format("✅ Rebirth leaderboard créé (position 3): %s → %d rebirths", player.Name, rebirthCount))
	end)


	local isPlannedReloadEarly = recentReloads[userId] ~= nil
		and (os.time() - recentReloads[userId]) < 120

	if not isPlannedReloadEarly then
		loadWarnings(player.UserId)
	end

	-- Toujours charger les cooldowns quêtes, même pour un reload
	task.spawn(function()
		loadAllQuestCooldowns(userId)
	end)
	task.wait(0.5)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local pointsStat = Instance.new("IntValue")
	pointsStat.Name = "Points"
	pointsStat.Value = 0
	pointsStat.Parent = leaderstats

	tempsJoueurs[player.UserId] = {base = 0, future = 0, lastSaved = 0}

	-- ✅ PATCH : Bloquer compteur passif + autosave + secureSave pendant le chargement
	dataLoading[userId] = true
	print(string.format("🔒 Chargement en cours pour %s, compteur passif bloqué", player.Name))

	task.spawn(function()
		-- ✅ Étalement plus agressif : 1.2s/joueur, max 12s
		-- Évite que 5+ joueurs déclenchent leurs GetAsync en même temps
		local joinDelay = math.min((#Players:GetPlayers() - 1) * 1.2, 12)
		if joinDelay > 0 then
			task.wait(joinDelay)
		end
		task.wait(0.5)

		print("🔍 CHARGEMENT DONNÉES pour", player.Name, "UserID:", player.UserId)

		local totalSeconds = 0

		if isPlannedReload then
			print(string.format("🔒 Reload prévu — lecture SessionLock pour %s", player.Name))
			local lockData = readSessionLock(userId)

			if lockData then
				totalSeconds = lockData.points
				print(string.format("✅ SessionLock lu: %d pts pour %s", totalSeconds, player.Name))

				local snap = lockData.questSnapshot
				if snap then
					do
						local waited = 0
						while type(_G.tryRestoreP2FromSnapshot) ~= "function" and waited < 30 do
							task.wait(0.1)
							waited = waited + 1
						end
						if type(_G.tryRestoreP2FromSnapshot) == "function" then
							_G.tryRestoreP2FromSnapshot(player, snap)
						else
							warn(string.format("⚠️ tryRestoreP2FromSnapshot jamais disponible pour %s, totalSpent non restauré", player.Name))
						end
					end
					-- ✨ Boosts temporaires
					if type(_G.tryRestoreBoostsFromSnapshot) == "function" then
						_G.tryRestoreBoostsFromSnapshot(player, snap)
					end
					playerCheckpoints[userId]        = snap.checkpoints or 0
					checkpointQuestCooldowns[userId] = snap.cooldownEnd or 0
					playerTouchedCheckpoints[userId] = snap.touchedUIDs or {}
					playerEarnedPointLevels[userId]  = snap.earnedPointLevels or {}
					playerKillCount[userId]          = snap.killCount or 0
					playerKillCooldown[userId]       = snap.killCooldown or 0
					killQuestCooldowns[userId]       = snap.killQuestCooldowns or 0
					killQuestProgress[userId]        = snap.killQuestProgress or 0

					-- ✅ FIX : Reset cooldowns expirés (même logique que secureLoad)
					-- Cas réel : reload qui prend 90s + cooldown 9h qui expire pendant les 90s
					local nowReload = os.time()
					if playerKillCooldown[userId] > 0 and nowReload >= playerKillCooldown[userId] then
						playerKillCount[userId]    = 0
						playerKillCooldown[userId] = 0
						print(string.format("✅ Cooldown 100-kills expiré pendant reload pour %d", userId))
					end
					if (checkpointQuestCooldowns[userId] or 0) > 0 and nowReload >= checkpointQuestCooldowns[userId] then
						playerCheckpoints[userId]        = 0
						checkpointQuestCooldowns[userId] = 0
						playerTouchedCheckpoints[userId] = {}
						-- NE PAS reset playerEarnedPointLevels (reset uniquement au rebirth)
						print(string.format("✅ CheckpointQuest cooldown 24h expiré pendant reload pour %d", userId))
					end

					-- ✅ FIX ANTI-RE-REDEEM : restaurer redeemedCodes depuis le snapshot
					if type(snap.redeemedCodes) == "table" then
						playerRedeemedCodes[userId] = snap.redeemedCodes
						print(string.format("✅ redeemedCodes restaurés depuis snapshot pour %s", player.Name))
					end

					-- ⚙️ Restaurer paramètres depuis snapshot
					if type(snap.settings) == "table" then
						Settings.data[userId] = snap.settings
					end

					-- ⏱️ Restaurer playtime depuis snapshot reload
					-- ⏱️ jamais « or 0 » : un snapshot sans playtime le remettait à zéro
					playerPlaytime[userId] = tonumber(snap.playtimeSeconds)
						or tonumber(lockData.playtimeSeconds) or playerPlaytime[userId]


					-- ✅ FIX FIABILITÉ : restaurer aussi rebirths, allowedRebirth, et cooldowns quêtes
					if type(snap.rebirthCount) == "number" then
						playerRebirthCount[userId] = snap.rebirthCount
						print(string.format("✅ rebirthCount restauré depuis snapshot : %d pour %s", snap.rebirthCount, player.Name))
					end
					if snap.allowedRebirth ~= nil then
						allowedRebirth[userId] = snap.allowedRebirth == true
					end
					if type(snap.questHistory) == "table" then
						mergeQuestHistory(userId, snap.questHistory)
						questCooldownsLoaded[userId] = questCooldownsLoaded[userId] or true
						print(string.format("✅ questHistory mergé depuis snapshot pour %s", player.Name))
					end

					-- ✅ RESTAURATION DES WARNINGS
					if snap.antiExploitInfractions and snap.antiExploitInfractions > 0 then
						AntiExploit.infractions[userId] = snap.antiExploitInfractions
						print(string.format("✅ Infractions AntiExploit restaurées: %d", snap.antiExploitInfractions))
					end

					if snap.smartAntiCheatInfractions then
						local smartData = SmartAntiCheat.playerData[userId]
						if not smartData then
							SmartAntiCheat.InitPlayer(userId)
							smartData = SmartAntiCheat.playerData[userId]
						end
						if smartData then
							smartData.infractions = {
								suspiciousCount   = snap.smartAntiCheatInfractions.suspiciousCount or 0,
								dangerousCount    = snap.smartAntiCheatInfractions.dangerousCount or 0,
								totalInfractions  = snap.smartAntiCheatInfractions.totalInfractions or 0,
								burstCount        = snap.smartAntiCheatInfractions.burstCount or 0,
								lastInfractionTime = snap.smartAntiCheatInfractions.lastInfractionTime or 0,
							}
							print(string.format("✅ Infractions SmartAntiCheat restaurées: %d total",
								snap.smartAntiCheatInfractions.totalInfractions or 0))
						end
					end

					print(string.format("✅ Quêtes restaurées depuis SessionLock: %d checkpoints | %d/%d kills",
						snap.checkpoints or 0, snap.killCount or 0, MAX_KILLS))
				end

				releaseSessionLock(userId)
			else
				warn(string.format("⚠️ Pas de SessionLock pour %s, fallback DataStore (attente 1s)", player.Name))
				task.wait(1)
				totalSeconds = secureLoad(userId)
			end
		else
			totalSeconds = secureLoad(userId)
		end

		-- 🛡️ secureLoad a retourné nil = DataStore en panne (fréquent juste après un reset de serveur).
		--    Avant : kick immédiat. Maintenant : NOUVEL ESSAI toutes les 15 s pendant ~5 min.
		--    • dataLoading RESTE actif → aucune sauvegarde possible (secureSave, autosave, départ,
		--      fermeture du serveur et reload la refusent) et aucun gain de points.
		--    • l'attribut "Points" n'est pas encore posé → le billboard affiche « Loading... ».
		--    Kick seulement en dernier recours, comme avant.
		if totalSeconds == nil then
			warn(string.format("🚨 Chargement impossible pour %s → nouvel essai toutes les 15 s (pas de kick)", player.Name))
			local RETRY_EVERY, MAX_TRIES = 15, 20   -- 20 essais × 15 s ≈ 5 min
			local tries = 0
			while totalSeconds == nil and player.Parent and tries < MAX_TRIES do
				tries += 1
				local waited = 0
				while waited < RETRY_EVERY and player.Parent do
					task.wait(1)
					waited += 1
				end
				if not player.Parent then break end
				totalSeconds = secureLoad(userId)
			end

			if totalSeconds == nil then
				-- ≈ 5 min sans DataStore, ou joueur parti : même nettoyage qu'avant
				warn(string.format("🚨 Chargement toujours impossible pour %s après %d essais", player.Name, tries))
				local current = Players:GetPlayerByUserId(userId)
				if current == nil or current == player then  -- pas une nouvelle session de ce joueur
					dataLoading[userId] = nil
					tempsJoueurs[userId] = nil  -- éviter que PlayerRemoving sauvegarde {base=0}
					activeConnections[userId] = nil
				end
				if player.Parent then
					player:Kick("⚠️ Server data temporarily unavailable. Please reconnect in 30 seconds. Your progress is safe.")
				end
				return
			end
			print(string.format("✅ Données de %s chargées après %d nouvel(s) essai(s)", player.Name, tries))
		end

		print("✅ DONNÉES CHARGÉES:", totalSeconds, "secondes pour", player.Name)
		if player.Parent then
			-- ✅ PATCH : future=0 garanti car le compteur était bloqué
			tempsJoueurs[player.UserId] = {base = totalSeconds, future = 0, lastSaved = totalSeconds}
			LossGuard.setLastSaved(player.UserId, totalSeconds)  -- ✅ Init référence anti-perte
			local finalPoints = applyAllBonuses(calculatePoints(totalSeconds), player)
			_G.suppressPointsAnim(player, finalPoints)  -- 🆕 pas d'animation au chargement des points
			pointsStat.Value = finalPoints
			player:SetAttribute("Points", pointsStat.Value)

			-- ✅ FIX MULTI-APPAREIL : Stocker les points chargés comme attribut de protection
			player:SetAttribute("LoadedBasePoints", totalSeconds)
			player:SetAttribute("LoadedAt", os.time())

			print("💾 POINTS APPLIQUÉS:", finalPoints, "pour", player.Name)

			local data = SmartAntiCheat.playerData[player.UserId]
			if data then
				data.lastKnownPoints = finalPoints
				data.lastCheckTime = os.time()
				data.dataLoaded = true
				data.initialPoints = finalPoints
				print(string.format("🧠 Anti-Cheat initialisé: %s | Points de départ: %d", player.Name, finalPoints))
			end

			-- ✅ PATCH : Débloquer seulement après assignation complète de base
			dataLoading[userId] = nil
			print(string.format("🔓 Chargement terminé pour %s, compteur passif activé", player.Name))

			-- ⚙️ Réappliquer les paramètres (défaut si jamais nil = nouveau/legacy)
			if Settings.data[userId] == nil then
				Settings.data[userId] = Settings.default()
			end
			Settings.apply(player)
			player:SetAttribute("SettingsLoaded", true)  -- ⚙️ le client peut envoyer ses réglages

			-- ⏱️ Démarrer le compteur de playtime APRÈS chargement complet
			playerSessionStart[userId] = os.time()
			player:SetAttribute("PlaytimeSeconds", playerPlaytime[userId] or 0)
			print(string.format("⏱️ Playtime initialisé pour %s : %d sec lifetime", 
				player.Name, playerPlaytime[userId] or 0))

			if type(_G.setP2Baseline) == "function" then
				_G.setP2Baseline(player, totalSeconds)
			end

			task.wait(0.5)
			pcall(function()
				dataLoadedEvent:FireClient(player)
			end)
		else
			-- Joueur parti avant fin du chargement, nettoyer le flag
			dataLoading[userId] = nil
		end
	end)

	task.spawn(function()
		task.wait(1)
		-- 🛡️ FIX FARM : attendre que secureLoad ait fini AVANT loadKillData.
		-- Sinon (multi-joueurs → joinDelay élevé) loadKillData charge les kills depuis les
		-- stores dédiés, PUIS secureLoad écrase avec l'unifié. Si l'unifié est en retard, le
		-- cooldown 24h de la KillQuest (ou des 100 kills) est downgradé → re-claim = farm.
		-- En attendant dataLoading=nil, playerKillCount est déjà set par secureLoad → loadKillData
		-- prend la branche "skip" (merge-max avec le store kq_) au lieu de tout recharger/écraser.
		local waitedForLoad = 0
		-- 🛡️ sans limite de 10 s : même raison (l'ordre unifié → stores dédiés doit être respecté)
		while dataLoading[userId] and player.Parent do
			task.wait(0.1)
			waitedForLoad = waitedForLoad + 1
		end
		if not player.Parent then return end
		loadKillData(player.UserId)
		task.wait(0.5)  -- ✅ AJOUT : laisser le temps au DataStore de répondre
		-- ✅ FIX CRITIQUE : Envoyer l'état initial au client SINON le bouton reste "In Progress"
		if player.Parent then
			updateKillUI(player)
		end

		-- ✅ Si c'est un reload, playerCheckpoints a déjà été assigné par le SessionLock
		-- dans le task.spawn de chargement des points → ne pas écraser
		loadCheckpointQuestData(player.UserId)
		rebuildCheckpointFolder(player)

		if player.Parent then
			local dataFolder = player:FindFirstChild("CheckpointData")
			if not dataFolder then
				dataFolder = Instance.new("Folder")

				dataFolder.Name = "CheckpointData"
				dataFolder.Parent = player
			end

			local userId = player.UserId
			local checkpoints = playerCheckpoints[userId] or 0
			local canClaim = canClaimCheckpointQuest(userId)
			local cooldownEnd = checkpointQuestCooldowns[userId] or 0

			lastUIUpdate[userId] = nil

			print(string.format("📤 ENVOI UI checkpoint au join: %d checkpoints | canClaim=%s", 
				checkpoints, tostring(canClaim)))

			pcall(function()
				checkpointQuestUpdateEvent:FireClient(player, checkpoints, canClaim, cooldownEnd)
			end)

			task.wait(3)
			if player.Parent then
				local checkpoints2 = playerCheckpoints[userId] or 0
				local canClaim2 = canClaimCheckpointQuest(userId)
				local cooldownEnd2 = checkpointQuestCooldowns[userId] or 0
				lastUIUpdate[userId] = nil
				print(string.format("📤 ENVOI UI checkpoint (2e tentative): %d checkpoints", checkpoints2))
				pcall(function()
					checkpointQuestUpdateEvent:FireClient(player, checkpoints2, canClaim2, cooldownEnd2)
				end)
			end

			task.wait(0.1)
			pcall(function()
				questsLoadedEvent:FireClient(player)
			end)
		end
	end)

	task.spawn(function()
		local maxWait = 50
		local waited = 0
		while playerRebirthCount[userId] == nil and waited < maxWait do
			task.wait(0.1)
			waited = waited + 1
		end

		waited = 0
		while playerCheckpoints[userId] == nil and waited < 50 do
			task.wait(0.1)
			waited = waited + 1
		end

		print(string.format("📊 Quest checkpoints chargés pour %s: %d", 
			player.Name, playerCheckpoints[userId] or 0))

		if not player.Parent then return end

		local character = player.Character or player.CharacterAdded:Wait()
		if not character then return end

		task.wait(2)
		if not player.Parent then return end

		local currentCheckpoint = detectPlayerCheckpoint(player)

		if currentCheckpoint then
			playerCurrentCheckpoint[player.UserId] = currentCheckpoint.yPos
			print(string.format("📍 Position détectée pour %s: Y=%.1f | Quest: %d checkpoints", 
				player.Name, currentCheckpoint.yPos, playerCheckpoints[userId] or 0))
		else
			print(string.format("ℹ️ Aucun checkpoint détecté pour %s", player.Name))
		end

		-- ✅ ICI - après markLowerCheckpointsAsCollected
		lastUIUpdate[player.UserId] = nil
		local checkpoints = playerCheckpoints[player.UserId] or 0
		local canClaim = canClaimCheckpointQuest(player.UserId)
		local cooldownEnd = checkpointQuestCooldowns[player.UserId] or 0
		print(string.format("📤 ENVOI UI après détection checkpoint: %d checkpoints", checkpoints))
		pcall(function()
			checkpointQuestUpdateEvent:FireClient(player, checkpoints, canClaim, cooldownEnd)
		end)
	end)

	task.spawn(function()
		task.wait(2)

		if player.Parent then
			local friendCount = countFriendsInGame(player)
			friendCountCache[player.UserId] = friendCount

			player:SetAttribute("FriendCount", friendCount)

			updateFriendUI(player)

			task.wait(0.2)
			pcall(function()
				friendsLoadedEvent:FireClient(player)
			end)

			task.wait(3)
			if player.Parent then
				refreshAllFriendsBatched()
			end
		end
	end)

	task.spawn(function()
		task.wait(4)

		if not player.Parent then return end

		-- Skip si déjà chargé par secureLoad (voie unified)
		if allowedRebirth[player.UserId] ~= nil then return end

		-- ✅ FIX MIGRATION : Retry 3x avant d'abandonner
		local success, hasRight
		for attempt = 1, 3 do
			success, hasRight = pcall(function()
				return rebirthRightStore:GetAsync(player.UserId)
			end)
			if success then break end
			warn(string.format("⚠️ rebirthRightStore tentative %d/3 échouée pour %d", attempt, player.UserId))
			task.wait(0.6 * attempt)
		end

		if success then
			allowedRebirth[player.UserId] = (hasRight == true)
		else
			-- ❌ DataStore down après 3 retries : NE PAS setter à false (sinon perte du droit en unified)
			warn(string.format("🚨 CRITIQUE: rebirthRightStore inaccessible pour %d — valeur laissée nil (saves bloqués jusqu'à recovery)", player.UserId))
			-- ✅ FIX : Retry persistant (10 tentatives sur 5 minutes au lieu de 1 seule)
			-- Sinon saves bloqués TOUTE la session = perte de progression à la déconnexion
			task.spawn(function()
				local attempts = 0
				while attempts < 10 do
					task.wait(30)
					attempts = attempts + 1

					-- Joueur parti : abandonner
					if not Players:GetPlayerByUserId(player.UserId) then return end
					-- Déjà chargé par un autre path (secureLoad unified par ex) : abandonner
					if allowedRebirth[player.UserId] ~= nil then return end

					local ok, val = pcall(function() return rebirthRightStore:GetAsync(player.UserId) end)
					if ok then
						allowedRebirth[player.UserId] = (val == true)
						print(string.format("✅ allowedRebirth recovery réussi pour %d après %d tentatives : %s",
							player.UserId, attempts, tostring(val == true)))
						return
					end
				end
				warn(string.format("🚨 allowedRebirth abandonné pour %d après 10 retries (5 min)", player.UserId))
			end)
		end
	end)

	task.spawn(function()
		task.wait(6)

		if player.Parent then
			getHighestGamePassMultiplier(player)
		end
	end)

	if player.Character then 
		task.spawn(function() 
			monitorCharacter(player.Character)
			if AntiExploit.playerTracking[player.UserId] then
				AntiExploit.playerTracking[player.UserId].spawnTime = os.time()
			end
		end)
	end

	player.CharacterAdded:Connect(function(char)
		task.spawn(function() 
			monitorCharacter(char) 
		end)

		task.spawn(function()
			if AntiExploit.playerTracking[player.UserId] then
				AntiExploit.playerTracking[player.UserId].spawnTime = os.time()
				print("🛡️ Période de grâce réinitialisée pour", player.Name)
			end
		end)

		task.spawn(function()
			task.wait(2)
			if player.Parent then
				updateFriendUI(player)
			end
		end)

		task.spawn(function()
			task.wait(3)

			if not player.Parent then return end

			local isRebirth = player:GetAttribute("JustRebirthed")

			if isRebirth then
				player:SetAttribute("JustRebirthed", nil)
				print(string.format("🔄 Rebirth détecté pour %s, skip marquage", player.Name))
				return
			end

			local currentCheckpoint = detectPlayerCheckpoint(player)

			if currentCheckpoint then
				local previousY = playerCurrentCheckpoint[player.UserId] or 0

				if currentCheckpoint.yPos > previousY then
					print(string.format("📍 Nouveau checkpoint détecté pour %s: Y=%.1f (ancien: %.1f)", 
						player.Name, currentCheckpoint.yPos, previousY))
					playerCurrentCheckpoint[player.UserId] = currentCheckpoint.yPos
				end
			end
		end)
	end)
end)

-- ========================================
-- JOUEUR QUITTE (VERSION AVEC RELOAD PRÉVU)
-- ========================================
Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId
	local now = os.time()

	print("👋 JOUEUR QUITTE:", player.Name)

	-- ═══════════════════════════════════
	-- CAS 0 : NOUVEAU — Détecter reconnexion multi-appareil
	-- Si un PlayerAdded pour ce même userId est arrivé très récemment
	-- (dans les 8 secondes), c'est une reconnexion — NE PAS sauvegarder
	-- ═══════════════════════════════════
	local currentSession = activeConnections[userId]
	if currentSession and currentSession.player ~= player then
		warn(string.format("🛡️ RECONNEXION MULTI-APPAREIL détectée pour %s — PlayerRemoving ignoré pour sauvegarde", player.Name))
		-- ⚠️ NE PAS mettre tempsJoueurs[userId] = nil ici !
		-- La nouvelle session est peut-être déjà en train de charger dans cette table.
		-- On ne touche à rien, on laisse la nouvelle session gérer ses données.
		return
	end

	-- ═══════════════════════════════════
	-- CAS 1 : Reload propre déjà géré par notifyReloadEvent
	-- tempsJoueurs[userId] == nil signifie que le cleanup a déjà été fait
	-- ═══════════════════════════════════
	if tempsJoueurs[userId] == nil then
		print(string.format("✅ %s : cleanup déjà effectué (reload AFK), PlayerRemoving ignoré", 
			player.Name))

		-- Nettoyage recentReloads
		if recentReloads[userId] then
			recentReloads[userId] = nil
		end

		-- Refresh amis pour les joueurs restants
		task.delay(3, function()
			if #Players:GetPlayers() > 0 then
				refreshAllFriendsBatched()
			end
		end)
		return
	end

	-- ═══════════════════════════════════
	-- CAS 2 : Vraie déconnexion → sauvegarder normalement (UNIFIÉ)
	-- ═══════════════════════════════════
	print(string.format("💾 Vraie déconnexion détectée pour %s", player.Name))

	-- Si un nouveau chargement est en cours pour ce userId, ne pas sauvegarder
	if dataLoading[userId] then
		warn(string.format("🚫 PlayerRemoving: dataLoading actif pour %d, sauvegarde annulée", userId))
		tempsJoueurs[userId] = nil
		return
	end

	-- ✅ FIX UGC ORPHELIN : prompt d'achat encore ouvert au quit.
	-- Le prompt meurt avec la session → l'achat ne peut plus aboutir,
	-- mais les points ont déjà été déduits ET persistés. On rembourse.
	-- (Si PromptPurchaseFinished a confirmé l'achat, processed=true → skip.)
	-- 🔐 Plus AUCUN remboursement au quit. `PlayerOwnsAsset` répondait ici le
	-- `false` mis en cache par le pré-check → tu remboursais une UGC livrée.
	-- La créance est déjà écrite en DataStore ; elle est tranchée à la
	-- reconnexion, sur un serveur neuf, avec une réponse authentique.
	for key, pending in pairs(pendingUGCPurchases) do
		if key:sub(1, #tostring(userId) + 1) == (userId .. "_") then
			pending.processed = true
			pendingUGCPurchases[key] = nil
		end
	end
	if _G.UGCEscrow then
		_G.UGCEscrow.OnPlayerLeaving(player)
	end


	-- ✅ FIX RE-FARM : flusher le store checkpoint si des touches n'ont pas
	-- encore été persistées. Le worker 20s JETAIT la data dirty quand le
	-- joueur était parti ("else dirtyCheckpointData[userId] = nil") →
	-- checkpointQuestStore restait stale. On capture la data MAINTENANT
	-- (avant le cleanup mémoire) ; l'écriture part en async.
	-- saveCheckpointQuestData construit sa table `data` de façon SYNCHRONE
	-- avant le task.spawn, donc le cleanup qui suit ne peut pas la corrompre.
	if dirtyCheckpointData[userId] and playerEarnedPointLevels[userId] ~= nil then
		dirtyCheckpointData[userId] = nil
		saveCheckpointQuestData(userId, false)
		print(string.format("💾 Flush checkpoint data au quit pour %d (touches non sauvegardées)", userId))
	end


	-- ✅ NOUVEAU : 1 SEUL save unifié au lieu de 6 SetAsync dispersés
	local data = tempsJoueurs[userId]
	if data and type(data) == "table" then
		local totalPoints = data.base + data.future

		-- Détection corruption (reset par nouvelle session)
		if data.base == 0 and data.future == 0 and data.lastSaved == 0 then
			warn(string.format("🛡️ tempsJoueurs reset détecté pour %s — save annulée (nouvelle session probable)",
				player.Name))
			return
		end

		-- Limite raisonnable
		if totalPoints < 0 or totalPoints > 1000000000000 then
			warn(string.format("⚠️ Points hors range: %d pour %s, sauvegarde annulée",
				totalPoints, player.Name))
			return
		end

		-- Jitter aléatoire 0-0.8s pour étaler les writes multi-joueurs
		local saveDelay = math.random(0, 8) * 0.1
		if saveDelay > 0 then task.wait(saveDelay) end

		-- Re-check multi-device après le yield
		local sessionAfterDelay = activeConnections[userId]
		if sessionAfterDelay and sessionAfterDelay.player ~= player then
			warn(string.format("🛡️ MULTI-DEVICE détecté après délai pour %s — save annulée",
				player.Name))
			return
		end

		-- Re-lire tempsJoueurs (peut avoir bougé pendant task.wait)
		local dataAfterDelay = tempsJoueurs[userId]
		if not dataAfterDelay or type(dataAfterDelay) ~= "table" then
			-- Si reload a tout cleané, l'autre chemin a déjà sauvegardé → skip OK
			if recentReloads[userId] then
				print(string.format("ℹ️ %s : tempsJoueurs cleaned par reload, save déjà fait", player.Name))
				return
			end
			-- Sinon, fallback sur la copie capturée AVANT le délai (pas de perte)
			warn(string.format(
				"⚠️ tempsJoueurs disparu pour %s pendant le délai — fallback sur données capturées (%d pts)",
				player.Name, data.base + data.future
				))
			dataAfterDelay = data
		end

		if dataAfterDelay.base == 0 and dataAfterDelay.future == 0 and dataAfterDelay.lastSaved == 0 then
			warn(string.format("🛡️ tempsJoueurs reset pendant délai pour %s", player.Name))
			return
		end
		totalPoints = dataAfterDelay.base + dataAfterDelay.future

		-- ✅ APPEL UNIQUE : secureSave écrit TOUT (points + rebirths + kills + checkpoints + warnings)
		-- dans PlayerData_v1 en 1 seul SetAsync
		print(string.format("💾 Save unifié final: %d pts pour %s", totalPoints, player.Name))
		local saveOk = secureSave(userId, totalPoints)

		if saveOk then
			print("✅ Save unifié réussi pour " .. player.Name)

			-- Ne pas nil-out si nouvelle session active
			local sessionAfterSave = activeConnections[userId]
			if not (sessionAfterSave and sessionAfterSave.player ~= player) then
				tempsJoueurs[userId] = nil
			end
		else
			warn("❌ Save unifié échoué pour " .. player.Name)
		end
	end

	-- ═══════════════════════════════════
	-- CLEANUP MÉMOIRE
	-- ═══════════════════════════════════
	task.wait(1)

	-- ✅ FIX MULTI-APPAREIL : Vérifier qu'une nouvelle session n'a pas pris le relais pendant le task.wait(1)
	local sessionAfterWait = activeConnections[userId]
	if sessionAfterWait and sessionAfterWait.player ~= player then
		warn(string.format("🛡️ CLEANUP ANNULÉ pour %s : nouvelle session active détectée après task.wait(1)", player.Name))
		return  -- Ne pas effacer les données de la nouvelle session
	end

	playerCurrentCheckpoint[userId] = nil
	friendCountCache[userId] = nil
	lastFriendCheck[userId] = nil
	friendsCache[userId] = nil
	tempsJoueurs[userId] = nil
	tempsJoueurs[userId .. "_pause"] = nil
	LossGuard.cleanup(userId)  -- ✅ Cleanup module externe
	_G.lastNotifyReload[userId] = nil
	_G.lastNotifyReload["abuse_" .. userId] = nil
	playerKillCount[userId] = nil
	playerKillCooldown[userId] = nil
	flushTotalKills(userId)
	totalKillsDirty[userId] = nil
	playerTotalKills[userId] = nil
	killQuestCooldowns[userId] = nil
	killQuestProgress[userId] = nil
	playerRebirthCount[userId] = nil
	allowedRebirth[userId] = nil
	playerCheckpoints[userId] = nil
	checkpointQuestCooldowns[userId] = nil
	playerTouchedCheckpoints[userId] = nil
	playerEarnedPointLevels[userId] = nil
	playerRedeemedCodes[userId] = nil
	Settings.data[userId] = nil
	Settings.rate[userId] = nil
	gamePassCache[userId] = nil
	_G.ACOptim.status[userId] = nil
	_G.ACOptim.attrAt[userId] = nil
	uiUpdateQueue[userId] = nil
	lastUIUpdate[userId] = nil
	pointLevelGlobalDebounce[userId] = nil
	AntiExploit.playerTracking[userId] = nil
	recentReloads[userId] = nil
	activeConnections[userId] = nil
	questCooldownsLoaded[userId] = nil
	rebirthTriggerCooldown[userId] = nil
	playerPlaytime[userId] = nil
	playerSessionStart[userId] = nil

	for key in pairs(lastPointLevelTouch) do
		if key:match("^" .. userId .. "_") then
			lastPointLevelTouch[key] = nil
		end
	end
	for key in pairs(checkpointTouchCooldown) do
		if key:match("^" .. userId .. "_") then
			checkpointTouchCooldown[key] = nil
		end
	end
	for key in pairs(checkpointRecountTimers) do
		if key:match("^" .. userId .. "_") then
			checkpointRecountTimers[key] = nil
		end
	end
	for _, friendList in pairs(friendsCache) do
		if type(friendList) == "table" and friendList[userId] then
			friendList[userId] = nil
		end
	end

	task.delay(15, function()
		disconnectProtection[userId] = nil
	end)

	-- Refresh amis
	task.delay(3, function()
		if #Players:GetPlayers() > 0 then
			refreshAllFriendsBatched()
		end
	end)

	print("✅ Cleanup complet pour", player.Name)
end)

killQuestClaimEvent.OnServerEvent:Connect(function(player)
	if not player or not player.Parent then return end

	local userId = player.UserId
	local now = os.time()

	-- Anti-spam
	if not AntiExploit.CheckRemoteCall(player, "KillQuestClaim") then return end

	-- Données chargées ?
	if playerKillCount[userId] == nil or killQuestCooldowns[userId] == nil or dataLoading[userId] then
		warn(string.format("⚠️ %s tente de claim KillQuest avant chargement", player.Name))
		pcall(function() updateKillUI(player) end)
		return
	end

	-- ✅ Vérifier cooldown 24h
	local cooldownEnd = killQuestCooldowns[userId] or 0
	if now < cooldownEnd then
		-- ✅ FIX FAUX-BAN : claim bloqué = 0 point => déjà sûr, aucune infraction.
		AntiExploit.NoteBlockedClaim(player, "KillQuest")
		updateKillUI(player)
		return
	end

	-- Vérif progression quest suffisante
	if (killQuestProgress[userId] or 0) < KILL_QUEST_REQUIRED then
		AntiExploit.NoteBlockedClaim(player, "KillQuest")
		pcall(function() updateKillUI(player) end)
		return
	end

	-- ✅ Poser le cooldown 24h IMMÉDIATEMENT (protection double-clic)
	killQuestCooldowns[userId] = now + KILL_QUEST_COOLDOWN

	-- ✅ Reset la progression quest (le joueur devra refaire 10 kills après le cooldown 24h)
	killQuestProgress[userId] = 0

	-- Sauvegarder le cooldown en DataStore
	task.spawn(function()
		pcall(function()
			KILL_QUEST_COOLDOWN_STORE:SetAsync("kq_" .. userId, killQuestCooldowns[userId])
		end)
	end)

	-- Sauvegarder le kill count reset
	saveKillData(userId)

	-- Donner les points
	if type(tempsJoueurs[userId]) ~= "table" then
		tempsJoueurs[userId] = {base = 0, future = 0, lastSaved = 0}
	end

	SmartAntiCheat.ExpectGain(userId, KILL_QUEST_REWARD, "KillQuest")
	tempsJoueurs[userId].future = tempsJoueurs[userId].future + KILL_QUEST_REWARD

	local leaderstats = player:FindFirstChild("leaderstats")
	local pointsStat = leaderstats and leaderstats:FindFirstChild("Points")
	if pointsStat then
		local total = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		pointsStat.Value = applyAllBonuses(calculatePoints(total), player)
		player:SetAttribute("Points", pointsStat.Value)

		local smartData = SmartAntiCheat.playerData[userId]
		if smartData then
			smartData.lastKnownPoints = pointsStat.Value
			smartData.lastCheckTime = os.time()
			if smartData.validationWindow then
				smartData.validationWindow.expectedGains = {}
			end
		end
	end

	task.spawn(function()
		SmartAntiCheat.RecordGain(player, KILL_QUEST_REWARD, "KillQuest")
	end)
	task.spawn(function()
		local total = tempsJoueurs[userId].base + tempsJoueurs[userId].future
		secureSave(userId, total)
	end)

	-- Notifier le client
	pcall(function() buyGamePassEvent:FireClient(player) end)
	updateKillUI(player)

	print(string.format("✅ KillQuest claim: %s +%d pts | Cooldown 24h jusqu'à %d (dans %.1fh)",
		player.Name, KILL_QUEST_REWARD, killQuestCooldowns[userId], KILL_QUEST_COOLDOWN/3600))
end)

-- ========================================
-- SAUVEGARDE D'URGENCE À LA FERMETURE
-- ========================================
game:BindToClose(function()
	print("🛑 FERMETURE DU SERVEUR - SAUVEGARDE D'URGENCE")

	-- ✅ SNAPSHOT IMMÉDIAT
	local snapshot = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local userId = player.UserId

		-- Skip reload en cours
		if recentReloads[userId] then
			print(string.format("⏭️ Skip %s (reload en cours)", player.Name))
			continue
		end

		-- Skip chargement en cours
		if dataLoading[userId] then
			print(string.format("⏭️ Skip %s (chargement en cours)", player.Name))
			continue
		end

		-- ✅ FIX MIGRATION : Skip si pas tout chargé
		-- (évite d'écrire un payload partiel avec des 0/{} qui écraseraient la data)
		if not isAllSecondaryLoaded(userId) then
			print(string.format("⏭️ Skip %s (loaders pas finis)", player.Name))
			continue
		end

		-- ✅ Skip double appareil
		local currentSession = activeConnections[userId]
		if currentSession and currentSession.player ~= player then
			print(string.format("⏭️ Skip %s (double appareil)", player.Name))
			continue
		end

		local data = tempsJoueurs[userId]
		if data and type(data) == "table" and not data.loading then
			local total = data.base + data.future
			-- ✅ Limite alignée avec validatePoints (1T au lieu de 1B)
			if total >= 0 and total <= 1000000000000 then
				snapshot[userId] = {
					name = player.Name,
					points = total,
					checkpoints       = playerCheckpoints[userId] or 0,
					cooldownEnd       = checkpointQuestCooldowns[userId] or 0,
					touchedUIDs       = playerTouchedCheckpoints[userId] or {},
					earnedPointLevels = playerEarnedPointLevels[userId] or {},
					killCount         = playerKillCount[userId] or 0,
					killCooldown = playerKillCooldown[userId] or 0,
					killQuestCooldown = killQuestCooldowns[userId] or 0,
					killQuestProgress = killQuestProgress[userId] or 0,
					rebirthCount = playerRebirthCount[userId] or 0,
					redeemedCodes = playerRedeemedCodes[userId] or {},
					playtimeSeconds = getCurrentPlaytime(userId),
					settings = Settings.data[userId] or Settings.default(),
				}
				-- ✅ FIX : Enrichir avec P2 (totalSpent etc.) avant les boosts
				if type(_G.enrichQuestSnapshotWithP2) == "function" then
					snapshot[userId] = _G.enrichQuestSnapshotWithP2(userId, snapshot[userId])
				end
				-- ✨ Inclure les boosts temporaires dans le snapshot
				if type(_G.enrichQuestSnapshotWithBoosts) == "function" then
					snapshot[userId] = _G.enrichQuestSnapshotWithBoosts(userId, snapshot[userId])
				end

				flushTotalKills(userId)

				-- ✅ Vider immédiatement pour que PlayerRemoving skip
				tempsJoueurs[userId] = nil
			end
		end
	end

	local snapshotCount = 0
	for _ in pairs(snapshot) do snapshotCount = snapshotCount + 1 end
	print(string.format("📸 Snapshot: %d joueurs capturés", snapshotCount))

	if snapshotCount == 0 then
		print("✅ BindToClose : rien à sauvegarder")
		return
	end

	-- ✅ NEW: PHASE SESSIONLOCK (filet de sécurité)
	-- Poser les locks en PARALLÈLE avant les SetAsync principaux.
	-- Si tempsStore:SetAsync timeout/échoue plus tard, les joueurs qui
	-- reconnectent < 30s liront ce lock en priorité dans secureLoad.
	print("🔒 Pose des SessionLocks (filet de sécurité)...")
	local locksPending = 0
	for userId, data in pairs(snapshot) do
		locksPending = locksPending + 1
		task.spawn(function()
			pcall(function()
				SESSION_LOCK_STORE:SetAsync("lock_" .. userId, {
					points = data.points,
					timestamp = os.time(),
					expiresAt = os.time() + SESSION_LOCK_DURATION,
					redeemedCodes = data.redeemedCodes or {},  -- ✅ FIX ANTI-RE-REDEEM (top-level)
					playtimeSeconds = data.playtimeSeconds or 0,  -- ⏱️ critique : éviter perte au BindToClose
					settings = data.settings or {},  -- ⚙️ paramètres joueur
					questSnapshot = {
						checkpoints        = data.checkpoints,
						cooldownEnd        = data.cooldownEnd,
						touchedUIDs        = data.touchedUIDs,
						earnedPointLevels  = data.earnedPointLevels or {},  -- ✅ FIX : était manquant
						killCount          = data.killCount,
						killCooldown       = data.killCooldown,
						killQuestCooldowns = data.killQuestCooldown,
						killQuestProgress  = data.killQuestProgress,
						redeemedCodes      = data.redeemedCodes or {},  -- ✅ FIX ANTI-RE-REDEEM (snapshot)
						settings           = data.settings or {},       -- ⚙️ paramètres joueur
						tempBoosts         = data.tempBoosts or {},     -- ✨ Boosts temporaires
						playtimeSeconds    = data.playtimeSeconds or 0, -- ⏱️ double-sécurité
						-- ✅ FIX FIABILITÉ : rebirths, allowedRebirth, cooldowns quêtes au shutdown
						rebirthCount = data.rebirthCount or 0,
						allowedRebirth = (allowedRebirth[userId] == true),
						questHistory = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},
					}
				})
			end)
			locksPending = locksPending - 1
		end)
	end

	-- Attendre max 3s que les SessionLocks soient posés (en parallèle, très rapide)
	local lockWait = 0
	while locksPending > 0 and lockWait < 30 do
		task.wait(0.1)
		lockWait = lockWait + 1
	end
	print(string.format("✅ SessionLocks posés (restants non confirmés: %d)", locksPending))

	-- Laisser PlayerRemoving détecter les nil et s'arrêter
	task.wait(1.5)

	-- ✅ NOUVEAU : 1 SEUL SetAsync par joueur — EN PARALLÈLE (le séquentiel avec
	-- task.wait(0.3) dépassait les 30s de BindToClose à 20+ joueurs)
	local savesPending = 0
	for userId, data in pairs(snapshot) do
		print(string.format("💾 %s → %d pts (unifié)", data.name, data.points))

		-- Construire le payload unifié avec TOUTES les données
		local payload = {
			version       = 1,
			migrated      = true,  -- ✅ FLAG : marque le joueur comme post-migration
			points        = data.points,
			rebirthCount  = data.rebirthCount or 0,
			rebirthRight  = (allowedRebirth and allowedRebirth[userId]) == true,
			lastSavedAt   = os.time(),

			-- Checkpoint quest
			checkpoints           = data.checkpoints or 0,
			checkpointCooldownEnd = data.cooldownEnd or 0,
			touchedCheckpoints    = data.touchedUIDs or {},
			earnedPointLevels     = data.earnedPointLevels or {},

			-- Kills
			killCount         = data.killCount or 0,
			killCooldown      = data.killCooldown or 0,
			killQuestProgress = data.killQuestProgress or 0,
			killQuestCooldown = data.killQuestCooldown or 0,

			-- Quest cooldowns
			questCooldowns = (AntiExploit.questHistory and AntiExploit.questHistory[userId]) or {},

			-- Codes redeem
			redeemedCodes = data.redeemedCodes or {},

			-- ⚙️ Paramètres joueur
			settings = data.settings or {},

			-- Playtime lifetime
			playtimeSeconds = data.playtimeSeconds or 0,

			-- Anti-cheat (warnings)
			warningInfractions = (AntiExploit.infractions and AntiExploit.infractions[userId]) or 0,
			smartAntiCheatInfractions = (
				SmartAntiCheat.playerData
					and SmartAntiCheat.playerData[userId]
					and SmartAntiCheat.playerData[userId].infractions
			) and {
				suspiciousCount    = SmartAntiCheat.playerData[userId].infractions.suspiciousCount or 0,
				dangerousCount     = SmartAntiCheat.playerData[userId].infractions.dangerousCount or 0,
				totalInfractions   = SmartAntiCheat.playerData[userId].infractions.totalInfractions or 0,
				burstCount         = SmartAntiCheat.playerData[userId].infractions.burstCount or 0,
				lastInfractionTime = SmartAntiCheat.playerData[userId].infractions.lastInfractionTime or 0,
			} or nil,
		}

		-- ✅ SetAsync en PARALLÈLE
		savesPending = savesPending + 1
		task.spawn(function()
			local ok = pcall(function()
				-- ⏱️ même garde-fou : le playtime ne recule jamais
				PLAYER_DATA_STORE:UpdateAsync("p_" .. userId, function(old)
					local oldPt = (type(old) == "table" and tonumber(old.playtimeSeconds)) or 0
					if oldPt > (tonumber(payload.playtimeSeconds) or 0) then
						payload.playtimeSeconds = oldPt
					end
					return payload
				end)
			end)

			if ok then
				_G.PlayerDataStats.saveSuccess = _G.PlayerDataStats.saveSuccess + 1
			else
				_G.PlayerDataStats.saveFail = _G.PlayerDataStats.saveFail + 1
				warn(string.format("❌ BindToClose: save échoué pour %s", data.name))
			end
			savesPending = savesPending - 1
		end)
	end

	-- Attendre max 15s que tous les saves parallèles se terminent
	local waitedSaves = 0
	while savesPending > 0 and waitedSaves < 150 do
		task.wait(0.1)
		waitedSaves = waitedSaves + 1
	end

	print(string.format("✅ BindToClose terminé (%d save(s) non confirmé(s))", savesPending))
end)

