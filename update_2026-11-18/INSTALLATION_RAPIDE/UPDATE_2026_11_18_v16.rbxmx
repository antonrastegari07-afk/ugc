		-- Limites de Remote Events (quests) — compté PAR remote, pas globalement
		MAX_REMOTE_CALLS_PER_SECOND = 3,
		QUEST_MIN_COOLDOWN = 24 * 60 * 60,  -- 🔧 24h pour Quest10K / Rebirth / Group (avant 8h)

