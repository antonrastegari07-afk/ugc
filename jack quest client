-- 📖 JACK GARDE SON LIVRE (quête en cours) / LE POSE PAR TERRE (quête finie)
-- ════════════════════════════════════════════════════════════════
local function jackModels()
	local jm = (view and view.JackMatch) or (grim and grim.JackMatch) or { Name = "Jack Lantern", Attribute = "JackLantern" }
	local list = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("Model") and ((jm.Attribute and d:GetAttribute(jm.Attribute) ~= nil) or (jm.Name and d.Name == jm.Name))
			and d:FindFirstChild("HumanoidRootPart") then
			table.insert(list, d)
		end
	end
	return list
end

-- 📗 quête finie : le grimoire reste posé par terre à côté de chaque Jack (pas pendant la cinématique)
placeBooks = function()
	if not (view and view.BookDown) then
		pcall(FX.ClearGroundBooks)                       -- (quête remise à zéro en test : plus de livre au sol)
		return
	end
	if inDialog() or FX.IsRunning() then return end
	for _, d in ipairs(jackModels()) do pcall(FX.GroundBook, d) end
end

-- 📖 quête en cours : il tient son livre ouvert (il lit), son seau reste au sol ; sinon il le range
syncHold = function()
	if inDialog() or FX.IsRunning() then return end      -- le dialogue / la cinématique s'en occupent
	if not view then return end
	for _, d in ipairs(jackModels()) do
		if grim then
			if not FX.IsHolding(d) then pcall(FX.SetHolding, d, true, { quiet = true }) end
		elseif FX.IsHolding(d) then
			pcall(FX.SetHolding, d, false)                   -- refusé / abandonné : il range son livre
		end
	end
end

