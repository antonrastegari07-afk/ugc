toastRE.OnClientEvent:Connect(function(p)
	if type(p) ~= "table" then return end
	if p.Page then
		local i = p.Page
		local rec = pages[i]
		if rec then catchPage(i, p)                      -- elle plonge vers toi et éclate (rien à l'écran)
		else
			pending[i] = nil
			if p.AllFound then task.delay(0.3, function() celebrateAll() end) end
		end
		-- la vue locale est mise à jour tout de suite (le serveur reste la référence)
		if grim and grim.Pages and grim.Pages[i] then
			local pg = grim.Pages[i]
			pg.Got, pg.Title, pg.Text, pg.Icon, pg.Formula, pg.P = true, p.Title, p.Text, p.Icon, p.Formula, nil
		end
		task.delay(1.5, fetch)
	elseif p.PageRefused then
		returnPage(p.PageRefused)
	elseif p.Candy or p.CandyRefused or p.CandyGot or p.CandyGive then
		if candyHook.toast then candyHook.toast(p) end     -- 🍬 quête du seau
	elseif p.Refresh then
		if p.Accepted then
			-- la quête vient d'être acceptée : les pages (ou les bonbons) apparaissent à la fin du dialogue
			freshPending = true
			if candyHook.accepted then candyHook.accepted() end
		end
		task.spawn(fetch)
	elseif p.StepId then
		task.delay(0.5, fetch)
	end
end)

-- la fin d'une discussion : on remet tout d'aplomb (pages, livre tenu / rangé, livre au sol)
player:GetAttributeChangedSignal("InNpcDialog"):Connect(function()
	if not inDialog() then task.delay(0.6, fetch) end
end)

-- au cas où : après un respawn, les pages restent (elles sont dans le Workspace, pas sur le perso)
task.spawn(function()
	task.wait(2)
	fetch()
	while ROOT.Parent do
		task.wait((grim or (candyHook.active and candyHook.active())) and 6 or 12)
		fetch()
	end
end)
