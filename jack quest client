local view = nil          -- vue complète renvoyée par JackState
local freshPending = false -- quête tout juste acceptée : les pages apparaîtront avec un effet
local grim = nil          -- view.active si c'est le grimoire
local fetching = false
local refreshPages, celebrateAll, hintBanner, placeBooks, syncHold -- fwd
local candyHook = {}       -- 🍬 quête du seau (rempli plus bas)

local function fetch()
	if fetching then return end
	fetching = true
	local ok, res = pcall(function() return stateRF:InvokeServer() end)
	fetching = false
	if not ok or type(res) ~= "table" or res.loading then return end
	if res.hidden then view, grim = nil, nil
	else
		view = res
		grim = (res.active and res.active.Goal and res.active.Goal.Type == "grimoire") and res.active or nil
	end
	refreshPages()
	placeBooks()
	syncHold()
	if candyHook.view then candyHook.view(view) end
end

