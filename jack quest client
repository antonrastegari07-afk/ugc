		GiveAction = "Give Candy", GiveObject = "Jack", GiveHold = 0.25, GiveDistance = 12,
	}
	local COLORS = { Color3.fromRGB(160, 80, 230), Color3.fromRGB(90, 200, 90), Color3.fromRGB(255, 110, 180),
		Color3.fromRGB(80, 160, 255), Color3.fromRGB(255, 150, 40), Color3.fromRGB(240, 60, 70) }
	local C_GREEN = Color3.fromRGB(110, 230, 110)
	local playerGui = player:WaitForChild("PlayerGui")

	local cv = nil                  -- vue du serveur (Bucket, Need, Count, Total, Full, Items)
	local on = false                -- quête du seau en cours
	local fresh = false             -- vient d'être acceptée (les bonbons apparaissent à la fin de la discussion)
	local recs = {}                 -- [id] = bonbon dans le monde
	local pendingId, pendingAt = nil, 0
	local wasFull = false
	local jacksCache = {}
	local BUSYC = { rise = true, hover = true, dive = true }
	local setHold                  -- (plus bas) bras tendu qui tient le seau

	local folder, hl
	local function candyWorld()
		if not folder or not folder.Parent then
			folder = new("Model", { Name = "JackCandies" }, workspace)
			-- UN seul Highlight pour tous les bonbons : contour doré visible même derrière un mur
			hl = new("Highlight", { Name = "CandyGlow", Adornee = folder, FillColor = Color3.fromRGB(255, 244, 210), FillTransparency = 0.72,
				OutlineColor = CU.Outline, OutlineTransparency = 0.05, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, folder)
		end
		return folder
	end

	local function bucketModel()
		local c = player.Character
		return c and c:FindFirstChild("JackCandyBucket")
	end
	local function bucketPos()
		local b = bucketModel()
		local h = b and (b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart"))
		if h then return h.Position + Vector3.new(0, -0.5, 0) end
		local r = hrp()
		return r and (r.Position + Vector3.new(0, 0.4, 0)) or nil
	end

	-- ── un bonbon ──
	local function fallbackCandy(col)
		local m = new("Model", { Name = "Candy" })
		local p = new("Part", { Name = "Collider", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5), Color = col,
			Material = Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false }, m)
		m.PrimaryPart = p
		return m
	end
	local function candyModel(col, scale)
		local kinds = ASSETS and ASSETS:FindFirstChild("Candies")
		kinds = kinds and kinds:GetChildren() or {}
		local m = (#kinds > 0) and kinds[math.random(1, #kinds)]:Clone() or fallbackCandy(col)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
				if d:GetAttribute("Tint") then d.Color = col end
			end
		end
		m.PrimaryPart = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
		if scale and scale ~= 1 then pcall(function() m:ScaleTo(m:GetScale() * scale) end) end
		return m
	end

	local function setAlpha(rec, a)
		for p, base in pairs(rec.parts) do
			if p.Parent then p.Transparency = base + (1 - base) * (1 - a) end
		end
	end

	local function spawnCandy(id, pos, fancy)
		local col = COLORS[math.random(1, #COLORS)]
		local m = candyModel(col, CU.Scale)
		m.Name = "Candy" .. id
		m:PivotTo(CFrame.new(pos))
		m.Parent = candyWorld()
		local pp = m.PrimaryPart
		local rec = { id = id, model = m, pp = pp, home = pos, parts = {}, state = "idle", t = math.random() * 10, col = col }
		local okS, sc = pcall(function() return m:GetScale() end)
		rec.scale0 = okS and sc or 1
		for _, d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") then rec.parts[d] = d.Transparency end end
		if pp then
			rec.light = new("PointLight", { Color = col:Lerp(Color3.new(1, 1, 1), 0.35), Range = CU.LightRange,
				Brightness = CU.LightBrightness, Shadows = false }, pp)
			rec.stars = new("ParticleEmitter", { Texture = FX.Tex("Star"), Rate = CU.Stars, LightEmission = 1, LightInfluence = 0,
				Lifetime = NumberRange.new(0.6, 1.1), Speed = NumberRange.new(0.3, 0.9), SpreadAngle = Vector2.new(180, 180),
				Size = nseq({ 0, 0 }, { 0.4, 0.22 }, { 1, 0 }), Color = seq(Color3.new(1, 1, 1), col), ZOffset = 0.4 },
			new("Attachment", {}, pp))
			pcall(function() rec.stars.Brightness = 2.5 end)
		end
		if fancy then
			rec.state = "appear"
			rec.appearT = os.clock()
			setAlpha(rec, 0)
			FX.Puff(pos, 0.45, true)
		end
		recs[id] = rec
		return rec
	end

	local function removeCandy(id, puff)
		local rec = recs[id]
		if not rec then return end
		recs[id] = nil
		if puff and rec.pp and rec.pp.Parent then FX.Puff(rec.pp.Position, 0.35) end
		rec.model:Destroy()
	end

	-- ── 🪣 PANNEAU PHYSIQUE à droite de ton seau : combien il est rempli (rectangulaire, fond gris brossé) ──
	--    Une vraie petite plaque dans le monde (pas un billboard) ; lisible des deux côtés. Visible pour toi seulement.
	local PANEL_W, PANEL_H, PPS = 2.4, 1.2, 150             -- studs ; pixels par stud (canevas 360 × 180)
	local panelFolder = new("Folder", { Name = "JackCandyBucketPanel" }, workspace)
	local panel = new("Part", { Name = "BucketPanel", Size = Vector3.new(PANEL_W, PANEL_H, 0.06), Anchored = true, CanCollide = false,
		CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 1 }, nil)
	local faces = {}
	for _, face in ipairs({ Enum.NormalId.Back, Enum.NormalId.Front }) do
		local sg = new("SurfaceGui", { Name = "Panel" .. face.Name, Face = face, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = PPS, LightInfluence = 0, AlwaysOnTop = false, ResetOnSpawn = false }, panel)
		local root = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(26, 24, 30), BorderSizePixel = 0 }, sg)
		local sc = new("UIScale", {}, root)
		local bgId = UI.BucketPanelImage
		if type(bgId) == "number" then bgId = tostring(bgId) end
		if type(bgId) == "string" and bgId ~= "" then
			if not bgId:find("://") then bgId = "rbxassetid://" .. bgId end
			root.BackgroundTransparency = 1                   -- l'image a ses bords arrachés (transparents) : rien derrière
			new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = bgId, ScaleType = Enum.ScaleType.Stretch }, root)
		else
			new("UIStroke", { Color = Color3.fromRGB(10, 9, 12), Thickness = 6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, root)
		end
		local title = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 14), Size = UDim2.new(1, -48, 0, 28),
			Text = "JACK'S BUCKET", Font = UI.FontTitle, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(255, 160, 60), ZIndex = 2 }, root)
		new("UIStroke", { Color = Color3.fromRGB(8, 6, 10), Thickness = 2 }, title)
		local count = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 44), Size = UDim2.new(1, -48, 0, 70),
			Text = "0 / 10", Font = UI.FontTitle, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.new(1, 1, 1), ZIndex = 2 }, root)
		new("UIStroke", { Color = Color3.fromRGB(8, 6, 10), Thickness = 3 }, count)
		local track = new("Frame", { Position = UDim2.fromOffset(24, 122), Size = UDim2.new(1, -48, 0, 14), BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(10, 9, 12), ZIndex = 2 }, root)
		local bar = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3 }, track)
		local barGrad = new("UIGradient", { Rotation = 90, Color = seq(C_YE, C_OR) }, bar)
		local sub = new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 142), Size = UDim2.new(1, -48, 0, 26),
			Text = "", Font = UI.FontTitle, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(190, 184, 200), ZIndex = 2 }, root)
		new("UIStroke", { Color = Color3.fromRGB(8, 6, 10), Thickness = 2 }, sub)
		table.insert(faces, { count = count, bar = bar, barGrad = barGrad, sub = sub, scale = sc })
	end
	local panelOffset = nil          -- calculé une fois d'après la taille du seau

	-- ── 🎃 repère au-dessus de Jack quand ton seau est plein ──
	local mk = new("BillboardGui", { Name = "JackCandyMarker", Size = UDim2.fromOffset(230, 92), StudsOffset = Vector3.new(0, 3.4, 0),
		AlwaysOnTop = true, LightInfluence = 0, ResetOnSpawn = false, Enabled = false }, playerGui)
	local mkText = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Text = "Bring your candy here!",
		Font = UI.FontTitle, TextScaled = true, TextColor3 = C_YE }, mk)
	new("UIStroke", { Color = Color3.fromRGB(60, 20, 6), Thickness = 2.5 }, mkText)
	local mkArrow = new("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 34),
		Size = UDim2.fromOffset(60, 54), Text = "▼", Font = UI.FontTitle, TextScaled = true, TextColor3 = C_OR }, mk)
	new("UIStroke", { Color = Color3.fromRGB(60, 20, 6), Thickness = 3 }, mkArrow)

	-- ── ✋ « Give Candy » : un prompt à toi, posé sur Jack (son « Talk » est éteint pendant ce temps) ──
	local giveFolder = new("Folder", { Name = "JackCandyGive" }, workspace)
	local givePart = new("Part", { Name = "GiveCandy", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }, giveFolder)
	local givePrompt = new("ProximityPrompt", { Name = "GiveCandy", ActionText = CU.GiveAction, ObjectText = CU.GiveObject,
		HoldDuration = CU.GiveHold, MaxActivationDistance = CU.GiveDistance, RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E, Enabled = false }, givePart)
	local giving = 0
	local talkOff = {}               -- [prompt de Jack] = était allumé
	local function jackTalk(off)
		if off then
			for _, m in ipairs(jacksCache) do
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("ProximityPrompt") and talkOff[d] == nil then
						talkOff[d] = d.Enabled
						d.Enabled = false
					end
				end
			end
		else
			for d, was in pairs(talkOff) do if d.Parent then d.Enabled = was end end
			table.clear(talkOff)
		end
	end
	local function nearestJackModel()
		local r = hrp()
		local best, bd
		for _, m in ipairs(jacksCache) do
			local root = m.Parent and m:FindFirstChild("HumanoidRootPart")
			if root then
				local d = r and (root.Position - r.Position).Magnitude or 0
				if not bd or d < bd then best, bd = m, d end
			end
		end
		return best
	end

	-- ── 🪣 Jack t'a prêté son seau : il ne l'a plus dans la main (chez toi seulement) ──
	local function jackBucketParts(m)
		local out = {}
		local pivot = m:FindFirstChild("BucketPivot", true)
		if pivot then
			for _, w in ipairs(pivot:GetChildren()) do
				if w:IsA("WeldConstraint") then
					local p = (w.Part0 == pivot) and w.Part1 or w.Part0
					if p and p ~= pivot and p:IsA("BasePart") then table.insert(out, p) end
				end
			end
		end
		return out
	end
	local hiddenJack = false
	local function hideJackBuckets(hide)
		if not hide and not hiddenJack then return end
		hiddenJack = hide
		for _, m in ipairs(jacksCache) do
			for _, p in ipairs(jackBucketParts(m)) do p.LocalTransparencyModifier = hide and 1 or 0 end
		end
	end

	-- 🖐️ bras tendu vers l'avant, immobile en marchant / sautant (l'animation « tenir un outil » de Roblox,
	--    priorité Action : elle passe par-dessus la marche et le saut). Jouée par toi → tout le monde la voit.
	local holdTrack, holdChar, holdRetry = nil, nil, 0
	local function holdAnimId(char, hum)
		local a = char:FindFirstChild("Animate")
		local tn = a and a:FindFirstChild("toolnone")
		local an = tn and tn:FindFirstChildWhichIsA("Animation")
		if an and an.AnimationId ~= "" then return an.AnimationId end
		return hum.RigType == Enum.HumanoidRigType.R15 and "rbxassetid://507768375" or "rbxassetid://182393478"
	end
	setHold = function(want)
		local char = player.Character
		if want then
			if holdTrack and holdChar == char then return end
			if os.clock() < holdRetry then return end
			holdRetry = os.clock() + 1
			if holdTrack then pcall(function() holdTrack:Stop(0.2) end) end
			holdTrack, holdChar = nil, nil
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local an = hum and hum:FindFirstChildOfClass("Animator")
			if not an then return end
			local ok, tr = pcall(function() return an:LoadAnimation(new("Animation", { AnimationId = holdAnimId(char, hum) })) end)
			if ok and tr then
				pcall(function() tr.Priority = Enum.AnimationPriority.Action end)
				tr.Looped = true
				tr:Play(0.2)
				holdTrack, holdChar = tr, char
			end
		elseif holdTrack then
			pcall(function() holdTrack:Stop(0.25) end)
			holdTrack, holdChar = nil, nil
		end
	end

	local function updateHud()
		local full = on and cv and cv.Full == true
		local need = cv and math.max(cv.Need or 0, 1) or 1
		local n = cv and math.min(cv.Bucket or 0, need) or 0
		for _, f in ipairs(faces) do
			f.count.Text = full and "FULL" or ("%d / %d"):format(n, need)
			f.count.TextColor3 = full and C_GREEN or Color3.new(1, 1, 1)
			tween(f.bar, 0.25, { Size = UDim2.fromScale(full and 1 or math.clamp(n / need, 0, 1), 1) })
			f.barGrad.Color = full and seq(Color3.fromRGB(190, 255, 170), C_GREEN) or seq(C_YE, C_OR)
			f.sub.Text = full and "Bring it back to Jack!" or ("Jack has %d / %d candies"):format(cv and cv.Count or 0, cv and cv.Total or 0)
			f.sub.TextColor3 = full and Color3.new(1, 1, 1) or Color3.fromRGB(190, 184, 200)
		end
		givePrompt.Enabled = full and os.clock() > giving
		jackTalk(full)
	end

	-- ✋ on DEMANDE au serveur ; le bonbon monte en attendant
	local function grab(rec)
		local now = os.clock()
		pendingId, pendingAt = rec.id, now
		actionRE:FireServer("candy", rec.id)
		rec.state = "rise"
		rec.riseT0 = now
		rec.riseFrom = rec.model:GetPivot()
		FX.Sound("Pop", rec.pp, 0.35)
		if rec.stars then rec.stars.Rate = CU.Stars * 4 end
	end
	local function backCandy(rec)
		if not rec or rec.state == "dive" then return end
		rec.state = "back"
		rec.backT0 = os.clock()
		rec.backFrom = rec.model:GetPivot()
		rec.cool = os.clock() + 1.5
		setAlpha(rec, 1)
		if rec.stars then rec.stars.Rate = CU.Stars end
	end

	-- 💥 il entre dans ton seau
	local function candyBurst(rec, target)
		FX.Sparkle(target, 14, seq(Color3.new(1, 1, 1), rec.col, C_YE), 5)
		FX.Sound("PageGet", nil, 0.45)
		local b = bucketModel()
		if b then   -- le seau s'illumine un instant
			local h = new("Highlight", { Name = "BucketGlow", Adornee = b, FillColor = rec.col, FillTransparency = 0.35,
				OutlineColor = Color3.new(1, 1, 1), OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.Occluded }, b)
			tween(h, 0.6, { FillTransparency = 1, OutlineTransparency = 1 })
			task.delay(0.7, function() h:Destroy() end)
		end
		for _, f in ipairs(faces) do
			f.scale.Scale = 1.08
			tween(f.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end

	-- 🍬→🎃 les bonbons de ton seau volent dans les mains de Jack
	local function deliverFx(amount)
		local from = bucketPos()
		local jm = nearestJackModel()
		local root = jm and jm:FindFirstChild("HumanoidRootPart")
		if not (from and root) then return end
		local to = root.Position + Vector3.new(0, 1.2, 0)
		local n = math.clamp(amount or 5, 3, 12)
		for k = 1, n do
			task.delay((k - 1) * 0.07, function()
				local col = COLORS[math.random(1, #COLORS)]
				local m = candyModel(col, 1.2)
				m.Parent = candyWorld()
				local t0 = os.clock()
				local side = (math.random() - 0.5) * 3
				local conn
				conn = RunService.Heartbeat:Connect(function()
					local u = math.clamp((os.clock() - t0) / 0.6, 0, 1)
					local mid = from:Lerp(to, 0.5) + Vector3.new(side, 4, 0)
					local q = 1 - u
					local p = from * (q * q) + mid * (2 * q * u) + to * (u * u)
					m:PivotTo(CFrame.new(p) * CFrame.Angles(u * 9, u * 7, 0))
					if u >= 1 then
						conn:Disconnect()
						m:Destroy()
						if k % 3 == 0 or k == n then FX.Sparkle(to, 8, seq(Color3.new(1, 1, 1), col), 4) end
					end
				end)
			end)
		end
		task.delay(n * 0.07 + 0.6, function()
			FX.Burst(to, 0.6, { Color3.fromRGB(255, 236, 190), C_OR })
			FX.Sound("PageIn", nil, 0.5)
		end)
	end

	-- ── synchro avec le serveur (vue complète ou réponse à un ramassage) ──
	local function sync(c)
		cv = c
		local want = {}
		if c and c.Items and not (fresh and inDialog()) then
			for _, it in ipairs(c.Items) do
				if type(it.P) == "table" then want[it.Id] = Vector3.new(it.P[1], it.P[2], it.P[3]) end
			end
		end
		for id, rec in pairs(recs) do
			if not want[id] and not BUSYC[rec.state] then removeCandy(id, c ~= nil and c.Full == true) end
		end
		local spawned = 0
		for id, pos in pairs(want) do
			if not recs[id] and pendingId ~= id then spawnCandy(id, pos, true) ; spawned += 1 end
		end
		if fresh and spawned > 0 then
			fresh = false
			task.delay(0.4, function() hintBanner("Fill Jack's bucket!", "Grab the glowing candies around him 🍬") end)
		end
		local full = c ~= nil and c.Full == true
		if full and not wasFull and not fresh then
			FX.Sound("AllFound", nil, 0.5)
			hintBanner("Your bucket is full!", "Bring it back to Jack 🎃")
		end
		wasFull = full
		updateHud()
	end

	candyHook.view = function(v)
		local a = v and v.active
		local c = (a and a.Goal and a.Goal.Type == "candy") and a.Candy or nil
		on = c ~= nil
		if on then jacksCache = jackModels() end
		if not on then
			for id in pairs(recs) do removeCandy(id, false) end
			pendingId = nil
			cv = nil
			wasFull = false
			givePrompt.Enabled = false
			jackTalk(false)
			hideJackBuckets(false)
			return
		end
		hideJackBuckets(true)
		sync(c)
	end
	candyHook.accepted = function() fresh = true end
	candyHook.active = function() return on end
	candyHook.toast = function(p)
		if p.CandyGot then
			local rec = recs[p.CandyGot]
			if pendingId == p.CandyGot then pendingId = nil end
			if rec then
				rec.confirmed = true
				if rec.state == "idle" or rec.state == "back" or rec.state == "appear" then
					rec.state = "hover"
					rec.riseFrom = rec.model:GetPivot()
				end
			end
		elseif p.CandyRefused then
			if pendingId == p.CandyRefused then pendingId = nil end
			backCandy(recs[p.CandyRefused])
			if p.BucketFull then hintBanner("Your bucket is full!", "Bring it back to Jack 🎃") end
		end
		if p.CandyGive then
			giving = 0
			deliverFx(p.CandyGive)
			local c = p.Candy or {}
			task.delay(0.9, function()
				if p.AllCandy then
					celebrateAll("ALL CANDIES DELIVERED!", "Jack is so happy! 🎃")
				else
					hintBanner(("%d / %d candies!"):format(c.Count or 0, c.Total or 0), "Go get more candies! 🍬")
				end
			end)
		end
		if p.Candy and on then sync(p.Candy) end
	end

	givePrompt.Triggered:Connect(function()
		if not (on and cv and cv.Full) or inDialog() or os.clock() < giving then return end
		giving = os.clock() + 4                    -- (sans réponse : le bouton revient dans 4 s)
		givePrompt.Enabled = false
		actionRE:FireServer("give")
	end)

	-- 🎞️ une seule boucle : bonbons, billboard, repère, prompt
	local RISE_C, DIVE_C = 0.35, 0.4
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		local talking = inDialog()
		local r = hrp()
		local me = r and r.Position
		local full = on and cv and cv.Full == true
		-- billboard du seau
		local b = bucketModel()
		local h = b and (b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart"))
		-- 🪣 la plaque suit ton seau, à sa droite, tournée comme ton perso (lisible derrière toi et devant)
		local showPanel = on and h ~= nil and r ~= nil and not talking
		if showPanel then
			if not panelOffset then
				local okE, ext = pcall(function() return b:GetExtentsSize() end)
				local wdt = (okE and ext and ext.X > 0.2 and ext.X < 8) and ext.X or 1.4
				local hgt = (okE and ext and ext.Y > 0.2 and ext.Y < 8) and ext.Y or 1.4
				panelOffset = CFrame.new(wdt / 2 + PANEL_W / 2 + 0.25, -hgt * 0.45, 0)
			end
			panel.CFrame = CFrame.new(h.Position) * r.CFrame.Rotation * panelOffset
			if panel.Parent ~= panelFolder then panel.Parent = panelFolder end
		elseif panel.Parent then
			panel.Parent = nil
			panelOffset = nil
		end
		setHold(on and h ~= nil)
		-- repère + prompt sur Jack
		local jm = (on and (full or giving > now)) and nearestJackModel() or nil
		local jroot = jm and jm:FindFirstChild("HumanoidRootPart")
		local head = jm and (jm:FindFirstChild("Head") or jroot)
		if head and mk.Adornee ~= head then mk.Adornee = head end
		mk.Enabled = full and head ~= nil and not talking
		if mk.Enabled then mkArrow.Position = UDim2.new(0.5, 0, 0, 34 + math.abs(math.sin(now * 4)) * 8) end
		if jroot then givePart.CFrame = jroot.CFrame end
		if full and not givePrompt.Enabled and now > giving and not talking then givePrompt.Enabled = true end
		if full then for _, f in ipairs(faces) do f.scale.Scale = 1 + math.abs(math.sin(now * 3)) * 0.04 end end
		for id, rec in pairs(recs) do
			if not rec.model.Parent then recs[id] = nil continue end
			rec.t += dt
			local t = rec.t
			if rec.state == "idle" or rec.state == "appear" then
				local cf = CFrame.new(rec.home + Vector3.new(0, math.sin(t * CU.BobSpeed) * CU.BobHeight, 0))
					* CFrame.Angles(0, t * CU.SpinSpeed, math.sin(t * 0.9) * 0.25)
				if rec.state == "appear" then
					local u = (now - rec.appearT) / 0.6
					if u >= 1 then rec.state = "idle" ; setAlpha(rec, 1)
					else
						setAlpha(rec, smooth(u))
						cf = cf * CFrame.new(0, (1 - smooth(u)) * -1, 0)
					end
				end
				rec.model:PivotTo(cf)
				-- 🍬 tu passes dessus → il saute dans ton seau
				if rec.state == "idle" and me and not talking and not full and not pendingId
					and not (rec.cool and now < rec.cool) and (me - rec.home).Magnitude <= CU.Grab then
					grab(rec)
				end
			elseif rec.state == "rise" or rec.state == "hover" then
				local u = rec.state == "rise" and math.clamp((now - rec.riseT0) / RISE_C, 0, 1) or 1
				local e = 1 - (1 - u) ^ 3
				local pos = rec.riseFrom.Position + Vector3.new(0, 1.6 * e, 0)
				rec.spin = (rec.spin or 0) + dt * (2 + e * 8)
				rec.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rec.spin, 0))
				if u >= 1 then rec.state = "hover" end
				if rec.state == "hover" and rec.confirmed then
					rec.state = "dive"
					rec.diveT0 = now
					rec.diveFrom = rec.model:GetPivot()
				elseif pendingId == id and now - pendingAt > 5 then
					pendingId = nil
					backCandy(rec)
					task.spawn(fetch)
				end
			elseif rec.state == "dive" then
				-- ⬇️ il plonge dans ton seau en tournoyant, rapetisse… et éclate
				local u = math.clamp((now - rec.diveT0) / DIVE_C, 0, 1)
				local e = u * u * u
				local target = bucketPos() or rec.home
				local from = rec.diveFrom.Position
				local mid = from:Lerp(target, 0.4) + Vector3.new(0, 1, 0)
				local q = 1 - e
				local pos = from * (q * q) + mid * (2 * q * e) + target * (e * e)
				rec.spin = (rec.spin or 0) + dt * 14
				rec.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rec.spin, 0))
				pcall(function() rec.model:ScaleTo(rec.scale0 * math.max(0.15, 1 - e * 0.85)) end)
				if u >= 1 then
					candyBurst(rec, target)
					recs[id] = nil
					rec.model:Destroy()
				end
			elseif rec.state == "back" then
				local u = math.clamp((now - rec.backT0) / 0.6, 0, 1)
				rec.model:PivotTo(rec.backFrom:Lerp(CFrame.new(rec.home), 1 - (1 - u) ^ 3))
				if u >= 1 then rec.state = "idle" end
			end
		end
	end)

	-- (Jack t'a prêté son seau : on le garde caché chez lui, même si une animation le remet)
	task.spawn(function()
		while ROOT.Parent do
			task.wait(1)
			if on then hideJackBuckets(true) end
		end
	end)
end

