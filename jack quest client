-- 🌫️ LES PAGES DANS LE MONDE
-- ════════════════════════════════════════════════════════════════
local worldFolder
local function world()
	if not worldFolder or not worldFolder.Parent then
		worldFolder = new("Folder", { Name = "JackQuestPages" }, workspace)
	end
	return worldFolder
end

local pages = {}          -- [i] = rec
local pending = {}        -- [i] = os.clock() de la demande au serveur
local BUSY = { rise = true, hover = true, dive = true }   -- page en train d'être ramassée : on n'y touche pas

-- page de secours si l'installeur n'a pas été lancé
local function fallbackPage()
	local m = new("Model", { Name = "TornPage" })
	local p = new("Part", { Name = "Page_Paper", Size = Vector3.new(1.5, 1.9, 0.05), Color = C_PAPER,
		Material = Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false }, m)
	local g = new("Part", { Name = "Page_Glyph", Size = Vector3.new(0.7, 0.7, 0.06), Color = C_OR,
		Material = Enum.Material.SmoothPlastic, Anchored = true, CanCollide = false, CFrame = p.CFrame }, m)
	new("WeldConstraint", { Part0 = p, Part1 = g }, p)
	m.PrimaryPart = p
	return m
end

local onPrompt   -- fwd

local function buildPage(i, pos)
	local tpl = ASSETS and ASSETS:FindFirstChild("TornPage")
	local m = tpl and tpl:Clone() or fallbackPage()
	m.Name = "Page" .. i
	local parts = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
			parts[d] = d.Transparency
		end
	end
	local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
	m.PrimaryPart = pp
	m:PivotTo(CFrame.new(pos))
	m.Parent = world()

	local rec = { i = i, model = m, pp = pp, home = pos, parts = parts, state = "idle", t = math.random() * 10,
		outline = 0, born = os.clock() }
	-- petite lumière chaude
	rec.light = new("PointLight", { Color = Color3.fromRGB(255, 205, 140), Range = UI.LightRange, Brightness = UI.LightBrightness,
		Shadows = false }, pp)
	-- ✨ petites étoiles magiques autour de la page (comme sur le livre de Jack)
	rec.fx = new("Part", { Name = "PageMagic", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(1.8, 2.2, 1.2), CFrame = CFrame.new(pos), CastShadow = false }, m)
	rec.stars = new("ParticleEmitter", { Texture = FX.Tex("Star"), Rate = UI.Stars, LightEmission = 1, LightInfluence = 0,
		Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(0.05, 0.25), SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.17), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0.1), Color = seq(Color3.new(1, 1, 1), C_LAV, C_YE), RotSpeed = NumberRange.new(-60, 60),
		Rotation = NumberRange.new(0, 360), ZOffset = 0.4 }, rec.fx)
	pcall(function() rec.stars.Brightness = 2.5 end)
	pcall(function() rec.stars.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume end)
	rec.motes = new("ParticleEmitter", { Texture = FX.Tex("Spark"), Rate = math.max(1, UI.Stars * 0.4), LightEmission = 1,
		LightInfluence = 0, Lifetime = NumberRange.new(1.4, 2.2), Speed = NumberRange.new(0.2, 0.45), EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(20, 20), Acceleration = Vector3.new(0, 0.3, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.1), NumberSequenceKeypoint.new(1, 0) }),
		Color = seq(C_LAV, C_PU), ZOffset = 0.3 }, rec.fx)
	-- contour blanc quand tu t'approches
	rec.hl = new("Highlight", { Name = "PageOutline", Adornee = m, FillColor = Color3.new(1, 1, 1), FillTransparency = 1,
		OutlineColor = UI.OutlineColor, OutlineTransparency = 1, DepthMode = Enum.HighlightDepthMode.Occluded, Enabled = false }, m)
	-- prompt (local : seul toi le vois) — accroché SOUS la page pour ne pas la cacher
	rec.promptPart = new("Part", { Name = "PagePrompt", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos - Vector3.new(0, UI.PromptBelow, 0)) }, m)
	rec.prompt = new("ProximityPrompt", { Name = "TakePage", ActionText = UI.PromptAction, ObjectText = UI.PromptObject,
		HoldDuration = UI.PromptHold, MaxActivationDistance = UI.PromptDistance, RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E, Style = Enum.ProximityPromptStyle.Default, Enabled = true }, rec.promptPart)
	rec.prompt.Triggered:Connect(function() onPrompt(rec) end)
	return rec
end

local function setPageAlpha(rec, a)
	for p, base in pairs(rec.parts) do
		if p.Parent then p.Transparency = base + (1 - base) * (1 - a) end
	end
end

local function removePage(i, puff)
	local rec = pages[i]
	if not rec then return end
	pages[i] = nil
	if puff and rec.pp and rec.pp.Parent then FX.Puff(rec.pp.Position, 0.6) end
	if rec.model then rec.model:Destroy() end
end

-- la page apparaît (pouf + petit tourbillon)
local function spawnPage(i, pos, fancy)
	local rec = buildPage(i, pos)
	pages[i] = rec
	if fancy then
		setPageAlpha(rec, 0)
		rec.state = "appear"
		rec.appearT = os.clock() + (i - 1) * 0.18
		task.delay((i - 1) * 0.18, function()
			if pages[i] == rec then FX.Puff(pos, 0.7) end
		end)
	end
end

refreshPages = function()
	local want = {}
	if grim and grim.Pages then
		for _, pg in ipairs(grim.Pages) do
			if not pg.Got and type(pg.P) == "table" then
				want[pg.I] = Vector3.new(pg.P[1], pg.P[2], pg.P[3])
			end
		end
	end
	if freshPending and inDialog() then return end     -- on attend la fin de la discussion
	local fresh = freshPending
	for i in pairs(pages) do
		if not want[i] and not BUSY[pages[i].state] then removePage(i, false) end
	end
	local spawned = 0
	for i, pos in pairs(want) do
		if not pages[i] and not pending[i] then spawnPage(i, pos, fresh) ; spawned += 1 end
	end
	if fresh and grim then
		freshPending = false
		if spawned > 0 then task.delay(0.3, function() hintBanner("The pages are out there!", "They float and sparkle. Look around!") end) end
	end
end

-- ✋ prompt : on DEMANDE au serveur (c'est lui qui vérifie tout) ; la page monte dans les airs en attendant
onPrompt = function(rec)
	local i = rec.i
	local now = os.clock()
	if pages[i] ~= rec or rec.state ~= "idle" or pending[i] or (rec.cool and now < rec.cool) or inDialog() then return end
	pending[i] = now
	actionRE:FireServer("page", i)
	rec.state = "rise"
	rec.riseT0 = now
	rec.riseFrom = rec.model:GetPivot()
	rec.prompt.Enabled = false
	FX.Sound("PageFly", rec.pp, 0.45)
	tween(rec.light, 0.6, { Brightness = 1.8, Range = UI.LightRange + 2 })
	tween(rec.hl, 0.3, { OutlineTransparency = 0, FillTransparency = 0.75 })
	rec.stars.Rate = UI.Stars * 4
end

-- ✅ le serveur dit oui : la page plonge vers toi et ÉCLATE en magie en entrant
local function catchPage(i, data)
	local rec = pages[i]
	pending[i] = nil
	if not rec then return end
	rec.data = data
	rec.confirmed = true
	if rec.state == "idle" or rec.state == "back" or rec.state == "appear" then   -- (rare) pas encore montée : on part de là
		rec.state = "hover"
		rec.riseFrom = rec.model:GetPivot()
	end
end

-- ❌ refusé : la page redescend doucement à sa place
local function returnPage(i)
	local rec = pages[i]
	pending[i] = nil
	if not rec or rec.state == "dive" then return end
	rec.state = "back"
	rec.backT0 = os.clock()
	rec.backFrom = rec.model:GetPivot()
	rec.cool = os.clock() + 2.5
	setPageAlpha(rec, 1)
	rec.stars.Rate = UI.Stars
	tween(rec.light, 0.6, { Brightness = UI.LightBrightness, Range = UI.LightRange })
	tween(rec.hl, 0.4, { FillTransparency = 1 })
end

-- 💥 l'éclat magique quand la page entre en toi
local function pageBurst(rec, target)
	FX.Burst(target, 0.75, { Color3.fromRGB(255, 236, 190), C_PU })
	FX.Sparkle(target, 26, seq(Color3.new(1, 1, 1), C_YE, C_PU), 7)
	FX.Sound("PageGet", nil, 0.6)
	local char = player.Character
	if char then   -- ton perso s'illumine une seconde
		local h = new("Highlight", { Name = "PageGlow", Adornee = char, FillColor = Color3.fromRGB(255, 226, 160), FillTransparency = 0.45,
			OutlineColor = Color3.new(1, 1, 1), OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.Occluded }, char)
		tween(h, 0.9, { FillTransparency = 1, OutlineTransparency = 1 })
		task.delay(1, function() h:Destroy() end)
	end
	local d = rec.data
	if d and d.AllFound then task.delay(0.7, function() celebrateAll() end) end
end

-- ════════════════════════════════════════════════════════════════
-- 🎞️ ANIMATION DES PAGES (une seule boucle)
-- ════════════════════════════════════════════════════════════════
local RISE_T, DIVE_T = 0.75, 0.5
RunService.Heartbeat:Connect(function(dt)
	local r = hrp()
	local me = r and r.Position
	local now = os.clock()
	local talking = inDialog()
	for i, rec in pairs(pages) do
		if not rec.model.Parent then pages[i] = nil continue end
		rec.t += dt
		local t = rec.t
		local d = me and (me - rec.home).Magnitude or math.huge
		if rec.state == "idle" or rec.state == "appear" then
			-- 🪶 debout, elle reste en place et tourne lentement sur elle-même (axe vertical)
			local bob = math.sin(t * UI.BobSpeed) * UI.BobHeight
			local cf = CFrame.new(rec.home + Vector3.new(0, bob, 0)) * CFrame.Angles(0, t * UI.SpinSpeed, 0)
			if rec.state == "appear" then
				local u = (now - rec.appearT) / 0.7
				if u >= 1 then rec.state = "idle" ; setPageAlpha(rec, 1)
				elseif u > 0 then
					setPageAlpha(rec, smooth(u))
					cf = cf * CFrame.new(0, (1 - smooth(u)) * -1.2, 0) * CFrame.Angles(0, (1 - u) * 6, 0)
				else
					setPageAlpha(rec, 0)
				end
			end
			rec.model:PivotTo(cf)
			rec.light.Brightness = UI.LightBrightness + math.sin(t * 1.3) * 0.12
			-- contour blanc quand tu es proche
			local want = (d <= UI.OutlineDistance and not talking) and 1 or 0
			rec.outline += (want - rec.outline) * math.min(1, dt * 6)
			rec.hl.OutlineTransparency = 1 - rec.outline * 0.95
			rec.hl.Enabled = rec.outline > 0.01
			rec.prompt.Enabled = rec.state == "idle" and not talking and not (rec.cool and now < rec.cool)
		elseif rec.state == "rise" or rec.state == "hover" then
			-- ⬆️ elle monte dans les airs en tournant (on attend le « oui » du serveur)
			local u = rec.state == "rise" and math.clamp((now - rec.riseT0) / RISE_T, 0, 1) or 1
			local e = 1 - (1 - u) ^ 3
			local top = rec.riseFrom.Position + Vector3.new(0, UI.RiseHeight, 0)
			local pos = rec.riseFrom.Position:Lerp(top, e) + Vector3.new(0, math.sin(t * 3) * 0.08 * e, 0)
			rec.spin = (rec.spin or (t * UI.SpinSpeed)) + dt * (1 + e * 7)
			rec.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rec.spin, 0) * CFrame.Angles(math.sin(t * 5) * 0.12 * e, 0, 0))
			rec.hl.Enabled = true
			if u >= 1 then rec.state = "hover" end
			if rec.state == "hover" and rec.confirmed then
				rec.state = "dive"
				rec.diveT0 = now
				rec.diveFrom = rec.model:GetPivot()
				FX.Sound("PageFly", rec.pp, 0.4)
				rec.stars.Rate = UI.Stars * 8
			elseif pending[i] and now - pending[i] > 5 then
				returnPage(i)                                 -- pas de réponse : elle redescend
				task.spawn(fetch)
			end
		elseif rec.state == "dive" then
			-- ⬇️ elle tournoie vers toi, plonge dans ta poitrine en accélérant, rapetisse… et éclate
			local u = math.clamp((now - rec.diveT0) / DIVE_T, 0, 1)
			local e = u * u * u
			local target = (r and (r.Position + Vector3.new(0, 0.6, 0))) or rec.home
			local from = rec.diveFrom.Position
			local mid = from:Lerp(target, 0.4) + Vector3.new(0, 1.2, 0)
			local q = 1 - e
			local pos = from * (q * q) + mid * (2 * q * e) + target * (e * e)
			rec.spin = (rec.spin or 0) + dt * 14
			rec.model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, rec.spin, 0))
			pcall(function() rec.model:ScaleTo(math.max(0.15, 1 - e * 0.85)) end)
			if u >= 1 then
				pageBurst(rec, target)
				pages[i] = nil
				rec.model:Destroy()
			end
		elseif rec.state == "back" then
			local u = math.clamp((now - rec.backT0) / 0.8, 0, 1)
			local e = 1 - (1 - u) ^ 3
			rec.model:PivotTo(rec.backFrom:Lerp(CFrame.new(rec.home), e))
			if u >= 1 then rec.state = "idle" end
		end
		if rec.fx.Parent then rec.fx.CFrame = CFrame.new(rec.model:GetPivot().Position) end
		if rec.promptPart.Parent and rec.state == "idle" then
			rec.promptPart.CFrame = CFrame.new(rec.home - Vector3.new(0, UI.PromptBelow, 0))
		end
		-- au loin : rien n'est calculé à l'écran
		local far = d > UI.ShowRadius
		if far ~= rec.far then
			rec.far = far
			rec.light.Enabled = not far
			rec.stars.Enabled = not far
			rec.motes.Enabled = not far
		end
	end
end)

