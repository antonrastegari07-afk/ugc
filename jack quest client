local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function tween(o, t, props, style, dir, delay)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out, 0, false, delay or 0), props)
	tw:Play()
	return tw
end
local function corner(o, r) return new("UICorner", { CornerRadius = r or UDim.new(0, 12) }, o) end
local function smooth(u) u = math.clamp(u, 0, 1) return u * u * (3 - 2 * u) end
local function seq(...)
	local cs = { ... }
	if #cs == 1 then return ColorSequence.new(cs[1]) end
	local kp = {}
	for i, c in ipairs(cs) do table.insert(kp, ColorSequenceKeypoint.new((i - 1) / (#cs - 1), c)) end
	return ColorSequence.new(kp)
end
local function nseq(...)
	local kp = {}
	for _, p in ipairs({ ... }) do table.insert(kp, NumberSequenceKeypoint.new(p[1], p[2])) end
	return NumberSequence.new(kp)
end
local function hrp()
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return nil end
	return c:FindFirstChild("HumanoidRootPart")
end
local function inDialog() return player:GetAttribute("InNpcDialog") == true end
local function isGamepad()
	local t = UserInputService:GetLastInputType()
	return t and t.Name:find("Gamepad") ~= nil
end

