_G.ShowProfileBlob = function()
	local ok, stored = pcall(function() return profileStore:GetAsync(PROFILE_BLOB_KEY) end)
	if not ok or type(stored) ~= "table" then
		warn("❌ Lecture du blob impossible")
		return
	end
	local n = 0
	for _ in pairs(stored) do n = n + 1 end
	local okEnc, json = pcall(function() return HttpService:JSONEncode(stored) end)
	print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
	print(string.format("📇 %s : %d fiche(s)", PROFILE_STORE_NAME, n))
	if okEnc then
		print(string.format("   Taille : %.1f KB  (plafond interne %.0f KB, limite Roblox 4096 KB)",
			#json / 1024, MAX_BLOB_BYTES / 1024))
	end
	print(string.format("   Plafond de fiches : %d", MAX_PROFILES))
	print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
end

