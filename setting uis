	local s = uiScale.Scale
	if s <= 0 then return end
	local need = (list.AbsoluteWindowSize.Y - lastSection.AbsoluteSize.Y) / s - 40
	spacer.Size = UDim2.new(1, 0, 0, math.max(0, math.floor(need)))
end
