			status.TextColor3 = Color3.fromRGB(255, 150, 120)
			return
		end
		FB.sending = true
		FB.refresh()
		task.spawn(function()
			local ok, res = pcall(function()
				return submitFn:InvokeServer(FB.selected, box.Text)
			end)
			FB.sending = false
			if ok and type(res) == "table" then
				if res.censored then
