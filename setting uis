	local m = matchPreset()
	if get("SettingPerfPreset") ~= m then setValue("SettingPerfPreset", m) end
	panelOpen = wasOpen

	for _, lst in pairs(watchers) do for _, fn in ipairs(lst) do pcall(fn) end end
	cover.Visible = false
end)

