			row.BackgroundTransparency = on and 0.25 or 1
			row.TextColor3             = on and Color3.fromRGB(255, 255, 255) or C_SUB
		end

		blocker.Visible     = (FB.selected == nil)
		box.TextEditable    = (FB.selected ~= nil)
		box.PlaceholderText = (FB.selected == nil)
			and "Pick a category above to start writing..."
			or  "Tell us what happened, what you'd change, or what you'd love to see..."

		local left  = FB.cdUntil - os.time()
		local ready = (FB.selected ~= nil) and n >= CFG.MIN_MESSAGE and not FB.sending and left <= 0

		if FB.sending then                 sendBtn.Text = "SENDING..."
		elseif left > 0 then               sendBtn.Text = "WAIT " .. left .. "s"
		elseif FB.selected == nil then     sendBtn.Text = "PICK A CATEGORY"
		elseif n < CFG.MIN_MESSAGE then    sendBtn.Text = "AT LEAST " .. CFG.MIN_MESSAGE .. " CHARACTERS"
		else                               sendBtn.Text = "SEND FEEDBACK" end

		sendBtn.BackgroundColor3 = ready and ACCENT_DEEP or C_TRACK_OFF
		sendBtn.TextColor3       = ready and Color3.fromRGB(255, 255, 255) or C_SUB
		sendStroke.Color         = ready and ACCENT or C_LINE
		FB.ready = ready

		if FB.refusedUntil and tick() < FB.refusedUntil then
			sendBtn.Text             = "REFUSED"
			sendBtn.BackgroundColor3 = Color3.fromRGB(205, 60, 60)
			sendBtn.TextColor3       = Color3.fromRGB(255, 255, 255)
			sendStroke.Color         = Color3.fromRGB(255, 130, 130)
			FB.ready = false
		end
	end
