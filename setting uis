				end
			else
				status.Text       = "⚠️ Couldn't send, please try again."
				status.TextColor3 = Color3.fromRGB(255, 150, 120)
			end

			if ok and type(res) == "table" and res.ok then
				FB.refresh()
			else
				FB.markRefused()
			end
		end)
	end)

