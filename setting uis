		Size = UDim2.new(1, -60, 1, 0), TextWrapped = false })
	local sign = title(b, { Text = "+", TextSize = 24, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 0), Size = UDim2.new(0, 40, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right })
	local open = false
