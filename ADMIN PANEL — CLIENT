		acTabBar(body, 3, {
			{ id = "vip",    label = "👑 VIP" },
			{ id = "weapon", label = "🔫 Armes" },
			{ id = "spins",  label = "🎡 Spins" },
		}, S.kind, GOLD, function(id) S.kind = id; screen(false) end)

		-- Filtres par statut / drapeau
		acTabBar(body, 4, {
			{ id = "all",      label = "📬 Tous" },
			{ id = "ok",       label = "✅ Livrés" },
			{ id = "pending",  label = "📦 En attente" },
			{ id = "fallback", label = "⚠️ Replis" },
		}, S.filter, GIFT, function(id) S.filter = id; screen(false) end)

		acTabBar(body, 5, {
			{ id = "_real",   label = "🎁 Achats seuls" },
			{ id = "_global", label = "🌍 Annoncés" },
			{ id = "_self",   label = "🪞 Auto-gifts" },
			{ id = "_legacy", label = "📦 Importés" },
		}, S.filter, C.PURPLE, function(id) S.filter = id; screen(false) end)

		-- Compteurs
		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 74 or 86)
		cf.BackgroundTransparency = 1
		cf.LayoutOrder = 6; cf.ZIndex = 11; cf.Parent = body
		local cLbl = label(cf, { text = "", size = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 52),
			wrapped = true, xAlign = Enum.TextXAlignment.Left, yAlign = Enum.TextYAlignment.Top,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		label(cf, {
			text = "👤 Touche le donneur (gauche) ou le receveur (droite) d'une carte pour ouvrir son profil.",
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16),
			position = UDim2.new(0, 0, 0, IS_MOBILE and 44 or 52),
			xAlign = Enum.TextXAlignment.Left, color = GIFT,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 11,
		})

		-- Un gift livré plus tard laisse DEUX lignes : l'achat, puis la
		-- confirmation « 🧾 ». Les totaux ne comptent que la première — dit
		-- ici, parce que sinon on croit à un doublon.
		label(cf, {
			text = "🧾 Une ligne « confirmation » = livraison différée d'un gift déjà listé. « 🎁 Achats seuls » les masque.",
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16),
			position = UDim2.new(0, 0, 0, IS_MOBILE and 58 or 68),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 11,
		})

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 7; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local render
		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end

			local list = visible()
			local shownPts = 0
			for _, e in ipairs(list) do shownPts = shownPts + (e.p or 0) end

			local t = S.totals or {}
			local bk = (type(t.byKind) == "table") and t.byKind or {}

			-- Récap par type : c'est là qu'on voit d'un coup si un type
			-- explose par rapport aux autres.
			local parts = {}
			for _, k in ipairs(K_ORDER) do
				local n = tonumber(bk[k]) or 0
				if n > 0 then
					table.insert(parts, K[k].e .. " " .. n)
				end
			end

			cLbl.Text = string.format(
				"%d affiché(s) · %s pts affichés  •  %d chargé(s)\n"
					.. "TOTAL JEU : %d gift(s) · %s pts · %d en attente · %d auto-gift(s)\n%s",
				#list, fmtNum(shownPts), #S.entries,
				t.all or 0, fmtNum(t.points or 0), t.pending or 0, t.selfGifts or 0,
				(#parts > 0) and ("PAR TYPE : " .. table.concat(parts, "  ·  ")) or "")

			if #list == 0 then
				local msg
				if S.loading then msg = "Chargement du journal..."
				elseif not getLog then msg = "❌ GiftLog_Server.lua pas installé côté serveur."
				elseif #S.entries == 0 then
					msg = "Aucun gift enregistré.\n\nSi des gifts ont déjà eu lieu, l'import "
						.. "automatique de GiftPurchaseLog_v1 tourne 40 s après le démarrage "
						.. "du serveur — reviens dans une minute, ou lance-le à la main depuis "
						.. "l'onglet 🏆 Classements."
				else msg = "Rien ne correspond à ces filtres." end
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 90); f.BackgroundTransparency = 1
				f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
				label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
			else
				for i, e in ipairs(list) do giftCard(holder, i, e, back) end
			end

			if S.hasMore then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = holder
				local mb, mlbl = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger plus", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					if S.loading then return end
					S.loading = true
					mlbl.Text = "⏳ Chargement..."
					task.spawn(function()
						local ok, res = pcall(function() return getLog:InvokeServer(S.cursor, 30) end)
						S.loading = false
						if ok and type(res) == "table" and res.throttled then
							toast("Trop rapide, réessaie dans 1 s", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
							return
						end
						if ok and type(res) == "table" then
							local ids = {}
							for _, e in ipairs(res.entries or {}) do
								table.insert(S.entries, e)
								table.insert(ids, e.su); table.insert(ids, e.ru)
							end
							S.cursor  = res.cursor
							S.hasMore = res.hasMore == true
							if res.totals then S.totals = res.totals end
							resolveUsernames(ids, function()
								resolvePoints(ids, function()
									if holder and holder.Parent then render() end
								end)
							end)
						else
							toast("Chargement impossible", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
						end
					end)
				end)
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text; render()
		end)

		render()
	end

	----------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "giftlog"
		if reset then
			S.entries, S.cursor, S.hasMore = {}, nil, false
			S.loaded = false
			S.top = nil
		end

		local body = buildScreen("🎁 GIFT LOG", true, GIFT, nil, function() screen(true) end)

		acTabBar(body, 0, {
			{ id = "log", label = "📜 Journal" },
			{ id = "top", label = "🏆 Classements" },
		}, S.tab, GIFT, function(id) S.tab = id; screen(false) end)

		local function refreshIfStillHere(tab)
			if currentScreen == "giftlog" and window.Visible and S.tab == tab then
				screen(false)
			end
		end

		if not getLog then
			noteCard(body, 1, "❌ GiftLog_Server.lua (v2) n'est pas installé dans "
				.. "ServerScriptService.\nAjoute-le, puis redémarre le serveur.", C.RED)
			return
		end

		if S.tab == "top" then
			renderTop(body)
			return
		end

		-- Journal : une seule tentative automatique
		if not S.loaded and not S.loading then
			S.loading = true
			task.spawn(function()
				local ok, res = pcall(function() return getLog:InvokeServer(nil, 30) end)
				S.loading = false
				if ok and type(res) == "table" and res.throttled then
					task.wait(1.5)
					refreshIfStillHere("log")
					return
				end
				S.loaded = true
				if ok and type(res) == "table" then
					S.entries = res.entries or {}
					S.cursor  = res.cursor
					S.hasMore = res.hasMore == true
					S.totals  = res.totals
					S.session = res.session
					local ids = {}
					for _, e in ipairs(S.entries) do
						table.insert(ids, e.su); table.insert(ids, e.ru)
					end
					resolveUsernames(ids, function()
						resolvePoints(ids, function() refreshIfStillHere("log") end)
					end)
				else
					refreshIfStillHere("log")
				end
			end)
		end

		renderJournal(body)
	end

	----------------------------------------------------------------------
	-- 👤 CARTE "GIFTS" — injectée dans tous les profils
	----------------------------------------------------------------------
	local function giftProfileCard(parent, order, userId)
		if not getPlayer then return end

		local host = Instance.new("Frame")
		host.Size = UDim2.new(1, 0, 0, 0)
		host.AutomaticSize = Enum.AutomaticSize.Y
		host.BackgroundColor3 = C.BG_DARK
		host.BorderSizePixel = 0
		host.LayoutOrder = order
		host.ZIndex = 11
		host.Parent = parent
		corner(host, 10); stroke(host, GIFT, 1)

		label(host, { text = "🎁 GIFTS", size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
			color = GIFT, textSize = IS_MOBILE and 11 or 14, zIndex = 12 })

		local rows = Instance.new("Frame")
		rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
		rows.Size = UDim2.new(1, 0, 0, 0)
		rows.AutomaticSize = Enum.AutomaticSize.Y
		rows.BackgroundTransparency = 1
		rows.ZIndex = 12
		rows.Parent = host

		local rl = Instance.new("UIListLayout"); rl.Padding = UDim.new(0, 2)
		rl.SortOrder = Enum.SortOrder.LayoutOrder; rl.Parent = rows
		local rp = Instance.new("UIPadding")
		rp.PaddingBottom = UDim.new(0, 8); rp.PaddingLeft = UDim.new(0, 10)
		rp.PaddingRight = UDim.new(0, 10); rp.Parent = rows

		local function line(o, key, val, col)
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
			row.BackgroundTransparency = 1
			row.LayoutOrder = o; row.ZIndex = 13; row.Parent = rows
			label(row, { text = key, size = UDim2.new(0.55, 0, 1, 0), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 13, truncate = true, zIndex = 14 })
			label(row, { text = tostring(val), size = UDim2.new(0.45, 0, 1, 0),
				position = UDim2.new(0.55, 0, 0, 0), xAlign = Enum.TextXAlignment.Right,
				color = col or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 13,
				truncate = true, zIndex = 14 })
			return row
		end

		--  Une ligne d'historique :
		--    [pfp de l'autre]  ▶/◀  [🔫]  Nom de l'objet      quand
		--                             son nom à lui
		--  Un clic ouvre le profil de CET autre joueur.
		local function histLine(o, e, isSent)
			local other = isSent and (tonumber(e.ru) or 0) or (tonumber(e.su) or 0)
			local oname = unameCache[other]
				or (isSent and (e.rn or e.rd) or (e.sn or e.sd))
				or tostring(other)
			local km  = kMeta(ek(e))
			local lbl = itemLabel(e)
			local isPoints = (ek(e) == "points")

			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
			row.BackgroundColor3 = C.BG_ITEM
			row.BackgroundTransparency = 1
			row.AutoButtonColor = false
			row.Text = ""
			row.BorderSizePixel = 0
			row.LayoutOrder = o
			row.ZIndex = 13
			row.Parent = rows
			corner(row, 6)

			local s = IS_MOBILE and 24 or 28
			local av = makeAvatar(row, other, s, isSent and RECV or GIFT)
			av.AnchorPoint = Vector2.new(0, 0.5)
			av.Position = UDim2.new(0, 2, 0.5, 0)

			-- Sens du gift, en couleur : rose = il donne, bleu = il reçoit
			label(row, {
				text = isSent and "▶" or "◀",
				size = UDim2.new(0, 12, 1, 0),
				position = UDim2.new(0, s + 5, 0, 0),
				color = isSent and GIFT or RECV,
				textSize = IS_MOBILE and 11 or 13, zIndex = 14,
			})

			-- Vignette de l'objet : c'est elle qui dit ce qui a changé de main
			local thumbS = IS_MOBILE and 22 or 26
			local th = itemThumb(row, e, thumbS, 14)
			th.AnchorPoint = Vector2.new(0, 0.5)
			th.Position = UDim2.new(0, s + 19, 0.5, 0)

			local tx   = s + 19 + thumbS + 7
			local valW = IS_MOBILE and 92 or 118
			local dirCol = isSent and RECV or GIFT

			local nameLbl = label(row, {
				text = lbl,
				size = UDim2.new(1, -tx - valW - 6, 0, IS_MOBILE and 15 or 18),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 4 or 5),
				xAlign = Enum.TextXAlignment.Left, color = km.c,
				textSize = IS_MOBILE and 11 or 13, truncate = true, zIndex = 14,
			})
			label(row, {
				text = (isSent and "à " or "de ") .. esc(oname),
				size = UDim2.new(1, -tx - valW - 6, 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, tx, 0, IS_MOBILE and 19 or 23),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 14,
			})

			local right = (isPoints and ("💎 " .. fmtNum(e.p or 0) .. "\n") or
				(stMeta(e.st).l .. "\n")) .. fmtWhen(e)
			label(row, {
				text = right,
				size = UDim2.new(0, valW, 1, 0),
				position = UDim2.new(1, -4, 0.5, 0), anchor = Vector2.new(1, 0.5),
				xAlign = Enum.TextXAlignment.Right,
				color = isPoints and GOLD or stMeta(e.st).c,
				textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 14,
			})

			row.MouseEnter:Connect(function()
				row.BackgroundTransparency = 0.4
				nameLbl.TextColor3 = dirCol
			end)
			row.MouseLeave:Connect(function()
				row.BackgroundTransparency = 1
				nameLbl.TextColor3 = km.c
			end)
			row.MouseButton1Click:Connect(function()
				screenManage({ userId = other, displayName = oname, username = oname,
					sub = isSent and ("📥 A reçu " .. lbl .. " de ce joueur")
						or ("🎁 A offert " .. lbl .. " à ce joueur") },
				function() openProfileDetail(unameCache[userId] or tostring(userId), nil) end)
			end)

			return row
		end

		line(1, "Chargement...", "", C.TEXT_DIM)

		task.spawn(function()
			-- Le serveur limite les appels rapprochés. Comme le panel ouvre
			-- parfois deux cartes GIFTS d'affilée (fiche + profil), on retente
			-- une fois plutôt que d'afficher « aucune donnée » à tort.
			local ok, res = pcall(function() return getPlayer:InvokeServer(userId, false) end)
			if ok and type(res) == "table" and res.throttled then
				task.wait(0.6)
				if not host.Parent then return end
				ok, res = pcall(function() return getPlayer:InvokeServer(userId, false) end)
			end
			if not host.Parent then return end

			for _, ch in ipairs(rows:GetChildren()) do
				if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
			end

			if not (ok and type(res) == "table" and res.ok and type(res.record) == "table") then
				line(1, "Aucune donnée de gift", "—", C.TEXT_DIM)
				return
			end

			local d = res.record
			local sent, sentPts = d.s or 0, d.sp or 0
			local recv, recvPts = d.r or 0, d.rp or 0
			local sk = (type(d.sk) == "table") and d.sk or {}
			local rk = (type(d.rk) == "table") and d.rk or {}

			if sent == 0 and recv == 0 then
				line(1, "Ce joueur n'a jamais gift ni reçu", "—", C.TEXT_DIM)
				return
			end

			-- Résumé : deux lignes, une par sens.
			line(1, "🎁 Il a offert",
				sent .. (sent > 1 and " gifts" or " gift") .. "  ·  💎 " .. fmtNum(sentPts),
				sent > 0 and GIFT or C.TEXT_DIM)
			line(2, "📥 Il a reçu",
				recv .. (recv > 1 and " gifts" or " gift") .. "  ·  💎 " .. fmtNum(recvPts),
				recv > 0 and RECV or C.TEXT_DIM)

			local bal = sentPts - recvPts
			line(3, "⚖️ Solde points",
				(bal >= 0 and "+" or "−") .. fmtNum(math.abs(bal)) .. " pts",
				bal >= 0 and GIFT or RECV)

			-- 🧩 Détail par type — offert vs reçu, sur la même ligne.
			--    C'est ce qui permet de voir en un regard qu'un joueur a reçu
			--    six boosts permanents sans jamais rien offrir.
			local hasKinds = false
			for _, k in ipairs(K_ORDER) do
				if (tonumber(sk[k]) or 0) > 0 or (tonumber(rk[k]) or 0) > 0 then hasKinds = true end
			end
			if hasKinds then
				line(9, "── 🧩 DÉTAIL PAR TYPE ──", "offert / reçu", C.TEXT_DIM)
				local o = 10
				for _, k in ipairs(K_ORDER) do
					local a = tonumber(sk[k]) or 0
					local b = tonumber(rk[k]) or 0
					if a > 0 or b > 0 then
						o = o + 1
						line(o, "  " .. K[k].e .. " " .. K[k].l,
							tostring(a) .. " / " .. tostring(b), K[k].c)
					end
				end
				-- Fiche antérieure à la v2 : le serveur a reconstruit ce
				-- détail depuis l'historique conservé. Le dire évite de
				-- prendre un chiffre partiel pour un total.
				if d.skPartial or d.rkPartial then
					line(19, "  ⚠️ Détail reconstruit",
						"partiel (30 derniers)", C.ORANGE)
				end
			end

			-- Ce qu'il a offert
			local hs = d.hs or {}
			if #hs > 0 then
				line(20, "── 🎁 CE QU'IL A OFFERT ──", "", C.TEXT_DIM)
				local n, ids = 0, {}
				for i = #hs, 1, -1 do
					n = n + 1
					if n > 12 then break end
					table.insert(ids, tonumber(hs[i].ru) or 0)
					histLine(20 + n, hs[i], true)
				end
				resolveUsernames(ids, function() end)
			end

			-- Ce qu'il a reçu
			local hr = d.hr or {}
			if #hr > 0 then
				line(50, "── 📥 CE QU'IL A REÇU ──", "", C.TEXT_DIM)
				local n, ids = 0, {}
				for i = #hr, 1, -1 do
					n = n + 1
					if n > 12 then break end
					table.insert(ids, tonumber(hr[i].su) or 0)
					histLine(50 + n, hr[i], false)
				end
				resolveUsernames(ids, function() end)
			end
		end)

		return host
	end

	-- 👤 Profils — LayoutOrder 12 = juste après les cartes UGC
	--    (🎽 UGC REDEEMED = 10, 🔐 UGC ESCROW = 11, 🎁 GIFTS = 12)
	local previousRenderProfile = renderProfile
	renderProfile = function(body, profile)
		previousRenderProfile(body, profile)
		if type(profile) == "table" and not profile.error and profile.userId then
			giftProfileCard(body, 12, profile.userId)
		end
	end

	-- 👤 Fiches "MANAGE PLAYER"
	local previousScreenManage = screenManage
	screenManage = function(info, backFn)
		previousScreenManage(info, backFn)
		if type(info) ~= "table" or not info.userId then return end
		local body = window:FindFirstChildOfClass("ScrollingFrame")
		if not body then return end
		giftProfileCard(body, 501, info.userId)
	end

	----------------------------------------------------------------------
	-- 🔗 AUTO-ENREGISTREMENT DANS LE MENU
	----------------------------------------------------------------------
	table.insert(ACTIONS, { id = "giftlog", name = "🎁 GIFT LOG", color = GIFT })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "giftlog" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

