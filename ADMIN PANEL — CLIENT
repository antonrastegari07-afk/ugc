	--════════════════════════════════════════════════════════════════════
	-- 📡 APPELS SERVEUR
	--    Même correctif que le bloc 8 : une limitation de débit renvoie
	--    `throttled` et on réessaie tout seul, au lieu d'afficher une
	--    fausse erreur et de se bloquer.
	--════════════════════════════════════════════════════════════════════
	local function callAct(action, payload, onDone, attempt)
		local fn = remote("AdminUGCRestrictAction")
		if not fn then toast("Module serveur pas installé", false) return end
		attempt = attempt or 1
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" and res.throttled then
				if attempt < 3 then
					task.wait(0.35 * attempt)
					callAct(action, payload, onDone, attempt + 1)
				else
					toast("Le serveur est saturé, réessaie dans un instant", false)
					if onDone then onDone(nil) end
				end
				return
			end
			if ok and type(res) == "table" then
				if res.msg then toast(res.msg, res.ok == true) end
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

	--════════════════════════════════════════════════════════════════════
	-- 🗂️ BROUILLON
	--
	--    On édite une COPIE locale, et on n'envoie au serveur que lorsque
	--    tu cliques sur ENREGISTRER. Deux raisons :
	--      • une écriture DataStore par clic de bouton, c'était exactement
	--        ce qui déclenchait « tu vas trop vite » ;
	--      • tu peux modifier plusieurs réglages puis annuler d'un coup.
	--════════════════════════════════════════════════════════════════════
	local DEF_MODES = {
		ban = { warningsToPunish = 3, kickBeforeBan = true, banDays = 0,
			alsoRestrictUGC = true, wipePoints = false, notifyBeforeKick = true },
		ugc = { warningsToPunish = 2, durationHours = 0, kickOnPunish = false,
			notifyOnPunish = true, remindOnJoin = true, blockGifts = true,
			blockRebirth = false },
		test = { correctPosition = false, notifyPlayer = false, logToConsole = true,
			separateStore = true, suggestAfterDays = 5 },
	}

	local function deepCopy(t)
		if type(t) ~= "table" then return t end
		local o = {}
		for k, v in pairs(t) do o[k] = deepCopy(v) end
		return o
	end

	--  Le brouillon est TOUJOURS complet : si le serveur tourne encore une
	--  ancienne config sans la section `modes`, on la reconstitue à partir
	--  des défauts. Comme ça le panel ne peut pas afficher un champ vide ni
	--  envoyer une config trouée.
	local function ensureDraft()
		if S.draft then return S.draft end
		local base = deepCopy(S.cfg or {})
		base.modes = base.modes or {}
		for name, def in pairs(DEF_MODES) do
			base.modes[name] = base.modes[name] or {}
			for k, v in pairs(def) do
				if base.modes[name][k] == nil then base.modes[name][k] = v end
			end
		end
		base.messages = base.messages or {}
		S.draft = base
		return base
	end

	local function setDraft(path, value)
		local d = ensureDraft()
		local t = d
		for i = 1, #path - 1 do
			t[path[i]] = t[path[i]] or {}
			t = t[path[i]]
		end
		t[path[#path]] = value
		S.dirty = true
	end

	local function getDraft(path, fallback)
		local t = ensureDraft()
		for i = 1, #path do
			if type(t) ~= "table" then return fallback end
			t = t[path[i]]
		end
		if t == nil then return fallback end
		return t
	end

	local function saveDraft()
		local d = ensureDraft()
		callAct("setconfig", { config = d }, function(res)
			if res and res.ok then
				S.cfg, S.draft, S.dirty = nil, nil, false
				S.failed, S.failMsg = false, nil
				toast("✅ Réglages enregistrés et diffusés à tous tes serveurs", true)
			end
			screen(false)
		end)
	end

	--════════════════════════════════════════════════════════════════════
