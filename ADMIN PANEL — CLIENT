-- filtre + tri appliqués côté client sur ce qui est déjà chargé (0 requête)
local function fbVisible()
	local out = {}
	local q = tostring(fbState.search or ""):lower()
	for _, e in ipairs(fbState.entries) do
		local okCat = (fbState.cat == "all") or (e.c == fbState.cat)
		local okSt  = (fbState.status == "all")
			or (fbState.status == "unread" and e.read ~= true)
			or (fbState.status == "read"   and e.read == true)
		local okQ = true
		if #q > 0 then
			local uname = (unameCache[tonumber(e.u) or 0] or ""):lower()
			okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.d or ""):lower():find(q, 1, true) ~= nil)
				or (uname:find(q, 1, true) ~= nil)
				or (tostring(e.m or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.u) == q)
		end
		if okCat and okSt and okQ then table.insert(out, e) end
	end

	local s = fbState.sort
	table.sort(out, function(a, b)
		if s == "old" then return (a.t or 0) < (b.t or 0) end
		if s == "points" then
			local pa = pointsFor(tonumber(a.u) or 0) or -1
			local pb = pointsFor(tonumber(b.u) or 0) or -1
			if pa ~= pb then return pa > pb end
			return (a.t or 0) > (b.t or 0)
		end
		if s == "unread" then
			local ua, ub = (a.read ~= true), (b.read ~= true)
			if ua ~= ub then return ua end
			return (a.t or 0) > (b.t or 0)
		end
		return (a.t or 0) > (b.t or 0)   -- "new"
	end)
	return out
end

