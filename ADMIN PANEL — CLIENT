		end
		paintOpt()
		opt.MouseButton1Click:Connect(function() GS.skipDup = not GS.skipDup; paintOpt() end)

		----------------------------------------------------------------
		-- 🧍 JOUEURS
		----------------------------------------------------------------
		local list = Players:GetPlayers()
		table.sort(list, function(a, b)
			if a == b then return false end
