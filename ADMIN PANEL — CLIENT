-- 🎁 BLOC 2 — SECTION GIFT LOG   ⟦ v2 — TOUS LES TYPES DE GIFT ⟧
--
--  ⚠️ CE BLOC REMPLACE INTÉGRALEMENT TON ANCIEN BLOC 2.
--     Supprime l'IIFE qui commence par :
--         ;(function()
--             local GOLD   = Color3.fromRGB(255, 205, 60)
--             local GIFT   = Color3.fromRGB(255, 140, 200)
--     ...jusqu'à son `end)()`, et colle celui-ci à la place (même endroit,
--     entre le bloc 1 🚫 BANS et le bloc 3 🔐 ESCROW).
--
--  Ce qui change :
--     • Le fil affiche l'ICÔNE et le NOM de ce qui a été offert — plus
--       seulement un montant de points. Une arme, un VIP, un boost x25 de
--       30 min : chacun a sa tête et sa couleur.
--     • Nouvelle rangée de filtres PAR TYPE (points / boosts / VIP / armes /
--       spins), en plus des filtres par statut.
--     • Les statuts « 📦 En attente » et « ✅ Livré » sont enfin reconnus
--       (avant, tout s'affichait en gris « ? »).
--     • La carte 🎁 GIFTS d'un profil détaille CE QU'IL A OFFERT ET REÇU
--       PAR TYPE, et l'historique montre l'objet, pas juste des points.
--     • Le message personnalisé écrit par le joueur s'affiche tel quel.
--
--  Prérequis serveur : GiftLog_Server.lua (v2) dans ServerScriptService.
--════════════════════════════════════════════════════════════════════════════

;(function()
	local GOLD   = Color3.fromRGB(255, 205, 60)
	local GIFT   = Color3.fromRGB(255, 140, 200)
	local GIFT_D = Color3.fromRGB(150, 50, 105)
	local RECV   = Color3.fromRGB(120, 220, 255)

	local getLog    = ReplicatedStorage:WaitForChild("AdminGetGiftLog", 10)
	local getPlayer = ReplicatedStorage:WaitForChild("AdminGetGiftPlayer", 10)
	local getTop    = ReplicatedStorage:WaitForChild("AdminGetGiftTop", 10)
	local doAct     = ReplicatedStorage:WaitForChild("AdminGiftAction", 10)

	if not getLog then
		warn("[Admin] AdminGetGiftLog introuvable → ajoute GiftLog_Server.lua (v2) "
			.. "dans ServerScriptService")
	end

	-- Config des gifts : sert de repli pour l'icône et le libellé quand une
	-- vieille ligne du journal n'en a pas (fiches d'avant la v2).
	local GCFG
	pcall(function()
		local m = ReplicatedStorage:WaitForChild("GIFT_CONFIG", 8)
		if m then GCFG = require(m) end
	end)

	----------------------------------------------------------------------
	-- 🎨 LES SIX TYPES
	----------------------------------------------------------------------
	local K = {
		points     = { l = "Points",         tag = "POINTS", c = GOLD,                        e = "💎" },
		boost_temp = { l = "Boost temporaire",tag = "TEMP",  c = Color3.fromRGB(255, 165, 60), e = "⏱️" },
		boost_perm = { l = "Boost permanent", tag = "PERM",  c = Color3.fromRGB(180, 130, 255),e = "♾️" },
		vip        = { l = "VIP",             tag = "VIP",   c = Color3.fromRGB(255, 225, 120),e = "👑" },
		weapon     = { l = "Arme PVP",        tag = "GUN",   c = Color3.fromRGB(255, 110, 110),e = "🔫" },
		spins      = { l = "Spins",           tag = "SPINS", c = Color3.fromRGB(140, 235, 190),e = "🎡" },
	}
	local K_ORDER = { "points", "boost_temp", "boost_perm", "vip", "weapon", "spins" }

	--  Type d'une entrée. Les lignes écrites AVANT que les autres types
	--  existent n'ont pas de champ `k` : à l'époque un gift ne pouvait être
	--  que des points, donc on les classe là plutôt que de les afficher en
	--  « ? » gris au milieu du fil.
	local function ek(e)
		local k = e and e.k
		if k == nil or k == "" then return "points" end
		return tostring(k)
	end

	local function kMeta(k)
		return K[tostring(k or "")] or
			{ l = tostring(k or "?"), tag = "?", c = C.TEXT_GREY, e = "🎁" }
	end

	----------------------------------------------------------------------
