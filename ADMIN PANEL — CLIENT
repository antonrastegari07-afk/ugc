		corner(wrap, 9); stroke(wrap, opt.color or VIOLET, 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 5); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = wrap
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 7); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = wrap

		label(wrap, { text = opt.title,
			size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22),
			xAlign = Enum.TextXAlignment.Left, color = opt.color or VIOLET,
			textSize = IS_MOBILE and 10 or 13, zIndex = 12 })

		if opt.desc then
			local d = Instance.new("TextLabel")
			d.Size = UDim2.new(1, 0, 0, 0)
			d.AutomaticSize = Enum.AutomaticSize.Y
			d.BackgroundTransparency = 1
			d.Font = Enum.Font.Gotham
			d.Text = opt.desc
			d.TextColor3 = C.TEXT_DIM
			d.TextSize = IS_MOBILE and 9 or 11
			d.TextWrapped = true
			d.TextXAlignment = Enum.TextXAlignment.Left
			d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = wrap
		end

		local boxH = opt.multiline and (IS_MOBILE and 96 or 120) or (IS_MOBILE and 30 or 36)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, boxH)
		holder.BackgroundColor3 = C.BG_LIGHT
		holder.BorderSizePixel = 0
		holder.LayoutOrder = 3; holder.ZIndex = 12; holder.Parent = wrap
		corner(holder, 7); stroke(holder, C.BORDER_SUBTLE, 1)

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, -14, 1, -10)
		box.Position = UDim2.new(0, 7, 0, 5)
		box.BackgroundTransparency = 1
		box.Font = Enum.Font.Gotham
		box.Text = tostring(opt.value or "")
		box.PlaceholderText = opt.placeholder or "(vide = texte par défaut)"
		box.TextColor3 = C.TEXT_WHITE
		box.PlaceholderColor3 = C.TEXT_DIM
		box.TextSize = IS_MOBILE and 10 or 12
		box.TextWrapped = true
		box.ClearTextOnFocus = false
		box.MultiLine = opt.multiline == true
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextYAlignment = opt.multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
		box.ZIndex = 13
		box.Parent = holder

		--  On n'écrit dans le brouillon qu'à la sortie du champ : pas de
		--  re-rendu pendant la frappe, donc pas de curseur qui saute.
		box.FocusLost:Connect(function()
			local v = box.Text
			if #v > 1200 then
				v = v:sub(1, 1200)
				box.Text = v
				toast("Texte coupé à 1200 caractères", false)
			end
			if v ~= tostring(opt.value or "") then
				setDraft(opt.path, v)
				--  Re-rendu différé : laisse le clavier mobile se fermer
				--  proprement avant qu'on redessine l'écran.
				task.defer(function() screen(false) end)
			end
		end)
		return box
	end

	--════════════════════════════════════════════════════════════════════
	-- 👁️ APERÇU — rendu identique à celui du serveur
	--    Les mêmes variables, les mêmes règles. Ce que tu lis ici est
	--    exactement ce que le joueur verra, à un détail près : ici on
	--    affiche toujours {confidence}, pour que tu puisses vérifier ta
	--    phrase même quand tu as choisi de la cacher aux joueurs.
	--════════════════════════════════════════════════════════════════════
	local SAMPLE = {
		player = "SomePlayer", type = "TELEPORT", typefr = "téléportation",
		warnings = "1", max = "2", left = "1", confidence = "88", game = "ton obby",
	}
	local function preview(tpl)
		if type(tpl) ~= "string" or tpl == "" then return "(vide → texte par défaut)" end

		--  🔐 On reproduit EXACTEMENT la règle du serveur : quand l'affichage
		--     de la certitude est coupé, la ligne qui contient {confidence}
		--     est retirée en entier. Sans ça, l'aperçu te montrerait un texte
		--     que le joueur ne verra jamais — le pire défaut possible pour
		--     un aperçu.
		if getDraft({ "messages", "showConfidenceToPlayer" }, false) ~= true
			and tpl:find("{confidence}", 1, true) then
			local kept = {}
			for line in (tpl .. "\n"):gmatch("([^\n]*)\n") do
				if not line:find("{confidence}", 1, true) then
					table.insert(kept, line)
				end
			end
			tpl = table.concat(kept, "\n")
			tpl = tpl:gsub("\n\n\n+", "\n\n"):gsub("^%s*\n", "")
		end

		local out = tpl:gsub("{(%w+)}", function(k)
			return SAMPLE[k] or ("{" .. k .. "}")
		end)
		return (out:gsub("\\n", "\n"))
	end

	local function previewBox(parent, order, tpl)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = Color3.fromRGB(24, 12, 12)
		f.BorderSizePixel = 0
		f.LayoutOrder = order; f.ZIndex = 11; f.Parent = parent
		corner(f, 8); stroke(f, RED_D, 1)
