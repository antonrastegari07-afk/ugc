	------------------------------------------------------------------
	-- ✏️ ÉCRAN « CONSTRUIRE UN ÉVÉNEMENT »
	------------------------------------------------------------------
	local function renderEdit(body)
		local w = S.edit
		if not w or not CFG then S.view = nil ; screen(false) return end

		big(body, -3, "\u{2039}  BACK (nothing is saved yet)", C.BG_LIGHT, C.BORDER_BRIGHT,
			function() S.view = nil ; S.edit = nil ; disarm() ; screen(false) end,
			IS_MOBILE and 36 or 40)

		note(body, -2, "Start with a sky and a particle effect - that alone makes a good "
			.. "event. The light, the fog and the glow are all optional and all "
			.. "start OFF.", INFO)

		local n = 0
		for _, sec in ipairs(CFG.SIMPLE_SCHEMA) do
			n = n + 1 ; head(body, n, sec.title)
			if sec.blurb then n = n + 1 ; note(body, n, sec.blurb, C.TEXT_DIM) end

			for _, f in ipairs(sec.fields) do
				n = n + 1
				local key = f.key

				if f.kind == "text" then
					n = textRow(body, n, f.label, w[key], f.maxLen,
						function(v) w[key] = v end, f.help,
						key == "msg" and "Written for you if you leave it empty" or nil) - 1

				elseif f.kind == "num" then
					local quick = nil
					if key == "duration" then
						quick = { { label = "1 min", v = 60 }, { label = "2 min", v = 120 },
							{ label = "3 min", v = 180 }, { label = "5 min", v = 300 },
							{ label = "10 min", v = 600 } }
					elseif key == "boost" then
						quick = { { label = "Off", v = 0 }, { label = "+2", v = 2 },
							{ label = "+5", v = 5 }, { label = "+10", v = 10 },
							{ label = "+25", v = 25 } }
					elseif key == "fxAmount" then
						quick = { { label = "Light", v = 50 }, { label = "Normal", v = 100 },
							{ label = "Heavy", v = 160 } }
					end
					local fmt = nil
					if key == "duration" then fmt = mmss
					elseif key == "fxAmount" then fmt = function(v) return tostring(v) .. "%" end end
					n = numberRow(body, n, f.label, w[key], f.min, f.max, f.step,
						function(v) w[key] = v ; screen(false) end, f.help, fmt, quick) - 1

				elseif f.kind == "bool" then
					n = toggleRow(body, n, f.label, w[key] == true,
						function(v) w[key] = v ; screen(false) end, f.help) - 1

				elseif f.kind == "color" then
					n = colorRow(body, n, f.label, w[key],
						function(v) w[key] = v ; screen(false) end, f.help) - 1

				elseif f.kind == "sky" or f.kind == "music" or f.kind == "tool" then
					local list, empty, intro
					if f.kind == "sky" then
						list  = skyChoices()
						empty = "Keep the current sky"
						intro = (#list <= 1) and ("Your sky folder is empty. Create a folder "
							.. "called \"" .. CFG.SKY_FOLDER .. "\" in ReplicatedStorage and "
							.. "drop Sky objects into it - they show up here instantly.") or nil
					elseif f.kind == "music" then
						list  = musicChoices()
						empty = "No music"
						intro = (#list <= 1) and ("No music found. Create a folder called \""
							.. CFG.MUSIC_FOLDER .. "\" in ReplicatedStorage and put Sound "
							.. "objects inside.") or nil
					else
						list  = toolChoices()
						empty = "No item"
						intro = (#list <= 1) and ("No item found. Create a folder called \""
							.. CFG.TOOLS_FOLDER .. "\" in ServerStorage and put your Tools "
							.. "inside (magic carpet, jetpack, coils, guns...).") or nil
					end
					local shown = (w[key] == "" or w[key] == nil) and empty or w[key]
					choiceRow(body, n, f.label, shown, function()
						openPick(string.upper(f.label), list, w[key],
							function(v) w[key] = v end, intro)
					end, f.help)
					n = n + 2

				elseif f.kind == "asset" then
					n = textRow(body, n, f.label, tostring(w[key] or 0), 20,
						function(v) w[key] = tonumber(v:match("%d+")) or 0 end,
						f.help, "0") - 1

				else -- choice
					choiceRow(body, n, f.label, labelOf(f.choices, w[key], "?"), function()
						openPick(string.upper(f.label), f.choices, w[key],
							function(v) w[key] = v end, f.help)
					end, f.help)
					n = n + 2
				end
			end
			n = n + 1 ; spacer(body, n, 8)
		end

		n = n + 1
		big(body, n, S.editNew and "CREATE THIS EVENT" or "SAVE CHANGES", OK_C, OK_D, function()
			--  On efface la note auto pour qu'elle soit réécrite d'après les
			--  nouveaux choix : sinon un ancien résumé survivrait à une
			--  modification et dirait le contraire de la réalité.
			local before = findEvent(S.editId)
			if before and before.desc == w.desc then w.desc = "" end
			srvAct("saveWeather", w, function(ok)
				if ok then S.loaded = false ; S.view = nil ; S.edit = nil end
			end)
		end)

		if not S.editNew and S.editId and S.custom[S.editId] then
			n = n + 1
			local a = armed("delW")
			big(body, n, a and "PRESS AGAIN TO DELETE" or "Delete this event",
				a and C.RED or C.BG_LIGHT, a and C.RED_DARK or C.BORDER_BRIGHT, function()
					if not a then arm("delW") ; screen(false) return end
					disarm()
					srvAct("deleteWeather", { id = S.editId }, function(ok)
						if ok then S.loaded = false ; S.view = nil ; S.edit = nil end
					end)
				end)
		end
	end

	------------------------------------------------------------------
	-- 🎬 ÉCRAN « MON PLANNING »
	--    Le rythme compte plus que le contenu : monter, culminer,
	--    redescendre. Le total est affiché en permanence.
	------------------------------------------------------------------
	local function renderPlan(body)
		big(body, -3, "\u{2039}  BACK", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			S.view = nil ; disarm() ; screen(false)
		end, IS_MOBILE and 36 or 40)

		head(body, -2, "MY SCHEDULE")
		note(body, -1, string.format(
			"%d step(s), %s in total. Steps play top to bottom. Put \"Cool Down\" last "
				.. "so the world eases back instead of snapping.",
			#S.steps, mmss(stepsTotal())),
			#S.steps > 0 and OK_C or C.TEXT_GREY)

		local n = 0
		for i, w in ipairs(S.steps) do
			n = n + 1
			card(body, n, {
				icon = CFG and CFG.Icon(w.icon) or nil,
				title = i .. ".  " .. tostring(w.name),
				sub = tostring(w.desc or ""),
				right = mmss(w.duration),
			})
			n = n + 1
			row2(body, n,
				{ text = "\u{2191} Up", col = C.BG_LIGHT, colD = C.BORDER_BRIGHT, fn = function()
					if i > 1 then
						S.steps[i], S.steps[i - 1] = S.steps[i - 1], S.steps[i]
						screen(false)
					end
				end },
				{ text = "Remove", col = C.BG_LIGHT, colD = C.RED_DARK, fn = function()
					table.remove(S.steps, i) ; screen(false)
				end })
		end

		n = n + 1 ; spacer(body, n, 6)
		n = n + 1
		big(body, n, "+  ADD A STEP", AA, AA_D, function()
			local list = {}
			for _, w in ipairs(allEvents()) do
				list[#list + 1] = { id = w.id,
					label = w.name .. "  (" .. mmss(w.duration) .. ")", desc = w.desc }
			end
			openPick("ADD A STEP", list, nil, function(id)
				local w = findEvent(id)
				if w then
					--  Copie : changer la durée d'une étape ne doit pas
					--  modifier l'événement d'origine.
					local c = {}
					for k, v in pairs(w) do c[k] = v end
					S.steps[#S.steps + 1] = c
				end
			end, "Tap an event to add it at the end of the schedule.")
		end)

		if #S.steps > 0 then
			n = n + 1
			n = textRow(body, n, "Title", S.planTitle, 28,
				function(v) S.planTitle = v end,
				"Shown on every player's screen while the event runs.", "ADMIN ABUSE")

			n = n + 1
			local a = armed("start")
			big(body, n, a and "PRESS AGAIN TO GO LIVE" or "\u{25B6}  START THIS EVENT NOW",
				a and OK_C or AA, a and OK_D or AA_D, function()
					if not a then arm("start") ; screen(false) return end
					disarm()
					srvAct("start", { title = S.planTitle, steps = S.steps }, function(ok)
						if ok then S.view = nil ; S.tab = "start" ; S.stats = nil end
					end)
				end, IS_MOBILE and 50 or 58)
			if a then
				n = n + 1
				note(body, n, "This starts on EVERY server, for EVERY player, right now.",
					C.ORANGE)
			end

			n = n + 1
			n = textRow(body, n, "Save as", S.saveName or "", 28,
				function(v) S.saveName = v end,
				"Give it a name to reuse it later in one click.", "My party")
			n = n + 1
			big(body, n, "Save this schedule", C.BG_LIGHT, C.BORDER_BRIGHT, function()
				if (S.saveName or "") == "" then toast("Give it a name first", false) return end
				srvAct("savePlan", { name = S.saveName, steps = S.steps }, function(ok)
					if ok then S.loaded = false end
				end)
			end)
		end
	end

	------------------------------------------------------------------
	-- ▶️ ONGLET « START »
	------------------------------------------------------------------
	local function renderStart(body)
		local run = S.run
		local live = run and run.on

		if live then
			local w = run.w or {}
			note(body, 1, string.format(
				"LIVE RIGHT NOW  -  %s\nStep %s/%s: %s\nEnds in %s.",
				tostring(run.title or "?"), tostring(run.idx or "?"), tostring(run.n or "?"),
				tostring(w.name or "?"),
				mmss(math.max(0, (tonumber(run.runEnd) or os.time()) - os.time()))), OK_C)

			--══════════════════════════════════════════════════════════
			--  💰 LE CHIFFRE QUE TU M'AS DEMANDÉ
			--
			--     Combien de points cet événement a AJOUTÉ à l'économie,
			--     tous serveurs confondus. C'est ce nombre qui te dit
			--     quand arrêter, donc il est affiché en grand, en haut,
			--     et il se recharge tout seul à l'ouverture de l'onglet.
			--══════════════════════════════════════════════════════════
			if not S.stats and not S.statsLoading then
				S.statsLoading = true
				srvGet("stats", function(res, err)
					S.statsLoading = false
					if res then S.stats = res.stats ; S.run = res.run or S.run end
					if currentScreen == "adminabuse" and window.Visible then screen(false) end
				end)
			end

			if S.stats then
				local total = tonumber(S.stats.pointsTotal) or 0
				local who   = tonumber(S.stats.pointsPlayers) or 0
				local cap   = (S.sched and S.sched.sc_capOn) and tonumber(S.sched.sc_cap) or nil
				local scope = (tostring(S.stats.scope) == "global")
					and ("all " .. tostring(S.stats.serversSeen or 1) .. " servers")
					or "THIS server only"
				note(body, 2, string.format(
					"EXTRA POINTS GIVEN BY THIS EVENT:  %s\n"
						.. "Across %s, to %d player(s).%s",
					comma(total), scope, who,
					cap and ("\nEach player can gain at most " .. comma(cap)
						.. " from one event.") or
						"\nNo cap is set - one player can gain a lot. See Gifts > Limits."),
					total > 0 and AA or C.TEXT_GREY)
				big(body, 3, "Refresh that number", C.BG_LIGHT, C.BORDER_BRIGHT, function()
					S.stats = nil ; screen(false)
				end, IS_MOBILE and 32 or 36)
			else
				note(body, 2, "Reading how many points this event has handed out...",
					C.TEXT_GREY)
			end

			local a = armed("stop")
			big(body, 4, a and "PRESS AGAIN TO STOP EVERYTHING" or "\u{25A0}  STOP THE EVENT",
				a and C.RED or C.BG_LIGHT, a and C.RED_DARK or C.BORDER_BRIGHT, function()
					if not a then arm("stop") ; screen(false) return end
					disarm()
					srvAct("stop", nil, function() S.stats = nil end)
				end, IS_MOBILE and 48 or 54)
			note(body, 5, "Stopping removes every boost, every speed change and every "
				.. "loaned item, on every server, immediately. Points already given stay "
				.. "- they are real points.", C.TEXT_DIM)
			spacer(body, 6, 10)
			head(body, 7, "REPLACE IT WITH SOMETHING ELSE")
		else
			note(body, 1, "No event is running. Pick a ready-made party below and it "
				.. "starts on every server, for every player.", C.TEXT_GREY)
			head(body, 7, "READY-MADE PARTIES  -  ONE CLICK")
		end

		local n = 7
		for _, p in ipairs((CFG and CFG.PRESET_PLANS) or {}) do
			n = n + 1
			local total, steps = 0, {}
			for _, id in ipairs(p.steps) do
				local w = CFG.Builtin(id)
				if w then
					steps[#steps + 1] = w
					total = total + (tonumber(w.duration) or 0)
				end
			end
			local key = "preset_" .. p.id
			local a = armed(key)
			card(body, n, {
				icon = CFG.Icon("gift"),
				title = a and ("TAP AGAIN TO START  \u{2192}  " .. p.name) or p.name,
				sub = a and ("Starts now on every server. " .. #steps .. " steps, "
					.. mmss(total) .. ".")
					or (p.desc .. "  (" .. #steps .. " steps, " .. mmss(total) .. ")"),
				right = a and "GO" or mmss(total),
				rightColor = a and OK_C or AA,
				color = a and OK_C or AA, selected = a,
				height = IS_MOBILE and 66 or 76,
				onClick = function()
					if not a then arm(key) ; screen(false) return end
					disarm()
					srvAct("start", { title = p.name, steps = steps },
					function() S.stats = nil end)
				end,
			})
		end

		n = n + 1 ; spacer(body, n, 10)
		n = n + 1 ; head(body, n, "BUILD MY OWN")
		n = n + 1
		big(body, n, "\u{270E}  BUILD A SCHEDULE STEP BY STEP", C.BG_LIGHT, AA_D, function()
			S.view = "plan" ; disarm() ; screen(false)
		end)

		if #(S.plans or {}) > 0 then
			n = n + 1 ; head(body, n, "MY SAVED SCHEDULES")
			for _, pl in ipairs(S.plans) do
				n = n + 1
				local t = 0
				for _, st in ipairs(pl.steps or {}) do t = t + (tonumber(st.duration) or 0) end
				card(body, n, {
					title = pl.name, sub = #(pl.steps or {}) .. " steps, " .. mmss(t),
					right = "OPEN",
					onClick = function()
						S.steps = {}
						for _, st in ipairs(pl.steps or {}) do
							local c = {}
							for k, v in pairs(st) do c[k] = v end
							S.steps[#S.steps + 1] = c
						end
						S.planTitle = pl.name ; S.saveName = pl.name
						S.view = "plan" ; disarm() ; screen(false)
					end,
				})
				n = n + 1
				local a = armed("delp_" .. pl.name)
				big(body, n, a and ("PRESS AGAIN TO DELETE \"" .. pl.name .. "\"")
					or ("Delete \"" .. pl.name .. "\""),
					a and C.RED or C.BG_LIGHT, a and C.RED_DARK or C.BORDER_BRIGHT,
					function()
						if not a then arm("delp_" .. pl.name) ; screen(false) return end
						disarm()
						srvAct("deletePlan", { name = pl.name }, function(ok)
							if ok then S.loaded = false end
						end)
					end, IS_MOBILE and 32 or 36)
			end
		end
	end

	------------------------------------------------------------------
	-- 🌦️ ONGLET « EVENTS »
	------------------------------------------------------------------
	local function renderEvents(body)
		if not CFG then note(body, 1, "AdminAbuse_Config not found.", C.RED) return end

		note(body, 1, "These are the building blocks. An event is ONE sky, ONE effect and "
			.. "ONE set of rewards - a schedule plays several of them in a row.",
			C.TEXT_GREY)

		big(body, 2, "+  CREATE A NEW EVENT", AA, AA_D, function()
			S.edit = CFG.SimpleDefaults()
			S.edit.name = "My Event"
			S.editId = nil ; S.editNew = true
			S.view = "edit" ; disarm() ; screen(false)
		end)

		local function open(w, asCopy)
			--  On repart des CHOIX de l'événement, pas de son rendu : une
			--  copie d'un événement prêt devient un événement à toi, tout de
			--  suite modifiable.
			local e = CFG.SimpleDefaults()
			for _, k in ipairs(CFG.SIMPLE_KEYS) do
				if w[k] ~= nil then
					if type(w[k]) == "table" then e[k] = { w[k][1], w[k][2], w[k][3] }
					else e[k] = w[k] end
				end
			end
			if asCopy then
				e.name = string.sub(tostring(w.name) .. " copy", 1, 28)
				S.editId, S.editNew = nil, true
			else
				e.id = w.id
				S.editId, S.editNew = w.id, false
			end
			S.edit = e ; S.view = "edit" ; disarm() ; screen(false)
		end

		local n = 3
		head(body, n, "MY EVENTS")
		local any = false
		for _, w in pairs(S.custom or {}) do
			any = true ; n = n + 1
			card(body, n, {
				icon = CFG.Icon(w.icon), title = w.name, sub = w.desc,
				right = mmss(w.duration), height = IS_MOBILE and 62 or 72,
				onClick = function() open(w, false) end,
			})
		end
		if not any then
			n = n + 1
			note(body, n, "None yet. Create one above, or copy a ready-made one below - "
				.. "copying is the easiest way to start.", C.TEXT_DIM)
		end

		n = n + 1 ; spacer(body, n, 10)
		n = n + 1 ; head(body, n, "READY-MADE EVENTS  (tap to copy and tweak)")
		for _, id in ipairs(CFG.BUILTIN_ORDER) do
			local w = CFG.Builtin(id)
			if w then
				n = n + 1
				card(body, n, {
					icon = CFG.Icon(w.icon), title = w.name, sub = w.desc,
					right = mmss(w.duration), height = IS_MOBILE and 62 or 72,
					onClick = function() open(w, true) end,
				})
			end
		end
	end

	------------------------------------------------------------------
	-- 🎁 ONGLET « GIFTS »
	------------------------------------------------------------------
	local function renderGifts(body)
		if not CFG then note(body, 1, "AdminAbuse_Config not found.", C.RED) return end

		head(body, 1, "SEND SOMETHING RIGHT NOW")
		note(body, 2, "Goes to every player online on every server, at the same second. "
			.. "Only players already connected when you press get it - so nobody can "
			.. "hop servers to receive it twice.", C.TEXT_GREY)

		local n = 2
		for _, g in ipairs(CFG.GIFT_PRESETS) do
			n = n + 1
			local key = "gp_" .. g.id
			local a = armed(key)
			card(body, n, {
				icon = CFG.Icon(g.kind == "points" and "points" or "boost10"),
				title = a and ("TAP AGAIN TO SEND  \u{2192}  " .. g.label) or g.label,
				sub = a and "Everyone online gets it immediately." or nil,
				right = a and "GO" or "SEND",
				rightColor = a and OK_C or AA,
				selected = a, color = a and OK_C or AA,
				height = IS_MOBILE and 46 or 54,
				onClick = function()
					if not a then arm(key) ; screen(false) return end
					disarm()
					srvAct("gift", {
						kind = g.kind, amount = g.amount, dur = g.dur or 1800,
						keep = g.keep == true, popup = true, note = "", tool = "",
					})
				end,
			})
		end

		n = n + 1 ; spacer(body, n, 6)
		n = n + 1
		big(body, n, "Send an item instead (jetpack, carpet, gun...)", C.BG_LIGHT, AA_D,
			function()
				openPick("SEND AN ITEM", toolChoices(), "", function(id)
					if id == "" then return end
					srvAct("gift", { kind = "tool", tool = id, amount = 0, dur = 1800,
						popup = true, note = "" })
				end, "Everyone online gets it for 30 minutes, then it is taken back "
					.. "automatically. Nobody can keep it.")
			end)

		--══════════════════════════════════════════════════════════════
		--  💰 LE PLAFOND DE POINTS
		--══════════════════════════════════════════════════════════════
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "LIMITS  -  HOW MUCH ONE PLAYER CAN GAIN")
		n = n + 1
		note(body, n, "Without a cap, a one-hour event with Point rain can hand a single "
			.. "player hundreds of thousands of points, and your UGC economy does not "
			.. "recover from that. When a player reaches the cap they simply stop "
			.. "receiving points - everything else keeps working and they never see an "
			.. "error.", C.TEXT_GREY)

		--  Le plafond vit dans le même enregistrement que les cadeaux
		--  automatiques (section « limits » du schéma) : c'est ce qui évite
		--  d'ajouter un deuxième chemin de sauvegarde côté serveur.
		local sc = S.sched
		for _, sec in ipairs(CFG.SCHED_SCHEMA) do
			if sec.id == "limits" then
				for _, f in ipairs(sec.fields) do
					n = n + 1
					if f.kind == "bool" then
						n = toggleRow(body, n, f.label, sc[f.key] == true,
							function(v) sc[f.key] = v ; screen(false) end, f.help) - 1
					else
						local quick = { { label = "5k", v = 5000 }, { label = "25k", v = 25000 },
							{ label = "50k", v = 50000 }, { label = "100k", v = 100000 },
							{ label = "250k", v = 250000 } }
						n = numberRow(body, n, f.label, sc[f.key], f.min, f.max, f.step,
							function(v) sc[f.key] = v ; screen(false) end, f.help,
							function(v) return comma(v) end, quick) - 1
					end
				end
			end
		end

		--══════════════════════════════════════════════════════════════
		--  ⏲️ CADEAUX AUTOMATIQUES
		--══════════════════════════════════════════════════════════════
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "AUTOMATIC GIFTS  (on a timer, forever)")

		local liveSc = S.run and S.run.sc
		local at     = S.run and tonumber(S.run.giftAt) or 0
		n = n + 1
		if liveSc and liveSc.on and at > 0 then
			note(body, n, string.format(
				"RUNNING  -  next gift in %s (+%s points to everyone online).",
				mmss(math.max(0, at - os.time())), comma(liveSc.amount or 0)), OK_C)
		else
			note(body, n, "Off. Turn it on below and every player sees the same "
				.. "countdown on their screen.", C.TEXT_GREY)
		end

		for _, sec in ipairs(CFG.SCHED_SCHEMA) do
			if sec.id ~= "limits" then
				for _, f in ipairs(sec.fields) do
					n = n + 1
					if f.kind == "bool" then
						n = toggleRow(body, n, f.label, sc[f.key] == true,
							function(v) sc[f.key] = v ; screen(false) end, f.help) - 1
					elseif f.kind == "num" then
						local quick = nil
						if f.key == "sc_every" then
							quick = { { label = "5 min", v = 300 }, { label = "15 min", v = 900 },
								{ label = "30 min", v = 1800 }, { label = "1 h", v = 3600 } }
						elseif f.key == "sc_amount" then
							quick = { { label = "250", v = 250 }, { label = "500", v = 500 },
								{ label = "1k", v = 1000 }, { label = "5k", v = 5000 } }
						end
						n = numberRow(body, n, f.label, sc[f.key], f.min, f.max, f.step,
							function(v) sc[f.key] = v ; screen(false) end, f.help,
							f.key == "sc_every" and mmss or nil, quick) - 1
					elseif f.kind == "choice" then
						choiceRow(body, n, f.label, labelOf(f.choices, sc[f.key], "?"), function()
							openPick("GIFT MESSAGE", f.choices, sc[f.key],
								function(v) sc[f.key] = v end,
								"\"Surprise me\" picks a different line every time, so it "
									.. "never sounds like a robot.")
						end, f.help)
						n = n + 2
					elseif f.kind == "text" then
						--  Le champ perso ne s'affiche QUE s'il sert : un champ
						--  grisé qu'on ne peut pas utiliser est du bruit.
						if sc.sc_msgId == "custom" then
							n = textRow(body, n, f.label, sc[f.key], f.maxLen,
								function(v) sc[f.key] = v end, f.help, "Say something nice") - 1
						else
							n = n - 1
						end
					end
				end
			end
		end

		--  UN SEUL bouton pour les deux blocs : le plafond et les cadeaux
		--  automatiques sont enregistrés ensemble, parce qu'ils vivent dans
		--  le même enregistrement. Deux boutons laisseraient croire qu'on
		--  peut sauvegarder l'un sans l'autre.
		n = n + 1
		big(body, n, "SAVE THE LIMIT AND THE AUTOMATIC GIFTS", AA, AA_D, function()
			srvAct("schedConfig", { sched = sc }, function(ok)
				if ok then S.loaded = false end
			end)
		end)
	end

	--══════════════════════════════════════════════════════════════════
	--
	-- 🖥️ ONGLET « LOOK » — LE PLACEMENT DES BARRES
	--
	--   🐛 POURQUOI IL N'Y A PLUS DE GLISSER-DÉPOSER
	--
	--      Le drag d'UI dépend de trop de choses qui peuvent l'avaler : quel
	--      élément capte l'entrée, le défilement tactile qui prend la main,
	--      le décalage de la barre Roblox selon IgnoreGuiInset, et le drag
	--      de la fenêtre du panel lui-même. Chez toi, quelque chose le
	--      mangeait — et je ne peux pas le déboguer à l'aveugle.
	--
	--      Un bouton, lui, ne peut pas « ne rien faire ». Donc : 9 ancrages
	--      (les coins, les bords, le centre) pour arriver au bon endroit en
	--      un clic, et quatre flèches pour ajuster. C'est aussi bien plus
	--      simple au doigt : pas besoin de viser une petite pastille.
	--
	--      Le rectangle reste, mais comme APERÇU : il montre où tombent les
	--      trois barres. Et « Show the live bars » les affiche pour de vrai
	--      sur ton écran pendant que tu règles.
	--
	--══════════════════════════════════════════════════════════════════
	local PLACE_TARGETS = {
		{ id = "gf", label = "Next gift bar", col = Color3.fromRGB(255, 205, 70) },
		{ id = "ev", label = "Event bar",     col = Color3.fromRGB(120, 235, 255) },
		{ id = "mc", label = "Message",       col = AA },
	}

	local function placeGet(id)
		if id == "gf" then return tonumber(S.hud.gf_x) or 0.5, tonumber(S.hud.gf_y) or 0.02 end
		if id == "ev" then return tonumber(S.hud.ev_x) or 0.5, tonumber(S.hud.ev_y) or 0.09 end
		return tonumber(S.mc.posX) or 0.5, tonumber(S.mc.posY) or 0.03
	end

	local function placeSet(id, x, y)
		x = math.clamp(x, 0, 1) ; y = math.clamp(y, 0, 1)
		--  On arrondit au millième : sinon on accumule des 0.30000000004 qui
		--  ne veulent rien dire et rendent l'affichage illisible.
		x = math.floor(x * 1000 + 0.5) / 1000
		y = math.floor(y * 1000 + 0.5) / 1000
		if id == "gf" then S.hud.gf_x, S.hud.gf_y = x, y
		elseif id == "ev" then S.hud.ev_x, S.hud.ev_y = x, y
		else S.mc.posX, S.mc.posY = x, y end
		--  L'aperçu à l'écran suit en direct, si tu l'as allumé.
		if S.hudPreview and _G.AdminAbusePreviewHud then
			pcall(_G.AdminAbusePreviewHud, true, S.hud)
		end
	end

	local function renderLook(body)
		if not CFG then note(body, 1, "AdminAbuse_Config not found.", C.RED) return end

		head(body, 1, "SAY SOMETHING TO EVERYONE")
		note(body, 2, "Your profile picture shows on the left of the bar, so players know "
			.. "straight away it is you talking. The text goes through the Roblox filter "
			.. "first - if the filter is down, nothing is sent at all.", C.TEXT_GREY)

		local n = 3
		n = textRow(body, n, "Message", S.msg.text, CFG.LIMITS.MESSAGE_LEN_MAX,
			function(v) S.msg.text = v end, nil, "Type your message here")
		n = toggleRow(body, n, "Rainbow text", S.msg.rainbow == true,
			function(v) S.msg.rainbow = v ; screen(false) end,
			"A rainbow gradient that slides across the letters only - it never colours "
				.. "the bar itself.")

		row2(body, n, {
			text = "Preview (only me)", col = C.BG_LIGHT, colD = AA_D, fn = function()
				srvAct("preview", { mc = S.mc, text = S.msg.text })
			end },
		{ text = armed("bc") and "AGAIN TO SEND" or "Broadcast",
			col = armed("bc") and OK_C or AA, colD = armed("bc") and OK_D or AA_D,
			fn = function()
				if S.msg.text == "" then toast("Write a message first", false) return end
				if not armed("bc") then arm("bc") ; screen(false) return end
				disarm()
				srvAct("message", { text = S.msg.text, rainbow = S.msg.rainbow })
			end })
		n = n + 1

		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "WHERE THE BARS SIT ON SCREEN")
		n = n + 1
		note(body, n, "Pick a bar, then tap an anchor to send it there, or use the arrows "
			.. "to nudge it. Positions are saved as fractions of the screen, so they land "
			.. "in the same relative place on a phone and on a 27-inch monitor - and they "
			.. "can never fall off the edge.", C.TEXT_GREY)

		--── 1. Quelle barre ? ──
		n = n + 1
		local sel = {}
		for _, t in ipairs(PLACE_TARGETS) do
			sel[#sel + 1] = { text = t.label, sel = (S.place == t.id),
				fn = function() S.place = t.id ; screen(false) end,
				textSize = IS_MOBILE and 10 or 12 }
		end
		btnGrid(body, n, sel, IS_MOBILE and 32 or 38)

		--── 2. L'aperçu ──
		n = n + 1
		local prev = Instance.new("Frame")
		prev.Size = UDim2.new(1, 0, 0, IS_MOBILE and 150 or 200)
		prev.BackgroundColor3 = Color3.fromRGB(26, 32, 44)
		prev.BorderSizePixel = 0
		prev.ClipsDescendants = true
		prev.LayoutOrder = n ; prev.ZIndex = 11 ; prev.Parent = body
		corner(prev, 10) ; stroke(prev, AA_D, 1.5)

		local vline = Instance.new("Frame")
		vline.Size = UDim2.new(0, 1, 1, 0) ; vline.Position = UDim2.new(0.5, 0, 0, 0)
		vline.BackgroundColor3 = C.BORDER_SUBTLE ; vline.BackgroundTransparency = 0.55
		vline.BorderSizePixel = 0 ; vline.ZIndex = 11 ; vline.Parent = prev
		local hline = Instance.new("Frame")
		hline.Size = UDim2.new(1, 0, 0, 1) ; hline.Position = UDim2.new(0, 0, 0.5, 0)
		hline.BackgroundColor3 = C.BORDER_SUBTLE ; hline.BackgroundTransparency = 0.55
		hline.BorderSizePixel = 0 ; hline.ZIndex = 11 ; hline.Parent = prev

		for _, t in ipairs(PLACE_TARGETS) do
			local x, y = placeGet(t.id)
			local chip = Instance.new("TextLabel")
			chip.Size = UDim2.new(0, IS_MOBILE and 74 or 96, 0, IS_MOBILE and 20 or 24)
			chip.AnchorPoint = Vector2.new(math.clamp(x, 0, 1), math.clamp(y, 0, 1))
			chip.Position = UDim2.fromScale(math.clamp(x, 0, 1), math.clamp(y, 0, 1))
			chip.BackgroundColor3 = t.col
			chip.BackgroundTransparency = (S.place == t.id) and 0 or 0.55
			chip.BorderSizePixel = 0
			chip.Font = FONT ; chip.Text = t.label
			chip.TextColor3 = C.BG_BLACK
			chip.TextSize = IS_MOBILE and 8.5 or 10.5
			chip.TextTruncate = Enum.TextTruncate.AtEnd
			chip.ZIndex = (S.place == t.id) and 15 or 13
			chip.Parent = prev
			corner(chip, 6)
			if S.place == t.id then stroke(chip, C.TEXT_WHITE, 2) end
		end

		--── 3. Les 9 ancrages ──
		local cx, cy = placeGet(S.place)
		local function anchorRow(order, yy, labels)
			local items = {}
			for _, a in ipairs(labels) do
				items[#items + 1] = { text = a.t,
					sel = (math.abs(cx - a.x) < 0.001 and math.abs(cy - yy) < 0.001),
					fn = function() placeSet(S.place, a.x, yy) ; screen(false) end,
					textSize = IS_MOBILE and 13 or 16 }
			end
			btnGrid(body, order, items, IS_MOBILE and 30 or 34)
		end
		n = n + 1 ; head(body, n, "SEND IT TO...")
		n = n + 1 ; anchorRow(n, 0.02, { { t = "\u{2196}", x = 0.02 }, { t = "\u{2191}", x = 0.5 }, { t = "\u{2197}", x = 0.98 } })
		n = n + 1 ; anchorRow(n, 0.50, { { t = "\u{2190}", x = 0.02 }, { t = "\u{2022}", x = 0.5 }, { t = "\u{2192}", x = 0.98 } })
		n = n + 1 ; anchorRow(n, 0.98, { { t = "\u{2199}", x = 0.02 }, { t = "\u{2193}", x = 0.5 }, { t = "\u{2198}", x = 0.98 } })

		--── 4. Le réglage fin ──
		n = n + 1 ; head(body, n, "NUDGE IT")
		n = n + 1
		btnGrid(body, n, {
			{ text = "Fine",  sel = (S.placeStep == 0.005), fn = function() S.placeStep = 0.005 ; screen(false) end },
			{ text = "Small", sel = (S.placeStep == 0.02),  fn = function() S.placeStep = 0.02 ; screen(false) end },
			{ text = "Big",   sel = (S.placeStep == 0.05),  fn = function() S.placeStep = 0.05 ; screen(false) end },
		}, IS_MOBILE and 28 or 32)
		n = n + 1
		local st = S.placeStep
		btnGrid(body, n, {
			{ text = "\u{2190}", fn = function() placeSet(S.place, cx - st, cy) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
			{ text = "\u{2191}", fn = function() placeSet(S.place, cx, cy - st) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
			{ text = "\u{2193}", fn = function() placeSet(S.place, cx, cy + st) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
			{ text = "\u{2192}", fn = function() placeSet(S.place, cx + st, cy) ; screen(false) end, textSize = IS_MOBILE and 14 or 17 },
		}, IS_MOBILE and 34 or 40)

		n = n + 1
		note(body, n, string.format("%s  -  x %.3f   y %.3f\n(0 = edge, 0.5 = middle, 1 = "
			.. "the other edge)", labelOf(PLACE_TARGETS, S.place, "?"), cx, cy), C.TEXT_DIM)

		n = n + 1
		row2(body, n,
			{ text = "Reset all three", col = C.BG_LIGHT, colD = C.BORDER_BRIGHT, fn = function()
				S.hud.gf_x, S.hud.gf_y = 0.5, 0.02
				S.hud.ev_x, S.hud.ev_y = 0.5, 0.09
				S.mc.posX,  S.mc.posY  = 0.5, 0.03
				if S.hudPreview and _G.AdminAbusePreviewHud then
					pcall(_G.AdminAbusePreviewHud, true, S.hud)
				end
				screen(false)
			end },
			{ text = S.hudPreview and "Hide the live bars" or "Show the live bars",
				col = S.hudPreview and OK_C or C.BG_LIGHT,
				colD = S.hudPreview and OK_D or AA_D, fn = function()
					S.hudPreview = not S.hudPreview
					if _G.AdminAbusePreviewHud then
						pcall(_G.AdminAbusePreviewHud, S.hudPreview, S.hud)
					end
					screen(false)
				end })
		n = n + 1

		n = n + 1
		big(body, n, "SAVE THE POSITIONS", AA, AA_D, function()
			--  Deux enregistrements : les barres (hud) et la bannière (mc). On
			--  enchaîne, parce que le serveur n'accepte qu'une action à la
			--  fois — c'est ce qui empêche deux admins de s'écraser.
			srvAct("hudConfig", { hud = S.hud }, function(ok)
				if not ok then return end
				task.delay(0.25, function()
					srvAct("msgConfig", { mc = S.mc }, function(ok2)
						if ok2 then S.loaded = false end
					end)
				end)
			end)
		end)

		--── 5. Le style des barres ──
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "HOW THE BARS LOOK")
		n = n + 1
		note(body, n, "There is NO box behind the bars - just the icon, the text, the "
			.. "countdown, and a soft horizontal glow that is wide in the middle and "
			.. "fades out at both ends.", C.TEXT_DIM)

		for _, sec in ipairs(CFG.HUD_SCHEMA) do
			n = n + 1 ; head(body, n, sec.title)
			for _, f in ipairs(sec.fields) do
				n = n + 1
				local v = S.hud[f.key]
				if f.kind == "bool" then
					n = toggleRow(body, n, f.label, v == true,
						function(nv) S.hud[f.key] = nv ; screen(false) end, f.help) - 1
				elseif f.kind == "num" then
					--  Les positions ont leur propre écran plus haut : les
					--  répéter ici en − / + serait deux façons de faire la
					--  même chose, donc deux façons de se tromper.
					if f.key:match("_x$") or f.key:match("_y$") then
						n = n - 1
					else
						n = numberRow(body, n, f.label, v, f.min, f.max, f.step,
							function(nv) S.hud[f.key] = nv ; screen(false) end, f.help) - 1
					end
				elseif f.kind == "color" then
					n = colorRow(body, n, f.label, v,
						function(nv) S.hud[f.key] = nv ; screen(false) end, f.help) - 1
				elseif f.kind == "choice" then
					choiceRow(body, n, f.label, labelOf(f.choices, v, "?"), function()
						openPick(string.upper(f.label), f.choices, v,
							function(nv) S.hud[f.key] = nv end, f.help)
					end, f.help)
					n = n + 2
				else
					n = textRow(body, n, f.label, v, f.maxLen or 40,
						function(nv) S.hud[f.key] = nv end, f.help) - 1
				end
			end
		end

		n = n + 1
		big(body, n, "SAVE THE BAR STYLE", AA, AA_D, function()
			srvAct("hudConfig", { hud = S.hud }, function(ok)
				if ok then S.loaded = false end
			end)
		end)

		--── 6. Les statistiques ──
		n = n + 1 ; spacer(body, n, 12)
		n = n + 1 ; head(body, n, "STATISTICS")
		n = n + 1
		big(body, n, "Read the counters", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			S.stats = nil
			srvGet("stats", function(res, err)
				if res then S.stats = res.stats ; S.run = res.run or S.run
				else toast(tostring(err), false) end
				if currentScreen == "adminabuse" and window.Visible then screen(false) end
			end)
		end)
		if S.stats then
			n = n + 1
			note(body, n, (tostring(S.stats.scope) == "global")
				and ("Total across " .. tostring(S.stats.serversSeen or 1) .. " server(s).")
				or "THIS server only - the shared store did not answer. Better an honest "
				.. "number than a fake total.",
				(tostring(S.stats.scope) == "global") and OK_C or C.ORANGE)
			for _, s in ipairs(CFG.STAT_LABELS) do
				local val = tonumber(S.stats[s.key])
				if val and val > 0 then
					n = n + 1
					card(body, n, { title = s.label, right = comma(val),
						height = IS_MOBILE and 32 or 36 })
				end
			end
		end
	end

	------------------------------------------------------------------
	-- 🗂️ BARRE D'ONGLETS
	------------------------------------------------------------------
	local TABS = {
		{ id = "start",  label = "Start" },
		{ id = "events", label = "Events" },
		{ id = "gifts",  label = "Gifts" },
		{ id = "look",   label = "Look" },
	}

	local function tabBar(parent, order)
		local items = {}
		for _, t in ipairs(TABS) do
			items[#items + 1] = { text = t.label, sel = (S.tab == t.id), fn = function()
				S.tab = t.id ; S.view = nil ; disarm()
				--  On coupe l'aperçu en quittant l'onglet Look : sinon une
				--  fausse barre resterait collée sur ton écran, et rien
				--  n'irait plus jamais l'éteindre.
				if t.id ~= "look" then
					S.hudPreview = false
					if _G.AdminAbusePreviewHud then pcall(_G.AdminAbusePreviewHud, false) end
				end
				screen(false)
			end }
		end
		return btnGrid(parent, order, items, IS_MOBILE and 36 or 42)
	end

	------------------------------------------------------------------
	-- 🖥️ ÉCRAN
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "adminabuse"
		if reset then
			S.tab = "start" ; S.view = nil
			S.loaded, S.loading, S.failed, S.failMsg = false, false, false, nil
			S.edit, S.editId, S.pick, S.stats = nil, nil, nil, nil
			S.statsLoading = false
			disarm()
			S.hudPreview = false
			if _G.AdminAbusePreviewHud then pcall(_G.AdminAbusePreviewHud, false) end
		end

		local body = buildScreen("ADMIN ABUSE", true, AA, nil, function()
			S.loaded, S.stats = false, nil
			screen(false)
		end)

		if not remote("AdminAbuseGet") then
			note(body, 1, "The server does not have the ADMIN ABUSE system.\n\n"
				.. "Put AdminAbuse_Server in ServerScriptService and AdminAbuse_Config "
				.. "in ReplicatedStorage, then restart the server.", C.RED)
			return
		end

		--  Les sous-écrans occupent toute la place : pas d'onglets, pas de
		--  bruit. Une tâche à la fois.
		if S.view == "pick" then renderPick(body) return end

		if not S.loaded and not S.loading then
			S.loading = true
			srvGet("panel", function(res, err)
				S.loading = false
				if res then
					S.loaded = true ; S.failed = false
					S.run    = res.run
					S.custom = res.weathers or {}
					S.plans  = res.plans or {}
					S.tools  = res.tools or {}
					if CFG then
						if type(res.mc) == "table" then S.mc = CFG.ValidateMessageConfig(res.mc) end
						if type(res.hud) == "table" then S.hud = CFG.ValidateHud(res.hud) end
						if type(res.sched) == "table" then S.sched = CFG.ValidateSched(res.sched) end
					end
				else
					S.failed = true ; S.failMsg = tostring(err)
				end
				if currentScreen == "adminabuse" and window.Visible then screen(false) end
			end)
		end

		if not S.loaded then
			note(body, 1, S.failed
				and ("Could not read.\n\n" .. (S.failMsg or "")
					.. "\n\nPress the refresh button at the top to try again.")
				or "Loading...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		if S.view == "edit" then renderEdit(body) return end
		if S.view == "plan" then renderPlan(body) return end

		tabBar(body, -5)
		if S.tab == "events" then renderEvents(body)
		elseif S.tab == "gifts" then renderGifts(body)
		elseif S.tab == "look" then renderLook(body)
		else renderStart(body) end
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "adminabuse", name = "Admin Abuse", color = AA })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "adminabuse" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end

	print("✅ Bloc 12 chargé — 🎪 ADMIN ABUSE (v4)")
end)()

--════════════════════════════════════════════════════════════════════════════
-- 🚫 BLOC 8 — PRIVATION D'UGC + MODES DE L'ANTI-CHEAT
--
