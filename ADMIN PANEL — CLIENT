		label(c, { text = (e.p and e.p > 0) and ("💎 " .. fmtNum(e.p)) or "—",
			size = UDim2.new(0, prW, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(1, -8, 0, IS_MOBILE and 6 or 9), anchor = Vector2.new(1, 0),
			xAlign = Enum.TextXAlignment.Right, color = Color3.fromRGB(120, 220, 255),
