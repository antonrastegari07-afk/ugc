	local function toUnix(v)
		if v == nil then return nil end
		if typeof(v) == "DateTime" then return v.UnixTimestamp end
		if type(v) == "number" then return math.floor(v) end
		if type(v) == "string" then
			local ok, dt = pcall(DateTime.fromIsoDate, v)
			if ok and dt then return dt.UnixTimestamp end
		end
		return nil
	end

	local function fmtStart(unix)
		if not unix then return "date inconnue" end
		local left = unix - os.time()
		local when = os.date("!%d/%m/%Y %H:%M", unix) .. " UTC"
		if left <= 0 then return when .. "  ·  🔴 en cours / passé" end
		local d = math.floor(left / 86400)
		local h = math.floor((left % 86400) / 3600)
		if d > 0 then return when .. string.format("  ·  dans %dj %dh", d, h) end
		local m = math.floor((left % 3600) / 60)
		return when .. string.format("  ·  dans %dh %dmin", h, m)
	end

	local function packEvent(data, fallbackId)
		return {
			id     = tostring(data.Id or fallbackId or "?"),
			title  = tostring(data.Title or "Sans titre"),
			startU = toUnix(data.StartTime),
			ended  = (data.HasEnded == true),
		}
	end

	local function fetchUpcoming()
		local ok, res = pcall(function()
			return SocialService:GetUpcomingExperienceEventsAsync()
		end)
		if not ok then return nil, tostring(res) end
		if type(res) ~= "table" then return nil, "réponse vide" end
		return res, nil
	end

	local function resolvePreview()
		local want = (S.sdraft and S.sdraft.eventId) or "auto"
		if want == "" then want = "auto" end
		if S.evLoading then return end
		if S.evFor == want and S.ev ~= nil then return end

		S.evLoading = true
		task.spawn(function()
			local data, err
			if want ~= "auto" then
				local ok, res = pcall(function()
					return SocialService:GetExperienceEventAsync(want)
				end)
				if ok and type(res) == "table" then data = res
				else err = "ID introuvable ou event d'une autre expérience" end
			else
				local list, e2 = fetchUpcoming()
				if list then
					for _, ev in ipairs(list) do
						if ev.HasEnded ~= true and ev.Id then data = ev break end
					end
					if not data then err = "aucun event à venir dans ton expérience" end
				else
					err = e2 or "API indisponible"
				end
			end

			S.evLoading = false
			S.evFor = want
			if data then S.ev, S.evErr = packEvent(data, want), nil
			else S.ev, S.evErr = false, err end
			if currentScreen == "eventinfo" and window.Visible then screen(false) end
		end)
	end

