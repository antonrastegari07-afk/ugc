		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, 0, 0.5, 0)
		gc.Size = UDim2.new(0, btnW, 1, 0)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 12; gc.Parent = sw

		local function callAction(act, extra)
			if not doAct then toast("Serveur pas à jour", false); return end
			local target = (S.mTarget or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if #target < 2 then toast("Entre un pseudo ou un UserID", false); return end

			local payload = {
				target      = target,
				duration    = S.mDuration,
				deviceBlock = S.mDevice,
				excludeAlts = S.mAlts,
				reason      = "admin",
				details     = (S.mDetails ~= "" and S.mDetails) or "Ban manuel via admin panel",
				displayMsg  = (S.mDetails ~= "" and S.mDetails) or "You have been banned by a moderator.",
			}
			if type(extra) == "table" then
				for k, v in pairs(extra) do payload[k] = v end
			end

			task.spawn(function()
				local ok, res = pcall(function() return doAct:InvokeServer(act, payload) end)
				if ok and type(res) == "table" then
					if act == "lookup" then
						S.lookup = res.ok and res or nil
						if not res.ok then toast(res.msg or "Introuvable", false) end
					else
						toast(res.msg or (res.ok and "OK" or "Échec"), res.ok == true)
						if res.ok then
							S.entries, S.cursor, S.hasMore = {}, nil, false
							S.logLoaded = false
							S.devLoaded = false
							S.lookup = nil
						end
					end
				else
					toast("Erreur de communication", false)
				end
				screen(false)
			end)
		end

		local gb = actionButton(gc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🔍", textSize = IS_MOBILE and 14 or 17, radius = 9, zIndex = 12 })
		gb.MouseButton1Click:Connect(function() callAction("lookup") end)
		box.FocusLost:Connect(function(enter) if enter then callAction("lookup") end end)

		-- Résultat de la recherche
		if S.lookup then
			local lk = S.lookup
			local rec = lk.record
			local active = rec and rec.active
			local _, rows = card(body, 2, "👤 " .. tostring(lk.name), active and C.RED or C.GREEN)
			statLine(rows, 1, "UserID", tostring(lk.userId), C.TEXT_WHITE)
			statLine(rows, 2, "En ligne", lk.online and "🟢 oui" or "⚪ non", lk.online and C.GREEN or C.TEXT_DIM)
			if lk.accountAge then
				statLine(rows, 3, "Âge du compte", tostring(lk.accountAge) .. " j",
					(S.cfg and lk.accountAge < (S.cfg.naMinDays or 7)) and C.ORANGE or C.TEXT_WHITE)
			end
			if active then
				statLine(rows, 4, "Statut", "🚫 BANNI", C.RED)
				statLine(rows, 5, "Raison", RLBL[rec.r] or tostring(rec.r), RCOL[rec.r] or C.TEXT_WHITE)
				statLine(rows, 6, "Détails", tostring(rec.dt or "—"), C.TEXT_GREY)
				statLine(rows, 7, "Depuis", fmtAgo(rec.t), C.TEXT_GREY)
				statLine(rows, 8, "Expire", fmtUntil(rec.ex), C.TEXT_WHITE)
				statLine(rows, 9, "Appareil bloqué", rec.db and "📵 oui" or "non", rec.db and C.ORANGE or C.TEXT_DIM)
				statLine(rows, 10, "Par", tostring(rec.by or "?"), C.TEXT_GREY)
			elseif lk.legacy then
				statLine(rows, 4, "Statut", "🚫 BANNI (fiche héritée)", C.RED)
				statLine(rows, 5, "Raison", tostring(lk.legacy), C.TEXT_GREY)
			else
				statLine(rows, 4, "Statut", "✅ pas de ban actif", C.GREEN)
			end

			-- 📵 État appareil
			if lk.device then
				local st, txt = deviceState(lk.device)
				statLine(rows, 20, "── 📵 Appareil ──", "", C.TEXT_DIM)
				statLine(rows, 21, "État", txt, st == "pending" and PENDING_COL or DEVICE_COL)
				if st == "pending" then
					statLine(rows, 22, "En attente depuis", fmtAgo(lk.device.qAt), C.TEXT_GREY)
				elseif st == "active" then
					statLine(rows, 22, "Blocage expire", fmtUntil(lk.device.exAt), C.TEXT_WHITE)
				end
			end
		end

		sectionLabel(body, 10, "DURÉE DU BAN")
		acTabBar(body, 11, DURATIONS, S.mDuration, ACCENT, function(id)
			S.mDuration = id; screen(false)
		end)

		sectionLabel(body, 12, "OU DURÉE PERSONNALISÉE (EN JOURS)")
		stepperRow(body, 13, durToDays(S.mDuration), 1, 3650, "jour(s)", function(v)
			S.mDuration = v * 86400; screen(false)
		end)

		toggleRow(body, 14, "📵 Bloquer l'appareil", S.mDevice,
			function(v) S.mDevice = v; screen(false) end)

		if S.mDevice then
			local online = S.lookup and S.lookup.online
			if S.lookup and not online then
				noteCard(body, 15, "⏳ Ce joueur est HORS LIGNE : la demande sera mise en attente et "
					.. "appliquée dès qu'il rejoint (compte banni + PC bloqué 24 h). "
					.. "Tu la retrouveras dans l'onglet 📵 Appareils.", PENDING_COL)
			elseif online then
				noteCard(body, 15, "📵 Ce joueur est EN LIGNE : le ban et le blocage d'appareil "
					.. "partent immédiatement.", DEVICE_COL)
			else
				noteCard(body, 15, "📵 Si le joueur est en ligne → blocage immédiat. S'il est hors ligne → "
