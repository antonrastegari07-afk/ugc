	local function applyCfg(patch, okMsg)
		local base = (S.draft or (S.data and S.data.config) or {})
		local out = {}
		for k, v in pairs(base) do out[k] = v end
		for k, v in pairs(patch) do out[k] = v end
		callAct("setconfig", { config = out }, function(res)
			if res and res.ok then
				S.data = nil ; S.draft = nil ; S.dirty = false
				if okMsg then toast(okMsg, true) end
			end
			screen(false)
		end)
	end

