function economy.accept(uid, value)
	if type(value) ~= "table" then return end
	if type(value.points) == "number" then pointsCache[uid] = value.points end
	if type(value.total) ~= "number" then return end
	local old = economy.values[uid]
	if old and (old.serial or 0) > (value.serial or 0) then return end
	value.time = os.clock(); economy.values[uid] = value
end
function economy.fetch(ids)
	for _, uid in ipairs(ids) do economy.pending[uid] = true end
	if economy.running then return end
	economy.running = true
	task.spawn(function()
		task.wait(0.08) -- gather all rows created in this frame
		while next(economy.pending) do
			local remote = ReplicatedStorage:FindFirstChild("AdminSpending_Get")
			if not remote or not remote:IsA("RemoteFunction") then
				economy.pending = {}; break -- missing add-on never blocks the admin panel
			end
			local ids, wantPoints = {}, {}
			for uid in pairs(economy.pending) do
				table.insert(ids, uid); economy.pending[uid] = nil
				wantPoints[tostring(uid)] = pointsFor(uid) == nil
				if #ids >= 30 then break end
			end
			local ok, response = pcall(function() return remote:InvokeServer(ids, wantPoints) end)
			local good = ok and type(response) == "table" and not response.throttled
			if ok and type(response) == "table" then
				for key, value in pairs(response) do
					local uid = tonumber(key)
					if uid then economy.accept(uid, value) end
				end
			end
			-- ⚡ serveur occupé : on redemande dans 1 s au lieu de laisser « … » pendant 15 s
			if not good then
				for _, uid in ipairs(ids) do economy.lastRequest[uid] = nil end
			end
			task.wait(good and 0.35 or 1.1)
		end
		economy.running = false
	end)
end
