	--  🔢 Un nombre, réglé au doigt : − / + et des raccourcis. Aucun clavier
	--     n'est nécessaire, ce qui compte sur téléphone.
	local function numberRow(parent, order, title, value, minV, maxV, stepV, onSet, help, fmt, quick)
		local h = IS_MOBILE and 40 or 46
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, h)
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.2
		f.BorderSizePixel = 0
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		corner(f, 10) ; stroke(f, C.BORDER_SUBTLE, 1)

		local btnW = IS_MOBILE and 34 or 40
		local valW = IS_MOBILE and 62 or 78

		lbl(f, { text = title, color = C.TEXT_WHITE, size = IS_MOBILE and 12 or 14,
			truncate = true, frame = UDim2.new(1, -(btnW * 2 + valW + 24), 1, 0),
			pos = UDim2.new(0, 12, 0, 0) })

		local function step(dir)
			local v = (tonumber(value) or 0) + dir * stepV
			v = math.clamp(v, minV, maxV)
			--  On arrondit au pas : sinon 0.1 + 0.2 finit par afficher
			--  2.9999999 et on croit à un bug.
			v = math.floor(v / stepV + 0.5) * stepV
			onSet(v)
		end

		local function mk(px, text, dir)
			local c = Instance.new("Frame")
			c.Size = UDim2.new(0, btnW, 0, h - 12)
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, -px, 0.5, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12 ; c.Parent = f
			local b = actionButton(c, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
				text = text, textSize = IS_MOBILE and 15 or 18, radius = 8, zIndex = 12 })
			b.MouseButton1Click:Connect(function() step(dir) end)
		end
		mk(8, "+", 1)
		mk(8 + btnW + valW + 4, "\u{2212}", -1)

		lbl(f, { text = fmt and fmt(value) or tostring(value), color = OK_C,
			size = IS_MOBILE and 13 or 15, xAlign = Enum.TextXAlignment.Center,
			frame = UDim2.new(0, valW, 1, 0),
			pos = UDim2.new(1, -(8 + btnW + valW), 0, 0) })

		local nx = order + 1
		if quick and #quick > 0 then
			local items = {}
			for _, it in ipairs(quick) do
				items[#items + 1] = { text = it.label, sel = (tonumber(value) == it.v),
					fn = function() onSet(it.v) end, textSize = IS_MOBILE and 10 or 12 }
			end
			btnGrid(parent, nx, items, IS_MOBILE and 26 or 30)
			nx = nx + 1
		end
		helpUnder(parent, nx, help)
		return nx + 1
	end

	local function toggleRow(parent, order, title, on, onSet, help)
		card(parent, order, {
			title = title,
			right = on and "ON" or "OFF",
			rightColor = on and OK_C or C.TEXT_DIM,
			color = on and OK_C or AA,
