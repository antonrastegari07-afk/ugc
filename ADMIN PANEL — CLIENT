-- 🌍 STREAMING : si ton jeu a StreamingEnabled, le client ne charge que la zone
--   autour de TON perso → un joueur lointain apparaît "dans le vide". On demande
--   au serveur de streamer la zone autour de la cible (API officielle, pas besoin
--   de téléporter ton perso). Appelé à chaque changement + en boucle (il bouge).
--   Étapes (async) : 1) demander la position au serveur (toujours connue, même
--   si le perso est streamé out) → sert de cible caméra ET de point de streaming.
--   2) demander au serveur de streamer la zone autour de cette position.
local function spectateStreamAround(target)
	target = target or spectateTarget
	if not target then return end
	-- 1) position serveur (fallback fiable pour les cibles lointaines)
	if getPosFn then
		local ok, pos = pcall(function() return getPosFn:InvokeServer(target.UserId) end)
		if ok and typeof(pos) == "Vector3" and target == spectateTarget then
			specServerPos = pos
		end
	end
	-- 2) meilleure position connue = perso local si chargé, sinon serveur
	local best
	local char = target.Character
	local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
	if hrp then best = hrp.Position else best = specServerPos end
	if best then
		pcall(function() player:RequestStreamAroundAsync(best) end)
	end
end

local function spectateAt(index)
	local others = getOthers()
	if #others == 0 then stopSpectate(); toast("No one to spectate", false); return end
	spectateIndex = ((index - 1) % #others) + 1
	local target = others[spectateIndex]
	spectateTarget = target
	specServerPos = nil  -- oublie la position de la cible précédente
	specName.Text = "👁️ " .. esc(target.DisplayName) .. ptsSuffixLive(target.UserId)
	loadAvatar(specAvatar, target.UserId)
	task.spawn(spectateStreamAround, target)  -- charge la zone tout de suite (async)
	spectateApply()  -- bascule immédiate (la boucle de rendu maintient ensuite)
	toast("👁️ " .. target.DisplayName, true)
end

stopSpectate = function()
	spectating = false
	spectateTarget = nil
	specDragging = false
	specLastMouse = nil
	specServerPos = nil
	specTouches = {}
	specPinchDist = nil
	if specBound then
		pcall(function() RunService:UnbindFromRenderStep(SPEC_BIND) end)
		specBound = false
	end
	for _, c in ipairs(specInputConns) do pcall(function() c:Disconnect() end) end
	specInputConns = {}
	spectateBar.Visible = false
	-- rend la caméra au joueur (Custom + son propre Humanoid)
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		local myChar = player.Character
		if myChar then
			local myHum = myChar:FindFirstChildOfClass("Humanoid")
			if myHum then cam.CameraSubject = myHum end
		end
	end
end

