					color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
				return
			end
			for i, e in ipairs(entries) do
				local isSpent = (ugcState.topMetric == "spent")
				acRow(body, 10 + i, i, e.userId,
					e.value, false, UGC_PINK, function() screenUGCLog(false) end)
			end
			local note = Instance.new("Frame")
			note.Size = UDim2.new(1, 0, 0, 22); note.BackgroundTransparency = 1
			note.LayoutOrder = 9999; note.ZIndex = 11; note.Parent = body
			label(note, {
				text = (ugcState.topMetric == "spent") and "Valeur = points dépensés en UGC" or "Valeur = nombre d'UGC récupérés",
				size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, zIndex = 11 })
		end

		if ugcState.top then
			local ids = {}
			for _, e in ipairs(ugcState.top) do table.insert(ids, e.userId) end
			resolveUsernames(ids, function() resolvePoints(ids, function() paint(ugcState.top) end) end)
		else
			task.spawn(function()
				local ok, res = pcall(function() return getUGCTop:InvokeServer(ugcState.topMetric, 50) end)
				if not st.Parent then return end
				if not ok or type(res) ~= "table" then stl.Text = "Couldn't load (try 🔄)."; return end
				ugcState.top = res.entries or {}
				local ids = {}
				for _, e in ipairs(ugcState.top) do table.insert(ids, e.userId) end
				resolveUsernames(ids, function() resolvePoints(ids, function() paint(ugcState.top) end) end)
			end)
		end
		return
	end

	-- ════════ ONGLET LOG ════════
	local searchWrap = Instance.new("Frame")
	searchWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
	searchWrap.BackgroundTransparency = 1
	searchWrap.LayoutOrder = 1; searchWrap.ZIndex = 11; searchWrap.Parent = body
	local sBox = Instance.new("TextBox")
	sBox.Size = UDim2.new(1, 0, 1, 0)
	sBox.BackgroundColor3 = C.BG_DARK
	sBox.BorderSizePixel = 0
	sBox.Font = FONT
	sBox.PlaceholderText = "🔍 Player, UserID or UGC name..."
	sBox.PlaceholderColor3 = C.TEXT_DIM
	sBox.Text = ugcState.search or ""
	sBox.TextColor3 = C.TEXT_WHITE
	sBox.TextSize = IS_MOBILE and 11 or 14
	sBox.TextXAlignment = Enum.TextXAlignment.Left
	sBox.ClearTextOnFocus = false
	sBox.ZIndex = 12
	sBox.Parent = searchWrap
	corner(sBox, 8); stroke(sBox, C.BORDER_SUBTLE, 1)
	local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0, 10); sp.Parent = sBox
	sBox:GetPropertyChangedSignal("Text"):Connect(function()
		ugcState.search = sBox.Text
		if render then render() end
	end)

	-- chips par UGC (config actuelle + UGC retirés encore présents dans le log)
	local chipRow = Instance.new("ScrollingFrame")
	chipRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
	chipRow.BackgroundTransparency = 1
	chipRow.BorderSizePixel = 0
	chipRow.ScrollBarThickness = 0
	chipRow.ScrollingDirection = Enum.ScrollingDirection.X
	chipRow.CanvasSize = UDim2.new(0, 0, 0, 0)
	chipRow.AutomaticCanvasSize = Enum.AutomaticSize.X
	chipRow.LayoutOrder = 2; chipRow.ZIndex = 11; chipRow.Parent = body
	local cl = Instance.new("UIListLayout")
	cl.FillDirection = Enum.FillDirection.Horizontal
	cl.Padding = UDim.new(0, 5); cl.SortOrder = Enum.SortOrder.LayoutOrder; cl.Parent = chipRow

	local function chip(i, id, text)
		local sel = (tostring(ugcState.asset) == tostring(id))
		local b = Instance.new("TextButton")
		b.AutomaticSize = Enum.AutomaticSize.X
		b.Size = UDim2.new(0, 0, 1, 0)
		b.BackgroundColor3 = sel and UGC_PINK or C.BG_DARK
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Font = FONT
		b.Text = text
		b.TextSize = IS_MOBILE and 10 or 12
		b.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		b.LayoutOrder = i
		b.ZIndex = 12
		b.Parent = chipRow
		corner(b, 7); stroke(b, sel and UGC_PINK or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10); p.Parent = b
		b.MouseButton1Click:Connect(function() ugcState.asset = id; screenUGCLog(false) end)
	end
	chip(1, "all", "🌐 All")
	local seen = {}
	if UGC_CFG then
		for i, u in ipairs(UGC_CFG.Items) do
			seen[tostring(u.AssetId)] = true
			chip(i + 1, u.AssetId, u.Name)
		end
	end
	local extra = 500
	for _, e in ipairs(ugcState.entries) do
		local k = tostring(e.a)
		if not seen[k] then seen[k] = true; extra += 1; chip(extra, e.a, (e.an or k) .. " ⚠️") end
	end

	-- Filtre par voie d'acquisition
	acTabBar(body, 25, {
		{ id = "all",  label = "🌐 Toutes" },
		{ id = "paid", label = "💎 Payées" },
		{ id = "free", label = "🎁 Gratuites" },
		{ id = "flag", label = "🚨 Hors shop" },
	}, ugcState.src, C.RED, function(id) ugcState.src = id; screenUGCLog(false) end)

	local countF = Instance.new("Frame")
	countF.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
	countF.BackgroundTransparency = 1
	countF.LayoutOrder = 30; countF.ZIndex = 11; countF.Parent = body
	local countLbl = label(countF, { text = "", size = UDim2.fromScale(1, 1),
		xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
		textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

	local listHolder = Instance.new("Frame")
	listHolder.Size = UDim2.new(1, 0, 0, 0)
	listHolder.AutomaticSize = Enum.AutomaticSize.Y
	listHolder.BackgroundTransparency = 1
	listHolder.LayoutOrder = 31; listHolder.ZIndex = 11; listHolder.Parent = body
	local ll = Instance.new("UIListLayout")
	ll.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
	ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = listHolder

	render = function()
		for _, ch in ipairs(listHolder:GetChildren()) do
			if not ch:IsA("UIListLayout") then ch:Destroy() end
		end
		local list = ugcVisible()
		local sum, freeN = 0, 0
		for _, e in ipairs(list) do
			sum += (e.p or 0)
			if e.f then freeN += 1 end
		end
		countLbl.Text = string.format("%d shown  •  %d loaded  •  %s pts total  •  %d free",
			#list, #ugcState.entries, fmtNum(sum), freeN)

		if #list == 0 then
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = listHolder
			label(f, { text = "Nothing matches these filters.", size = UDim2.fromScale(1, 1),
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
		else
			for i, e in ipairs(list) do
				ugcCard(listHolder, i, e, function() screenUGCLog(false) end)
			end
		end

		if ugcState.hasMore then
			local mc = Instance.new("Frame")
			mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
			mc.BackgroundTransparency = 1; mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = listHolder
			local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
				text = "⬇️ Load more", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
			mb.MouseButton1Click:Connect(function()
				local ok, res = pcall(function() return getUGCLog:InvokeServer(ugcState.cursor, 30) end)
				if ok and type(res) == "table" then
					local ids = {}
					for _, e in ipairs(res.entries or {}) do
						table.insert(ugcState.entries, e); table.insert(ids, e.u)
					end
					ugcState.cursor  = res.cursor
					ugcState.hasMore = res.hasMore == true
					resolveUsernames(ids, function() resolvePoints(ids, function() render() end) end)
				else render() end
			end)
		end
	end

	if not getUGCLog then countLbl.Text = "❌ Server not updated (AdminGetUGCRedeems missing)."; return end
	if #ugcState.entries > 0 and not reset then render(); return end

	countLbl.Text = "Loading UGC log..."
	task.spawn(function()
		local ok, res = pcall(function() return getUGCLog:InvokeServer(nil, 30) end)
		if not body.Parent then return end
		if not ok or type(res) ~= "table" then countLbl.Text = "Couldn't load (try 🔄)."; return end
		ugcState.entries = res.entries or {}
		ugcState.cursor  = res.cursor
		ugcState.hasMore = res.hasMore == true
		local ids = {}
		for _, e in ipairs(ugcState.entries) do table.insert(ids, e.u) end
		resolveUsernames(ids, function()
			resolvePoints(ids, function()
				if not body.Parent then return end
				-- si le log contient des UGC absents de la config actuelle,
				-- on reconstruit une fois pour afficher leurs chips "⚠️"
				local needRebuild = false
				if UGC_CFG then
					local known = {}
					for _, u in ipairs(UGC_CFG.Items) do known[tostring(u.AssetId)] = true end
					for _, e in ipairs(ugcState.entries) do
						if not known[tostring(e.a)] then needRebuild = true break end
					end
				end
				if needRebuild then screenUGCLog(false) else render() end
			end)
		end)
	end)
end

