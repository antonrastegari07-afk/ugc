screenLeaderboards = function(tabId, count, fresh)
	currentScreen = "leaderboards"
	tabId = tabId or "Points"
	count = math.clamp(tonumber(count) or 50, 50, 200)

	-- ⚡ Cache client 30 s (survit à la fermeture du panel) : rebasculer d'onglet est instantané.
	--    Rangé dans `economy` pour ne PAS ajouter de variable locale au script (limite 200).
	local lbc = economy.lbCache
	if not lbc then lbc = {}; economy.lbCache = lbc end
	local period = economy.robuxPeriod or "all"
	local PERIODS = {
		{ id = "day",   label = "Aujourd'hui", title = "DU JOUR" },
		{ id = "month", label = "Ce mois",     title = "DU MOIS" },
		{ id = "year",  label = "Cette année", title = "DE L'ANNÉE" },
		{ id = "all",   label = "All time",    title = "ALL TIME" },
	}
	local periodTitle = "ALL TIME"
	for _, p in ipairs(PERIODS) do if p.id == period then periodTitle = p.title end end

	local isRobuxTab = (tabId == "RobuxSpent")
	local body = buildScreen(isRobuxTab and ("💸 TOP SPENDERS — " .. periodTitle) or "🏆 LEADERBOARDS",
		true, isRobuxTab and C.GREEN or GOLD, nil, function() screenLeaderboards(tabId, count, true) end)

	-- Barre d'onglets
	local tabWrap = Instance.new("Frame")
	tabWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 42)
	tabWrap.BackgroundTransparency = 1
	tabWrap.LayoutOrder = 0
	tabWrap.ZIndex = 11
	tabWrap.Parent = body
	local pw = panelSize().X.Offset
	local inner = pw - PAD * 2
	local tgap = 4
	local nTabs = #LB_TABS
	local tw = math.floor((inner - tgap * (nTabs - 1)) / nTabs)
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.Padding = UDim.new(0, tgap)
	tl.Parent = tabWrap
	for _, tabDef in ipairs(LB_TABS) do
		local sel = (tabDef.id == tabId)
		local accent = tabDef.isRobux and C.GREEN or GOLD
		local tb = Instance.new("TextButton")
		tb.Size = UDim2.new(0, tw, 1, 0)
		tb.BackgroundColor3 = sel and accent or C.BG_DARK
		tb.AutoButtonColor = false
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.Text = IS_MOBILE and tabDef.short or tabDef.label
		tb.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
		tb.TextSize = IS_MOBILE and 12 or 14
		tb.ZIndex = 12
		tb.Parent = tabWrap
		if tabDef.isRobux or tabDef.id == "Points" then
			local iconBox = Instance.new("Frame")
			iconBox.Size = UDim2.fromOffset(13,13)
			iconBox.Position = IS_MOBILE and UDim2.new(0.5,-6,0.5,-6) or UDim2.new(0,5,0.5,-6)
			iconBox.BackgroundTransparency = 1; iconBox.ZIndex = 13; iconBox.Parent = tb
			economy.icon(iconBox, tabDef.isRobux == true, sel and C.BG_BLACK or accent, 14)
			if not IS_MOBILE then tb.Text = "    " .. tabDef.label; tb.TextSize = 12 end
		end
		corner(tb, 8)
		stroke(tb, sel and accent or C.BORDER_SUBTLE, 1)
		tb.MouseButton1Click:Connect(function() screenLeaderboards(tabDef.id, 50) end)
	end

	local tab
	for _, t in ipairs(LB_TABS) do if t.id == tabId then tab = t end end
	if not tab then tab = LB_TABS[2]; tabId = tab.id end

	-- ⚡ Case à cocher (onglet Playtime) : bascule temps de jeu ↔ efficacité
	if tab.isPlaytime then
		local cbRow = Instance.new("TextButton")
		cbRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		cbRow.BackgroundColor3 = C.BG_DARK
		cbRow.AutoButtonColor = false
		cbRow.Text = ""
		cbRow.BorderSizePixel = 0
		cbRow.LayoutOrder = 1
		cbRow.ZIndex = 11
		cbRow.Parent = body
		corner(cbRow, 8); stroke(cbRow, playtimeEffMode and GOLD or C.BORDER_SUBTLE, 1)
		local box = Instance.new("Frame")
		box.Size = UDim2.new(0, IS_MOBILE and 18 or 22, 0, IS_MOBILE and 18 or 22)
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 10, 0.5, 0)
		box.BackgroundColor3 = playtimeEffMode and GOLD or C.BG_LIGHT
		box.BorderSizePixel = 0
		box.ZIndex = 12
		box.Parent = cbRow
		corner(box, 5); stroke(box, playtimeEffMode and GOLD or C.BORDER_BRIGHT, 1)
		if playtimeEffMode then
			label(box, { text = "✓", size = UDim2.fromScale(1, 1), color = C.BG_BLACK, textSize = IS_MOBILE and 13 or 16, zIndex = 13 })
		end
		label(cbRow, {
			text = "⚡ Plus de points / moins de temps",
			size = UDim2.new(1, -(IS_MOBILE and 40 or 48), 1, 0),
			position = UDim2.new(0, IS_MOBILE and 36 or 42, 0, 0),
			xAlign = Enum.TextXAlignment.Left, color = playtimeEffMode and GOLD or C.TEXT_GREY,
			textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 12,
		})
		cbRow.MouseButton1Click:Connect(function()
			playtimeEffMode = not playtimeEffMode
			screenLeaderboards(tabId, 50)
		end)
	end

	-- 💸 Sous-onglets du classement Robux : jour / mois / année / all time
	if tab.isRobux then
		local pWrap = Instance.new("Frame")
		pWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 36)
		pWrap.BackgroundTransparency = 1
		pWrap.LayoutOrder = 1
		pWrap.ZIndex = 11
		pWrap.Parent = body
		local pl = Instance.new("UIListLayout")
		pl.FillDirection = Enum.FillDirection.Horizontal
		pl.Padding = UDim.new(0, tgap)
		pl.Parent = pWrap
		local pwEach = math.floor((inner - tgap * (#PERIODS - 1)) / #PERIODS)
		for _, p in ipairs(PERIODS) do
			local sel = (p.id == period)
			local pb = Instance.new("TextButton")
			pb.Size = UDim2.new(0, pwEach, 1, 0)
			pb.BackgroundColor3 = sel and C.GREEN or C.BG_DARK
			pb.AutoButtonColor = false
			pb.BorderSizePixel = 0
			pb.Font = FONT
			pb.Text = p.label
			pb.TextColor3 = sel and C.BG_BLACK or C.TEXT_GREY
			pb.TextSize = IS_MOBILE and 10 or 13
			pb.ZIndex = 12
			pb.Parent = pWrap
			corner(pb, 7)
			stroke(pb, sel and C.GREEN or C.BORDER_SUBTLE, 1)
			pb.MouseButton1Click:Connect(function()
				economy.robuxPeriod = p.id
				screenLeaderboards("RobuxSpent", 50)
			end)
		end
		local note = label(body, {text = (period == "all")
			and "Total suivi • passes estimés + dev products • touche un joueur pour le détail"
			or "Achats enregistrés depuis l'installation v4 • bascule à minuit UTC",
			size=UDim2.new(1,0,0,26), color=C.TEXT_GREY, textSize=IS_MOBILE and 10 or 12,
			wrapped=true, zIndex=11})
		note.LayoutOrder = 2
	end

	local statusF = Instance.new("Frame")
	statusF.Size = UDim2.new(1, 0, 0, 40); statusF.BackgroundTransparency = 1
	statusF.LayoutOrder = 3; statusF.ZIndex = 11; statusF.Parent = body
	label(statusF, { text = "Loading " .. tab.id .. "...", size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

	-- Clé du board envoyée au serveur
	local boardKey = tabId
	if tab.isPlaytime then boardKey = playtimeEffMode and "Efficiency" or "Playtime" end
	if tab.isRobux then boardKey = (period == "all") and "RobuxSpent" or ("RobuxSpent_" .. period) end
	local cacheKey = boardKey .. "#" .. count

	local function paint(data, paged)
		if not statusF.Parent then return end
		statusF:Destroy()
		if #data == 0 then
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 50); f.BackgroundTransparency = 1
			f.LayoutOrder = 3; f.ZIndex = 11; f.Parent = body
			label(f, { text = tab.isRobux and "Aucun achat enregistré sur cette période." or "No entries yet.",
				size = UDim2.fromScale(1, 1), color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			return
		end
		-- ① on dessine TOUT DE SUITE
		local refs, ids = {}, {}
		for i, entry in ipairs(data) do
			if not entry.name then entry.name = unameCache[entry.userId] end
			ids[i] = entry.userId
			refs[i] = lbRow(body, 3 + i, tab, entry, unameCache[entry.userId])
		end
		-- ⬇️ Load more
		if paged and #data >= count and count < 200 then
			local mc = Instance.new("Frame")
			mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
			mc.BackgroundTransparency = 1
			mc.LayoutOrder = 99999
			mc.ZIndex = 11
			mc.Parent = body
			local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT, text = "⬇️ Load more (+50)", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
			mb.MouseButton1Click:Connect(function() screenLeaderboards(tabId, count + 50) end)
		end
		-- ② puis on remplit les noms et le badge 🚫, sans rien reconstruire
		local function refill()
			for _, r in ipairs(refs) do
				if r.name.Parent then
					local e = r.entry
					local un = unameCache[e.userId]
					if un then
						if not e.name then e.name = un end
						r.user.Text = "@" .. un
					end
					r.name.Text = esc(e.name or ("User " .. e.userId)) .. ptsSuffixLive(e.userId)
				end
			end
		end
		resolveUsernames(ids, function()
			refill()
			resolvePoints(ids, refill)
		end)
	end

	local cached = lbc[cacheKey]
	if cached and not fresh and os.clock() - cached.at < 30 then
		paint(cached.data, cached.paged)
		return
	end

	task.spawn(function()
		local data, paged, robuxErr
		local boardRemote = getGameBoard
		if tab.isRobux then boardRemote = ReplicatedStorage:FindFirstChild("AdminSpending_Top") end
		if boardRemote then
			for attempt = 1, 4 do
				local ok, res = pcall(function() return boardRemote:InvokeServer(boardKey, count) end)
				if ok and type(res) == "table" and res.throttled and attempt < 4 then
					task.wait(0.35 * attempt) -- serveur occupé : on réessaie tout seul
				else
					if ok and type(res) == "table" and type(res.entries) == "table" then
						paged = true
						data = {}
						for i, e in ipairs(res.entries) do
							local row = { userId = e.userId, rank = i }
							row[tab.field] = e.value
							data[i] = row
						end
					elseif ok and type(res) == "table" and res.error then
						robuxErr = tostring(res.error)
					end
					break
				end
			end
		end
		if tab.isRobux and not paged then
			if not statusF.Parent then return end
			statusF:ClearAllChildren()
			label(statusF, {text = robuxErr or "Classement indisponible. Vérifie AdminSpending_Server (v4) puis actualise.",
				size=UDim2.fromScale(1,1), color=C.RED, textSize=IS_MOBILE and 11 or 14, wrapped=true, zIndex=12})
			return
		end
		if not paged then
			local remote = tab.remote and ReplicatedStorage:FindFirstChild(tab.remote)
			if not remote then
				if not statusF.Parent then return end
				statusF:Destroy()
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 80); f.BackgroundColor3 = C.BG_DARK; f.BorderSizePixel = 0
				f.LayoutOrder = 3; f.ZIndex = 11; f.Parent = body
				corner(f, 10); stroke(f, C.RED, 1)
				label(f, { text = "❌ Leaderboard system not found\n(mets AdminPanel_Server à jour ou installe LeaderboardManager)", size = UDim2.fromScale(1, 1), color = C.RED, textSize = IS_MOBILE and 11 or 14, wrapped = true, zIndex = 12 })
				return
			end
			local ok, res = pcall(function() return remote:InvokeServer() end)
			if ok and type(res) == "table" then data = res end
		end
		if type(data) == "table" then
			lbc[cacheKey] = { data = data, paged = paged, at = os.clock() }
		else
			data = {} -- lecture ratée : on n'enregistre rien, 🔄 réessaiera
		end
		paint(data, paged)
	end)
end

