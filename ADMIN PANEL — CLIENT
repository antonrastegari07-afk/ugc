			local l = note(body, 1, ST.loading and ("⏳ Lecture du log… %d achats"):format(ST.progress)
				or "⏳ Chargement…", C.TEXT_GREY)
			ST.progLbl = l
			if not ST.loading then loadStats() end
			return
