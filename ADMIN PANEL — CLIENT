	if existing then existing.uid = uid; return end
	local host = avatar.Parent
	local reserved = host:GetAttribute("AdminEconomyReservedHeight") or 0
	local baseH = host.Size.Y.Offset - reserved
	if host.Size.Y.Scale ~= 0 then baseH = host.AbsoluteSize.Y - reserved end
	if baseH <= 0 then return end
	-- Preserve existing child geometry before making room below the card.
	-- In particular, icons and vertically centred action buttons must not grow.
	for _, child in ipairs(host:GetChildren()) do
		if child:IsA("GuiObject") then
			local pos, size = child.Position, child.Size
			if pos.Y.Scale ~= 0 then
				child.Position = UDim2.new(pos.X.Scale, pos.X.Offset, 0, baseH*pos.Y.Scale+pos.Y.Offset)
			end
			if size.Y.Scale ~= 0 then
				child.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, baseH*size.Y.Scale+size.Y.Offset)
			end
		end
	end
	if reserved == 0 then
		host.Size = UDim2.new(host.Size.X.Scale, host.Size.X.Offset, 0, baseH+economy.FOOTER_H)
	end
	local footer = Instance.new("Frame")
	footer.Name = "AdminCurrencyFooter"
	footer.Size = UDim2.new(1, -16, 0, economy.FOOTER_H)
	footer.Position = UDim2.fromOffset(8, baseH)
	footer.BackgroundTransparency = 1; footer.ZIndex = host.ZIndex+1; footer.Parent = host
	local lineH = IS_MOBILE and 14 or 16
	local function makeLine(isRobux, y, color)
		local line = Instance.new("Frame")
		line.Position = UDim2.fromOffset(0, y); line.Size = UDim2.new(1, 0, 0, lineH)
		line.BackgroundTransparency = 1; line.ZIndex = footer.ZIndex; line.Parent = footer
		economy.icon(line, isRobux, color, footer.ZIndex+1)
		return label(line, {text="…", size=UDim2.new(1, -18, 1, 0),
			position=UDim2.fromOffset(18, 0), xAlign=Enum.TextXAlignment.Left,
			color=color, textSize=IS_MOBILE and 10 or 12, zIndex=footer.ZIndex+1, truncate=true})
	end
	local ref = {uid=uid, host=host, points=makeLine(false, 2, Color3.fromRGB(255, 215, 70)),
		robux=makeLine(true, 2+lineH, C.GREEN)}
	local click = Instance.new("TextButton")
	click.Name = "OpenPurchaseSummary"; click.Text = ""; click.BackgroundTransparency = 1
	click.Size = UDim2.fromScale(1,1); click.ZIndex = footer.ZIndex+3
	click.Parent = ref.robux.Parent
	click.Activated:Connect(function() economy.openPurchases(ref.uid) end)
	economy.rows[footer] = ref; economy.byAvatar[avatar] = ref
	footer.Destroying:Connect(function()
		economy.rows[footer] = nil; economy.byAvatar[avatar] = nil; economy.desired[avatar] = nil
	end)
end
function economy.bindAvatar(avatar, uid)
	economy.desired[avatar] = uid
	task.defer(function()
		if avatar.Parent then economy.mount(avatar, economy.desired[avatar])
		else economy.desired[avatar] = nil end
	end)
end
function economy.isVisible(object)
	local current = object
	while current do
		if current:IsA("GuiObject") and not current.Visible then return false end
		if current:IsA("ScreenGui") and not current.Enabled then return false end
		current = current.Parent
	end
	return true
end
function economy.refresh()
	local now, needed = os.clock(), {}
	for footer, ref in pairs(economy.rows) do
		if footer.Parent and economy.isVisible(footer) then
			ref.points.Text = fmtPts(pointsFor(ref.uid)) or "…"
			local value = economy.values[ref.uid]
			ref.robux.Text = value and fmtPts(value.total) or "…"
			if (not value or now-value.time > 120)
				and now-(economy.lastRequest[ref.uid] or -1000) > 15 then
				economy.lastRequest[ref.uid] = now; table.insert(needed, ref.uid)
			end
		end
	end
	if #needed > 0 then economy.fetch(needed) end
end
function economy.connectUpdates()
	if economy.connection then return end
	local remote = ReplicatedStorage:FindFirstChild("AdminSpending_Changed")
	if remote and remote:IsA("RemoteEvent") then
		economy.connection = remote.OnClientEvent:Connect(function(uid, value)
			if type(uid) == "number" then economy.accept(uid, value) end
		end)
	end
end
task.spawn(function()
	while script.Parent do
		economy.connectUpdates(); economy.refresh(); task.wait(0.5)
	end
end)

