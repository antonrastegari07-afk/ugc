		note(body, 0, "📝 Un brouillon, c'est une publication écrite d'avance qui n'existe "
			.. "que pour toi.\n\n"
			.. "Aucun joueur ne le voit, aucune pastille rouge, aucune date de parution : "
			.. "elle est fixée au moment où tu appuies sur 🚀 Publier. Tu peux en préparer "
			.. "trois la veille d'un event et les sortir quand tu veux.", C.PURPLE)

		feedTabs(body, 1)

		bigBtn(body, 2, "➕ NOUVEAU BROUILLON", C.PURPLE, C.PURPLE_DARK, function()
			openEditor(nil, nil, "drafts")
		end)

		sectionLabel(body, 3, string.format("MES BROUILLONS  (%d / %d)", #drafts, maxD))

		if #drafts == 0 then
			note(body, 4, "Aucun brouillon pour l'instant.\n\n"
				.. "Deux façons d'en créer un :\n"
				.. "  • ➕ NOUVEAU BROUILLON ci-dessus\n"
				.. "  • ouvrir une publication du fil et faire « 📝 Copier dans les "
				.. "brouillons » — pratique pour repartir de la mise en forme d'une "
				.. "annonce précédente.", C.TEXT_DIM)
			return
		end

		for i, d in ipairs(drafts) do
			draftRow(body, 100 + i, d)
		end
	end

	------------------------------------------------------------------
	-- 📰 ÉCRAN 1 — LE FIL  (suite)
	------------------------------------------------------------------

	local function renderFeed(body)
		local posts = S.data.posts or {}
		local st = S.data.settings

		-- Bandeau d'état
		local line = string.format("📰 %d publication(s) dans le fil  ·  👁️ %s vue(s) au total",
			#posts, fmtViews(S.data.totalViews or 0))
		if st.feedLimitOn then
			line = line .. string.format("  ·  les joueurs en voient %d", st.feedLimit)
		else
			line = line .. "  ·  les joueurs voient tout"
		end
		if st.storeLimitOn then
			line = line .. string.format("\n🧹 Conservation : %d max (les plus vieilles "
				.. "partent toutes seules)", st.storeLimit)
		end
		if st.enabled == false then
			line = line .. "\n\n⚫ LA CLOCHE EST CACHÉE — aucun joueur ne peut ouvrir le panel."
		end
		local nd = #(S.data.drafts or {})
		if nd > 0 then
			line = line .. string.format("\n📝 %d brouillon(s) en attente — onglet ci-dessous", nd)
		end
		note(body, 0, line, st.enabled == false and C.ORANGE or BELL)

		if not S.data.loaded then
			note(body, 1, "⚠️ Ce serveur n'a pas encore lu le DataStore. Tes modifications "
				.. "seront refusées tant que ce n'est pas résolu (relecture toutes les 45 s).",
				C.ORANGE)
		end

		feedTabs(body, 2)

		bigBtn(body, 3, "➕ NOUVELLE PUBLICATION", GRN, GRN_D, function()
			openEditor(nil, nil, "feed")
		end)

		bigBtn(body, 4, "⚙️ Réglages du panel", C.BG_LIGHT, C.BORDER_BRIGHT, function()
			S.view, S.sdraft, S.dirty = "settings", nil, false
			screen(false)
		end)

		sectionLabel(body, 5, "LE FIL — DE LA PLUS RÉCENTE À LA PLUS ANCIENNE")

		if #posts == 0 then
			note(body, 6, "Le fil est vide. Appuie sur ➕ NOUVELLE PUBLICATION pour écrire "
				.. "la première : elle apparaîtra dans le panel des joueurs, avec sa date, "
				.. "et la cloche se mettra à clignoter en rouge pour tout le monde.",
				C.TEXT_DIM)
			return
		end

		-- ⚠️ LayoutOrder doit rester un ENTIER : on avance de 2 en 2 pour
		--    pouvoir glisser un repère entre deux publications.
		for i, p in ipairs(posts) do
			postRow(body, 100 + i * 2, p)
			-- Repère : à partir d'ici les joueurs ne voient plus rien
			if st.feedLimitOn and i == st.feedLimit and i < #posts then
				note(body, 100 + i * 2 + 1, "── ⬆️ les joueurs s'arrêtent ici ──\n"
					.. "Les publications ci-dessous sont conservées mais invisibles en jeu. "
					.. "Augmente la limite dans les réglages pour les afficher.", C.TEXT_DIM)
			end
		end
	end

	------------------------------------------------------------------
	-- ✏️ ÉCRAN 2 — L'ÉDITEUR
	------------------------------------------------------------------

	local function newPostDraft(p)
		if p then
			return {
				title    = tostring(p.title or ""),
				body     = tostring(p.body or ""),
				imageId  = tostring(p.imageId or ""),
				autoOpen = p.autoOpen == true,
			}
		end
		return { title = "", body = "", imageId = "", autoOpen = false }
	end

	local function previewCard(parent, order)
		local d = S.draft
		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, 0)
		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 12); stroke(box, C.BORDER_SUBTLE, 1.5); padding(box, 10)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 7)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = box

		local dateF = Instance.new("Frame")
		dateF.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
		dateF.BackgroundTransparency = 1
		dateF.LayoutOrder = 1; dateF.ZIndex = 12; dateF.Parent = box
		-- Un brouillon n'a pas encore de date : elle sera celle de la publication
		local p = (not S.editDid) and S.editId and findPost(S.editId) or nil
		label(dateF, { text = "🗓️ " .. (p and fmtWhen(p.at) or "aujourd'hui (à la publication)"),
			size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })

		if d.title ~= "" then
			local t = Instance.new("TextLabel")
			t.Size = UDim2.new(1, 0, 0, 0)
			t.AutomaticSize = Enum.AutomaticSize.Y
			t.BackgroundTransparency = 1
			t.Font = FONT
			t.Text = d.title
			t.TextColor3 = C.TEXT_WHITE
			t.TextSize = IS_MOBILE and 14 or 17
			t.TextWrapped = true
			t.TextXAlignment = Enum.TextXAlignment.Left
			t.LayoutOrder = 2; t.ZIndex = 12; t.Parent = box
		end

		local digits = tostring(d.imageId or ""):match("(%d+)")
		if digits then
			local iw = Instance.new("Frame")
			iw.Size = UDim2.new(1, 0, 0, 0)
			iw.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
			iw.BorderSizePixel = 0
			iw.ClipsDescendants = true
			iw.LayoutOrder = 3; iw.ZIndex = 12; iw.Parent = box
			corner(iw, 10)
			local ar = Instance.new("UIAspectRatioConstraint")
			ar.AspectRatio = 16 / 9
			ar.DominantAxis = Enum.DominantAxis.Width
			ar.Parent = iw
			local im = Instance.new("ImageLabel")
			im.Size = UDim2.new(1, 0, 1, 0)
			im.BackgroundTransparency = 1
			im.Image = "rbxassetid://" .. digits
			im.ScaleType = Enum.ScaleType.Crop
			im.ZIndex = 13
			im.Parent = iw
		end

		if d.body ~= "" then
			local b = Instance.new("TextLabel")
			b.Size = UDim2.new(1, 0, 0, 0)
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.BackgroundTransparency = 1
			b.Font = FONT
			b.Text = d.body
			b.TextColor3 = digits and C.TEXT_GREY or C.TEXT_WHITE
			b.TextSize = digits and (IS_MOBILE and 10 or 12) or (IS_MOBILE and 11 or 14)
			b.TextWrapped = true
			b.RichText = true
			b.TextXAlignment = Enum.TextXAlignment.Left
			b.TextYAlignment = Enum.TextYAlignment.Top
			b.LayoutOrder = 4; b.ZIndex = 12; b.Parent = box
		end

		return box
	end

	local function renderPost(body)
		local isDraft  = (S.editDid ~= nil)
		local isNew    = (S.editId == nil and not isDraft)
		local existing = S.editId and findPost(S.editId) or nil
		local dr       = isDraft and findDraft(S.editDid) or nil

		if S.editId and not existing then
			note(body, 1, "⚠️ Cette publication n'existe plus (supprimée depuis un autre "
				.. "serveur ?). Reviens au fil.", C.ORANGE)
			return
		end
		if isDraft and not dr then
			note(body, 1, "⚠️ Ce brouillon n'existe plus (supprimé ou publié depuis un "
				.. "autre serveur ?). Reviens à la liste.", C.ORANGE)
			return
		end

		S.draft = S.draft or newPostDraft(existing or dr)
		local d = S.draft

		-- Le libellé du bouton d'enregistrement change selon le mode : il est
		-- rafraîchi à la frappe par field(), donc il doit être décidé ici.
		local saveText = isDraft and "💾 ENREGISTRER LE BROUILLON"
			or "💾 ENREGISTRER (sans renotifier)"

		if isDraft then
			note(body, 0, "📝 Brouillon #" .. dr.did
				.. "\n✍️ Enregistré " .. fmtWhen(dr.savedAt)
				.. "\n⚫ Invisible pour les joueurs — aucune pastille rouge", C.PURPLE)
			note(body, 1, "Tant que tu n'appuies pas sur 🚀 PUBLIER, rien ne sort d'ici. "
				.. "La date de parution sera celle du moment où tu publies, pas celle "
				.. "d'aujourd'hui.\n\n"
				.. "🚀 PUBLIER prend ce que tu as sous les yeux, même sans avoir cliqué "
				.. "sur 💾 avant.", C.TEXT_DIM)
		elseif existing then
			local v = tonumber(existing.views) or 0
			note(body, 0, "✏️ Publication #" .. existing.id
				.. "\n🗓️ Publiée le " .. fmtWhen(existing.at)
				.. "\n👁️ Vue par " .. fmtViews(v) .. " joueur(s)", BELL)
			note(body, 1, "Une vue = un joueur qui a ouvert le panel alors qu'il "
				.. "n'avait pas encore lu cette publication. Un même joueur n'est "
				.. "jamais compté deux fois.\n\n"
				.. "Les vues remontent par paquets toutes les 2 minutes : juste après "
				.. "une publication, le compteur a un peu de retard, c'est normal.\n\n"
				.. "🔁 Republier ne remet PAS le compteur à zéro : les vues de la "
				.. "nouvelle diffusion s'ajoutent aux anciennes.", C.TEXT_DIM)
		else
			note(body, 0, "➕ Nouvelle publication.\nElle arrivera tout en haut du fil, "
				.. "datée d'aujourd'hui, et fera clignoter la cloche en rouge pour tous "
				.. "les joueurs.", GRN)
		end

		sectionLabel(body, 2, "TITRE (60 CARACTÈRES MAX)")
		field(body, 3, {
			key = "title", value = d.title, max = 60, accent = BELL,
			saveText = saveText,
			placeholder = "Ex : Halloween Update — 3 nouveaux UGC",
		})

		sectionLabel(body, 4, "IMAGE (FACULTATIF)")
		field(body, 5, {
			key = "imageId", value = d.imageId, max = 200, accent = BELL,
			saveText = saveText,
			placeholder = "ID ou URL de l'image — laisse vide si tu n'en veux pas",
		})
		note(body, 6, "Colle ce que tu veux : « 1234567890 », « rbxassetid://1234567890 » "
			.. "ou l'URL du catalogue — le serveur extrait l'ID.\n\n"
			.. "📐 Format 16:9 (1280×720 par exemple). Une autre proportion est recadrée "
			.. "au centre.\n\n"
			.. "Sans image, le texte de la publication s'affiche un peu plus gros : c'est "
			.. "lui qui porte tout le message.", C.TEXT_DIM)

		sectionLabel(body, 7, "TEXTE (1500 CARACTÈRES MAX)")
		field(body, 8, {
			key = "body", value = d.body, max = 1500, multiline = true, accent = BELL,
			saveText = saveText,
			placeholder = "Ce que voit le joueur...",
		})
		note(body, 9, "Entrée pour aller à la ligne. Mise en forme RichText possible :\n"
			.. "  <b>gras</b>   ·   <i>italique</i>   ·   "
			.. "<font color=\"#FFD24A\">couleur</font>\n\n"
			.. "L'aperçu plus bas se met à jour dès que tu cliques ailleurs.", C.TEXT_DIM)

		sectionLabel(body, 10, "OUVERTURE AUTOMATIQUE")
		toggle(body, 11, {
			key = "autoOpen", value = d.autoOpen, onColor = CYAN,
			title = "🚪 Ouvrir le panel tout seul sur cette publication",
			onDesc = "Quand un joueur rejoint le jeu et n'a pas encore lu cette "
				.. "publication, le panel s'ouvre de lui-même dessus, 3,5 s après son "
				.. "arrivée. Une seule fois par joueur.",
			offDesc = "Le joueur voit seulement la pastille rouge sur la cloche, et ouvre "
				.. "le panel s'il en a envie.",
		})
		note(body, 12, "À réserver aux grosses annonces. Si tu coches ça sur chaque "
			.. "publication, les joueurs se font ouvrir une fenêtre à chaque connexion et "
			.. "finiront par la fermer sans lire.\n\n"
			.. "Ça ne se déclenche PAS pour les joueurs déjà en partie au moment où tu "
			.. "publies : leur arracher l'écran en pleine game serait pire que la pastille.",
			C.TEXT_DIM)

		sectionLabel(body, 13, "APERÇU — CE QUE VOIT LE JOUEUR")
		previewCard(body, 14)

		--── Actions ──
		sectionLabel(body, 20, "APPLIQUER")

		-- Le contenu de l'éditeur, prêt à partir au serveur
		local function payload(extra)
			local pl = {}
			for k, v in pairs(d) do pl[k] = v end
			if extra then for k, v in pairs(extra) do pl[k] = v end end
			return pl
		end

		local function isEmpty()
			return d.title:gsub("%s", "") == "" and d.body:gsub("%s", "") == ""
		end

		--── Mode BROUILLON ──
		if isDraft then
			local _, lbl = bigBtn(body, 21,
				S.dirty and "💾 ENREGISTRER LE BROUILLON" or "✅ Brouillon à jour",
				S.dirty and C.PURPLE or C.BG_MEDIUM,
				S.dirty and C.PURPLE_DARK or C.BORDER_SUBTLE, function()
					if isEmpty() then
						toast("Écris au moins un titre ou un texte", false)
						return
					end
					callAct("draftSave", payload({ did = S.editDid }))
				end)
			S.saveLbl = lbl

			bigBtn(body, 22, "🚀 PUBLIER CE BROUILLON", BELL, BELL_D, function()
				if isEmpty() then
					toast("Écris au moins un titre ou un texte", false)
					return
				end
				ask({
					title = "Publier ce brouillon",
					accent = BELL, delay = 3, confirmText = "🚀 PUBLIER",
					lines = {
						"Il devient une vraie publication : en haut du fil, daté "
							.. "d'aujourd'hui, et il quitte la liste des brouillons.",
						"Une pastille rouge apparaît sur la cloche de TOUS les joueurs, "
							.. "sur tous les serveurs, dans la seconde.",
						S.dirty
							and "✏️ Tes modifications non enregistrées SONT incluses : "
							.. "c'est ce que tu as sous les yeux qui part."
							or "C'est le contenu ci-dessus qui part, tel quel.",
						d.autoOpen
							and "🚪 Ouverture auto ACTIVÉE : le panel s'ouvrira tout seul "
							.. "dessus au prochain join de chaque joueur."
							or "Le panel ne s'ouvrira pas tout seul (option décochée).",
					},
					onConfirm = function()
						callAct("draftPublish", payload({ did = S.editDid }), function(ok)
							if ok then
								S.view, S.editId, S.editDid, S.draft = "feed", nil, nil, nil
							end
						end)
					end,
				})
			end, C.BG_BLACK)

			bigBtn(body, 23, "🗑️ SUPPRIMER LE BROUILLON", C.RED, C.RED_DARK, function()
				ask({
					title = "Supprimer ce brouillon",
					accent = C.RED, danger = true, delay = 3, confirmText = "🗑️ Supprimer",
					lines = {
						"Aucun joueur ne l'a jamais vu — rien ne change côté jeu.",
						"Mais le texte et l'image que tu avais préparés sont perdus.",
					},
					onConfirm = function()
						callAct("draftDelete", { did = S.editDid }, function(ok)
							if ok then
								S.view, S.editId, S.editDid, S.draft = "drafts", nil, nil, nil
							end
						end)
					end,
				})
			end, C.TEXT_WHITE)

			--── Mode NOUVEAU ──
		elseif isNew then
			bigBtn(body, 21, "🔔 PUBLIER MAINTENANT", BELL, BELL_D, function()
				if isEmpty() then
					toast("Écris au moins un titre ou un texte", false)
					return
				end
				ask({
					title = "Publier cette annonce",
					accent = BELL, delay = 3, confirmText = "🔔 PUBLIER",
					lines = {
						"Elle arrive en haut du fil, datée d'aujourd'hui.",
						"Une pastille rouge apparaît sur la cloche de TOUS les joueurs, "
							.. "sur tous les serveurs, dans la seconde. Elle disparaît "
							.. "quand le joueur ouvre le panel.",
						d.autoOpen
							and "🚪 Ouverture auto ACTIVÉE : le panel s'ouvrira tout seul "
							.. "sur cette publication au prochain join de chaque joueur."
							or "Le panel ne s'ouvrira pas tout seul (option décochée).",
					},
					onConfirm = function()
						callAct("create", d, function(ok)
							if ok then S.view, S.editId, S.draft = "feed", nil, nil end
						end)
					end,
				})
			end, C.BG_BLACK)

			bigBtn(body, 22, "📝 ENREGISTRER COMME BROUILLON", C.PURPLE, C.PURPLE_DARK,
				function()
					if isEmpty() then
						toast("Écris au moins un titre ou un texte", false)
						return
					end
					callAct("draftSave", d, function(ok)
						if ok then
							S.view, S.editId, S.editDid, S.draft = "drafts", nil, nil, nil
						end
					end)
				end)
			note(body, 23, "Le brouillon est gardé côté serveur : tu le retrouves après un "
				.. "redémarrage, depuis n'importe quel serveur, et tes autres admins le "
				.. "voient aussi. Rien n'arrive aux joueurs tant que tu ne publies pas.",
				C.TEXT_DIM)
		else
			local _, lbl = bigBtn(body, 21,
				S.dirty and "💾 ENREGISTRER (sans renotifier)" or "✅ Rien à enregistrer",
				C.BG_LIGHT, C.BORDER_BRIGHT, function()
					if not S.dirty then toast("Aucune modification", false) return end
					callAct("update", payload({ id = S.editId }))
				end)
			S.saveLbl = lbl

			bigBtn(body, 22, "🔁 REPUBLIER EN HAUT DU FIL", BELL, BELL_D, function()
				ask({
					title = "Republier cette annonce",
					accent = BELL, delay = 3, confirmText = "🔁 Republier",
					lines = {
						"Elle remonte en haut du fil avec la date d'aujourd'hui, et tout "
							.. "le monde revoit la pastille rouge.",
						"⚠️ Tes modifications en cours ne sont PAS incluses : enregistre "
							.. "d'abord avec 💾, puis republie.",
					},
					onConfirm = function() callAct("bump", { id = S.editId }) end,
				})
			end, C.BG_BLACK)

			bigBtn(body, 23, "📋 DUPLIQUER (publiée tout de suite)", CYAN,
				Color3.fromRGB(30, 100, 150), function()
					callAct("duplicate", { id = S.editId }, function(ok)
						if ok then S.view, S.editId, S.draft = "feed", nil, nil end
					end)
				end, C.BG_BLACK)

			bigBtn(body, 24, "📝 COPIER DANS LES BROUILLONS", C.PURPLE, C.PURPLE_DARK,
				function()
					callAct("draftFromPost", { id = S.editId }, function(ok)
						if ok then
							S.view, S.editId, S.editDid, S.draft = "drafts", nil, nil, nil
						end
					end)
				end)
			note(body, 25, "📋 Dupliquer crée une copie PUBLIÉE immédiatement.\n"
				.. "📝 Copier dans les brouillons crée une copie que tu peux retravailler "
				.. "tranquillement avant de la sortir — l'originale ne bouge pas dans les "
				.. "deux cas.", C.TEXT_DIM)

			bigBtn(body, 26, "🗑️ SUPPRIMER", C.RED, C.RED_DARK, function()
				ask({
					title = "Supprimer cette publication",
					accent = C.RED, danger = true, delay = 4, confirmText = "🗑️ Supprimer",
					lines = {
						"Elle disparaît du fil pour tous les joueurs, immédiatement.",
						"Le texte et l'image ne sont récupérables nulle part ensuite.",
					},
					warn = "⚠️ Irréversible.",
					onConfirm = function()
						callAct("delete", { id = S.editId }, function(ok)
							if ok then S.view, S.editId, S.draft = "feed", nil, nil end
						end)
					end,
				})
			end, C.TEXT_WHITE)
		end
	end

	------------------------------------------------------------------
	-- ⚙️ ÉCRAN 3 — LES RÉGLAGES
	------------------------------------------------------------------

	local function newSettingsDraft(st)
		return {
			enabled      = st.enabled ~= false,
			panelTitle   = tostring(st.panelTitle or "What's new ?"),
			eventId      = tostring(st.eventId or "auto"),
			btnText      = tostring(st.btnText or "Notify Me"),
			autoOptIn    = st.autoOptIn ~= false,
			feedLimitOn  = st.feedLimitOn == true,
			feedLimit    = tonumber(st.feedLimit) or 10,
			storeLimitOn = st.storeLimitOn ~= false,
			storeLimit   = tonumber(st.storeLimit) or 30,
		}
	end

	local function renderSettings(body)
		S.sdraft = S.sdraft or newSettingsDraft(S.data.settings)
		local d = S.sdraft
		local maxKeep = S.data.maxKeep or 100

		resolvePreview()

		sectionLabel(body, 0, "LA CLOCHE")
		toggle(body, 1, {
			key = "enabled", value = d.enabled, store = d,
			title = "🔔 Cloche visible pour les joueurs",
			onDesc = "La cloche s'affiche dans la barre du haut, entre le ⚙️ et « How To "
				.. "Play ».",
			offDesc = "Cachée pour tout le monde. Pratique pendant que tu prépares une "
				.. "série d'annonces.",
		})

		sectionLabel(body, 2, "TITRE DU PANEL")
		field(body, 3, {
			key = "panelTitle", value = d.panelTitle, max = 60, accent = BELL, store = d,
			placeholder = "What's new ?",
		})

