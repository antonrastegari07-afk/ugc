-- 🎥 CAMÉRA DE SPECTATE — pilotée MANUELLEMENT.
--   Pourquoi : régler CameraSubject ne suffit pas si ton jeu a une caméra
--   personnalisée (fréquent en simulateur/rebirth) qui la réécrit chaque frame →
--   tu te revois. Ici on met la caméra en Scriptable et on calcule sa position
--   nous-mêmes, via BindToRenderStep à une priorité APRÈS la caméra du jeu, donc
--   on gagne toujours. Suit le respawn (on relit le Character à chaque frame).
local SPEC_BIND   = "AdminSpectateCam"
local specYaw     = 0
local specPitch   = math.rad(-15)
local specDist    = 14
local specDragging = false
local specInputConns = {}
local specBound   = false
local specTouches = {}      -- [inputObject] = Vector2  (suivi multi-touch pour le pinch)
local specPinchDist = nil   -- dernière distance entre 2 doigts
local specLastMouse = nil   -- dernière position curseur (delta calculé à la main)
local specServerPos = nil   -- position de la cible fournie par le serveur (fallback streaming)

local function spectateApply()
	local target = spectateTarget
	if not target or not target.Parent then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	-- Position cible : le perso local (précis/fluide) si chargé, sinon la position
	-- serveur (cas d'un joueur lointain "streamé out"). On NE retombe JAMAIS sur
	-- soi-même → on prend la caméra en main dès le début.
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	local basePos
	local char = target.Character
	local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
	if hrp then
		basePos = hrp.Position
	elseif specServerPos then
		basePos = specServerPos
	else
		return  -- pas encore de position connue → on garde la dernière CFrame (figée), pas soi
	end
	local focus  = basePos + Vector3.new(0, 2, 0)
	local rot    = CFrame.Angles(0, specYaw, 0) * CFrame.Angles(specPitch, 0, 0)
	local camPos = focus + rot * Vector3.new(0, 0, specDist)
	cam.CFrame = CFrame.lookAt(camPos, focus)
	cam.Focus  = CFrame.new(focus)
end

-- Rotation par glisser (souris gauche/droite OU doigt), zoom molette + pinch.
--   Les connexions ne vivent que pendant le spectate. `gpe` (gameProcessedEvent)
--   à true = l'input a touché l'UI → on ignore, pour ne pas tourner en cliquant
--   les boutons de la barre.
local function specTouchCount()
	local n = 0
	for _ in pairs(specTouches) do n = n + 1 end
	return n
end
local function bindSpectateInput()
	table.insert(specInputConns, UserInputService.InputBegan:Connect(function(input, gpe)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2) and not gpe then
			specDragging = true
			specLastMouse = nil  -- 1er MouseMovement fixe la base (même repère que input.Position)
		elseif t == Enum.UserInputType.Touch and not gpe then
			specTouches[input] = Vector2.new(input.Position.X, input.Position.Y)
		end
	end))
	table.insert(specInputConns, UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			specDragging = false
			specLastMouse = nil
		elseif t == Enum.UserInputType.Touch then
			specTouches[input] = nil
			if specTouchCount() < 2 then specPinchDist = nil end
		end
	end))
	table.insert(specInputConns, UserInputService.InputChanged:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement and specDragging then
			-- ⚠️ input.Delta = (0,0) quand le curseur est libre (caméra Scriptable) →
			--    on calcule le delta nous-mêmes à partir de la position écran.
			local pos = Vector2.new(input.Position.X, input.Position.Y)
			if specLastMouse then
				local d = pos - specLastMouse
				specYaw   = specYaw - d.X * 0.006
				specPitch = math.clamp(specPitch - d.Y * 0.006, -1.4, 1.4)
			end
			specLastMouse = pos
		elseif t == Enum.UserInputType.MouseWheel then
			specDist = math.clamp(specDist - input.Position.Z * 3, 4, 80)
		elseif t == Enum.UserInputType.Touch then
			if specTouches[input] then
				specTouches[input] = Vector2.new(input.Position.X, input.Position.Y)
			end
			if specTouchCount() >= 2 then
				-- 🤏 pinch → zoom
				local pts = {}
				for _, p in pairs(specTouches) do pts[#pts + 1] = p end
				local d = (pts[1] - pts[2]).Magnitude
				if specPinchDist then
					specDist = math.clamp(specDist - (d - specPinchDist) * 0.06, 4, 80)
				end
				specPinchDist = d
			else
				-- 👆 un doigt → rotation
				specYaw   = specYaw - input.Delta.X * 0.012
				specPitch = math.clamp(specPitch - input.Delta.Y * 0.012, -1.4, 1.4)
			end
		end
	end))
end

