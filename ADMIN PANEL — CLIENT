	-- Le graphique : barres empilées, axe gradué, défilement horizontal, barre cliquable
	local function ugcChartView(body, order, res)
		local items = res.buckets
		local n = #items
		local H = IS_MOBILE and 210 or 270
		local f = card(body, order, H)
		local axisW = IS_MOBILE and 36 or 46
		local top, bottom = IS_MOBILE and 14 or 18, IS_MOBILE and 20 or 24
		local plotH = H - top - bottom
		local inner = panelSize().X.Offset - PAD * 2 - axisW - 10
		local colW = math.max(IS_MOBILE and 10 or 13, (n > 0) and (inner / n) or inner)
		local canvasW = math.floor(colW * n)
		local max = 0
		for i, b in ipairs(items) do
			max = math.max(max, mval(b), (res.prev and pval(res.prev[i])) or 0)
		end
		local vmax = niceMax(max)
		for _, q in ipairs({ 0, 0.25, 0.5, 0.75, 1 }) do
			local y = top + (1 - q) * plotH
			label(f, { text = mfmt(vmax * q), size = UDim2.new(0, axisW - 6, 0, 12), position = UDim2.new(0, 2, 0, y - 6),
				xAlign = Enum.TextXAlignment.Right, color = C.TEXT_DIM, textSize = IS_MOBILE and 8 or 10, zIndex = 12 })
			local gl = Instance.new("Frame")
			gl.Position = UDim2.new(0, axisW, 0, y)
			gl.Size = UDim2.new(1, -axisW - 6, 0, 1)
			gl.BackgroundColor3 = C.BORDER_SUBTLE
			gl.BackgroundTransparency = (q == 0) and 0.2 or 0.7
			gl.BorderSizePixel = 0
			gl.ZIndex = 12
			gl.Parent = f
		end
		if n == 0 or max <= 0 then
			label(f, { text = "Rien sur cette période", size = UDim2.fromScale(1, 1), color = C.TEXT_DIM, textSize = MD, zIndex = 13 })
			return f
		end
		local sc = Instance.new("ScrollingFrame")
		sc.Position = UDim2.new(0, axisW, 0, 0)
		sc.Size = UDim2.new(1, -axisW - 6, 1, 0)
		sc.BackgroundTransparency = 1
		sc.BorderSizePixel = 0
		sc.ScrollBarThickness = (canvasW > inner + 1) and 4 or 0
		sc.ScrollingDirection = Enum.ScrollingDirection.X
		sc.CanvasSize = UDim2.new(0, canvasW, 0, 0)
		sc.ZIndex = 12
		sc.Parent = f
		local keepX = U.keepX
		U.keepX = nil
		task.defer(function()
			if sc.Parent then
				sc.CanvasPosition = Vector2.new(keepX or math.max(0, canvasW - sc.AbsoluteSize.X), 0)
			end
		end)
		local every = math.max(1, math.ceil((IS_MOBILE and 36 or 44) / colW))
		local showVals = colW >= (IS_MOBILE and 24 or 30)
		local bw = math.max(3, math.floor(colW * 0.7))
		for i, b in ipairs(items) do
			local col = Instance.new("TextButton")
			col.Text = ""
			col.AutoButtonColor = false
			col.BackgroundColor3 = C.BG_LIGHT
			col.BackgroundTransparency = (i == U.sel) and 0.5 or 1
			col.BorderSizePixel = 0
			col.Position = UDim2.new(0, (i - 1) * colW, 0, 0)
			col.Size = UDim2.new(0, colW, 1, 0)
			col.ZIndex = 12
			col.Parent = sc
			col.MouseButton1Click:Connect(function()
				U.sel = i
				U.keepX = sc.CanvasPosition.X
				screenUGC(false)
			end)
			local base = top + plotH
			local pv = res.prev and pval(res.prev[i])
			if pv and pv > 0 then
				local gh = Instance.new("Frame")
				gh.AnchorPoint = Vector2.new(0.5, 1)
				gh.Position = UDim2.new(0.5, 0, 0, base)
				gh.Size = UDim2.new(0, math.max(4, colW * 0.92), 0, plotH * math.min(1, pv / vmax))
				gh.BackgroundColor3 = C.TEXT_GREY
				gh.BackgroundTransparency = 0.8
				gh.BorderSizePixel = 0
				gh.ZIndex = 13
				gh.Parent = col
			end
			local y = base
			local function seg(v, color)
				if v <= 0 then return end
				local h = plotH * math.min(1, v / vmax)
				local s = Instance.new("Frame")
				s.AnchorPoint = Vector2.new(0.5, 1)
				s.Position = UDim2.new(0.5, 0, 0, y)
				s.Size = UDim2.new(0, bw, 0, math.max(1, h))
				s.BackgroundColor3 = color
				s.BorderSizePixel = 0
				s.ZIndex = 14
				s.Parent = col
				y = y - h
			end
			if U.metric == "n" then
				for _, c in ipairs(CLASSES) do
					if not U.hide[c.k] then seg(tonumber(b[c.k]) or 0, c.color) end
				end
			else
				seg(mval(b), (U.metric == "pts") and PINK or GREEN)
			end
			local v = mval(b)
			if showVals and v > 0 then
				label(col, { text = mfmt(v), size = UDim2.new(0, colW + 10, 0, 12), position = UDim2.new(0.5, 0, 0, y - 1),
					anchor = Vector2.new(0.5, 1), color = (i == U.sel) and GOLD or C.TEXT_GREY,
					textSize = IS_MOBILE and 8 or 10, zIndex = 15 })
			end
			if (i - 1) % every == 0 or i == n or i == U.sel then
				label(col, { text = b.l or "", size = UDim2.new(0, math.max(colW, 44), 0, 12),
					position = UDim2.new(0.5, 0, 0, base + 4), anchor = Vector2.new(0.5, 0),
					color = (i == U.sel) and GOLD or C.TEXT_DIM, textSize = IS_MOBILE and 8 or 10, zIndex = 15 })
			end
		end
		return f
	end

	local function classLine(b)
		local parts = {}
		for _, c in ipairs(CLASSES) do
			local v = tonumber(b[c.k]) or 0
			if v > 0 then table.insert(parts, c.label .. " " .. sep(v)) end
		end
		return (#parts > 0) and table.concat(parts, "  ·  ") or "—"
	end

