	-- 🖥️ ÉCRAN PRINCIPAL
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "ugcban"
		if reset then
			S.data = nil ; S.failed = false ; S.failMsg = nil
			S.tab = "list" ; S.search = ""
			S.query = "" ; S.note = "" ; S.found = nil ; S.looking = false
			S.detailFor = nil ; S.draft = nil ; S.dirty = false
		end

		local body = buildScreen("🚫 UGC BAN", true, RED, nil, function()
			S.data = nil ; screen(false)
		end)

		acTabBar(body, -2, {
			{ id = "list", label = "🚫 Restreints" },
			{ id = "add",  label = "➕ Restreindre" },
		}, S.tab, RED, function(id)
			S.tab = id
			if id ~= "add" then S.found = nil end
			screen(false)
		end)

		acTabBar(body, -1, {
			{ id = "detail", label = "📊 Détail" },
			{ id = "cfg",    label = "⚙️ Réglages" },
		}, S.tab, RED, function(id)
			S.tab = id ; S.found = nil ; screen(false)
		end)

		if not remote("AdminGetUGCRestrict") then
			note(body, 1, "❌ Le serveur n'a pas le module de privation d'UGC.\n\n"
				.. "Ajoute AntiCheat_UGCRestrict.server.lua dans ServerScriptService, "
				.. "puis redémarre le serveur.", RED)
			return
		end

		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetUGCRestrict")
				local ok, res = false, nil
				if fn then ok, res = pcall(function() return fn:InvokeServer(true) end) end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data = res ; S.failMsg = nil
				else
					S.failed = true
					S.failMsg = (type(res) == "table" and res.msg)
						or (ok == false and ("Erreur : " .. tostring(res)))
						or "Réponse inattendue du serveur."
				end
				if currentScreen == "ugcban" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Chargement impossible.\n\n" .. (S.failMsg or "") .. "\n\nAppuie sur 🔄.")
				or "Chargement du registre...",
				S.failed and ORANGE or C.TEXT_GREY)
			return
		end

		if S.tab == "add" then
			renderAdd(body)
		elseif S.tab == "detail" then
			renderDetail(body)
		elseif S.tab == "cfg" then
			renderCfg(body)
		else
			renderList(body)
		end
	end

