	local function deviceState(rec)
		local now = os.time()
		if rec.st == "pending" then
			return "pending", "⏳ EN ATTENTE", PENDING_COL
		elseif rec.st == "active" and (rec.exAt or 0) > now then
			return "active", "📵 BLOQUÉ", DEVICE_COL
		else
			return "expired", "⌛ EXPIRÉ", C.TEXT_DIM
		end
	end

