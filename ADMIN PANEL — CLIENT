	------------------------------------------------------------------
	local function ugcRestrictCard(parent, order, userId, uname)
		if not remote("AdminUGCRestrictAction") then return end

		local host, rows = card(parent, order, "🚫 ACCÈS UGC", C.TEXT_DIM)
		statLine(rows, 1, "État", "…", C.TEXT_DIM)

		local btnWrap = Instance.new("Frame")
		btnWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		btnWrap.BackgroundTransparency = 1
		btnWrap.LayoutOrder = 5
		btnWrap.ZIndex = 13
		btnWrap.Parent = rows

		task.spawn(function()
			local fn = remote("AdminUGCRestrictAction")
			local ok, res = pcall(function()
				return fn:InvokeServer("lookup", { target = userId })
			end)
			if not (ok and type(res) == "table" and res.ok) then return end
			if not host.Parent then return end

			for _, ch in ipairs(rows:GetChildren()) do
				if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") and ch ~= btnWrap then
					ch:Destroy()
				end
			end

			local r = res.record
			if r then
				stroke(host, RED, 1.5)
				statLine(rows, 1, "État", "🚫 PRIVÉ D'UGC", RED)
				statLine(rows, 2, "Depuis", fmtAgo(r.at or 0), C.TEXT_GREY)
				statLine(rows, 3, "Par", tostring(r.by or "?"), C.TEXT_GREY)
				statLine(rows, 4, "Motif", tostring(r.details or "—"), C.TEXT_GREY)
			elseif res.isAdmin then
				statLine(rows, 1, "État", "👮 admin — jamais restreint", C.PURPLE)
				return
			elseif res.readFail then
				statLine(rows, 1, "État", "⚠️ registre illisible", ORANGE)
				return
			else
				statLine(rows, 1, "État", "✅ accès normal", GREEN)
			end

			local b, lbl = actionButton(btnWrap, {
				color = r and GREEN or RED,
				strokeColor = r and GREEN_D or RED_D,
				text = r and "✅ Rendre l'accès UGC" or "🚫 Priver d'UGC",
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13,
			})
			b.MouseButton1Click:Connect(function()
				if r then
					ask({
						title = "Rendre l'accès UGC", userId = userId, userName = uname,
						accent = GREEN, delay = 3, confirmText = "✅ Lever",
						lines = { "Il pourra de nouveau récupérer des UGC, immédiatement." },
						onConfirm = function()
							callAct("remove", { userId = userId })
						end,
					})
				else
					ask({
						title = "Priver d'UGC", userId = userId, userName = uname,
						accent = RED, danger = true, delay = 4, confirmText = "🚫 PRIVER",
						lines = {
							"Il ne pourra plus récupérer aucune UGC, sur aucun serveur, "
								.. "jusqu'à ce qu'un admin lève la sanction.",
							"Il n'est pas banni : il garde ses points et continue de jouer.",
						},
						onConfirm = function()
							callAct("add", { userId = userId,
								note = "Depuis la fiche profil" })
						end,
					})
				end
			end)
		end)

		return host
	end

	--  Injectée dans les profils complets…
	local previousRenderProfile = renderProfile
	renderProfile = function(body, profile)
		previousRenderProfile(body, profile)
		if type(profile) == "table" and not profile.error and profile.userId then
			ugcRestrictCard(body, 23, profile.userId, profile.username or profile.name)
		end
	end

	--  …et dans les fiches « MANAGE PLAYER ».
	local previousScreenManage = screenManage
	screenManage = function(info, backFn)
		previousScreenManage(info, backFn)
		if type(info) ~= "table" or not info.userId then return end
		local b = window:FindFirstChildOfClass("ScrollingFrame")
		if not b then return end
		ugcRestrictCard(b, 502, info.userId, info.username or tostring(info.userId))
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "ugcban", name = "🚫 UGC BAN", color = RED })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "ugcban" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

