		if ST.robux and ST.rbxLoading then
			ST.progLbl = note(body, 4, ST.rbxProgress ~= "" and ST.rbxProgress or "💳 Lecture des achats Robux…", RBX_C)
		elseif ST.robux and ST.rbxErr then
			note(body, 4, "❌ " .. ST.rbxErr, C.RED)
		end

		acTabBar(body, 2, {
			{ id = "paid", label = "💎 Achats payés" },
