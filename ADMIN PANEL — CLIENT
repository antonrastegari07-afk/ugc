local function ugcVisible()
	local out = {}
	local q = tostring(ugcState.search or ""):lower()
	for _, e in ipairs(ugcState.entries) do
		local okA = (ugcState.asset == "all") or (tostring(e.a) == tostring(ugcState.asset))
		local g   = SRC_GROUP[tostring(e.s)] or "paid"
		local okS = (ugcState.src == "all") or (g == ugcState.src)
		local okQ = true
		if #q > 0 then
			local un = (unameCache[tonumber(e.u) or 0] or ""):lower()
			okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.d or ""):lower():find(q, 1, true) ~= nil)
				or (un:find(q, 1, true) ~= nil)
				or (tostring(e.an or ""):lower():find(q, 1, true) ~= nil)
				or (tostring(e.u) == q)
		end
		if okA and okS and okQ then table.insert(out, e) end
	end
	table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
	return out
end

screenUGCLog = function(reset)
	currentScreen = "ugclog"
	if reset then ugcState.entries, ugcState.cursor, ugcState.hasMore = {}, nil, false end

	local body = buildScreen("🎽 UGC REDEEMERS", true, UGC_PINK, nil, function() screenUGCLog(true) end)
	local render

	-- onglets Log / Top
	acTabBar(body, 0, {
		{ id = "log", label = "📜 Log" },
		{ id = "top", label = "🏆 Top redeemers" },
	}, ugcState.tab, UGC_PINK, function(id)
		ugcState.tab = id
		if id == "top" then ugcState.top = nil end
		screenUGCLog(false)
	end)

	-- ════════ ONGLET TOP ════════
	if ugcState.tab == "top" then
		acTabBar(body, 1, {
			{ id = "count", label = "🎽 Nb d'UGC" },
			{ id = "spent", label = "💎 Points dépensés" },
		}, ugcState.topMetric, C.PURPLE, function(id)
