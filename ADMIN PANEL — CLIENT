		local c = cfg()
		if not c then return map, list end
		for _, it in ipairs(c.GetSortedItems()) do
			local k = key(it.AssetId)
			if not map[k] then
				map[k] = it
				table.insert(list, k)
			end
		end
		return map, list
	end

	local function copy(t)
		local o = {}
		for i, v in ipairs(t) do o[i] = v end
