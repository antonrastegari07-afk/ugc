	local UPER = {
		{ id = "1d", label = "Jour" }, { id = "7d", label = "7 j" }, { id = "30d", label = "30 j" },
		{ id = "90d", label = "90 j" }, { id = "365d", label = "1 an" }, { id = "all", label = "Tout" },
	}
	local METRICS = {
		{ id = "n", label = "Nombre" }, { id = "pct", label = "% Robux" },
		{ id = "r", label = "R$ Robux" }, { id = "pts", label = "Points" },
	}
