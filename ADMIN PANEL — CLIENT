local screenGiveTool
do
	--  🎁 GIVE TOOLS — plusieurs joueurs × plusieurs outils, en un seul clic.
	--  La sélection reste gardée : tu peux redonner, changer un joueur, etc.
	--  Tout est dans ce bloc `do` : aucune variable ajoutée au script (limite 200).
	local GS = {
		players = {},        -- [userId] = true
		tools = {},          -- [nom de l'outil] = true
		toolList = nil,      -- noms reçus du serveur (cache de session)
		loadingTools = false,
		pSearch = "", tSearch = "",
		skipDup = true,
		duration = 0,        -- 0 = une fois (perdu à la mort) · sinon secondes de prêt
		allServer = false,   -- prêt à tout le serveur, y compris ceux qui rejoignent
		loans = nil,         -- prêts en cours (lus sur le serveur)
		loansError = nil,
	}
	local DURATION_CHOICES = {
		{ s = 0,    label = "Une fois" },
		{ s = 300,  label = "5 min" },
		{ s = 600,  label = "10 min" },
		{ s = 900,  label = "15 min" },
		{ s = 1800, label = "30 min" },
		{ s = 3600, label = "1 h" },
	}
	local function durLabel(sec)
		for _, d in ipairs(DURATION_CHOICES) do if d.s == sec then return d.label end end
		return tostring(sec) .. " s"
	end
	local function fmtLeft(sec)
		sec = math.max(0, math.floor(sec))
		if sec >= 3600 then return string.format("%d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60) end
		return string.format("%d:%02d", sec // 60, sec % 60)
	end
	local ACC = C.ORANGE

	-- Réponses du serveur : don groupé, fin / arrêt d'un prêt
	adminEvent.OnClientEvent:Connect(function(action, data)
		if type(data) ~= "table" then return end
		if action == "givetools_result" then
			if data.error then toast("❌ " .. tostring(data.error), false) return end
			local given, extended = tonumber(data.given) or 0, tonumber(data.extended) or 0
			local dur = tonumber(data.duration) or 0
			local msg = string.format("🎁 %d objet(s) donné(s)", given)
			if extended > 0 then msg = msg .. string.format(" · %d prolongé(s)", extended) end
			if (tonumber(data.skipped) or 0) > 0 then msg = msg .. string.format(" · %d déjà possédé(s)", data.skipped) end
			if (tonumber(data.offline) or 0) > 0 then msg = msg .. string.format(" · %d joueur(s) parti(s)", data.offline) end
			if dur > 0 then msg = msg .. " · ⏱️ " .. durLabel(dur) end
			toast(msg, given + extended > 0)
			if dur > 0 and GS.fetchLoans then GS.fetchLoans() end
		elseif action == "loan_ended" then
			if data.cancelled then
				toast(string.format("⏹️ %d prêt(s) arrêté(s) · %d arme(s) retirée(s)", data.cancelled, data.removed or 0), true)
			elseif type(data.tools) == "table" then
				toast("⏱️ Prêt terminé : " .. table.concat(data.tools, ", "), true)
			end
			if GS.fetchLoans then GS.fetchLoans() end
		end
	end)

