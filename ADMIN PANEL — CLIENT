			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		if not getUGCTop then stl.Text = "❌ Server not updated."; return end

		local function paint(entries)
			if not st.Parent then return end
			st:Destroy()
			if #entries == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 50); f.BackgroundTransparency = 1
				f.LayoutOrder = 3; f.ZIndex = 11; f.Parent = body
