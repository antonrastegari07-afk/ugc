	local function callAct(action, payload, onDone)
		local fn = remote("AdminEventInfoAction")
		if not fn then toast("EventInfo_Server pas installé", false) return end
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			if ok and type(res) == "table" and res.ok then
				toast(res.msg or "OK", true)
				S.data = nil
				S.dirty = false
				if onDone then onDone(true) end
			else
				toast((type(res) == "table" and res.msg) or "Échec", false)
				if onDone then onDone(false) end
			end
			screen(false)
		end)
	end

	local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun",
		"Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }

	local function fmtWhen(at)
		at = tonumber(at)
		if not at or at <= 0 then return "date inconnue" end
		local d = os.date("!*t", at)
		return string.format("%s %d, %d  ·  %s",
			MONTHS[d.month] or "?", d.day, d.year, fmtAgo(at))
	end

	-- 👁️ Nombre de vues, lisible d'un coup d'œil
	local function fmtViews(n)
		n = tonumber(n) or 0
		if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
		if n >= 1000    then return string.format("%.1fK", n / 1000) end
		return tostring(math.floor(n))
	end

	local function findPost(id)
		for _, p in ipairs((S.data and S.data.posts) or {}) do
			if p.id == id then return p end
		end
		return nil
	end

	local function findDraft(did)
		for _, d in ipairs((S.data and S.data.drafts) or {}) do
			if d.did == did then return d end
		end
		return nil
	end

