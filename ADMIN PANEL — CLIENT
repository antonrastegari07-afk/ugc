			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 12 })

		c.MouseEnter:Connect(function() c.BackgroundColor3 = C.BG_MEDIUM ; cs.Color = CY end)
		c.MouseLeave:Connect(function() c.BackgroundColor3 = C.BG_DARK ; cs.Color = meta.c end)
