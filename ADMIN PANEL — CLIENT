	-- 🎯 ONGLET « RISQUE ÉCONOMIQUE »
	--════════════════════════════════════════════════════════════════
	local function renderRisk(body)
		note(body, 0, string.format(
			"Ce classement répond à UNE question : parmi les joueurs suspects, lesquels "
				.. "sont assez riches pour transformer leur triche en objet ?\n\n"
				.. "Un tricheur à 200 points ne coûte rien à ton économie. Le même à "
				.. "1,9 million est à un pas de vider ton stock. Le score combine donc les "
				.. "warnings et le pouvoir d'achat, une UGC valant %s points.",
			fmtNum(UGC_PRICE)), GOLD)

		--  Filtre : ne montrer que ceux qui peuvent réellement acheter.
		acTabBar(body, 1, {
			{ id = 0, label = "🌐 Tous" },
			{ id = 1, label = "🎽 ≥ 1 UGC" },
			{ id = 2, label = "🎽 ≥ 2 UGC" },
		}, ST.riskMinUGC, GOLD, function(id)
			ST.riskMinUGC = id ; screenACBoards_new()
		end)

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 2; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Calcul du risque...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 3; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local gb = acRemote("AdminGetACBoard")
		if not gb then
			stl.Text = "❌ AdminGetACBoard manquant — mets AdminPanel_Server à jour."
			return
		end

		task.spawn(function()
			--  On part du classement des warnings : c'est la seule dimension
			--  « suspicion » qui a du sens économiquement (un simple signal
			--  écarté ne veut rien dire).
			local ok, res = pcall(function() return gb:InvokeServer("fly_warnings", 60) end)
			if not status.Parent then return end
			if not (ok and type(res) == "table" and type(res.entries) == "table") then
				stl.Text = "Lecture du classement impossible. Appuie sur 🔄."
				return
			end

			local entries = res.entries
			if #entries == 0 then
				status:Destroy()
				label(holder, { text = "✅ Aucun joueur avec des warnings.\n\n"
					.. "Rien à classer — c'est la meilleure nouvelle possible.",
					size = UDim2.new(1, 0, 0, 70), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
				return
			end

			--  Les points sont indispensables au tri ici : on attend, mais on
			--  prévient l'utilisateur de ce qui se passe.
			stl.Text = string.format("Lecture des soldes de %d joueur(s)...", #entries)

			local ids = {}
			for _, e in ipairs(entries) do ids[#ids + 1] = e.userId end

			resolveAC(ids, function()
				if not status.Parent then return end
				status:Destroy()

				local rows = {}
				for _, e in ipairs(entries) do
					local p = pointsOf(e.userId)
					local pw = ugcPower(p) or 0
					if pw >= ST.riskMinUGC then
						rows[#rows + 1] = {
							userId = e.userId,
							warnings = e.value,
							points = p,
							pw = pw,
							score = riskScore(e.value, p),
						}
					end
				end

				table.sort(rows, function(a, b) return a.score > b.score end)

				if #rows == 0 then
					label(holder, { text = "Aucun joueur ne correspond à ce filtre.\n\n"
						.. "Personne avec des warnings n'a assez de points pour s'offrir "
						.. "le nombre d'UGC demandé.",
						size = UDim2.new(1, 0, 0, 70), wrapped = true,
						color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
					return
				end

				for i, r in ipairs(rows) do
					local col = (r.pw >= 1 and r.warnings >= 2) and RED
						or (r.pw >= 1 and ORANGE or C.TEXT_GREY)
					local ref = acLine(holder, i, {
						userId = r.userId, rank = i, accent = GOLD,
						value = string.format("%.0f", r.score),
						valueColor = col,
					})
					--  Ligne de contexte spécifique : on veut voir les deux
					--  facteurs du score côte à côte, pas un total opaque.
					ref.sub.Text = string.format("⚠️ %d warning(s)  ·  💎 %s  ·  🎽 %s",
						r.warnings,
						r.points and fmtNum(r.points) or "—",
						r.pw >= 1 and (math.floor(r.pw) .. " UGC")
							or (math.floor(r.pw * 100) .. " % d'une UGC"))
					ref.sub.TextColor3 = col
					ref.name.Text = nameOf(r.userId) or ("UserId " .. r.userId)
				end

				local nf = Instance.new("Frame")
				nf.Size = UDim2.new(1, 0, 0, 24)
				nf.BackgroundTransparency = 1
				nf.LayoutOrder = 99999
				nf.ZIndex = 11
				nf.Parent = holder
				label(nf, { text = "Score = warnings × pouvoir d'achat en UGC",
					size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, zIndex = 11 })
			end)
		end)
	end

