		-- la nouvelle version n'est pas encore arrivée par réplication.
		local f = folder()
		if S.expectV and f and (tonumber(f:GetAttribute("Version")) or 0) < S.expectV and S.base then
			if not S.draft then S.draft = copy(S.base) end
			return map
		end
		S.expectV = nil
		S.base = current
		if not S.draft or not isDirty() then
			S.draft = copy(current)
			return map
		end
		local inDraft, kept = {}, {}
		for _, k in ipairs(S.draft) do
			if map[k] and not inDraft[k] then inDraft[k] = true; table.insert(kept, k) end
		end
		local fresh = {}
		for _, k in ipairs(current) do
			if not inDraft[k] then table.insert(fresh, k) end
		end
		for _, k in ipairs(kept) do table.insert(fresh, k) end
		S.draft = fresh
		return map
	end

