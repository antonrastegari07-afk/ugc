		box.AutomaticSize = Enum.AutomaticSize.Y
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10)

		-- Contour rouge si le compteur maison et Roblox ne racontent pas la
		-- même histoire : c'est exactement le cas qui t'obligeait à corriger
		-- toi-même après un exploit.
		local drift  = (it.liveRem ~= nil) and (it.liveRem ~= it.internal)
		local hidden = ugcHidden(it.assetId)

		-- Un UGC masqué se voit au premier coup d'œil : bord éteint, contenu
		-- assombri. Sinon on finit par oublier qu'on en a laissé un de côté.
		box.BackgroundColor3 = hidden and Color3.fromRGB(22, 22, 26) or C.BG_DARK
		stroke(box,
			hidden and C.TEXT_DIM
				or (drift and C.RED or (it.shown == 0 and C.TEXT_DIM or C.BORDER_SUBTLE)),
			(drift and not hidden) and 1.5 or 1)
		padding(box, 9)

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = box

		--── Ligne 1 : image, nom, valeur affichée ──
		local head = Instance.new("Frame")
		head.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 46)
		head.BackgroundTransparency = 1
		head.LayoutOrder = 1; head.ZIndex = 12; head.Parent = box

		local s = IS_MOBILE and 34 or 42
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(0, s, 0, s)
		img.Position = UDim2.new(0, 0, 0.5, 0)
		img.AnchorPoint = Vector2.new(0, 0.5)
		img.BackgroundColor3 = C.BG_ITEM
		img.BorderSizePixel = 0
		img.Image = "rbxassetid://" .. tostring(it.imageId or it.assetId)
		img.ScaleType = Enum.ScaleType.Fit
		img.ImageTransparency = hidden and 0.6 or 0
		img.ZIndex = 13
		img.Parent = head
		corner(img, 7)

		local tx = s + 10
		local vw = IS_MOBILE and 84 or 106

		label(head, { text = (hidden and "⚫ " or "") .. tostring(it.name),
			size = UDim2.new(1, -tx - vw - 8, 0, IS_MOBILE and 16 or 19),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 2 or 4),
			xAlign = Enum.TextXAlignment.Left,
			color = hidden and C.TEXT_DIM or C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 14, truncate = true, zIndex = 13 })

		local srcTxt
		if it.source == "live" then
			srcTxt = "🌐 lu chez Roblox"
		elseif it.source == "degraded" then
			srcTxt = "⚠️ repli — dernier stock connu"
		else
			srcTxt = "📦 compteur maison"
		end
		label(head, { text = srcTxt .. "  ·  départ " .. tostring(it.initial),
			size = UDim2.new(1, -tx - vw - 8, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 19 or 24),
			xAlign = Enum.TextXAlignment.Left,
			color = (it.source == "degraded") and C.ORANGE
				or ((it.source == "live") and LIVE or HOUSE),
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })

		label(head, { text = tostring(it.shown) .. " / " .. tostring(it.shownTotal),
			size = UDim2.new(0, vw, 1, 0),
			position = UDim2.new(1, 0, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right,
			color = (it.shown == 0) and C.RED
				or ((it.shown <= (it.shownTotal or 1) * 0.3) and C.ORANGE or C.GREEN),
			textSize = IS_MOBILE and 14 or 17, truncate = true, zIndex = 13 })

		--── Ligne 2 : comparaison maison / Roblox ──
		if it.liveRem ~= nil or isLive then
			local cmp = Instance.new("TextLabel")
			cmp.Size = UDim2.new(1, 0, 0, 0)
			cmp.AutomaticSize = Enum.AutomaticSize.Y
			cmp.BackgroundColor3 = C.BG_ITEM
			cmp.BackgroundTransparency = 0.4
			cmp.BorderSizePixel = 0
			cmp.Font = FONT
			cmp.TextColor3 = drift and C.RED or C.TEXT_DIM
			cmp.TextSize = IS_MOBILE and 9 or 11
			cmp.TextWrapped = true
			cmp.TextXAlignment = Enum.TextXAlignment.Left
			cmp.TextYAlignment = Enum.TextYAlignment.Top
			cmp.LayoutOrder = 2; cmp.ZIndex = 12; cmp.Parent = box
			corner(cmp, 6)
			local cp = Instance.new("UIPadding")
			cp.PaddingTop = UDim.new(0, 5); cp.PaddingBottom = UDim.new(0, 5)
			cp.PaddingLeft = UDim.new(0, 8); cp.PaddingRight = UDim.new(0, 8)
			cp.Parent = cmp

			local lines = {}
			table.insert(lines, string.format("📦 Maison : %d      🌐 Roblox : %s",
				it.internal,
				it.liveRem ~= nil and (tostring(it.liveRem) .. "/" .. tostring(it.liveTotal or "?"))
					or "pas encore lu"))
			if drift then
				local d = it.internal - it.liveRem
				table.insert(lines, string.format(
					"⚠️ Écart de %d — ton compteur %s de %d par rapport à la réalité.",
					math.abs(d), d > 0 and "surestime" or "sous-estime", math.abs(d)))
			end
			if it.liveAt then
				table.insert(lines, "Lu " .. fmtAgo(it.liveAt)
					.. (it.liveFresh and "" or "  ·  ⌛ périmé"))
			end
			cmp.Text = table.concat(lines, "\n")
		end

		--── Ligne 3 : édition du compteur maison ──
		local edit = Instance.new("Frame")
		edit.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		edit.BackgroundTransparency = 1
		edit.LayoutOrder = 3; edit.ZIndex = 12; edit.Parent = box

		local gw = IS_MOBILE and 34 or 42
		local function step(x, txt, delta)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(0, 0.5)
			c.Position = UDim2.new(0, x, 0.5, 0)
			c.Size = UDim2.new(0, gw, 1, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = edit
			local b = actionButton(c, {
				color = delta > 0 and C.GREEN or C.BG_LIGHT,
				strokeColor = delta > 0 and C.GREEN_DARK or C.BORDER_BRIGHT,
				text = txt, textSize = IS_MOBILE and 11 or 13, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				local target = math.max(0, (it.internal or 0) + delta)
				call("setstock", { assetId = it.assetId, amount = target }, function()
					S.data = nil; screen(false)
				end)
			end)
		end

		step(0, "−10", -10)
		step(gw + 4, "−1", -1)

		local boxX = (gw + 4) * 2
		local rightW = (gw + 4) * 2 + (IS_MOBILE and 44 or 54)
		local tb = Instance.new("TextBox")
		tb.Position = UDim2.new(0, boxX, 0, 0)
		tb.Size = UDim2.new(1, -boxX - rightW - 4, 1, 0)
		tb.BackgroundColor3 = C.BG_ITEM
		tb.BorderSizePixel = 0
		tb.Font = FONT
		tb.Text = tostring(it.internal)
		tb.PlaceholderText = "stock exact"
		tb.PlaceholderColor3 = C.TEXT_DIM
		tb.TextColor3 = C.TEXT_WHITE
		tb.TextSize = IS_MOBILE and 12 or 15
		tb.ClearTextOnFocus = true
		tb.ZIndex = 12
		tb.Parent = edit
		corner(tb, 7); stroke(tb, HOUSE, 1)

		tb.FocusLost:Connect(function(enter)
			if not enter then tb.Text = tostring(it.internal) return end
			local v = tonumber(tb.Text:match("%-?%d+"))
			if not v or v < 0 then
				toast("Entre un nombre entier positif", false)
				tb.Text = tostring(it.internal)
				return
			end
			call("setstock", { assetId = it.assetId, amount = math.floor(v) }, function()
				S.data = nil; screen(false)
			end)
		end)

		local rx = rightW
		local function rstep(fromRight, txt, delta)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, -fromRight, 0.5, 0)
			c.Size = UDim2.new(0, gw, 1, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = edit
			local b = actionButton(c, {
				color = C.GREEN, strokeColor = C.GREEN_DARK,
				text = txt, textSize = IS_MOBILE and 11 or 13, radius = 7, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				call("setstock", { assetId = it.assetId, amount = math.max(0, (it.internal or 0) + delta) },
				function() S.data = nil; screen(false) end)
			end)
		end

		local resetW = IS_MOBILE and 40 or 50
		rstep(resetW + 4 + gw + 4, "+1", 1)
		rstep(resetW + 4, "+10", 10)

		local rc = Instance.new("Frame")
		rc.AnchorPoint = Vector2.new(1, 0.5)
		rc.Position = UDim2.new(1, 0, 0.5, 0)
		rc.Size = UDim2.new(0, resetW, 1, 0)
		rc.BackgroundTransparency = 1
		rc.ZIndex = 12; rc.Parent = edit
		local rb = actionButton(rc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "♻️", textSize = IS_MOBILE and 12 or 14, radius = 7, zIndex = 12 })
		--── 👁️ Visible ou non dans le shop ──
		local visRow = Instance.new("Frame")
		visRow.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		visRow.BackgroundTransparency = 1
		visRow.LayoutOrder = 4
		visRow.ZIndex = 12
		visRow.Parent = box

		local visBtn, visLbl = actionButton(visRow, {
			color = hidden and C.BG_LIGHT or LIVE,
			strokeColor = hidden and C.BORDER_BRIGHT or LIVE_D,
			text = hidden and "⚫ MASQUÉ — appuie pour l'afficher"
				or "🟢 VISIBLE dans le shop — appuie pour le masquer",
			textColor = hidden and C.TEXT_GREY or C.BG_BLACK,
			textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 12,
		})

		visBtn.MouseButton1Click:Connect(function()
			local fn = remote("AdminSetUGCVisible")
			if not fn then
				toast("UGCSalesLock_Server pas installé côté serveur", false)
				return
			end
			visLbl.Text = "⏳ …"
			task.spawn(function()
				local ok, res = pcall(function()
					return fn:InvokeServer(it.assetId, hidden)   -- masqué → on affiche
				end)
				if ok and type(res) == "table" and res.ok then
					toast(res.msg or "Visibilité changée", true)
				else
					toast((type(res) == "table" and res.msg) or "Échec", false)
				end
				S.data = nil; screen(false)
			end)
		end)

		rb.MouseButton1Click:Connect(function()
			ask({
				title = "Remettre « " .. it.name .. " » à " .. tostring(it.initial),
				accent = C.PURPLE, delay = 3, confirmText = "♻️ Remettre à " .. tostring(it.initial),
				lines = {
					"Le compteur maison repasse de " .. tostring(it.internal)
						.. " à " .. tostring(it.initial) .. " (ta valeur InitialStock).",
					isLive and "Tu es en 🌐 Stock Roblox : cette valeur ne s'affichera pas "
						.. "tant que l'API répond. Elle sert uniquement de repli."
						or "Les joueurs verront le nouveau chiffre immédiatement.",
				},
				onConfirm = function()
					call("resetstock", { assetId = it.assetId }, function()
						S.data = nil; screen(false)
					end)
				end,
			})
		end)

		return box
	end

	------------------------------------------------------------------
	-- 🖥️ L'ÉCRAN
	------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "stockcfg"
		if reset then S.data = nil; S.failed = false; S.draftProxy = nil end

		local body = buildScreen("📦 RÉGLAGES DU STOCK", true, HOUSE,
			function() screenUGCLog(false) end,
			function() S.data = nil; screen(true) end)

		if not remote("AdminGetStockPanel") then
			note(body, 1, "❌ Le serveur n'a pas le système de stock.\n\n"
				.. "Colle le fichier UGCStock_LiveSystem.lua à la fin de ton script "
				.. "serveur de stock UGC, puis redémarre le serveur.", C.RED)
			return
		end

		-- Chargement, une seule tentative automatique
		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetStockPanel")

				-- ⚠️ NE JAMAIS écrire `local ok, res = fn and pcall(...)` :
				--    en Lua, `a and f()` tronque à UNE seule valeur. `ok` aurait
				--    reçu true et `res` serait resté nil — le serveur répond
				--    correctement mais on jette sa réponse, et l'écran affiche
				--    « impossible de lire les réglages » sans aucune raison.
				local ok, res = false, nil
				if fn then
					ok, res = pcall(function() return fn:InvokeServer() end)
				end

				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data = res
					S.failMsg = nil
				else
					S.failed = true
					-- On garde la raison exacte donnée par le serveur : sans elle,
					-- « impossible de charger » ne dit pas si c'est un refus de
					-- droits, un remote absent ou une vraie erreur.
					if type(res) == "table" and res.msg then
						S.failMsg = tostring(res.msg)
					elseif fn == nil then
						S.failMsg = "Le remote AdminGetStockPanel n'existe pas encore. "
							.. "Le serveur a-t-il fini de charger ?"
					elseif ok == false then
						S.failMsg = "Erreur pendant l'appel : " .. tostring(res)
					else
						S.failMsg = "Le serveur a répondu un " .. type(res)
							.. " au lieu d'une table. Lance _G.UGCStock_Diag() "
							.. "dans la barre de commande."
					end
				end
				if currentScreen == "stockcfg" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Impossible de lire les réglages.\n\n"
					.. (S.failMsg and (tostring(S.failMsg) .. "\n\n") or "")
					.. "Appuie sur 🔄 en haut pour réessayer.")
				or "Chargement des réglages du stock...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		local cfg    = S.data.cfg
		local st     = S.data.state or {}
		local items  = S.data.items or {}
		local isLive = (cfg.mode == "live")

		--── Bandeau d'état ──────────────────────────────────
		local degraded = false
		local drifts = 0
		for _, it in ipairs(items) do
			if it.source == "degraded" then degraded = true end
			if it.liveRem ~= nil and it.liveRem ~= it.internal then drifts = drifts + 1 end
		end

		if isLive and degraded then
			note(body, 0, "⚠️ REPLI ACTIF — l'API Roblox ne répond pas. Le shop affiche le "
				.. "compteur maison, qui contient le dernier stock réel connu et continue de "
				.. "descendre à chaque achat. Les joueurs ne voient aucune erreur.\n\n"
				.. "Dernière erreur : " .. tostring(st.err or "?")
				.. "\nDernière lecture réussie : "
				.. ((st.lastOk and st.lastOk > 0) and fmtAgo(st.lastOk) or "jamais"),
				C.ORANGE)
		elseif isLive then
			note(body, 0, "🌐 Le shop affiche le stock réel de Roblox.\n"
				.. "Dernière lecture : "
				.. ((st.lastOk and st.lastOk > 0) and fmtAgo(st.lastOk) or "jamais")
				.. "  ·  " .. tostring(st.lastMs or 0) .. " ms  ·  "
				.. tostring(st.okCount or 0) .. " OK / " .. tostring(st.failCount or 0) .. " échec(s)"
				.. (drifts > 0 and ("\n\n🔴 " .. drifts .. " UGC ont un écart entre ton compteur "
					.. "et Roblox — c'est ce que le mode live corrige tout seul.") or ""),
				LIVE)
		else
			note(body, 0, "📦 Le shop affiche TON compteur, celui que tu contrôles ici.\n"
				.. "C'est le fonctionnement que tu as depuis le début : fiable et instantané, "
				.. "mais si un achat passe sans être compté, l'écart reste jusqu'à ce que tu le "
				.. "corriges."
				.. (drifts > 0 and ("\n\n🔴 " .. drifts .. " UGC ont déjà un écart avec Roblox. "
					.. "Vois le détail plus bas.") or ""),
				HOUSE)
		end

		--── Choix du mode ───────────────────────────────────
		sectionLabel(body, 1, "SOURCE DU STOCK AFFICHÉ")

		modeCard(body, 2, {
			title = "📦 Compteur maison", color = HOUSE, selected = not isLive,
			desc = "Le stock est un nombre que tu possèdes. Il descend à chaque achat "
				.. "confirmé et tu le corriges à la main ici. Aucune dépendance externe, "
				.. "affichage instantané — mais un achat qui échappe au système laisse un "
				.. "écart que tu dois rattraper toi-même.",
			onPick = function()
				ask({
					title = "Passer en 📦 Compteur maison",
					accent = HOUSE, delay = 3, confirmText = "📦 Activer le compteur maison",
					lines = {
						"Le shop affichera de nouveau TON compteur.",
						"Les valeurs actuelles sont déjà les bonnes : elles ont été alignées "
							.. "sur Roblox à chaque lecture réussie du mode live.",
						"Tu retrouves l'édition manuelle immédiate, et plus aucun appel HTTP "
							.. "n'est fait.",
					},
					warn = "⚠️ Si un exploit passe, l'écart avec le vrai stock ne se corrigera "
						.. "plus tout seul.",
					onConfirm = function() saveCfg({ mode = "internal" }, "📦 Compteur maison actif") end,
				})
			end,
		})

		modeCard(body, 3, {
			title = "🌐 Stock Roblox", color = LIVE, selected = isLive,
			desc = "Le stock affiché est celui que Roblox connaît vraiment. Impossible à "
				.. "désynchroniser : même si un achat échappe à ton système, le chiffre reste "
				.. "juste. Se rafraîchit toutes les " .. tostring(cfg.pollSeconds) .. " s, et "
				.. "bascule tout seul sur le compteur maison si l'API tombe.",
			onPick = function()
				ask({
					title = "Passer en 🌐 Stock Roblox",
					accent = LIVE, delay = 4, confirmText = "🌐 Activer le stock Roblox",
					lines = {
						"Le shop affichera le stock réel du catalogue Roblox, rafraîchi toutes "
							.. "les " .. tostring(cfg.pollSeconds) .. " secondes.",
						"Plus jamais besoin de corriger un compteur après un exploit : le "
							.. "chiffre vient de la source.",
						"Ton compteur maison continue de tourner en arrière-plan et sera "
							.. "réaligné sur Roblox à chaque lecture — il sert de repli.",
					},
					warn = (cfg.proxyHost == "")
						and "⚠️ Aucun proxy configuré. Roblox interdit à HttpService d'appeler "
						.. "ses propres domaines : sans proxy, chaque lecture échouera et tu "
						.. "resteras en repli permanent. Configure-le juste en dessous, puis "
						.. "utilise 🧪 Tester."
						or nil,
					danger = (cfg.proxyHost == ""),
					onConfirm = function() saveCfg({ mode = "live" }, "🌐 Stock Roblox actif") end,
				})
			end,
		})

		--── Réglages du mode live ───────────────────────────
		sectionLabel(body, 10, "RELAIS VERS L'API ROBLOX")

		local pw = Instance.new("Frame")
		pw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		pw.BackgroundTransparency = 1
		pw.LayoutOrder = 11; pw.ZIndex = 11; pw.Parent = body

		local btnW = IS_MOBILE and 74 or 96
		local pb = Instance.new("TextBox")
		pb.AnchorPoint = Vector2.new(0, 0.5)
		pb.Position = UDim2.new(0, 0, 0.5, 0)
		pb.Size = UDim2.new(1, -btnW - 8, 1, 0)
		pb.BackgroundColor3 = C.BG_DARK
		pb.BorderSizePixel = 0
		pb.Font = FONT
		pb.PlaceholderText = "roproxy.com  (vide = appel direct)"
		pb.PlaceholderColor3 = C.TEXT_DIM
		pb.Text = S.draftProxy or cfg.proxyHost or ""
		pb.TextColor3 = C.TEXT_WHITE
		pb.TextSize = IS_MOBILE and 11 or 14
		pb.TextXAlignment = Enum.TextXAlignment.Left
		pb.ClearTextOnFocus = false
		pb.ZIndex = 12
		pb.Parent = pw
		corner(pb, 8); stroke(pb, LIVE, 1)
		local pp = Instance.new("UIPadding"); pp.PaddingLeft = UDim.new(0, 10); pp.Parent = pb

		pb:GetPropertyChangedSignal("Text"):Connect(function() S.draftProxy = pb.Text end)

		local sc = Instance.new("Frame")
		sc.AnchorPoint = Vector2.new(1, 0.5)
		sc.Position = UDim2.new(1, 0, 0.5, 0)
		sc.Size = UDim2.new(0, btnW, 1, 0)
		sc.BackgroundTransparency = 1
		sc.ZIndex = 12; sc.Parent = pw
		local sb = actionButton(sc, { color = LIVE_D, strokeColor = LIVE,
			text = "💾 Poser", textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })
		sb.MouseButton1Click:Connect(function()
			saveCfg({ proxyHost = pb.Text }, "Relais enregistré")
		end)

		note(body, 12, "Roblox refuse que ton serveur appelle catalog.roblox.com directement. "
			.. "Il faut un relais qui répète la requête.\n\n"
			.. "• Le plus rapide : tape roproxy.com — service public gratuit, rien à installer, "
			.. "mais partagé donc parfois lent ou saturé.\n"
			.. "• Le plus fiable : ton propre Cloudflare Worker (gratuit, 5 minutes, le code "
			.. "complet est dans INSTALL_STOCK.md). Tu tapes alors le domaine de ton worker.\n\n"
			.. "Actuellement : " .. ((cfg.proxyHost ~= "" and cfg.proxyHost)
				or "aucun — appel direct, qui échouera"),
			(cfg.proxyHost == "") and C.ORANGE or C.TEXT_DIM)

		local tc = Instance.new("Frame")
		tc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		tc.BackgroundTransparency = 1
		tc.LayoutOrder = 13; tc.ZIndex = 11; tc.Parent = body
		local tb2 = actionButton(tc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🧪 Tester la connexion", textSize = IS_MOBILE and 12 or 14,
			radius = 9, zIndex = 11 })
