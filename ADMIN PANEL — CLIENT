	local hist = profile.flyTpHistory or {}
	if #hist > 0 then
		statRow(flyRows, 3, "── Recent detections ──", "", C.TEXT_DIM)
		local shown = 0
		for i = #hist, 1, -1 do
			local e = hist[i]
			shown = shown + 1
			if shown > 6 then break end
			local when = e.t and fmtAgo(e.t) or "?"
			-- clé = type, valeur = quand ; détails en petit dessous
