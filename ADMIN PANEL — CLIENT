	local function modePicker(parent, order)
		local d = ensureDraft()
		local active = d.mode or "ugc"
		local shadow = d.shadow == true

		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		wrap.BackgroundTransparency = 1
		wrap.LayoutOrder = order; wrap.ZIndex = 11; wrap.Parent = parent

		local items = {
			{ id = "ban",  txt = "🔨 Ban",  col = ORANGE, colD = ORANGE_D },
			{ id = "ugc",  txt = "🚫 UGC",  col = RED,    colD = RED_D },
			{ id = "test", txt = "🧪 Test", col = CYAN,   colD = CYAN_D },
		}
		for i, it in ipairs(items) do
			local c = Instance.new("Frame")
			c.Size = UDim2.new(1 / 3, -5, 1, 0)
			c.Position = UDim2.new((i - 1) / 3, i == 1 and 0 or 3, 0, 0)
			c.BackgroundTransparency = 1
			c.ZIndex = 12; c.Parent = wrap

			--  La fiche affichée n'est pas forcément le mode actif : tu peux
			--  préparer le mode ban pendant que tu tournes en ugc.
			local shown = (S.mode == it.id)
			--  Un liseré plein signale le mode réellement en vigueur.
			local live = (it.id == "test") and shadow or (it.id == active and not shadow)

			local b = actionButton(c, {
				color = shown and it.col or C.BG_DARK,
				strokeColor = live and it.col or C.BORDER_SUBTLE,
				text = it.txt .. (live and "  ●" or ""),
				textColor = shown and Color3.new(0, 0, 0) or C.TEXT_GREY,
				textSize = IS_MOBILE and 11 or 13, radius = 9, zIndex = 12 })
			b.MouseButton1Click:Connect(function()
				S.mode = it.id
				screen(false)
			end)
		end
		return wrap
	end

