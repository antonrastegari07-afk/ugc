					.. "n'as jamais à toucher au code de l'anti-fly : il relit ces valeurs à "
					.. "chaque mesure.", GREEN)
		end

		bigBtn(body, 910, "♻️ Recharger depuis le serveur", C.BG_LIGHT, C.BORDER_BRIGHT,
			function()
				callAct("reload", {}, function()
					S.cfg, S.draft, S.dirty = nil, nil, false
					S.failed, S.failMsg = false, nil
					screen(false)
				end)
			end)
	end

