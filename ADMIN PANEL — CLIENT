		-- Chargement
		--──────────────────────────────────────────────────────────────
		if not S.cfg and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetUGCRestrict")
				local ok, res = false, nil
				for attempt = 1, 2 do
					if fn then
						--  `false` = on ne veut PAS la liste des restreints ici,
						--  seulement la config. Une requête plus légère.
						ok, res = pcall(function() return fn:InvokeServer(false, false) end)
					end
					if ok and type(res) == "table" and res.ok then break end
					if attempt == 1 then task.wait(0.7) end
				end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.cfg = res.config or {}
					S.mode = (S.cfg.mode == "ban") and "ban" or "ugc"
					S.failed, S.failMsg = false, nil
