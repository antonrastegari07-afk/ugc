			openProfileDetail(uname, function() screen(false) end)
		end)

		if state == "pending" then
			act(2, IS_MOBILE and "✕" or "✕ Annuler", C.BG_LIGHT, C.BORDER_BRIGHT, true, function()
				callServer("devicecancel", { target = tostring(uid) }, function()
