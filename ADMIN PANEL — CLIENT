	local function mmss(sec)
		sec = math.max(0, math.floor(tonumber(sec) or 0))
		if sec >= 3600 then
			return string.format("%dh%02d", math.floor(sec / 3600), math.floor(sec / 60) % 60)
		end
		if sec >= 60 then
			local m, s = math.floor(sec / 60), sec % 60
			if s == 0 then return m .. " min" end
			return string.format("%dm%02d", m, s)
		end
		return sec .. "s"
	end

	--  Séparateur de milliers : « 1 250 000 » se lit, « 1250000 » non.
	local function comma(n)
		local s = tostring(math.floor(tonumber(n) or 0))
		local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
		return (out:gsub("^%s+", ""))
	end

	--  ✅ Confirmation en DEUX APPUIS, sans fenêtre par-dessus. Une boîte de
	--     dialogue coûte un écran entier et casse le fil ; deux appuis
	--     suffisent à empêcher le clic accidentel, et le bouton dit lui-même
	--     ce qui va se passer.
	local function armed(key)
		return S.confirmKey == key and (os.clock() - S.confirmAt) < 6
	end
	local function arm(key) S.confirmKey, S.confirmAt = key, os.clock() end
	local function disarm() S.confirmKey = nil end

	------------------------------------------------------------------
	-- 🧱 COMPOSANTS
	--    Tout est défini ici. Ce bloc ne dépend que de `corner`, `stroke`,
	--    `actionButton`, `toast`, `buildScreen`, `C`, `FONT` et `IS_MOBILE`
	--    — les seules briques du panel principal dont je suis certain. Rien
	--    ne peut casser à cause d'un autre bloc.
	------------------------------------------------------------------
	local FS = IS_MOBILE and 0.86 or 1

	local function lbl(parent, props)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Font           = FONT
		l.Text           = props.text or ""
		l.TextColor3     = props.color or C.TEXT_WHITE
		l.TextSize       = (props.size or 13) * FS
		l.TextXAlignment = props.xAlign or Enum.TextXAlignment.Left
		l.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
		l.TextWrapped    = props.wrap or false
		l.Size           = props.frame or UDim2.new(1, 0, 1, 0)
		if props.pos then l.Position = props.pos end
		if props.auto then l.AutomaticSize = Enum.AutomaticSize.Y end
		if props.truncate then l.TextTruncate = Enum.TextTruncate.AtEnd end
		l.ZIndex = props.z or 12
		l.Parent = parent
		return l
	end

