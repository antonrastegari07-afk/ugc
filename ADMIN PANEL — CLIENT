local function fmtNum(n)
	if not n or type(n) ~= "number" then return "0" end
	if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
	if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
	if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end
local function fmtTime(s)
	if not s or s <= 0 then return "0min" end
	local d = math.floor(s / 86400); local h = math.floor((s % 86400) / 3600); local m = math.floor((s % 3600) / 60)
	if d > 0 then return string.format("%dd %dh %dmin", d, h, m) end
	if h > 0 then return string.format("%dh %dmin", h, m) end
	return string.format("%dmin", m)
end
local function fmtAgo(ts)
	if not ts or ts <= 0 then return "Unknown" end
	local a = os.time() - ts
	if a < 60 then return a .. "s ago" end
	if a < 3600 then return math.floor(a / 60) .. "min ago" end
	if a < 86400 then return math.floor(a / 3600) .. "h ago" end
	return string.format("%.1fd ago", a / 86400)
end

