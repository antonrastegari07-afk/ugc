	local R = {}
	local function remote(name)
		local r = R[name]
		if r and r.Parent then return r end
		r = ReplicatedStorage:FindFirstChild(name)
		R[name] = r
		return r
	end

	local S = {
		cfg     = nil,      -- config serveur telle que reçue
		draft   = nil,      -- copie locale en cours d'édition
