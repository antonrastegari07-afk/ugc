	-- 📡 ONGLET « RÉCENT »
	--════════════════════════════════════════════════════════════════
	local function renderFeed(body)
		note(body, 0, "Les joueurs dont l'anti-cheat a RETENU un signal récemment, tous "
			.. "serveurs confondus. Les signaux écartés par le filtre de certitude "
			.. "n'apparaissent pas ici — c'est volontaire : cette liste ne doit contenir "
			.. "que des dossiers qui méritent ton temps.\n\n"
			.. "Touche une ligne pour ouvrir le dossier complet.", CYAN)

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 1; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Lecture du fil...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 2; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local function paint(entries)
			if not status.Parent then return end
			status:Destroy()

			if #entries == 0 then
				label(holder, { text = "✅ Aucune détection retenue récemment.\n\n"
					.. "Soit personne ne triche, soit tu es en shadow depuis peu — le fil "
					.. "se remplit avec un décalage de 90 secondes maximum.",
					size = UDim2.new(1, 0, 0, 80), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
				return
			end

			--  ① On dessine TOUT DE SUITE, avec les UserId. L'écran n'est
			--     jamais vide, même si la résolution prend deux secondes.
			local refs, ids = {}, {}
			for i, e in ipairs(entries) do
				ids[#ids + 1] = e.userId
				refs[#refs + 1] = acLine(holder, i, {
					userId = e.userId, rank = i, accent = ORANGE,
					value = e.at and fmtAgo(e.at) or "?",
					valueColor = ORANGE,
				})
			end

			--  ② Puis on remplit, sans rien reconstruire.
			resolveAC(ids, function()
				if holder.Parent then fillLines(refs, stdSub) end
			end)
		end

		if not acRemote("AdminUGCRestrictAction") then
			stl.Text = "❌ AntiCheat_UGCRestrict.server.lua manquant côté serveur."
			return
		end

		callAC("feed", { limit = 50 }, function(res)
			if not status.Parent then return end
			if not (res and res.ok) then
				stl.Text = "Lecture impossible. Appuie sur 🔄."
				return
			end
			paint(res.entries or {})
		end)
	end

