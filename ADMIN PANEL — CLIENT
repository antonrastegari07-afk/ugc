	local function msgText(e)
		if e.mt and e.mt ~= "" then return e.mt end
		if GCFG and GCFG.GetMessageText and e.m then
			local ok, t = pcall(function() return GCFG.GetMessageText(e.m) end)
			if ok and t then return t end
		end
		return nil
	end

	-- Icône de l'objet offert.
	--   1. celle enregistrée AVEC le gift (fiable même si tu retires le produit)
	--   2. sinon celle de GIFT_CONFIG pour ce produit
	--   3. sinon rien → on retombe sur l'emoji du type
	local function itemImage(e)
		local raw = e.ic
		if type(raw) == "string" and raw ~= "" then
			if raw:match("^rbxassetid://") then return raw end
			local digits = raw:match("(%d+)")
			if digits then return "rbxassetid://" .. digits end
		end
		if GCFG and GCFG.GetItem and e.pr and e.pr ~= 0 then
			local ok, item = pcall(function() return GCFG.GetItem(e.pr) end)
			if ok and type(item) == "table" and item.icon then return item.icon end
		end
		return nil
	end

	local function itemLabel(e)
		if e.lb and e.lb ~= "" then return e.lb end
		if GCFG and GCFG.GetItem and GCFG.GetDisplayName and e.pr and e.pr ~= 0 then
			local ok, item = pcall(function() return GCFG.GetItem(e.pr) end)
			if ok and type(item) == "table" then
				local ok2, n = pcall(function() return GCFG.GetDisplayName(item) end)
				if ok2 and n then return n end
			end
		end
		if (tonumber(e.p) or 0) > 0 then return fmtNum(e.p) .. " points" end
		return kMeta(ek(e)).l
	end

	local function fmtWhen(e)
		if e.unk or not e.t or e.t == 0 then return "📅 date inconnue" end
		return fmtAgo(e.t)
	end

	local function noteCard(parent, order, text, color)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundColor3 = C.BG_ITEM
		f.BackgroundTransparency = 0.25
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = parent
		corner(f, 8); stroke(f, color or C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
