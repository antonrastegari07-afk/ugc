	--     IIFE, donc invisible depuis ce bloc. corner / stroke / label /
	--     buildScreen viennent d'un bloc antérieur au niveau du script et
	--     sont, eux, bien accessibles.
	----------------------------------------------------------------------
	local function noteCard(parent, order, text, color)
