	goC.LayoutOrder = 502
	goC.ZIndex = 11
	goC.Parent = body
	local goBtn = actionButton(goC, { color = C.GREEN, strokeColor = C.GREEN_DARK, text = "📍 TELEPORT", textSize = IS_MOBILE and 15 or 18, radius = 10, zIndex = 11 })
	goBtn.MouseButton1Click:Connect(function()
		if not selectedTarget then toast("Select a player!", false); return end
		local val = tonumber(box.Text)
		if not val or val < 1 or val > 125 then toast("Invalid number (1–125)", false); return end
		adminEvent:FireServer("tpcheckpoint", selectedTarget, math.floor(val))
		toast("📍 " .. selectedTarget .. " → CP" .. math.floor(val), true)
	end)
end

