			("sur %s au départ%s"):format(nfmt(R.init), soldPct and ("  ·  %.0f%% parti"):format(soldPct) or ""), C.GREEN)
		tile(g1, 2, "UGC épuisés", ("%d / %d"):format(R.out, R.known),
