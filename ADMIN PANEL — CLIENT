		applyPlayerFilter()

		----------------------------------------------------------------
		-- 🔧 OUTILS
		----------------------------------------------------------------
		local toolsTitle = sectionLabel(body, 10, "OUTILS  — plusieurs possibles")
		local tRefs = {}
		local function paintTool(r)
			local sel = GS.tools[r.name] == true
			r.btn.BackgroundColor3 = sel and C.ORANGE_DARK or C.BG_DARK
			r.stroke.Color = sel and ACC or C.BORDER_SUBTLE
			r.stroke.Thickness = sel and 2 or 1
			r.btn.Text = (sel and "  ✅ " or "  🔧 ") .. r.name
			r.btn.TextColor3 = sel and C.TEXT_WHITE or C.TEXT_GREY
		end
		local function toolVisible(r)
			local q = GS.tSearch:lower()
			return q == "" or r.lower:find(q, 1, true) ~= nil
		end

		quickRow(body, 11, {
			{ text = "✅ Tous (filtrés)", fn = function()
				for _, r in ipairs(tRefs) do
					if toolVisible(r) then GS.tools[r.name] = true end
					paintTool(r)
				end
				refreshSummary()
			end },
			{ text = "✕ Aucun", fn = function()
				table.clear(GS.tools)
				for _, r in ipairs(tRefs) do paintTool(r) end
				refreshSummary()
			end },
		})
		searchBox(body, 12, "🔍 Chercher un outil...", GS.tSearch, function(t)
			GS.tSearch = t
			for _, r in ipairs(tRefs) do r.btn.Visible = toolVisible(r) end
		end)

		local grid = Instance.new("Frame")
		grid.Size = UDim2.new(1, 0, 0, 0)
		grid.AutomaticSize = Enum.AutomaticSize.Y
		grid.BackgroundTransparency = 1
		grid.LayoutOrder = 13
		grid.ZIndex = 11
		grid.Parent = body
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.new(0.5, -4, 0, IS_MOBILE and 34 or 40)
		gl.CellPadding = UDim2.new(0, 8, 0, 6)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = grid

		-- 📭 Message sous la grille : erreur / aucun outil, avec bouton Réessayer
		local toolsMsg = Instance.new("Frame")
		toolsMsg.Size = UDim2.new(1, 0, 0, 0)
		toolsMsg.AutomaticSize = Enum.AutomaticSize.Y
		toolsMsg.BackgroundColor3 = C.BG_ITEM
		toolsMsg.BorderSizePixel = 0
		toolsMsg.LayoutOrder = 14
		toolsMsg.Visible = false
		toolsMsg.ZIndex = 11
		toolsMsg.Parent = body
		corner(toolsMsg, 8); stroke(toolsMsg, C.ORANGE, 1)
		padding(toolsMsg, 8)
		local tml = Instance.new("UIListLayout")
		tml.Padding = UDim.new(0, 6); tml.SortOrder = Enum.SortOrder.LayoutOrder; tml.Parent = toolsMsg
		local msgLbl = Instance.new("TextLabel")
		msgLbl.Size = UDim2.new(1, 0, 0, 0)
		msgLbl.AutomaticSize = Enum.AutomaticSize.Y
		msgLbl.BackgroundTransparency = 1
		msgLbl.Font = FONT
		msgLbl.Text = ""
		msgLbl.TextColor3 = C.ORANGE
		msgLbl.TextSize = IS_MOBILE and 10 or 12
		msgLbl.TextWrapped = true
		msgLbl.TextXAlignment = Enum.TextXAlignment.Left
		msgLbl.LayoutOrder = 1
		msgLbl.ZIndex = 12
		msgLbl.Parent = toolsMsg
		local retryWrap = Instance.new("Frame")
		retryWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 36)
		retryWrap.BackgroundTransparency = 1
		retryWrap.LayoutOrder = 2
		retryWrap.ZIndex = 12
		retryWrap.Parent = toolsMsg
		local retryBtn = actionButton(retryWrap, { color = C.ORANGE_DARK, strokeColor = C.ORANGE,
			text = "🔄 Réessayer", textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })

		local fetchTools  -- fwd

		local function buildTools()
			if not grid.Parent then return end
			for _, ch in ipairs(grid:GetChildren()) do
				if not ch:IsA("UIGridLayout") then ch:Destroy() end
			end
			table.clear(tRefs)
			local titleLbl = toolsTitle:FindFirstChildOfClass("TextLabel")
			local names = GS.toolList

			-- ⏳ Pas encore de liste : « chargement » OU erreur — jamais d'attente infinie
			if not names then
				if titleLbl then
					titleLbl.Text = GS.toolsError and "OUTILS  — ❌ non chargés" or "OUTILS  — chargement..."
				end
				toolsMsg.Visible = GS.toolsError ~= nil
				msgLbl.Text = GS.toolsError or ""
				refreshSummary()
				return
			end

			if #names == 0 then
				toolsMsg.Visible = true
				msgLbl.Text = "Aucun Tool trouvé dans ServerStorage (ni dans ses dossiers).\n"
					.. "Range tes outils dans ServerStorage, puis appuie sur Réessayer."
			else
				toolsMsg.Visible = false
				msgLbl.Text = ""
			end
			if titleLbl then
				titleLbl.Text = (#names == 0) and "OUTILS  — aucun"
					or ("OUTILS  (" .. #names .. ")  — plusieurs possibles")
			end
			for i, name in ipairs(names) do
				local b = Instance.new("TextButton")
				b.BackgroundColor3 = C.BG_DARK
				b.AutoButtonColor = false
				b.BorderSizePixel = 0
				b.Font = FONT
				b.TextSize = IS_MOBILE and 11 or 14
				b.TextXAlignment = Enum.TextXAlignment.Left
				b.TextTruncate = Enum.TextTruncate.AtEnd
				b.LayoutOrder = i
				b.ZIndex = 12
				b.Parent = grid
				corner(b, 8)
				local r = { name = name, lower = string.lower(tostring(name)), btn = b, stroke = stroke(b, C.BORDER_SUBTLE, 1) }
				tRefs[#tRefs + 1] = r
				paintTool(r)
				b.Visible = toolVisible(r)
				b.MouseButton1Click:Connect(function()
					GS.tools[name] = not GS.tools[name] or nil
					paintTool(r)
					refreshSummary()
				end)
			end
			-- un outil retiré de ServerStorage sort de la sélection
			local known = {}
			for _, n in ipairs(names) do known[n] = true end
			for n in pairs(GS.tools) do if not known[n] then GS.tools[n] = nil end end
			refreshSummary()
		end

		-- 📡 Lecture de la liste avec délai maximum : au bout de 8 s sans réponse,
		--    on affiche la cause probable au lieu de tourner à l'infini.
		--    Une réponse qui arrive en retard est quand même utilisée.
		fetchTools = function()
			local token = {}
			GS.fetchToken = token
			GS.loadingTools = true
			GS.toolsError = nil
			task.spawn(function()
				local ok, res = pcall(function() return getToolsEvent:InvokeServer() end)
				if ok and type(res) == "table" then
					GS.toolList = res
					GS.toolsError = nil
				elseif not GS.toolList and GS.fetchToken == token then
					GS.toolsError = "❌ Le serveur a renvoyé une erreur :\n" .. tostring(res)
				end
				if GS.fetchToken == token then GS.loadingTools = false end
				if currentScreen == "givetool" and GS.onTools then GS.onTools() end
			end)
			task.delay(8, function()
				if GS.fetchToken == token and GS.loadingTools and not GS.toolList then
					GS.loadingTools = false
					GS.toolsError = "⏳ Le serveur ne répond pas (AdminGetTools).\n"
						.. "• Dans AdminPanel_Server, la fonction getToolsEvent.OnServerInvoke doit exister (patch T1).\n"
						.. "• Regarde la console SERVEUR : une erreur rouge dans AdminPanel_Server bloque tout ce qui suit."
					if currentScreen == "givetool" and GS.onTools then GS.onTools() end
				end
			end)
		end

		retryBtn.MouseButton1Click:Connect(function()
			GS.toolList = nil
			fetchTools()
			buildTools()
		end)

		clearBtn.MouseButton1Click:Connect(function()
			table.clear(GS.players); table.clear(GS.tools)
			for _, r in ipairs(pRefs) do paintPlayer(r) end
			for _, r in ipairs(tRefs) do paintTool(r) end
			refreshSummary()
		end)

		----------------------------------------------------------------
		-- ⏱️ PRÊTS EN COURS
		----------------------------------------------------------------
		sectionLabel(body, 20, "⏱️ PRÊTS EN COURS SUR CE SERVEUR")
		local loansHolder = Instance.new("Frame")
		loansHolder.Size = UDim2.new(1, 0, 0, 0)
		loansHolder.AutomaticSize = Enum.AutomaticSize.Y
		loansHolder.BackgroundTransparency = 1
		loansHolder.LayoutOrder = 21
		loansHolder.ZIndex = 11
		loansHolder.Parent = body
		local lhl = Instance.new("UIListLayout")
		lhl.Padding = UDim.new(0, IS_MOBILE and 5 or 7)
		lhl.SortOrder = Enum.SortOrder.LayoutOrder
		lhl.Parent = loansHolder
		local countdowns = {}   -- { lbl, endAt }

		local function renderLoans()
			if not loansHolder.Parent then return end
			for _, ch in ipairs(loansHolder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			table.clear(countdowns)
			local list = GS.loans
			if not list then
				label(loansHolder, { text = GS.loansError or "Chargement des prêts...",
					size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26), xAlign = Enum.TextXAlignment.Left,
					color = GS.loansError and C.ORANGE or C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12,
					wrapped = true, zIndex = 12 })
				return
			end
			if #list == 0 then
				label(loansHolder, { text = "Aucun prêt en cours. Choisis une durée plus haut pour en créer un.",
					size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 26), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_DIM, textSize = IS_MOBILE and 10 or 12, wrapped = true, zIndex = 12 })
				return
			end
			for i, loan in ipairs(list) do
				local card = Instance.new("Frame")
				card.Size = UDim2.new(1, 0, 0, IS_MOBILE and 54 or 60)
				card.BackgroundColor3 = C.BG_DARK
				card.BorderSizePixel = 0
				card.LayoutOrder = i
				card.ZIndex = 12
				card.Parent = loansHolder
				corner(card, 9); stroke(card, ACC, 1)
				local stopW = IS_MOBILE and 70 or 90
				local timeW = IS_MOBILE and 56 or 70
				label(card, { text = "🔧 " .. table.concat(loan.tools or {}, ", "),
					size = UDim2.new(1, -stopW - timeW - 26, 0, IS_MOBILE and 17 or 20),
					position = UDim2.new(0, 10, 0, IS_MOBILE and 7 or 9), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_WHITE, textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 13 })
				local who = loan.all and "🌍 tout le serveur"
					or ("🧍 " .. tostring(loan.players or 0) .. " joueur(s)"
						.. ((type(loan.names) == "table" and #loan.names > 0) and (" · " .. table.concat(loan.names, ", ")) or ""))
				label(card, { text = who .. " · " .. durLabel(loan.duration) .. " · par " .. tostring(loan.by or "?"),
					size = UDim2.new(1, -stopW - timeW - 26, 0, IS_MOBILE and 14 or 16),
					position = UDim2.new(0, 10, 0, IS_MOBILE and 28 or 33), xAlign = Enum.TextXAlignment.Left,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
				local tl = label(card, { text = fmtLeft(loan.remaining or 0),
					size = UDim2.new(0, timeW, 1, 0), position = UDim2.new(1, -stopW - 14, 0, 0),
					anchor = Vector2.new(1, 0), color = ACC, textSize = IS_MOBILE and 13 or 16, zIndex = 13 })
				countdowns[#countdowns + 1] = { lbl = tl, endAt = loan.endAt or os.clock() }
				local sc = Instance.new("Frame")
				sc.AnchorPoint = Vector2.new(1, 0.5)
				sc.Position = UDim2.new(1, -8, 0.5, 0)
				sc.Size = UDim2.new(0, stopW, 0, IS_MOBILE and 30 or 34)
				sc.BackgroundTransparency = 1
				sc.ZIndex = 13
				sc.Parent = card
				local sb, sl = actionButton(sc, { color = C.RED_DARK, strokeColor = C.RED,
					text = "✕ Arrêter", textSize = IS_MOBILE and 10 or 12, radius = 8, zIndex = 13 })
				local armed = false
				sb.MouseButton1Click:Connect(function()
					if not armed then
						armed = true; sl.Text = "Sûr ?"
						task.delay(3, function() if sl.Parent then armed = false; sl.Text = "✕ Arrêter" end end)
						return
					end
					adminEvent:FireServer("cancelloan", nil, loan.id)
				end)
			end
			if #list >= 2 then
				local ac = Instance.new("Frame")
				ac.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 38)
				ac.BackgroundTransparency = 1
				ac.LayoutOrder = 999
				ac.ZIndex = 12
				ac.Parent = loansHolder
				local ab, al = actionButton(ac, { color = C.RED_DARK, strokeColor = C.RED,
					text = "⏹️ Tout arrêter (" .. #list .. ")", textSize = IS_MOBILE and 11 or 13, radius = 8, zIndex = 12 })
				local armedAll = false
				ab.MouseButton1Click:Connect(function()
					if not armedAll then
						armedAll = true; al.Text = "Appuie encore pour tout arrêter"
						task.delay(3, function() if al.Parent then armedAll = false; al.Text = "⏹️ Tout arrêter (" .. #list .. ")" end end)
						return
					end
					adminEvent:FireServer("cancelloan", nil, "all")
				end)
			end
		end

		GS.fetchLoans = function()
			local token = {}
			GS.loansToken = token
			task.spawn(function()
				local ok, res = pcall(function() return getToolsEvent:InvokeServer("loans") end)
				if GS.loansToken ~= token then return end
				if ok and type(res) == "table" and type(res.loans) == "table" then
					local now = os.clock()
					for _, l in ipairs(res.loans) do l.endAt = now + (tonumber(l.remaining) or 0) end
					GS.loans, GS.loansError = res.loans, nil
				elseif ok then
					GS.loans, GS.loansError = nil, "⚠️ Serveur pas à jour : colle le bloc L1 dans AdminPanel_Server."
				else
					GS.loans, GS.loansError = nil, "❌ Lecture des prêts impossible : " .. tostring(res)
				end
				if currentScreen == "givetool" and GS.onLoans then GS.onLoans() end
			end)
			task.delay(8, function()
				if GS.loansToken == token and not GS.loans and not GS.loansError then
					GS.loansError = "⏳ Le serveur ne répond pas (prêts)."
					if currentScreen == "givetool" and GS.onLoans then GS.onLoans() end
				end
			end)
		end

		-- compte à rebours (une seule boucle par écran, s'arrête quand l'écran disparaît)
		task.spawn(function()
			while loansHolder.Parent do
				local ended = false
				for _, c in ipairs(countdowns) do
					local left = c.endAt - os.clock()
					if c.lbl.Parent then c.lbl.Text = fmtLeft(left) end
					if left <= -2 then ended = true end
				end
				if ended then
					table.clear(countdowns)
					GS.fetchLoans()
				end
				task.wait(1)
			end
		end)

		refreshSummary()
		GS.onTools = buildTools   -- toujours l'écran le plus récent
		GS.onLoans = renderLoans
		if not GS.toolList then fetchTools() end
		buildTools()
		renderLoans()
		GS.fetchLoans()
	end
end
