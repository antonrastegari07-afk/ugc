		--──────────────────────────────────────────────────────────────
		if S.dirty then
			note(body, -2,
				"✏️ Tu as des modifications NON ENREGISTRÉES. Rien n'est appliqué tant que "
					.. "tu n'as pas cliqué sur ENREGISTRER en bas de l'écran.", ORANGE)
