		p.PaddingBottom = UDim.new(0, 6) ; p.Parent = f
		lbl(f, { text = text, color = C.TEXT_DIM, size = IS_MOBILE and 9.5 or 11,
			wrap = true, auto = true, frame = UDim2.new(1, 0, 0, 0),
			yAlign = Enum.TextYAlignment.Top })
	end

	local function choiceRow(parent, order, title, valueText, onOpen, help)
