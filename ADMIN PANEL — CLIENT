		toggleRow(body, 16, "👥 Épargner les comptes alternatifs", S.mAlts,
			function(v) S.mAlts = v; screen(false) end)

		sectionLabel(body, 17, "RAISON AFFICHÉE AU JOUEUR")
		local rb = Instance.new("TextBox")
		rb.LayoutOrder = 18
		rb.Size = UDim2.new(1, 0, 0, IS_MOBILE and 36 or 42)
		rb.BackgroundColor3 = C.BG_DARK
		rb.BorderSizePixel = 0
		rb.Font = FONT
		rb.PlaceholderText = "Ex: Exploiting — permanent ban"
		rb.PlaceholderColor3 = C.TEXT_DIM
		rb.Text = S.mDetails or ""
		rb.TextColor3 = C.TEXT_WHITE
		rb.TextSize = IS_MOBILE and 11 or 14
		rb.TextXAlignment = Enum.TextXAlignment.Left
		rb.ClearTextOnFocus = false
		rb.ZIndex = 11
		rb.Parent = body
		corner(rb, 8); stroke(rb, C.BORDER_SUBTLE, 1)
		local rp = Instance.new("UIPadding"); rp.PaddingLeft = UDim.new(0, 10); rp.Parent = rb
		rb:GetPropertyChangedSignal("Text"):Connect(function() S.mDetails = rb.Text end)

		bigBtn(body, 20, "🔨 BANNIR", C.RED, C.RED_DARK, true, function() callAction("ban") end)
		bigBtn(body, 21, "📵 METTRE UN DEVICE BAN EN ATTENTE", DEVICE_DARK, DEVICE_COL, true, function()
			callAction("devicequeue")
		end)
		bigBtn(body, 22, "👟 KICK (joueur en ligne)", C.ORANGE, C.ORANGE_DARK, false, function() callAction("kick") end)
		bigBtn(body, 23, "✅ DÉBANNIR", C.GREEN, C.GREEN_DARK, true, function() callAction("unban") end)

		noteCard(body, 24, "Le débannissement retire le ban Roblox, la fiche interne, la fiche héritée "
			.. "(BannedPlayers), lève le blocage d'appareil ET annule une demande en attente.", C.TEXT_DIM)
	end

	----------------------------------------------------------------------
	-- 🖥️ ÉCRAN PRINCIPAL
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "bans"

		if reset then
			S.entries, S.cursor, S.hasMore = {}, nil, false
			S.logLoaded = false
			S.cfgFailed = false
			S.lookup    = nil
			S.devLoaded = false
		end

		local body = buildScreen("🚫 GESTION DES BANS", true, ACCENT, nil, function()
			S.cfg = nil
			screen(true)
		end)

		acTabBar(body, 0, {
			{ id = "cfg",    label = "⚙️ Réglages" },
			{ id = "log",    label = "📜 Journal" },
			{ id = "device", label = "📵 Appareils"
				.. ((S.devCount.pending or 0) > 0 and (" (" .. S.devCount.pending .. ")") or "") },
			{ id = "manual", label = "🔨 Manuel" },
		}, S.tab, ACCENT, function(id) S.tab = id; screen(false) end)

		local function refreshIfStillHere(tab)
			if currentScreen == "bans" and window.Visible and S.tab == tab then
				screen(false)
			end
		end

		-- Config : une seule tentative automatique, ensuite c'est le bouton 🔄
		if not S.cfg and getCfg and not S.loadingCfg and not S.cfgFailed then
			S.loadingCfg = true
			task.spawn(function()
				local ok, res = pcall(function() return getCfg:InvokeServer() end)
				S.loadingCfg = false
				if ok and type(res) == "table" and type(res.config) == "table" then
					S.cfg     = res.config
					S.totals  = res.totals
					S.session = res.session
					S.devOk   = res.deviceBlockSupported ~= false
					S.dirty   = false
					S.devCount.pending = res.devicePending or 0
					S.devCount.active  = res.deviceActive or 0
					if S.mDuration == -1 and res.config.adDuration then
						S.mDuration = res.config.adDuration
					end
					S.mDevice = res.config.adDeviceBlock == true
				else
					S.cfgFailed = true
				end
				refreshIfStillHere("cfg")
			end)
		end

		if S.tab == "cfg" then
			renderSettings(body)

		elseif S.tab == "manual" then
			renderManual(body)

		elseif S.tab == "device" then
			if not S.devLoaded and getDev and not S.devLoading then
				S.devLoading = true
				task.spawn(function()
					local ok, res = pcall(function() return getDev:InvokeServer(true) end)
					S.devLoading = false
					if ok and type(res) == "table" and res.throttled then
						task.wait(1.5)
						refreshIfStillHere("device")
						return
					end
					S.devLoaded = true
					if ok and type(res) == "table" then
						S.devEntries = res.entries or {}
						S.devOk = res.deviceBlockSupported ~= false
						local ids = {}
						for _, e in ipairs(S.devEntries) do table.insert(ids, e.userId) end
						resolveUsernames(ids, function()
							resolvePoints(ids, function() refreshIfStillHere("device") end)
						end)
					else
						refreshIfStillHere("device")
					end
				end)
			end
			renderDevices(body)

		else
			-- Journal : UNE seule tentative automatique, pilotée par S.logLoaded
			if not S.logLoaded and getLog and not S.loadingLog then
				S.loadingLog = true
				task.spawn(function()
					local ok, res = pcall(function() return getLog:InvokeServer(nil, 30) end)
					S.loadingLog = false
					if ok and type(res) == "table" and res.throttled then
						task.wait(1.5)
						refreshIfStillHere("log")
						return
					end
					S.logLoaded = true
					if ok and type(res) == "table" then
						S.entries = res.entries or {}
						S.cursor  = res.cursor
						S.hasMore = res.hasMore == true
						local ids = {}
						for _, e in ipairs(S.entries) do table.insert(ids, e.u) end
						resolveUsernames(ids, function()
							resolvePoints(ids, function() refreshIfStillHere("log") end)
						end)
					else
						refreshIfStillHere("log")
					end
				end)
			end
			renderJournal(body)
		end
	end

	----------------------------------------------------------------------
	-- 📵 CARTE "DEVICE BAN" — injectée dans TOUS les profils et fiches joueur
	----------------------------------------------------------------------
	local function deviceBanCard(parent, order, userId, username, isOnline)
		local host, rows = card(parent, order, "📵 DEVICE BAN — blocage d'appareil", DEVICE_COL)

		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1, 0, 0, 0)
		info.AutomaticSize = Enum.AutomaticSize.Y
		info.BackgroundTransparency = 1
		info.Font = FONT
		info.Text = isOnline
			and "🟢 Joueur EN LIGNE : le ban et le blocage d'appareil partent immédiatement. "
			.. "24 h de blocage (limite Roblox), PC Windows/macOS uniquement."
			or  "⚪ Joueur HORS LIGNE : la demande est MISE EN ATTENTE et appliquée à la seconde où il "
			.. "rejoint. Roblox ne peut pas bloquer un appareil absent — c'est la seule méthode qui marche."
		info.TextColor3 = isOnline and C.TEXT_GREY or PENDING_COL
		info.TextSize = IS_MOBILE and 9 or 11
		info.TextWrapped = true
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.LayoutOrder = 1
		info.ZIndex = 13
		info.Parent = rows

		-- Ligne d'état, remplie dès que le serveur répond
		local statusRow = statLine(rows, 2, "État actuel", "…", C.TEXT_DIM)

		local grid = Instance.new("Frame")
		grid.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		grid.BackgroundTransparency = 1
		grid.LayoutOrder = 3
		grid.ZIndex = 13
		grid.Parent = rows
		local g = Instance.new("UIGridLayout")
		g.CellSize = UDim2.new(1 / 3, -5, 1, 0)
		g.CellPadding = UDim2.new(0, 6, 0, 0)
		g.SortOrder = Enum.SortOrder.LayoutOrder
		g.Parent = grid

		local function refreshStatus()
			if not doAct then return end
			task.spawn(function()
				local ok, res = pcall(function()
					return doAct:InvokeServer("devicestatus", { target = tostring(userId) })
				end)
				if not (ok and type(res) == "table" and res.ok) then return end
				if not (statusRow and statusRow.Parent) then return end

				local lbls = statusRow:GetChildren()
				local valueLbl
				for _, ch in ipairs(lbls) do
					if ch:IsA("TextLabel") and ch.TextXAlignment == Enum.TextXAlignment.Right then
						valueLbl = ch
					end
				end
				if not valueLbl then return end

				if res.device then
					local st, txt, col = deviceState(res.device)
					if st == "pending" then
						valueLbl.Text = txt .. " (" .. fmtAgo(res.device.qAt) .. ")"
					elseif st == "active" then
						valueLbl.Text = txt .. " — expire " .. fmtUntil(res.device.exAt)
					else
						valueLbl.Text = txt
					end
					valueLbl.TextColor3 = col
				else
					valueLbl.Text = "aucun"
					valueLbl.TextColor3 = C.GREEN
				end
			end)
		end
		refreshStatus()

		local function opt(o, text, dur)
			local c = Instance.new("Frame")
			c.LayoutOrder = o
			c.BackgroundTransparency = 1
			c.ZIndex = 13
			c.Parent = grid

			local b, lbl = actionButton(c, {
				color = isOnline and DEVICE_DARK or PENDING_COL,
				strokeColor = isOnline and DEVICE_COL or C.ORANGE_DARK,
				text = text,
				textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13,
			})

			local armed = false
			b.MouseButton1Click:Connect(function()
				if not armed then
					armed = true
					lbl.Text = "⚠️ Confirmer"
					task.delay(3, function()
						if lbl and lbl.Parent then armed = false; lbl.Text = text end
					end)
					return
				end
				armed = false; lbl.Text = text

				-- Le serveur décide tout seul : en ligne → immédiat, hors ligne → file d'attente.
				callServer("ban", {
					target      = tostring(userId),
					duration    = dur,
					deviceBlock = true,
					reason      = "admin",
					details     = "Device ban via admin panel (" .. fmtDur(dur) .. ")",
					displayMsg  = "You have been banned. Your device is blocked for 24 hours.",
				}, function(res)
					if res and res.ok then
						S.entries, S.cursor, S.hasMore = {}, nil, false
						S.logLoaded = false
						S.devLoaded = false
					end
					refreshStatus()
				end)
			end)
		end

		local prefix = isOnline and "📵 " or "⏳ "
		opt(1, prefix .. "24 h",    86400)
		opt(2, prefix .. "7 j",     7 * 86400)
		opt(3, prefix .. "♾️ Perm", -1)

		-- Bouton d'annulation (utile si une demande traîne)
		local cancelWrap = Instance.new("Frame")
		cancelWrap.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 32)
		cancelWrap.BackgroundTransparency = 1
		cancelWrap.LayoutOrder = 4
		cancelWrap.ZIndex = 13
		cancelWrap.Parent = rows
		local cb, clbl = actionButton(cancelWrap, {
			color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "✕ Annuler / retirer la fiche appareil",
			textSize = IS_MOBILE and 10 or 12, radius = 7, zIndex = 13,
		})
		local armedC = false
		cb.MouseButton1Click:Connect(function()
			if not armedC then
				armedC = true
				clbl.Text = "⚠️ Confirmer"
				task.delay(3, function()
					if clbl and clbl.Parent then armedC = false
						clbl.Text = "✕ Annuler / retirer la fiche appareil" end
				end)
				return
			end
			armedC = false
			clbl.Text = "✕ Annuler / retirer la fiche appareil"
			callServer("devicecancel", { target = tostring(userId) }, function()
				S.devLoaded = false
				refreshStatus()
			end)
		end)

		return host
	end

	-- 👤 Tous les profils (écran PROFILE) reçoivent la carte automatiquement
	local previousRenderProfile = renderProfile
	renderProfile = function(body, profile)
		previousRenderProfile(body, profile)
		if type(profile) == "table" and not profile.error and profile.userId then
			deviceBanCard(body, 22, profile.userId,
				profile.username or profile.name, profile.isOnline == true)
		end
	end

	-- 👤 Toutes les fiches "MANAGE PLAYER" la reçoivent aussi
	local previousScreenManage = screenManage
	screenManage = function(info, backFn)
		previousScreenManage(info, backFn)
		if type(info) ~= "table" or not info.userId then return end
		local body = window:FindFirstChildOfClass("ScrollingFrame")
		if not body then return end
		deviceBanCard(body, 500, info.userId,
			info.username or tostring(info.userId),
			Players:GetPlayerByUserId(info.userId) ~= nil)
	end

	----------------------------------------------------------------------
	-- 🔗 AUTO-ENREGISTREMENT DANS LE MENU
	----------------------------------------------------------------------
	table.insert(ACTIONS, { id = "bans", name = "🚫 BANS", color = ACCENT })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "bans" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()


