					text = "⬇️ Charger plus", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					if not getLog or S.loadingLog then return end
					S.loadingLog = true
					mlbl.Text = "⏳ Chargement..."
					task.spawn(function()
						local ok, res = pcall(function() return getLog:InvokeServer(S.cursor, 30) end)
						S.loadingLog = false
						if ok and type(res) == "table" and res.throttled then
							toast("Trop rapide, réessaie dans 1 s", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
							return
						end
						if ok and type(res) == "table" then
							local ids = {}
							for _, e in ipairs(res.entries or {}) do
								table.insert(S.entries, e); table.insert(ids, e.u)
							end
							S.cursor  = res.cursor
							S.hasMore = res.hasMore == true
							resolveUsernames(ids, function()
								resolvePoints(ids, function()
									if holder and holder.Parent then render() end
								end)
							end)
						else
							toast("Chargement impossible", false)
							if mlbl and mlbl.Parent then mlbl.Text = "⬇️ Charger plus" end
						end
					end)
				end)
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text; render()
		end)

		render()
	end

