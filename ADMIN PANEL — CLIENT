		noteCard(body, 6, "Tape directement dans la case pour saisir un nombre, ou utilise − / +. "
			.. "Actuellement : un compte de moins de " .. tostring(cfg.naMinDays) .. " jour(s) est bloqué.", C.TEXT_DIM)

		if cfg.naMode == "ban" then
			sectionLabel(body, 7, "DURÉE DU BAN")
			acTabBar(body, 8, DURATIONS, cfg.naDuration, ACCENT, function(id) set("naDuration", id) end)
			sectionLabel(body, 9, "OU DURÉE PERSONNALISÉE (EN JOURS)")
			stepperRow(body, 10, durToDays(cfg.naDuration), 1, 3650, "jour(s)", function(v)
				set("naDuration", v * 86400)
			end)
		end

		sectionLabel(body, 11, "OPTIONS")
		toggleRow(body, 12, "📵 Bloquer aussi l'appareil (ApplyDeviceBlock)", cfg.naDeviceBlock == true,
			function(v) set("naDeviceBlock", v) end)
		toggleRow(body, 13, "👥 Épargner les comptes alternatifs détectés", cfg.naExcludeAlts == true,
			function(v) set("naExcludeAlts", v) end)
		toggleRow(body, 14, "🎮 Ignorer le filtre dans Studio", cfg.naSkipStudio ~= false,
			function(v) set("naSkipStudio", v) end)

		if cfg.naDeviceBlock and cfg.naMode ~= "ban" then
			noteCard(body, 15, "⚠️ Le blocage d'appareil ne s'applique qu'en mode BAN. En mode KICK il est ignoré.", C.ORANGE)
		elseif cfg.naDeviceBlock then
			noteCard(body, 15, "📵 Blocage d'appareil : 24 h maximum (limite Roblox), PC Windows/macOS uniquement. "
				.. "Le joueur étant forcément connecté quand ce filtre se déclenche, le blocage s'applique bien.",
				DEVICE_COL)
		end

		if S.devOk == false then
			noteCard(body, 16, "🚨 Le moteur de ce serveur a refusé ApplyDeviceBlock : les bans partent sans blocage d'appareil.", C.RED)
		end

		bigBtn(body, 20, S.dirty and "💾 ENREGISTRER LES MODIFICATIONS" or "✅ Réglages à jour",
