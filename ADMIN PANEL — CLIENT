	local function salesList(body, order, res, b, alive)
		sectionLabel(body, order, "📜 VENTES · " .. tostring(b.full) .. " · touche pour le détail")
		local ld = note(body, order + 1, "⏳ Chargement des ventes…")
		local o = { from = b.from, to = b.to, asset = res.asset, hour = b.hr }
		fetch("ugcsales", o, function(sr, err)
			if not alive() then return end
			ld:Destroy()
			if not sr then note(body, order + 1, "❌ " .. tostring(err), C.RED) return end
			if sr.tooLong then
				note(body, order + 1, "Cette barre couvre plus de 7 jours. Passe en « Par jour » ou « Par semaine » "
					.. "(bouton 📅) pour voir chaque vente.", C.TEXT_GREY)
				return
			end
			if #sr.entries == 0 then
				note(body, order + 1, sr.expired and "Détail effacé après 90 jours (les totaux du graphique restent)."
					or "Aucune vente ici.", C.TEXT_DIM)
				return
			end
			local ids = {}
			for _, e in ipairs(sr.entries) do table.insert(ids, e.u) end
			resolveUsernames(ids, function()
				if not alive() then return end
				for i, e in ipairs(sr.entries) do
					local name, img = ugcName(e.a, e.an)
					local tag = TAG[e.c] or TAG.unk
					local right = tag[1]
					if e.c == "buy" then right = right .. pct(e.rb, e.pp) end
					local bad = (e.s == "exploit" or e.s == "external")
					row(body, order + 1 + i, { image = img, title = name,
						sub = "@" .. (unameCache[e.u] or tostring(e.u)) .. " · " .. tostring(e.ds) .. " · "
							.. (SRC[e.s] or tostring(e.s)) .. (e.h and " · 🕰️" or ""),
						subColor = bad and C.RED or nil, right = right, rightColor = tag[2], hover = PINK,
						onClick = function() ugcDetail(e) end })
				end
				if (sr.total or 0) > #sr.entries then
					note(body, order + 900, string.format("… %s ventes au total, les %d plus récentes affichées.",
						sep(sr.total), #sr.entries), C.TEXT_DIM)
				end
			end)
		end, okey("ugcsales", o))
	end

	screenUGC = function(fresh)
		currentScreen = "ugcstats"
		ST.token += 1
		local tok = ST.token
		if fresh then ST.cache = {} end
		local body = buildScreen("🎽 UGC STATS", true, PINK, nil, function() ST.cache = {} ; screenUGC(false) end)
		local function alive() return ST.token == tok and currentScreen == "ugcstats" and body.Parent ~= nil end
		acTabBar(body, 1, UPER, U.p, PINK_D, function(id)
			U.p, U.off, U.g, U.sel, U.keepX = id, 0, nil, nil, nil
			screenUGC(false)
		end)
		local loading = note(body, 2, "⏳ Chargement…")
		local o = { p = U.p, off = U.off, g = U.g, asset = U.asset, cmp = U.cmp }

		fetch("ugcchart", o, function(res, err)
			if not alive() then return end
			loading:Destroy()
			if not res then note(body, 2, "❌ " .. tostring(err), C.RED) return end
			U.off = res.off or U.off
