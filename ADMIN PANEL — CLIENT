		local clearBtn = actionButton(cc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
			text = "✕", textSize = IS_MOBILE and 13 or 16, radius = 9, zIndex = 21 })

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, -8, 0.5, 0)
		gc.Size = UDim2.new(0, giveW, 0, BAR_H - 14)
