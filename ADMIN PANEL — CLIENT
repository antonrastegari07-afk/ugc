	-- ── Fabrique de chips ────────────────────────────────────
	local function chipRow(order)
		local sf = Instance.new("ScrollingFrame")
		sf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 28 or 34)
		sf.BackgroundTransparency = 1
		sf.BorderSizePixel = 0
		sf.ScrollBarThickness = 0
		sf.ScrollingDirection = Enum.ScrollingDirection.X
		sf.CanvasSize = UDim2.new(0, 0, 0, 0)
		sf.AutomaticCanvasSize = Enum.AutomaticSize.X
		sf.LayoutOrder = order; sf.ZIndex = 11; sf.Parent = body
		local l = Instance.new("UIListLayout")
		l.FillDirection = Enum.FillDirection.Horizontal
		l.Padding = UDim.new(0, 5)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = sf
		return sf
	end

	local function mkChip(parent, i, group, id, text, accent)
		local b = Instance.new("TextButton")
		b.AutomaticSize   = Enum.AutomaticSize.X
		b.Size            = UDim2.new(0, 0, 1, 0)
		b.BackgroundColor3 = C.BG_DARK
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Font            = FONT
		b.Text            = text
		b.TextSize        = IS_MOBILE and 10 or 12
		b.TextColor3      = C.TEXT_GREY
		b.LayoutOrder     = i
		b.ZIndex          = 12
		b.Parent          = parent
		corner(b, 7)
		local st = stroke(b, C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 10); p.PaddingRight = UDim.new(0, 10); p.Parent = b
		table.insert(chipRefs, { btn = b, stroke = st, group = group, id = id, accent = accent or C.TURQUOISE })
		b.MouseButton1Click:Connect(function()
			fbState[group] = id
			paintChips(); render()
		end)
	end

	paintChips = function()
		for _, r in ipairs(chipRefs) do
			local sel = (fbState[r.group] == r.id)
			r.btn.BackgroundColor3 = sel and r.accent or C.BG_DARK
			r.btn.TextColor3       = sel and C.TEXT_WHITE or C.TEXT_GREY
			r.stroke.Color         = sel and r.accent or C.BORDER_SUBTLE
