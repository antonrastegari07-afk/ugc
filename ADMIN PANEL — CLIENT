local function idCopyRow(parent, order, userId)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
	row.BackgroundColor3 = C.BG_DARK
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.ZIndex = 12
	row.Parent = parent
	corner(row, 8); stroke(row, C.BORDER_SUBTLE, 1)

	local lblW = IS_MOBILE and 30 or 38
	label(row, {
		text = "🆔", size = UDim2.new(0, lblW, 1, 0), position = UDim2.new(0, 6, 0, 0),
		color = C.TEXT_GREY, textSize = IS_MOBILE and 13 or 16, zIndex = 13,
	})

	local copyW = IS_MOBILE and 60 or 84
	local boxX = 6 + lblW
	local box = Instance.new("TextBox")
	box.Position = UDim2.new(0, boxX, 0, 0)
	box.Size = UDim2.new(1, -boxX - copyW - 10, 1, 0)
	box.BackgroundTransparency = 1
	box.Font = FONT
	box.Text = tostring(userId)
	box.TextColor3 = C.TEXT_WHITE
	box.TextSize = IS_MOBILE and 13 or 16
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false
	box.TextEditable = true          -- nécessaire pour permettre la sélection/copie
	box.ZIndex = 13
	box.Parent = row
	-- si le joueur modifie par accident, on restaure l'ID exact
	box.FocusLost:Connect(function() box.Text = tostring(userId) end)

	local cC = Instance.new("Frame")
	cC.AnchorPoint = Vector2.new(1, 0.5)
	cC.Position = UDim2.new(1, -6, 0.5, 0)
	cC.Size = UDim2.new(0, copyW, 0, IS_MOBILE and 26 or 32)
	cC.BackgroundTransparency = 1
	cC.ZIndex = 13
	cC.Parent = row
	local cb = actionButton(cC, {
		color = C.TURQUOISE_DARK, strokeColor = C.TURQUOISE,
		text = IS_MOBILE and "⧉" or "⧉ Copy", textSize = IS_MOBILE and 13 or 13, radius = 7, zIndex = 13,
	})
	cb.MouseButton1Click:Connect(function()
		box.Text = tostring(userId)
		box:CaptureFocus()
		box.CursorPosition = #box.Text + 1
		box.SelectionStart = 1        -- pré-sélectionne tout l'ID
		toast("ID selected — Ctrl+C (PC) / long-press → Copy (mobile)", true)
	end)
	return row
end

