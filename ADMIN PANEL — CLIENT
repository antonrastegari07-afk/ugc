			if U.selKey ~= selKey then U.selKey, U.sel = selKey, nil end
			local items = res.buckets
			if not U.sel or not items[U.sel] then
				U.sel = #items
				for i = #items, 1, -1 do
					if (items[i].n or 0) > 0 then U.sel = i break end
				end
			end

			navRow(body, 3, res)
			optionsRow(body, 4, res)

			-- ── Résumé de la période affichée ──
			local t = res.tot
			local hero = card(body, 5, IS_MOBILE and 104 or 124)
			line(hero, 8, 16, "UGC SORTIES" .. (res.asset and (" · " .. ugcName(res.asset)) or ""), C.TEXT_GREY, SM)
