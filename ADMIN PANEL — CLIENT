	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, rec in ipairs((S.data and S.data.entries) or {}) do
			local ok = true
			if #q > 0 then
				local un = (unameCache[rec.userId] or ""):lower()
				ok = (tostring(rec.name or ""):lower():find(q, 1, true) ~= nil)
					or (un:find(q, 1, true) ~= nil)
					or (tostring(rec.userId) == q)
					or (tostring(rec.by or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(rec.details or ""):lower():find(q, 1, true) ~= nil)
			end
			if ok then table.insert(out, rec) end
		end
		table.sort(out, function(a, b) return (a.at or 0) > (b.at or 0) end)
		return out
	end

	local function renderList(body)
		local d = S.data
		local entries = d.entries or {}
		local auto, manual, tries, leaks = 0, 0, 0, 0
		for _, r in ipairs(entries) do
			if r.auto then auto = auto + 1 else manual = manual + 1 end
			tries = tries + (r.attempts or 0)
			leaks = leaks + (r.leaks or 0)
		end

		local c = d.config or {}
		local head = string.format(
			"🚫 %d joueur(s) privé(s) d'UGC  ·  🤖 %d auto  ·  👮 %d manuel",
			#entries, auto, manual)
		if tries > 0 then
			head = head .. string.format("\n🔁 %d tentative(s) d'achat bloquée(s) au total", tries)
		end
		if c.shadow then
			head = head .. "\n\n🧪 SHADOW ACTIF — plus aucune privation automatique ne tombera. "
				.. "Les détections continuent d'être enregistrées, mais personne n'est puni."
		elseif c.mode ~= "ugc" then
			head = head .. "\n\n⚠️ Le mode actuel est BAN, pas privation d'UGC. Cette liste "
