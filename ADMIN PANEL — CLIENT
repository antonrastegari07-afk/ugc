	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs((S.data and S.data.entries) or {}) do
			local okF = (S.filter == "all")
				or (S.filter == "admin"    and e.s == "admin")
				or (S.filter == "gift"     and e.s == "gift")
				or (S.filter == "gamepass" and e.s ~= "admin" and e.s ~= "gift")
			local okQ = true
			if #q > 0 then
				local un = (unameCache[e.userId] or ""):lower()
				okQ = (un:find(q, 1, true) ~= nil)
					or (tostring(e.userId) == q)
					or (tostring(e.by or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
			end
			if okF and okQ then table.insert(out, e) end
		end
		return out
	end

