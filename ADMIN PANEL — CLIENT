			screenManage({ userId = uid, displayName = e.n or uname, username = uname,
				sub = meta.l .. " · " .. tostring(e.an) }, backFn)
		end)
	end

	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs(S.entries) do
			local g = ev(e.ev).g
			local okF = (S.filter == "all") or (g == S.filter)
			local okQ = true
			if #q > 0 then
				local un = (unameCache[tonumber(e.u) or 0] or ""):lower()
				okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
					or (un:find(q, 1, true) ~= nil)
					or (tostring(e.an or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.ev or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.u) == q)
			end
			if okF and okQ then table.insert(out, e) end
		end
		table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
		return out
	end

	local function renderLog(body, back)
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 32 or 38)
		sw.BackgroundTransparency = 1 ; sw.LayoutOrder = 1 ; sw.ZIndex = 11 ; sw.Parent = body

		local sb = Instance.new("TextBox")
		sb.Size = UDim2.new(1, 0, 1, 0) ; sb.BackgroundColor3 = C.BG_DARK
		sb.BorderSizePixel = 0 ; sb.Font = FONT
		sb.PlaceholderText = "🔍 Joueur, UserID, UGC ou type d'événement..."
		sb.PlaceholderColor3 = C.TEXT_DIM ; sb.Text = S.search or ""
		sb.TextColor3 = C.TEXT_WHITE ; sb.TextSize = IS_MOBILE and 11 or 14
		sb.TextXAlignment = Enum.TextXAlignment.Left ; sb.ClearTextOnFocus = false
		sb.ZIndex = 12 ; sb.Parent = sw
		corner(sb, 8) ; stroke(sb, C.BORDER_SUBTLE, 1)
		local sp = Instance.new("UIPadding") ; sp.PaddingLeft = UDim.new(0, 10) ; sp.Parent = sb

		acTabBar(body, 2, {
			{ id = "all",   label = "🌐 Tout" },
			{ id = "risk",  label = "🚨 À risque" },
			{ id = "money", label = "💎 Argent" },
			{ id = "flow",  label = "⚙️ Flux" },
		}, S.filter, C.RED, function(id) S.filter = id ; screen(false) end)

		local cf = Instance.new("Frame")
		cf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 16 or 20)
		cf.BackgroundTransparency = 1 ; cf.LayoutOrder = 3 ; cf.ZIndex = 11 ; cf.Parent = body
		local cl = label(cf, { text = "", size = UDim2.fromScale(1, 1),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 10 or 12, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0) ; holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1 ; holder.LayoutOrder = 4 ; holder.ZIndex = 11
		holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder ; hl.Parent = holder

		local render
		render = function()
			for _, ch in ipairs(holder:GetChildren()) do
				if not ch:IsA("UIListLayout") then ch:Destroy() end
			end
			local list = visible()
			local risk = 0
			for _, e in ipairs(S.entries) do if ev(e.ev).g == "risk" then risk = risk + 1 end end
			cl.Text = string.format("%d affiché(s)  •  %d chargé(s)  •  %d à risque",
				#list, #S.entries, risk)

			if #list == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 60) ; f.BackgroundTransparency = 1
				f.LayoutOrder = 1 ; f.ZIndex = 11 ; f.Parent = holder
				label(f, { text = "Rien ne correspond à ces filtres.", size = UDim2.fromScale(1, 1),
					color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			else
				for i, e in ipairs(list) do logCard(holder, i, e, back) end
			end

			if S.hasMore then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1 ; mc.LayoutOrder = 99999
				mc.ZIndex = 11 ; mc.Parent = holder
				local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger plus", textSize = IS_MOBILE and 12 or 14, radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					local ok, res = pcall(function() return getLog:InvokeServer(S.cursor, 30) end)
					if ok and type(res) == "table" then
						local ids = {}
						for _, e in ipairs(res.entries or {}) do
							table.insert(S.entries, e) ; table.insert(ids, e.u)
						end
						S.cursor, S.hasMore = res.cursor, res.hasMore == true
						resolveUsernames(ids, function() resolvePoints(ids, function() render() end) end)
					else render() end
				end)
			end
		end

		sb:GetPropertyChangedSignal("Text"):Connect(function()
			S.search = sb.Text ; render()
		end)

		render()
	end

