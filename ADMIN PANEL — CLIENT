	-- Vignette carrée d'un objet : image si on l'a, sinon l'emoji du type.
	local function itemThumb(parent, e, size, z)
		local km = kMeta(ek(e))
		local img = itemImage(e)
		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(0, size, 0, size)
		holder.BackgroundColor3 = C.BG_ITEM
		holder.BackgroundTransparency = 0.45
		holder.BorderSizePixel = 0
		holder.ZIndex = z
		holder.Parent = parent
		corner(holder, math.floor(size * 0.22))
		stroke(holder, km.c, 1, 0.45)
		if img then
			local im = Instance.new("ImageLabel")
			im.Size = UDim2.new(1, -4, 1, -4)
			im.Position = UDim2.fromScale(0.5, 0.5)
			im.AnchorPoint = Vector2.new(0.5, 0.5)
			im.BackgroundTransparency = 1
			im.Image = img
			im.ScaleType = Enum.ScaleType.Fit
			im.ZIndex = z + 1
			im.Parent = holder
		else
			label(holder, { text = km.e, size = UDim2.fromScale(1, 1),
				color = km.c, textSize = math.floor(size * 0.55), zIndex = z + 1 })
		end
		return holder
	end

	----------------------------------------------------------------------
	--  Carte d'un gift — lecture immédiate, de gauche à droite :
	--
	--     ┌──────────────────────────────────────────────┐
	--     │  [pfp] Donneur   [🔫] ──▶   Receveur [pfp]   │
	--     │        @pseudo    GUN        @pseudo          │
	--     │  🔫 AK47 · ✅ Livré · il y a 3 h              │
	--     │  💬 « message » · 🆔 111 ➜ 222                │
	--     └──────────────────────────────────────────────┘
	--
	--  Moitié gauche → profil du donneur.  Moitié droite → profil du receveur.
	--  Le centre dit CE QUI a été offert : icône du produit + étiquette du
	--  type. Un gift de points garde son montant, les autres montrent leur
	--  objet — c'est tout ce qui change par rapport à avant.
	----------------------------------------------------------------------
	local function giftCard(parent, order, e, backFn)
		local su, ru = tonumber(e.su) or 0, tonumber(e.ru) or 0
		local sn = unameCache[su] or e.sn or tostring(su)
		local rn = unameCache[ru] or e.rn or tostring(ru)
		local meta = stMeta(e.st)
		local km   = kMeta(ek(e))
		local lbl  = itemLabel(e)
		local isPoints = (ek(e) == "points")

		local H    = (IS_MOBILE and 112 or 132) + economy.FOOTER_H
		local botH = IS_MOBILE and 32 or 38
		local topH = H - botH
		local avS  = IS_MOBILE and 34 or 44

		local box = Instance.new("Frame")
		box.Size = UDim2.new(1, 0, 0, H)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.LayoutOrder = order
		box.ZIndex = 11
		box.Parent = parent
		corner(box, 10)
		stroke(box, e.self and C.ORANGE or km.c, 1)

		-- ── Zone d'un joueur (gauche ou droite), cliquable ──
		local function side(isLeft, uid, disp, uname, ringCol, sub)
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(0.36, 0, 0, topH)
			btn.Position = UDim2.new(isLeft and 0 or 0.64, 0, 0, 0)
			btn.BackgroundColor3 = C.BG_ITEM
			btn.BackgroundTransparency = 0.82      -- affordance permanente
			btn.AutoButtonColor = false
			btn.BorderSizePixel = 0
			btn.Text = ""
			btn.ZIndex = 12
			btn.Parent = box
			btn:SetAttribute("AdminEconomyReservedHeight", economy.FOOTER_H)
			corner(btn, 8)
			local bs = stroke(btn, ringCol, 1, 1)   -- contour invisible au repos

			local av = makeAvatar(btn, uid, avS, ringCol)
			av.AnchorPoint = Vector2.new(isLeft and 0 or 1, 0.5)
			av.Position = UDim2.new(isLeft and 0 or 1, isLeft and 8 or -8, 0.5, 0)

			local tx = avS + 14
			local align = isLeft and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right

			local nameLbl = label(btn, {
				text = esc(disp),
				size = UDim2.new(1, -tx - 6, 0, IS_MOBILE and 16 or 20),
				position = UDim2.new(0, isLeft and tx or 6, 0, IS_MOBILE and 10 or 14),
				xAlign = align, color = C.TEXT_WHITE,
				textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13,
			})
			label(btn, {
				text = "@" .. uname,
				size = UDim2.new(1, -tx - 6, 0, IS_MOBILE and 14 or 17),
				position = UDim2.new(0, isLeft and tx or 6, 0, IS_MOBILE and 27 or 35),
				xAlign = align, color = C.TEXT_GREY,
				textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 13,
			})

			local hint = label(btn, {
				text = isLeft and "👤 voir le profil" or "voir le profil 👤",
				size = UDim2.new(1, -tx - 6, 0, IS_MOBILE and 12 or 14),
				position = UDim2.new(0, isLeft and tx or 6, 0, IS_MOBILE and 43 or 54),
				xAlign = align, color = ringCol,
				textSize = IS_MOBILE and 8 or 10, truncate = true, zIndex = 13,
			})
			hint.TextTransparency = 0.55

			btn.MouseEnter:Connect(function()
				btn.BackgroundTransparency = 0.4
				bs.Transparency = 0
				hint.TextTransparency = 0
				nameLbl.TextColor3 = ringCol
			end)
			btn.MouseLeave:Connect(function()
				btn.BackgroundTransparency = 0.82
				bs.Transparency = 1
				hint.TextTransparency = 0.55
				nameLbl.TextColor3 = C.TEXT_WHITE
			end)
			btn.MouseButton1Click:Connect(function()
				screenManage({ userId = uid, displayName = disp, username = uname, sub = sub }, backFn)
			end)
			return btn
		end

		side(true,  su, e.sd or sn, sn, GIFT,
			"🎁 A offert " .. lbl .. " à " .. rn)
		side(false, ru, e.rd or rn, rn, RECV,
			"📥 A reçu " .. lbl .. " de " .. sn)

		-- ── Milieu : CE QUI a été offert, puis la flèche ──
		local mid = Instance.new("Frame")
		mid.Size = UDim2.new(0.28, 0, 0, topH)
		mid.Position = UDim2.new(0.36, 0, 0, 0)
		mid.BackgroundTransparency = 1
		mid.ZIndex = 12
		mid.Parent = box

		local thumbS = IS_MOBILE and 26 or 32
		local th = itemThumb(mid, e, thumbS, 13)
		th.AnchorPoint = Vector2.new(0.5, 0)
		th.Position = UDim2.new(0.5, 0, 0, IS_MOBILE and 5 or 7)

		-- Sous la vignette : le montant pour les points, l'étiquette du type
		-- pour tout le reste. Deux gifts de types différents ne peuvent donc
		-- jamais être confondus au premier coup d'œil.
		label(mid, {
			text = isPoints and ("💎 " .. fmtNum(e.p or 0)) or km.tag,
			size = UDim2.new(1, -4, 0, IS_MOBILE and 16 or 19),
			position = UDim2.new(0.5, 0, 0, IS_MOBILE and 34 or 42),
			anchor = Vector2.new(0.5, 0),
			color = isPoints and GOLD or km.c,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13,
		})

		-- La flèche : un trait + une pointe
		local lineY = IS_MOBILE and 0.82 or 0.80
		local line = Instance.new("Frame")
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Position = UDim2.new(0.5, -3, lineY, 0)
		line.Size = UDim2.new(1, -22, 0, 2)
		line.BackgroundColor3 = e.self and C.ORANGE or km.c
		line.BorderSizePixel = 0
		line.ZIndex = 13
		line.Parent = mid

		label(mid, {
			text = "▶",
			size = UDim2.new(0, 14, 0, 14),
			position = UDim2.new(1, -5, lineY, 0), anchor = Vector2.new(1, 0.5),
			color = e.self and C.ORANGE or km.c,
			textSize = IS_MOBILE and 11 or 13, zIndex = 13,
		})

		-- ── Bas : le nom exact de l'objet, le statut, puis le message ──
		local bot = Instance.new("Frame")
		bot.Size = UDim2.new(1, -16, 0, botH)
		bot.Position = UDim2.new(0, 8, 0, topH)
		bot.BackgroundTransparency = 1
		bot.ZIndex = 12
		bot.Parent = box

		local l1 = km.e .. " " .. lbl .. "  ·  " .. meta.l .. "  ·  " .. fmtWhen(e)
		if e.g    then l1 = l1 .. "  ·  🌍 annoncé" end
		if e.self then l1 = l1 .. "  ·  🪞 auto-gift" end
		if e.lg   then l1 = l1 .. "  ·  📦 importé" end
		-- 🧾 Une livraison différée écrit une SECONDE ligne, sans recompter le
		--    gift. Sans ce repère, on croirait qu'un joueur a reçu deux fois
		--    la même arme alors qu'il s'agit de l'achat puis de sa remise.
		if e.nc   then l1 = l1 .. "  ·  🧾 confirmation" end

		label(bot, {
			text = l1,
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, 0, 0, 0),
			xAlign = Enum.TextXAlignment.Left, color = km.c,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13,
		})

		local mt = msgText(e)
		local l2 = mt and ("💬 « " .. mt .. " »") or ""
		if e.pr and e.pr ~= 0 then
			l2 = (l2 ~= "" and (l2 .. "  ·  ") or "") .. "produit " .. tostring(e.pr)
		end
		l2 = (l2 ~= "" and (l2 .. "  ·  ") or "") .. "🆔 " .. tostring(su) .. " ➜ " .. tostring(ru)
		if e.sv and e.sv ~= "" then l2 = l2 .. "  ·  🖥️ " .. tostring(e.sv):sub(1, 6) end

		label(bot, {
			text = l2,
			size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, 0, 0, IS_MOBILE and 15 or 18),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM,
			textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13,
		})

		return box
	end

	local function visible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs(S.entries) do
			local grp = stMeta(e.st).g

			local okF
			if S.filter == "all" then okF = true
			elseif S.filter == "_self" then okF = (e.self == true)
			elseif S.filter == "_legacy" then okF = (e.lg == true)
			elseif S.filter == "_global" then okF = (e.g == true)
			elseif S.filter == "_claim"  then okF = (e.nc == true)
			elseif S.filter == "_real"   then okF = (e.nc ~= true)
			else okF = (grp == S.filter) end

			-- Filtre par type. « boost » regroupe temporaire ET permanent :
			-- quand on cherche un abus de multiplicateur, on veut les deux.
			local okK
			if S.kind == "all" then okK = true
			elseif S.kind == "boost" then okK = (ek(e) == "boost_temp" or ek(e) == "boost_perm")
			else okK = (ek(e) == S.kind) end

			local okQ = true
			if #q > 0 then
				local sn = (unameCache[tonumber(e.su) or 0] or ""):lower()
				local rn = (unameCache[tonumber(e.ru) or 0] or ""):lower()
				okQ = (tostring(e.sn or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.rn or ""):lower():find(q, 1, true) ~= nil)
					or (sn:find(q, 1, true) ~= nil)
					or (rn:find(q, 1, true) ~= nil)
					or (tostring(e.su) == q) or (tostring(e.ru) == q)
					or (tostring(e.lb or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(msgText(e) or ""):lower():find(q, 1, true) ~= nil)
			end

			if okF and okK and okQ then table.insert(out, e) end
		end
		table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
		return out
	end

	----------------------------------------------------------------------
	-- 🏆 ONGLET TOP
	----------------------------------------------------------------------
	local function renderTop(body)
		acTabBar(body, 1, TOPS, S.topMetric, GOLD, function(id)
			S.topMetric = id; S.top = nil; screen(false)
		end)

		local meta
		for _, t in ipairs(TOPS) do if t.id == S.topMetric then meta = t end end

		noteCard(body, 2, "Les deux classements « 💎 Pts » ne comptent QUE les gifts de "
			.. "points — c'est ce que tu voulais garder tel quel.\n\n"
			.. "Les deux classements « nombre » comptent TOUS les types : un VIP, une "
			.. "arme ou un boost valent chacun 1 gift. Un joueur peut donc être premier "
			.. "en nombre sans apparaître en points.", C.TEXT_DIM)

		local st = Instance.new("Frame")
		st.Size = UDim2.new(1, 0, 0, 44); st.BackgroundTransparency = 1
		st.LayoutOrder = 3; st.ZIndex = 11; st.Parent = body
		local stl = label(st, { text = "Chargement du classement...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		if not getTop then stl.Text = "❌ GiftLog_Server.lua pas installé."; return end

		local function paint(entries)
			if not st.Parent then return end
			st:Destroy()
			if #entries == 0 then
				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 50); f.BackgroundTransparency = 1
				f.LayoutOrder = 4; f.ZIndex = 11; f.Parent = body
				label(f, { text = "Aucun gift enregistré pour l'instant.", size = UDim2.fromScale(1, 1),
					color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
				return
			end
			for i, e in ipairs(entries) do
				acRow(body, 10 + i, i, e.userId, e.value, false, meta.col, function() screen(false) end)
			end

			local note = Instance.new("Frame")
			note.Size = UDim2.new(1, 0, 0, 22); note.BackgroundTransparency = 1
			note.LayoutOrder = 9999; note.ZIndex = 11; note.Parent = body
			label(note, {
				text = "Valeur = " .. meta.note .. " — cumul de toute l'histoire du jeu",
				size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
				color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 11 })

			-- 📦 Maintenance : ré-import de l'historique
			if doAct then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 10000; mc.ZIndex = 11; mc.Parent = body
				local mb, mlbl = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "📦 Ré-importer l'historique des gifts",
					textSize = IS_MOBILE and 11 or 13, radius = 9, zIndex = 11 })
				local armed = false
				mb.MouseButton1Click:Connect(function()
					if not armed then
						armed = true
						mlbl.Text = "⚠️ Appuie encore pour confirmer"
						task.delay(3, function()
							if mlbl and mlbl.Parent then
								armed = false
								mlbl.Text = "📦 Ré-importer l'historique des gifts"
							end
						end)
						return
					end
					armed = false
					mlbl.Text = "⏳ Import en cours (1 à 2 min)…"
					toast("Import lancé, ça peut prendre 1 à 2 minutes…", true)
					task.spawn(function()
						local ok, res = pcall(function()
							return doAct:InvokeServer("importlegacy", {})
						end)
						if ok and type(res) == "table" then
							toast(res.msg or (res.ok and "Import terminé" or "Échec"), res.ok == true)
						else
							toast("Erreur de communication", false)
						end
						S.entries, S.cursor, S.hasMore = {}, nil, false
						S.loaded, S.top = false, nil
						screen(false)
					end)
				end)
			end
		end

		if S.top then
			local ids = {}
			for _, e in ipairs(S.top) do table.insert(ids, e.userId) end
			resolveUsernames(ids, function() resolvePoints(ids, function() paint(S.top) end) end)
		elseif not S.topLoading then
			S.topLoading = true
			task.spawn(function()
				local ok, res = pcall(function() return getTop:InvokeServer(S.topMetric, 50) end)
				S.topLoading = false
				if not st.Parent then return end
				if not ok or type(res) ~= "table" then stl.Text = "Impossible de charger (🔄)."; return end
				S.top = res.entries or {}
				local ids = {}
				for _, e in ipairs(S.top) do table.insert(ids, e.userId) end
				resolveUsernames(ids, function() resolvePoints(ids, function() paint(S.top) end) end)
			end)
		end
	end

	----------------------------------------------------------------------
	-- 📜 ONGLET JOURNAL
