-- 📜 BLOC 11 — CONSERVER LA POSITION DE DÉFILEMENT
--
--  Le problème : chaque réglage appelle screen(false) → buildScreen →
--  clearWindow(), qui DÉTRUIT la ScrollingFrame. La nouvelle naît à
--  CanvasPosition = 0, donc tu remontes en haut. Et le bouton
--  « appuie encore pour confirmer » repart hors écran, d'où le
--  double appui à deux endroits différents.
--
--  Ici on mémorise la position AVANT la destruction, et on la restaure
--  sur la nouvelle frame — uniquement si c'est le MÊME écran (même titre),
--  pour qu'une vraie navigation reparte bien du haut.
--
--  ⚠️ Doit être le DERNIER bloc : il enveloppe la version de buildScreen
--     déjà enveloppée par le bloc 2-bis (bandeau du gift log).
--════════════════════════════════════════════════════════════════════════════
;(function()
	local previousBuildScreen = buildScreen
	local lastTitle, lastY = nil, 0

	buildScreen = function(titleText, ...)
		-- 1. On lit la position AVANT que clearWindow ne détruise la frame.
		local old = window:FindFirstChildOfClass("ScrollingFrame")
		if old then lastY = old.CanvasPosition.Y end

		local sameScreen = (titleText == lastTitle)
		local target     = lastY

		-- table.pack : buildScreen peut renvoyer plusieurs valeurs selon les
		-- enveloppes déjà posées. On ne doit rien perdre au passage.
		local r = table.pack(previousBuildScreen(titleText, ...))
		lastTitle = titleText

		local body = r[1]
		if sameScreen and target > 1 and typeof(body) == "Instance"
			and body:IsA("ScrollingFrame") then
			-- 2. Le contenu est ajouté APRÈS ce retour, et AutomaticCanvasSize
			--    ne connaît la hauteur qu'une fois les enfants posés. On
			--    réapplique donc pendant quelques frames, en s'arrêtant dès
			--    que le joueur touche lui-même au défilement.
			task.spawn(function()
				local applied = -1
				local t = 0
				while t < 0.5 do
					if not body.Parent then return end
					-- Le joueur a fait défiler : on lâche immédiatement.
					if applied >= 0 and math.abs(body.CanvasPosition.Y - applied) > 2 then
						return
					end
					local maxY = math.max(0,
						body.AbsoluteCanvasSize.Y - body.AbsoluteWindowSize.Y)
					if maxY > 0 then
						local y = math.min(target, maxY)
						body.CanvasPosition = Vector2.new(0, y)
						applied = y
					end
					t = t + task.wait()
				end
			end)
		end

		return table.unpack(r, 1, r.n)
	end
end)()

