local function makeAvatar(parent, userId, size, ringColor)
	local av = Instance.new("ImageLabel")
	av.Size = UDim2.new(0, size, 0, size)
	av.BackgroundColor3 = C.BG_LIGHT
	av.BorderSizePixel = 0
	av.ZIndex = (parent.ZIndex or 1) + 1
	av.Parent = parent
	corner(av, size / 2)
	if ringColor then stroke(av, ringColor, 2) end
	loadAvatar(av, userId)
	return av
end

