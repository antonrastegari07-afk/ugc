		local p = (cur - prev) / prev * 100
		if math.abs(p) < 0.5 then return "= pareil que", C.TEXT_GREY end
		return string.format("%s %.0f %% vs", p > 0 and "▲" or "▼", math.abs(p)), p > 0 and GREEN or C.RED
