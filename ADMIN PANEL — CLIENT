	local function fmtDur(sec)
		sec = tonumber(sec)
		if sec == nil then return "?" end
		if sec == -1 then return "♾️ permanent" end
		if sec <= 0 then return "—" end
		if sec >= 86400 then return string.format("%.0f j", sec / 86400) end
		if sec >= 3600  then return string.format("%.0f h", sec / 3600) end
		return string.format("%.0f min", sec / 60)
	end

	local function durToDays(sec)
		sec = tonumber(sec)
		if not sec or sec == -1 then return 7 end
		return math.max(1, math.floor(sec / 86400 + 0.5))
	end

	local function fmtUntil(ts)
		ts = tonumber(ts)
		if not ts or ts == 0 then return "♾️ jamais" end
		local left = ts - os.time()
		if left <= 0 then return "expiré" end
		return "dans " .. fmtDur(left)
	end

	-- Date d'un événement du journal (gère les fiches importées sans date)
	local function fmtWhen(e)
		if e.unk or not e.t or e.t == 0 then return "📅 date inconnue" end
		return fmtAgo(e.t)
	end

