			size = UDim2.new(0, valW, 1, 0),
			position = UDim2.new(1, -8, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right, color = GOLD, textSize = IS_MOBILE and 12 or 16, zIndex = 12, truncate = true,
