local GREEN_HEX = "#FFD746"  -- ≈ C.GREEN, pour le RichText

local function fmtPts(n)
	n = tonumber(n)
	if not n then return nil end
	if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
	if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
	if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end

-- Points d'un joueur EN LIGNE (via l'attribut "Points" répliqué, sinon leaderstats)
local function livePoints(userId)
	local p = Players:GetPlayerByUserId(userId)
	if not p then return nil end
	local a = p:GetAttribute("Points")
	if type(a) == "number" then return a end
	local ls = p:FindFirstChild("leaderstats")
	local pts = ls and ls:FindFirstChild("Points")
	if pts then return pts.Value end
	return nil
end

-- échappe le texte pour le RichText (noms avec & < >)
local function esc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- construit "  💎X" en vert (RichText) si des points sont connus, sinon ""
local PTS_SIZE = IS_MOBILE and 11 or 13  -- un peu plus gros, mais < taille du nom
local function ptsSuffix(pointsValue)
	if pointsValue == nil then return "" end
	local f = fmtPts(pointsValue)
	if not f then return "" end
	return "  <font color=\"" .. GREEN_HEX .. "\" size=\"" .. PTS_SIZE .. "\">" .. f .. " pts</font>"
end

-- Caches HORS LIGNE (remplis par resolvePoints, à la demande)
local pointsCache = {}  -- [userId] = number
local banCache = {}     -- [userId] = bool
local RED_HEX = "#E14550"  -- ≈ C.RED, pour le 🚫

-- Points d'un joueur : en ligne (attribut, gratuit) sinon cache hors ligne
local function pointsFor(userId)
	local lp = livePoints(userId)
	if lp ~= nil then return lp end
	local c = pointsCache[userId]
	if type(c) == "number" then return c end
	return nil
end
-- Un joueur EN LIGNE n'est jamais banni (il joue) ; sinon on lit le cache
local function bannedFor(userId)
	if Players:GetPlayerByUserId(userId) then return false end
	return banCache[userId] == true
end
-- Va chercher (batch + cache) points + ban des joueurs HORS LIGNE d'une liste, puis cb()
-- ⚡ Anti-doublon : si ces joueurs sont déjà en cours de lecture, on attend cette
--    lecture au lieu d'en relancer une (avant : 2e requête → réponse vide).
local function resolvePoints(userIds, cb)
	if not getPointsFn then cb(); return end
	local flight = economy.ptsFlight
	if not flight then flight = {}; economy.ptsFlight = flight end
	local need, waitOthers = {}, false
	for _, id in ipairs(userIds) do
		if livePoints(id) == nil and pointsCache[id] == nil then
			if flight[id] then
				waitOthers = true
			else
				flight[id] = true
				table.insert(need, id)
			end
		end
	end
	if #need == 0 and not waitOthers then cb(); return end
	task.spawn(function()
		for start = 1, #need, 60 do
			local chunk = table.move(need, start, math.min(start + 59, #need), 1, {})
			local ok, res = pcall(function() return getPointsFn:InvokeServer(chunk) end)
			if ok and type(res) == "table" then
				for k, v in pairs(res) do
					local id = tonumber(k)
					if id and type(v) == "table" then
						if type(v.points) == "number" then pointsCache[id] = v.points end
						banCache[id] = v.banned == true
					end
				end
			end
			for _, id in ipairs(chunk) do flight[id] = nil end
		end
		if waitOthers then
			local t0 = os.clock()
			local busy = true
			while busy and os.clock() - t0 < 12 do
				busy = false
				for _, id in ipairs(userIds) do
					if flight[id] then busy = true; break end
				end
				if busy then task.wait(0.1) end
			end
		end
		cb()
	end)
end
-- suffixe complet d'une entrée : 💎points (vert) + 🚫 (rouge) si banni
local function ptsSuffixLive(userId)
	-- The shared avatar footer displays both currencies; keep only the ban badge here.
	if bannedFor(userId) then
		return "  <font color=\"" .. RED_HEX .. "\" size=\"" .. PTS_SIZE .. "\">🚫</font>"
	end
	return ""
end

