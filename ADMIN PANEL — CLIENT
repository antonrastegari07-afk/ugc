		--  arrivé entre-temps — un autre admin a coupé — présentait le bouton
		--  vert « RÉACTIVER » exactement là où le doigt allait retomber : le
		--  second appui rouvrait les cadeaux en plein incident.
		armed = false, armedFor = nil, armedAt = 0,
		busy = false, result = nil, resultColor = nil,
		reason = "",
	}
	local ARM_WINDOW = 6

	----------------------------------------------------------------------
