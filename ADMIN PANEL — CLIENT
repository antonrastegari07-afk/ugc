			onClick = function() onSet(not on) end,
		})
		helpUnder(parent, order + 1, help)
		return order + 2
	end

	local function textRow(parent, order, title, value, maxLen, onSet, help, placeholder)
		local h = IS_MOBILE and 38 or 44
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, h)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent

		local labW = IS_MOBILE and 0.34 or 0.30
		lbl(f, { text = title, color = C.TEXT_WHITE, size = IS_MOBILE and 12 or 14,
			truncate = true, frame = UDim2.new(labW, -6, 1, 0), pos = UDim2.new(0, 2, 0, 0) })

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1 - labW, 0, 1, 0)
		box.Position = UDim2.new(labW, 0, 0, 0)
		box.BackgroundColor3 = C.BG_ITEM
		box.BackgroundTransparency = 0.15
		box.BorderSizePixel = 0
		box.Font = FONT
		box.Text = tostring(value or "")
		box.PlaceholderText = placeholder or ""
		box.PlaceholderColor3 = C.TEXT_DIM
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 12 or 14
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.TextTruncate = Enum.TextTruncate.AtEnd
		box.ClipsDescendants = true
		box.ClearTextOnFocus = false
		box.ZIndex = 12 ; box.Parent = f
		corner(box, 8) ; stroke(box, C.BORDER_SUBTLE, 1)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, 9) ; p.PaddingRight = UDim.new(0, 9)
		p.Parent = box

		--  ✂️ On coupe en CARACTÈRES, jamais en octets : couper au milieu d'un
		--     emoji fabrique une demi-lettre, et c'est exactement ce qui
		--     faisait échouer la sauvegarde entière côté DataStore.
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local t = box.Text
			local n = utf8.len(t)
			if n and maxLen and n > maxLen then
				local off = utf8.offset(t, maxLen + 1)
				t = t:sub(1, (off or 1) - 1)
				box.Text = t
			end
			onSet(t)
		end)
		helpUnder(parent, order + 1, help)
		return order + 2
	end

	--  🎨 Une couleur sans roue chromatique : 12 pastilles + AUTO. Une roue
	--     RGB c'est trois curseurs et une décision de graphiste ; douze
	--     pastilles c'est un clic.
	local PALETTE = {
		{ "Auto",    0, 0, 0 },
		{ "Pink",  255, 110, 190 }, { "Red",    255, 90, 100 },
		{ "Orange",255, 165,  70 }, { "Gold",   255, 205,  70 },
		{ "Lime",  170, 255, 110 }, { "Green",   90, 220, 140 },
		{ "Teal",  110, 240, 220 }, { "Cyan",   110, 210, 255 },
		{ "Blue",  120, 150, 255 }, { "Violet", 180, 130, 255 },
		{ "White", 245, 245, 255 },
	}

	local function colorRow(parent, order, title, value, onSet, help)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, IS_MOBILE and 24 or 28)
		f.BackgroundTransparency = 1
		f.LayoutOrder = order ; f.ZIndex = 11 ; f.Parent = parent
		lbl(f, { text = title, color = C.TEXT_WHITE, size = IS_MOBILE and 12 or 14 })

		local g = Instance.new("Frame")
		g.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
		g.BackgroundTransparency = 1
		g.LayoutOrder = order + 1 ; g.ZIndex = 11 ; g.Parent = parent
		local lay = Instance.new("UIListLayout")
		lay.FillDirection = Enum.FillDirection.Horizontal
		lay.Padding = UDim.new(0, 4)
		lay.SortOrder = Enum.SortOrder.LayoutOrder
		lay.Parent = g

		local cur = value or { 0, 0, 0 }
		for i, p in ipairs(PALETTE) do
			local cc = Instance.new("TextButton")
			cc.Size = UDim2.new(1 / #PALETTE, -4, 1, 0)
			cc.BackgroundColor3 = (i == 1) and C.BG_LIGHT or Color3.fromRGB(p[2], p[3], p[4])
			cc.AutoButtonColor = false
			cc.Text = (i == 1) and "A" or ""
			cc.Font = FONT
			cc.TextSize = IS_MOBILE and 10 or 12
			cc.TextColor3 = C.TEXT_GREY
			cc.BorderSizePixel = 0
			cc.LayoutOrder = i ; cc.ZIndex = 12 ; cc.Parent = g
			corner(cc, 6)
			local same = (cur[1] == p[2] and cur[2] == p[3] and cur[3] == p[4])
			stroke(cc, same and C.TEXT_WHITE or C.BORDER_SUBTLE, same and 2.2 or 1)
			cc.MouseButton1Click:Connect(function() onSet({ p[2], p[3], p[4] }) end)
		end
		helpUnder(parent, order + 2, help)
		return order + 3
	end

	------------------------------------------------------------------
	-- 📚 LES DONNÉES
	------------------------------------------------------------------
	local function allEvents()
		local out = {}
		if CFG then
			for _, id in ipairs(CFG.BUILTIN_ORDER) do
				local w = CFG.Builtin(id)
				if w then out[#out + 1] = w end
			end
		end
		for _, w in pairs(S.custom or {}) do out[#out + 1] = w end
		return out
	end

	local function findEvent(id)
		for _, w in ipairs(allEvents()) do
			if w.id == id then return w end
		end
		return nil
	end

	--  Les listes lues EN DIRECT dans tes dossiers : tu glisses un objet dans
	--  ReplicatedStorage et il apparaît ici, sans rien redémarrer.
	local function folderChoices(folderName, className, emptyLabel, emptyDesc, itemDesc)
		local out = { { id = "", label = emptyLabel, desc = emptyDesc } }
		local folder = folderName and RSX:FindFirstChild(folderName)
		if folder then
			local names = {}
			for _, c in ipairs(folder:GetChildren()) do
				if c:IsA(className) then names[#names + 1] = c.Name end
			end
			table.sort(names)
			for _, n in ipairs(names) do
				out[#out + 1] = { id = n, label = n, desc = itemDesc }
			end
		end
		return out
	end

	local function skyChoices()
		return folderChoices(CFG and CFG.SKY_FOLDER, "Sky",
			"Keep the current sky",
			"Only the light changes. Safe, and the fastest to load.",
			"From your sky folder.")
	end

	local function musicChoices()
		return folderChoices(CFG and CFG.MUSIC_FOLDER, "Sound",
			"No music",
			"The player's normal playlist keeps going, untouched.",
			"From your Party music folder.")
	end

	local function toolChoices()
		local out = { { id = "", label = "No item", desc = "Players get nothing to hold." } }
		for _, n in ipairs(S.tools or {}) do
			out[#out + 1] = { id = n, label = n,
				desc = "Lent for the step, then taken back automatically." }
		end
		return out
	end

	local function labelOf(list, id, fallback)
		for _, o in ipairs(list) do
			if o.id == id then return o.label end
		end
		return fallback or tostring(id)
	end

	local function stepsTotal()
		local t = 0
		for _, w in ipairs(S.steps) do t = t + (tonumber(w.duration) or 0) end
		return t
	end

	------------------------------------------------------------------
	-- 📋 ÉCRAN « CHOISIR DANS UNE LISTE »
	--
	--  🐛 LE BUG QUE TU AS TROUVÉ ÉTAIT ICI.
	--
	--     Avant, en refermant la liste je faisais `S.view = nil`. Or
	--     l'éditeur d'événement VIT dans `S.view = "edit"` : le vider
	--     revenait à fermer l'éditeur. Chaque choix te ramenait donc à la
	--     liste des événements, et modifier quoi que ce soit devenait
	--     impossible.
	--
	--     La liste mémorise maintenant l'écran appelant et y revient. Un
	--     seul champ (`back`) règle le problème pour TOUS les écrans : celui
	--     de l'éditeur, du planning et des cadeaux — pas de cas particulier
	--     à écrire, donc pas de cas particulier à oublier.
	------------------------------------------------------------------
	local function openPick(title, options, current, onPick, intro)
		S.pick = { title = title, options = options, current = current,
			onPick = onPick, intro = intro, back = S.view }
		S.view = "pick"
		screen(false)
	end

	local function closePick()
		local back = S.pick and S.pick.back or nil
		S.pick = nil
		S.view = back          -- ⬅️ on RETOURNE d'où on vient
		screen(false)
	end

	local function renderPick(body)
		local p = S.pick
		if not p then S.view = nil ; screen(false) return end

		big(body, -1, "\u{2039}  BACK", C.BG_LIGHT, C.BORDER_BRIGHT, closePick,
			IS_MOBILE and 36 or 40)
		head(body, 0, p.title)
		if p.intro then note(body, 1, p.intro, C.TEXT_GREY) end

