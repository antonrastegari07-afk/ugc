local function corner(inst, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = inst; return c
end
local function stroke(inst, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col or C.BORDER_SUBTLE; s.Thickness = th or 1; s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = inst; return s
end
local function gradient(inst, c1, c2, rot)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2) })
	g.Rotation = rot or 90; g.Parent = inst; return g
end
local function padding(inst, all)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, all); p.PaddingBottom = UDim.new(0, all)
	p.PaddingLeft = UDim.new(0, all); p.PaddingRight = UDim.new(0, all)
	p.Parent = inst; return p
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = FONT
	l.TextColor3 = props.color or C.TEXT_WHITE
	l.TextXAlignment = props.xAlign or Enum.TextXAlignment.Center
	l.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
	l.Text = props.text or ""
	l.TextWrapped = props.wrapped or false
	l.RichText = props.richText or false
	if props.truncate then l.TextTruncate = Enum.TextTruncate.AtEnd end
	if props.textSize then l.TextSize = props.textSize else l.TextScaled = true end
	if props.size then l.Size = props.size end
	if props.position then l.Position = props.position end
	if props.anchor then l.AnchorPoint = props.anchor end
	if props.zIndex then l.ZIndex = props.zIndex end
	l.Parent = parent
	return l
end

-- Bouton d'action coloré (avec petit effet de scale)
local function actionButton(parent, props)
	local color = props.color or C.GREEN
	local strokeCol = props.strokeColor or C.BORDER_BRIGHT
	local btn = Instance.new("TextButton")
	btn.Size = props.size or UDim2.fromScale(1, 1)
	btn.Position = props.position or UDim2.fromScale(0.5, 0.5)
	btn.AnchorPoint = props.anchor or Vector2.new(0.5, 0.5)
	btn.BackgroundColor3 = color
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.ZIndex = props.zIndex or 5
	btn.Parent = parent
	corner(btn, props.radius or 9)
	stroke(btn, strokeCol, 1.5)
	local sc = Instance.new("UIScale"); sc.Parent = btn
	local function tw(s, d) TweenService:Create(sc, TweenInfo.new(d or 0.13, Enum.EasingStyle.Quad), { Scale = s }):Play() end
	btn.MouseEnter:Connect(function() tw(1.04) end)
	btn.MouseLeave:Connect(function() tw(1) end)
	btn.MouseButton1Down:Connect(function() tw(0.96, 0.07) end)
	btn.MouseButton1Up:Connect(function() tw(1.04, 0.1) end)
	local lbl = label(btn, {
		text = props.text or "", size = UDim2.fromScale(1, 1),
		color = props.textColor or C.TEXT_WHITE,
		textSize = props.textSize or (IS_MOBILE and 14 or 17), zIndex = (props.zIndex or 5) + 1,
	})
	return btn, lbl
end

