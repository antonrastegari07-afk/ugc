	local function renderBoards(body)
		local sys
		for _, s in ipairs(AC_SYS) do if s.id == ST.sys then sys = s end end
		if not sys then sys = AC_SYS[1] ; ST.sys = sys.id end

		local valid = false
		for _, m in ipairs(sys.metrics) do if m.id == ST.metric then valid = true end end
		if not valid then ST.metric = sys.metrics[1].id end

		local sysItems = {}
		for _, s in ipairs(AC_SYS) do table.insert(sysItems, { id = s.id, label = s.label }) end
		acTabBar(body, 0, sysItems, ST.sys, RED, function(id)
			ST.sys = id ; ST.metric = nil ; screenACBoards_new()
		end)
		acTabBar(body, 1, sys.metrics, ST.metric, sys.color, function(id)
			ST.metric = id ; screenACBoards_new()
		end)

		local isDate = false
		for _, m in ipairs(sys.metrics) do if m.id == ST.metric then isDate = m.isDate end end

		--── 🗑️ Zone dangereuse (fly uniquement), inchangée dans l'esprit ──
		if ST.sys == "fly" then
			local dz = Instance.new("Frame")
			dz.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
			dz.BackgroundTransparency = 1
			dz.LayoutOrder = 2; dz.ZIndex = 11; dz.Parent = body
			local ag = Instance.new("UIGridLayout")
			ag.CellSize = UDim2.new(0.5, -4, 1, 0)
			ag.CellPadding = UDim2.new(0, 8, 0, 0)
			ag.Parent = dz

			local function danger(order, text, actionId)
				local c = Instance.new("Frame")
				c.LayoutOrder = order; c.BackgroundTransparency = 1
				c.ZIndex = 11; c.Parent = dz
				local b, lbl = actionButton(c, { color = Color3.fromRGB(150, 40, 40),
					strokeColor = RED, text = text,
					textSize = IS_MOBILE and 10 or 12, radius = 8, zIndex = 11 })
				local armed = false
				b.MouseButton1Click:Connect(function()
					if not armed then
						armed = true ; lbl.Text = "⚠️ Appuie encore"
						task.delay(3, function()
							if lbl and lbl.Parent then armed = false ; lbl.Text = text end
						end)
						return
					end
					armed = false
					adminEvent:FireServer(actionId)
					-- ⏳ L'effacement ne peut PAS être instantané : un OrderedDataStore
					--    se vide clé par clé, et les lectures triées de Roblox mettent
					--    jusqu'à une minute à refléter les suppressions. On relit donc
					--    plusieurs fois au lieu d'annoncer une fausse fin au bout de 2 s.
					toast("Effacement lancé — ça prend jusqu'à 1 min", true)
					local steps = { 4, 10, 18, 30, 45, 60 }
					task.spawn(function()
						local t0 = os.clock()
						for i, at in ipairs(steps) do
							while os.clock() - t0 < at do
								if lbl and lbl.Parent then
									lbl.Text = string.format("⏳ %ds…",
										math.max(0, math.floor(at - (os.clock() - t0))))
								end
								task.wait(0.5)
							end
							-- Le cache client ET la relecture serveur, à chaque passe.
							CACHE.board = {}
							if currentScreen ~= "acboards" then return end
							screenACBoards_new()
							if i == #steps and lbl and lbl.Parent then
								lbl.Text = text
							end
						end
					end)
				end)
			end
			danger(1, "🗑️ Effacer les stats", "wipeflytest")
			danger(2, "🗑️ Effacer les warnings", "wipeflyreal")
		end

		local status = Instance.new("Frame")
		status.Size = UDim2.new(1, 0, 0, 40)
		status.BackgroundTransparency = 1
		status.LayoutOrder = 4; status.ZIndex = 11; status.Parent = body
		local stl = label(status, { text = "Chargement...", size = UDim2.fromScale(1, 1),
			color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })

		local holder = Instance.new("Frame")
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.AutomaticSize = Enum.AutomaticSize.Y
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = 5; holder.ZIndex = 11; holder.Parent = body
		local hl = Instance.new("UIListLayout")
		hl.Padding = UDim.new(0, IS_MOBILE and 6 or 9)
		hl.SortOrder = Enum.SortOrder.LayoutOrder
		hl.Parent = holder

		local gb = acRemote("AdminGetACBoard")
		if not gb then
			stl.Text = "❌ AdminGetACBoard manquant — mets AdminPanel_Server à jour."
			return
		end

		local function paint(entries, testMode)
			if not status.Parent then return end
			status:Destroy()

			if ST.sys == "fly" then
				local bf = Instance.new("Frame")
				bf.Size = UDim2.new(1, 0, 0, IS_MOBILE and 18 or 22)
				bf.BackgroundTransparency = 1
				bf.LayoutOrder = 0; bf.ZIndex = 11; bf.Parent = holder
				label(bf, {
					text = testMode and "🧪 Données du mode shadow (rien n'a été appliqué)"
						or "🛡️ Données réelles (sanctions actives)",
					size = UDim2.fromScale(1, 1), xAlign = Enum.TextXAlignment.Left,
					color = testMode and CYAN or ORANGE,
					textSize = IS_MOBILE and 10 or 12, zIndex = 11 })
			end

			if #entries == 0 then
				label(holder, { text = (testMode == false
					and (ST.metric == "fly_strikes" or ST.metric == "fly_kicks"))
					and "⏸️ Signaux et kicks ne sont suivis qu'en mode shadow."
					or "Aucune donnée pour ce classement.",
					size = UDim2.new(1, 0, 0, 60), wrapped = true,
					color = C.TEXT_GREY, textSize = IS_MOBILE and 11 or 14, zIndex = 11 })
				return
			end

			local refs, ids = {}, {}
			for i, e in ipairs(entries) do
				ids[#ids + 1] = e.userId
				refs[#refs + 1] = acLine(holder, i + 1, {
					userId = e.userId, rank = i, accent = sys.color,
					value = isDate
						and ((e.value and e.value > 0) and fmtAgo(e.value) or "?")
						or fmtNum(e.value),
					valueColor = sys.color,
				})
			end
			resolveAC(ids, function()
				if holder.Parent then fillLines(refs, stdSub) end
			end)

			if #entries >= ST.count and ST.count < 200 then
				local mc = Instance.new("Frame")
				mc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 38 or 44)
				mc.BackgroundTransparency = 1
				mc.LayoutOrder = 99999; mc.ZIndex = 11; mc.Parent = holder
				local mb = actionButton(mc, { color = C.BG_LIGHT, strokeColor = C.BORDER_BRIGHT,
					text = "⬇️ Charger 50 de plus", textSize = IS_MOBILE and 11 or 13,
					radius = 9, zIndex = 11 })
				mb.MouseButton1Click:Connect(function()
					ST.count = ST.count + 50
					CACHE.board[ST.metric .. "_" .. ST.count] = nil
					screenACBoards_new()
				end)
			end
		end

		--  Cache de 45 s : rebasculer entre deux onglets ne relit pas le
		--  DataStore. C'est ce qui rend la navigation instantanée.
		local key = ST.metric .. "_" .. ST.count
		local cached = CACHE.board[key]
		if cached and (os.clock() - cached.at) < CACHE.BOARD_TTL then
			paint(cached.entries, cached.testMode)
			return
		end

		task.spawn(function()
			local ok, res = pcall(function() return gb:InvokeServer(ST.metric, ST.count) end)
			if not status.Parent then return end
			if not (ok and type(res) == "table" and type(res.entries) == "table") then
				stl.Text = "Lecture impossible. Appuie sur 🔄."
				return
			end
			CACHE.board[key] = { entries = res.entries, testMode = res.testMode, at = os.clock() }
			paint(res.entries, res.testMode)
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 🔍 ONGLET « DOSSIER »
	--════════════════════════════════════════════════════════════════
	local function renderCard(body)
		--  Recherche libre : on peut ouvrir un dossier sans passer par une liste.
		local sw = Instance.new("Frame")
		sw.Size = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
		sw.BackgroundTransparency = 1
		sw.LayoutOrder = 0; sw.ZIndex = 11; sw.Parent = body

		local btnW = IS_MOBILE and 58 or 76
		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0, 0.5)
		box.Position = UDim2.new(0, 0, 0.5, 0)
		box.Size = UDim2.new(1, -btnW - 8, 1, 0)
		box.BackgroundColor3 = C.BG_DARK
		box.BorderSizePixel = 0
		box.Font = FONT
		box.PlaceholderText = "Pseudo exact ou UserID..."
		box.PlaceholderColor3 = C.TEXT_DIM
		box.Text = ST.search or ""
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 11 or 14
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.ZIndex = 12
		box.Parent = sw
		corner(box, 8); stroke(box, CYAN, 1)
		local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0, 10); bp.Parent = box
		box:GetPropertyChangedSignal("Text"):Connect(function() ST.search = box.Text end)

		local gc = Instance.new("Frame")
		gc.AnchorPoint = Vector2.new(1, 0.5)
		gc.Position = UDim2.new(1, 0, 0.5, 0)
		gc.Size = UDim2.new(0, btnW, 1, 0)
		gc.BackgroundTransparency = 1
		gc.ZIndex = 12; gc.Parent = sw

		local function lookup()
			local q = (ST.search or ""):gsub("^%s+", ""):gsub("%s+$", "")
			if #q < 2 then toast("Entre un pseudo ou un UserID", false) return end
			ST.cardFor = tonumber(q) or q
			ST.cardData = nil
			screenACBoards_new()
		end

		local gb2 = actionButton(gc, { color = C.PURPLE, strokeColor = C.PURPLE_DARK,
			text = "🔍", textSize = IS_MOBILE and 13 or 16, radius = 8, zIndex = 12 })
		gb2.MouseButton1Click:Connect(lookup)
		box.FocusLost:Connect(function(enter) if enter then lookup() end end)

		if not ST.cardFor then
			note(body, 1, "Choisis un joueur dans 📡 Récent, 🎯 Risque ou 🏆 Classements, "
				.. "ou cherche-le ici.\n\nLe dossier te donne le pourcentage de certitude, "
				.. "le détail de chaque signal, et les facteurs exacts qui l'ont fait monter "
				.. "ou descendre.", C.TEXT_DIM)
			return
		end

		if not ST.cardData and not ST.cardLoading then
			ST.cardLoading = true
			callAC("lookup", { target = ST.cardFor, deep = true }, function(res)
				ST.cardLoading = false
				ST.cardData = res or { ok = false }
				if currentScreen == "acboards" and window.Visible then
					screenACBoards_new()
				end
			end)
		end

		if not ST.cardData then
			note(body, 1, "⏳ Ouverture du dossier...", C.TEXT_GREY)
			return
		end

		local d = ST.cardData
		if not d.ok then
			note(body, 1, "❌ " .. tostring(d.msg or "Joueur introuvable"), RED)
			return
		end

		local uid  = d.userId
		local live = d.live
		local per  = d.persisted
		local conf = (type(live) == "table" and tonumber(live.confidence)) or 0

		--── En-tête ──
		local hc = Instance.new("Frame")
		hc.Size = UDim2.new(1, 0, 0, IS_MOBILE and 84 or 104)
		hc.BackgroundColor3 = C.BG_DARK
		hc.BorderSizePixel = 0
		hc.LayoutOrder = 1
		hc.ZIndex = 12
		hc.Parent = body
		corner(hc, 10); stroke(hc, confColor(conf), 1.5)
		gradient(hc, C.BG_DARK, C.BG_ITEM)

		local avSize = IS_MOBILE and 58 or 76
		local av = makeAvatar(hc, uid, avSize, confColor(conf))
		av.AnchorPoint = Vector2.new(0, 0.5); av.Position = UDim2.new(0, 10, 0.5, 0)

		local ix = 10 + avSize + 12
		label(hc, { text = esc(d.name),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 20 or 26),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 8 or 12),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 15 or 19, truncate = true, zIndex = 13 })

		local p = pointsOf(uid)
		label(hc, { text = "🆔 " .. tostring(uid)
			.. (d.online and "  ·  🟢 en ligne" or "  ·  ⚪ hors ligne")
			.. (d.isAdmin and "  ·  👮 admin" or "")
			.. (p and ("  ·  💎 " .. fmtNum(p)) or ""),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 15 or 18),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 30 or 40),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 10 or 12, truncate = true, zIndex = 13 })

		label(hc, { text = string.format("🎯 Certitude du dossier : %d %%", conf),
			size = UDim2.new(1, -ix - 12, 0, IS_MOBILE and 18 or 22),
			position = UDim2.new(0, ix, 0, IS_MOBILE and 48 or 62),
			xAlign = Enum.TextXAlignment.Left, color = confColor(conf),
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 13 })

		--── Lecture du chiffre, en français ──
		local verdict, vcol
		if conf >= 85 then
			verdict = "Dossier solide. Plusieurs signaux concordants, rien dans le contexte "
				.. "ne les explique. C'est ce niveau qui autorise une sanction automatique."
			vcol = RED
		elseif conf >= 70 then
			verdict = "Comportement anormal établi, mais pas au niveau requis pour "
				.. "sanctionner tout seul. Regarde le détail avant de trancher."
			vcol = ORANGE
		elseif conf >= 55 then
			verdict = "Signaux retenus, mais faibles. Un bug de ton obby peut produire ça. "
				.. "N'agis pas là-dessus seul — attends que ça se répète."
			vcol = GOLD
		else
			verdict = "Rien de retenu contre ce joueur. Les signaux éventuels ont été "
				.. "écartés par le filtre parce que le contexte les expliquait."
			vcol = GREEN
		end
		note(body, 2, verdict, vcol)

		--── Compteurs ──
		local _, rows = card(body, 3, "📊 SUR CE SERVEUR", CYAN)
		if type(live) == "table" then
			statLine(rows, 1, "Signaux retenus", tostring(live.counted or 0),
				(live.counted or 0) > 0 and ORANGE or GREEN)
			statLine(rows, 2, "Signaux écartés par le filtre", tostring(live.ignored or 0),
				C.TEXT_GREY)
			statLine(rows, 3, "Warnings", tostring(live.simWarnings or 0),
				(live.simWarnings or 0) > 0 and ORANGE or GREEN)
			statLine(rows, 4, "Pic de certitude", tostring(live.confMax or 0) .. " %",
				confColor(live.confMax))
			local o = 10
			for t, n in pairs(live.detections or {}) do
				o = o + 1
				statLine(rows, o, "  " .. t, tostring(n), C.TEXT_GREY)
			end
		else
			statLine(rows, 1, "Aucun signal sur ce serveur", "clean ✅", GREEN)
		end

		if type(per) == "table" then
			local pAvg = ((per.confCount or 0) > 0)
				and math.floor(per.confSum / per.confCount) or 0
			local _, prows = card(body, 4, "💾 CUMUL TOUS SERVEURS", PURPLE)
			statLine(prows, 1, "Certitude moyenne", pAvg .. " %", confColor(pAvg))
			statLine(prows, 2, "Signaux retenus", tostring(per.total or 0),
				(per.total or 0) > 0 and ORANGE or GREEN)
			statLine(prows, 3, "Signaux écartés", tostring(per.detIgnored or 0), C.TEXT_GREY)
			statLine(prows, 4, "Warnings", tostring(per.warnEvents or 0), C.TEXT_WHITE)
			statLine(prows, 5, "Kicks", tostring(per.kickEvents or 0), C.TEXT_WHITE)
			statLine(prows, 6, "Sanction finale", per.wouldBan and "🚫 oui" or "non",
				per.wouldBan and RED or GREEN)
			if per.firstSeen then
				statLine(prows, 7, "Premier signal", fmtAgo(per.firstSeen), C.TEXT_GREY)
			end
			if per.lastSeen then
				statLine(prows, 8, "Dernier signal", fmtAgo(per.lastSeen), C.TEXT_GREY)
			end
			local o = 20
			for t, n in pairs(per.detByType or {}) do
				o = o + 1
				statLine(prows, o, "  " .. t, tostring(n), C.TEXT_GREY)
			end
		end

		--── Privation en cours ──
		if d.record then
			local r = d.record
			local _, rr = card(body, 5, "🚫 PRIVÉ D'UGC", RED)
			statLine(rr, 1, "Depuis", fmtAgo(r.at or 0), C.TEXT_WHITE)
			statLine(rr, 2, "Par", tostring(r.by or "?"), C.TEXT_GREY)
			statLine(rr, 3, "Certitude au moment T",
				(r.confidence and (r.confidence .. " %")) or "—", confColor(r.confidence))
			statLine(rr, 4, "Tentatives bloquées", tostring(r.attempts or 0), C.TEXT_WHITE)
		end

		--── 🎯 LE RAPPORT DÉTAILLÉ ──
		local rec = (type(live) == "table" and live.recent) or {}
		if #rec > 0 then
			local _, drows = card(body, 6, "🎯 CE QUE LA MACHINE A VU", ORANGE)
			note(drows, 0, "Chaque ligne « + » a fait monter la certitude, chaque ligne "
				.. "« − » l'a fait descendre. Un signal écarté (⚪) n'a rien coûté au joueur.",
				C.TEXT_DIM)

			local n = 0
			for _, e in ipairs(rec) do
				n = n + 1
				if n > 10 then break end
				local base = 100 + n * 30

				local head = (e.kind == "warning")
					and ("⚠️ WARNING " .. tostring(e.count or "?"))
					or ((e.counted and "✅ " or "⚪ ") .. tostring(e.vType))
				statLine(drows, base, head,
					((e.conf and e.conf > 0) and (e.conf .. " % · ") or "")
						.. ((e.t and fmtAgo(e.t)) or "?"),
					e.kind == "warning" and RED or (e.counted and ORANGE or C.TEXT_DIM))

				local function sub(o, txt, col)
					local fr = Instance.new("Frame")
					fr.Size = UDim2.new(1, 0, 0, IS_MOBILE and 14 or 16)
					fr.BackgroundTransparency = 1
					fr.LayoutOrder = o; fr.ZIndex = 13; fr.Parent = drows
					label(fr, { text = txt, size = UDim2.fromScale(1, 1),
						xAlign = Enum.TextXAlignment.Left, color = col,
						textSize = IS_MOBILE and 9 or 11, truncate = true, zIndex = 13 })
				end

				if e.details and e.details ~= "" then
					sub(base + 1, "   " .. e.details, C.TEXT_DIM)
				end
				local nf = 0
				for _, f in ipairs(e.factors or {}) do
					nf = nf + 1
					if nf > 9 then break end
					local dv = tonumber(f.delta) or 0
					sub(base + 1 + nf,
						string.format("      %s%d   %s", dv > 0 and "+" or "", dv,
							tostring(f.label or "?")),
						dv > 0 and ORANGE or GREEN)
				end
			end
		end

		--── Actions ──
		bigBtn(body, 20, "👤 Voir le profil complet", C.PURPLE, C.PURPLE_DARK, function()
			openProfileDetail(d.name, function() screenACBoards_new() end)
		end)

		if d.record then
			bigBtn(body, 21, "✅ Rendre l'accès UGC", GREEN, Color3.fromRGB(28, 122, 62),
				function()
					callAC("remove", { userId = uid }, function(res)
						if res and res.msg then toast(res.msg, res.ok == true) end
						ST.cardData = nil ; CACHE.restr[uid] = nil
						screenACBoards_new()
					end)
				end, C.BG_BLACK)
		else
			bigBtn(body, 21, "🚫 Priver d'UGC", RED, RED_D, function()
				callAC("add", { userId = uid, note = "Depuis le dossier anti-cheat" },
				function(res)
					if res and res.msg then toast(res.msg, res.ok == true) end
					ST.cardData = nil ; CACHE.restr[uid] = true
					screenACBoards_new()
				end)
			end, C.TEXT_WHITE)
		end

		bigBtn(body, 22, "🧹 Remettre ses compteurs à zéro", C.BG_LIGHT, C.BORDER_BRIGHT,
			function()
				callAC("clearstats", { userId = uid }, function(res)
					if res and res.msg then toast(res.msg, res.ok == true) end
					ST.cardData = nil ; CACHE.board = {}
					screenACBoards_new()
				end)
			end)
		note(body, 23, "À faire quand tu conclus à un faux positif. Sans ça, même après "
			.. "avoir levé une sanction, les anciens signaux continuent de peser sur son "
			.. "score de certitude.", C.TEXT_DIM)
	end

