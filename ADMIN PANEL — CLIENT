			local bans, devs = 0, 0
			for _, e in ipairs(S.entries) do
				if e.a == "ban" then bans = bans + 1 end
				if e.db or e.dq then devs = devs + 1 end
			end
			countLbl.Text = string.format("%d affiché(s)  •  %d chargé(s)  •  %d ban(s)  •  %d appareil",
				#list, #S.entries, bans, devs)

			if #list == 0 then
				local msg
				if S.loadingLog then msg = "Chargement du journal..."
				elseif not getLog then msg = "❌ BanManager pas installé côté serveur."
				elseif #S.entries == 0 then
					msg = "✅ Aucune sanction enregistrée.\n\nSi tu as déjà banni des joueurs avant, "
						.. "l'import automatique tourne 25 s après le démarrage du serveur — "
						.. "reviens dans une minute, ou lance-le à la main depuis ⚙️ Réglages."
				else msg = "Rien ne correspond à ces filtres." end

				local f = Instance.new("Frame")
				f.Size = UDim2.new(1, 0, 0, 80); f.BackgroundTransparency = 1
				f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
				label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
