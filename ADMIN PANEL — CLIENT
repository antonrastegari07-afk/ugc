	local function stepper(parent, order, opt)
		local value = tonumber(opt.value) or opt.min
		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, 0)
		wrap.AutomaticSize = Enum.AutomaticSize.Y
		wrap.BackgroundColor3 = C.BG_DARK
		wrap.BorderSizePixel = 0
		wrap.LayoutOrder = order
		wrap.ZIndex = 11
		wrap.Parent = parent
		corner(wrap, 9); stroke(wrap, opt.color or CYAN, 1)

		local ll = Instance.new("UIListLayout")
		ll.Padding = UDim.new(0, 3); ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Parent = wrap
		local rp = Instance.new("UIPadding")
		rp.PaddingTop = UDim.new(0, 6); rp.PaddingBottom = UDim.new(0, 9)
		rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
		rp.Parent = wrap

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 36)
		row.BackgroundTransparency = 1
		row.LayoutOrder = 1; row.ZIndex = 12; row.Parent = wrap

		label(row, { text = opt.title, size = UDim2.new(1, -(IS_MOBILE and 132 or 160), 1, 0),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 11 or 14, truncate = true, zIndex = 13 })

		--  Disposition, alignée à droite : [ − ] [ valeur ] [ + ]
		--  Les décalages sont calculés dans des variables nommées, jamais
		--  inline : `bw + IS_MOBILE and 58 or 70` s'évalue en
		--  `(bw + IS_MOBILE) and 58 or 70` et fait une addition sur un
		--  booléen. C'est le genre d'erreur qui ne se voit qu'à l'exécution.
		local bw    = IS_MOBILE and 32 or 38     -- largeur d'un bouton
		local vw    = IS_MOBILE and 58 or 68     -- largeur de la valeur
		local gap   = 4
		local plusX  = 0                          -- collé à droite
		local valX   = plusX - bw - gap
		local minusX = valX - vw - gap

		local function side(isPlus, offset)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(1, 0.5)
			c.Position = UDim2.new(1, offset, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 26 or 30)
			c.BackgroundTransparency = 1
			c.ZIndex = 13; c.Parent = row
			local b = actionButton(c, {
				color = isPlus and GREEN or C.BG_LIGHT,
				strokeColor = isPlus and GREEN_D or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 15 or 19, radius = 7, zIndex = 13 })
			b.MouseButton1Click:Connect(function()
				local step = opt.step or 1
				setDraft(opt.path, math.clamp(value + (isPlus and step or -step),
					opt.min, opt.max))
				screen(false)
			end)
		end
		side(true,  plusX)
		side(false, minusX)

		label(row, { text = opt.format and opt.format(value) or tostring(value),
			size = UDim2.new(0, vw, 1, 0),
			position = UDim2.new(1, valX, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			color = opt.color or CYAN, textSize = IS_MOBILE and 12 or 15, zIndex = 13 })

		if opt.desc then
			local d = Instance.new("TextLabel")
			d.Size = UDim2.new(1, 0, 0, 0)
			d.AutomaticSize = Enum.AutomaticSize.Y
			d.BackgroundTransparency = 1
			d.Font = Enum.Font.Gotham
			d.Text = opt.desc
			d.TextColor3 = C.TEXT_DIM
			d.TextSize = IS_MOBILE and 9 or 11
			d.TextWrapped = true
			d.TextXAlignment = Enum.TextXAlignment.Left
			d.LayoutOrder = 2; d.ZIndex = 12; d.Parent = wrap
		end
		return wrap
	end

	--════════════════════════════════════════════════════════════════════
	-- ✍️ CHAMP DE TEXTE MULTILIGNE
	--
	--    On n'enregistre PAS à chaque frappe : on écrit dans le brouillon
	--    quand tu quittes le champ (FocusLost). Sinon chaque lettre tapée
	--    déclencherait un re-rendu et tu perdrais le curseur.
	--════════════════════════════════════════════════════════════════════
	local function textField(parent, order, opt)
		local wrap = Instance.new("Frame")
		wrap.Size = UDim2.new(1, 0, 0, 0)
		wrap.AutomaticSize = Enum.AutomaticSize.Y
		wrap.BackgroundColor3 = C.BG_DARK
		wrap.BorderSizePixel = 0
		wrap.LayoutOrder = order
		wrap.ZIndex = 11
