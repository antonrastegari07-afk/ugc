		p.PaddingTop = UDim.new(0, 7); p.PaddingBottom = UDim.new(0, 7)
		p.PaddingLeft = UDim.new(0, 9); p.PaddingRight = UDim.new(0, 9)
		p.Parent = f
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, 0)
		l.AutomaticSize = Enum.AutomaticSize.Y
		l.BackgroundTransparency = 1
		l.Font = FONT
		l.Text = text
		l.TextColor3 = color or C.TEXT_GREY
		l.TextSize = IS_MOBILE and 10 or 12
		l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.ZIndex = 12
		l.Parent = f
		return f
	end

	local function bigButton(parent, order, txt, bg, edge, h, onClick)
		local b = Instance.new("TextButton")
		b.Size             = UDim2.new(1, 0, 0, h)
		b.BackgroundColor3 = bg
		b.BorderSizePixel  = 0
		b.AutoButtonColor  = false
		b.Text             = txt
		b.Font             = FONT
		b.TextSize         = IS_MOBILE and 15 or 19
		b.TextColor3       = Color3.fromRGB(255, 255, 255)
		b.TextWrapped      = true
		b.LayoutOrder      = order
		b.ZIndex           = 12
		b.Parent           = parent
		corner(b, 12)
		stroke(b, edge, 2)

		local veil = Instance.new("Frame")
		veil.Size                   = UDim2.new(1, 0, 1, 0)
		veil.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
		veil.BackgroundTransparency = 1
		veil.BorderSizePixel        = 0
		veil.ZIndex                 = 12
		veil.Parent                 = b
		corner(veil, 12)

		local function fade(v)
			TweenService:Create(veil, TweenInfo.new(0.1),
				{ BackgroundTransparency = v }):Play()
		end
		if not IS_MOBILE then
			b.MouseEnter:Connect(function() fade(0.9) end)
			b.MouseLeave:Connect(function() fade(1) end)
		end
		b.MouseButton1Down:Connect(function() fade(0.8) end)
		b.MouseButton1Up:Connect(function() fade(IS_MOBILE and 1 or 0.9) end)
		b.MouseButton1Click:Connect(onClick)
		return b
	end

	local function infoRow(parent, order, k, v, col)
		local row = Instance.new("Frame")
		row.Size               = UDim2.new(1, 0, 0, IS_MOBILE and 20 or 24)
		row.BackgroundTransparency = 1
		row.LayoutOrder        = order
		row.ZIndex             = 12
		row.Parent             = parent
		label(row, { text = k, size = UDim2.new(0.42, 0, 1, 0),
			position = UDim2.new(0, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, zIndex = 13 })
		label(row, { text = v, size = UDim2.new(0.58, 0, 1, 0),
			position = UDim2.new(0.42, 0, 0, 0), xAlign = Enum.TextXAlignment.Left,
			color = col or C.TEXT_WHITE, textSize = IS_MOBILE and 10 or 12, zIndex = 13 })
		return row
	end

	--  ⚠️ InvokeServer n'a AUCUN timeout. Si le remote existe mais que
	--     personne ne l'a branché côté serveur — le script du switch a planté
	--     après avoir créé les remotes, ou le DataStore throttle la lecture —
	--     l'appel ne revient jamais. Les drapeaux `loading` / `busy`
	--     restaient alors coincés à true et l'écran ne pouvait plus RIEN
	--     faire, bouton « Rafraîchir » compris. C'est l'écran qu'on utilise
	--     sous pression : il doit toujours répondre.
	local function invokeBounded(remote, seconds, ...)
		local args = table.pack(...)
		local done, res = false, nil
		task.spawn(function()
			local ok, r = pcall(function()
				return remote:InvokeServer(table.unpack(args, 1, args.n))
			end)
			if ok then res = r end
			done = true
		end)
		local waited = 0
		while not done and waited < seconds do
			task.wait(0.1)
			waited = waited + 0.1
		end
		return done, res
	end

	local function when(t)
		t = tonumber(t) or 0
		if t <= 0 then return "—" end
		return os.date("!%d/%m/%Y %H:%M UTC", t)
	end

	----------------------------------------------------------------------
	-- CHARGEMENT DE L'ÉTAT
	----------------------------------------------------------------------
	local screen   -- forward
	local function refreshIfStillHere()
		if currentScreen == "giftkill" and window.Visible then screen(false) end
	end

	--  ⚠️ `failed` est indispensable.
	--
	--     screen() appelle load() quand snap est vide, et load() rappelle
	--     screen() quand il a fini. Si l'appel échoue, snap reste vide : sans
	--     ce drapeau, les deux fonctions se relançaient l'une l'autre en
	--     boucle et martelaient le serveur aussi vite que le réseau le
	--     permet. Après un échec, on attend que l'admin appuie sur
	--     « Rafraîchir ».
	local function load()
		if S.loading or not killGet then return end
		S.loading = true
		task.spawn(function()
			local done, res = invokeBounded(killGet, 8)
			S.loading = false
			if done and type(res) == "table" then
				S.snap   = res
				S.snapAt = os.clock()
				S.failed = false
			else
				S.failed = true
			end
			refreshIfStillHere()
		end)
	end

	----------------------------------------------------------------------
	-- LA BASCULE
	----------------------------------------------------------------------
	local CODES = {
		applied      = { "✅ Appliqué sur TOUS les serveurs.", nil },
		no_broadcast = { "⚠️ Enregistré, mais la diffusion instantanée a échoué.\n"
			.. "Les autres serveurs suivront dans 30 s maximum.", nil },
		local_only   = { "🚨 Écriture DataStore impossible.\n"
			.. "La coupure n'est active QUE sur ce serveur. Réessaie dans un "
			.. "instant pour la propager partout.", nil },
		write_failed = { "❌ Écriture DataStore impossible — RIEN n'a changé.\n"
			.. "Réessaie. (Une réactivation n'est jamais appliquée localement : "
			.. "les autres serveurs resteraient coupés sans que tu le saches.)", nil },
		busy         = { "⏳ Trop rapide, attends deux secondes.", nil },
		denied       = { "🚫 Refusé : tu n'es pas dans ADMIN_IDS côté serveur.", nil },
		bad_arg      = { "❌ Requête invalide.", nil },
	}

	local function apply(turnOn)
		if S.busy or not killSet then return end
		S.busy   = true
		S.armed, S.armedFor = false, nil
		S.result = "⏳ Envoi…"
		S.resultColor = C.ORANGE
		refreshIfStillHere()

		task.spawn(function()
			local done, res = invokeBounded(killSet, 12, turnOn, S.reason)
			S.busy = false

			if not done or type(res) ~= "table" then
				S.result = done
					and "❌ Le serveur n'a pas répondu. Rien n'a changé."
					or  "⏱️ Pas de réponse en 12 s. L'action a peut-être abouti : "
					.. "rafraîchis l'état avant de réessayer."
				S.resultColor = C.RED
			else
				local meta = CODES[tostring(res.code)]
				S.result = meta and meta[1] or ("Code : " .. tostring(res.code))
				S.resultColor = res.ok and (res.code == "applied" and C.GREEN or C.ORANGE) or C.RED
				if type(res.snapshot) == "table" then
					S.snap   = res.snapshot
					S.snapAt = os.clock()
					S.failed = false
				end
			end

			refreshIfStillHere()
			--  On relit la vérité serveur : le snapshot renvoyé vient d'UN
			--  serveur, la lecture fraîche vient du DataStore.
			task.delay(1, load)
		end)
	end

	----------------------------------------------------------------------
	-- ÉCRAN
	----------------------------------------------------------------------
	screen = function(reset)
		currentScreen = "giftkill"
		if reset then
			S.armed, S.armedFor = false, nil
			S.result, S.resultColor = nil, nil
			S.snap = nil
		end

		local body = buildScreen("🛑 GIFT KILL SWITCH", true, KILL, nil,
			function() screen(true) end)

		if not (killGet and killSet) then
			noteCard(body, 1, "❌ GiftKillSwitch.server.lua n'est pas installé dans "
				.. "ServerScriptService.\nAjoute-le, puis redémarre le serveur.", C.RED)
			return
		end

		if not S.snap and not S.loading and not S.failed then load() end

		if S.failed and not S.snap then
			noteCard(body, 1, "⚠️ Impossible de lire l'état du kill switch.\n"
				.. "Appuie sur « Rafraîchir l'état » en bas de l'écran.", C.ORANGE)
		end

		local snap = S.snap
		--  `on`       = coupure GLOBALE (écrite dans le DataStore)
		--  `localOnly`= ce serveur est coupé en secours, mais pas les autres.
		--
		--  Les confondre affichait « coupé sur tous les serveurs » alors qu'un
		--  seul l'était, ET ne proposait plus que « RÉACTIVER » — donc aucun
		--  moyen de réessayer la coupure globale depuis l'écran qui venait de
		--  dire de réessayer.
		local on        = snap and snap.on == true
		local localOnly = (snap and snap.localCut == true) and not on

		------------------------------------------------------------------
		-- Bandeau d'état
		------------------------------------------------------------------
		local banner = Instance.new("Frame")
		banner.Size               = UDim2.new(1, 0, 0, IS_MOBILE and 62 or 76)
		local headline, subline, tone
		if not snap then
			headline, subline, tone =
				"⏳ Lecture de l'état…", "", C.TEXT_GREY
		elseif on then
			headline, subline, tone =
				"🛑 CADEAUX COUPÉS",
			"Aucun achat de cadeau n'est possible, sur aucun serveur.",
			KILL
		elseif localOnly then
			headline, subline, tone =
				"⚠️ COUPÉ SUR CE SERVEUR SEULEMENT",
			"L'écriture globale a échoué. Appuie sur COUPER pour réessayer "
				.. "de propager la coupure partout.",
			C.ORANGE
		else
			headline, subline, tone =
				"🟢 CADEAUX ACTIFS",
			"Le système de cadeaux fonctionne normalement.",
			LIVE
		end

		banner.BackgroundColor3   = on and KILL_D or C.BG_DARK
		banner.BorderSizePixel    = 0
		banner.LayoutOrder        = 0
		banner.ZIndex             = 11
		banner.Parent             = body
		corner(banner, 12); stroke(banner, tone, 2)

		label(banner, {
			text = headline,
			size = UDim2.new(1, -20, 0, IS_MOBILE and 26 or 32),
			position = UDim2.new(0, 10, 0, IS_MOBILE and 8 or 10),
			color = tone,
			textSize = IS_MOBILE and 16 or 21, zIndex = 12 })

		label(banner, {
			text = subline,
			size = UDim2.new(1, -20, 0, IS_MOBILE and 22 or 26),
			position = UDim2.new(0, 10, 0, IS_MOBILE and 34 or 44),
			xAlign = Enum.TextXAlignment.Center,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, zIndex = 12 })

		------------------------------------------------------------------
		-- Détail
		------------------------------------------------------------------
		if snap then
			local infoCard = Instance.new("Frame")
			infoCard.Size             = UDim2.new(1, 0, 0, 0)
			infoCard.AutomaticSize    = Enum.AutomaticSize.Y
			infoCard.BackgroundColor3 = C.BG_DARK
			infoCard.BorderSizePixel  = 0
			infoCard.LayoutOrder      = 1
			infoCard.ZIndex           = 11
			infoCard.Parent           = body
			corner(infoCard, 10); stroke(infoCard, C.BORDER_SUBTLE, 1)

			local rows = Instance.new("Frame")
			rows.Size               = UDim2.new(1, -20, 0, 0)
			rows.Position           = UDim2.new(0, 10, 0, 8)
			rows.AutomaticSize      = Enum.AutomaticSize.Y
			rows.BackgroundTransparency = 1
			rows.ZIndex             = 12
			rows.Parent             = infoCard
			local lay = Instance.new("UIListLayout")
			lay.Padding   = UDim.new(0, 2)
			lay.SortOrder = Enum.SortOrder.LayoutOrder
			lay.Parent    = rows
			local p = Instance.new("UIPadding")
			p.PaddingBottom = UDim.new(0, 8)
			p.Parent = rows

			infoRow(rows, 1, "Dernier changement", when(snap.t))
			infoRow(rows, 2, "Par", (snap.by ~= "" and snap.by or "—")
				.. (snap.byId and snap.byId > 0 and (" (" .. snap.byId .. ")") or ""))
			infoRow(rows, 3, "Raison notée", snap.reason ~= "" and snap.reason or "—")
			infoRow(rows, 4, "Version", tostring(snap.v or 0), C.TEXT_DIM)
			infoRow(rows, 5, "État lu sur ce serveur",
				snap.ready and "oui" or "NON (cadeaux bloqués par sécurité)",
				snap.ready and C.GREEN or C.ORANGE)
		end

		------------------------------------------------------------------
		-- Raison (optionnelle) — écrite dans le journal du switch
		------------------------------------------------------------------
		local reasonCard = Instance.new("Frame")
		reasonCard.Size             = UDim2.new(1, 0, 0, IS_MOBILE and 44 or 50)
		reasonCard.BackgroundColor3 = C.BG_ITEM
		reasonCard.BorderSizePixel  = 0
		reasonCard.LayoutOrder      = 2
		reasonCard.ZIndex           = 11
		reasonCard.Parent           = body
		corner(reasonCard, 10); stroke(reasonCard, C.BORDER_SUBTLE, 1)

		local reasonBox = Instance.new("TextBox")
		reasonBox.Size                   = UDim2.new(1, -20, 1, -10)
		reasonBox.Position               = UDim2.new(0, 10, 0, 5)
		reasonBox.BackgroundTransparency = 1
		reasonBox.ClearTextOnFocus       = false
		reasonBox.Text                   = S.reason
		reasonBox.PlaceholderText        = "Raison (facultatif) — ex : faille suspectée sur les boosts"
		reasonBox.PlaceholderColor3      = C.TEXT_DIM
		reasonBox.Font                   = FONT
		reasonBox.TextSize               = IS_MOBILE and 11 or 13
		reasonBox.TextColor3             = C.TEXT_WHITE
		reasonBox.TextXAlignment         = Enum.TextXAlignment.Left
		reasonBox.TextTruncate           = Enum.TextTruncate.AtEnd
		reasonBox.ZIndex                 = 12
		reasonBox.Parent                 = reasonCard
		reasonBox:GetPropertyChangedSignal("Text"):Connect(function()
			if #reasonBox.Text > 140 then reasonBox.Text = reasonBox.Text:sub(1, 140) end
			S.reason = reasonBox.Text
		end)

		------------------------------------------------------------------
		-- LE BOUTON
		------------------------------------------------------------------
		--  L'action que CE rendu propose. Si l'état a bougé depuis l'armement
		--  — un autre admin est passé par là — l'armement ne vaut plus rien :
		--  on désarme, et le deuxième appui de l'admin ne fait que réarmer.
		--  Les deux sens demandent confirmation : rouvrir en plein incident
		--  est aussi grave que couper par erreur.
		local want = on and "open" or "cut"
		if S.armed and S.armedFor ~= want then
			S.armed, S.armedFor = false, nil
		end
		local isArmed = S.armed and (os.clock() - S.armedAt) < ARM_WINDOW

		if S.busy then
			bigButton(body, 3, "⏳ ENVOI EN COURS…", C.BG_LIGHT, C.BORDER_BRIGHT,
				IS_MOBILE and 54 or 62, function() end)

		elseif isArmed then
			--  Deuxième appui : c'est celui qui agit.
			bigButton(body, 3,
				(want == "cut") and "⚠️  CONFIRMER — COUPER MAINTENANT"
					or "⚠️  CONFIRMER — ROUVRIR LES CADEAUX",
				(want == "cut") and KILL or C.GREEN,
				Color3.fromRGB(255, 255, 255),
				IS_MOBILE and 60 or 70,
				function() apply(want == "cut") end)

			bigButton(body, 4, "Annuler", C.BG_LIGHT, C.BORDER_SUBTLE,
				IS_MOBILE and 36 or 42, function()
					S.armed, S.armedFor = false, nil
					screen(false)
				end)

			--  L'armement retombe tout seul : un panneau laissé ouvert ne doit
			--  pas rester à un appui d'une bascule.
			task.delay(ARM_WINDOW + 0.1, function()
				if S.armed and (os.clock() - S.armedAt) >= ARM_WINDOW then
					S.armed, S.armedFor = false, nil
					refreshIfStillHere()
				end
			end)

		elseif on then
			bigButton(body, 3, "▶  RÉACTIVER LES CADEAUX", C.GREEN, LIVE,
				IS_MOBILE and 54 or 62, function()
					S.armed, S.armedFor, S.armedAt = true, "open", os.clock()
					S.result = nil
					screen(false)
				end)

		else
			bigButton(body, 3,
				localOnly and "🛑  RÉESSAYER — COUPER PARTOUT" or "🛑  COUPER LES CADEAUX",
				KILL_D, KILL,
				IS_MOBILE and 54 or 62, function()
					S.armed, S.armedFor, S.armedAt = true, "cut", os.clock()
					S.result = nil
					screen(false)
				end)

			--  Sortie de secours pour l'état « coupé ici seulement ». Sans
			--  arming : ça ne rouvre QUE ce serveur, alors que tous les autres
			--  sont déjà ouverts — la portée est minuscule et l'admin doit
			--  pouvoir défaire sa coupure locale sans détour.
			if localOnly then
				bigButton(body, 4, "Annuler la coupure locale (ce serveur)",
					C.BG_LIGHT, C.BORDER_SUBTLE,
					IS_MOBILE and 36 or 42, function() apply(false) end)
			end
		end

		------------------------------------------------------------------
		-- Résultat de la dernière action
		------------------------------------------------------------------
		if S.result then
			noteCard(body, 5, S.result, S.resultColor or C.TEXT_GREY)
		end

		------------------------------------------------------------------
		-- Ce que la coupure fait, en clair
		------------------------------------------------------------------
		noteCard(body, 6,
			"CE QUE LA COUPURE FAIT\n"
				.. "• Plus aucune fenêtre d'achat de cadeau ne s'ouvre, sur aucun serveur.\n"
				.. "• Le panneau cadeau se ferme et affiche le message de sécurité.\n"
				.. "• Les livraisons sont GELÉES : les cadeaux déjà payés restent dans "
				.. "la file et repartiront à la réouverture. Rien n'est perdu.",
			C.TEXT_GREY)

		noteCard(body, 7,
			"CE QU'ELLE NE FAIT PAS, ET C'EST VOULU\n"
				.. "Un achat lancé juste avant la coupure est quand même encaissé : "
				.. "Roblox a déjà débité le joueur, refuser le receipt reviendrait à "
				.. "garder son argent. Le cadeau part dans la file, gelé, et sera "
				.. "livré à la réouverture.\n\n"
				.. "Propagation : instantanée par MessagingService, 30 s au pire si un "
				.. "message se perd.",
			C.TEXT_DIM)

		bigButton(body, 8, "🔄 Rafraîchir l'état", C.BG_LIGHT, C.BORDER_SUBTLE,
			IS_MOBILE and 36 or 42, function()
				S.snap, S.failed = nil, false
				screen(false)
			end)
	end

	----------------------------------------------------------------------
	-- 🔗 ENTRÉE DE MENU
	----------------------------------------------------------------------
	table.insert(ACTIONS, { id = "giftkill", name = "🛑 GIFT KILL SWITCH", color = KILL })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "giftkill" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end

	----------------------------------------------------------------------
	-- 🎁 CARTE D'ÉTAT DANS L'ÉCRAN GIFT LOG
	--
	--  On enveloppe buildScreen plutôt que le `screen()` du bloc 2, qui est
	--  un local inaccessible d'ici. La carte est donc reconstruite à chaque
	--  rafraîchissement du journal, y compris au changement d'onglet.
	--
	--  Tout est sous pcall : une carte d'information ne doit jamais pouvoir
	--  empêcher le gift log de s'afficher.
	----------------------------------------------------------------------
	local previousBuildScreen = buildScreen
	buildScreen = function(title, ...)
		local r = table.pack(previousBuildScreen(title, ...))
		local body = r[1]

		if title == "🎁 GIFT LOG" and body and killGet then
			pcall(function()
				local strip = Instance.new("TextButton")
				strip.Size             = UDim2.new(1, 0, 0, IS_MOBILE and 34 or 40)
				strip.BackgroundColor3 = C.BG_DARK
				strip.BorderSizePixel  = 0
				strip.AutoButtonColor  = false
				strip.Text             = ""
