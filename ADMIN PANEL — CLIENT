	local function journalVisible()
		local out = {}
		local q = tostring(S.search or ""):lower()
		for _, e in ipairs(S.entries) do
			local rid = RLBL[e.r] and e.r or "other"
			local okR
			if S.filter == "all" then okR = true
			elseif S.filter == "_device" then okR = (e.db == true or e.dq == true)
			elseif S.filter == "_legacy" then okR = (e.lg == true)
			else okR = (rid == S.filter) end

			local okQ = true
			if #q > 0 then
				local un = (unameCache[tonumber(e.u) or 0] or ""):lower()
				okQ = (tostring(e.n or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.d or ""):lower():find(q, 1, true) ~= nil)
					or (un:find(q, 1, true) ~= nil)
					or (tostring(e.dt or ""):lower():find(q, 1, true) ~= nil)
					or (tostring(e.u) == q)
			end
			if okR and okQ then table.insert(out, e) end
		end
		-- Les entrées sans date partent en bas plutôt que de polluer le haut
		table.sort(out, function(a, b) return (a.t or 0) > (b.t or 0) end)
		return out
	end

