Players.PlayerAdded:Connect(function(p) unameCache[p.UserId] = p.Name end)

local function resolveUsernames(userIds, cb)
	-- ⚡ Les points partent EN MÊME TEMPS que les pseudos (avant : l'un APRÈS l'autre).
	--    resolvePoints appelé ensuite par l'écran attendra simplement cette lecture.
	resolvePoints(table.move(userIds, 1, math.min(#userIds, 60), 1, {}), function() end)
	local need = {}
	for _, id in ipairs(userIds) do
		if not unameCache[id] then table.insert(need, id) end
	end
	if #need == 0 then cb(); return end
	task.spawn(function()
		for start = 1, #need, 200 do
			local chunk = table.move(need, start, math.min(start + 199, #need), 1, {})
			local ok, res = pcall(function() return resolveNamesEvent:InvokeServer(chunk) end)
			if ok and type(res) == "table" then
				for k, v in pairs(res) do
					local id = tonumber(k)
					if id then unameCache[id] = v end
				end
			end
		end
		cb()
	end)
end

