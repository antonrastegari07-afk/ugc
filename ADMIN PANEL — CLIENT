	sysId = sysId or "fly"
	local sys
	for _, s in ipairs(AC_SYSTEMS) do if s.id == sysId then sys = s end end
	if not sys then sys = AC_SYSTEMS[1]; sysId = sys.id end
	local isValid = false
	for _, m in ipairs(sys.metrics) do if m.id == metricId then isValid = true end end
	if not isValid then metricId = sys.metrics[1].id end

	local body = buildScreen("🚨 ANTI-CHEAT BOARDS", true, C.RED, nil, function() screenACBoards(sysId, metricId) end)

