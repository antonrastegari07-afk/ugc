	local function renderDebt(body, back)
		local cfg = S.cfg
		note(body, 0, "Une dette veut dire : on a dû reprendre des points au joueur (parce "
			.. "qu'il a bien reçu son UGC après un remboursement), et son solde ne suffisait "
			.. "pas. Le reliquat est prélevé automatiquement dès qu'il a de quoi payer. Si tu "
			.. "penses que c'est une erreur, annule-la — le joueur ne perd rien.", C.RED)

		if cfg and not cfg.debtEnabled then
			note(body, 1, "⚠️ Le système de dette est ÉTEINT dans les réglages. Ces dettes "
				.. "datent d'avant : elles ne sont plus prélevées et ne bloquent plus rien. "
				.. "Tu peux les annuler pour faire le ménage.", WARN)
		elseif cfg and cfg.debtBlocksPurchases then
			note(body, 1, "🔒 Le blocage des achats est ACTIF : ces joueurs ne peuvent rien "
