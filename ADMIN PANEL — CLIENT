	screenRevenue = function(fresh)
		currentScreen = "revenue"
		ST.token += 1
		local tok = ST.token
		if fresh then ST.cache = {} end
		local body = buildScreen("💸 REVENUS", true, GREEN, nil, function() ST.cache = {} ; screenRevenue(false) end)
		local function alive() return ST.token == tok and currentScreen == "revenue" and body.Parent ~= nil end
		acTabBar(body, 1, PERIODS, ST.revP, GREEN_D, function(id) ST.revP = id ; screenRevenue(false) end)
		local loading = note(body, 2, "⏳ Chargement…")

		fetch("rev", ST.revP, function(res, err)
			if not alive() then return end
			loading:Destroy()
			if not res then note(body, 2, "❌ " .. tostring(err), C.RED) return end
			local p = res.period
			local net = math.floor((tonumber(res.gross) or 0) * SHARE)
			local when = PERIOD_TXT[p] or ("depuis le " .. tostring(res.since))

			-- ── Ce que tu as reçu ──
			local hero = card(body, 3, IS_MOBILE and 130 or 158)
			line(hero, 8, 16, "CE QUE TU AS REÇU · " .. string.upper(when), C.TEXT_GREY, SM)
			line(hero, IS_MOBILE and 24 or 26, IS_MOBILE and 32 or 40,
				R(net) .. string.format('  <font size="%d" color="#9A9AB0">≈ %s</font>', MD, cad(net, res.cadPerRobux)),
				GREEN, IS_MOBILE and 28 or 36, true)
			local dt, dc = deltaTxt(res.gross, res.prevGross)
			if dt then
				line(hero, IS_MOBILE and 60 or 72, 16, dt .. " " .. (PREV_TXT[p] or ""), dc, SM)
			elseif res.clipped or p == "all" then
				line(hero, IS_MOBILE and 60 or 72, 16, "Stats depuis le " .. tostring(res.since), C.TEXT_DIM, SM)
			end
			line(hero, IS_MOBILE and 84 or 104, 16, string.format("Payé par les joueurs : %s  ·  %s achat%s  ·  %s acheteur%s",
				R(res.gross), sep(res.n), (res.n or 0) > 1 and "s" or "", sep(res.buyers), (res.buyers or 0) > 1 and "s" or ""),
				C.TEXT_GREY, SM)
			-- 💱 Vrai taux ou taux de secours ?
			local rateTxt = (string.format("%.4f", tonumber(res.usdCad) or 1.42):gsub("%.", ","))
			if res.fxAt then
				line(hero, IS_MOBILE and 104 or 128, 16, "✅ Vrai taux du jour : 1 $ US = " .. rateTxt
					.. " $ CA  (récupéré le " .. tostring(res.fxAt) .. ")", GREEN, SM)
			else
				line(hero, IS_MOBILE and 104 or 128, 16, "⚠️ TAUX DE SECOURS : 1 $ US = " .. rateTxt
					.. " $ CA  (vrai taux indisponible, voir en bas)", C.ORANGE, SM)
			end

			-- ── Graphique ──
			barChart(body, 4, res.series, p == "today" and "R$ reçus par heure (heure de Montréal)"
				or ("R$ reçus par " .. tostring(res.unit)), GREEN_D)

			-- ── Ce qui rapporte ──
			sectionLabel(body, 5, "CE QUI RAPPORTE LE PLUS")
			local maxR = (res.products[1] and res.products[1].r) or 1
			for i, x in ipairs(res.products) do
				local name = Cat and Cat.Name(x.id) or ("Produit " .. tostring(x.id))
				local m = Cat and Cat.CATEGORIES[Cat.Category(x.id)]
				row(body, 5 + i, { title = (m and (m.emoji .. " ") or "") .. name,
					sub = string.format("%s vente%s · %s du total", sep(x.n), x.n > 1 and "s" or "", pct(x.r, res.gross)),
					right = "+" .. R(x.r * SHARE), share = x.r / math.max(1, maxR) })
			end
			if res.rest then
				row(body, 20, { title = "Autres produits", sub = sep(res.rest.n) .. " ventes",
					right = "+" .. R(res.rest.r * SHARE), rightColor = C.TEXT_GREY })
			end
			if #res.products == 0 then note(body, 6, "Aucune vente sur cette période.") end

			-- ── Derniers achats ──
			sectionLabel(body, 30, "DERNIERS ACHATS · touche pour voir tout ce qu'il a acheté")
			local ids = {}
			for _, e in ipairs(res.recent) do
				table.insert(ids, e.u)
				if e.g then table.insert(ids, e.g) end
			end
			resolveUsernames(ids, function()
				if not alive() then return end
				for i, e in ipairs(res.recent) do
					local name = Cat and Cat.Name(e.p) or tostring(e.p)
					local sub = name .. " · " .. tostring(e.ds)
					if e.g then sub = sub .. " · 🎁 pour @" .. (unameCache[e.g] or tostring(e.g)) end
					row(body, 30 + i, { image = "rbxthumb://type=AvatarHeadShot&id=" .. e.u .. "&w=48&h=48", round = true,
						title = "@" .. (unameCache[e.u] or tostring(e.u)) .. (e.f and "  🆕" or ""),
						sub = sub, right = "+" .. R((tonumber(e.r) or 0) * SHARE),
						onClick = function() economy.openPurchases(e.u) end })
				end
				if #res.recent == 0 then note(body, 31, "Aucun achat pour l'instant.") end
				note(body, 90, "Tu reçois 70 % de ce que paient les joueurs (Roblox garde 30 %). "
					.. string.format("≈ $ CA = DevEx 0,0038 $ US/R$ × %s %s. ",
						(string.format("%.4f", tonumber(res.usdCad) or 1.42):gsub("%.", ",")),
						res.fxAt and ("(vrai taux du jour, mis à jour toutes les 12 h, dernier : " .. tostring(res.fxAt) .. ")")
							or "(⚠️ taux de SECOURS de ProductCatalog : le vrai taux n'a pas pu être récupéré. "
							.. "Vérifie « Allow HTTP Requests » dans Game Settings › Security. En Studio, c'est le taux du jeu qui s'affiche dès qu'un vrai serveur l'a récupéré)")
						.. "🆕 = tout premier achat du joueur. "
						.. "Heures de Montréal. Stats depuis le " .. tostring(res.since) .. ".", C.TEXT_DIM)
			end)
		end)
	end

