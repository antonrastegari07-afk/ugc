local function startSpectate()
	if #getOthers() == 0 then toast("No one to spectate", false); return end
	spectating = true
	spectateIndex = 1
	-- réglages caméra par défaut
	specYaw, specPitch, specDist = 0, math.rad(-15), 14
	spectateBar.Visible = true
	window.Visible = false
	bindSpectateInput()
	spectateAt(1)
	-- 🔑 pilotage caméra chaque frame, APRÈS la caméra du jeu (priorité + élevée
	--    = exécuté en dernier → on écrase toute caméra custom → fix "je me revois").
	--    Suit aussi le respawn (Character relu à chaque frame dans spectateApply).
	if specBound then pcall(function() RunService:UnbindFromRenderStep(SPEC_BIND) end) end
	RunService:BindToRenderStep(SPEC_BIND, Enum.RenderPriority.Camera.Value + 100, function()
		if spectating then spectateApply() end
	end)
	specBound = true
	-- 🌍 boucle de streaming : recharge la zone autour de la cible qui se déplace
	--    (async, ne bloque jamais le rendu). S'arrête quand le spectate s'arrête.
	task.spawn(function()
		while spectating do
			spectateStreamAround(spectateTarget)
			task.wait(0.5)
		end
	end)
end

