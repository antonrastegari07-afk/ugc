	local function nfmt(n)
		n = tonumber(n) or 0
		if math.abs(n) >= 999500 then return ("%.2fM"):format(n / 1e6) end
		if math.abs(n) >= 1e4 then return ("%.1fK"):format(n / 1e3) end
		if n ~= math.floor(n) then
			return (n >= 10) and ("%.0f"):format(n) or ("%.1f"):format(n)
		end
		local s = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1 "):reverse()
		return (s:gsub("^ ", ""))
	end

	local function daysFmt(d)
		if not d or d == math.huge or d ~= d then return "∞" end
		if d < 1 then return ("%.0f h"):format(math.max(1, d * 24)) end
		if d < 60 then return ("%.0f j"):format(d) end
		if d < 730 then return ("%.1f mois"):format(d / 30.44) end
		return ("%.1f ans"):format(d / 365)
	end

	local function midnight(t)
		local d = os.date("*t", t)   -- heure locale
		return t - (d.hour * 3600 + d.min * 60 + d.sec)
	end

	local function configItems()
		local c = cfg()
		if not c then return {} end
		local ok, list = pcall(function() return c.GetSortedItems() end)
		return (ok and type(list) == "table") and list or (c.Items or {})
	end

	local function loadStats()
		if ST.loading then return end
		ST.loading, ST.err, ST.progress, ST.truncated = true, nil, 0, false
		if currentScreen == "shopstats" then statsScreen() end
		task.spawn(function()
			-- 1) Stock de chaque UGC (en parallèle)
			local stocks = {}
			local stockFn = ReplicatedStorage:FindFirstChild("GetStockFunction")
			if stockFn then
				local items = configItems()
				local left = #items
				for _, it in ipairs(items) do
					task.spawn(function()
						local ok, d = pcall(function() return stockFn:InvokeServer(it.AssetId) end)
						if ok and type(d) == "table" then
							local total = tonumber(d.Total)
								or (type(d.Config) == "table" and tonumber(d.Config.InitialStock))
								or tonumber(it.InitialStock)
							stocks[key(it.AssetId)] = { cur = tonumber(d.CurrentStock), total = total }
						end
						left -= 1
					end)
				end
				local t0 = os.clock()
				while left > 0 and os.clock() - t0 < 15 do task.wait(0.05) end
			end

			-- 2) Tout le log des UGC récupérés
			local entries, cursor, pages = {}, nil, 0
			local logFn = ReplicatedStorage:FindFirstChild("AdminGetUGCRedeems")
			local cutoff = os.time() - 400 * DAY
			if not logFn then
				ST.err = "AdminGetUGCRedeems introuvable → UGCRedeemLog_Server pas installé."
			else
				while true do
					local ok, res = pcall(function() return logFn:InvokeServer(cursor, PAGE_SIZE) end)
					if not ok or type(res) ~= "table" or type(res.entries) ~= "table" then
						if pages == 0 then
							ST.err = "Lecture du log impossible : " .. tostring(type(res) == "table" and res.msg or res)
						else
							ST.truncated = true
						end
						break
					end
					local oldest = math.huge
					for _, e in ipairs(res.entries) do
						table.insert(entries, e)
						oldest = math.min(oldest, tonumber(e.t) or math.huge)
					end
					pages += 1
					ST.progress = #entries
					if ST.progLbl and ST.progLbl.Parent then
						ST.progLbl.Text = ("⏳ Lecture du log… %d achats"):format(#entries)
					end
					cursor = res.cursor
					if res.hasMore ~= true or cursor == nil or #res.entries == 0 then break end
					if oldest < cutoff then break end              -- plus d'un an : assez
					if pages >= MAX_PAGES then ST.truncated = true; break end
					task.wait(0.12)
				end
			end

			ST.stocks, ST.entries = stocks, entries
			ST.loading, ST.loadedAt = false, os.time()
			if ST.robux and not ST.rbx then loadRobux() end
			if currentScreen == "shopstats" then statsScreen() end
		end)
	end

	-- 💳 Combien de points chaque acheteur d'UGC a-t-il eus grâce à des Robux ?
	--    • packs achetés POUR LUI-MÊME   → AdminSpending (AdminSpending_Get / _Details)
	--    • gifts de points REÇUS         → GiftLog (AdminGetGiftPlayer)
	--    Les packs « Gift » achetés par un joueur ne comptent PAS pour lui :
	--    c'est le receveur qui a les points, donc c'est lui qui est financé.
	loadRobux = function()
		if ST.rbxLoading then return end
		ST.rbxLoading, ST.rbxErr, ST.rbxProgress = true, nil, ""
		task.spawn(function()
			local getFn = ReplicatedStorage:FindFirstChild("AdminSpending_Get")
			local detFn = ReplicatedStorage:FindFirstChild("AdminSpending_Details")
			local gpFn  = ReplicatedStorage:FindFirstChild("AdminGetGiftPlayer")
			local map = {}
			local function progress(txt)
				ST.rbxProgress = txt
				if ST.progLbl and ST.progLbl.Parent then ST.progLbl.Text = txt end
			end
			local function invoke(fn, ...)
				local args = table.pack(...)
				for _ = 1, 20 do
					local ok, res = pcall(function() return fn:InvokeServer(table.unpack(args, 1, args.n)) end)
					if ok and not (type(res) == "table" and res.throttled) then return res end
					task.wait(0.4)
				end
				return nil
			end

			local ids, seen = {}, {}
			for _, e in ipairs(ST.entries or {}) do
				local uid = tonumber(e.u)
				local g = SRC_GRP[tostring(e.s)] or "paid"
				if uid and g == "paid" and not seen[uid] then
					seen[uid] = true
					table.insert(ids, uid)
					map[uid] = { pts = 0, rbx = 0, gpts = 0 }
				end
			end

			-- 1) Packs achetés pour soi (AdminSpending)
			if not getFn or not detFn then
				ST.rbxErr = "AdminSpending_Server introuvable → les packs achetés pour soi ne sont pas comptés."
			else
				local spenders = {}
				for i = 1, #ids, 50 do
					local chunk = {}
					for j = i, math.min(i + 49, #ids) do table.insert(chunk, ids[j]) end
					local res = invoke(getFn, chunk, false)
					if type(res) == "table" then
						for _, uid in ipairs(chunk) do
							local v = res[tostring(uid)]
							if type(v) == "table" and (tonumber(v.total) or 0) > 0 then table.insert(spenders, uid) end
						end
					end
					progress(("💳 Achats Robux… %d / %d joueurs"):format(math.min(i + 49, #ids), #ids))
				end
				for i, uid in ipairs(spenders) do
					local det = invoke(detFn, uid)
					if type(det) == "table" then
						for _, pr in ipairs(det.products or {}) do
							local pack = SELF_PACKS[tonumber(pr.id)]
							if pack then
								local n = tonumber(pr.count) or 0
								map[uid].pts += n * pack.pts
								map[uid].rbx += tonumber(pr.spent) or (n * pack.rbx)
							end
						end
					end
					progress(("💳 Détail des packs… %d / %d"):format(i, #spenders))
				end
			end

			-- 2) Gifts de points reçus (GiftLog), 6 lectures en parallèle
			if not gpFn then
				ST.rbxErr = (ST.rbxErr and (ST.rbxErr .. "\n") or "")
					.. "GiftLog introuvable (AdminGetGiftPlayer) → les gifts reçus ne sont pas comptés."
			else
				local idx, done = 0, 0
				local function worker()
					while true do
						idx += 1
						local uid = ids[idx]
						if not uid then return end
						local res = invoke(gpFn, uid, false)
						local rec = type(res) == "table" and res.record
						if type(rec) == "table" then
							local rp = tonumber(rec.rp) or 0
							if rp > 0 then
								-- Valeur exacte pour les gifts encore dans l'historique…
								local kPts, kRbx = 0, 0
								for _, h in ipairs(type(rec.hr) == "table" and rec.hr or {}) do
									local pack = GIFT_PACKS[tonumber(h.pr)]
									if pack and (h.k == nil or h.k == "points") then
										kPts += pack.pts; kRbx += pack.rbx
									end
								end
								kPts = math.min(kPts, rp)
								-- …et au meilleur taux (2M = 499 R$) pour les plus anciens
								local rest = rp - kPts
								map[uid].gpts += rp
								map[uid].pts += rp
								map[uid].rbx += kRbx + rest * BEST_RATE
							end
						end
						done += 1
						progress(("🎁 Gifts reçus… %d / %d joueurs"):format(done, #ids))
					end
				end
				local running = 0
				for _ = 1, math.min(6, #ids) do
					running += 1
					task.spawn(function() worker(); running -= 1 end)
				end
				local t0 = os.clock()
				while running > 0 and os.clock() - t0 < 180 do task.wait(0.1) end
			end

			for uid, info in pairs(map) do
				if info.pts <= 0 then map[uid] = nil end
			end
			ST.rbx, ST.rbxLoading = map, false
			if currentScreen == "shopstats" then statsScreen() end
		end)
	end

	-- Tous les calculs
	local function compute()
		local now = os.time()
		local today0 = midnight(now)
		local yest0 = midnight(today0 - DAY / 2)
		local R = {
			total = 0, today = 0, yest = 0, d7 = 0, d30 = 0, d365 = 0,
			pts7 = 0, pts30 = 0, ptsAll = 0, paidN = 0, flags = 0, free30 = 0,
			first = nil, byDay = {}, byHour = {}, byWday = {}, per = {},
			buyers30 = 0, repeat30 = 0,
			out7 = 0, out30 = 0,   -- toutes les sorties (pour la rupture)
			r = { today = 0, yest = 0, d7 = 0, d30 = 0, d365 = 0, total = 0, rev = 0,
				rev7 = 0, rev30 = 0, byDay = {}, buyers = 0, viaGift = 0, leftPts = 0, leftRbx = 0 },
		}
		local buyers = {}

		-- 💳 Quelle part de chaque UGC a été payée avec des points achetés en
		--    Robux ? Chaque joueur a un « budget » de points Robux (packs achetés
		--    pour lui-même + gifts de points REÇUS). On le dépense sur ses UGC
		--    payés, du plus récent au plus ancien. Un UGC peut être financé en
		--    partie (ex. 0,5 = moitié Robux, moitié grind).
		--    Le log ne dit pas QUAND les points ont été achetés : la répartition
		--    par jour est une estimation, les totaux sont fiables.
		local rbxShare = {}   -- [entry] = fraction 0..1
		local rbxRate  = {}   -- [uid] = R$ par point
		if ST.robux and ST.rbx then
			local byUser = {}
			for _, e in ipairs(ST.entries or {}) do
				local uid = tonumber(e.u)
				local g = SRC_GRP[tostring(e.s)] or "paid"
				if uid and g == "paid" and not e.f and (tonumber(e.p) or 0) > 0 and ST.rbx[uid] and tonumber(e.t) then
					byUser[uid] = byUser[uid] or {}
					table.insert(byUser[uid], e)
				end
			end
			for uid, info in pairs(ST.rbx) do
				if info.pts > 0 then
					rbxRate[uid] = info.rbx / info.pts
					local list = byUser[uid] or {}
					table.sort(list, function(a, b) return (tonumber(a.t) or 0) > (tonumber(b.t) or 0) end)
					local budget = info.pts
					for _, e in ipairs(list) do
						if budget <= 0 then break end
						local p = tonumber(e.p)
						local f = math.min(1, budget / p)
						rbxShare[e] = f
						budget -= f * p
					end
					R.r.buyers += 1
					if info.gpts > 0 then R.r.viaGift += 1 end
					R.r.leftPts += budget
					R.r.leftRbx += budget * rbxRate[uid]
				end
			end
		end
		for _, e in ipairs(ST.entries or {}) do
			local t = tonumber(e.t)
			local g = SRC_GRP[tostring(e.s)] or "paid"
			if g == "flag" then
				R.flags += 1
			elseif t and (ST.scope == "all" or g == "paid") then
				local age = now - t
				-- Toutes les sorties : rupture + détail par UGC
				if age < 7 * DAY then R.out7 += 1 end
				if age < 30 * DAY then R.out30 += 1 end
				local k = key(e.a)
				local P = R.per[k] or { total = 0, d7 = 0, d30 = 0, last = 0, rbx = 0 }
				P.total += 1
				if age < 7 * DAY then P.d7 += 1 end
				if age < 30 * DAY then P.d30 += 1 end
				P.last = math.max(P.last, t)
				R.per[k] = P
				local dk = os.date("%Y-%m-%d", t)
				R.first = math.min(R.first or t, t)
				local p = (not e.f) and tonumber(e.p) or 0

				local f = rbxShare[e] or 0
				if f > 0 then
					-- 💳 part payée en Robux : comptée à part, pas comme un cadeau
					local r = R.r
					local rev = f * p * (rbxRate[tonumber(e.u)] or 0)
					r.total += f
					r.rev += rev
					P.rbx += f
					if t >= today0 then r.today += f elseif t >= yest0 then r.yest += f end
					if age < 7 * DAY then r.d7 += f; r.rev7 += rev end
					if age < 30 * DAY then r.d30 += f; r.rev30 += rev end
					if age < 365 * DAY then r.d365 += f end
					r.byDay[dk] = (r.byDay[dk] or 0) + f
				end

				local w = 1 - f   -- part vraiment « donnée » (grind)
				if w > 0.0001 then
					R.total += w
					if t >= today0 then R.today += w elseif t >= yest0 then R.yest += w end
					R.ptsAll += p * w
					if p > 0 then R.paidN += w end
					if age < 7 * DAY then R.d7 += w; R.pts7 += p * w end
					if age < 30 * DAY then
						R.d30 += w; R.pts30 += p * w
						if g == "free" then R.free30 += w end
						local u = tostring(e.u)
						buyers[u] = (buyers[u] or 0) + 1
					end
					if age < 365 * DAY then R.d365 += w end
					R.byDay[dk] = (R.byDay[dk] or 0) + w
					local dt = os.date("*t", t)
					R.byHour[dt.hour] = (R.byHour[dt.hour] or 0) + w
					R.byWday[dt.wday] = (R.byWday[dt.wday] or 0) + w
				end
			end
		end
		for _, n in pairs(buyers) do
			R.buyers30 += 1
			if n > 1 then R.repeat30 += 1 end
		end

		-- Période couverte par les données (évite de sous-estimer si le log est récent)
		R.spanDays = R.first and math.max(1, (now - R.first) / DAY) or 1
		local function win(w) return math.min(w, R.spanDays) end
		R.perDayAll = R.total / R.spanDays
		R.rate7  = R.d7 / win(7)
		R.rate30 = R.d30 / win(30)
		R.outRate7  = R.out7 / win(7)
		R.outRate30 = R.out30 / win(30)

		-- Meilleur jour
		R.bestDay, R.bestN = nil, 0
		for dk, n in pairs(R.byDay) do
			if n > R.bestN then R.bestDay, R.bestN = dk, n end
		end
		local bh, bn = nil, 0
		for h, n in pairs(R.byHour) do if n > bn then bh, bn = h, n end end
		R.bestHour = bh
		local bw, bwn = nil, 0
		for w, n in pairs(R.byWday) do if n > bwn then bw, bwn = w, n end end
		R.bestWday = bw

		-- 14 derniers jours (pour le graphique)
		R.last14 = {}
		for i = 13, 0, -1 do
			local t = today0 - i * DAY + DAY / 2
			local dk = os.date("%Y-%m-%d", t)
			table.insert(R.last14, { day = os.date("*t", t), n = R.byDay[dk] or 0,
				r = R.r.byDay[dk] or 0, today = (i == 0) })
		end

		-- Stock restant
		R.rem, R.init, R.known, R.out = 0, 0, 0, 0
		for _, s in pairs(ST.stocks or {}) do
			if s.cur then
				R.rem += s.cur; R.known += 1
				if s.cur <= 0 then R.out += 1 end
			end
			if s.total then R.init += s.total end
		end
		return R
	end

	-- Tuile : titre / grosse valeur / sous-titre
	local function tile(grid, order, title, value, sub, color)
		local f = Instance.new("Frame")
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = grid
		corner(f, 10)
		stroke(f, C.BORDER_SUBTLE, 1)
		label(f, {
			text = title, size = UDim2.new(1, -14, 0, IS_MOBILE and 13 or 16), position = UDim2.new(0, 8, 0, 6),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12,
			zIndex = 12, truncate = true,
		})
		label(f, {
			text = value, size = UDim2.new(1, -14, 0, IS_MOBILE and 22 or 28),
			position = UDim2.new(0, 8, 0, IS_MOBILE and 19 or 23),
			xAlign = Enum.TextXAlignment.Left, color = color or C.TEXT_WHITE,
			textSize = IS_MOBILE and 19 or 24, zIndex = 12, truncate = true,
		})
		if sub then
			label(f, {
				text = sub, richText = true, size = UDim2.new(1, -14, 0, IS_MOBILE and 12 or 14),
				position = UDim2.new(0, 8, 1, IS_MOBILE and -16 or -19),
				xAlign = Enum.TextXAlignment.Left, color = C.TEXT_DIM, textSize = IS_MOBILE and 9 or 11,
				zIndex = 12, truncate = true,
			})
		end
	end

	local function grid(body, order)
		local g = Instance.new("Frame")
		g.Size = UDim2.new(1, 0, 0, 0)
		g.AutomaticSize = Enum.AutomaticSize.Y
		g.BackgroundTransparency = 1
		g.LayoutOrder = order
		g.ZIndex = 11
		g.Parent = body
		local gl = Instance.new("UIGridLayout")
		gl.CellPadding = UDim2.new(0, 6, 0, 6)
		gl.CellSize = UDim2.new(0.5, -3, 0, IS_MOBILE and 62 or 76)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = g
		return g
	end

	local function barChart(body, order, days)
		local H = IS_MOBILE and 120 or 150
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, H)
		f.BackgroundColor3 = C.BG_DARK
		f.BorderSizePixel = 0
		f.LayoutOrder = order
		f.ZIndex = 11
		f.Parent = body
		corner(f, 10)
		stroke(f, C.BORDER_SUBTLE, 1)
		local max = 1
		for _, d in ipairs(days) do max = math.max(max, d.n + (d.r or 0)) end
		local n = #days
		local top, bottom = IS_MOBILE and 18 or 22, IS_MOBILE and 18 or 22
		for i, d in ipairs(days) do
			local col = Instance.new("Frame")
			col.BackgroundTransparency = 1
			col.Size = UDim2.new(1 / n, -4, 1, -8)
			col.Position = UDim2.new((i - 1) / n, 2, 0, 4)
			col.ZIndex = 12
			col.Parent = f
			local rb = d.r or 0
			local sum = d.n + rb
			local h = sum / max
			local plot = Instance.new("Frame")
			plot.BackgroundTransparency = 1
			plot.Position = UDim2.new(0, 0, 0, top)
			plot.Size = UDim2.new(1, 0, 1, -(top + bottom))
			plot.ZIndex = 12
			plot.Parent = col
			local bar = Instance.new("Frame")
			bar.AnchorPoint = Vector2.new(0.5, 1)
			bar.Position = UDim2.new(0.5, 0, 1, 0)
			bar.Size = UDim2.new(0.72, 0, h, sum > 0 and 0 or 2)
			bar.BackgroundColor3 = d.today and STAT_C or ACC_D
			bar.BorderSizePixel = 0
			bar.ZIndex = 12
			bar.Parent = plot
			corner(bar, 3)
			if rb > 0 then
				-- 💳 part financée en Robux, en vert en bas de la barre
				local rf = Instance.new("Frame")
				rf.AnchorPoint = Vector2.new(0, 1)
				rf.Position = UDim2.new(0, 0, 1, 0)
				rf.Size = UDim2.new(1, 0, rb / sum, 0)
				rf.BackgroundColor3 = RBX_C
				rf.BorderSizePixel = 0
				rf.ZIndex = 13
				rf.Parent = bar
				corner(rf, 3)
			end
			if sum > 0 then
				-- la valeur juste au-dessus de la barre
				label(plot, {
					text = nfmt(sum), size = UDim2.new(1, 0, 0, IS_MOBILE and 12 or 14),
					position = UDim2.new(0, 0, 1 - h, -2), anchor = Vector2.new(0, 1),
					color = d.today and STAT_C or C.TEXT_GREY, textSize = IS_MOBILE and 9 or 11, zIndex = 13,
				})
			end
			label(col, {
				text = (d.day.day == 1 or i == 1) and (d.day.day .. "/" .. d.day.month) or tostring(d.day.day),
				size = UDim2.new(1, 4, 0, bottom - 4), position = UDim2.new(0, -2, 1, -(bottom - 4)),
				color = d.today and STAT_C or C.TEXT_DIM, textSize = IS_MOBILE and 8 or 10, zIndex = 13,
			})
		end
	end

