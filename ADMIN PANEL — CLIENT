-- durée lisible à partir de secondes (ex "3d 4h", "5h 12m", "9m")
local function fmtDuration(sec)
	sec = math.max(0, math.floor(tonumber(sec) or 0))
	local d = math.floor(sec / 86400)
	local h = math.floor((sec % 86400) / 3600)
	local m = math.floor((sec % 3600) / 60)
	if d > 0 then return string.format("%dd %dh", d, h) end
	if h > 0 then return string.format("%dh %dm", h, m) end
	return string.format("%dm", m)
end

local function rankColor(r)
	if r == 1 then return Color3.fromRGB(255, 205, 60)
	elseif r == 2 then return Color3.fromRGB(205, 205, 215)
	elseif r == 3 then return Color3.fromRGB(205, 130, 70)
	elseif r <= 10 then return C.TURQUOISE
	else return C.TEXT_GREY end
end

local function fmtValue(tab, v)
	v = tonumber(v) or 0
	if tab.isPlaytime then
		if playtimeEffMode then return fmtNum(math.floor(v)) .. "/h" end
		return fmtDuration(v)
	end
	if tab.suffix then return tostring(math.floor(v)) .. tab.suffix end
	if tab.id == "Rebirths" then return tostring(math.floor(v)) end
	return fmtNum(v)
end

