	------------------------------------------------------------------
	-- 🖱️ DRAG & DROP (PC / souris) : maintiens un UGC et glisse-le
	------------------------------------------------------------------
	local UIS        = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	local RunService = game:GetService("RunService")
	local DRAG_START_PX = 6
	local D = { from = nil, startY = nil, y = 0, active = false, target = nil, dropAt = 0 }
	local rows = {}   -- [i] = { row, stroke, color, thick } de l'écran affiché

	-- Position souris dans le même repère que AbsolutePosition
	local function guiY(input)
		local y = input.Position.Y
		local sg = window:FindFirstAncestorOfClass("ScreenGui")
		if sg and sg.IgnoreGuiInset then y = y + GuiService:GetGuiInset().Y end
		return y
	end

	local function targetAt(y)
		local n = #rows
		if n == 0 then return nil end
		for i, r in ipairs(rows) do
			if y < r.row.AbsolutePosition.Y + r.row.AbsoluteSize.Y then return i end
		end
		return n
	end

	local function paint()
		for i, r in ipairs(rows) do
			if r.row.Parent then
				local isFrom = D.active and i == D.from
				local isTgt  = D.active and i == D.target and i ~= D.from
				r.row.BackgroundTransparency = isFrom and 0.55 or 0
				r.stroke.Color     = isTgt and ACC or r.color
				r.stroke.Thickness = isTgt and 3 or r.thick
			end
		end
	end

	local function endDrag(commit)
		local from, to, was = D.from, D.target, D.active
		D.from, D.startY, D.active, D.target = nil, nil, false, nil
		if not was then return end
		D.dropAt = os.clock()
		if commit and from and to and from ~= to and not S.busy then
			move(from, to)
		else
			paint()
		end
	end

	UIS.InputChanged:Connect(function(input)
		if not D.from or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local y = guiY(input)
		D.y = y
		if not D.startY then D.startY = y; return end
		if not D.active then
			if math.abs(y - D.startY) < DRAG_START_PX then return end
			D.active = true
		end
		local t = targetAt(y)
		if t ~= D.target then D.target = t; paint() end
	end)

	UIS.InputEnded:Connect(function(input)
		if D.from and input.UserInputType == Enum.UserInputType.MouseButton1 then endDrag(true) end
	end)

	-- Défilement auto quand tu tiens l'UGC près du haut / bas de la liste
	RunService.Heartbeat:Connect(function(dt)
		if not D.active then return end
		local first = rows[1] and rows[1].row
		local body = first and first.Parent
		if not body or not body:IsA("ScrollingFrame") then endDrag(false); return end
		local top = body.AbsolutePosition.Y
		local bot = top + body.AbsoluteSize.Y
		local edge = 45
		local speed = 0
		if D.y < top + edge then
			speed = -math.min(edge, top + edge - D.y)
		elseif D.y > bot - edge then
			speed = math.min(edge, D.y - (bot - edge))
		end
		if speed ~= 0 then
			local maxY = math.max(0, body.AbsoluteCanvasSize.Y - body.AbsoluteWindowSize.Y)
			body.CanvasPosition = Vector2.new(0, math.clamp(body.CanvasPosition.Y + speed * dt * 10, 0, maxY))
			local t = targetAt(D.y)
			if t ~= D.target then D.target = t; paint() end
		end
	end)

