		if S.editDid then postTitle = "📝 BROUILLON"
		elseif S.editId then postTitle = "✏️ MODIFIER" end

		local titles = {
			feed     = "🔔 WHAT'S NEW",
			drafts   = "📝 BROUILLONS",
			post     = postTitle,
			settings = "⚙️ RÉGLAGES DU PANEL",
		}

		local backFn
		if S.view == "feed" then
			backFn = nil        -- retour à l'accueil du panel admin
		else
			-- L'éditeur revient là d'où on l'a ouvert : le fil ou les brouillons
			local dest = (S.view == "post") and (S.from or "feed") or "feed"
			backFn = function()
				S.view, S.editId, S.editDid = dest, nil, nil
				S.draft, S.sdraft, S.dirty = nil, nil, false
				screen(false)
			end
		end

		local body = buildScreen(titles[S.view] or "🔔 WHAT'S NEW", true, BELL, backFn,
			function() screen(true) end)

		if not remote("AdminGetEventInfo") then
			note(body, 1, "❌ Le serveur n'a pas le système What's new.\n\n"
				.. "Installe EventInfo_Server.lua (version fil de publications) dans "
				.. "ServerScriptService, puis redémarre le serveur.", C.RED)
			return
		end

		if not S.data and not S.loading and not S.failed then
			S.loading = true
			task.spawn(function()
				local fn = remote("AdminGetEventInfo")
				local ok, res = false, nil
				if fn then ok, res = pcall(function() return fn:InvokeServer() end) end
				S.loading = false
				if ok and type(res) == "table" and res.ok then
					S.data, S.failMsg = res, nil
				else
					S.failed = true
					if type(res) == "table" and res.msg then S.failMsg = tostring(res.msg)
					elseif ok == false then S.failMsg = "Erreur pendant l'appel : " .. tostring(res)
					else S.failMsg = "Réponse inattendue. Lance _G.EventInfo_Diag() côté serveur." end
				end
				if currentScreen == "eventinfo" and window.Visible then screen(false) end
			end)
		end

		if not S.data then
			note(body, 1, S.failed
				and ("⚠️ Impossible de lire le fil.\n\n"
					.. (S.failMsg and (S.failMsg .. "\n\n") or "")
					.. "Appuie sur 🔄 en haut.")
				or "Chargement du fil...",
				S.failed and C.ORANGE or C.TEXT_GREY)
			return
		end

		if S.view == "post" then
			renderPost(body)
		elseif S.view == "drafts" then
			renderDrafts(body)
		elseif S.view == "settings" then
			renderSettings(body)
		else
			renderFeed(body)
		end
	end

	------------------------------------------------------------------
	-- 🔗 ENTRÉE SUR L'ACCUEIL
	------------------------------------------------------------------
	table.insert(ACTIONS, { id = "eventinfo", name = "🔔 WHAT'S NEW", color = BELL })

	local previousOpenAction = openAction
	openAction = function(a)
		if a and a.id == "eventinfo" then screen(true) return end
		if previousOpenAction then return previousOpenAction(a) end
	end
end)()

