		if cfg.naMode == "off" then
			noteCard(body, 3, "Le filtre est éteint : tous les comptes peuvent jouer, quel que soit leur âge.", C.TEXT_DIM)
		else
			noteCard(body, 3, (cfg.naMode == "ban")
				and "Un compte plus jeune que le seuil est BANNI (il ne peut plus rejoindre du tout)."
				or  "Un compte plus jeune que le seuil est KICK (il peut réessayer, mais sera re-kické).",
