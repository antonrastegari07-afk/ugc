local function statCard(parent, order, title, titleColor)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = C.BG_DARK
	card.BorderSizePixel = 0
	card.LayoutOrder = order
	card.ZIndex = 12
	card.Parent = parent
	corner(card, 10); stroke(card, titleColor, 1)
	label(card, {
		text = title, size = UDim2.new(1, -16, 0, IS_MOBILE and 18 or 22),
		position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left,
		color = titleColor, textSize = IS_MOBILE and 11 or 14, zIndex = 13,
	})
	local rows = Instance.new("Frame")
	rows.Position = UDim2.new(0, 0, 0, IS_MOBILE and 24 or 28)
	rows.Size = UDim2.new(1, 0, 0, 0)
	rows.AutomaticSize = Enum.AutomaticSize.Y
	rows.BackgroundTransparency = 1
	rows.ZIndex = 13
	rows.Parent = card
	local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 2); l.Parent = rows
	local rp = Instance.new("UIPadding")
	rp.PaddingBottom = UDim.new(0, 8); rp.PaddingLeft = UDim.new(0, 10); rp.PaddingRight = UDim.new(0, 10)
	rp.Parent = rows
	return card, rows
end

