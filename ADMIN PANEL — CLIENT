	-- 🖥️ ÉCRAN PRINCIPAL
	--════════════════════════════════════════════════════════════════
	screenACBoards_new = function(a)
		currentScreen = "acboards"

		--  Compat : l'ancien code appelait screenACBoards("fly", "fly_warnings", 50).
		--  On accepte ces appels sans rien casser.
		if a == "fly" or a == "smart" or a == "exploit" then
			ST.sys = a ; ST.metric = nil ; ST.tab = "boards"
		elseif a == "feed" or a == "risk" or a == "boards" or a == "card" then
			ST.tab = a
		end

		local body = buildScreen("🚨 ANTI-CHEAT", true, RED, nil, function()
			--  🔄 vide tous les caches : c'est le seul chemin qui relit
			--  vraiment le DataStore.
			CACHE.board = {} ; CACHE.pts = {} ; CACHE.ban = {} ; CACHE.restr = {}
			ST.cardData = nil ; ST.entries = nil
			screenACBoards_new()
		end)

		acTabBar(body, -2, {
			{ id = "feed", label = "📡 Récent" },
			{ id = "risk", label = "🎯 Risque" },
		}, ST.tab, RED, function(id) ST.tab = id ; screenACBoards_new() end)

		acTabBar(body, -1, {
			{ id = "boards", label = "🏆 Classements" },
			{ id = "card",   label = "🔍 Dossier" },
		}, ST.tab, RED, function(id) ST.tab = id ; screenACBoards_new() end)

		if ST.tab == "risk" then
			renderRisk(body)
		elseif ST.tab == "boards" then
			renderBoards(body)
		elseif ST.tab == "card" then
			renderCard(body)
		else
			renderFeed(body)
		end
	end

	--  🔁 On remplace la fonction d'origine. Le dispatch de l'accueil
	--     (openAction → screenACBoards) pointe sur une variable locale du
	--     script principal : en la réassignant ici, tous les appels — y
	--     compris ceux déjà écrits dans ton ancien code — arrivent sur la
	--     nouvelle version.
	screenACBoards = screenACBoards_new
end)()

