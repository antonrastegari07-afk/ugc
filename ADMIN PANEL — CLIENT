	--  🃏 La carte cliquable : un titre, une explication, une pastille à
	--     droite. Tu sais ce que fait un élément AVANT de cliquer dessus.
	local function card(parent, order, o)
		local h = o.height or (IS_MOBILE and 56 or 66)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, 0, 0, h)
		b.BackgroundColor3 = o.selected and C.BG_MEDIUM or C.BG_ITEM
		b.BackgroundTransparency = 0.2
		b.AutoButtonColor = false
		b.Text = "" ; b.BorderSizePixel = 0
		b.LayoutOrder = order ; b.ZIndex = 11 ; b.Parent = parent
		corner(b, 10)
		local st = stroke(b, o.selected and (o.color or AA) or C.BORDER_SUBTLE,
			o.selected and 1.8 or 1)

		local x = 12
		if o.icon then
			local img = Instance.new("ImageLabel")
			img.BackgroundTransparency = 1
			img.ScaleType = Enum.ScaleType.Fit
			img.Image = o.icon
			img.Size = UDim2.new(0, h - 22, 0, h - 22)
			img.Position = UDim2.new(0, 10, 0.5, 0)
			img.AnchorPoint = Vector2.new(0, 0.5)
			img.ZIndex = 12 ; img.Parent = b
			x = 10 + (h - 22) + 10
		end

		local rightW = o.right and (IS_MOBILE and 70 or 92) or 16
		lbl(b, { text = o.title or "", color = o.titleColor or C.TEXT_WHITE,
			size = IS_MOBILE and 13 or 15, truncate = true,
			frame = UDim2.new(1, -x - rightW, 0, IS_MOBILE and 18 or 20),
			pos = UDim2.new(0, x, 0, o.sub and (IS_MOBILE and 8 or 11) or (h / 2 - 10)) })
		if o.sub then
			lbl(b, { text = o.sub, color = o.subColor or C.TEXT_GREY,
				size = IS_MOBILE and 10 or 11.5, wrap = true,
				frame = UDim2.new(1, -x - rightW, 0, IS_MOBILE and 26 or 30),
				pos = UDim2.new(0, x, 0, IS_MOBILE and 25 or 30),
				yAlign = Enum.TextYAlignment.Top })
		end
		if o.right then
			lbl(b, { text = o.right, color = o.rightColor or AA,
				size = IS_MOBILE and 12 or 14, xAlign = Enum.TextXAlignment.Right,
				frame = UDim2.new(0, rightW - 8, 1, 0),
				pos = UDim2.new(1, -rightW, 0, 0) })
		end

		if o.onClick then
			b.MouseEnter:Connect(function()
				b.BackgroundColor3 = C.BG_MEDIUM ; st.Color = o.color or AA
			end)
			b.MouseLeave:Connect(function()
				if o.selected then return end
				b.BackgroundColor3 = C.BG_ITEM ; st.Color = C.BORDER_SUBTLE
			end)
			b.MouseButton1Click:Connect(o.onClick)
		end
		return b
	end

