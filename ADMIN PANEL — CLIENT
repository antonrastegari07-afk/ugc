		row.Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46)
		row.BackgroundColor3 = C.BG_DARK
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 8); stroke(row, CY, 1)

		local bw = IS_MOBILE and 38 or 46
		local function sideBtn(isPlus)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(isPlus and 1 or 0, 0.5)
			c.Position = UDim2.new(isPlus and 1 or 0, isPlus and -6 or 6, 0.5, 0)
			c.Size = UDim2.new(0, bw, 0, IS_MOBILE and 28 or 34)
			c.BackgroundTransparency = 1
			c.ZIndex = 12
			c.Parent = row
			local b = actionButton(c, {
				color = isPlus and C.GREEN or C.BG_LIGHT,
				strokeColor = isPlus and C.GREEN_DARK or C.BORDER_BRIGHT,
				text = isPlus and "+" or "−",
				textSize = IS_MOBILE and 16 or 20, radius = 7, zIndex = 12,
			})
			b.MouseButton1Click:Connect(function()
				onSet(math.clamp(value + (isPlus and step or -step), minV, maxV))
			end)
		end
		sideBtn(false); sideBtn(true)

		local box = Instance.new("TextBox")
		box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.Position = UDim2.new(0.5, 0, 0.5, 0)
		box.Size = UDim2.new(1, -(bw * 2 + 24), 1, -10)
		box.BackgroundTransparency = 1
		box.Font = FONT
		box.Text = tostring(value) .. " " .. suffix
		box.TextColor3 = C.TEXT_WHITE
		box.TextSize = IS_MOBILE and 14 or 17
		box.ClearTextOnFocus = true
		box.ZIndex = 12
		box.Parent = row
		box.FocusLost:Connect(function()
			local v = tonumber(box.Text:match("%d+"))
			if v then onSet(math.clamp(math.floor(v), minV, maxV))
			else box.Text = tostring(value) .. " " .. suffix end
		end)
		return row
	end

