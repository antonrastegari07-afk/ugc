	-- Appel serveur générique + toast + rafraîchissement
	local function callServer(action, payload, onDone)
		if not doAct then toast("BanManager pas installé côté serveur", false); return end
		task.spawn(function()
			local ok, res = pcall(function() return doAct:InvokeServer(action, payload) end)
			if ok and type(res) == "table" then
				if res.msg then toast(res.msg, res.ok == true) end
				if onDone then onDone(res) end
			else
				toast("Erreur de communication", false)
				if onDone then onDone(nil) end
			end
		end)
	end

