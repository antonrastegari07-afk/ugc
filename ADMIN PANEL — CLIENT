		local nt = (e.nt and e.nt ~= "") and e.nt or (e.st and ("état " .. tostring(e.st)) or "")
		label(c, { text = fmtAgo(e.t) .. (nt ~= "" and ("  ·  " .. nt) or ""),
			size = UDim2.new(1, -tx - 12, 0, IS_MOBILE and 14 or 17),
