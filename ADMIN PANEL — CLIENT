					size = UDim2.new(0.6, -12, 0, 16), position = UDim2.new(0.4, 0, 0, IS_MOBILE and 34 or 38),
					xAlign = Enum.TextXAlignment.Right, color = dc or C.TEXT_GREY, textSize = SM, truncate = true, zIndex = 12 })
			end
			line(hero, IS_MOBILE and 60 or 70, IS_MOBILE and 18 or 22, string.format(
				"💳 %s payée%s avec des points achetés en Robux  (%s)  ·  ≈ %s", sep(buyN(t)), buyN(t) > 1 and "s" or "",
				pct(buyN(t), t.n), R(t.r)), GREEN, MD)
			line(hero, IS_MOBILE and 80 or 96, 16, string.format("dont %s à 100 %%  ·  %s pts dépensés",
				sep(t.b100), sep(t.pts)), C.TEXT_GREY, SM)

			-- ── Ce qu'on regarde ──
			acTabBar(body, 6, METRICS, U.metric, PINK_D, function(id) U.metric = id ; screenUGC(false) end)
			if U.metric == "n" then legendRow(body, 7, res) end

			-- ── Graphique ──
			if res.empty then
				note(body, 8, "Pas de données avant le " .. tostring(res.since) .. ".", C.TEXT_DIM)
			else
				ugcChartView(body, 8, res)
			end
			note(body, 9, "Touche une barre pour voir son détail et chacune de ses ventes"
				.. (U.metric == "n" and " · touche une catégorie pour la masquer" or "")
				.. (res.prev and " · gris = période d'avant" or "") .. ".", C.TEXT_DIM)

			if res.hist and res.hist.state ~= "done" then
				note(body, 10, string.format("⏳ Reconstitution des jours d'avant le %s en cours : %d %%.",
					tostring(res.installed), tonumber(res.hist.pct) or 0), C.ORANGE)
			elseif (t.h or 0) > 0 then
				note(body, 10, string.format("🕰️ %s UGC d'avant le %s sont reconstituées depuis tes anciens logs "
					.. "(points achetés datés + cadeaux reçus ; pass/boosts d'avant inconnus).",
					sep(t.h), tostring(res.installed)), C.TEXT_DIM)
			end

			-- ── Barre sélectionnée ──
			local b = items[U.sel]
			if b then
				local bc = card(body, 11, IS_MOBILE and 92 or 108)
				line(bc, 8, 18, "📅 " .. tostring(b.full), GOLD, MD)
				line(bc, IS_MOBILE and 30 or 34, 16, string.format("%s UGC  ·  💳 %s payées en Robux (%s)  ·  ≈ %s",
					sep(b.n), sep(buyN(b)), pct(buyN(b), b.n), R(b.r)), GREEN, SM)
				line(bc, IS_MOBILE and 50 or 56, 16, classLine(b), C.TEXT_GREY, SM)
				local pv = res.prev and res.prev[U.sel]
				if pv then
					line(bc, IS_MOBILE and 70 or 78, 16, string.format("Période d'avant (%s) : %s UGC · %s en Robux",
						tostring(pv.l), sep(pv.n), sep(pv.y)), C.TEXT_DIM, SM)
				end
				if (b.n or 0) > 0 then salesList(body, 20, res, b, alive) end
			end

			note(body, 2000, "💳 Règle : quand un joueur achète une UGC, ses points ACHETÉS en Robux (packs de points, "
				.. "cadeaux de points reçus) sont dépensés EN PREMIER. Il achète 2M de points puis une UGC à 2M → "
				.. "100 % Robux. 🕰️ = reconstituée depuis les anciens logs. Heures de Montréal.", C.TEXT_DIM)
		end, okey("ugcchart", o))
	end

