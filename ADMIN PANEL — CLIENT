		sep.BackgroundTransparency = 0.3
		sep.BorderSizePixel = 0
		sep.ZIndex = 21
		sep.Parent = bar

		local giveW = IS_MOBILE and 112 or 150
		local clearW = IS_MOBILE and 40 or 46
		local summary = label(bar, {
			text = "", size = UDim2.new(1, -giveW - clearW - 32, 1, -10),
			position = UDim2.new(0, 12, 0, 5), xAlign = Enum.TextXAlignment.Left,
			color = C.TEXT_GREY, textSize = IS_MOBILE and 10 or 12, wrapped = true, zIndex = 21,
		})

		local cc = Instance.new("Frame")
		cc.AnchorPoint = Vector2.new(1, 0.5)
		cc.Position = UDim2.new(1, -giveW - 16, 0.5, 0)
		cc.Size = UDim2.new(0, clearW, 0, BAR_H - 18)
