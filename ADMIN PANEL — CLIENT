		local d = math.max(0, os.time() - t)
		if d < 60 then return "à l'instant" end
		if d < 3600 then return ("il y a %d min"):format(d // 60) end
		if d < 86400 then return ("il y a %d h"):format(d // 3600) end
		return ("il y a %d j"):format(d // 86400)
