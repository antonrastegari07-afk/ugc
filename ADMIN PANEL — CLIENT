			return
		end

		local list = {}
		for _, rec in ipairs(S.devEntries) do
			local state = select(1, deviceState(rec))
			if S.devFilter == "all" or S.devFilter == state then
				table.insert(list, rec)
			end
		end

		cLbl.Text = string.format("%d affiché(s)  •  %d en attente  •  %d bloqué(s)  •  %d expiré(s)",
			#list, pending, active, expired)

		if #list == 0 then
			local msg
			if S.devLoading then msg = "Chargement du registre..."
			elseif #S.devEntries == 0 then msg = "✅ Aucun appareil bloqué ni en attente."
			else msg = "Rien ne correspond à ce filtre." end
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, 0, 0, 60); f.BackgroundTransparency = 1
			f.LayoutOrder = 1; f.ZIndex = 11; f.Parent = holder
			label(f, { text = msg, size = UDim2.fromScale(1, 1), wrapped = true,
				color = C.TEXT_GREY, textSize = IS_MOBILE and 12 or 15, zIndex = 11 })
			return
		end

		for i, rec in ipairs(list) do
			deviceRow(holder, i, rec)
		end
	end

