	local function okey(action, o)
		return action .. "|" .. table.concat({ tostring(o.p), tostring(o.off), tostring(o.g), tostring(o.asset),
			tostring(o.cmp), tostring(o.from), tostring(o.to), tostring(o.hour) }, "|")
	end
	local function buyN(b) return (tonumber(b.b100) or 0) + (tonumber(b.bpart) or 0) end
	local function mval(b)
		if U.metric == "pct" then return (b.n > 0) and (buyN(b) / b.n * 100) or 0 end
		if U.metric == "r" then return tonumber(b.r) or 0 end
		if U.metric == "pts" then return tonumber(b.pts) or 0 end
		local v = 0
		for _, c in ipairs(CLASSES) do
			if not U.hide[c.k] then v += tonumber(b[c.k]) or 0 end
		end
		return v
	end
	local function pval(pv)
		if not pv then return nil end
		if U.metric == "pct" then return (pv.n > 0) and (pv.y / pv.n * 100) or 0 end
		if U.metric == "r" then return tonumber(pv.r) or 0 end
		if U.metric == "pts" then return tonumber(pv.pts) or 0 end
		return tonumber(pv.n) or 0
	end
	local function mfmt(v)
		v = tonumber(v) or 0
		if U.metric == "pct" then return string.format("%.0f%%", v) end
		if U.metric == "pts" then return fmtPts(v) or "0" end
		if U.metric == "r" then return sep(v) .. " R$" end
		return sep(v)
	end
	local function niceMax(m)
		if U.metric == "pct" then return 100 end
		if m <= 0 then return 1 end
		local e = 10 ^ math.floor(math.log10(m))
		for _, f in ipairs({ 1, 2, 2.5, 5, 10 }) do
			if f * e >= m then return math.max(1, f * e) end
		end
		return 10 * e
	end

