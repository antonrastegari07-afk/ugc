	--════════════════════════════════════════════════════════════════
	-- 📞 APPELS SERVEUR
	--════════════════════════════════════════════════════════════════
	local function callAC(action, payload, cb, attempt)
		local fn = acRemote("AdminUGCRestrictAction")
		if not fn then if cb then cb(nil) end return end
		attempt = attempt or 1
		task.spawn(function()
			local ok, res = pcall(function() return fn:InvokeServer(action, payload) end)
			--  Une limite de débit n'est pas une panne : on réessaie tout seul.
			if ok and type(res) == "table" and res.throttled and attempt < 3 then
				task.wait(0.35 * attempt)
				callAC(action, payload, cb, attempt + 1)
				return
			end
			if cb then cb((ok and type(res) == "table") and res or nil) end
		end)
	end

	--  Résolution en lot : ne demande que ce qui MANQUE, et remplit le cache.
	local function resolveAC(ids, cb)
		local need = {}
		for _, id in ipairs(ids) do
			if not CACHE.name[id] then need[#need + 1] = id end
		end
		if #need == 0 then if cb then cb() end return end

		callAC("resolve", { ids = need }, function(res)
			if res and res.ok and type(res.data) == "table" then
				for key, e in pairs(res.data) do
					local id = tonumber(key)
					if id and type(e) == "table" then
						if e.name then CACHE.name[id] = e.name end
						if e.points ~= nil then CACHE.pts[id] = e.points end
						if e.banned ~= nil then CACHE.ban[id] = e.banned end
						if e.restricted ~= nil then CACHE.restr[id] = e.restricted end
					end
				end
			end
			if cb then cb() end
		end)
	end

	--════════════════════════════════════════════════════════════════
	-- 📏 OUTILS
	--════════════════════════════════════════════════════════════════
	local function nameOf(id)
		local pl = Players:GetPlayerByUserId(id)
		if pl then CACHE.name[id] = pl.Name ; return pl.Name end
		return CACHE.name[id]
	end

	local function pointsOf(id)
		local pl = Players:GetPlayerByUserId(id)
		if pl then
			local a = pl:GetAttribute("Points")
			if type(a) == "number" then return a end
		end
		return CACHE.pts[id]
	end

	--  Combien d'UGC ce joueur peut s'offrir MAINTENANT.
	local function ugcPower(points)
		if not points then return nil end
		return points / UGC_PRICE
	end

	--  Le score de risque. Il répond à une question précise : parmi les
	--  joueurs suspects, lesquels sont assez riches pour transformer ça en
	--  objet ? Un tricheur à 200 points ne coûte rien à ton économie ; le
	--  même à 1,9 million est à un pas de vider ton stock.
	local function riskScore(warnings, points)
		local w = tonumber(warnings) or 0
		if w <= 0 then return 0 end
		local pw = ugcPower(points)
		if pw == nil then return w * 0.2 end            -- points inconnus : poids minimal
		return w * (0.2 + math.clamp(pw, 0, 4))
	end

	local function confColor(c)
		c = tonumber(c) or 0
		if c >= 85 then return RED end
		if c >= 70 then return ORANGE end
		if c >= 55 then return GOLD end
		return C.TEXT_GREY
	end

	--════════════════════════════════════════════════════════════════
	-- 📋 LIGNE À REMPLISSAGE PROGRESSIF
	--
	--    C'est le cœur de la correction de lenteur. La ligne est construite
	--    tout de suite avec ce qu'on sait (l'UserId), puis on garde une
	--    référence à ses deux labels. Quand le serveur répond, on écrit
	--    dedans — on ne reconstruit RIEN.
	--════════════════════════════════════════════════════════════════
	local function acLine(parent, order, opt)
		local id = opt.userId
		local accent = opt.accent or CYAN

		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, ROW_H)
		row.BackgroundColor3 = C.BG_DARK
		row.AutoButtonColor = false
		row.Text = ""
		row.BorderSizePixel = 0
		row.LayoutOrder = order
		row.ZIndex = 11
		row.Parent = parent
		corner(row, 10)
		local rs = stroke(row, C.BORDER_SUBTLE, 1)

		local rankW = IS_MOBILE and 28 or 36
		if opt.rank then
			label(row, { text = "#" .. opt.rank, size = UDim2.new(0, rankW, 1, 0),
				position = UDim2.new(0, 4, 0, 0), color = rankColor(opt.rank),
				textSize = IS_MOBILE and 11 or 15, zIndex = 12 })
		else
			rankW = 2
		end

		local avS = ROW_H - 18
		local av = makeAvatar(row, id, avS)
		av.AnchorPoint = Vector2.new(0, 0.5)
		av.Position = UDim2.new(0, rankW + 6, 0.5, 0)

		local tx = rankW + 6 + avS + 8
		local valW = IS_MOBILE and 86 or 112

		--  Ligne 1 : le pseudo. Affiché « … » puis rempli.
		local nameLbl = label(row, {
			text = nameOf(id) or "…",
			size = UDim2.new(1, -tx - valW - 10, 0, IS_MOBILE and 15 or 19),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 8 or 12),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_WHITE,
			textSize = IS_MOBILE and 12 or 15, truncate = true, zIndex = 12,
		})

		--  Ligne 2 : la ligne de contexte (points, UGC finançables, statut).
		local subLbl = label(row, {
			text = opt.sub or "chargement…",
			size = UDim2.new(1, -tx - valW - 10, 0, IS_MOBILE and 14 or 17),
			position = UDim2.new(0, tx, 0, IS_MOBILE and 26 or 34),
			xAlign = Enum.TextXAlignment.Left, color = C.TEXT_GREY,
			textSize = IS_MOBILE and 9 or 12, truncate = true, zIndex = 12,
		})

		--  Colonne de droite : la valeur du classement courant.
		local valLbl = label(row, {
			text = opt.value or "",
			size = UDim2.new(0, valW, 1, 0),
			position = UDim2.new(1, -8, 0.5, 0), anchor = Vector2.new(1, 0.5),
			xAlign = Enum.TextXAlignment.Right, color = opt.valueColor or accent,
			textSize = IS_MOBILE and 12 or 15, zIndex = 12, truncate = true,
		})

		row.MouseEnter:Connect(function() row.BackgroundColor3 = C.BG_MEDIUM ; rs.Color = accent end)
		row.MouseLeave:Connect(function() row.BackgroundColor3 = C.BG_DARK ; rs.Color = C.BORDER_SUBTLE end)
		row.MouseButton1Click:Connect(function()
			ST.tab = "card" ; ST.cardFor = id ; ST.cardData = nil
			screenACBoards_new()
		end)

		return { row = row, name = nameLbl, sub = subLbl, value = valLbl, userId = id }
	end

	--  Remplit les lignes une fois la résolution revenue.
	local function fillLines(refs, subBuilder)
		for _, r in ipairs(refs) do
			if r.name.Parent then
				r.name.Text = nameOf(r.userId) or ("UserId " .. r.userId)
				if subBuilder then
					local txt, col = subBuilder(r.userId)
					r.sub.Text = txt
					if col then r.sub.TextColor3 = col end
				end
			end
		end
	end

	--  La ligne de contexte standard : points, pouvoir d'achat UGC, statut.
	local function stdSub(id)
		local p = pointsOf(id)
		local parts = {}
		if p then
			table.insert(parts, fmtNum(p) .. " pts")
			local pw = ugcPower(p)
			if pw and pw >= 1 then
				table.insert(parts, string.format("🎽 %d UGC finançable(s)", math.floor(pw)))
			elseif pw then
				table.insert(parts, string.format("🎽 %d %% d'une UGC", math.floor(pw * 100)))
			end
		else
			table.insert(parts, "Points : —")
		end
		if CACHE.restr[id] then table.insert(parts, "🚫 privé d'UGC") end
		if CACHE.ban[id] then table.insert(parts, "⛔ banni") end
		if Players:GetPlayerByUserId(id) then table.insert(parts, "🟢 en ligne") end

		local col = C.TEXT_GREY
		if CACHE.restr[id] then col = PURPLE
		elseif CACHE.ban[id] then col = RED
		elseif p and p >= UGC_PRICE then col = ORANGE end
		return table.concat(parts, "  ·  "), col
	end

