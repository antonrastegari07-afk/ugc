	icon.TextScaled             = true
	icon.Font                   = Enum.Font.FredokaOne
	icon.ZIndex                 = 51
	icon.Parent                 = frame

	local lbl = Instance.new("TextLabel")
	lbl.AnchorPoint            = Vector2.new(0.5, 0)
