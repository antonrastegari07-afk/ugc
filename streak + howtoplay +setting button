local function fmtCountdown(sec)
	sec = math.max(0, math.floor(sec))
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	if h > 0 then return string.format("%dh %02dm", h, m) end
	if m > 0 then return string.format("%dm %02ds", m, s) end
	return string.format("%ds", s)
end

local function updateNextDayCountdown()
	local canRecover = player:GetAttribute("FlameCanRecover") or false
	local nextDay    = player:GetAttribute("FlameNextDay")
	local streak     = player:GetAttribute("FlameStreak") or 0

	-- masqué en mode recover, si pas encore chargé, ou streak au max
	if canRecover or nextDay == nil or (TOTAL > 0 and streak >= TOTAL) then
		nextDayLabel.Visible = false
		return
	end

	local remaining = nextDay - os.time()
	if remaining <= 0 then
		nextDayLabel.Text      = "🔥 Reconnect now to extend your streak!"
		nextDayLabel.TextColor3 = Color3.fromRGB(120, 255, 150)
	else
		nextDayLabel.Text      = "🔥 Reconnect in " .. fmtCountdown(remaining) .. " to extend your streak"
		nextDayLabel.TextColor3 = Color3.fromRGB(255, 205, 110)
	end
	nextDayLabel.Visible = true
end

