local function refreshTrack()
	if not StreakRewardsConfig then return end
	local streak = clientStreak

	local frac = 0
	if TOTAL > 1 then frac = math.clamp((streak - 1) / (TOTAL - 1), 0, 1) end
	TweenService:Create(barFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad),
		{ Size = UDim2.new(frac, 0, 1, 0) }):Play()
	fireTip.Visible  = streak >= 1
	fireTip.Position = UDim2.new(frac, 0, 0.5, 0)

	claimableList = {}
	for day = 1, TOTAL do
		local ref       = nodeRefs[day]
		local reached   = day <= streak
		local isReward  = ref.reward ~= nil
		local claimed   = clientClaimed[day] == true
		local claimable = isReward and reached and not claimed and not ref.pending
		ref.claimable   = claimable

		if isReward then
			ref.check.Visible = claimed
			if claimed then
				ref.stroke.Color          = Color3.fromRGB(40, 175, 75)
				ref.stroke.Thickness      = 2.5
				ref.node.BackgroundColor3 = Color3.fromRGB(24, 40, 28)
				ref.mainImg.ImageTransparency = 0.25
			elseif claimable then
				ref.stroke.Color          = Color3.fromRGB(255, 170, 30)
				ref.stroke.Thickness      = 3
				ref.node.BackgroundColor3 = Color3.fromRGB(45, 34, 16)
				ref.mainImg.ImageTransparency = 0
				table.insert(claimableList, ref)
			else
				ref.stroke.Color          = Color3.fromRGB(70, 70, 76)
				ref.stroke.Thickness      = 2
				ref.node.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
				ref.mainImg.ImageTransparency = 0.55
			end
		else
			if reached then
				ref.stroke.Color              = Color3.fromRGB(255, 150, 40)
				ref.node.BackgroundColor3     = Color3.fromRGB(48, 32, 14)
				ref.mainImg.ImageTransparency = 0.1
				ref.dayText.TextColor3        = Color3.fromRGB(255, 255, 255)
			else
				ref.stroke.Color              = Color3.fromRGB(70, 70, 76)
				ref.node.BackgroundColor3     = Color3.fromRGB(28, 28, 34)
				ref.mainImg.ImageTransparency = 0.7
				ref.dayText.TextColor3        = Color3.fromRGB(170, 170, 176)
			end
		end
	end

	updateClaimButton()
end

