		local v = statValueLabels[key]
		local row = v and v.Parent
		if row then
			for _, l in ipairs(row:GetChildren()) do
				if l:IsA("TextLabel") and l ~= v then
					local sz = row.Size.Y.Offset
					local ic = Instance.new("ImageLabel")
					ic.BackgroundTransparency = 1
					ic.Image                  = img
					ic.ScaleType              = Enum.ScaleType.Fit
					ic.Size                   = UDim2.new(0, sz, 0, sz)
					ic.ZIndex                 = 33
					ic.Parent                 = row
					l.Text     = (l.Text:match("%a.*")) or l.Text     -- retire l'emoji
					l.Position = UDim2.new(0, sz + 6, 0, 0)
					l.Size     = UDim2.new(0.55, -(sz + 6), 1, 0)
				end
			end
		end
	end
	-- Avatar de l'onglet Stats : contour bleu du téléporteur
	local avs = avatar:FindFirstChildOfClass("UIStroke")
	if avs then avs.Color = ACCENT end
end)()
