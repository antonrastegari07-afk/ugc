local function pushSetting(name, value)
	pcall(function() updateSettingEvent:FireServer(name, value) end)
end
-- Rafraîchit un contrôle quand le serveur charge/applique la valeur sauvegardée
local function bindSetting(name, control, isSlider)
	player:GetAttributeChangedSignal(name):Connect(function()
		local v = player:GetAttribute(name)
		if v == nil then return end
		if isSlider then control.setValue(v, true) else control.setState(v, true) end
	end)
end

