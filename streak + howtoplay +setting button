		okStroke.Thickness = 1.5 + p2 * 2.5
		okBtn.BackgroundColor3 = Color3.fromRGB(40, 175, 75):Lerp(Color3.fromRGB(58, 205, 95), p2)
	end
end)

local function scrollToStreak()
	if not StreakRewardsConfig or TOTAL <= 0 then return end
	local streak = math.max(1, clientStreak)
	local cx = LEFT_PAD + (streak - 1) * SPACING
	local target = cx - track.AbsoluteWindowSize.X / 2 + NODE / 2
	target = math.clamp(target, 0, math.max(0, CANVAS_W - track.AbsoluteWindowSize.X))
	track.CanvasPosition = Vector2.new(target, 0)
end

