-- Claim all : réclame tous les jours dispo (espacés pour le lock serveur)
local function claimAll()
	if not StreakRewardsConfig or nodeRefs.claimingAll then return end
	nodeRefs.claimingAll = true
	local days = {}
	for day = 1, TOTAL do
		local ref = nodeRefs[day]
		if ref and ref.claimable and not ref.pending then
			table.insert(days, day)
		end
	end
	table.sort(days)
	for _, d in ipairs(days) do
		if nodeRefs[d] then nodeRefs[d].pending = true end
	end
	refreshTrack()  -- éteint tout le pulse d'un coup
	task.spawn(function()
		for _, d in ipairs(days) do
			if srClaim then srClaim:FireServer(d) end
			task.wait(0.35)   -- ≥ debounce serveur (0.15s) avec marge
		end
		task.wait(0.6)
		nodeRefs.claimingAll = false
	end)
end

