	--  BackgroundColor3 ni par le UIStroke. C'est ce qui lui permet de
	--  coexister avec tout le reste sans une seule condition : le pulse
	--  vert du Heartbeat écrit la couleur de fond en continu, paintOk
	--  écrit la couleur du contour, et le recover a déjà ses propres
	--  handlers de couleur. Le voile se superpose à tout ça.
	--
	--  L'échelle passe par UIScale : la mise en page du panneau n'est
	--  jamais recalculée.
	local function interactive(btn, radius, zIndex, low, high)
		local veil = Instance.new("Frame")
		veil.Name                   = "HoverVeil"
		veil.Size                   = UDim2.new(1, 0, 1, 0)
		veil.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
		veil.BackgroundTransparency = 1
		veil.BorderSizePixel        = 0
		veil.ZIndex                 = zIndex
		veil.Parent                 = btn
		local vc = Instance.new("UICorner")
		vc.CornerRadius = UDim.new(0, radius)
		vc.Parent = veil

		local s = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		s.Parent = btn

		local function to(scale, veilT)
			local i = TweenInfo.new(0.11, Enum.EasingStyle.Quad)
			TweenService:Create(s,    i, { Scale = scale }):Play()
			TweenService:Create(veil, i, { BackgroundTransparency = veilT }):Play()
		end

		--  MouseEnter ne se déclenche pas au doigt. Au relâchement on
		--  revient donc au repos sur mobile (le curseur n'est nulle part)
		--  et à l'état survolé sur PC (le curseur est encore dessus) —
		--  sans ça, un bouton tapé sur mobile restait éclairci pour
		--  toujours, MouseLeave n'arrivant jamais.
		btn.MouseEnter:Connect(function() to(high, 0.88) end)
		btn.MouseLeave:Connect(function() to(1, 1) end)
		btn.MouseButton1Down:Connect(function() to(low, 0.78) end)
		btn.MouseButton1Up:Connect(function()
			if isMobile then to(1, 1) else to(high, 0.88) end
		end)
		return s
