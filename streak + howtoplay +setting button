-- ============================================================
-- ✨ RESTYLE — bouton RECOVER STREAK + bouton OK / CLAIM
--    + badge « streak perdue » + badge topbar réduit à "Lost"
-- ------------------------------------------------------------
-- 📍 OÙ LE COLLER
--    Juste APRÈS ces deux lignes, à la fin de la section Streak :
--
--        refreshUI()
--        task.defer(function() if srRequest then ... end end)
--
--    ...et AVANT la ligne :
--        -- ⚙️  SETTINGS PANEL + 📊 STATS  (refonte complète)
--
--    C'est obligatoire : ce bloc réécrit updateClaimButton et
--    refreshUI, qui sont définis juste au-dessus. Et il doit rester
--    AVANT le panneau Settings, qui redéclare un `panel` à lui.
--
-- 🧠 ZÉRO nouveau local au niveau du script : tout vit dans cette
--    fonction anonyme. Aucun risque pour la limite Luau des 200
--    registres, comme pour tes autres blocs.
--
-- 🎨 PRINCIPE : les dégradés n'ajoutent QUE de la luminance
--    (blanc → gris). Un UIGradient se MULTIPLIE par BackgroundColor3,
--    donc le pulse vert du Heartbeat, le hover du recover et les
--    couleurs posées par refreshUI continuent de marcher — ils sont
--    simplement mieux habillés. Rien à désactiver, rien à dupliquer.
--
-- ⚠️ Le ";" au début de ";(function()" est OBLIGATOIRE.
-- ============================================================
;(function()

	-- ────────────────────────────────────────────────────────
	-- Helpers de style
	-- ────────────────────────────────────────────────────────

	--  Relief : clair en haut, sombre en bas. Multiplié par la couleur
	--  du bouton, donc valable pour le vert du claim, le vert du
	--  recover et le gris du OK, sans une seule ligne par cas.
	local function relief(inst, bottom)
		local g = Instance.new("UIGradient")
		g.Rotation = 90
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.52, Color3.fromRGB(236, 236, 236)),
			ColorSequenceKeypoint.new(1.00, Color3.new(bottom, bottom, bottom)),
		})
		g.Parent = inst
		return g
	end

	--  Reflet qui balaie le bouton. Il vit sur un calque enfant : un
	--  GuiObject ne peut porter qu'UN seul UIGradient, et celui du
	--  bouton sert déjà au relief.
	local function sheenOn(btn, radius, zIndex)
		btn.ClipsDescendants = true
		local layer = Instance.new("Frame")
		layer.Name                   = "Sheen"
		layer.Size                   = UDim2.new(1, 0, 1, 0)
