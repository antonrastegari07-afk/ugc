-- ── Responsive : le frame rétrécit pour toujours tenir à l'écran ──
-- (UIScale auto, même principe que le script 1v1 cross-server)
local function fitToScreen(frame, margin)
	margin = margin or 24
	local sc = frame:FindFirstChildOfClass("UIScale")
	if not sc then sc = Instance.new("UIScale"); sc.Parent = frame end
	local function apply()
		local cam = workspace.CurrentCamera
		local vp = (cam and cam.ViewportSize.Y > 1) and cam.ViewportSize or Vector2.new(1280, 720)
		local w, h = frame.Size.X.Offset, frame.Size.Y.Offset
		if w <= 0 or h <= 0 then sc.Scale = 1; return end
		sc.Scale = math.min(1, (vp.X - margin) / w, (vp.Y - margin) / h)
	end
	apply()
	frame:GetPropertyChangedSignal("Size"):Connect(apply)
	local function hookCam()
		local cam = workspace.CurrentCamera
		if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply) end
	end
	hookCam()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		hookCam(); apply()
	end)
	return sc
end

