	fireGrad.Rotation = math.sin(tAccum * 2) * 6
	fireTip.Rotation  = math.sin(tAccum * 4) * 8

	local pulse = 0.5 + 0.5 * math.sin(tAccum * 5)
	for _, ref in ipairs(claimableList) do
